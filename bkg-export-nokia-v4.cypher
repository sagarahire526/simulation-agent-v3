CREATE (:BKGNode {map_table_name: 'stg_tmo_nas_daily_dashboard', map_key_column: 'id', nl_business_rule: '', session_id: '69a3d22f26e208edc083a06e', label: 'NAS Daily Dashboard Entry', map_sql_template: 'SELECT "id", "region", "market", "project_category", "sow", "nest_type", "session_id", "site_id", "on_site", "company_name", "activity", "activity_status", "current_layers_sector_status", "checkin_latest_start_time", "checkout_os", "totalActivity_duration", "initial_nest_approved", "nest_extension_hrs", "nest_extension_approver", "pre_rtwp", "post_rtwp", "pre_alarm", "pre_2g_3g_alarm", "post_2g_3g_alarm", "post_alarm", "warroom_comments", "create_uid", "create_date", "write_uid", "write_date" FROM "public"."stg_tmo_nas_daily_dashboard"', map_label_column: 'session_id', nl_description: 'Shift-level war room snapshot row for an NAS integration session (daily-refreshed operational view). Grain: 1 row per NAS session (not per day). Enriches Integration Activity with real-time RF quality signals (pre/post RTWP, pre/post alarm states across layers, sector/layer status) and free-text war room comments. Contains timestamps for latest check-in start and checkout on-site. Includes nest_type as an attribute (NSI/SI) but has no direct outage/workorder FK; outage linkage is via site+time inference if needed.', map_contract: '{"function_name": "get_nas_daily_dashboard_entry", "node_type": "core", "node_id": "nas_daily_dashboard_entry", "node_label": "NAS Daily Dashboard Entry", "description": "Query NAS Daily Dashboard Entry data from stg_tmo_nas_daily_dashboard", "parameters": [{"name": "id", "type": "number", "description": "Filter by id (primary key)", "required": false, "sample_values": ["400000", "400001", "400002"]}, {"name": "session_id", "type": "string", "description": "Filter by session_id", "required": false, "sample_values": ["300000", "300001", "300002"]}, {"name": "region", "type": "string", "description": "Filter by region", "required": false, "sample_values": ["Central"]}, {"name": "project_category", "type": "string", "description": "Filter by project_category", "required": false, "sample_values": []}, {"name": "activity_status", "type": "string", "description": "Filter by activity_status", "required": false, "sample_values": ["Completed"]}, {"name": "current_layers_sector_status", "type": "string", "description": "Filter by current_layers_sector_status", "required": false, "sample_values": ["Pending"]}, {"name": "market", "type": "string", "description": "Filter by market", "required": false, "sample_values": ["Chicago", "Detroit", "Indianapolis"]}, {"name": "nest_type", "type": "string", "description": "Filter by nest_type", "required": false, "sample_values": ["shoulder", "gas"]}, {"name": "sow", "type": "string", "description": "Filter by sow", "required": false, "sample_values": ["go"]}, {"name": "on_site", "type": "string", "description": "Filter by on_site", "required": false, "sample_values": ["control"]}, {"name": "activity", "type": "string", "description": "Filter by activity", "required": false, "sample_values": ["across"]}, {"name": "checkout_os", "type": "string", "description": "Filter by checkout_os", "required": false, "sample_values": ["2026-02-10 08:01:58"]}], "output_columns": [{"name": "id", "type": "number", "nullable": false}, {"name": "region", "type": "string", "nullable": false}, {"name": "market", "type": "string", "nullable": false}, {"name": "project_category", "type": "string", "nullable": true}, {"name": "sow", "type": "string", "nullable": true}, {"name": "nest_type", "type": "string", "nullable": true}, {"name": "session_id", "type": "string", "nullable": false}, {"name": "site_id", "type": "string", "nullable": false}, {"name": "on_site", "type": "string", "nullable": true}, {"name": "company_name", "type": "string", "nullable": false}, {"name": "activity", "type": "string", "nullable": true}, {"name": "activity_status", "type": "string", "nullable": true}, {"name": "current_layers_sector_status", "type": "string", "nullable": true}, {"name": "checkin_latest_start_time", "type": "string", "nullable": false}, {"name": "checkout_os", "type": "string", "nullable": true}, {"name": "totalActivity_duration", "type": "string", "nullable": false}, {"name": "initial_nest_approved", "type": "string", "nullable": true}, {"name": "nest_extension_hrs", "type": "string", "nullable": true}, {"name": "nest_extension_approver", "type": "string", "nullable": true}, {"name": "pre_rtwp", "type": "string", "nullable": true}, {"name": "post_rtwp", "type": "string", "nullable": true}, {"name": "pre_alarm", "type": "string", "nullable": false}, {"name": "pre_2g_3g_alarm", "type": "string", "nullable": true}, {"name": "post_2g_3g_alarm", "type": "string", "nullable": true}, {"name": "post_alarm", "type": "string", "nullable": false}, {"name": "warroom_comments", "type": "string", "nullable": false}, {"name": "create_uid", "type": "number", "nullable": false}, {"name": "create_date", "type": "string", "nullable": false}, {"name": "write_uid", "type": "number", "nullable": false}, {"name": "write_date", "type": "string", "nullable": false}], "sample_output": [], "row_count": 3}', entity_type: 'transaction', node_type: 'CORE', map_python_function: 'def get_nas_daily_dashboard_entry(execute_query: callable, filters: dict = None) -> list[dict]:\n    """Fetch NAS Daily Dashboard Entry records.\n\n    Node: NAS Daily Dashboard Entry | Table: stg_tmo_nas_daily_dashboard | Key: id | DB: public\n\n    Supported filters (curated):\n      - session_id, site_id, market, region, company_name, activity_status, nest_type\n      - checkin_start_from, checkin_start_to (applied to checkin_latest_start_time)\n\n    Notes:\n      - Date filters expect ISO-8601 strings (e.g., \'2026-02-01\' or \'2026-02-01T00:00:00\').\n      - Unknown filter keys are ignored (to avoid accidental SQL injection via column names).\n    """\n\n    base_sql = (\n        \'SELECT \'\n        \'"id", "region", "market", "project_category", "sow", "nest_type", "session_id", "site_id", \'\n        \'"on_site", "company_name", \'\n        \'"activity", "activity_status", "current_layers_sector_status", \'\n        \'"checkin_latest_start_time", "checkout_os", "totalActivity_duration", \'\n        \'"initial_nest_approved", "nest_extension_hrs", "nest_extension_approver", \'\n        \'"pre_rtwp", "post_rtwp", "pre_alarm", "pre_2g_3g_alarm", "post_2g_3g_alarm", "post_alarm", \'\n        \'"warroom_comments", "create_uid", "create_date", "write_uid", "write_date" \'\n        \'FROM "public"."stg_tmo_nas_daily_dashboard"\'\n    )\n\n    allowed_equals = {\n        "session_id",\n        "site_id",\n        "market",\n        "region",\n        "company_name",\n        "activity_status",\n        "nest_type",\n    }\n\n    where_parts = []\n\n    def _escape(val: str) -> str:\n        return str(val).replace("\'", "\'\'")\n\n    if filters:\n        # equality filters\n        for key in allowed_equals:\n            if key in filters and filters[key] is not None:\n                where_parts.append(f\'"{key}" = \\\'{_escape(filters[key])}\\\'\')\n            elif key in filters and filters[key] is None:\n                where_parts.append(f\'"{key}" IS NULL\')\n\n        # date range filters on checkin_latest_start_time\n        if filters.get("checkin_start_from") is not None:\n            where_parts.append(\n                f\'"checkin_latest_start_time" >= \\\'{_escape(filters["checkin_start_from"])}\\\'\'\n            )\n        if filters.get("checkin_start_to") is not None:\n            where_parts.append(\n                f\'"checkin_latest_start_time" <= \\\'{_escape(filters["checkin_start_to"])}\\\'\'\n            )\n\n    if where_parts:\n        base_sql += " WHERE " + " AND ".join(where_parts)\n\n    rows = execute_query(base_sql)\n    return rows if rows else []\n', is_skipped: false, name: 'nas_daily_dashboard_entry', definition: 'Shift-level war room snapshot row for an NAS integration session (daily-refreshed operational view). Grain: 1 row per NAS session (not per day). Enriches Integration Activity with real-time RF quality signals (pre/post RTWP, pre/post alarm states across layers, sector/layer status) and free-text war room comments. Contains timestamps for latest check-in start and checkout on-site. Includes nest_type as an attribute (NSI/SI) but has no direct outage/workorder FK; outage linkage is via site+time inference if needed.', map_database_name: 'public', skip_reason: '', status: 'mentioned', node_id: 'nas_daily_dashboard_entry'});
