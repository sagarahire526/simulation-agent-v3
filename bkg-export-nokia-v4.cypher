MATCH (a:BKGNode {session_id: '69a3d22f26e208edc083a06e', node_id: 'site'}), (b:BKGNode {session_id: '69a3d22f26e208edc083a06e', node_id: 'quality_session_ndpc'}) CREATE (a)-[:RELATES_TO {relationship_type: 'HAS_QUALITY_SESSION', edge_id: '4df828d8-263e-4f68-b8e7-066f70cb38f0', session_id: '69a3d22f26e208edc083a06e', style: 'solid', relationship: 'has_quality_session', status: 'confirmed'}]->(b);
MATCH (a:BKGNode {session_id: '69a3d22f26e208edc083a06e', node_id: 'site'}), (b:BKGNode {session_id: '69a3d22f26e208edc083a06e', node_id: 'general_contractor'}) CREATE (a)-[:RELATES_TO {relationship_type: 'HAS_ASSIGNED_GC', edge_id: '424ba50a-a1fa-4475-90a1-bd0c26668e61', session_id: '69a3d22f26e208edc083a06e', style: 'solid', relationship: 'has_assigned_gc', status: 'confirmed'}]->(b);
MATCH (a:BKGNode {session_id: '69a3d22f26e208edc083a06e', node_id: 'site'}), (b:BKGNode {session_id: '69a3d22f26e208edc083a06e', node_id: 'market'}) CREATE (a)-[:RELATES_TO {relationship_type: 'IS_IN_MARKET', edge_id: 'bb4cc468-7aef-4097-97ac-37ce47a0903d', session_id: '69a3d22f26e208edc083a06e', style: 'solid', relationship: 'is_in_market', status: 'confirmed'}]->(b);
MATCH (a:BKGNode {session_id: '69a3d22f26e208edc083a06e', node_id: 'project'}), (b:BKGNode {session_id: '69a3d22f26e208edc083a06e', node_id: 'general_contractor_assignment'}) CREATE (a)-[:RELATES_TO {relationship_type: 'HAS_GC_ASSIGNMENT', edge_id: 'bc2f3aa0-6066-462b-9305-9a227e8abb94', session_id: '69a3d22f26e208edc083a06e', style: 'solid', relationship: 'has_gc_assignment', status: 'confirmed'}]->(b);
MATCH (a:BKGNode {session_id: '69a3d22f26e208edc083a06e', node_id: 'project'}), (b:BKGNode {session_id: '69a3d22f26e208edc083a06e', node_id: 'customer'}) CREATE (a)-[:RELATES_TO {relationship_type: 'IS_FOR_CUSTOMER', edge_id: 'f15cfff8-a9f5-453f-af69-eae2d51d238e', session_id: '69a3d22f26e208edc083a06e', style: 'solid', relationship: 'is_for_customer', status: 'confirmed'}]->(b);
