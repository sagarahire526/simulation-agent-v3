CREATE (:BKGNode {node_id: 'workflow_phase', session_id: '6a079b6bc1ea92432985ef54', name: 'workflow_phase', label: 'Workflow Phase', node_type: 'CORE', entity_type: 'reference', status: 'confirmed', definition: 'A phase of the NAS site-delivery lifecycle. Six phases in total: Site Assignment, INTP (Integration Pre-requisites), Construction, Tower Construction, Integration, and Post Integration.', nl_description: 'A phase of the NAS site-delivery lifecycle. Six phases in total: Site Assignment, INTP (Integration Pre-requisites), Construction, Tower Construction, Integration, and Post Integration.', nl_business_rule: 'Workflow Phase represents the major stage of the NAS site-delivery lifecycle, from site assignment through integration and post-integration. It helps answer where a site or project currently sits in delivery and how work, progress, or delays compare across stages. It can be analyzed by phase, site, and delivery timeline.', is_skipped: false, skip_reason: '', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'phase_id', map_label_column: 'phase_name', map_sql_template: 'Returns the 6 ordered NAS workflow phases with their step counts. No Postgres source\u003B reference data.', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\nWORKFLOW_PHASES = [{\'phase_id\': 1, \'phase_name\': \'Site Assignment\', \'step_count\': 2}, {\'phase_id\': 6, \'phase_name\': \'INTP (Integration Pre-requisites)\', \'step_count\': 3}, {\'phase_id\': 8, \'phase_name\': \'Construction\', \'step_count\': 8}, {\'phase_id\': 10, \'phase_name\': \'Tower Construction\', \'step_count\': 1}, {\'phase_id\': 11, \'phase_name\': \'Integration\', \'step_count\': 9}, {\'phase_id\': 12, \'phase_name\': \'Post Integration\', \'step_count\': 6}]\n# ─────────── end inlined prelude ───────────\n\ndef get_workflow_phase(execute_query, filters=None):\n    """Workflow Phase — 6 phases of the NAS site-delivery lifecycle.\n    Filters honoured: phase_id, phase_name (ILIKE).\n    """\n    filters = filters or {}\n    rows = list(WORKFLOW_PHASES)\n    pid = filters.get("phase_id")\n    if pid is not None:\n        try:\n            pid_int = int(pid)\n            rows = [r for r in rows if r.get("phase_id") == pid_int]\n        except (TypeError, ValueError):\n            rows = []\n    pname = filters.get("phase_name")\n    if pname:\n        rows = [r for r in rows if pname.lower() in (r.get("phase_name") or "").lower()]\n    return rows\n', filters: '[{"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_workflow_phase", "node_type": "core", "node_id": "workflow_phase", "node_label": "Workflow Phase", "description": "A phase of the NAS site-delivery lifecycle. Six phases in total: Site Assignment, INTP (Integration Pre-requisites), Construction, Tower Construction, Integration, and Post Integration.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'workflow_step', session_id: '6a079b6bc1ea92432985ef54', name: 'workflow_step', label: 'Workflow Step', node_type: 'CORE', entity_type: 'reference', status: 'confirmed', definition: 'An individual step in the NAS workflow (29 total, e.g. \'NAS Check in × Rejection\', \'e911 call testing Final Green\'). Carries its parent phase, dependency list, and the staging table that feeds it.', nl_description: 'An individual step in the NAS workflow (29 total, e.g. \'NAS Check in × Rejection\', \'e911 call testing Final Green\'). Carries its parent phase, dependency list, and the staging table that feeds it.', nl_business_rule: 'Workflow Step represents a single task in the NAS workflow, such as a check-in, testing, approval, or rejection step. It helps answer where a job sits in the process, what must happen next, and which prior steps it depends on. You can analyze workflow steps by parent phase, dependency relationships, and individual step.', is_skipped: false, skip_reason: '', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'step_id', map_label_column: 'step_name', map_sql_template: 'Returns the 29 ordered NAS workflow steps with their parent phase, upstream dependencies, source-table mapping and filter rules. No Postgres source\u003B reference data.', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\nWORKFLOW_STEPS = [{\'step_id\': 0, \'name\': \'Sites Input from TMO NAS MBT\', \'step_description\': \'Sites Input\', \'phase_id\': 1, \'phase_name\': \'Site Assignment\', \'category\': [\'Project Ops\', \'PC (IA/GR/CA)\'], \'enabled\': True, \'depends_on\': [], \'merge_strategy\': \'union\', \'filter_enabled\': True, \'filter_criteria\': {\'enabled\': True, \'conditional_logic\': \'AND\', \'rules\': [{\'source_table\': \'stg_tmo_nas_mbt\', \'primary_key_column\': \'s_site_id\', \'column_name\': \'s_site_id\', \'operator\': \