CREATE (:BKGNode {node_id: 'kpi_rf010_completion_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_rf010_completion_rate', label: 'RF010 Completion Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: '% RF010 tasks with activity_tracker_state=\'Completed\', plus count of on-air (mb_status=\'Done\').', nl_description: '% RF010 tasks with activity_tracker_state=\'Completed\', plus count of on-air (mb_status=\'Done\').', nl_business_rule: 'Percentage of RF010 tasks reaching activity_tracker_state = ’Completed’, plus count of fully on-air sites (mb_status = ’Done’). The leading indicator of post-integration throughput.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_rf010_completion_rate', kpi_name: 'RF010 Completion Rate', kpi_description: '% RF010 tasks with activity_tracker_state=\'Completed\', plus count of on-air (mb_status=\'Done\').', kpi_formula_description: '100 * COUNT FILTER (tracker_state=\'Completed\') / COUNT(*)', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\':