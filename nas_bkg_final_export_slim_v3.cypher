CREATE (:BKGNode {node_id: 'kpi_nas_assignment_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_nas_assignment_count', label: 'NAS Assignment Count', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Distinct sites assigned to NAS, grouped by derived region × market × project category.', nl_description: 'Distinct sites assigned to NAS, grouped by derived region × market × project category.', nl_business_rule: 'Counts distinct sites assigned to NAS, grouped by region × market × project category. Region is derived from nas_market via a canonical mapping (West / South / Central). Sites with NULL market produce a NULL region bucket — these are flagged for triage.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_nas_assignment_count', kpi_name: 'NAS Assignment Count', kpi_description: 'Distinct sites assigned to NAS, grouped by derived region × market × project category.', kpi_formula_description: 'COUNT(DISTINCT nas_site_id) FROM stg_nas_session_level_combined_data, region derived from nas_market via canonical mapping', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\nDERIVED_REGION_SQL = \'\\nCASE\\n  WHEN "nas_market" IN (\\\'Seattle\\\',\\\'Phoenix\\\',\\\'Inland west\\\',\\\'Spokane\\\',\\\'Montana\\\',\\\'Portland\\\',\\\'Las Vegas-Ericsson\\\') THEN \\\'West\\\'\\n  WHEN "nas_market" IN (\\\'Atlanda\\\',\\\'Atlanta\\\',\\\'Austin\\\',\\\'Dallas\\\',\\\'BHM-MEM\\\',\\\'Mobile\\\',\\\'Puretorico\\\',\\\'PuertoRico\\\',\\\'Houston\\\') THEN \\\'South\\\'\\n  WHEN "nas_market" IN (\\\'Chicago\\\',\\\'Milwaukee\\\',\\\'Detroit\\\',\\\'Minneapolis\\\',\\\'Denver\\\',\\\'Dakotas\\\',\\\'Omaha\\\',\\\'Desmoines\\\',\\\'Des Moines\\\',\\\'Okalahoma\\\',\\\'Oklahoma\\\',\\\'KansasCity\\\',\\\'Arkansas\\\',\\\'Indianapolis\\\',\\\'Wichita\\\',\\\'Tulsa\\\',\\\'St.Louis\\\',\\\'StLouis\\\',\\\'Columbus\\\',\\\'Cleavland\\\',\\\'Cleveland\\\',\\\'Nasville\\\',\\\'Nashville\\\',\\\'Louisville\\\',\\\'Knoxville\\\',\\\'West virgina\\\',\\\'WestVirginia\\\',\\\'Cincinnati\\\',\\\'Cincinatti\\\',\\\'Pitturburg\\\',\\\'Pittsburgh\\\') THEN \\\'Central\\\'\\n  ELSE NULL\\nEND\\n\'\n# ─────────── end inlined prelude ───────────\n\ndef get_nas_assignment_count(execute_query, filters=None):\n    """KPI 1 — Project Assignment to NAS: distinct sites assigned, by derived region × market × project category."""\n    where, params = apply_filters("stg_nas_session_level_combined_data", filters)\n    sql = f"""\n        SELECT\n            {DERIVED_REGION_SQL} AS region,\n            "nas_market" AS market,\n            "nas_project_category" AS project_category,\n            COUNT(DISTINCT "nas_site_id") AS site_count\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2, 3\n        ORDER BY site_count DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['site', 'nas_session', 'project'], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_site_id', 'nas_market', 'nas_project_category'], kpi_dimensions: ['region', 'market', 'project_category'], kpi_business_logic: '"COUNT(DISTINCT nas_site_id) FROM stg_nas_session_level_combined_data, region derived from nas_market via canonical mapping"', kpi_filters: '[{"name": "region", "type": "string", "description": "filter by NAS region"}, {"name": "area", "type": "string", "description": "filter by area"}, {"name": "market", "type": "string", "description": "filter by NAS market"}, {"name": "gc_name", "type": "string", "description": "filter by General Contractor"}, {"name": "start_date", "type": "date", "description": "start of time range"}, {"name": "end_date", "type": "date", "description": "end of time range"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_nas_assignment_count", "node_type": "kpi", "node_id": "kpi_nas_assignment_count", "node_label": "NAS Assignment Count", "description": "Distinct sites assigned to NAS, grouped by derived region \\u00d7 market \\u00d7 project category.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_nas_session_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_nas_session_count', label: 'NAS Session Count', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Distinct NAS sessions where check-in (nas_nest_start_time) has occurred.', nl_description: 'Distinct NAS sessions where check-in (nas_nest_start_time) has occurred.', nl_business_rule: 'Counts distinct NAS sessions where check-in has occurred (nas_nest_start_time IS NOT NULL). Sessions without a check-in are excluded as they represent assignment-only rows, not work performed.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_nas_session_count', kpi_name: 'NAS Session Count', kpi_description: 'Distinct NAS sessions where check-in (nas_nest_start_time) has occurred.', kpi_formula_description: 'COUNT(DISTINCT nas_session_id) WHERE nas_nest_start_time IS NOT NULL', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_nas_session_count(execute_query, filters=None):\n    """KPI 2 — total distinct NAS sessions where check-in has occurred."""\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_nest_start_time",\n        extra_required=[\'"nas_nest_start_time" IS NOT NULL\'],\n    )\n    sql = f"""\n        SELECT\n            "nas_market" AS market,\n            "nas_project_category" AS project_category,\n            COUNT(DISTINCT "nas_session_id") AS session_count\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY session_count DESC\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session'], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_session_id', 'nas_nest_start_time', 'nas_market', 'nas_project_category'], kpi_dimensions: ['market', 'project_category'], kpi_business_logic: '"COUNT(DISTINCT nas_session_id) WHERE nas_nest_start_time IS NOT NULL"', kpi_filters: '[{"name": "region", "type": "string", "description": "filter by NAS region"}, {"name": "area", "type": "string", "description": "filter by area"}, {"name": "market", "type": "string", "description": "filter by NAS market"}, {"name": "gc_name", "type": "string", "description": "filter by General Contractor"}, {"name": "start_date", "type": "date", "description": "start of time range"}, {"name": "end_date", "type": "date", "description": "end of time range"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_nas_session_count", "node_type": "kpi", "node_id": "kpi_nas_session_count", "node_label": "NAS Session Count", "description": "Distinct NAS sessions where check-in (nas_nest_start_time) has occurred.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_checkout_turnaround', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_checkout_turnaround', label: 'Check-out Turnaround Time', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Average / p50 / p95 minutes between checkout request and approval.', nl_description: 'Average / p50 / p95 minutes between checkout request and approval.', nl_business_rule: 'Measures avg / p50 / p95 minutes from checkout request to approval. Sessions with checkout_approve_time before checkout_time are filtered out as data anomalies. Used to detect markets running over the 15-minute checkout SLA.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_checkout_turnaround', kpi_name: 'Check-out Turnaround Time', kpi_description: 'Average / p50 / p95 minutes between checkout request and approval.', kpi_formula_description: 'AVG(EPOCH(nas_checkout_approve_time - nas_checkout_time)/60)', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_checkout_turnaround(execute_query, filters=None):\n    """KPI 3 — Checkout turnaround time = approve_time - checkout_time (minutes), by market.\n    Returns avg, p50, p95, count.\n    """\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_checkout_time",\n        extra_required=[\n            \'"nas_checkout_time" IS NOT NULL\',\n            \'"nas_checkout_approve_time" IS NOT NULL\',\n            \'"nas_checkout_approve_time"::timestamp >= "nas_checkout_time"::timestamp\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            "nas_market" AS market,\n            COUNT(*) AS sessions,\n            ROUND(AVG(EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_checkout_time"::timestamp))/60.0)::numeric, 2) AS avg_turnaround_minutes,\n            ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_checkout_time"::timestamp))/60.0))::numeric, 2) AS p50_minutes,\n            ROUND((PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_checkout_time"::timestamp))/60.0))::numeric, 2) AS p95_minutes\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE {where}\n        GROUP BY 1\n        ORDER BY avg_turnaround_minutes DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session'], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_checkout_time', 'nas_checkout_approve_time', 'nas_market'], kpi_dimensions: ['market'], kpi_business_logic: '"AVG(EPOCH(nas_checkout_approve_time - nas_checkout_time)/60)"', kpi_filters: '[{"name": "region", "type": "string", "description": "filter by NAS region"}, {"name": "area", "type": "string", "description": "filter by area"}, {"name": "market", "type": "string", "description": "filter by NAS market"}, {"name": "gc_name", "type": "string", "description": "filter by General Contractor"}, {"name": "start_date", "type": "date", "description": "start of time range"}, {"name": "end_date", "type": "date", "description": "end of time range"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_checkout_turnaround", "node_type": "kpi", "node_id": "kpi_checkout_turnaround", "node_label": "Check-out Turnaround Time", "description": "Average / p50 / p95 minutes between checkout request and approval.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_checkout_sla_compliance', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_checkout_sla_compliance', label: 'Check-out SLA Compliance Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: '% of checkouts whose turnaround time is within 15 minutes.', nl_description: '% of checkouts whose turnaround time is within 15 minutes.', nl_business_rule: 'Percentage of checkouts whose approval landed within 15 minutes of the request. Threshold: ≥70% to pass; markets below 70% are flagged for investigation. Compliance is computed per market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_checkout_sla_compliance', kpi_name: 'Check-out SLA Compliance Rate', kpi_description: '% of checkouts whose turnaround time is within 15 minutes.', kpi_formula_description: '100 * COUNT(*) FILTER (turnaround <= 15min) / COUNT(*)', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_checkout_sla_compliance(execute_query, filters=None):\n    """KPI 4 — % checkouts with turnaround ≤ 15 minutes (Check-Out SLA Compliance Rate)."""\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_checkout_time",\n        extra_required=[\n            \'"nas_checkout_time" IS NOT NULL\',\n            \'"nas_checkout_approve_time" IS NOT NULL\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            "nas_market" AS market,\n            COUNT(*) AS total_checkouts,\n            COUNT(*) FILTER (\n                WHERE EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_checkout_time"::timestamp))/60.0 <= 15\n            ) AS within_sla,\n            ROUND(100.0 * COUNT(*) FILTER (\n                WHERE EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_checkout_time"::timestamp))/60.0 <= 15\n            ) / NULLIF(COUNT(*), 0), 2) AS sla_compliance_pct\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE {where}\n        GROUP BY 1\n        ORDER BY sla_compliance_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session'], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_checkout_time', 'nas_checkout_approve_time'], kpi_dimensions: ['market'], kpi_business_logic: '"100 * COUNT(*) FILTER (turnaround <= 15min) / COUNT(*)"', kpi_filters: '[{"name": "region", "type": "string", "description": "filter by NAS region"}, {"name": "area", "type": "string", "description": "filter by area"}, {"name": "market", "type": "string", "description": "filter by NAS market"}, {"name": "gc_name", "type": "string", "description": "filter by General Contractor"}, {"name": "start_date", "type": "date", "description": "start of time range"}, {"name": "end_date", "type": "date", "description": "end of time range"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_checkout_sla_compliance", "node_type": "kpi", "node_id": "kpi_checkout_sla_compliance", "node_label": "Check-out SLA Compliance Rate", "description": "% of checkouts whose turnaround time is within 15 minutes.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_rejection_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_rejection_rate', label: 'NAS Rejection Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: '% of NAS log events that are rejections, broken down into check-in and check-out rejections.', nl_description: '% of NAS log events that are rejections, broken down into check-in and check-out rejections.', nl_business_rule: 'Percentage of NAS log events that are rejections (Nest Rejected + Conditional Approval-Rejected). Broken down by check-in vs checkout rejection. Markets exceeding ~10% rejection rate trigger root-cause analysis via Event Diagnoser.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_rejection_rate', kpi_name: 'NAS Rejection Rate', kpi_description: '% of NAS log events that are rejections, broken down into check-in and check-out rejections.', kpi_formula_description: 'COUNT(rejection_events) / COUNT(*) — rejection_events = nas_event_type IN (\'Nest Rejected\',\'Conditional Approval-Rejected\')', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_rejection_rate(execute_query, filters=None):\n    """KPI 5 — NAS Rejection rate: rejection events / total events, by market."""\n    where, params = apply_filters(\n        "stg_nas_log_data", filters, time_column="nas_event_time",\n    )\n    sql = f"""\n        SELECT\n            "nas_region" AS region,\n            "nas_market" AS market,\n            COUNT(*) AS total_events,\n            COUNT(*) FILTER (WHERE "nas_event_type" IN (\'Nest Rejected\',\'Conditional Approval-Rejected\')) AS rejection_events,\n            COUNT(*) FILTER (WHERE "nas_event_type" = \'Nest Rejected\') AS check_in_rejections,\n            COUNT(*) FILTER (WHERE "nas_event_type" = \'Conditional Approval-Rejected\') AS check_out_rejections,\n            ROUND(100.0 * COUNT(*) FILTER (WHERE "nas_event_type" IN (\'Nest Rejected\',\'Conditional Approval-Rejected\'))\n                  / NULLIF(COUNT(*), 0), 2) AS rejection_rate_pct\n        FROM {fq("stg_nas_log_data")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2\n        ORDER BY rejection_rate_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_log_event', 'rejection_event'], kpi_source_tables: ['stg_nas_log_data'], kpi_source_columns: ['nas_event_type', 'nas_region', 'nas_market'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"COUNT(rejection_events) / COUNT(*) \\u2014 rejection_events = nas_event_type IN (’Nest Rejected’,’Conditional Approval-Rejected’)"', kpi_filters: '[{"name": "region", "type": "string", "description": "filter by NAS region"}, {"name": "area", "type": "string", "description": "filter by area"}, {"name": "market", "type": "string", "description": "filter by NAS market"}, {"name": "gc_name", "type": "string", "description": "filter by General Contractor"}, {"name": "start_date", "type": "date", "description": "start of time range"}, {"name": "end_date", "type": "date", "description": "end of time range"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_rejection_rate", "node_type": "kpi", "node_id": "kpi_rejection_rate", "node_label": "NAS Rejection Rate", "description": "% of NAS log events that are rejections, broken down into check-in and check-out rejections.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_nest_extension_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_nest_extension_rate', label: 'NEST Extension Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: '% of sessions that needed a NEST extension, by market × vendor.', nl_description: '% of sessions that needed a NEST extension, by market × vendor.', nl_business_rule: 'Percentage of sessions that required a NEST extension, grouped by market × vendor. Vendors with persistently high extension rates indicate either scope-estimation issues or operational inefficiency — they’re surfaced to the Workload Optimizer.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_nest_extension_rate', kpi_name: 'NEST Extension Rate', kpi_description: '% of sessions that needed a NEST extension, by market × vendor.', kpi_formula_description: 'COUNT(DISTINCT session WITH extension) / COUNT(DISTINCT total sessions)', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_nest_extension_rate(execute_query, filters=None):\n    """KPI 6 — % of sessions that needed a NEST extension, by market × vendor."""\n    # Count from nest_ext_raw table; use total sessions as denominator from session table.\n    ext_where, ext_params = apply_filters(\n        "stg_nas_nest_ext_raw_by_session", filters,\n    )\n    sess_where, sess_params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        extra_required=[\'"nas_nest_start_time" IS NOT NULL\'],\n    )\n    # Combine params for the named placeholders (they\'re all the same canonical keys)\n    sql = f"""\n        SELECT\n            COALESCE(ext."nas_market", sess."nas_market") AS market,\n            COALESCE(ext."nas_vendorname", \'UNKNOWN\')      AS vendor,\n            sess.total_sessions,\n            COALESCE(ext.ext_sessions, 0) AS extension_sessions,\n            ROUND(100.0 * COALESCE(ext.ext_sessions, 0) / NULLIF(sess.total_sessions, 0), 2) AS extension_rate_pct\n        FROM (\n            SELECT "nas_market", COUNT(DISTINCT "nas_session_id") AS total_sessions\n            FROM {fq("stg_nas_session_level_combined_data")}\n            WHERE {sess_where}\n            GROUP BY 1\n        ) sess\n        LEFT JOIN (\n            SELECT "nas_market", "nas_vendorname",\n                   COUNT(DISTINCT "nas_session_id") AS ext_sessions\n            FROM {fq("stg_nas_nest_ext_raw_by_session")}\n            {f"WHERE {ext_where}" if ext_where else ""}\n            GROUP BY 1, 2\n        ) ext ON ext."nas_market" = sess."nas_market"\n        ORDER BY extension_rate_pct DESC NULLS LAST\n    """\n    # ext_params + sess_params should be identical because they use the same canonical keys\n    merged = {**ext_params, **sess_params}\n    return execute_query(sql, merged)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'nest_extension'], kpi_source_tables: ['stg_nas_session_level_combined_data', 'stg_nas_nest_ext_raw_by_session'], kpi_source_columns: ['nas_session_id', 'nas_market', 'nas_vendorname'], kpi_dimensions: ['market', 'vendor'], kpi_business_logic: '"COUNT(DISTINCT session WITH extension) / COUNT(DISTINCT total sessions)"', kpi_filters: '[{"name": "region", "type": "string", "description": "filter by NAS region"}, {"name": "area", "type": "string", "description": "filter by area"}, {"name": "market", "type": "string", "description": "filter by NAS market"}, {"name": "gc_name", "type": "string", "description": "filter by General Contractor"}, {"name": "start_date", "type": "date", "description": "start of time range"}, {"name": "end_date", "type": "date", "description": "end of time range"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_nest_extension_rate", "node_type": "kpi", "node_id": "kpi_nest_extension_rate", "node_label": "NEST Extension Rate", "description": "% of sessions that needed a NEST extension, by market \\u00d7 vendor.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_e911_readiness_index', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_e911_readiness_index', label: 'E911 Readiness Index', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Count + % of sites with E911 readiness = Ready (or Ready_Completed), by region × market.', nl_description: 'Count + % of sites with E911 readiness = Ready (or Ready_Completed), by region × market.', nl_business_rule: 'Percentage of sites with nas_validate_e911_readiness matching ’Ready%’ on the validation date. Sites below the regional baseline are escalated to RIOT / CBN / PSAP remediation.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_e911_readiness_index', kpi_name: 'E911 Readiness Index', kpi_description: 'Count + % of sites with E911 readiness = Ready (or Ready_Completed), by region × market.', kpi_formula_description: '100 * COUNT(DISTINCT nas_site_id) FILTER (nas_validate_e911_readiness ILIKE \'Ready%\') / COUNT(DISTINCT nas_site_id)', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_e911_readiness_index(execute_query, filters=None):\n    """KPI 7 — count of sites with E911 readiness = \'Ready\', plus readiness % per market."""\n    where, params = apply_filters(\n        "stg_nas_e911_readiness_riot_validation", filters,\n        time_column="nas_e911_validation_date",\n    )\n    sql = f"""\n        SELECT\n            "nas_region" AS region,\n            "nas_market" AS market,\n            COUNT(DISTINCT "nas_site_id") AS total_sites,\n            COUNT(DISTINCT "nas_site_id") FILTER (\n                WHERE "nas_validate_e911_readiness" ILIKE \'Ready%%\'\n            ) AS ready_sites,\n            ROUND(100.0 * COUNT(DISTINCT "nas_site_id") FILTER (\n                WHERE "nas_validate_e911_readiness" ILIKE \'Ready%%\'\n            ) / NULLIF(COUNT(DISTINCT "nas_site_id"), 0), 2) AS ready_pct\n        FROM {fq("stg_nas_e911_readiness_riot_validation")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2\n        ORDER BY ready_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e911_validation', 'site'], kpi_source_tables: ['stg_nas_e911_readiness_riot_validation'], kpi_source_columns: ['nas_site_id', 'nas_validate_e911_readiness', 'nas_region', 'nas_market'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"100 * COUNT(DISTINCT nas_site_id) FILTER (nas_validate_e911_readiness ILIKE ’Ready%’) / COUNT(DISTINCT nas_site_id)"', kpi_filters: '[{"name": "region", "type": "string", "description": "filter by NAS region"}, {"name": "area", "type": "string", "description": "filter by area"}, {"name": "market", "type": "string", "description": "filter by NAS market"}, {"name": "gc_name", "type": "string", "description": "filter by General Contractor"}, {"name": "start_date", "type": "date", "description": "start of time range"}, {"name": "end_date", "type": "date", "description": "end of time range"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_e911_readiness_index", "node_type": "kpi", "node_id": "kpi_e911_readiness_index", "node_label": "E911 Readiness Index", "description": "Count + % of sites with E911 readiness = Ready (or Ready_Completed), by region \\u00d7 market.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_e911_ftr_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_e911_ftr_rate', label: 'E911 First-Time-Right Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: '% sites where E911 readiness reached Ready_Completed (treated as FTR proxy).', nl_description: '% sites where E911 readiness reached Ready_Completed (treated as FTR proxy).', nl_business_rule: 'First-time-right proxy: percentage of sites whose readiness reached ’Ready_Completed’ (no re-validation needed). Low FTR indicates upstream INTP gaps — feeds Remediation Planner with the failure layer.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_e911_ftr_rate', kpi_name: 'E911 First-Time-Right Rate', kpi_description: '% sites where E911 readiness reached Ready_Completed (treated as FTR proxy).', kpi_formula_description: '100 * COUNT(DISTINCT nas_site_id) FILTER (nas_validate_e911_readiness ILIKE \'Ready%Complete%\') / COUNT(DISTINCT nas_site_id)', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_e911_ftr_rate(execute_query, filters=None):\n    """KPI 8 — % sites where E911 readiness was Ready_Completed on the validation date (proxy for first-time-right)."""\n    where, params = apply_filters(\n        "stg_nas_e911_readiness_riot_validation", filters,\n        time_column="nas_e911_validation_date",\n    )\n    sql = f"""\n        SELECT\n            "nas_market" AS market,\n            COUNT(DISTINCT "nas_site_id") AS total_sites,\n            COUNT(DISTINCT "nas_site_id") FILTER (\n                WHERE "nas_validate_e911_readiness" ILIKE \'Ready%%Complete%%\'\n            ) AS ftr_sites,\n            ROUND(100.0 * COUNT(DISTINCT "nas_site_id") FILTER (\n                WHERE "nas_validate_e911_readiness" ILIKE \'Ready%%Complete%%\'\n            ) / NULLIF(COUNT(DISTINCT "nas_site_id"), 0), 2) AS ftr_rate_pct\n        FROM {fq("stg_nas_e911_readiness_riot_validation")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1\n        ORDER BY ftr_rate_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e911_validation'], kpi_source_tables: ['stg_nas_e911_readiness_riot_validation'], kpi_source_columns: ['nas_site_id', 'nas_validate_e911_readiness'], kpi_dimensions: ['market'], kpi_business_logic: '"100 * COUNT(DISTINCT nas_site_id) FILTER (nas_validate_e911_readiness ILIKE ’Ready%Complete%’) / COUNT(DISTINCT nas_site_id)"', kpi_filters: '[{"name": "region", "type": "string", "description": "filter by NAS region"}, {"name": "area", "type": "string", "description": "filter by area"}, {"name": "market", "type": "string", "description": "filter by NAS market"}, {"name": "gc_name", "type": "string", "description": "filter by General Contractor"}, {"name": "start_date", "type": "date", "description": "start of time range"}, {"name": "end_date", "type": "date", "description": "end of time range"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_e911_ftr_rate", "node_type": "kpi", "node_id": "kpi_e911_ftr_rate", "node_label": "E911 First-Time-Right Rate", "description": "% sites where E911 readiness reached Ready_Completed (treated as FTR proxy).", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_call_test_completion_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_call_test_completion_rate', label: 'E911 Call Test Completion Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: '% of E2E call tests that completed GREEN, plus RED and PARTIAL counts, per market.', nl_description: '% of E2E call tests that completed GREEN, plus RED and PARTIAL counts, per market.', nl_business_rule: 'Percentage of e2e call tests completing GREEN. RED + PARTIAL counts are returned alongside as work-in-progress indicators. Markets below 90% green are gate-blocked at Phase 11.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_call_test_completion_rate', kpi_name: 'E911 Call Test Completion Rate', kpi_description: '% of E2E call tests that completed GREEN, plus RED and PARTIAL counts, per market.', kpi_formula_description: '100 * COUNT FILTER (status ILIKE \'GREEN\') / COUNT(*)', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_call_test_completion_rate(execute_query, filters=None):\n    """KPI 9 — % of call tests with GREEN result, by market."""\n    where, params = apply_filters(\n        "stg_nas_e2e_call_test_completion", filters,\n        time_column="nas_integration_date",\n    )\n    sql = f"""\n        SELECT\n            "nas_region" AS region,\n            "nas_market" AS market,\n            COUNT(*) AS total_tests,\n            COUNT(*) FILTER (WHERE "nas_call_test_completion_status" ILIKE \'GREEN\') AS green,\n            COUNT(*) FILTER (WHERE "nas_call_test_completion_status" ILIKE \'RED\') AS red,\n            COUNT(*) FILTER (WHERE "nas_call_test_completion_status" ILIKE \'PARTIAL\') AS partial,\n            ROUND(100.0 * COUNT(*) FILTER (WHERE "nas_call_test_completion_status" ILIKE \'GREEN\')\n                  / NULLIF(COUNT(*), 0), 2) AS green_pct\n        FROM {fq("stg_nas_e2e_call_test_completion")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2\n        ORDER BY green_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e2e_call_test'], kpi_source_tables: ['stg_nas_e2e_call_test_completion'], kpi_source_columns: ['nas_call_test_completion_status', 'nas_region', 'nas_market'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"100 * COUNT FILTER (status ILIKE ’GREEN’) / COUNT(*)"', kpi_filters: '[{"name": "region", "type": "string", "description": "filter by NAS region"}, {"name": "area", "type": "string", "description": "filter by area"}, {"name": "market", "type": "string", "description": "filter by NAS market"}, {"name": "gc_name", "type": "string", "description": "filter by General Contractor"}, {"name": "start_date", "type": "date", "description": "start of time range"}, {"name": "end_date", "type": "date", "description": "end of time range"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_call_test_completion_rate", "node_type": "kpi", "node_id": "kpi_call_test_completion_rate", "node_label": "E911 Call Test Completion Rate", "description": "% of E2E call tests that completed GREEN, plus RED and PARTIAL counts, per market.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
