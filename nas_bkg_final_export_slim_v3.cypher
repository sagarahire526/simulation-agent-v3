date\', \'phase_id\': 12, \'phase_name\': \'Post Integration\', \'category\': [\'NAS\'], \'enabled\': True, \'depends_on\': [35], \'merge_strategy\': \'union\', \'filter_enabled\': True, \'filter_criteria\': {\'enabled\': True, \'conditional_logic\': \'AND\', \'rules\': [{\'source_table\': \'stg_ndpd_mbt_tmobile_macro_combined\', \'primary_key_column\': \'s_site_id\', \'column_name\': \'pj_p_5800_l2100_onair_finish\', \'operator\': \'not_null\', \'expected_value\': None, \'description\': \'pj_p_5800_l2100_onair_finish not_null\'}]}, \'computation\': None, \'agent_integration\': None}, {\'step_id\': 37, \'name\': \'On-Air milestones update and final\', \'step_description\': \'On-Air milestones update and final\', \'phase_id\': 12, \'phase_name\': \'Post Integration\', \'category\': [\'NAS\'], \'enabled\': True, \'depends_on\': [36], \'merge_strategy\': \'union\', \'filter_enabled\': True, \'filter_criteria\': {\'enabled\': True, \'conditional_logic\': \'AND\', \'rules\': [{\'source_table\': \'stg_nas_rf010_dashboard\', \'primary_key_column\': \'project_site_id\', \'column_name\': \'mb_status\', \'operator\': \'contains\', \'expected_value\': \'Done\', \'description\': \'mb_status contains\'}]}, \'computation\': None, \'agent_integration\': None}]\n# ─────────── end inlined prelude ───────────\n\ndef get_workflow_step(execute_query, filters=None):\n    """Workflow Step — 29 steps in the NAS lifecycle (with their phase, dependencies,\n    source_table).\n    Filters honoured: step_id, phase_id, phase_name (ILIKE), step_name (ILIKE), source_table.\n    """\n    filters = filters or {}\n    rows = []\n    for s in WORKFLOW_STEPS:\n        fc = s.get("filter_criteria") if isinstance(s.get("filter_criteria"), dict) else None\n        # Derive a simple source_table shortcut from the first rule (when present).\n        rules = (fc or {}).get("rules") or []\n        src_table = rules[0].get("source_table") if rules and isinstance(rules[0], dict) else None\n        rows.append({\n            # Renamed for accessor consistency\n            "step_id": s.get("step_id"),\n            "step_name": s.get("name"),\n            "phase_id": s.get("phase_id"),\n            "phase_name": s.get("phase_name"),\n            "depends_on": s.get("depends_on", []),\n            "source_table": src_table,\n            "description": s.get("step_description"),\n            "enabled": s.get("enabled"),\n            # Full passthrough of every other JSON field so the node mirrors the\n            # Nokia workflow document 1:1 (no data dropped).\n            "category": s.get("category"),\n            "agent_integration": s.get("agent_integration"),\n            "computation": s.get("computation"),\n            "filter_enabled": s.get("filter_enabled"),\n            "merge_strategy": s.get("merge_strategy"),\n            "filter_criteria": fc,\n        })\n    if filters.get("step_id") is not None:\n        try:\n            sid = int(filters["step_id"])\n            rows = [r for r in rows if r.get("step_id") == sid]\n        except (TypeError, ValueError):\n            rows = []\n    if filters.get("phase_id") is not None:\n        try:\n            pid = int(filters["phase_id"])\n            rows = [r for r in rows if r.get("phase_id") == pid]\n        except (TypeError, ValueError):\n            rows = []\n    if filters.get("phase_name"):\n        pn = filters["phase_name"].lower()\n        rows = [r for r in rows if pn in (r.get("phase_name") or "").lower()]\n    if filters.get("step_name"):\n        sn = filters["step_name"].lower()\n        rows = [r for r in rows if sn in (r.get("step_name") or "").lower()]\n    if filters.get("source_table"):\n        rows = [r for r in rows if (r.get("source_table") or "") == filters["source_table"]]\n    return rows\n', filters: '[{"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_workflow_step", "node_type": "core", "node_id": "workflow_step", "node_label": "Workflow Step", "description": "An individual step in the NAS workflow (29 total, e.g. \'NAS Check in \\u00d7 Rejection\', \'e911 call testing Final Green\'). Carries its parent phase, dependency list, and the staging table that feeds it.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'daily_dashboard', session_id: '6a079b6bc1ea92432985ef54', name: 'daily_dashboard', label: 'NAS Daily Dashboard', node_type: 'CORE', entity_type: 'context', status: 'confirmed', definition: 'Daily operational dashboard rollup — region/market/site/session keyed. Independent check-in/out timestamps for cross-validation.', nl_description: 'Daily operational dashboard rollup — region/market/site/session keyed. Independent check-in/out timestamps for cross-validation.', nl_business_rule: 'This node represents the daily operational view of NAS activity across regions, markets, sites, and sessions. It helps answer questions about what happened on a given day, how activity compares across locations, and whether session timing looks complete and credible. It can be broken down by region, market, site, and session, with separate check-in and check-out times available for validation.', is_skipped: false, skip_reason: '', map_table_name: 'stg_tmo_nas_daily_dashboard', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'id', map_label_column: 'site_id', map_sql_template: 'SELECT "id", "region", "market", "site_id", "session_id", "project_category", "activity_status", "current_layers_sector_status" AS layer_status, "checkin_latest_start_time"::timestamp AS checkin_start_time, "checkout_os"::timestamp AS checkout_time FROM "pwc_macro_staging_schema"."stg_tmo_nas_daily_dashboard"', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_daily_dashboard(execute_query, filters=None):\n    """Daily operational rollup — region/market/site/session keyed."""\n    where, params = apply_filters(\n        "stg_tmo_nas_daily_dashboard", filters, time_column="checkin_latest_start_time"\n    )\n    sql = f"""\n        SELECT "id", "region", "market", "site_id", "session_id",\n               "project_category",\n               "activity_status", "current_layers_sector_status" AS layer_status,\n               "checkin_latest_start_time"::timestamp AS checkin_start_time,\n               "checkout_os"::timestamp               AS checkout_time\n        FROM {fq("stg_tmo_nas_daily_dashboard")}\n        {f"WHERE {where}" if where else ""}\n    """\n    return execute_query(sql, params)\n', filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_daily_dashboard", "node_type": "core", "node_id": "daily_dashboard", "node_label": "NAS Daily Dashboard", "description": "Daily operational dashboard rollup \\u2014 region/market/site/session keyed. Independent check-in/out timestamps for cross-validation.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'cbn_validation', session_id: '6a079b6bc1ea92432985ef54', name: 'cbn_validation', label: 'CBN Validation', node_type: 'CORE', entity_type: 'core', status: 'confirmed', definition: 'Per-session record of the Phase-11 RAN-Integration CBN (Code Block Number) validation step. Tracks request time, approve time, validation status and turnaround. Pending rows (request_time IS NOT NULL, approve_time IS NULL) are the canonical CBN tool downtime signal.', nl_description: 'Per-session record of the Phase-11 RAN-Integration CBN (Code Block Number) validation step. Tracks request time, approve time, validation status and turnaround. Pending rows (request_time IS NOT NULL, approve_time IS NULL) are the canonical CBN tool downtime signal.', nl_business_rule: 'CBN Validation represents the per-session check of the Code Block Number step during Phase-11 RAN integration. It helps answer whether validations are completing, how long approval takes, and when the CBN tool may be down based on requests that remain pending. You can analyze it by validation status, request and approval timing, and individual NAS sessions.', is_skipped: false, skip_reason: '', map_table_name: 'stg_nas_session_level_combined_data', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'nas_session_id', map_label_column: 'nas_site_id', map_sql_template: 'SELECT "nas_session_id", "nas_site_id", "nas_market", "nas_project_category", "nas_status_cbn_validation", "nas_cbn_request_time"::timestamp, "nas_cbn_approve_time"::timestamp, derived turnaround_minutes and state ∈ {pending, approved, not_requested} FROM "pwc_macro_staging_schema"."stg_nas_session_level_combined_data" WHERE nas_cbn_request_time IS NOT NULL', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_cbn_validation(execute_query, filters=None):\n    """CBN Validation — per-session record of the Phase-11 Code Block Number\n    validation step (request, approve, status, turnaround). Pending rows\n    (approve_time IS NULL while request_time IS NOT NULL) are the CBN tool\n    downtime signal."""\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_cbn_request_time",\n    )\n    sql = f"""\n        SELECT "nas_session_id" AS session_id,\n               "nas_site_id"    AS site_id,\n               "nas_market"     AS market,\n               "nas_project_category" AS project_category,\n               "nas_status_cbn_validation" AS cbn_status,\n               "nas_cbn_request_time"::timestamp AS cbn_request_time,\n               "nas_cbn_approve_time"::timestamp AS cbn_approve_time,\n               CASE\n                   WHEN "nas_cbn_request_time" IS NOT NULL\n                    AND "nas_cbn_approve_time" IS NOT NULL\n                   THEN EXTRACT(EPOCH FROM (\n                            "nas_cbn_approve_time"::timestamp\n                          - "nas_cbn_request_time"::timestamp)) / 60.0\n                   ELSE NULL\n               END AS turnaround_minutes,\n               CASE\n                   WHEN "nas_cbn_request_time" IS NOT NULL\n                    AND "nas_cbn_approve_time" IS NULL THEN \'pending\'\n                   WHEN "nas_cbn_approve_time" IS NOT NULL THEN \'approved\'\n                   ELSE \'not_requested\'\n               END AS state\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {where}" if where else "WHERE 1=1"}\n          AND "nas_cbn_request_time" IS NOT NULL\n        ORDER BY cbn_request_time DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_cbn_validation", "node_type": "core", "node_id": "cbn_validation", "node_label": "CBN Validation", "description": "Per-session record of the Phase-11 RAN-Integration CBN (Code Block Number) validation step. Tracks request time, approve time, validation status and turnaround. Pending rows (request_time IS NOT NULL, approve_time IS NULL) are the canonical CBN tool downtime signal.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'nas_project_smp_tracker', session_id: '6a079b6bc1ea92432985ef54', name: 'nas_project_smp_tracker', label: 'NAS Project / SMP Tracker', node_type: 'CORE', entity_type: 'reference', status: 'confirmed', definition: 'Per-site map of SMP work-orders and PO metadata (smp_id, smp_name, project_code, description, npo_scope, customer_code, po_requested_by). Lookup table that resolves a site to its NAS engagement details.', nl_description: 'Per-site map of SMP work-orders and PO metadata (smp_id, smp_name, project_code, description, npo_scope, customer_code, po_requested_by). Lookup table that resolves a site to its NAS engagement details.', nl_business_rule: 'This node represents the site-level tracker that links each site to its NAS project and SMP work order details, including project codes, descriptions, scope, customer, and who requested the purchase order. It helps answer which NAS engagement a site belongs to and what commercial or work-order context applies to it. It can be analyzed by site, project or SMP, and customer or requestor.', is_skipped: false, skip_reason: '', map_table_name: 'stg_nas_projectid_and_smpid_tracker', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'site_name', map_label_column: 'smp_name', map_sql_template: 'SELECT "site_name", "smp_id", "smp_name", "project_code", "description", "npo_scope", "customer_code", "po_requested_by", "po_date" FROM "pwc_macro_staging_schema"."stg_nas_projectid_and_smpid_tracker"', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_nas_project_smp_tracker(execute_query, filters=None):\n    """NAS Project/SMP Tracker — per-site map of SMP work-orders and PO metadata.\n\n    Sources stg_nas_projectid_and_smpid_tracker, the canonical lookup for:\n      - smp_id, smp_name        (work-order identity + label)\n      - project_code            (the construction-side project code linked to the site)\n      - description             (PO line description)\n      - npo_scope               (engagement/scope bucket — NAS Services / TMO CnI DIY / etc.)\n      - customer_code, po_requested_by, po_date  (PO header attributes)\n\n    One row per site × po_line so questions like "what SMP names exist for site X"\n    or "how many distinct description / npo_scope values" are answerable.\n    Site-id filter maps to ``site_name`` per TABLE_FILTER_MAPPING.\n    """\n    where, params = apply_filters("stg_nas_projectid_and_smpid_tracker", filters)\n    sql = f"""\n        SELECT\n            "site_name"        AS site_id,\n            "smp_id",\n            "smp_name",\n            "project_code",\n            "description",\n            "npo_scope",\n            "customer_code",\n            "po_requested_by",\n            "po_date"::date    AS po_date\n        FROM {fq("stg_nas_projectid_and_smpid_tracker")}\n        {f"WHERE {where}" if where else ""}\n        ORDER BY "site_name", "smp_id"\n    """\n    return execute_query(sql, params)\n', filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_nas_project_smp_tracker", "node_type": "core", "node_id": "nas_project_smp_tracker", "node_label": "NAS Project / SMP Tracker", "description": "Per-site map of SMP work-orders and PO metadata (smp_id, smp_name, project_code, description, npo_scope, customer_code, po_requested_by). Lookup table that resolves a site to its NAS engagement details.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});

