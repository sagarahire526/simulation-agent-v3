       if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_site(execute_query, filters=None):\n    """Site — canonical 1000-site list from stg_nas_session_level_combined_data.\n    Returns one row per distinct nas_site_id with its NAS-tracked market.\n    """\n    where, params = apply_filters("stg_nas_session_level_combined_data", filters)\n    sql = f"""\n        SELECT DISTINCT "nas_site_id" AS site_id, "nas_market" AS market,\n               "nas_project_category" AS project_category\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {where}" if where else ""}\n        ORDER BY site_id\n    """\n    return execute_query(sql, params)\n', filters: '[{"name": "region", "type": "string", "description": "filter by region", "required": false}, {"name": "area", "type": "string", "description": "filter by area", "required": false}, {"name": "market", "type": "string", "description": "filter by market", "required": false}, {"name": "gc_name", "type": "string", "description": "filter by GC name", "required": false}, {"name": "site_id", "type": "string", "description": "filter by site id", "required": false},