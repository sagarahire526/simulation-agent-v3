CREATE (:BKGNode {node_id: 'kpi_e911_ftr_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_e911_ftr_rate', label: 'E911 First-Time-Right Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: '% sites where E911 readiness reached Ready_Completed (treated as FTR proxy).', nl_description: '% sites where E911 readiness reached Ready_Completed (treated as FTR proxy).', nl_business_rule: 'E911 First-Time-Right Rate measures the share of sites that reached completed E911 readiness, used as a proxy for getting E911 right on the first pass. It helps answer how reliably sites are becoming E911-ready during the integration phase and where readiness performance may be lagging. You can break it down by market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_e911_ftr_rate', kpi_name: 'E911 First-Time-Right Rate', kpi_description: '% sites where E911 readiness reached Ready_Completed (treated as FTR proxy).', kpi_formula_description: '100 * COUNT(DISTINCT nas_site_id) FILTER (nas_validate_e911_readiness ILIKE \'Ready%Complete%\') / COUNT(DISTINCT nas_site_id)', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_e911_ftr_rate(execute_query, filters=None):\n    """KPI 8 — % sites where E911 readiness was Ready_Completed on the validation date (proxy for first-time-right)."""\n    where, params = apply_filters(\n        "stg_nas_e911_readiness_riot_validation", filters,\n        time_column="nas_e911_validation_date",\n    )\n    sql = f"""\n        SELECT\n            "nas_market" AS market,\n            COUNT(DISTINCT "nas_site_id") AS total_sites,\n            COUNT(DISTINCT "nas_site_id") FILTER (\n                WHERE "nas_validate_e911_readiness" ILIKE \'Ready%%Complete%%\'\n            ) AS ftr_sites,\n            ROUND(100.0 * COUNT(DISTINCT "nas_site_id") FILTER (\n                WHERE "nas_validate_e911_readiness" ILIKE \'Ready%%Complete%%\'\n            ) / NULLIF(COUNT(DISTINCT "nas_site_id"), 0), 2) AS ftr_rate_pct\n        FROM {fq("stg_nas_e911_readiness_riot_validation")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1\n        ORDER BY ftr_rate_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e911_validation'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_e911_readiness_riot_validation'], kpi_source_columns: ['nas_site_id', 'nas_validate_e911_readiness'], kpi_dimensions: ['market'], kpi_business_logic: '"100 * COUNT(DISTINCT nas_site_id) FILTER (nas_validate_e911_readiness ILIKE \'Ready%Complete%\') / COUNT(DISTINCT nas_site_id)"', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_e911_ftr_rate", "node_type": "kpi", "node_id": "kpi_e911_ftr_rate", "node_label": "E911 First-Time-Right Rate", "description": "% sites where E911 readiness reached Ready_Completed (treated as FTR proxy).", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_call_test_completion_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_call_test_completion_rate', label: 'E911 Call Test Completion Count & Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Per market: distinct sites assigned for E2E call test, count of tests completed (any status), total tests, status breakdown (GREEN incl. GREEN(DIY) / RED / PARTIAL), and GREEN completion rate %.', nl_description: 'Per market: distinct sites assigned for E2E call test, count of tests completed (any status), total tests, status breakdown (GREEN incl. GREEN(DIY) / RED / PARTIAL), and GREEN completion rate %.', nl_business_rule: 'E911 Call Test Completion Count & Rate shows how many assigned sites have completed end-to-end call testing in each market, and what share achieved a green result. It answers questions about testing progress, completion levels, and overall readiness for E911 validation. It can be broken down by region and market, with results viewed as assigned sites, completed tests, total tests, and status mix.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_call_test_completion_rate', kpi_name: 'E911 Call Test Completion Count & Rate', kpi_description: 'Per market: distinct sites assigned for E2E call test, count of tests completed (any status), total tests, status breakdown (GREEN incl. GREEN(DIY) / RED / PARTIAL), and GREEN completion rate %.', kpi_formula_description: 'assigned_sites=COUNT(DISTINCT site)\u003B completed=COUNT(completed_date NOT NULL)\u003B green_pct=100*COUNT(status IN (\'green\',\'green(diy)\'))/COUNT(*)', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_call_test_completion_rate(execute_query, filters=None):\n    """KPI 9 — call-test completion mix by market.\n\n    Returns per (region, market):\n      - assigned_sites    — COUNT(DISTINCT nas_site_id) in scope (answers "sites assigned")\n      - completed_tests   — COUNT(*) WHERE nas_call_test_completed_date IS NOT NULL\n      - total_tests       — COUNT(*) all rows in scope\n      - green / red / partial — status breakdown (case-insensitive, includes \'GREEN(DIY)\')\n      - green_pct         — % green (the rate signal)\n    The first three columns answer "how many sites/tests" style questions from the\n    semantic question bank\u003B green_pct answers "FTR / completion rate".\n    """\n    where, params = apply_filters(\n        "stg_nas_e2e_call_test_completion", filters,\n        time_column="nas_integration_date",\n    )\n    sql = f"""\n        SELECT\n            "nas_region" AS region,\n            "nas_market" AS market,\n            COUNT(DISTINCT "nas_site_id") AS assigned_sites,\n            COUNT(*) FILTER (WHERE "nas_call_test_completed_date" IS NOT NULL) AS completed_tests,\n            COUNT(*) AS total_tests,\n            COUNT(*) FILTER (WHERE LOWER("nas_call_test_completion_status") IN (\'green\', \'green(diy)\')) AS green,\n            COUNT(*) FILTER (WHERE "nas_call_test_completion_status" ILIKE \'RED\') AS red,\n            COUNT(*) FILTER (WHERE "nas_call_test_completion_status" ILIKE \'PARTIAL\') AS partial,\n            ROUND(100.0 * COUNT(*) FILTER (WHERE LOWER("nas_call_test_completion_status") IN (\'green\', \'green(diy)\'))\n                  / NULLIF(COUNT(*), 0), 2) AS green_pct\n        FROM {fq("stg_nas_e2e_call_test_completion")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2\n        ORDER BY green_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e2e_call_test'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_e2e_call_test_completion'], kpi_source_columns: ['nas_site_id', 'nas_call_test_completion_status', 'nas_call_test_completed_date', 'nas_integration_date', 'nas_region', 'nas_market'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"assigned_sites=COUNT(DISTINCT site)\u003B completed=COUNT(completed_date NOT NULL)\u003B green_pct=100*COUNT(status IN (\'green\',\'green(diy)\'))/COUNT(*)"', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_call_test_completion_rate", "node_type": "kpi", "node_id": "kpi_call_test_completion_rate", "node_label": "E911 Call Test Completion Count & Rate", "description": "Per market: distinct sites assigned for E2E call test, count of tests completed (any status), total tests, status breakdown (GREEN incl. GREEN(DIY) / RED / PARTIAL), and GREEN completion rate %.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_call_test_red_wip', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_call_test_red_wip', label: 'Call Test Red WIP', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Count of RED call tests by engineer × market (work-in-progress backlog).', nl_description: 'Count of RED call tests by engineer × market (work-in-progress backlog).', nl_business_rule: 'Call Test Red WIP measures the number of failed or red call tests currently sitting in the work-in-progress backlog. It helps answer where unresolved call test issues are building up and which engineers or markets need attention. You can break it down by market and engineer to spot concentration of backlog and accountability.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_call_test_red_wip', kpi_name: 'Call Test Red WIP', kpi_description: 'Count of RED call tests by engineer × market (work-in-progress backlog).', kpi_formula_description: 'COUNT(*) WHERE nas_call_test_completion_status ILIKE \'RED\'', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_call_test_red_wip(execute_query, filters=None):\n    """KPI 10 — count of sites currently RED in call test, by engineer × market."""\n    where, params = apply_filters(\n        "stg_nas_e2e_call_test_completion", filters,\n        time_column="nas_integration_date",\n        extra_required=["\\"nas_call_test_completion_status\\" ILIKE \'RED\'"],\n    )\n    sql = f"""\n        SELECT\n            "nas_market" AS market,\n            "nas_go_email_responsibility" AS engineer,\n            COUNT(*) AS red_wip_sites\n        FROM {fq("stg_nas_e2e_call_test_completion")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY red_wip_sites DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e2e_call_test'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_e2e_call_test_completion'], kpi_source_columns: ['nas_call_test_completion_status', 'nas_go_email_responsibility', 'nas_market'], kpi_dimensions: ['market', 'engineer'], kpi_business_logic: '"COUNT(*) WHERE nas_call_test_completion_status ILIKE \'RED\'"', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_call_test_red_wip", "node_type": "kpi", "node_id": "kpi_call_test_red_wip", "node_label": "Call Test Red WIP", "description": "Count of RED call tests by engineer \\u00d7 market (work-in-progress backlog).", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_rf010_completion_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_rf010_completion_rate', label: 'RF010 Completion Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: '% RF010 tasks with activity_tracker_state=\'Completed\', plus count of on-air (mb_status=\'Done\').', nl_description: '% RF010 tasks with activity_tracker_state=\'Completed\', plus count of on-air (mb_status=\'Done\').', nl_business_rule: 'RF010 Completion Rate measures the share of RF010 post-integration tasks that are completed, including work counted as already on air. It helps answer how far RF010 delivery has progressed and where completion is lagging in Phase 12. You can break it down by market and project category.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_rf010_completion_rate', kpi_name: 'RF010 Completion Rate', kpi_description: '% RF010 tasks with activity_tracker_state=\'Completed\', plus count of on-air (mb_status=\'Done\').', kpi_formula_description: '100 * COUNT FILTER (tracker_state=\'Completed\') / COUNT(*)', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_rf010_completion_rate(execute_query, filters=None):\n    """KPI 11 — % RF010 tasks with activity_tracker_state=\'Completed\', by market."""\n    where, params = apply_filters(\n        "stg_nas_rf010_dashboard", filters,\n        time_column="task_received_datetime",\n    )\n    sql = f"""\n        SELECT\n            "market_id" AS market,\n            "project_category" AS project_category,\n            COUNT(*) AS total_tasks,\n            COUNT(*) FILTER (WHERE "activity_tracker_state" ILIKE \'Completed\') AS completed,\n            ROUND(100.0 * COUNT(*) FILTER (WHERE "activity_tracker_state" ILIKE \'Completed\')\n                  / NULLIF(COUNT(*), 0), 2) AS completion_pct,\n            COUNT(*) FILTER (WHERE "mb_status" ILIKE \'Done\') AS on_air_sites\n        FROM {fq("stg_nas_rf010_dashboard")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2\n        ORDER BY completion_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['rf010_task'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_rf010_dashboard'], kpi_source_columns: ['activity_tracker_state', 'mb_status', 'market_id', 'project_category'], kpi_dimensions: ['market', 'project_category'], kpi_business_logic: '"100 * COUNT FILTER (tracker_state=\'Completed\') / COUNT(*)"', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_rf010_completion_rate", "node_type": "kpi", "node_id": "kpi_rf010_completion_rate", "node_label": "RF010 Completion Rate", "description": "% RF010 tasks with activity_tracker_state=\'Completed\', plus count of on-air (mb_status=\'Done\').", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_rf010_turnaround', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_rf010_turnaround', label: 'RF010 Average Turnaround (minutes)', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'AVG and SLA-adherence (≤240 min) for RF010 task turnaround.', nl_description: 'AVG and SLA-adherence (≤240 min) for RF010 task turnaround.', nl_business_rule: 'This metric tracks the average time, in minutes, to complete RF010 tasks after they are received, along with whether performance meets the 240-minute SLA. It helps answer how quickly RF010 work is being turned around and whether service levels are being achieved. Results can be analyzed by market and for the post-integration phase.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_rf010_turnaround', kpi_name: 'RF010 Average Turnaround (minutes)', kpi_description: 'AVG and SLA-adherence (≤240 min) for RF010 task turnaround.', kpi_formula_description: 'AVG(EPOCH(completed - received)/60)\u003B SLA = 240 min', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_rf010_turnaround(execute_query, filters=None):\n    """KPI 12 — RF010 average task turnaround in minutes (target: ≤240)."""\n    where, params = apply_filters(\n        "stg_nas_rf010_dashboard", filters,\n        time_column="task_received_datetime",\n        extra_required=[\n            \'"task_received_datetime" IS NOT NULL\',\n            \'"task_completed_datetime" IS NOT NULL\',\n            \'"task_completed_datetime"::timestamp >= "task_received_datetime"::timestamp\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            "market_id" AS market,\n            COUNT(*) AS tasks,\n            ROUND(AVG(EXTRACT(EPOCH FROM ("task_completed_datetime"::timestamp - "task_received_datetime"::timestamp))/60.0)::numeric, 2) AS avg_turnaround_minutes,\n            COUNT(*) FILTER (\n                WHERE EXTRACT(EPOCH FROM ("task_completed_datetime"::timestamp - "task_received_datetime"::timestamp))/60.0 <= 240\n            ) AS within_sla,\n            ROUND(100.0 * COUNT(*) FILTER (\n                WHERE EXTRACT(EPOCH FROM ("task_completed_datetime"::timestamp - "task_received_datetime"::timestamp))/60.0 <= 240\n            ) / NULLIF(COUNT(*), 0), 2) AS sla_compliance_pct\n        FROM {fq("stg_nas_rf010_dashboard")}\n        WHERE {where}\n        GROUP BY 1\n        ORDER BY avg_turnaround_minutes DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['rf010_task'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_rf010_dashboard'], kpi_source_columns: ['task_received_datetime', 'task_completed_datetime', 'market_id'], kpi_dimensions: ['market'], kpi_business_logic: '"AVG(EPOCH(completed - received)/60)\u003B SLA = 240 min"', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_rf010_turnaround", "node_type": "kpi", "node_id": "kpi_rf010_turnaround", "node_label": "RF010 Average Turnaround (minutes)", "description": "AVG and SLA-adherence (\\u2264240 min) for RF010 task turnaround.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_gc_quality_index', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_gc_quality_index', label: 'GC Quality & Compliance Index', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Per-GC: % sessions with no rejection AND no NEST extension AND no NSI outage.', nl_description: 'Per-GC: % sessions with no rejection AND no NEST extension AND no NSI outage.', nl_business_rule: 'GC Quality & Compliance Index measures the share of each GC’s sessions that were clean, with no rejection, no NEST extension, and no NSI outage. It helps answer which GCs are delivering the most compliant, issue-free session experience and where quality problems are concentrated. You can break it down by GC and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_gc_quality_index', kpi_name: 'GC Quality & Compliance Index', kpi_description: 'Per-GC: % sessions with no rejection AND no NEST extension AND no NSI outage.', kpi_formula_description: '100 * COUNT(clean_sessions) / COUNT(total_sessions)\u003B clean = no_reject ∧ no_ext ∧ no_NSI', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_gc_quality_index(execute_query, filters=None):\n    """KPI 13 — GC Quality & Compliance Index: % sessions per GC with NO rejection, NO extension, NO NSI outage."""\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_nest_start_time",\n        extra_required=[\'"nas_primary_gc" IS NOT NULL\'],\n    )\n    sql = f"""\n        SELECT\n            sess."nas_primary_gc" AS gc_name,\n            sess."nas_market"     AS market,\n            COUNT(DISTINCT sess."nas_session_id") AS total_sessions,\n            COUNT(DISTINCT sess."nas_session_id") FILTER (\n                WHERE NOT EXISTS (\n                    SELECT 1 FROM {fq("stg_nas_log_data")} l\n                    WHERE l."nas_session_id" = sess."nas_session_id"\n                      AND l."nas_event_type" IN (\'Nest Rejected\',\'Conditional Approval-Rejected\')\n                )\n                AND NOT EXISTS (\n                    SELECT 1 FROM {fq("stg_nas_nest_ext_raw_by_session")} e\n                    WHERE e."nas_session_id" = sess."nas_session_id"\n                      AND e."nas_total_ext_count_approved" IS NOT NULL\n                )\n                AND sess."nas_nsi_outage_layers" IS NULL\n            ) AS clean_sessions,\n            ROUND(100.0 * COUNT(DISTINCT sess."nas_session_id") FILTER (\n                WHERE NOT EXISTS (\n                    SELECT 1 FROM {fq("stg_nas_log_data")} l\n                    WHERE l."nas_session_id" = sess."nas_session_id"\n                      AND l."nas_event_type" IN (\'Nest Rejected\',\'Conditional Approval-Rejected\')\n                )\n                AND NOT EXISTS (\n                    SELECT 1 FROM {fq("stg_nas_nest_ext_raw_by_session")} e\n                    WHERE e."nas_session_id" = sess."nas_session_id"\n                      AND e."nas_total_ext_count_approved" IS NOT NULL\n                )\n                AND sess."nas_nsi_outage_layers" IS NULL\n            ) / NULLIF(COUNT(DISTINCT sess."nas_session_id"), 0), 2) AS quality_index_pct\n        FROM {fq("stg_nas_session_level_combined_data")} sess\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY quality_index_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'nest_extension', 'nas_log_event'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data', 'stg_nas_log_data', 'stg_nas_nest_ext_raw_by_session'], kpi_source_columns: ['nas_primary_gc', 'nas_session_id', 'nas_event_type', 'nas_total_ext_count_approved', 'nas_nsi_outage_layers'], kpi_dimensions: ['gc_name', 'market'], kpi_business_logic: '"100 * COUNT(clean_sessions) / COUNT(total_sessions)\u003B clean = no_reject \\u2227 no_ext \\u2227 no_NSI"', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_gc_quality_index", "node_type": "kpi", "node_id": "kpi_gc_quality_index", "node_label": "GC Quality & Compliance Index", "description": "Per-GC: % sessions with no rejection AND no NEST extension AND no NSI outage.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_intp_assignment_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_intp_assignment_count', label: 'INTP Assignment & Pending Count', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Per (region, market, project_category): distinct sites assigned to the iNTP (E911) readiness workflow, plus the subset that are still PENDING — i.e. assigned but their MBT pj_a_5250_intp_clearance_received_finish is NULL.', nl_description: 'Per (region, market, project_category): distinct sites assigned to the iNTP (E911) readiness workflow, plus the subset that are still PENDING — i.e. assigned but their MBT pj_a_5250_intp_clearance_received_finish is NULL.', nl_business_rule: 'This metric tracks how many sites have been assigned to the iNTP (E911) readiness workflow and how many of those are still pending clearance. It helps answer where E911 readiness work has started, how much remains unresolved, and where pending volume is building up. You can break it down by region, market, and project category.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_intp_assignment_count', kpi_name: 'INTP Assignment & Pending Count', kpi_description: 'Per (region, market, project_category): distinct sites assigned to the iNTP (E911) readiness workflow, plus the subset that are still PENDING — i.e. assigned but their MBT pj_a_5250_intp_clearance_received_finish is NULL.', kpi_formula_description: 'intp_assigned_sites=COUNT(DISTINCT nas_site_id) WHERE nas_validate_e911_readiness NOT NULL\u003B intp_pending_sites=COUNT(DISTINCT nas_site_id) FILTER (mbt.pj_a_5250_intp_clearance_received_finish IS NULL via LEFT JOIN)', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_intp_assignment_count(execute_query, filters=None):\n    """KPI — INTP Assignment Count + Pending.\n\n    Returns per market × project_category:\n      - intp_assigned_sites — distinct sites whose E911 readiness is populated (RIOT-side)\n      - intp_pending_sites  — distinct sites whose Magenta MBT\n                              ``pj_a_5250_intp_clearance_received_finish`` is NULL\n                              (joined to MBT on nas_site_id), i.e. assigned but\n                              clearance not yet received.\n\n    The pending-count branch mirrors the ground-truth SQL in\n    semantic_question_bank.csv ("How many sites pending for iNTP?").\n    """\n    where, params = apply_filters(\n        "stg_nas_e911_readiness_riot_validation", filters,\n        time_column="nas_e911_validation_date",\n        extra_required=[\'"nas_validate_e911_readiness" IS NOT NULL\'],\n    )\n    sql = f"""\n        SELECT\n            e."nas_region" AS region,\n            e."nas_market" AS market,\n            e."nas_project_category" AS project_category,\n            COUNT(DISTINCT e."nas_site_id") AS intp_assigned_sites,\n            COUNT(DISTINCT e."nas_site_id") FILTER (\n                WHERE m."pj_a_5250_intp_clearance_received_finish" IS NULL\n            ) AS intp_pending_sites\n        FROM {fq("stg_nas_e911_readiness_riot_validation")} e\n        LEFT JOIN {fq("stg_ndpd_mbt_tmobile_macro_combined")} m\n               ON CAST(m."s_site_id" AS TEXT) = CAST(e."nas_site_id" AS TEXT)\n        WHERE {where}\n        GROUP BY 1, 2, 3\n        ORDER BY intp_assigned_sites DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['site', 'e911_validation', 'project_category'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_e911_readiness_riot_validation', 'stg_ndpd_mbt_tmobile_macro_combined'], kpi_source_columns: ['nas_site_id', 'nas_validate_e911_readiness', 'nas_region', 'nas_market', 'nas_project_category', 'pj_a_5250_intp_clearance_received_finish'], kpi_dimensions: ['region', 'market', 'project_category'], kpi_business_logic: '"(1) Restrict RIOT rows to those where nas_validate_e911_readiness IS NOT NULL. (2) LEFT JOIN to MBT on s_site_id = nas_site_id. (3) Group by region, market, project_category. (4) Return COUNT(DISTINCT nas_site_id) overall AND COUNT(DISTINCT nas_site_id) FILTER (mbt.pj_a_5250_intp_clearance_received_finish IS NULL) per group, sorted descending."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by area", "name": "area"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_intp_assignment_count", "node_type": "kpi", "node_id": "kpi_intp_assignment_count", "node_label": "INTP Assignment & Pending Count", "description": "Per (region, market, project_category): distinct sites assigned to the iNTP (E911) readiness workflow, plus the subset that are still PENDING \\u2014 i.e. assigned but their MBT pj_a_5250_intp_clearance_received_finish is NULL.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_nsi_outage_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_nsi_outage_rate', label: 'NSI Outage Activity Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Percentage of NAS sessions whose nas_nsi_outage_layers field is populated (indicating a Non-Service-Impacting outage was logged for at least one layer). Higher value indicates more sessions had NSI outage incidents that need investigation.', nl_description: 'Percentage of NAS sessions whose nas_nsi_outage_layers field is populated (indicating a Non-Service-Impacting outage was logged for at least one layer). Higher value indicates more sessions had NSI outage incidents that need investigation.', nl_business_rule: 'NSI Outage Activity Rate measures the share of NAS sessions where a non-service-impacting outage was recorded on at least one network layer. It helps answer how often these outage incidents are occurring and where investigation may be needed. You can analyze it by region and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_nsi_outage_rate', kpi_name: 'NSI Outage Activity Rate', kpi_description: 'Percentage of NAS sessions whose nas_nsi_outage_layers field is populated (indicating a Non-Service-Impacting outage was logged for at least one layer). Higher value indicates more sessions had NSI outage incidents that need investigation.', kpi_formula_description: '100 * COUNT(*) FILTER (nas_nsi_outage_layers IS NOT NULL AND <> \'\') / COUNT(*)', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\nDERIVED_REGION_SQL = \'\\nCASE\\n  WHEN LOWER("nas_market") IN (\\\'seattle\\\',\\\'phoenix\\\',\\\'spokane\\\',\\\'montana\\\',\\\'portland\\\') THEN \\\'West\\\'\\n  WHEN LOWER("nas_market") IN (\\\'atlanta\\\',\\\'austin\\\',\\\'dallas\\\',\\\'bhm-mem\\\',\\\'mobile\\\',\\\'puertorico\\\',\\\'houston\\\') THEN \\\'South\\\'\\n  WHEN LOWER("nas_market") IN (\\\'chicago\\\',\\\'milwaukee\\\',\\\'detroit\\\',\\\'minneapolis\\\',\\\'denver\\\',\\\'dakotas\\\',\\\'omaha\\\',\\\'des moines\\\',\\\'oklahoma\\\',\\\'kansascity\\\',\\\'arkansas\\\',\\\'indianapolis\\\',\\\'wichita\\\',\\\'tulsa\\\',\\\'stlouis\\\',\\\'columbus\\\',\\\'cleveland\\\',\\\'nashville\\\',\\\'louisville\\\',\\\'knoxville\\\',\\\'westvirginia\\\',\\\'cincinnati\\\',\\\'pittsburgh\\\') THEN \\\'Central\\\'\\n  ELSE NULL\\nEND\\n\'\n# ─────────── end inlined prelude ───────────\n\ndef get_nsi_outage_rate(execute_query, filters=None):\n    """KPI — NSI Outage Activity Rate: % of NAS sessions with nas_nsi_outage_layers populated."""\n    where, params = apply_filters("stg_nas_session_level_combined_data", filters)\n    sql = f"""\n        SELECT\n            {DERIVED_REGION_SQL} AS region,\n            "nas_market" AS market,\n            COUNT(*) AS total_sessions,\n            COUNT(*) FILTER (\n                WHERE "nas_nsi_outage_layers" IS NOT NULL\n                  AND "nas_nsi_outage_layers" <> \'\'\n            ) AS nsi_outage_sessions,\n            ROUND(100.0 * COUNT(*) FILTER (\n                WHERE "nas_nsi_outage_layers" IS NOT NULL\n                  AND "nas_nsi_outage_layers" <> \'\'\n            ) / NULLIF(COUNT(*), 0), 2) AS nsi_outage_rate_pct\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2\n        ORDER BY nsi_outage_rate_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'site', 'layer'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_session_id', 'nas_nsi_outage_layers', 'nas_market'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"(1) Read all session-level rows. (2) Compute COUNT(*) as total sessions. (3) Compute COUNT(*) FILTER (nas_nsi_outage_layers IS NOT NULL AND nas_nsi_outage_layers <> \'\') as nsi sessions. (4) Return 100 * nsi/total per derived_region \\u00d7 market. (5) Sort by rate descending."', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_nsi_outage_rate", "node_type": "kpi", "node_id": "kpi_nsi_outage_rate", "node_label": "NSI Outage Activity Rate", "description": "Percentage of NAS sessions whose nas_nsi_outage_layers field is populated (indicating a Non-Service-Impacting outage was logged for at least one layer). Higher value indicates more sessions had NSI outage incidents that need investigation.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_check_in_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_check_in_count', label: 'NAS Check-in Count', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Total count of NAS sessions where check-in (nest start) has actually happened (nas_nest_start_time IS NOT NULL). Differs from kpi_nas_session_count by NOT applying DISTINCT — counts every check-in event row.', nl_description: 'Total count of NAS sessions where check-in (nest start) has actually happened (nas_nest_start_time IS NOT NULL). Differs from kpi_nas_session_count by NOT applying DISTINCT — counts every check-in event row.', nl_business_rule: 'NAS Check-in Count measures the total number of NAS check-in events that actually occurred, based on sessions with a recorded nest start. It answers questions about how many check-ins happened and where check-in activity is highest or lowest. You can analyze it by region, market, project category, and GC.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_check_in_count', kpi_name: 'NAS Check-in Count', kpi_description: 'Total count of NAS sessions where check-in (nest start) has actually happened (nas_nest_start_time IS NOT NULL). Differs from kpi_nas_session_count by NOT applying DISTINCT — counts every check-in event row.', kpi_formula_description: 'COUNT(*) WHERE nas_nest_start_time IS NOT NULL', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\nDERIVED_REGION_SQL = \'\\nCASE\\n  WHEN LOWER("nas_market") IN (\\\'seattle\\\',\\\'phoenix\\\',\\\'spokane\\\',\\\'montana\\\',\\\'portland\\\') THEN \\\'West\\\'\\n  WHEN LOWER("nas_market") IN (\\\'atlanta\\\',\\\'austin\\\',\\\'dallas\\\',\\\'bhm-mem\\\',\\\'mobile\\\',\\\'puertorico\\\',\\\'houston\\\') THEN \\\'South\\\'\\n  WHEN LOWER("nas_market") IN (\\\'chicago\\\',\\\'milwaukee\\\',\\\'detroit\\\',\\\'minneapolis\\\',\\\'denver\\\',\\\'dakotas\\\',\\\'omaha\\\',\\\'des moines\\\',\\\'oklahoma\\\',\\\'kansascity\\\',\\\'arkansas\\\',\\\'indianapolis\\\',\\\'wichita\\\',\\\'tulsa\\\',\\\'stlouis\\\',\\\'columbus\\\',\\\'cleveland\\\',\\\'nashville\\\',\\\'louisville\\\',\\\'knoxville\\\',\\\'westvirginia\\\',\\\'cincinnati\\\',\\\'pittsburgh\\\') THEN \\\'Central\\\'\\n  ELSE NULL\\nEND\\n\'\n# ─────────── end inlined prelude ───────────\n\ndef get_check_in_count(execute_query, filters=None):\n    """KPI — NAS Check-in Count: total events where nas_nest_start_time is populated."""\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_nest_start_time",\n        extra_required=[\'"nas_nest_start_time" IS NOT NULL\'],\n    )\n    sql = f"""\n        SELECT\n            {DERIVED_REGION_SQL} AS region,\n            "nas_market" AS market,\n            "nas_project_category" AS project_category,\n            "nas_primary_gc" AS gc_name,\n            COUNT(*) AS check_in_count\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE {where}\n        GROUP BY 1, 2, 3, 4\n        ORDER BY check_in_count DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'site', 'gc'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_nest_start_time', 'nas_market', 'nas_project_category', 'nas_primary_gc'], kpi_dimensions: ['region', 'market', 'project_category', 'gc_name'], kpi_business_logic: '"(1) Restrict to rows where nas_nest_start_time IS NOT NULL. (2) Apply optional filters. (3) Group by derived_region \\u00d7 market \\u00d7 project_category \\u00d7 gc_name. (4) Return COUNT(*)."', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_check_in_count", "node_type": "kpi", "node_id": "kpi_check_in_count", "node_label": "NAS Check-in Count", "description": "Total count of NAS sessions where check-in (nest start) has actually happened (nas_nest_start_time IS NOT NULL). Differs from kpi_nas_session_count by NOT applying DISTINCT \\u2014 counts every check-in event row.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_check_in_sla_compliance', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_check_in_sla_compliance', label: 'Check-in SLA Compliance Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Percentage of NAS check-ins whose elapsed time between requested check-in (nas_nest_start_time_requested) and actual check-in (nas_nest_start_time) is at or below the 15-minute SLA. Both timestamps must be present. Threshold from KPI catalog.', nl_description: 'Percentage of NAS check-ins whose elapsed time between requested check-in (nas_nest_start_time_requested) and actual check-in (nas_nest_start_time) is at or below the 15-minute SLA. Both timestamps must be present. Threshold from KPI catalog.', nl_business_rule: 'Check-in SLA Compliance Rate measures the share of NAS check-ins that start within 15 minutes of the requested check-in time. It answers how reliably operations are meeting the check-in service-level target and where delays are affecting performance. You can analyze it by region and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_check_in_sla_compliance', kpi_name: 'Check-in SLA Compliance Rate', kpi_description: 'Percentage of NAS check-ins whose elapsed time between requested check-in (nas_nest_start_time_requested) and actual check-in (nas_nest_start_time) is at or below the 15-minute SLA. Both timestamps must be present. Threshold from KPI catalog.', kpi_formula_description: '100 * COUNT FILTER (delta <= 15 min) / COUNT, delta = nas_nest_start_time - nas_nest_start_time_requested', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_