te_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\nDERIVED_REGION_SQL = \'\\nCASE\\n  WHEN LOWER("nas_market") IN (\\\'seattle\\\',\\\'phoenix\\\',\\\'spokane\\\',\\\'montana\\\',\\\'portland\\\') THEN \\\'West\\\'\\n  WHEN LOWER("nas_market") IN (\\\'atlanta\\\',\\\'austin\\\',\\\'dallas\\\',\\\'bhm-mem\\\',\\\'mobile\\\',\\\'puertorico\\\',\\\'houston\\\') THEN \\\'South\\\'\\n  WHEN LOWER("nas_market") IN (\\\'chicago\\\',\\\'milwaukee\\\',\\\'detroit\\\',\\\'minneapolis\\\',\\\'denver\\\',\\\'dakotas\\\',\\\'omaha\\\',\\\'des moines\\\',\\\'oklahoma\\\',\\\'kansascity\\\',\\\'arkansas\\\',\\\'indianapolis\\\',\\\'wichita\\\',\\\'tulsa\\\',\\\'stlouis\\\',\\\'columbus\\\',\\\'cleveland\\\',\\\'nashville\\\',\\\'louisville\\\',\\\'knoxville\\\',\\\'westvirginia\\\',\\\'cincinnati\\\',\\\'pittsburgh\\\') THEN \\\'Central\\\'\\n  ELSE NULL\\nEND\\n\'\n# ─────────── end inlined prelude ───────────\n\ndef get_region(execute_query, filters=None):\n    """Region — distinct derived regions (West / South / Central) with their\n    market counts. Region is computed from nas_market via DERIVED_REGION_SQL\n    because the session table has no nas_region column.\n    """\n    where, params = apply_filters("stg_nas_session_level_combined_data", filters)\n    sql = f"""\n        SELECT {DERIVED_REGION_SQL} AS region,\n               COUNT(DISTINCT "nas_market") AS market_count,\n               COUNT(DISTINCT "nas_site_id") AS site_count\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {where}" if where else "WHERE 1=1"}\n          AND "nas_market" IS NOT NULL\n        GROUP BY 1\n        ORDER BY site_count DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_region", "node_type": "core", "node_id": "region", "node_label": "Region", "description": "A derived NAS region (West / South / Central) computed from nas_market via the canonical DERIVED_REGION_SQL CASE expression. The session table has no nas_region column.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
