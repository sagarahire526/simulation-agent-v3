ode\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_call_test_red_to_green_count(execute_query, filters=None):\n    """KPI — Call Test Red-to-Green Count."""\n    where, params = apply_filters(\n        "stg_nas_e2e_call_test_completion", filters,\n        time_column="nas_integration_date",\n        extra_required=[\n            "(\\"nas_call_test_completion_status\\" ILIKE \'Red%%Green%%\' "\n            "OR \\"nas_call_test_completion_status\\" ILIKE \'Red to Green\')"\n        ],\n    )\n    sql = f"""\n        SELECT\n            "nas_region" AS region,\n            "nas_market" AS market,\n            "nas_go_email_responsibility" AS engineer,\n            COUNT(*) AS red_to_green_count\n        FROM {fq("stg_nas_e2e_call_test_completion")}\n        WHERE {where}\n        GROUP BY 1, 2, 3\n        ORDER BY red_to_green_count DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e2e_call_test', 'engineer'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_e2e_call_test_completion'], kpi_source_columns: ['nas_call_test_completion_status', 'nas_region', 'nas_market', 'nas_go_email_responsibility'], kpi_dimensions: ['region', 'market', 'engineer'], kpi_business_logic: '"(1) Filter to rows where nas_call_test_completion_status ILIKE \'Red%Green%\' OR ILIKE \'Red to Green\'. (2) Group by region \\u00d7 market \\u00d7 engineer. (3) Return COUNT(*)."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_call_test_red_to_green_count", "node_type": "kpi", "node_id": "kpi_call_test_red_to_green_count", "node_label": "Call Test Red-to-Green Count", "description": "Count of E2E call tests that recovered from RED to GREEN (i.e., a previously-failing call test was retested and now passes). Identifies remediation success volume per engineer/market.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_psap_call_test_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_psap_call_test_count', label: 'PSAP Call-Testing Count', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Count of distinct (PSAP, site) pairs that have an E2E call test recorded. nas_psap_id lives on the e911_readiness table — join via nas_site_id to the call-test table. Tracks PSAP-coverage of the calling-test program.', nl_description: 'Count of distinct (PSAP, site) pairs that have an E2E call test recorded. nas_psap_id lives on the e911_readiness table — join via nas_site_id to the call-test table. Tracks PSAP-coverage of the calling-test program.', nl_business_rule: 'PSAP Call-Testing Count measures how many unique PSAP and site combinations have completed an end-to-end call test. It helps answer how broadly the call-testing program covers PSAPs and where testing has already been recorded. You can analyze it by region and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_psap_call_test_count', kpi_name: 'PSAP Call-Testing Count', kpi_description: 'Count of distinct (PSAP, site) pairs that have an E2E call test recorded. nas_psap_id lives on the e911_readiness table — join via nas_site_id to the call-test table. Tracks PSAP-coverage of the calling-test program.', kpi_formula_description: 'COUNT(DISTINCT (nas_psap_id, nas_site_id)) WHERE call test exists', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_psap_call_test_count(execute_query, filters=None):\n    """KPI — PSAP Call-Testing Count (distinct PSAP-site pairs with a call test)."""\n    import re\n    c_where, c_params = apply_filters(\n        "stg_nas_e2e_call_test_completion", filters, time_column="nas_integration_date",\n    )\n    c_where = re.sub(r\'(?<![\\w.])"nas_\\w+"\', lambda m: \'c.\' + m.group(), c_where)\n    sql = f"""\n        SELECT\n            c."nas_region" AS region,\n            c."nas_market" AS market,\n            COUNT(DISTINCT (e."nas_psap_id" || \'||\' || c."nas_site_id")) AS psap_site_pairs\n        FROM {fq("stg_nas_e2e_call_test_completion")} c\n        INNER JOIN {fq("stg_nas_e911_readiness_riot_validation")} e\n                ON e."nas_site_id" = c."nas_site_id"\n        WHERE e."nas_psap_id" IS NOT NULL\n              {f"AND {c_where}" if c_where else ""}\n        GROUP BY 1, 2\n        ORDER BY psap_site_pairs DESC NULLS LAST\n    """\n    return execute_query(sql, c_params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e2e_call_test', 'psap', 'site'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_e2e_call_test_completion', 'stg_nas_e911_readiness_riot_validation'], kpi_source_columns: ['nas_site_id', 'nas_psap_id', 'nas_region', 'nas_market'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"(1) JOIN call-test (c) with e911_readiness (e) on nas_site_id. (2) Restrict to rows where e.nas_psap_id IS NOT NULL. (3) Group by c.nas_region \\u00d7 c.nas_market. (4) Return COUNT(DISTINCT (e.nas_psap_id, c.nas_site_id))."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_psap_call_test_count", "node_type": "kpi", "node_id": "kpi_psap_call_test_count", "node_label": "PSAP Call-Testing Count", "description": "Count of distinct (PSAP, site) pairs that have an E2E call test recorded. nas_psap_id lives on the e911_readiness table \\u2014 join via nas_site_id to the call-test table. Tracks PSAP-coverage of the calling-test program.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_ftr_e911_call_validation_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_ftr_e911_call_validation_rate', label: 'FTR E911 Call Validation Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Percentage of E911 call tests that resulted in GREEN AND completed on the same calendar date as the integration date — i.e., the call test passed first-time-right without a follow-up day. Indicates Phase-11 quality on the first attempt.', nl_description: 'Percentage of E911 call tests that resulted in GREEN AND completed on the same calendar date as the integration date — i.e., the call test passed first-time-right without a follow-up day. Indicates Phase-11 quality on the first attempt.', nl_business_rule: 'FTR E911 Call Validation Rate measures the share of E911 call tests that pass on the first attempt and are completed the same day as integration. It helps answer how often Phase 11 validation is successful first-time-right without needing follow-up work on another day. You can analyze it by region, market, and engineer.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_ftr_e911_call_validation_rate', kpi_name: 'FTR E911 Call Validation Rate', kpi_description: 'Percentage of E911 call tests that resulted in GREEN AND completed on the same calendar date as the integration date — i.e., the call test passed first-time-right without a follow-up day. Indicates Phase-11 quality on the first attempt.', kpi_formula_description: '100 * COUNT FILTER (status=\'GREEN\' AND completed_date::date = integration_date::date) / COUNT(*)', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_ftr_e911_call_validation_rate(execute_query, filters=None):\n    """KPI — FTR E911 Call Validation Rate (GREEN AND same-day completion)."""\n    where, params = apply_filters(\n        "stg_nas_e2e_call_test_completion", filters,\n        time_column="nas_integration_date",\n    )\n    sql = f"""\n        SELECT\n            "nas_region" AS region,\n            "nas_market" AS market,\n            "nas_go_email_responsibility" AS engineer,\n            COUNT(*) AS total_tests,\n            COUNT(*) FILTER (\n                WHERE "nas_call_test_completion_status" ILIKE \'GREEN\'\n                  AND "nas_call_test_completed_date" IS NOT NULL\n                  AND "nas_integration_date" IS NOT NULL\n                  AND "nas_call_test_completed_date"::date = "nas_integration_date"::date\n            ) AS ftr_tests,\n            ROUND(100.0 * COUNT(*) FILTER (\n                WHERE "nas_call_test_completion_status" ILIKE \'GREEN\'\n                  AND "nas_call_test_completed_date" IS NOT NULL\n                  AND "nas_integration_date" IS NOT NULL\n                  AND "nas_call_test_completed_date"::date = "nas_integration_date"::date\n            ) / NULLIF(COUNT(*), 0), 2) AS ftr_rate_pct\n        FROM {fq("stg_nas_e2e_call_test_completion")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2, 3\n        ORDER BY ftr_rate_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e2e_call_test', 'engineer'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_e2e_call_test_completion'], kpi_source_columns: ['nas_call_test_completion_status', 'nas_call_test_completed_date', 'nas_integration_date', 'nas_region', 'nas_market', 'nas_go_email_responsibility'], kpi_dimensions: ['region', 'market', 'engineer'], kpi_business_logic: '"(1) Read all e2e call test rows. (2) total = COUNT(*). (3) ftr = COUNT FILTER (status ILIKE \'GREEN\' AND completed_date::date = integration_date::date). (4) Return 100 * ftr/total grouped by region \\u00d7 market \\u00d7 engineer."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_ftr_e911_call_validation_rate", "node_type": "kpi", "node_id": "kpi_ftr_e911_call_validation_rate", "node_label": "FTR E911 Call Validation Rate", "description": "Percentage of E911 call tests that resulted in GREEN AND completed on the same calendar date as the integration date \\u2014 i.e., the call test passed first-time-right without a follow-up day. Indicates Phase-11 quality on the first attempt.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_rf010_assignment_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_rf010_assignment_count', label: 'RF010 Site Assignment Count', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Distinct count of project_site_id values that have received an RF010 task (task_received_datetime IS NOT NULL). Tracks the size of the RF010 work-queue per region/market/project_category.', nl_description: 'Distinct count of project_site_id values that have received an RF010 task (task_received_datetime IS NOT NULL). Tracks the size of the RF010 work-queue per region/market/project_category.', nl_business_rule: 'RF010 Site Assignment Count measures how many unique sites have been assigned an RF010 task, showing the current size of the RF010 work queue. It helps answer questions about how much RF010 work has been assigned and where assignment volume is building up. You can break it down by region, market, and project category.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_rf010_assignment_count', kpi_name: 'RF010 Site Assignment Count', kpi_description: 'Distinct count of project_site_id values that have received an RF010 task (task_received_datetime IS NOT NULL). Tracks the size of the RF010 work-queue per region/market/project_category.', kpi_formula_description: 'COUNT(DISTINCT project_site_id) WHERE task_received_datetime IS NOT NULL', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_rf010_assignment_count(execute_query, filters=None):\n    """KPI — RF010 Site Assignment Count: distinct project_site_id with task_received_datetime."""\n    where, params = apply_filters(\n        "stg_nas_rf010_dashboard", filters,\n        time_column="task_received_datetime",\n        extra_required=[\'"task_received_datetime" IS NOT NULL\'],\n    )\n    sql = f"""\n        SELECT\n            "region_id" AS region,\n            "market_id" AS market,\n            "project_category" AS project_category,\n            COUNT(DISTINCT "project_site_id") AS rf010_assigned_sites\n        FROM {fq("stg_nas_rf010_dashboard")}\n        WHERE {where}\n        GROUP BY 1, 2, 3\n        ORDER BY rf010_assigned_sites DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['rf010_task', 'site', 'project_category'], kpi_related_kpi_