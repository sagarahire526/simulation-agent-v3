CREATE (:BKGNode {node_id: 'project', session_id: '6a079b6bc1ea92432985ef54', name: 'project', label: 'Project', node_type: 'CORE', entity_type: 'core', status: 'confirmed', definition: 'A project category grouping for NAS sites (canonical values: Macro, Hardening, ACS DAS Venue, Param Audit (Nokia Only), Baseband Swap (non L4L), AHLOA-B Swap, Microwave, Special Projects, Small Cell). Filtered via nas_project_category. NB: pj_project_id has no cross-table overlap.', nl_description: 'A project category grouping for NAS sites (canonical values: Macro, Hardening, ACS DAS Venue, Param Audit (Nokia Only), Baseband Swap (non L4L), AHLOA-B Swap, Microwave, Special Projects, Small Cell). Filtered via nas_project_category. NB: pj_project_id has no cross-table overlap.', nl_business_rule: 'Project represents the type of network work being delivered across NAS sites, such as macro builds, hardening, microwave, small cell, and other project categories. It helps answer which kinds of projects are driving activity, volume, or performance across the portfolio. You can break results down by project category and compare them across sites or time periods.', is_skipped: false, skip_reason: '', map_table_name: 'stg_nas_session_level_combined_data', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'nas_project_category', map_label_column: 'nas_project_category', map_sql_template: 'SELECT "nas_project_category", COUNT(DISTINCT "nas_site_id") AS site_count FROM "pwc_macro_staging_schema"."stg_nas_session_level_combined_data" WHERE "nas_project_category" IS NOT NULL GROUP BY "nas_project_category"', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\