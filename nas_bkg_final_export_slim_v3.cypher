CREATE (:BKGNode {node_id: 'kpi_gc_construction_complete_latency', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_gc_construction_complete_latency', label: 'GC Construction Complete Latency', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Average elapsed days from construction-start to ms_15550_gc_construction_complete_actual (the GC-handoff milestone), grouped per GC crew. Captures pure GC-attributable delivery duration.', nl_description: 'Average elapsed days from construction-start to ms_15550_gc_construction_complete_actual (the GC-handoff milestone), grouped per GC crew. Captures pure GC-attributable delivery duration.', nl_business_rule: 'GC Construction Complete Latency measures the average number of days a GC crew takes to move a project from construction start to the GC handoff milestone. It helps answer which GC crews are delivering faster or slower and where GC-driven schedule delays are occurring. You can break it down by GC crew and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_gc_construction_complete_latency', kpi_name: 'GC Construction Complete Latency', kpi_description: 'Average elapsed days from construction-start to ms_15550_gc_construction_complete_actual (the GC-handoff milestone), grouped per GC crew. Captures pure GC-attributable delivery duration.', kpi_formula_description: 'AVG((ms_15550_gc_construction_complete_actual - ms_1550_construction_start_actual) in days), grouped by pj_gc_crew_name', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_gc_construction_complete_latency(execute_query, filters=None):\n    """KPI — GC Construction Complete Latency (ms_15550)."""\n    where, params = apply_filters(\n        "stg_ndpd_mbt_tmobile_macro_combined", filters,\n        time_column="ms_1550_construction_start_actual",\n        extra_required=[\n            \'"ms_1550_construction_start_actual" IS NOT NULL\',\n            \'"ms_15550_gc_construction_complete_actual" IS NOT NULL\',\n            \'"pj_gc_crew_name" IS NOT NULL\',\n            \'"ms_15550_gc_construction_complete_actual"::timestamp >= "ms_1550_construction_start_actual"::timestamp\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            "pj_gc_crew_name" AS gc_name,\n            "m_market" AS market,\n            COUNT(*) AS sites,\n            ROUND(AVG(EXTRACT(EPOCH FROM ("ms_15550_gc_construction_complete_actual"::timestamp - "ms_1550_construction_start_actual"::timestamp))/86400.0)::numeric, 2) AS avg_gc_latency_days,\n            ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("ms_15550_gc_construction_complete_actual"::timestamp - "ms_1550_construction_start_actual"::timestamp))/86400.0))::numeric, 2) AS p50_days,\n            ROUND((PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("ms_15550_gc_construction_complete_actual"::timestamp - "ms_1550_construction_start_actual"::timestamp))/86400.0))::numeric, 2) AS p95_days\n        FROM {fq("stg_ndpd_mbt_tmobile_macro_combined")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY avg_gc_latency_days DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['site', 'project', 'gc'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_ndpd_mbt_tmobile_macro_combined'], kpi_source_columns: ['s_site_id', 'ms_1550_construction_start_actual', 'ms_15550_gc_construction_complete_actual', 'pj_gc_crew_name', 'm_market'], kpi_dimensions: ['gc_name', 'market'], kpi_business_logic: '"(1) Restrict to rows where both ms_1550_construction_start_actual and ms_15550_gc_construction_complete_actual are NOT NULL, pj_gc_crew_name IS NOT NULL, and complete >= start. (2) days = EPOCH(complete - start)/86400. (3) Return AVG, p50, p95, COUNT grouped by pj_gc_crew_name \\u00d7 m_market."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by area", "name": "area"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_gc_construction_complete_latency", "node_type": "kpi", "node_id": "kpi_gc_construction_complete_latency", "node_label": "GC Construction Complete Latency", "description": "Average elapsed days from construction-start to ms_15550_gc_construction_complete_actual (the GC-handoff milestone), grouped per GC crew. Captures pure GC-attributable delivery duration.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_vendor_revisit_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_vendor_revisit_rate', label: 'Vendor Revisit Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Percentage of distinct sites where the same Primary GC ran more than one NAS session — a proxy for sites the GC had to revisit, indicating likely rework or incomplete first-visit closure.', nl_description: 'Percentage of distinct sites where the same Primary GC ran more than one NAS session — a proxy for sites the GC had to revisit, indicating likely rework or incomplete first-visit closure.', nl_business_rule: 'Vendor Revisit Rate measures the share of sites where the same primary GC had to run more than one NAS session, signaling likely rework or an incomplete first visit. It helps answer which teams or areas are driving repeat site visits and where first-time closure may be weak. You can break it down by GC and by market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_vendor_revisit_rate', kpi_name: 'Vendor Revisit Rate', kpi_description: 'Percentage of distinct sites where the same Primary GC ran more than one NAS session — a proxy for sites the GC had to revisit, indicating likely rework or incomplete first-visit closure.', kpi_formula_description: '100 * COUNT(DISTINCT site with >1 session under same nas_primary_gc) / COUNT(DISTINCT site)', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_vendor_revisit_rate(execute_query, filters=None):\n    """KPI — Vendor Revisit Rate: % of (gc,site) pairs where the GC ran >1 session."""\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        extra_required=[\'"nas_primary_gc" IS NOT NULL\', \'"nas_site_id" IS NOT NULL\'],\n    )\n    sql = f"""\n        SELECT\n            agg."nas_primary_gc" AS gc_name,\n            agg."nas_market" AS market,\n            COUNT(*) AS total_sites,\n            COUNT(*) FILTER (WHERE agg.session_count > 1) AS revisit_sites,\n            ROUND(100.0 * COUNT(*) FILTER (WHERE agg.session_count > 1)\n                  / NULLIF(COUNT(*), 0), 2) AS revisit_rate_pct\n        FROM (\n            SELECT "nas_primary_gc", "nas_market", "nas_site_id",\n                   COUNT(DISTINCT "nas_session_id") AS session_count\n            FROM {fq("stg_nas_session_level_combined_data")}\n            WHERE {where}\n            GROUP BY 1, 2, 3\n        ) agg\n        GROUP BY 1, 2\n        ORDER BY revisit_rate_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'site', 'gc'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_session_id', 'nas_site_id', 'nas_primary_gc', 'nas_market'], kpi_dimensions: ['gc_name', 'market'], kpi_business_logic: '"(1) For each (gc, site), count distinct sessions. (2) revisit_sites = COUNT(DISTINCT site) FILTER (session_count > 1). (3) total_sites = COUNT(DISTINCT site). (4) Return 100 * revisit/total grouped by nas_primary_gc \\u00d7 nas_market."', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_vendor_revisit_rate", "node_type": "kpi", "node_id": "kpi_vendor_revisit_rate", "node_label": "Vendor Revisit Rate", "description": "Percentage of distinct sites where the same Primary GC ran more than one NAS session \\u2014 a proxy for sites the GC had to revisit, indicating likely rework or incomplete first-visit closure.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_pending_queue_size', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_pending_queue_size', label: 'Pending Queue Size (per stage)', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Parameterised count of items in each pending workflow state. Stages: check_in_pending (requested but not started), checkout_pending (requested checkout but no approval), intp_pending (E911 not yet Ready_Completed), rf010_pending (received but not completed), call_test_red (RED status). Routes to the correct source table based on the \'stage\' filter\u003B if stage is omitted, returns one row per stage with its count.', nl_description: 'Parameterised count of items in each pending workflow state. Stages: check_in_pending (requested but not started), checkout_pending (requested checkout but no approval), intp_pending (E911 not yet Ready_Completed), rf010_pending (received but not completed), call_test_red (RED status). Routes to the correct source table based on the \'stage\' filter\u003B if stage is omitted, returns one row per stage with its count.', nl_business_rule: 'Pending Queue Size (per stage) shows how many items are currently waiting in each workflow stage, such as check-in, checkout approval, E911 completion, RF010 completion, or call testing. It answers questions about where work is backing up and which pending stage has the largest queue at a point in time. You can break it down by stage, region, and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_pending_queue_size', kpi_name: 'Pending Queue Size (per stage)', kpi_description: 'Parameterised count of items in each pending workflow state. Stages: check_in_pending (requested but not started), checkout_pending (requested checkout but no approval), intp_pending (E911 not yet Ready_Completed), rf010_pending (received but not completed), call_test_red (RED status). Routes to the correct source table based on the \'stage\' filter\u003B if stage is omitted, returns one row per stage with its count.', kpi_formula_description: 'Per stage: COUNT(*) of items in pending state — see business_logic for per-stage predicates.', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\nDERIVED_REGION_SQL = \'\\nCASE\\n  WHEN LOWER("nas_market") IN (\\\'seattle\\\',\\\'phoenix\\\',\\\'spokane\\\',\\\'montana\\\',\\\'portland\\\') THEN \\\'West\\\'\\n  WHEN LOWER("nas_market") IN (\\\'atlanta\\\',\\\'austin\\\',\\\'dallas\\\',\\\'bhm-mem\\\',\\\'mobile\\\',\\\'puertorico\\\',\\\'houston\\\') THEN \\\'South\\\'\\n  WHEN LOWER("nas_market") IN (\\\'chicago\\\',\\\'milwaukee\\\',\\\'detroit\\\',\\\'minneapolis\\\',\\\'denver\\\',\\\'dakotas\\\',\\\'omaha\\\',\\\'des moines\\\',\\\'oklahoma\\\',\\\'kansascity\\\',\\\'arkansas\\\',\\\'indianapolis\\\',\\\'wichita\\\',\\\'tulsa\\\',\\\'stlouis\\\',\\\'columbus\\\',\\\'cleveland\\\',\\\'nashville\\\',\\\'louisville\\\',\\\'knoxville\\\',\\\'westvirginia\\\',\\\'cincinnati\\\',\\\'pittsburgh\\\') THEN \\\'Central\\\'\\n  ELSE NULL\\nEND\\n\'\n# ─────────── end inlined prelude ───────────\n\ndef get_pending_queue_size(execute_query, filters=None):\n    """KPI — Pending Queue Size (per stage). Routes by \'stage\' filter\u003B default returns all stages."""\n    filters = filters or {}\n    stage = (filters.get("stage") or "").strip().lower()\n\n    # Common region/market filter (canonical), passed to each source table individually.\n    # We strip \'stage\' out before delegating to apply_filters since none of the source\n    # tables have a \'stage\' column.\n    base_filters = {k: v for k, v in filters.items() if k != "stage"}\n\n    parts: list[str] = []\n    params: dict = {}\n\n    def _add_part(label: str, table: str, predicate: str, region_expr: str, market_expr: str, time_column: str | None = None):\n        sub_where, sub_params = apply_filters(\n            table, base_filters,\n            time_column=time_column,\n            extra_required=[predicate],\n        )\n        # Prefix parameter keys to keep them unique across UNIONed sub-SELECTs\n        prefix = f"{label}_"\n        renamed_params = {f"{prefix}{k}": v for k, v in sub_params.items()}\n        renamed_where = sub_where\n        for k in sub_params.keys():\n            renamed_where = renamed_where.replace(f"%({k})s", f"%({prefix}{k})s")\n        parts.append(f"""\n            SELECT \'{label}\' AS stage,\n                   {region_expr} AS region,\n                   {market_expr} AS market,\n                   COUNT(*) AS pending_count\n            FROM {fq(table)}\n            WHERE {renamed_where}\n            GROUP BY 1, 2, 3\n        """)\n        params.update(renamed_params)\n\n    want_check_in   = (stage == "" or stage == "check_in_pending")\n    want_checkout   = (stage == "" or stage == "checkout_pending")\n    want_intp       = (stage == "" or stage == "intp_pending")\n    want_rf010      = (stage == "" or stage == "rf010_pending")\n    want_call_red   = (stage == "" or stage == "call_test_red")\n\n    if want_check_in:\n        _add_part(\n            "check_in_pending",\n            "stg_nas_session_level_combined_data",\n            \'"nas_nest_start_time_requested" IS NOT NULL AND "nas_nest_start_time" IS NULL\',\n            DERIVED_REGION_SQL,\n            \'"nas_market"\',\n        )\n    if want_checkout:\n        _add_part(\n            "checkout_pending",\n            "stg_nas_session_level_combined_data",\n            \'"nas_checkout_time" IS NOT NULL AND "nas_checkout_approve_time" IS NULL\',\n            DERIVED_REGION_SQL,\n            \'"nas_market"\',\n        )\n    if want_intp:\n        _add_part(\n            "intp_pending",\n            "stg_nas_e911_readiness_riot_validation",\n            \'("nas_validate_e911_readiness" IS NULL OR "nas_validate_e911_readiness" NOT ILIKE \\\'Ready%%Complete%%\\\')\',\n            \'"nas_region"\',\n            \'"nas_market"\',\n            time_column="nas_e911_validation_date",\n        )\n    if want_rf010:\n        _add_part(\n            "rf010_pending",\n            "stg_nas_rf010_dashboard",\n            \'"task_received_datetime" IS NOT NULL AND "task_completed_datetime" IS NULL\',\n            \'"region_id"\',\n            \'"market_id"\',\n            time_column="task_received_datetime",\n        )\n    if want_call_red:\n        _add_part(\n            "call_test_red",\n            "stg_nas_e2e_call_test_completion",\n            "\\"nas_call_test_completion_status\\" ILIKE \'RED\'",\n            \'"nas_region"\',\n            \'"nas_market"\',\n            time_column="nas_integration_date",\n        )\n\n    if not parts:\n        return []\n\n    sql = " UNION ALL ".join(parts) + "\\n ORDER BY pending_count DESC NULLS LAST"\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'e911_validation', 'rf010_task', 'e2e_call_test'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data', 'stg_nas_e911_readiness_riot_validation', 'stg_nas_rf010_dashboard', 'stg_nas_e2e_call_test_completion'], kpi_source_columns: ['nas_nest_start_time_requested', 'nas_nest_start_time', 'nas_checkout_time', 'nas_checkout_approve_time', 'nas_validate_e911_readiness', 'task_received_datetime', 'task_completed_datetime', 'nas_call_test_completion_status'], kpi_dimensions: ['region', 'market', 'stage'], kpi_business_logic: '"(1) Resolve the \'stage\' filter (optional). If supplied, only return that stage\u003B otherwise, return all five. (2) check_in_pending: nas_nest_start_time_requested IS NOT NULL AND nas_nest_start_time IS NULL on session table. (3) checkout_pending: nas_checkout_time IS NOT NULL AND nas_checkout_approve_time IS NULL on session table. (4) intp_pending: nas_validate_e911_readiness IS NULL OR NOT ILIKE \'Ready%%Complete%%\' on e911 table. (5) rf010_pending: task_received_datetime IS NOT NULL AND task_completed_datetime IS NULL on rf010 table. (6) call_test_red: nas_call_test_completion_status ILIKE \'RED\' on call-test table. (7) Each stage is computed via its own SELECT and UNION-ALL\'d, with region/market projected."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_pending_queue_size", "node_type": "kpi", "node_id": "kpi_pending_queue_size", "node_label": "Pending Queue Size (per stage)", "description": "Parameterised count of items in each pending workflow state. Stages: check_in_pending (requested but not started), checkout_pending (requested checkout but no approval), intp_pending (E911 not yet Ready_Completed), rf010_pending (received but not completed), call_test_red (RED status). Routes to the correct source table based on the \'stage\' filter\u003B if stage is omitted, returns one row per stage with its count.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_cbn_pending_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_cbn_pending_count', label: 'CBN Tool Downtime Pending Count', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Count of CBN (Code Block Number) validation requests that submitted but never got approved (request_time IS NOT NULL AND approve_time IS NULL). A spike in this count for a market or date window is the canonical signal that the CBN tool is down or unresponsive during E911 testing.', nl_description: 'Count of CBN (Code Block Number) validation requests that submitted but never got approved (request_time IS NOT NULL AND approve_time IS NULL). A spike in this count for a market or date window is the canonical signal that the CBN tool is down or unresponsive during E911 testing.', nl_business_rule: 'CBN Tool Downtime Pending Count measures how many CBN validation requests were submitted but never approved, which is a key sign the CBN tool was down or unresponsive during E911 testing. It helps answer where and when CBN processing is getting stuck and whether downtime is affecting testing activity. You can break it down by region, market, and project category.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_cbn_pending_count', kpi_name: 'CBN Tool Downtime Pending Count', kpi_description: 'Count of CBN (Code Block Number) validation requests that submitted but never got approved (request_time IS NOT NULL AND approve_time IS NULL). A spike in this count for a market or date window is the canonical signal that the CBN tool is down or unresponsive during E911 testing.', kpi_formula_description: 'COUNT(*) FILTER (WHERE nas_cbn_approve_time IS NULL) over rows WHERE nas_cbn_request_time IS NOT NULL, grouped by derived region × market × project_category. Pending_pct = pending_count / total_cbn_requests.', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\nDERIVED_REGION_SQL = \'\\nCASE\\n  WHEN LOWER("nas_market") IN (\\\'seattle\\\',\\\'phoenix\\\',\\\'spokane\\\',\\\'montana\\\',\\\'portland\\\') THEN \\\'West\\\'\\n  WHEN LOWER("nas_market") IN (\\\'atlanta\\\',\\\'austin\\\',\\\'dallas\\\',\\\'bhm-mem\\\',\\\'mobile\\\',\\\'puertorico\\\',\\\'houston\\\') THEN \\\'South\\\'\\n  WHEN LOWER("nas_market") IN (\\\'chicago\\\',\\\'milwaukee\\\',\\\'detroit\\\',\\\'minneapolis\\\',\\\'denver\\\',\\\'dakotas\\\',\\\'omaha\\\',\\\'des moines\\\',\\\'oklahoma\\\',\\\'kansascity\\\',\\\'arkansas\\\',\\\'indianapolis\\\',\\\'wichita\\\',\\\'tulsa\\\',\\\'stlouis\\\',\\\'columbus\\\',\\\'cleveland\\\',\\\'nashville\\\',\\\'louisville\\\',\\\'knoxville\\\',\\\'westvirginia\\\',\\\'cincinnati\\\',\\\'pittsburgh\\\') THEN \\\'Central\\\'\\n  ELSE NULL\\nEND\\n\'\n# ─────────── end inlined prelude ───────────\n\ndef get_cbn_pending_count(execute_query, filters=None):\n    """KPI — CBN Tool Downtime Pending Count.\n\n    Counts CBN-validation requests that submitted but never got approved\n    (request_time IS NOT NULL AND approve_time IS NULL). A spike in this\n    count for a market or date window is the canonical signal that the\n    CBN tool is down or slow during E911 testing.\n    """\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_cbn_request_time",\n    )\n    sql = f"""\n        SELECT\n            {DERIVED_REGION_SQL} AS region,\n            "nas_market"   AS market,\n            "nas_project_category" AS project_category,\n            COUNT(*) AS total_cbn_requests,\n            COUNT(*) FILTER (WHERE "nas_cbn_approve_time" IS NULL)\n                AS pending_count,\n            ROUND(\n              100.0 * COUNT(*) FILTER (WHERE "nas_cbn_approve_time" IS NULL)\n              / NULLIF(COUNT(*), 0), 2\n            ) AS pending_pct\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {where}" if where else "WHERE 1=1"}\n          AND "nas_cbn_request_time" IS NOT NULL\n        GROUP BY 1, 2, 3\n        ORDER BY pending_count DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['cbn_validation', 'nas_session', 'market', 'region', 'project_category'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_cbn_request_time', 'nas_cbn_approve_time', 'nas_market', 'nas_project_category'], kpi_dimensions: ['region', 'market', 'project_category'], kpi_business_logic: '"COUNT(*) FILTER (WHERE nas_cbn_approve_time IS NULL) over rows WHERE nas_cbn_request_time IS NOT NULL, grouped by derived region \\u00d7 market \\u00d7 project_category. Pending_pct = pending_count / total_cbn_requests."', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_cbn_pending_count", "node_type": "kpi", "node_id": "kpi_cbn_pending_count", "node_label": "CBN Tool Downtime Pending Count", "description": "Count of CBN (Code Block Number) validation requests that submitted but never got approved (request_time IS NOT NULL AND approve_time IS NULL). A spike in this count for a market or date window is the canonical signal that the CBN tool is down or unresponsive during E911 testing.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_cbn_approval_turnaround', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_cbn_approval_turnaround', label: 'CBN Approval Turnaround Time', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Average / p50 / p95 minutes between CBN validation request and approval, plus a count of breaches above the 60-minute threshold. Elevated turnaround is the secondary CBN tool downtime signal — the tool is reachable but sluggish, which delays every dependent E911 call test.', nl_description: 'Average / p50 / p95 minutes between CBN validation request and approval, plus a count of breaches above the 60-minute threshold. Elevated turnaround is the secondary CBN tool downtime signal — the tool is reachable but sluggish, which delays every dependent E911 call test.', nl_business_rule: 'CBN Approval Turnaround Time measures how long it takes, in minutes, for a CBN validation request to be approved, including typical, median, and high-end wait times and how often the 60-minute limit is breached. It helps answer whether the CBN tool is slowing down even when it is still reachable, and where that delay is affecting dependent E911 call testing. You can analyze it by region and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_cbn_approval_turnaround', kpi_name: 'CBN Approval Turnaround Time', kpi_description: 'Average / p50 / p95 minutes between CBN validation request and approval, plus a count of breaches above the 60-minute threshold. Elevated turnaround is the secondary CBN tool downtime signal — the tool is reachable but sluggish, which delays every dependent E911 call test.', kpi_formula_description: 'AVG / percentile_cont(0.5,0.95) of (nas_cbn_approve_time - nas_cbn_request_time) in minutes, plus COUNT FILTER WHERE delta > 60 min. Grouped by derived region × market. Only approved rows (both timestamps non-null) contribute.', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\nDERIVED_REGION_SQL = \'\\nCASE\\n  WHEN LOWER("nas_market") IN (\\\'seattle\\\',\\\'phoenix\\\',\\\'spokane\\\',\\\'montana\\\',\\\'portland\\\') THEN \\\'West\\\'\\n  WHEN LOWER("nas_market") IN (\\\'atlanta\\\',\\\'austin\\\',\\\'dallas\\\',\\\'bhm-mem\\\',\\\'mobile\\\',\\\'puertorico\\\',\\\'houston\\\') THEN \\\'South\\\'\\n  WHEN LOWER("nas_market") IN (\\\'chicago\\\',\\\'milwaukee\\\',\\\'detroit\\\',\\\'minneapolis\\\',\\\'denver\\\',\\\'dakotas\\\',\\\'omaha\\\',\\\'des moines\\\',\\\'oklahoma\\\',\\\'kansascity\\\',\\\'arkansas\\\',\\\'indianapolis\\\',\\\'wichita\\\',\\\'tulsa\\\',\\\'stlouis\\\',\\\'columbus\\\',\\\'cleveland\\\',\\\'nashville\\\',\\\'louisville\\\',\\\'knoxville\\\',\\\'westvirginia\\\',\\\'cincinnati\\\',\\\'pittsburgh\\\') THEN \\\'Central\\\'\\n  ELSE NULL\\nEND\\n\'\n# ─────────── end inlined prelude ───────────\n\ndef get_cbn_approval_turnaround(execute_query, filters=None):\n    """KPI — CBN Approval Turnaround Time (minutes).\n\n    AVG / p50 / p95 minutes between CBN request and approval, plus a\n    breach count above the 60-minute threshold. Elevated turnaround is\n    the secondary CBN tool downtime signal (the tool is reachable but\n    sluggish).\n    """\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_cbn_request_time",\n    )\n    sql = f"""\n        SELECT\n            {DERIVED_REGION_SQL} AS region,\n            "nas_market"   AS market,\n            COUNT(*) AS approved_count,\n            ROUND(AVG(EXTRACT(EPOCH FROM (\n                "nas_cbn_approve_time"::timestamp\n              - "nas_cbn_request_time"::timestamp)) / 60.0)::numeric, 2)\n                AS avg_minutes,\n            ROUND(percentile_cont(0.5) WITHIN GROUP (ORDER BY\n                EXTRACT(EPOCH FROM (\n                    "nas_cbn_approve_time"::timestamp\n                  - "nas_cbn_request_time"::timestamp)) / 60.0\n            )::numeric, 2) AS p50_minutes,\n            ROUND(percentile_cont(0.95) WITHIN GROUP (ORDER BY\n                EXTRACT(EPOCH FROM (\n                    "nas_cbn_approve_time"::timestamp\n                  - "nas_cbn_request_time"::timestamp)) / 60.0\n            )::numeric, 2) AS p95_minutes,\n            COUNT(*) FILTER (\n                WHERE EXTRACT(EPOCH FROM (\n                          "nas_cbn_approve_time"::timestamp\n                        - "nas_cbn_request_time"::timestamp)) / 60.0 > 60\n            ) AS breach_over_60_min_count\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {where}" if where else "WHERE 1=1"}\n          AND "nas_cbn_request_time" IS NOT NULL\n          AND "nas_cbn_approve_time" IS NOT NULL\n        GROUP BY 1, 2\n        ORDER BY avg_minutes DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['cbn_validation', 'nas_session', 'market', 'region'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_cbn_request_time', 'nas_cbn_approve_time', 'nas_market'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"AVG / percentile_cont(0.5,0.95) of (nas_cbn_approve_time - nas_cbn_request_time) in minutes, plus COUNT FILTER WHERE delta > 60 min. Grouped by derived region \\u00d7 market. Only approved rows (both timestamps non-null) contribute."', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_cbn_approval_turnaround", "node_type": "kpi", "node_id": "kpi_cbn_approval_turnaround", "node_label": "CBN Approval Turnaround Time", "description": "Average / p50 / p95 minutes between CBN validation request and approval, plus a count of breaches above the 60-minute threshold. Elevated turnaround is the secondary CBN tool downtime signal \\u2014 the tool is reachable but sluggish, which delays every dependent E911 call test.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_event_diagnoser', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_event_diagnoser', label: 'Event Diagnoser', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended diagnostic capability over the NAS event log. Accepts any event_type (or event_types list) and auto-selects the right cause taxonomy. Used to answer ANY question about why events of a given category occurred (rejection causes, pending reasons, failure breakdowns).', nl_description: 'Open-ended diagnostic capability over the NAS event log. Accepts any event_type (or event_types list) and auto-selects the right cause taxonomy. Used to answer ANY question about why events of a given category occurred (rejection causes, pending reasons, failure breakdowns).', nl_business_rule: 'Event Diagnoser is a diagnostic view that explains why NAS events happened by identifying the most likely root causes for any event category. It answers open-ended questions like why rejections, pending cases, or failures are occurring and whether each issue should be monitored or investigated. Results can be broken down by market, event type, and cause.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_event_diagnoser', kpi_name: 'Event Diagnoser', kpi_description: 'Open-ended diagnostic capability over the NAS event log. Accepts any event_type (or event_types list) and auto-selects the right cause taxonomy. Used to answer ANY question about why events of a given category occurred (rejection causes, pending reasons, failure breakdowns).', kpi_formula_description: 'Aggregate cause-taxonomy counts from stg_nas_log_data grouped by market\u003B classify root-cause class\u003B return \'investigate\' vs \'monitor\' per (market, cause).', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\nCAUSE_TAXONOMIES = {\'check_in_rejection\': {\'Invalid CR\': [\'invalid\', \'cr \', \' cr.\'], \'Outage Pending\': [\'outage\', \'pending\'], \'Unavailable PO\': [\'po \', \'unavail\', \'purchase\'], \'Existing Layer Outage\': [\'layer\', \'outage\'], \'Duplicate Session\': [\'duplicate\', \'duplicat\']}, \'checkout_rejection\': {\'Alarms\': [\'alarm\'], \'Cell Down\': [\'cell down\', \'cell-down\'], \'RTWP\': [\'rtwp\'], \'Pending Clearance\': [\'clearance\', \'pending\'], \'Open Incident\': [\'incident\', \'ticket\']}, \'e911_red\': {\'RIOT Mismatch\': [\'riot\', \'mismatch\'], \'CBN Issue\': [\'cbn\'], \'Duplicate CGI\': [\'cgi\', \'duplicate\'], \'New Layer Failure\': [\'new layer\', \'layer failure\'], \'GMLC/eSMLC Sync\': [\'gmlc\', \'esmlc\', \'sync\']}, \'intp_delay\': {\'Dependency Delay\': [\'dependency\', \'depend\'], \'Approval Pending\': [\'approval\', \'pending\'], \'Resource Shortage\': [\'resource\', \'staffing\'], \'Tool Downtime\': [\'tool\', \'downtime\', \'outage\'], \'Backlog\': [\'backlog\']}, \'nest_extension_rejection\': {\'Invalid Request\': [\'invalid\', \'incorrect\'], \'Missing Approval\': [\'approval\', \'missing\'], \'SLA Exceeded\': [\'sla\', \'exceeded\'], \'Site ID Mismatch\': [\'site id\', \'mismatch\'], \'Duplicate Request\': [\'duplicate\']}}\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_event_diagnoser(execute_query, filters=None):\n    """Universal RCA for any failure event recorded in `stg_nas_log_data`.\n\n    Pass `filters[\'event_type\']` (or `event_types` list) to focus on one or\n    more event categories (e.g. \'Nest Rejected\', \'Conditional Approval-Rejected\',\n    \'Nest Pending\'). Omit it to scan ALL non-approval events.\n\n    Classification is taxonomy-driven (CAUSE_TAXONOMIES) and chosen automatically\n    from the event_type label.\n    """\n    filt = dict(filters or {})\n    event_types = filt.pop("event_types", None) or ([filt.pop("event_type")] if filt.get("event_type") else None)\n    extras = []\n    params_overlay = {}\n    if event_types:\n        extras.append(\'"nas_event_type" = ANY(%(_event_types)s::text[])\')\n        params_overlay["_event_types"] = event_types\n    else:\n        extras.append("(\\"nas_event_type\\" ILIKE \'%%reject%%\' OR \\"nas_event_type\\" ILIKE \'%%pending%%\' OR \\"nas_event_type\\" ILIKE \'%%fail%%\')")\n    where, params = apply_filters("stg_nas_log_data", filt, time_column="nas_event_time", extra_required=extras)\n    params.update(params_overlay)\n    sql = f"""\n        SELECT "nas_event_type" AS event_type, "nas_region" AS region, "nas_market" AS market,\n               "nas_site_id" AS site_id, "nas_session_id" AS session_id,\n               "nas_activity_type" AS activity_type, "nas_event_time"::timestamp AS event_time\n        FROM {fq("stg_nas_log_data")}\n        WHERE {where}\n        ORDER BY event_time DESC NULLS LAST\n        LIMIT 500\n    """\n    rows = execute_query(sql, params)\n    # Pick taxonomy by majority event_type signal\n    sample_event = (rows[0]["event_type"] if rows else "").lower()\n    taxonomy_key = (\n        "check_in_rejection" if "nest rejected" in sample_event else\n        "checkout_rejection" if "conditional" in sample_event else\n        "intp_delay" if "intp" in sample_event else\n        "check_in_rejection"\n    )\n    taxonomy = CAUSE_TAXONOMIES[taxonomy_key]\n    by_market: dict[str, dict] = {}\n    for r in rows:\n        m = r.get("market") or "UNKNOWN"\n        cause = _classify(f"{r.get(\'event_type\',\'\')} {r.get(\'activity_type\',\'\')}", taxonomy)\n        bucket = by_market.setdefault(m, {"causes": {}, "samples": [], "total": 0, "event_types": set()})\n        bucket["causes"][cause] = bucket["causes"].get(cause, 0) + 1\n        bucket["total"] += 1\n        bucket["event_types"].add(r.get("event_type"))\n        if len(bucket["samples"]) < 3:\n            bucket["samples"].append({"site_id": r.get("site_id"), "session_id": r.get("session_id"), "event_time": str(r.get("event_time", ""))})\n    out = []\n    for m, b in sorted(by_market.items(), key=lambda kv: -kv[1]["total"]):\n        top = max(b["causes"], key=b["causes"].get) if b["causes"] else "—"\n        out.append({\n            "entity": m,\n            "decision": "investigate" if b["total"] >= 5 else "monitor",\n            "reason": f"Top cause: {top} ({b[\'causes\'].get(top, 0)} of {b[\'total\']} events)",\n            "evidence": {\n                "causes": b["causes"],\n                "event_types_seen": sorted(b["event_types"]),\n                "samples": b["samples"],\n                "taxonomy_used": taxonomy_key,\n            },\n        })\n    return out\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_log_event', 'rejection_event', 'nas_session', 'market', 'region'], kpi_related_kpi_ids: ['kpi_rejection_rate'], kpi_source_tables: ['stg_nas_log_data'], kpi_source_columns: ['nas_event_type', 'nas_market', 'nas_site_id', 'nas_session_id'], kpi_dimensions: ['market', 'cause', 'event_type'], kpi_business_logic: '"Aggregate cause-taxonomy counts from stg_nas_log_data grouped by market\u003B classify root-cause class\u003B return \'investigate\' vs \'monitor\' per (market, cause)."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "evaluate_event_diagnoser", "node_type": "kpi", "node_id": "kpi_event_diagnoser", "node_label": "Event Diagnoser", "description": "Open-ended diagnostic capability over the NAS event log. Accepts any event_type (or event_types list) and auto-selects the right cause taxonomy. Used to answer ANY question about why events of a given category occurred (rejection causes, pending reasons, failure breakdowns).", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_sla_compliance_diagnoser', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_sla_compliance_diagnoser', label: 'SLA Compliance Diagnoser', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended SLA compliance lens. Pass sla_kind ∈ {checkin, checkout, rf010} or omit it to evaluate all three SLA families. Powers any question about SLA breach magnitude, market hotspots, or trend.', nl_description: 'Open-ended SLA compliance lens. Pass sla_kind ∈ {checkin, checkout, rf010} or omit it to evaluate all three SLA families. Powers any question about SLA breach magnitude, market hotspots, or trend.', nl_business_rule: 'SLA Compliance Diagnoser is a diagnostic KPI that assesses whether service levels are being met across check-in, checkout, and RF010 work, and highlights where performance needs attention. It answers questions about the size of SLA breaches, where the biggest problem areas are, and whether a market should be monitored or investigated. Results can be sliced by market and SLA type, with rollups to region.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_sla_compliance_diagnoser', kpi_name: 'SLA Compliance Diagnoser', kpi_description: 'Open-ended SLA compliance lens. Pass sla_kind ∈ {checkin, checkout, rf010} or omit it to evaluate all three SLA families. Powers any question about SLA breach magnitude, market hotspots, or trend.', kpi_formula_description: 'Pull SLA compliance rate per (market, sla_kind)\u003B flag \'investigate\' if compliance < 70%, else \'monitor\'.', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_sla_compliance_diagnoser(execute_query, filters=None):\n    """Universal SLA-breach RCA. Pass `filters[\'sla_kind\']` ∈ {\'checkin\',\'checkout\',\'rf010\'}\n    to focus on a specific SLA family\u003B omit to evaluate all three side-by-side.\n    Returns one row per (entity, sla_kind) combination with compliance %, threshold,\n    and the top breach contributor where derivable.\n    """\n    filt = dict(filters or {})\n    sla_kind = filt.pop("sla_kind", None)\n    out = []\n\n    def add(rows, sla_label, threshold, value_key, pct_key):\n        for r in rows:\n            pct = r.get(pct_key)\n            avg = r.get(value_key)\n            breach = pct is not None and pct < 70\n            out.append({\n                "entity": r.get("market"),\n                "decision": "investigate" if breach else "monitor",\n                "reason": f"{sla_label} compliance {pct}% (target ≥ 70%, threshold {threshold})",\n                "evidence": {"sla_kind": sla_label, "avg_value": avg, "threshold": threshold, "compliance_pct": pct},\n            })\n\n    if sla_kind in (None, "checkout"):\n        add(get_checkout_sla_compliance(execute_query, filt), "checkout", "15 min", "total_checkouts", "sla_compliance_pct")\n    if sla_kind in (None, "rf010"):\n        add(get_rf010_turnaround(execute_query, filt), "rf010", "240 min", "avg_turnaround_minutes", "sla_compliance_pct")\n    if sla_kind in (None, "checkin"):\n        # Surrogate: % sessions where (checkout_time - nest_start_time) <= 60 min (proxy for check-in efficiency)\n        where, params = apply_filters("stg_nas_session_level_combined_data", filt, time_column="nas_nest_start_time",\n                                       extra_required=[\'"nas_nest_start_time" IS NOT NULL\', \'"nas_checkout_time" IS NOT NULL\'])\n        rows = execute_query(f"""\n            SELECT "nas_market" AS market, COUNT(*) AS total,\n                   ROUND(100.0 * COUNT(*) FILTER (\n                       WHERE EXTRACT(EPOCH FROM ("nas_checkout_time"::timestamp - "nas_nest_start_time"::timestamp))/60 <= 60\n                   ) / NULLIF(COUNT(*),0), 2) AS sla_compliance_pct\n            FROM {fq("stg_nas_session_level_combined_data")}\n            WHERE {where}\n            GROUP BY 1 ORDER BY sla_compliance_pct DESC NULLS LAST\n        """, params)\n        for r in rows:\n            pct = r.get("sla_compliance_pct")\n            out.append({\n                "entity": r.get("market"),\n                "decision": "investigate" if pct is not None and pct < 70 else "monitor",\n                "reason": f"check-in window compliance {pct}% (proxy: nest→checkout ≤ 60 min)",\n                "evidence": {"sla_kind": "checkin_proxy", "total_sessions": r.get("total"), "compliance_pct": pct},\n            })\n    return out\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'rf010_task', 'market', 'region'], kpi_related_kpi_ids: ['kpi_checkout_sla_compliance', 'kpi_rf010_turnaround', 'kpi_check_in_sla_compliance', 'kpi_rf010_sla_adherence'], kpi_source_tables: ['stg_nas_session_level_combined_data', 'stg_nas_rf010_dashboard'], kpi_source_columns: ['nas_nest_start_time', 'nas_checkout_time', 'nas_checkout_approve_time', 'task_received_datetime', 'task_completed_datetime'], kpi_dimensions: ['market', 'sla_kind'], kpi_business_logic: '"Pull SLA compliance rate per (market, sla_kind)\u003B flag \'investigate\' if compliance < 70%, else \'monitor\'."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "evaluate_sla_compliance_diagnoser", "node_type": "kpi", "node_id": "kpi_sla_compliance_diagnoser", "node_label": "SLA Compliance Diagnoser", "description": "Open-ended SLA compliance lens. Pass sla_kind \\u2208 {checkin, checkout, rf010} or omit it to evaluate all three SLA families. Powers any question about SLA breach magnitude, market hotspots, or trend.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_gate_blocker_finder', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_gate_blocker_finder', label: 'Gate Blocker Finder', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended gate-blocker locator. Pass gate_kind ∈ {e911, call_test, rf010_oa} or omit to scan all gates. Surfaces every site currently held at any workflow gate and classifies the blocking layer.', nl_description: 'Open-ended gate-blocker locator. Pass gate_kind ∈ {e911, call_test, rf010_oa} or omit to scan all gates. Surfaces every site currently held at any workflow gate and classifies the blocking layer.', nl_business_rule: 'Gate Blocker Finder identifies sites that are currently stuck at key workflow gates and shows which layer is causing the hold. It answers questions like which sites are blocked on E911 readiness, call testing, or RF010 completion, and where the bottleneck sits. Results can be sliced by gate type, site, and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_gate_blocker_finder', kpi_name: 'Gate Blocker Finder', kpi_description: 'Open-ended gate-blocker locator. Pass gate_kind ∈ {e911, call_test, rf010_oa} or omit to scan all gates. Surfaces every site currently held at any workflow gate and classifies the blocking layer.', kpi_formula_description: 'Per gate (E911 readiness, call-test outcome, RF010 completion) list sites where the gate hasn\'t cleared\u003B classify the blocking layer.', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\nCAUSE_TAXONOMIES = {\'check_in_rejection\': {\'Invalid CR\': [\'invalid\', \'cr \', \' cr.\'], \'Outage Pending\': [\'outage\', \'pending\'], \'Unavailable PO\': [\'po \', \'unavail\', \'purchase\'], \'Existing Layer Outage\': [\'layer\', \'outage\'], \'Duplicate Session\': [\'duplicate\', \'duplicat\']}, \'checkout_rejection\': {\'Alarms\': [\'alarm\'], \'Cell Down\': [\'cell down\', \'cell-down\'], \'RTWP\': [\'rtwp\'], \'Pending Clearance\': [\'clearance\', \'pending\'], \'Open Incident\': [\'incident\', \'ticket\']}, \'e911_red\': {\'RIOT Mismatch\': [\'riot\', \'mismatch\'], \'CBN Issue\': [\'cbn\'], \'Duplicate CGI\': [\'cgi\', \'duplicate\'], \'New Layer Failure\': [\'new layer\', \'layer failure\'], \'GMLC/eSMLC Sync\': [\'gmlc\', \'esmlc\', \'sync\']}, \'intp_delay\': {\'Dependency Delay\': [\'dependency\', \'depend\'], \'Approval Pending\': [\'approval\', \'pending\'], \'Resource Shortage\': [\'resource\', \'staffing\'], \'Tool Downtime\': [\'tool\', \'downtime\', \'outage\'], \'Backlog\': [\'backlog\']}, \'nest_extension_rejection\': {\'Invalid Request\': [\'invalid\', \'incorrect\'], \'Missing Approval\': [\'approval\', \'missing\'], \'SLA Exceeded\': [\'sla\', \'exceeded\'], \'Site ID Mismatch\': [\'site id\', \'mismatch\'], \'Duplicate Request\': [\'duplicate\']}}\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_gate_blocker_finder(execute_query, filters=None):\n    """Universal readiness-gap analysis. `filters[\'gate_kind\']` ∈\n    {\'e911\',\'call_test\',\'rf010_oa\'} chooses the gate\u003B omit to scan all.\n    Surfaces sites blocked at that gate and classifies the blocking layer.\n    """\n    filt = dict(filters or {})\n    gate = filt.pop("gate_kind", None)\n    out = []\n\n    if gate in (None, "e911"):\n        where, params = apply_filters(\n            "stg_nas_e911_readiness_riot_validation", filt,\n            time_column="nas_e911_validation_date",\n            extra_required=["\\"nas_validate_e911_readiness\\" NOT ILIKE \'Ready%%\'"],\n        )\n        rows = execute_query(f"""\n            SELECT "nas_site_id" AS site_id, "nas_market" AS market, "nas_engineer" AS engineer,\n                   "nas_validate_e911_readiness" AS readiness,\n                   "nas_consolidation_check_all_layers" AS consolidation\n            FROM {fq("stg_nas_e911_readiness_riot_validation")}\n            WHERE {where}\n            LIMIT 200\n        """, params)\n        for r in rows:\n            layer = _classify(f"{r.get(\'readiness\',\'\')} {r.get(\'consolidation\',\'\')}", CAUSE_TAXONOMIES["e911_red"])\n            out.append({\n                "entity": r["site_id"],\n                "decision": "remediate",\n                "reason": f"E911 gate blocked — failure layer: {layer}",\n                "evidence": {"gate": "e911", "market": r.get("market"), "engineer": r.get("engineer"), "readiness": r.get("readiness")},\n            })\n\n    if gate in (None, "call_test"):\n        where, params = apply_filters(\n            "stg_nas_e2e_call_test_completion", filt,\n            time_column="nas_integration_date",\n            extra_required=["\\"nas_call_test_completion_status\\" ILIKE \'RED\'"],\n        )\n        rows = execute_query(f"""\n            SELECT "nas_site_id" AS site_id, "nas_market" AS market, "nas_go_email_responsibility" AS engineer\n            FROM {fq("stg_nas_e2e_call_test_completion")}\n            WHERE {where}\n            LIMIT 200\n        """, params)\n        for r in rows:\n            out.append({\n                "entity": r["site_id"],\n                "decision": "remediate",\n                "reason": "Call test gate blocked — status RED",\n                "evidence": {"gate": "call_test", "market": r.get("market"), "engineer": r.get("engineer")},\n            })\n\n    if gate in (None, "rf010_oa"):\n        where, params = apply_filters(\n            "stg_nas_rf010_dashboard", filt,\n            time_column="task_received_datetime",\n            extra_required=["\\"activity_tracker_state\\" NOT ILIKE \'Completed\'"],\n        )\n        rows = execute_query(f"""\n            SELECT "project_site_id" AS site_id, "market_id" AS market, "activity_tracker_state" AS state,\n                   "on_hold_status" AS on_hold\n            FROM {fq("stg_nas_rf010_dashboard")}\n            WHERE {where}\n            LIMIT 200\n        """, params)\n        for r in rows:\n            out.append({\n                "entity": r["site_id"],\n                "decision": "remediate",\n                "reason": f"RF010 gate not Completed — state \'{r.get(\'state\')}\'",\n                "evidence": {"gate": "rf010_oa", "market": r.get("market"), "on_hold": r.get("on_hold")},\n            })\n    return out\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e911_validation', 'e2e_call_test', 'rf010_task', 'site', 'layer', 'e911_consolidation_check'], kpi_related_kpi_ids: ['kpi_e911_readiness_index', 'kpi_call_test_completion_rate', 'kpi_rf010_completion_rate'], kpi_source_tables: ['stg_nas_e911_readiness_riot_validation', 'stg_nas_e2e_call_test_completion', 'stg_nas_rf010_dashboard'], kpi_source_columns: ['nas_validate_e911_readiness', 'nas_call_test_completion_status', 'activity_tracker_state', 'mb_status'], kpi_dimensions: ['gate_kind', 'site', 'market'], kpi_business_logic: '"Per gate (E911 readiness, call-test outcome, RF010 completion) list sites where the gate hasn\'t cleared\u003B classify the blocking layer."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "evaluate_gate_blocker_finder", "node_type": "kpi", "node_id": "kpi_gate_blocker_finder", "node_label": "Gate Blocker Finder", "description": "Open-ended gate-blocker locator. Pass gate_kind \\u2208 {e911, call_test, rf010_oa} or omit to scan all gates. Surfaces every site currently held at any workflow gate and classifies the blocking layer.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_workload_optimizer', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_workload_optimizer', label: 'Workload Optimizer', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended workload-rebalance capability. Pass entity_dim ∈ {gc, engineer, market} to choose the comparison plane and quality_threshold_pct to tune sensitivity. Powers any rebalance/reassignment question.', nl_description: 'Open-ended workload-rebalance capability. Pass entity_dim ∈ {gc, engineer, market} to choose the comparison plane and quality_threshold_pct to tune sensitivity. Powers any rebalance/reassignment question.', nl_business_rule: 'Workload Optimizer identifies where work should be reassigned to improve quality and balance capacity across the business. It answers questions about which GCs, engineers, or markets are overloaded while underperforming and therefore are candidates for rebalancing. Results can be viewed by comparison level such as GC, engineer, or market, and sliced by market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_workload_optimizer', kpi_name: 'Workload Optimizer', kpi_description: 'Open-ended workload-rebalance capability. Pass entity_dim ∈ {gc, engineer, market} to choose the comparison plane and quality_threshold_pct to tune sensitivity. Powers any rebalance/reassignment question.', kpi_formula_description: 'Compare entity quality (gc_quality_index, call_test_completion_rate) against threshold\u003B recommend rebalance if quality < threshold AND load > median.', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_workload_optimizer(execute_query, filters=None):\n    """Universal: identify entities (GCs / engineers / markets) that are under-\n    performing while over-loaded, recommend rebalance.\n\n    `filters[\'entity_dim\']` ∈ {\'gc\',\'engineer\',\'market\'}\u003B default \'gc\'.\n    `filters[\'quality_threshold_pct\']` (default 70).\n    """\n    filt = dict(filters or {})\n    dim = filt.pop("entity_dim", "gc")\n    threshold = float(filt.pop("quality_threshold_pct", 70))\n    out = []\n\n    if dim == "gc":\n        rows = get_gc_quality_index(execute_query, filt)\n        by_market: dict[str, list] = {}\n        for r in rows:\n            by_market.setdefault(r.get("market") or "UNKNOWN", []).append(r)\n        for m, gcs in by_market.items():\n            if not gcs:\n                continue\n            sessions_sorted = sorted([g.get("total_sessions") or 0 for g in gcs])\n            median = sessions_sorted[len(sessions_sorted) // 2]\n            for g in gcs:\n                qi = g.get("quality_index_pct") or 0\n                ts = g.get("total_sessions") or 0\n                if qi < threshold and ts > median:\n                    peer = max(gcs, key=lambda x: x.get("quality_index_pct") or 0)\n                    out.append({\n                        "entity": g.get("gc_name"),\n                        "decision": "rebalance",\n                        "reason": f"GC quality {qi}% < {threshold}% AND load {ts} > market_median {median}",\n                        "evidence": {"dim": "gc", "market": m, "current_quality": qi, "load": ts, "suggested_peer": peer.get("gc_name"), "peer_quality": peer.get("quality_index_pct")},\n                    })\n\n    elif dim == "engineer":\n        # Use call_test_red_wip as the engineer-level metric\n        rows = get_call_test_red_wip(execute_query, filt)\n        by_market: dict[str, list] = {}\n        for r in rows:\n            by_market.setdefault(r.get("market") or "UNKNOWN", []).append(r)\n        for m, engs in by_market.items():\n            if not engs:\n                continue\n            med = sorted([e.get("red_wip_sites") or 0 for e in engs])[len(engs) // 2]\n            for e in engs:\n                wip = e.get("red_wip_sites") or 0\n                if wip > 2 * med and wip >= 5:\n                    out.append({\n                        "entity": e.get("engineer"),\n                        "decision": "rebalance",\n                        "reason": f"Engineer Red WIP {wip} > 2× market median ({med})",\n                        "evidence": {"dim": "engineer", "market": m, "red_wip": wip, "market_median": med},\n                    })\n\n    elif dim == "market":\n        rates = get_call_test_completion_rate(execute_query, filt)\n        for r in rates:\n            green = r.get("green_pct") or 0\n            if green < threshold:\n                out.append({\n                    "entity": r.get("market"),\n                    "decision": "rebalance",\n                    "reason": f"Market green-rate {green}% < {threshold}%",\n                    "evidence": {"dim": "market", "region": r.get("region"), "green_pct": green, "total_tests": r.get("total_tests")},\n                })\n    return out\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'gc', 'engineer', 'market'], kpi_related_kpi_ids: ['kpi_gc_quality_index', 'kpi_call_test_red_wip', 'kpi_call_test_completion_rate'], kpi_source_tables: ['stg_nas_session_level_combined_data', 'stg_nas_e2e_call_test_completion'], kpi_source_columns: ['nas_primary_gc', 'nas_go_email_responsibility', 'nas_market'], kpi_dimensions: ['entity_dim', 'market'], kpi_business_logic: '"Compare entity quality (gc_quality_index, call_test_completion_rate) against threshold\u003B recommend rebalance if quality < threshold AND load > median."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "evaluate_workload_optimizer", "node_type": "kpi", "node_id": "kpi_workload_optimizer", "node_label": "Workload Optimizer", "description": "Open-ended workload-rebalance capability. Pass entity_dim \\u2208 {gc, engineer, market} to choose the comparison plane and quality_threshold_pct to tune sensitivity. Powers any rebalance/reassignment question.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_remediation_planner', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_remediation_planner', label: 'Remediation Planner', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended remediation capability. Pass failure_source ∈ {e911, call_test, rf010} to focus, or leave default. Returns one row per failing entity with classified failure layer, suggested owner, and prescribed remediation step.', nl_description: 'Open-ended remediation capability. Pass failure_source ∈ {e911, call_test, rf010} to focus, or leave default. Returns one row per failing entity with classified failure layer, suggested owner, and prescribed remediation step.', nl_business_rule: 'Remediation Planner identifies each failing entity, classifies the root failure layer, and recommends the right owner and next remediation step. It answers what is failing, who should act, and what action should be taken to resolve it. Results can be focused by failure source and compared across markets.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_remediation_planner', kpi_name: 'Remediation Planner', kpi_description: 'Open-ended remediation capability. Pass failure_source ∈ {e911, call_test, rf010} to focus, or leave default. Returns one row per failing entity with classified failure layer, suggested owner, and prescribed remediation step.', kpi_formula_description: 'Per failing entity classify the failure layer (RIOT mismatch, CBN issue, etc.)\u003B assign owner (engineer or PM)\u003B attach remediation_step.', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\nCAUSE_TAXONOMIES = {\'check_in_rejection\': {\'Invalid CR\': [\'invalid\', \'cr \', \' cr.\'], \'Outage Pending\': [\'outage\', \'pending\'], \'Unavailable PO\': [\'po \', \'unavail\', \'purchase\'], \'Existing Layer Outage\': [\'layer\', \'outage\'], \'Duplicate Session\': [\'duplicate\', \'duplicat\']}, \'checkout_rejection\': {\'Alarms\': [\'alarm\'], \'Cell Down\': [\'cell down\', \'cell-down\'], \'RTWP\': [\'rtwp\'], \'Pending Clearance\': [\'clearance\', \'pending\'], \'Open Incident\': [\'incident\', \'ticket\']}, \'e911_red\': {\'RIOT Mismatch\': [\'riot\', \'mismatch\'], \'CBN Issue\': [\'cbn\'], \'Duplicate CGI\': [\'cgi\', \'duplicate\'], \'New Layer Failure\': [\'new layer\', \'layer failure\'], \'GMLC/eSMLC Sync\': [\'gmlc\', \'esmlc\', \'sync\']}, \'intp_delay\': {\'Dependency Delay\': [\'dependency\', \'depend\'], \'Approval Pending\': [\'approval\', \'pending\'], \'Resource Shortage\': [\'resource\', \'staffing\'], \'Tool Downtime\': [\'tool\', \'downtime\', \'outage\'], \'Backlog\': [\'backlog\']}, \'nest_extension_rejection\': {\'Invalid Request\': [\'invalid\', \'incorrect\'], \'Missing Approval\': [\'approval\', \'missing\'], \'SLA Exceeded\': [\'sla\', \'exceeded\'], \'Site ID Mismatch\': [\'site id\', \'mismatch\'], \'Duplicate Request\': [\'duplicate\']}}\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_remediation_planner(execute_query, filters=None):\n    """Universal: for any flagged failure surface (NOT-READY E911, RED call test,\n    pending RF010), classify failure layer and assign owner + remediation step.\n\n    `filters[\'failure_source\']` ∈ {\'e911\',\'call_test\',\'rf010\'}\u003B default \'e911\'.\n    """\n    filt = dict(filters or {})\n    source = filt.pop("failure_source", "e911")\n    out = []\n    step_map = {\n        "RIOT Mismatch":     "Re-run RIOT validation\u003B compare against RFCIQ",\n        "CBN Issue":         "Re-test CBN connectivity from PSAP",\n        "Duplicate CGI":     "Resolve CGI conflict with TMO",\n        "New Layer Failure": "Validate new-layer config via NEST",\n        "GMLC/eSMLC Sync":   "Trigger GMLC/eSMLC re-sync",\n        "Alarms":            "Restore from MOP, retest",\n        "Cell Down":         "Field engineer on-site\u003B replace SFP/RRU",\n    }\n\n    if source == "e911":\n        where, params = apply_filters(\n            "stg_nas_e911_readiness_riot_validation", filt,\n            time_column="nas_e911_validation_date",\n            extra_required=["\\"nas_validate_e911_readiness\\" NOT ILIKE \'Ready%%\'"],\n        )\n        rows = execute_query(f"""\n            SELECT "nas_site_id" AS site_id, "nas_market" AS market, "nas_engineer" AS engineer,\n                   "nas_validate_e911_readiness" AS readiness, "nas_consolidation_check_all_layers" AS consolidation\n            FROM {fq("stg_nas_e911_readiness_riot_validation")} WHERE {where} LIMIT 200\n        """, params)\n        for r in rows:\n            layer = _classify(f"{r.get(\'readiness\',\'\')} {r.get(\'consolidation\',\'\')}", CAUSE_TAXONOMIES["e911_red"])\n            out.append({\n                "entity": r["site_id"],\n                "decision": "remediate",\n                "reason": f"E911 failure layer: {layer}",\n                "evidence": {"owner": r.get("engineer") or "PM", "remediation_step": step_map.get(layer, "Manual review"), "market": r.get("market"), "readiness": r.get("readiness")},\n            })\n\n    elif source == "call_test":\n        where, params = apply_filters(\n            "stg_nas_e2e_call_test_completion", filt,\n            time_column="nas_integration_date",\n            extra_required=["\\"nas_call_test_completion_status\\" ILIKE \'RED\'"],\n        )\n        rows = execute_query(f"""\n            SELECT "nas_site_id" AS site_id, "nas_market" AS market, "nas_go_email_responsibility" AS engineer\n            FROM {fq("stg_nas_e2e_call_test_completion")} WHERE {where} LIMIT 200\n        """, params)\n        for r in rows:\n            out.append({\n                "entity": r["site_id"],\n                "decision": "remediate",\n                "reason": "RED call test — cross-check RIOT and CBN",\n                "evidence": {"owner": r.get("engineer") or "PM", "remediation_step": "RIOT/CBN reconciliation", "market": r.get("market")},\n            })\n\n    elif source == "rf010":\n        where, params = apply_filters(\n            "stg_nas_rf010_dashboard", filt,\n            time_column="task_received_datetime",\n            extra_required=["\\"activity_tracker_state\\" NOT ILIKE \'Completed\'"],\n        )\n        rows = execute_query(f"""\n            SELECT "project_site_id" AS site_id, "market_id" AS market, "activity_tracker_state" AS state\n            FROM {fq("stg_nas_rf010_dashboard")} WHERE {where} LIMIT 200\n        """, params)\n        for r in rows:\n            out.append({\n                "entity": r["site_id"],\n                "decision": "remediate",\n                "reason": f"RF010 task state \'{r.get(\'state\')}\'",\n                "evidence": {"owner": "RF010 PM", "remediation_step": "Re-trigger health check, escalate if blocked", "market": r.get("market")},\n            })\n    return out\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e911_validation', 'e2e_call_test', 'rf010_task', 'engineer', 'layer'], kpi_related_kpi_ids: ['kpi_e911_readiness_index', 'kpi_call_test_red_wip'], kpi_source_tables: ['stg_nas_e911_readiness_riot_validation', 'stg_nas_e2e_call_test_completion', 'stg_nas_rf010_dashboard'], kpi_source_columns: ['nas_validate_e911_readiness', 'nas_call_test_completion_status', 'nas_go_email_responsibility'], kpi_dimensions: ['failure_source', 'market'], kpi_business_logic: '"Per failing entity classify the failure layer (RIOT mismatch, CBN issue, etc.)\u003B assign owner (engineer or PM)\u003B attach remediation_step."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "evaluate_remediation_planner", "node_type": "kpi", "node_id": "kpi_remediation_planner", "node_label": "Remediation Planner", "description": "Open-ended remediation capability. Pass failure_source \\u2208 {e911, call_test, rf010} to focus, or leave default. Returns one row per failing entity with classified failure layer, suggested owner, and prescribed remediation step.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_queue_monitor', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_queue_monitor', label: 'Queue Monitor', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended queue surveillance. Pass queue_kind ∈ {checkin, checkout, rf010, e911} and threshold_pct. Returns markets exceeding the pending-volume threshold with escalation recommendation.', nl_description: 'Open-ended queue surveillance. Pass queue_kind ∈ {checkin, checkout, rf010, e911} and threshold_pct. Returns markets exceeding the pending-volume threshold with escalation recommendation.', nl_business_rule: 'Queue Monitor shows which operational queues have too much pending work and whether they should be escalated or simply watched. It answers questions like which markets are over the backlog threshold for check-in, check-out, RF010, or E911 activity, and where intervention is needed now. Results can be sliced by queue type and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_queue_monitor', kpi_name: 'Queue Monitor', kpi_description: 'Open-ended queue surveillance. Pass queue_kind ∈ {checkin, checkout, rf010, e911} and threshold_pct. Returns markets exceeding the pending-volume threshold with escalation recommendation.', kpi_formula_description: 'Per queue, count pending items and total\u003B emit \'escalate\' if pending_pct ≥ threshold_pct, else \'monitor\'.', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_queue_monitor(execute_query, filters=None):\n    """Universal: for any queue (check-in, check-out, RF010, e911), recommend\n    escalation when pending volume exceeds threshold.\n\n    `filters[\'queue_kind\']` ∈ {\'checkin\',\'checkout\',\'rf010\',\'e911\'}\u003B default \'checkin\'.\n    `filters[\'threshold_pct\']` (default 50) — pending % above which to escalate.\n    """\n    filt = dict(filters or {})\n    kind = filt.pop("queue_kind", "checkin")\n    threshold = float(filt.pop("threshold_pct", 50))\n    out = []\n\n    if kind in ("checkin", "checkout"):\n        where, params = apply_filters("stg_nas_session_level_combined_data", filt, time_column="nas_nest_start_time",\n                                       extra_required=[\'"nas_nest_start_time" IS NOT NULL\'])\n        pending_pred = \'"nas_checkout_approve_time" IS NULL\' if kind == "checkout" else \'"nas_checkout_time" IS NULL\'\n        rows = execute_query(f"""\n            SELECT "nas_market" AS market,\n                   COUNT(*)                              AS total,\n                   COUNT(*) FILTER (WHERE {pending_pred}) AS pending,\n                   ROUND(100.0 * COUNT(*) FILTER (WHERE {pending_pred}) / NULLIF(COUNT(*),0), 2) AS pending_pct\n            FROM {fq("stg_nas_session_level_combined_data")} WHERE {where} GROUP BY 1 ORDER BY pending_pct DESC NULLS LAST\n        """, params)\n    elif kind == "rf010":\n        where, params = apply_filters("stg_nas_rf010_dashboard", filt, time_column="task_received_datetime")\n        rows = execute_query(f"""\n            SELECT "market_id" AS market, COUNT(*) AS total,\n                   COUNT(*) FILTER (WHERE "activity_tracker_state" NOT ILIKE \'Completed\') AS pending,\n                   ROUND(100.0 * COUNT(*) FILTER (WHERE "activity_tracker_state" NOT ILIKE \'Completed\') / NULLIF(COUNT(*),0), 2) AS pending_pct\n            FROM {fq("stg_nas_rf010_dashboard")} {f"WHERE {where}" if where else ""} GROUP BY 1\n        """, params)\n    elif kind == "e911":\n        where, params = apply_filters("stg_nas_e911_readiness_riot_validation", filt, time_column="nas_e911_validation_date")\n        rows = execute_query(f"""\n            SELECT "nas_market" AS market, COUNT(*) AS total,\n                   COUNT(*) FILTER (WHERE "nas_validate_e911_readiness" NOT ILIKE \'Ready%%\') AS pending,\n                   ROUND(100.0 * COUNT(*) FILTER (WHERE "nas_validate_e911_readiness" NOT ILIKE \'Ready%%\') / NULLIF(COUNT(*),0), 2) AS pending_pct\n            FROM {fq("stg_nas_e911_readiness_riot_validation")} {f"WHERE {where}" if where else ""} GROUP BY 1\n        """, params)\n    else:\n        return []\n    for r in rows:\n        pct = r.get("pending_pct") or 0\n        out.append({\n            "entity": r.get("market"),\n            "decision": "escalate" if pct >= threshold else "monitor",\n            "reason": f"{kind} queue pending {pct}% (threshold {threshold}%)",\n            "evidence": {"queue_kind": kind, "total": r.get("total"), "pending": r.get("pending"), "threshold_pct": threshold},\n        })\n    return out\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'rf010_task', 'e911_validation', 'escalation'], kpi_related_kpi_ids: ['kpi_nas_session_count', 'kpi_rf010_completion_rate', 'kpi_e911_readiness_index', 'kpi_pending_queue_size'], kpi_source_tables: ['stg_nas_session_level_combined_data', 'stg_nas_rf010_dashboard', 'stg_nas_e911_readiness_riot_validation'], kpi_source_columns: ['nas_market', 'nas_nest_start_time_requested', 'nas_nest_start_time', 'task_received_datetime', 'task_completed_datetime'], kpi_dimensions: ['queue_kind', 'market'], kpi_business_logic: '"Per queue, count pending items and total\u003B emit \'escalate\' if pending_pct \\u2265 threshold_pct, else \'monitor\'."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "evaluate_queue_monitor", "node_type": "kpi", "node_id": "kpi_queue_monitor", "node_label": "Queue Monitor", "description": "Open-ended queue surveillance. Pass queue_kind \\u2208 {checkin, checkout, rf010, e911} and threshold_pct. Returns markets exceeding the pending-volume threshold with escalation recommendation.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_performance_ranker', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_performance_ranker', label: 'Performance Ranker', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended top-N ranking. Pass metric ∈ {rejection, red_wip, nest_extension, rf010_pending} and n. Returns ranked offenders with evidence — used for \'who is the worst at X?\' style questions.', nl_description: 'Open-ended top-N ranking. Pass metric ∈ {rejection, red_wip, nest_extension, rf010_pending} and n. Returns ranked offenders with evidence — used for \'who is the worst at X?\' style questions.', nl_business_rule: 'Performance Ranker identifies the worst-performing entities for a selected operational issue, such as rejections, red WIP, nest extensions, or pending RF010 work. It answers questions like who is performing worst on a given metric and what evidence supports that ranking. Results can be sliced by the chosen metric and by entity, such as GC, engineer, or market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_performance_ranker', kpi_name: 'Performance Ranker', kpi_description: 'Open-ended top-N ranking. Pass metric ∈ {rejection, red_wip, nest_extension, rf010_pending} and n. Returns ranked offenders with evidence — used for \'who is the worst at X?\' style questions.', kpi_formula_description: 'Sort entities by the chosen metric DESC, take top-N, attach evidence row count.', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_performance_ranker(execute_query, filters=None):\n    """Universal top-N ranking. `filters[\'metric\']` ∈\n    {\'rejection\',\'red_wip\',\'nest_extension\',\'rf010_pending\'}\u003B default \'rejection\'.\n    `filters[\'n\']` (default 10).\n    """\n    filt = dict(filters or {})\n    metric = filt.pop("metric", "rejection")\n    n = int(filt.pop("n", 10))\n    out = []\n\n    if metric == "rejection":\n        rows = get_rejection_rate(execute_query, filt)\n        rows.sort(key=lambda r: -(r.get("rejection_events") or 0))\n        for r in rows[:n]:\n            out.append({"entity": r.get("market"), "decision": "investigate", "reason": f"{r.get(\'rejection_events\')} rejection events", "evidence": r})\n\n    elif metric == "red_wip":\n        rows = get_call_test_red_wip(execute_query, filt)\n        rows.sort(key=lambda r: -(r.get("red_wip_sites") or 0))\n        for r in rows[:n]:\n            out.append({"entity": r.get("engineer") or r.get("market"), "decision": "investigate", "reason": f"{r.get(\'red_wip_sites\')} RED WIP sites", "evidence": r})\n\n    elif metric == "nest_extension":\n        rows = get_nest_extension_rate(execute_query, filt)\n        rows.sort(key=lambda r: -(r.get("extension_sessions") or 0))\n        for r in rows[:n]:\n            out.append({"entity": r.get("vendor"), "decision": "audit", "reason": f"{r.get(\'extension_sessions\')} extensions in {r.get(\'market\')}", "evidence": r})\n\n    elif metric == "rf010_pending":\n        rows = get_rf010_completion_rate(execute_query, filt)\n        rows.sort(key=lambda r: ((r.get("total_tasks") or 0) - (r.get("completed") or 0)), reverse=True)\n        for r in rows[:n]:\n            pending = (r.get("total_tasks") or 0) - (r.get("completed") or 0)\n            out.append({"entity": r.get("market"), "decision": "accelerate", "reason": f"{pending} RF010 tasks pending", "evidence": r})\n    return out\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_log_event', 'e2e_call_test', 'nest_extension', 'rf010_task', 'gc', 'engineer', 'market'], kpi_related_kpi_ids: ['kpi_rejection_rate', 'kpi_call_test_red_wip', 'kpi_nest_extension_rate', 'kpi_rf010_completion_rate'], kpi_source_tables: ['stg_nas_log_data', 'stg_nas_e2e_call_test_completion', 'stg_nas_nest_ext_raw_by_session', 'stg_nas_rf010_dashboard'], kpi_source_columns: ['nas_event_type', 'nas_call_test_completion_status', 'nas_total_ext_count_approved', 'activity_tracker_state'], kpi_dimensions: ['metric', 'entity'], kpi_business_logic: '"Sort entities by the chosen metric DESC, take top-N, attach evidence row count."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "evaluate_performance_ranker", "node_type": "kpi", "node_id": "kpi_performance_ranker", "node_label": "Performance Ranker", "description": "Open-ended top-N ranking. Pass metric \\u2208 {rejection, red_wip, nest_extension, rf010_pending} and n. Returns ranked offenders with evidence \\u2014 used for \'who is the worst at X?\' style questions.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_capacity_planner', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_capacity_planner', label: 'Capacity Planner', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended capacity simulator. Every assumption is a filter override (target_sites, sessions_per_site, engineers, productivity, working_days). Powers any \'how many people/days do we need for X sites?\' question.', nl_description: 'Open-ended capacity simulator. Every assumption is a filter override (target_sites, sessions_per_site, engineers, productivity, working_days). Powers any \'how many people/days do we need for X sites?\' question.', nl_business_rule: 'Capacity Planner is a scenario tool for estimating the people and time needed to deliver work across a target number of sites. It answers planning questions like how many engineers or working days are needed, how many sites can be completed per day, and how changes in reattempts or productivity affect delivery. Results can be compared by assumption set, including site volume, sessions per site, and engineer productivity.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_capacity_planner', kpi_name: 'Capacity Planner', kpi_description: 'Open-ended capacity simulator. Every assumption is a filter override (target_sites, sessions_per_site, engineers, productivity, working_days). Powers any \'how many people/days do we need for X sites?\' question.', kpi_formula_description: 'fte_days_needed = target_sites × sessions_per_site × (1 + reattempt_pct) / engineer_sessions_per_day\u003B daily_sites = engineers × engineer_sessions_per_day / sessions_per_site.', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_capacity_planner(execute_query, filters=None):\n    """Universal capacity simulator. All inputs are filter overrides:\n      target_sites (default 1000), sessions_per_site (2.5), reattempt_pct (10),\n      engineer_sessions_per_day (8), engineers (10), working_days_per_year (250).\n    Output: FTE-days, daily sites, monthly sites, anchor to live observed throughput.\n    """\n    cfg = dict(filters or {})\n    target_sites              = float(cfg.get("target_sites", 1000))\n    sessions_per_site         = float(cfg.get("sessions_per_site", 2.5))\n    reattempt_pct             = float(cfg.get("reattempt_pct", 10))\n    engineer_sessions_per_day = float(cfg.get("engineer_sessions_per_day", 8))\n    engineers                 = float(cfg.get("engineers", 10))\n    working_days_per_year     = float(cfg.get("working_days_per_year", 250))\n\n    total_sessions    = target_sites * sessions_per_site\n    expected_sessions = total_sessions * (1 + reattempt_pct / 100)\n    fte_days          = expected_sessions / engineer_sessions_per_day if engineer_sessions_per_day else 0\n    daily_sessions    = engineer_sessions_per_day * engineers\n    daily_sites       = daily_sessions / sessions_per_site if sessions_per_site else 0\n    monthly_sites     = daily_sites * 20\n\n    current = execute_query(f"""\n        SELECT COUNT(DISTINCT "nas_session_id") AS observed_sessions,\n               COUNT(DISTINCT "nas_site_id")    AS observed_sites\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE "nas_nest_start_time" IS NOT NULL\n    """)\n    obs = current[0] if current else {"observed_sessions": 0, "observed_sites": 0}\n    return [{\n        "entity": "capacity_plan",\n        "decision": "plan",\n        "reason": f"Need {fte_days:.0f} FTE-days to deliver {int(target_sites)} sites",\n        "evidence": {\n            "inputs": {"target_sites": target_sites, "sessions_per_site": sessions_per_site, "reattempt_pct": reattempt_pct, "engineer_sessions_per_day": engineer_sessions_per_day, "engineers": engineers, "working_days_per_year": working_days_per_year},\n            "outputs": {"total_sessions": total_sessions, "expected_sessions_with_reattempt": round(expected_sessions, 1), "fte_days_needed": round(fte_days, 1), "daily_sites": round(daily_sites, 1), "monthly_sites": round(monthly_sites, 0)},\n            "live_anchor": {"observed_sessions": obs["observed_sessions"], "observed_sites": obs["observed_sites"]},\n        },\n    }]\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'site', 'engineer'], kpi_related_kpi_ids: ['kpi_nas_session_count', 'kpi_nas_assignment_count'], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_site_id', 'nas_session_id'], kpi_dimensions: ['assumption_set'], kpi_business_logic: '"fte_days_needed = target_sites \\u00d7 sessions_per_site \\u00d7 (1 + reattempt_pct) / engineer_sessions_per_day\u003B daily_sites = engineers \\u00d7 engineer_sessions_per_day / sessions_per_site."', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "evaluate_capacity_planner", "node_type": "kpi", "node_id": "kpi_capacity_planner", "node_label": "Capacity Planner", "description": "Open-ended capacity simulator. Every assumption is a filter override (target_sites, sessions_per_site, engineers, productivity, working_days). Powers any \'how many people/days do we need for X sites?\' question.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_scenario_modeler', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_scenario_modeler', label: 'Scenario Modeler', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended what-if simulator over staffing/throughput. Inputs (staff_pct, weeks, sla_impact_factor) handle holiday plans, attrition, surges, weekend-only operation, etc.', nl_description: 'Open-ended what-if simulator over staffing/throughput. Inputs (staff_pct, weeks, sla_impact_factor) handle holiday plans, attrition, surges, weekend-only operation, etc.', nl_business_rule: 'Scenario Modeler is a what-if planning tool for testing how staffing changes affect session capacity and service-level risk. It helps answer questions like how holiday plans, attrition, demand surges, or weekend-only operations could change throughput and the likelihood of missing SLA targets. Results can be compared by scenario type and market, with rollups to region.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_scenario_modeler', kpi_name: 'Scenario Modeler', kpi_description: 'Open-ended what-if simulator over staffing/throughput. Inputs (staff_pct, weeks, sla_impact_factor) handle holiday plans, attrition, surges, weekend-only operation, etc.', kpi_formula_description: 'projected_throughput = baseline_sessions_per_week × staff_pct\u003B sla_breach_prob = 1 - (projected_throughput / required_throughput) × sla_impact_factor.', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_scenario_modeler(execute_query, filters=None):\n    """Universal resource-reduction simulator. Inputs (filter overrides):\n      staff_pct (default 50), weeks (default 2), sla_impact_factor (default 0.3).\n    Output: projected weekly throughput drop, SLA breach probability, escalation rec.\n    """\n    cfg = dict(filters or {})\n    weeks    = float(cfg.get("weeks", 2))\n    staff_pct = float(cfg.get("staff_pct", 50))\n    sla_impact_factor = float(cfg.get("sla_impact_factor", 0.3))\n\n    where, params = apply_filters("stg_nas_session_level_combined_data", filters,\n                                   time_column="nas_nest_start_time",\n                                   extra_required=[\'"nas_nest_start_time" IS NOT NULL\'])\n    sql = f"""\n        SELECT "nas_market" AS market,\n               COUNT(DISTINCT "nas_session_id")::numeric\n                   / GREATEST(EXTRACT(EPOCH FROM (MAX("nas_nest_start_time"::timestamp) - MIN("nas_nest_start_time"::timestamp)))/(86400*7), 1) AS sessions_per_week\n        FROM {fq("stg_nas_session_level_combined_data")} WHERE {where}\n        GROUP BY 1 ORDER BY sessions_per_week DESC NULLS LAST LIMIT 50\n    """\n    rows = execute_query(sql, params)\n    out = []\n    factor = staff_pct / 100.0\n    drop_pct = 100 * (1 - factor)\n    for r in rows:\n        full = float(r.get("sessions_per_week") or 0)\n        reduced = full * factor\n        sla_risk = min(100.0, drop_pct * weeks * sla_impact_factor)\n        out.append({\n            "entity": r.get("market"),\n            "decision": "prepare" if sla_risk >= 30 else "monitor",\n            "reason": f"At {staff_pct:.0f}% staffing for {weeks:.0f} wks → throughput drop {drop_pct:.0f}%, SLA breach risk {sla_risk:.0f}%",\n            "evidence": {"baseline_per_week": round(full, 1), "projected_per_week": round(reduced, 1), "throughput_drop_pct": round(drop_pct, 1), "sla_breach_probability_pct": round(sla_risk, 1)},\n        })\n    return out\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'market', 'region'], kpi_related_kpi_ids: ['kpi_nas_session_count', 'kpi_checkout_sla_compliance'], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_market', 'nas_nest_start_time', 'nas_session_id'], kpi_dimensions: ['scenario_kind', 'market'], kpi_business_logic: '"projected_throughput = baseline_sessions_per_week \\u00d7 staff_pct\u003B sla_breach_prob = 1 - (projected_throughput / required_throughput) \\u00d7 sla_impact_factor."', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "evaluate_scenario_modeler", "node_type": "kpi", "node_id": "kpi_scenario_modeler", "node_label": "Scenario Modeler", "description": "Open-ended what-if simulator over staffing/throughput. Inputs (staff_pct, weeks, sla_impact_factor) handle holiday plans, attrition, surges, weekend-only operation, etc.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_backlog_forecaster', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_backlog_forecaster', label: 'Backlog Forecaster', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended burn-down projection. Pass backlog_kind ∈ {rf010, call_test_red, e911_not_ready, checkout_pending}. Returns weeks-to-burndown for any chosen backlog at the current run-rate.', nl_description: 'Open-ended burn-down projection. Pass backlog_kind ∈ {rf010, call_test_red, e911_not_ready, checkout_pending}. Returns weeks-to-burndown for any chosen backlog at the current run-rate.', nl_business_rule: 'Backlog Forecaster estimates how many weeks it will take to clear a selected operational backlog at the current weekly run rate, and flags whether the team is on track or needs to accelerate. It answers questions like when a backlog will burn down and which queues are at risk of taking too long to resolve. It can be sliced by backlog type and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_backlog_forecaster', kpi_name: 'Backlog Forecaster', kpi_description: 'Open-ended burn-down projection. Pass backlog_kind ∈ {rf010, call_test_red, e911_not_ready, checkout_pending}. Returns weeks-to-burndown for any chosen backlog at the current run-rate.', kpi_formula_description: 'weeks_to_burndown = pending_count / weekly_velocity\u003B emit \'accelerate\' if weeks_to_burndown > 8, else \'track\'.', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_backlog_forecaster(execute_query, filters=None):\n    """Universal backlog burn-down. `filters[\'backlog_kind\']` ∈\n    {\'rf010\',\'call_test_red\',\'e911_not_ready\',\'checkout_pending\'}\u003B default \'rf010\'.\n    """\n    filt = dict(filters or {})\n    kind = filt.pop("backlog_kind", "rf010")\n    out = []\n\n    if kind == "rf010":\n        rates = get_rf010_completion_rate(execute_query, filt)\n        for r in rates:\n            total = r.get("total_tasks") or 0\n            done  = r.get("completed") or 0\n            pending = total - done\n            weekly_velocity = max(done / 12, 1)\n            weeks = pending / weekly_velocity if weekly_velocity else None\n            out.append({"entity": r.get("market"), "decision": "accelerate" if (weeks or 0) > 8 else "track",\n                        "reason": f"RF010 backlog burns down in {weeks:.1f} weeks" if weeks is not None else "Insufficient data",\n                        "evidence": {"kind": kind, "total": total, "completed": done, "pending": pending, "weekly_velocity": round(weekly_velocity, 1), "weeks_to_burndown": round(weeks, 1) if weeks else None}})\n    elif kind == "call_test_red":\n        rows = get_call_test_completion_rate(execute_query, filt)\n        for r in rows:\n            red = r.get("red") or 0\n            green = r.get("green") or 0\n            weekly_velocity = max(green / 12, 1)\n            weeks = red / weekly_velocity if weekly_velocity else None\n            out.append({"entity": r.get("market"), "decision": "accelerate" if (weeks or 0) > 8 else "track",\n                        "reason": f"Red WIP burns down in {weeks:.1f} weeks" if weeks else "—",\n                        "evidence": {"kind": kind, "red": red, "weekly_velocity": round(weekly_velocity, 1), "weeks_to_burndown": round(weeks, 1) if weeks else None}})\n    elif kind == "e911_not_ready":\n        rows = get_e911_readiness_index(execute_query, filt)\n        for r in rows:\n            total = r.get("total_sites") or 0\n            ready = r.get("ready_sites") or 0\n            pending = total - ready\n            weekly_velocity = max(ready / 12, 1)\n            weeks = pending / weekly_velocity if weekly_velocity else None\n            out.append({"entity": r.get("market"), "decision": "accelerate" if (weeks or 0) > 8 else "track",\n                        "reason": f"E911 NOT-READY burns down in {weeks:.1f} weeks" if weeks else "—",\n                        "evidence": {"kind": kind, "pending": pending, "weekly_velocity": round(weekly_velocity, 1)}})\n    elif kind == "checkout_pending":\n        rows = get_checkout_sla_compliance(execute_query, filt)\n        for r in rows:\n            total = r.get("total_checkouts") or 0\n            within = r.get("within_sla") or 0\n            pending = total - within\n            weekly_velocity = max(within / 12, 1)\n            weeks = pending / weekly_velocity if weekly_velocity else None\n            out.append({"entity": r.get("market"), "decision": "accelerate" if (weeks or 0) > 8 else "track",\n                        "reason": f"Checkout-SLA breach burns down in {weeks:.1f} weeks" if weeks else "—",\n                        "evidence": {"kind": kind, "pending": pending, "weekly_velocity": round(weekly_velocity, 1)}})\n    return out\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['rf010_task', 'e2e_call_test', 'e911_validation', 'nas_session', 'escalation'], kpi_related_kpi_ids: ['kpi_rf010_completion_rate', 'kpi_call_test_completion_rate', 'kpi_e911_readiness_index', 'kpi_checkout_sla_compliance', 'kpi_pending_queue_size'], kpi_source_tables: ['stg_nas_rf010_dashboard', 'stg_nas_e2e_call_test_completion', 'stg_nas_e911_readiness_riot_validation', 'stg_nas_session_level_combined_data'], kpi_source_columns: ['task_received_datetime', 'task_completed_datetime', 'nas_call_test_completion_status', 'nas_validate_e911_readiness'], kpi_dimensions: ['backlog_kind', 'market'], kpi_business_logic: '"weeks_to_burndown = pending_count / weekly_velocity\u003B emit \'accelerate\' if weeks_to_burndown > 8, else \'track\'."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "evaluate_backlog_forecaster", "node_type": "kpi", "node_id": "kpi_backlog_forecaster", "node_label": "Backlog Forecaster", "description": "Open-ended burn-down projection. Pass backlog_kind \\u2208 {rf010, call_test_red, e911_not_ready, checkout_pending}. Returns weeks-to-burndown for any chosen backlog at the current run-rate.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_site_state_inspector', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_site_state_inspector', label: 'Site State Inspector', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended site-state lookup. Filter by site_id or market and get current workflow stage (assigned / checked-in / checkout-pending / approved). Powers \'where is site X right now?\' type questions.', nl_description: 'Open-ended site-state lookup. Filter by site_id or market and get current workflow stage (assigned / checked-in / checkout-pending / approved). Powers \'where is site X right now?\' type questions.', nl_business_rule: 'Site State Inspector shows the current workflow status of each site in the field process. It answers questions like where a specific site is right now, or which sites are assigned, checked in, pending checkout, or approved. Results can be viewed by site and by current stage, and filtered for a market-level view.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_site_state_inspector', kpi_name: 'Site State Inspector', kpi_description: 'Open-ended site-state lookup. Filter by site_id or market and get current workflow stage (assigned / checked-in / checkout-pending / approved). Powers \'where is site X right now?\' type questions.', kpi_formula_description: 'Per site, look up the latest workflow milestone (nest_start, checkout_request, checkout_approve, rf010_done) and classify the current stage.', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_site_state_inspector(execute_query, filters=None):\n    """Universal site/session workflow-progression diagnoser.\n\n    Given filters (site_id or market scope), returns each site with its current\n    workflow stage derived from the presence/absence of phase milestones.\n    """\n    filt = dict(filters or {})\n    where, params = apply_filters("stg_nas_session_level_combined_data", filt,\n                                   time_column="nas_nest_start_time")\n    sites = execute_query(f"""\n        SELECT "nas_site_id" AS site_id, "nas_market" AS market, "nas_project_category" AS project_category,\n               MAX("nas_nest_start_time"::timestamp)         AS last_nest_start,\n               MAX("nas_checkout_time"::timestamp)            AS last_checkout,\n               MAX("nas_checkout_approve_time"::timestamp)    AS last_checkout_approve\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2, 3\n        LIMIT 500\n    """, params)\n    out = []\n    for s in sites:\n        if s.get("last_checkout_approve") is not None:\n            stage = "Phase 11+ (checkout approved)"\n            decision = "track"\n        elif s.get("last_checkout") is not None:\n            stage = "Phase 8 (checkout pending approval)"\n            decision = "monitor"\n        elif s.get("last_nest_start") is not None:\n            stage = "Phase 8 (checked-in, NEST window)"\n            decision = "monitor"\n        else:\n            stage = "Phase 1 (assigned, not started)"\n            decision = "monitor"\n        out.append({\n            "entity": s["site_id"],\n            "decision": decision,\n            "reason": f"Current stage: {stage}",\n            "evidence": {"market": s.get("market"), "project_category": s.get("project_category"),\n                         "last_nest_start": str(s.get("last_nest_start", "")), "last_checkout": str(s.get("last_checkout", "")), "last_checkout_approve": str(s.get("last_checkout_approve", ""))},\n        })\n    return out\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['site', 'nas_session', 'rf010_task'], kpi_related_kpi_ids: ['kpi_nas_session_count'], kpi_source_tables: ['stg_nas_session_level_combined_data', 'stg_nas_rf010_dashboard'], kpi_source_columns: ['nas_site_id', 'nas_nest_start_time', 'nas_checkout_time', 'nas_checkout_approve_time', 'task_completed_datetime'], kpi_dimensions: ['site', 'stage'], kpi_business_logic: '"Per site, look up the latest workflow milestone (nest_start, checkout_request, checkout_approve, rf010_done) and classify the current stage."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "evaluate_site_state_inspector", "node_type": "kpi", "node_id": "kpi_site_state_inspector", "node_label": "Site State Inspector", "description": "Open-ended site-state lookup. Filter by site_id or market and get current workflow stage (assigned / checked-in / checkout-pending / approved). Powers \'where is site X right now?\' type questions.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_funnel_analyzer', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_funnel_analyzer', label: 'Funnel Analyzer', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended pipeline funnel analysis. Returns per-market funnel (assigned → checkin → checkout → approval → on-air) with drop-off % at every stage — the universal tool for conversion / bottleneck questions.', nl_description: 'Open-ended pipeline funnel analysis. Returns per-market funnel (assigned → checkin → checkout → approval → on-air) with drop-off % at every stage — the universal tool for conversion / bottleneck questions.', nl_business_rule: 'Funnel Analyzer shows how work moves through the operational pipeline from assignment to check-in, check-out, approval, and finally on-air. It answers where conversion is strongest or weakest, and where the biggest drop-offs or bottlenecks occur in the process. Results are most useful when compared by market and by funnel stage.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_funnel_analyzer', kpi_name: 'Funnel Analyzer', kpi_description: 'Open-ended pipeline funnel analysis. Returns per-market funnel (assigned → checkin → checkout → approval → on-air) with drop-off % at every stage — the universal tool for conversion / bottleneck questions.', kpi_formula_description: 'Per market compute COUNT at each stage (assigned, checked-in, checked-out, approved, on-air)\u003B compute stage-to-stage conversion %.', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_funnel_analyzer(execute_query, filters=None):\n    """Universal pipeline funnel: assignment → check-in → checkout → integration → on-air.\n    Returns one row per market with stage counts + drop-off percentages.\n    """\n    filt = dict(filters or {})\n    # Stage 1: assigned sites\n    sites_where, sites_params = apply_filters("stg_nas_session_level_combined_data", filt)\n    stages = execute_query(f"""\n        SELECT\n            "nas_market" AS market,\n            COUNT(DISTINCT "nas_site_id") AS assigned_sites,\n            COUNT(DISTINCT "nas_site_id") FILTER (WHERE "nas_nest_start_time" IS NOT NULL) AS checked_in_sites,\n            COUNT(DISTINCT "nas_site_id") FILTER (WHERE "nas_checkout_time" IS NOT NULL) AS checked_out_sites,\n            COUNT(DISTINCT "nas_site_id") FILTER (WHERE "nas_checkout_approve_time" IS NOT NULL) AS approved_sites\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {sites_where}" if sites_where else ""}\n        GROUP BY 1\n        ORDER BY assigned_sites DESC NULLS LAST\n        LIMIT 50\n    """, sites_params)\n    # Stage 5: on-air sites by market from rf010\n    rf_where, rf_params = apply_filters("stg_nas_rf010_dashboard", filt)\n    on_air = execute_query(f"""\n        SELECT "market_id" AS market,\n               COUNT(*) FILTER (WHERE "mb_status" ILIKE \'Done\') AS on_air_sites\n        FROM {fq("stg_nas_rf010_dashboard")}\n        {f"WHERE {rf_where}" if rf_where else ""}\n        GROUP BY 1\n    """, rf_params)\n    on_air_lookup = {r["market"]: r["on_air_sites"] for r in on_air}\n    out = []\n    for s in stages:\n        a = s.get("assigned_sites") or 0\n        ci = s.get("checked_in_sites") or 0\n        co = s.get("checked_out_sites") or 0\n        ap = s.get("approved_sites") or 0\n        oa = on_air_lookup.get(s.get("market"), 0)\n        out.append({\n            "entity": s.get("market"),\n            "decision": "monitor" if a >= 5 else "ignore",\n            "reason": f"Funnel: {a} assigned → {ci} checked-in → {co} checked-out → {ap} approved → {oa} on-air",\n            "evidence": {\n                "assigned_sites": a, "checked_in_sites": ci, "checked_out_sites": co,\n                "approved_sites": ap, "on_air_sites": oa,\n                "drop_off_pct": {\n                    "assigned_to_checkin": round(100 * (a - ci) / a, 2) if a else 0,\n                    "checkin_to_checkout": round(100 * (ci - co) / ci, 2) if ci else 0,\n                    "checkout_to_approval": round(100 * (co - ap) / co, 2) if co else 0,\n                    "approval_to_on_air":  round(100 * (ap - oa) / ap, 2) if ap else 0,\n                }\n            }\n        })\n    return out\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['site', 'nas_session', 'rf010_task', 'market', 'region'], kpi_related_kpi_ids: ['kpi_nas_assignment_count', 'kpi_nas_session_count', 'kpi_rf010_completion_rate'], kpi_source_tables: ['stg_nas_session_level_combined_data', 'stg_nas_rf010_dashboard'], kpi_source_columns: ['nas_site_id', 'nas_nest_start_time', 'nas_checkout_approve_time', 'mb_status'], kpi_dimensions: ['market', 'stage'], kpi_business_logic: '"Per market compute COUNT at each stage (assigned, checked-in, checked-out, approved, on-air)\u003B compute stage-to-stage conversion %."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "evaluate_funnel_analyzer", "node_type": "kpi", "node_id": "kpi_funnel_analyzer", "node_label": "Funnel Analyzer", "description": "Open-ended pipeline funnel analysis. Returns per-market funnel (assigned \\u2192 checkin \\u2192 checkout \\u2192 approval \\u2192 on-air) with drop-off % at every stage \\u2014 the universal tool for conversion / bottleneck questions.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_dashboard_checkin_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_dashboard_checkin_count', label: 'NAS Check-in Count (daily dashboard)', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'COUNT(*) of dashboard rows whose checkin_latest_start_time IS NOT NULL, grouped by region/market/project_category. Catalog KPI #4.', nl_description: 'COUNT(*) of dashboard rows whose checkin_latest_start_time IS NOT NULL, grouped by region/market/project_category. Catalog KPI #4.', nl_business_rule: 'This metric tracks how many NAS check-ins were recorded during the Site Assignment phase on the daily dashboard. It helps answer questions about check-in volume and where activity is happening across the business. You can break it down by region, market, and project category.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_dashboard_checkin_count', kpi_name: 'NAS Check-in Count (daily dashboard)', kpi_description: 'COUNT(*) of dashboard rows whose checkin_latest_start_time IS NOT NULL, grouped by region/market/project_category. Catalog KPI #4.', kpi_formula_description: 'COUNT(*) WHERE checkin_latest_start_time IS NOT NULL GROUP BY region, market, project_category', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_dashboard_checkin_count(execute_query, filters=None):\n    """Catalog KPI #4 — NAS Check-in count from stg_tmo_nas_daily_dashboard."""\n    where, params = apply_filters(\n        "stg_tmo_nas_daily_dashboard", filters,\n        time_column="checkin_latest_start_time",\n        extra_required=[\'"checkin_latest_start_time" IS NOT NULL\'],\n    )\n    sql = f"""\n        SELECT\n            "region" AS region,\n            "market" AS market,\n            "project_category" AS project_category,\n            COUNT(*) AS checkin_count\n        FROM {fq("stg_tmo_nas_daily_dashboard")}\n        WHERE {where}\n        GROUP BY 1, 2, 3\n        ORDER BY checkin_count DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['daily_dashboard', 'market', 'region'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_tmo_nas_daily_dashboard'], kpi_source_columns: ['region', 'market', 'project_category', 'checkin_latest_start_time'], kpi_dimensions: ['region', 'market', 'project_category'], kpi_business_logic: '"COUNT(*) WHERE checkin_latest_start_time IS NOT NULL GROUP BY region, market, project_category"', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_dashboard_checkin_count", "node_type": "kpi", "node_id": "kpi_dashboard_checkin_count", "node_label": "NAS Check-in Count (daily dashboard)", "description": "COUNT(*) of dashboard rows whose checkin_latest_start_time IS NOT NULL, grouped by region/market/project_category. Catalog KPI #4.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_dashboard_checkout_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_dashboard_checkout_count', label: 'NAS Check-out Count (daily dashboard)', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'COUNT(*) of dashboard rows whose checkout_os IS NOT NULL, grouped by region/market/project_category. Catalog KPI #6.', nl_description: 'COUNT(*) of dashboard rows whose checkout_os IS NOT NULL, grouped by region/market/project_category. Catalog KPI #6.', nl_business_rule: 'This metric tracks how many NAS check-outs were recorded during the Site Assignment phase on the daily dashboard. It helps answer where check-outs are happening and how activity is trending across the business. You can break it down by region, market, and project category.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_dashboard_checkout_count', kpi_name: 'NAS Check-out Count (daily dashboard)', kpi_description: 'COUNT(*) of dashboard rows whose checkout_os IS NOT NULL, grouped by region/market/project_category. Catalog KPI #6.', kpi_formula_description: 'COUNT(*) WHERE checkout_os IS NOT NULL GROUP BY region, market, project_category', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_dashboard_checkout_count(execute_query, filters=None):\n    """Catalog KPI #6 — NAS Check-out count from stg_tmo_nas_daily_dashboard."""\n    where, params = apply_filters(\n        "stg_tmo_nas_daily_dashboard", filters,\n        time_column="checkout_os",\n        extra_required=[\'"checkout_os" IS NOT NULL\'],\n    )\n    sql = f"""\n        SELECT\n            "region" AS region,\n            "market" AS market,\n            "project_category" AS project_category,\n            COUNT(*) AS checkout_count\n        FROM {fq("stg_tmo_nas_daily_dashboard")}\n        WHERE {where}\n        GROUP BY 1, 2, 3\n        ORDER BY checkout_count DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['daily_dashboard', 'market', 'region'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_tmo_nas_daily_dashboard'], kpi_source_columns: ['region', 'market', 'project_category', 'checkout_os'], kpi_dimensions: ['region', 'market', 'project_category'], kpi_business_logic: '"COUNT(*) WHERE checkout_os IS NOT NULL GROUP BY region, market, project_category"', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_dashboard_checkout_count", "node_type": "kpi", "node_id": "kpi_dashboard_checkout_count", "node_label": "NAS Check-out Count (daily dashboard)", "description": "COUNT(*) of dashboard rows whose checkout_os IS NOT NULL, grouped by region/market/project_category. Catalog KPI #6.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_dashboard_ftr_checkout_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_dashboard_ftr_checkout_rate', label: 'First-Time-Right Checkout Rate (daily dashboard)', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Percentage of dashboard sessions whose (checkout_os − checkin_latest_start_time) ≤ 1440 minutes (24h). Catalog KPI #29.', nl_description: 'Percentage of dashboard sessions whose (checkout_os − checkin_latest_start_time) ≤ 1440 minutes (24h). Catalog KPI #29.', nl_business_rule: 'First-Time-Right Checkout Rate measures the share of dashboard sessions that complete checkout within 24 hours of the latest check-in start. It helps answer how often the check-in/check-out process is completed on time and where operational delays may be affecting performance. It can be analyzed by region, market, and project category.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_dashboard_ftr_checkout_rate', kpi_name: 'First-Time-Right Checkout Rate (daily dashboard)', kpi_description: 'Percentage of dashboard sessions whose (checkout_os − checkin_latest_start_time) ≤ 1440 minutes (24h). Catalog KPI #29.', kpi_formula_description: '100 * COUNT(*) FILTER (delta_minutes <= 1440) / COUNT(*) GROUP BY region, market, project_category', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_dashboard_ftr_checkout_rate(execute_query, filters=None):\n    """Catalog KPI #29 — First-Time-Right Checkout Rate from daily dashboard.\n\n    Formula:\n        100 * COUNT(*) FILTER (\n            WHERE (checkout_os - checkin_latest_start_time) in minutes <= 1440\n        ) / COUNT(*)\n    Grouped by region × market × project_category.\n    """\n    where, params = apply_filters(\n        "stg_tmo_nas_daily_dashboard", filters,\n        time_column="checkout_os",\n        extra_required=[\n            \'"checkin_latest_start_time" IS NOT NULL\',\n            \'"checkout_os" IS NOT NULL\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            "region" AS region,\n            "market" AS market,\n            "project_category" AS project_category,\n            COUNT(*) AS total_checkouts,\n            COUNT(*) FILTER (\n                WHERE (EXTRACT(EPOCH FROM (\n                          "checkout_os"::timestamp - "checkin_latest_start_time"::timestamp\n                      )) / 60.0) <= 1440\n            ) AS ftr_checkouts,\n            ROUND(\n                100.0 * COUNT(*) FILTER (\n                    WHERE (EXTRACT(EPOCH FROM (\n                              "checkout_os"::timestamp - "checkin_latest_start_time"::timestamp\n                          )) / 60.0) <= 1440\n                ) / NULLIF(COUNT(*), 0),\n                2\n            ) AS ftr_checkout_rate_pct\n        FROM {fq("stg_tmo_nas_daily_dashboard")}\n        WHERE {where}\n        GROUP BY 1, 2, 3\n        ORDER BY ftr_checkout_rate_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['daily_dashboard'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_tmo_nas_daily_dashboard'], kpi_source_columns: ['region', 'market', 'project_category', 'checkin_latest_start_time', 'checkout_os'], kpi_dimensions: ['region', 'market', 'project_category'], kpi_business_logic: '"100 * COUNT(*) FILTER (delta_minutes <= 1440) / COUNT(*) GROUP BY region, market, project_category"', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_dashboard_ftr_checkout_rate", "node_type": "kpi", "node_id": "kpi_dashboard_ftr_checkout_rate", "node_label": "First-Time-Right Checkout Rate (daily dashboard)", "description": "Percentage of dashboard sessions whose (checkout_os \\u2212 checkin_latest_start_time) \\u2264 1440 minutes (24h). Catalog KPI #29.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_session_activity_duration_and_nest_approving_sla', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_session_activity_duration_and_nest_approving_sla', label: 'NAS Session Activity Duration, Nest Hours and Max NEST Approving SLA', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Per market: AVG / MIN / MAX / p50 / p95 of nas_total_activity_duration (minutes)\u003B AVG of nas_nest_time_requested_hrs\u003B MAX of nas_sla_sla_nest (NEST approval SLA minutes). Answers questions about session duration, requested nest hours and maximum nest approval time.', nl_description: 'Per market: AVG / MIN / MAX / p50 / p95 of nas_total_activity_duration (minutes)\u003B AVG of nas_nest_time_requested_hrs\u003B MAX of nas_sla_sla_nest (NEST approval SLA minutes). Answers questions about session duration, requested nest hours and maximum nest approval time.', nl_business_rule: 'This metric tracks NAS session activity duration, requested NEST hours, and the longest NEST approval SLA for each market. It helps answer how long sessions typically take, how much NEST time is being requested, and where approval times are highest. It can be analyzed by market, with views such as average, minimum, maximum, median, and 95th percentile for session duration.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_session_activity_duration_and_nest_approving_sla', kpi_name: 'NAS Session Activity Duration, Nest Hours and Max NEST Approving SLA', kpi_description: 'Per market: AVG / MIN / MAX / p50 / p95 of nas_total_activity_duration (minutes)\u003B AVG of nas_nest_time_requested_hrs\u003B MAX of nas_sla_sla_nest (NEST approval SLA minutes). Answers questions about session duration, requested nest hours and maximum nest approval time.', kpi_formula_description: 'AVG/MIN/MAX/PCT(0.5)/PCT(0.95) of nas_total_activity_duration\u003B AVG of nas_nest_time_requested_hrs\u003B MAX of nas_sla_sla_nest', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_session_activity_duration(execute_query, filters=None):\n    """KPI — NAS Session Activity Duration aggregates per market.\n\n    Returns per market:\n      - total_sessions\n      - avg / min / max / p50 / p95 of nas_total_activity_duration (minutes)\n      - avg_requested_nest_hours (from nas_nest_time_requested_hrs)\n      - max_nest_approval_sla_minutes (from nas_sla_sla_nest) — answers\n        "max time taken for Approving the site for NEStin" style questions.\n    """\n    where, params = apply_filters("stg_nas_session_level_combined_data", filters)\n    sql = f"""\n        SELECT\n            "nas_market" AS market,\n            COUNT(*) AS total_sessions,\n            ROUND(AVG(EXTRACT(EPOCH FROM "nas_total_activity_duration"::interval)/60.0)::numeric, 2) AS avg_activity_minutes,\n            ROUND(MIN(EXTRACT(EPOCH FROM "nas_total_activity_duration"::interval)/60.0)::numeric, 2) AS min_activity_minutes,\n            ROUND(MAX(EXTRACT(EPOCH FROM "nas_total_activity_duration"::interval)/60.0)::numeric, 2) AS max_activity_minutes,\n            ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (\n                ORDER BY EXTRACT(EPOCH FROM "nas_total_activity_duration"::interval)/60.0\n            ))::numeric, 2) AS p50_activity_minutes,\n            ROUND((PERCENTILE_CONT(0.95) WITHIN GROUP (\n                ORDER BY EXTRACT(EPOCH FROM "nas_total_activity_duration"::interval)/60.0\n            ))::numeric, 2) AS p95_activity_minutes,\n            ROUND(AVG(CASE\n                WHEN "nas_nest_time_requested_hrs" ~ \'^[0-9]+(\\\\.[0-9]+)?$\'\n                THEN "nas_nest_time_requested_hrs"::numeric ELSE NULL\n            END)::numeric, 2) AS avg_requested_nest_hours,\n            ROUND(MAX(CASE\n                WHEN "nas_sla_sla_nest" ~ \'^[0-9]+(\\\\.[0-9]+)?$\'\n                THEN "nas_sla_sla_nest"::numeric ELSE NULL\n            END)::numeric, 2) AS max_nest_approval_sla_minutes\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE "nas_total_activity_duration" IS NOT NULL\n              {f"AND {where}" if where else ""}\n        GROUP BY 1\n        ORDER BY avg_activity_minutes DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'market'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_market', 'nas_total_activity_duration', 'nas_nest_time_requested_hrs', 'nas_sla_sla_nest'], kpi_dimensions: ['market'], kpi_business_logic: '"AVG/MIN/MAX/PCT(0.5)/PCT(0.95) of nas_total_activity_duration\u003B AVG of nas_nest_time_requested_hrs\u003B MAX of nas_sla_sla_nest"', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_session_activity_duration", "node_type": "kpi", "node_id": "kpi_session_activity_duration_and_nest_approving_sla", "node_label": "NAS Session Activity Duration, Nest Hours and Max NEST Approving SLA", "description": "Per market: AVG / MIN / MAX / p50 / p95 of nas_total_activity_duration (minutes)\u003B AVG of nas_nest_time_requested_hrs\u003B MAX of nas_sla_sla_nest (NEST approval SLA minutes). Answers questions about session duration, requested nest hours and maximum nest approval time.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_rejection_reason_breakdown', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_rejection_reason_breakdown', label: 'Check-in / Check-out Rejection Reasons (top recurring)', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Aggregates rejection counts by the FREE-TEXT reason text from stg_nas_rejection_data_last_30_days. Answers \'why are check-ins/check-outs being rejected\', \'top recurring rejection reasons\', \'what is the rejection reason mix\'. UNION of two queries — one over `nas_rej_checkin_reject_reason`, one over `nas_rej_checkout_reject_reason` — discriminated by a `direction` column (\'check_in\' | \'check_out\').', nl_description: 'Aggregates rejection counts by the FREE-TEXT reason text from stg_nas_rejection_data_last_30_days. Answers \'why are check-ins/check-outs being rejected\', \'top recurring rejection reasons\', \'what is the rejection reason mix\'. UNION of two queries — one over `nas_rej_checkin_reject_reason`, one over `nas_rej_checkout_reject_reason` — discriminated by a `direction` column (\'check_in\' | \'check_out\').', nl_business_rule: 'This metric shows the most common reasons check-ins and check-outs are being rejected, based on recent rejection events. It helps answer why rejections are happening, which issues recur most often, and how the rejection mix differs between check-in and check-out activity. You can break it down by check-in vs. check-out, region, and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_rejection_reason_breakdown', kpi_name: 'Check-in / Check-out Rejection Reasons (top recurring)', kpi_description: 'Aggregates rejection counts by the FREE-TEXT reason text from stg_nas_rejection_data_last_30_days. Answers \'why are check-ins/check-outs being rejected\', \'top recurring rejection reasons\', \'what is the rejection reason mix\'. UNION of two queries — one over `nas_rej_checkin_reject_reason`, one over `nas_rej_checkout_reject_reason` — discriminated by a `direction` column (\'check_in\' | \'check_out\').', kpi_formula_description: 'COUNT(*) GROUP BY direction, region, market, reason ORDER BY occurrences DESC LIMIT 100', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_rejection_reason_breakdown(execute_query, filters=None):\n    """KPI — rejection reason breakdown (check-in + check-out), top 25 each.\n\n    Aggregates the free-text reject-reason columns from\n    `stg_nas_rejection_data_last_30_days`:\n      • nas_rej_checkin_reject_reason   (e.g. \'Invalid Check-in\', \'Other\')\n      • nas_rej_checkout_reject_reason  (e.g. \'RTWP\', \'Alarm\', \'RET\')\n\n    Returns one unified table: {direction, region, market, reason, occurrences}\n    where `direction` is \'check_in\' or \'check_out\'. Use this for the family of\n    questions "why are check-ins / check-outs being rejected" / "top recurring\n    rejection reasons".\n    """\n    # nas_rej_requesttime is 100% NULL in production — date filters anchor on\n    # nas_rej_rejection_time, which is ~75% populated and is the actual event\n    # timestamp.\n    where, params = apply_filters(\n        "stg_nas_rejection_data_last_30_days", filters,\n        time_column="nas_rej_rejection_time",\n    )\n    sql = f"""\n        SELECT \'check_in\' AS direction,\n               "nas_rej_region" AS region,\n               "nas_rej_market" AS market,\n               "nas_rej_checkin_reject_reason" AS reason,\n               COUNT(*) AS occurrences\n        FROM {fq("stg_nas_rejection_data_last_30_days")}\n        WHERE "nas_rej_checkin_reject_reason" IS NOT NULL\n              {f"AND {where}" if where else ""}\n        GROUP BY 1, 2, 3, 4\n        UNION ALL\n        SELECT \'check_out\' AS direction,\n               "nas_rej_region" AS region,\n               "nas_rej_market" AS market,\n               "nas_rej_checkout_reject_reason" AS reason,\n               COUNT(*) AS occurrences\n        FROM {fq("stg_nas_rejection_data_last_30_days")}\n        WHERE "nas_rej_checkout_reject_reason" IS NOT NULL\n              {f"AND {where}" if where else ""}\n        GROUP BY 1, 2, 3, 4\n        ORDER BY occurrences DESC NULLS LAST\n        LIMIT 100\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['rejection_event'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_rejection_data_last_30_days'], kpi_source_columns: ['nas_rej_region', 'nas_rej_market', 'nas_rej_checkin_reject_reason', 'nas_rej_checkout_reject_reason', 'nas_rej_requesttime'], kpi_dimensions: ['direction', 'region', 'market', 'reason'], kpi_business_logic: '"COUNT(*) GROUP BY direction, region, market, reason ORDER BY occurrences DESC LIMIT 100"', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_rejection_reason_breakdown", "node_type": "kpi", "node_id": "kpi_rejection_reason_breakdown", "node_label": "Check-in / Check-out Rejection Reasons (top recurring)", "description": "Aggregates rejection counts by the FREE-TEXT reason text from stg_nas_rejection_data_last_30_days. Answers \'why are check-ins/check-outs being rejected\', \'top recurring rejection reasons\', \'what is the rejection reason mix\'. UNION of two queries \\u2014 one over `nas_rej_checkin_reject_reason`, one over `nas_rej_checkout_reject_reason` \\u2014 discriminated by a `direction` column (\'check_in\' | \'check_out\').", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});

