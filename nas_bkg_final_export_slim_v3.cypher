CREATE (:BKGNode {node_id: 'kpi_nas_assignment_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_nas_assignment_count', label: 'NAS Assignment Count', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Distinct sites assigned to NAS, grouped by derived region × market × project category.', nl_description: 'Distinct sites assigned to NAS, grouped by derived region × market × project category.', nl_business_rule: 'NAS Assignment Count measures how many unique sites have been assigned to NAS during the site assignment stage. It helps answer questions about the scale of NAS coverage and where assignments are concentrated across the business. You can break it down by region, market, and project category.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_nas_assignment_count', kpi_name: 'NAS Assignment Count', kpi_description: 'Distinct sites assigned to NAS, grouped by derived region × market × project category.', kpi_formula_description: 'COUNT(DISTINCT nas_site_id) FROM stg_nas_session_level_combined_data, region derived from nas_market via canonical mapping', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\nDERIVED_REGION_SQL = \'\\nCASE\\n  WHEN LOWER("nas_market") IN (\\\'seattle\\\',\\\'phoenix\\\',\\\'spokane\\\',\\\'montana\\\',\\\'portland\\\') THEN \\\'West\\\'\\n  WHEN LOWER("nas_market") IN (\\\'atlanta\\\',\\\'austin\\\',\\\'dallas\\\',\\\'bhm-mem\\\',\\\'mobile\\\',\\\'puertorico\\\',\\\'houston\\\') THEN \\\'South\\\'\\n  WHEN LOWER("nas_market") IN (\\\'chicago\\\',\\\'milwaukee\\\',\\\'detroit\\\',\\\'minneapolis\\\',\\\'denver\\\',\\\'dakotas\\\',\\\'omaha\\\',\\\'des moines\\\',\\\'oklahoma\\\',\\\'kansascity\\\',\\\'arkansas\\\',\\\'indianapolis\\\',\\\'wichita\\\',\\\'tulsa\\\',\\\'stlouis\\\',\\\'columbus\\\',\\\'cleveland\\\',\\\'nashville\\\',\\\'louisville\\\',\\\'knoxville\\\',\\\'westvirginia\\\',\\\'cincinnati\\\',\\\'pittsburgh\\\') THEN \\\'Central\\\'\\n  ELSE NULL\\nEND\\n\'\n# ─────────── end inlined prelude ───────────\n\ndef get_nas_assignment_count(execute_query, filters=None):\n    """KPI 1 — Project Assignment to NAS: distinct sites assigned, by derived region × market × project category."""\n    where, params = apply_filters("stg_nas_session_level_combined_data", filters)\n    sql = f"""\n        SELECT\n            {DERIVED_REGION_SQL} AS region,\n            "nas_market" AS market,\n            "nas_project_category" AS project_category,\n            COUNT(DISTINCT "nas_site_id") AS site_count\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2, 3\n        ORDER BY site_count DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['site', 'nas_session', 'project'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_site_id', 'nas_market', 'nas_project_category'], kpi_dimensions: ['region', 'market', 'project_category'], kpi_business_logic: '"COUNT(DISTINCT nas_site_id) FROM stg_nas_session_level_combined_data, region derived from nas_market via canonical mapping"', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_nas_assignment_count", "node_type": "kpi", "node_id": "kpi_nas_assignment_count", "node_label": "NAS Assignment Count", "description": "Distinct sites assigned to NAS, grouped by derived region \\u00d7 market \\u00d7 project category.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_nas_session_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_nas_session_count', label: 'NAS Session Count by Market, Activity Type and Site', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Distinct NAS sessions where check-in (nas_nest_start_time) has occurred, grouped by market × project_category × activity_type × site_id so that downstream questions about sessions per site or per activity_type are answerable from a single KPI.', nl_description: 'Distinct NAS sessions where check-in (nas_nest_start_time) has occurred, grouped by market × project_category × activity_type × site_id so that downstream questions about sessions per site or per activity_type are answerable from a single KPI.', nl_business_rule: 'This metric counts NAS sessions that have actually started, giving a view of session volume across the business. It helps answer questions like which markets, sites, or activity types are handling the most sessions and how session mix varies by work type. You can break it down by market, activity type, and site, with project category as an additional slice.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_nas_session_count', kpi_name: 'NAS Session Count by Market, Activity Type and Site', kpi_description: 'Distinct NAS sessions where check-in (nas_nest_start_time) has occurred, grouped by market × project_category × activity_type × site_id so that downstream questions about sessions per site or per activity_type are answerable from a single KPI.', kpi_formula_description: 'COUNT(DISTINCT nas_session_id) WHERE nas_nest_start_time IS NOT NULL GROUP BY market, project_category, nas_activity_type, nas_site_id', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_nas_session_count(execute_query, filters=None):\n    """KPI 2 — total distinct NAS sessions where check-in has occurred.\n\n    Returned at (market × project_category × activity_type) grain so that\n    questions asking for "sessions by activity type" or "sessions by site\n    × activity type" are answerable directly. The activity-type column is\n    nas_activity_type (the canonical NAS activity bucket)\u003B site-level\n    questions get the same aggregate via the nas_site_id column.\n    """\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_nest_start_time",\n        extra_required=[\'"nas_nest_start_time" IS NOT NULL\'],\n    )\n    sql = f"""\n        SELECT\n            "nas_market" AS market,\n            "nas_project_category" AS project_category,\n            "nas_activity_type" AS activity_type,\n            "nas_site_id" AS site_id,\n            COUNT(DISTINCT "nas_session_id") AS session_count\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE {where}\n        GROUP BY 1, 2, 3, 4\n        ORDER BY session_count DESC\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'site'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_session_id', 'nas_nest_start_time', 'nas_market', 'nas_project_category', 'nas_activity_type', 'nas_site_id'], kpi_dimensions: ['market', 'project_category', 'activity_type', 'site_id'], kpi_business_logic: '"COUNT(DISTINCT nas_session_id) WHERE nas_nest_start_time IS NOT NULL GROUP BY market, project_category, nas_activity_type, nas_site_id"', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_nas_session_count", "node_type": "kpi", "node_id": "kpi_nas_session_count", "node_label": "NAS Session Count by Market, Activity Type and Site", "description": "Distinct NAS sessions where check-in (nas_nest_start_time) has occurred, grouped by market \\u00d7 project_category \\u00d7 activity_type \\u00d7 site_id so that downstream questions about sessions per site or per activity_type are answerable from a single KPI.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_checkout_turnaround', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_checkout_turnaround', label: 'Check-out Turnaround Time', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Average / p50 / p95 minutes between checkout request and approval.', nl_description: 'Average / p50 / p95 minutes between checkout request and approval.', nl_business_rule: 'Check-out Turnaround Time measures how long it takes, in minutes, from a check-out request to its approval during the construction phase. It helps answer how quickly check-outs are being processed and whether approval delays are affecting field operations. You can analyze it as average, median, or high-end turnaround time, and compare performance by market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_checkout_turnaround', kpi_name: 'Check-out Turnaround Time', kpi_description: 'Average / p50 / p95 minutes between checkout request and approval.', kpi_formula_description: 'AVG(EPOCH(nas_checkout_approve_time - nas_checkout_time)/60)', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_checkout_turnaround(execute_query, filters=None):\n    """KPI 3 — Checkout turnaround time = approve_time - checkout_time (minutes), by market.\n    Returns avg, p50, p95, count.\n    """\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_checkout_time",\n        extra_required=[\n            \'"nas_checkout_time" IS NOT NULL\',\n            \'"nas_checkout_approve_time" IS NOT NULL\',\n            \'"nas_checkout_approve_time"::timestamp >= "nas_checkout_time"::timestamp\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            "nas_market" AS market,\n            COUNT(*) AS sessions,\n            ROUND(AVG(EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_checkout_time"::timestamp))/60.0)::numeric, 2) AS avg_turnaround_minutes,\n            ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_checkout_time"::timestamp))/60.0))::numeric, 2) AS p50_minutes,\n            ROUND((PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_checkout_time"::timestamp))/60.0))::numeric, 2) AS p95_minutes\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE {where}\n        GROUP BY 1\n        ORDER BY avg_turnaround_minutes DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_checkout_time', 'nas_checkout_approve_time', 'nas_market'], kpi_dimensions: ['market'], kpi_business_logic: '"AVG(EPOCH(nas_checkout_approve_time - nas_checkout_time)/60)"', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_checkout_turnaround", "node_type": "kpi", "node_id": "kpi_checkout_turnaround", "node_label": "Check-out Turnaround Time", "description": "Average / p50 / p95 minutes between checkout request and approval.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_checkout_sla_compliance', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_checkout_sla_compliance', label: 'Check-out SLA Compliance Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: '% of checkouts whose turnaround time is within 15 minutes.', nl_description: '% of checkouts whose turnaround time is within 15 minutes.', nl_business_rule: 'Check-out SLA Compliance Rate measures the share of checkouts completed within the 15-minute service target during the construction phase. It helps answer how consistently teams are meeting the promised turnaround time and where service performance is slipping. This metric is expressed as a percentage and is most useful when compared across markets.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_checkout_sla_compliance', kpi_name: 'Check-out SLA Compliance Rate', kpi_description: '% of checkouts whose turnaround time is within 15 minutes.', kpi_formula_description: '100 * COUNT(*) FILTER (turnaround <= 15min) / COUNT(*)', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_checkout_sla_compliance(execute_query, filters=None):\n    """KPI 4 — % checkouts with turnaround ≤ 15 minutes (Check-Out SLA Compliance Rate)."""\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_checkout_time",\n        extra_required=[\n            \'"nas_checkout_time" IS NOT NULL\',\n            \'"nas_checkout_approve_time" IS NOT NULL\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            "nas_market" AS market,\n            COUNT(*) AS total_checkouts,\n            COUNT(*) FILTER (\n                WHERE EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_checkout_time"::timestamp))/60.0 <= 15\n            ) AS within_sla,\n            ROUND(100.0 * COUNT(*) FILTER (\n                WHERE EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_checkout_time"::timestamp))/60.0 <= 15\n            ) / NULLIF(COUNT(*), 0), 2) AS sla_compliance_pct\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE {where}\n        GROUP BY 1\n        ORDER BY sla_compliance_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_checkout_time', 'nas_checkout_approve_time'], kpi_dimensions: ['market'], kpi_business_logic: '"100 * COUNT(*) FILTER (turnaround <= 15min) / COUNT(*)"', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_checkout_sla_compliance", "node_type": "kpi", "node_id": "kpi_checkout_sla_compliance", "node_label": "Check-out SLA Compliance Rate", "description": "% of checkouts whose turnaround time is within 15 minutes.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_rejection_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_rejection_rate', label: 'NAS Rejection Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: '% of NAS log events that are rejections, broken down into check-in and check-out rejections.', nl_description: '% of NAS log events that are rejections, broken down into check-in and check-out rejections.', nl_business_rule: 'NAS Rejection Rate measures the share of NAS activity in Construction that ends in a rejection, including both check-in and check-out rejections. It helps answer where rejection levels are high and how often NAS events are being rejected overall. You can analyze it by region and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_rejection_rate', kpi_name: 'NAS Rejection Rate', kpi_description: '% of NAS log events that are rejections, broken down into check-in and check-out rejections.', kpi_formula_description: 'COUNT(rejection_events) / COUNT(*) — rejection_events = nas_event_type IN (\'Nest Rejected\',\'Conditional Approval-Rejected\')', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_rejection_rate(execute_query, filters=None):\n    """KPI 5 — NAS Rejection rate: rejection events / total events, by market."""\n    where, params = apply_filters(\n        "stg_nas_log_data", filters, time_column="nas_event_time",\n    )\n    sql = f"""\n        SELECT\n            "nas_region" AS region,\n            "nas_market" AS market,\n            COUNT(*) AS total_events,\n            COUNT(*) FILTER (WHERE "nas_event_type" IN (\'Nest Rejected\',\'Conditional Approval-Rejected\')) AS rejection_events,\n            COUNT(*) FILTER (WHERE "nas_event_type" = \'Nest Rejected\') AS check_in_rejections,\n            COUNT(*) FILTER (WHERE "nas_event_type" = \'Conditional Approval-Rejected\') AS check_out_rejections,\n            ROUND(100.0 * COUNT(*) FILTER (WHERE "nas_event_type" IN (\'Nest Rejected\',\'Conditional Approval-Rejected\'))\n                  / NULLIF(COUNT(*), 0), 2) AS rejection_rate_pct\n        FROM {fq("stg_nas_log_data")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2\n        ORDER BY rejection_rate_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_log_event', 'rejection_event'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_log_data'], kpi_source_columns: ['nas_event_type', 'nas_region', 'nas_market'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"COUNT(rejection_events) / COUNT(*) \\u2014 rejection_events = nas_event_type IN (\'Nest Rejected\',\'Conditional Approval-Rejected\')"', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_rejection_rate", "node_type": "kpi", "node_id": "kpi_rejection_rate", "node_label": "NAS Rejection Rate", "description": "% of NAS log events that are rejections, broken down into check-in and check-out rejections.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_nest_extension_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_nest_extension_rate', label: 'NEST Extension Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Sessions that needed a NEST extension (status flag = 1) by market and project_category, plus those currently ongoing today.', nl_description: 'Sessions that needed a NEST extension (status flag = 1) by market and project_category, plus those currently ongoing today.', nl_business_rule: 'NEST Extension Rate measures the share of construction-phase sessions that required a NEST extension, along with how many are still ongoing today. It helps answer where extensions are happening most often and which areas may be facing delivery delays or added complexity. It can be broken down by market and project category.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_nest_extension_rate', kpi_name: 'NEST Extension Rate', kpi_description: 'Sessions that needed a NEST extension (status flag = 1) by market and project_category, plus those currently ongoing today.', kpi_formula_description: 'COUNT(DISTINCT session) FILTER (nas_status_nest_ext = \'1\') with rate and ongoing-today count', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_nest_extension_rate(execute_query, filters=None):\n    """KPI 6 — sessions that needed a NEST extension, plus those currently ongoing.\n\n    Ground-truth SQL from semantic_question_bank.csv uses the session-level flag\n    column ``nas_status_nest_ext = \'1\'`` directly (no JOIN to nest_ext_raw), which\n    avoids the fan-out bug that previously produced extension_rate_pct > 100% on\n    markets where the raw table had multiple rows per session.\n\n    Three measures per market × project_category:\n      - total_sessions\n      - extension_sessions     — sessions whose status flag = 1\n      - extension_rate_pct\n      - ongoing_today_sessions — extension flag=1, session created today, last_event\n                                 not \'forced checkout approval\' or \'nest_rejected\'\n    """\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        extra_required=[\'"nas_nest_start_time" IS NOT NULL\'],\n    )\n    sql = f"""\n        SELECT\n            "nas_market" AS market,\n            "nas_project_category" AS project_category,\n            COUNT(DISTINCT "nas_session_id") AS total_sessions,\n            COUNT(DISTINCT "nas_session_id") FILTER (\n                WHERE "nas_status_nest_ext" ~ \'^[0-9]+$\'\n                  AND "nas_status_nest_ext"::numeric = 1\n            ) AS extension_sessions,\n            ROUND(100.0 * COUNT(DISTINCT "nas_session_id") FILTER (\n                WHERE "nas_status_nest_ext" ~ \'^[0-9]+$\'\n                  AND "nas_status_nest_ext"::numeric = 1\n            ) / NULLIF(COUNT(DISTINCT "nas_session_id"), 0), 2) AS extension_rate_pct,\n            COUNT(DISTINCT "nas_session_id") FILTER (\n                WHERE "nas_status_nest_ext" IS NOT NULL\n                  AND "nas_status_nest_ext" <> \'0\'\n                  AND "nas_session_create_time"::date = CURRENT_DATE\n                  AND LOWER(COALESCE("nas_last_event", \'\')) NOT IN (\'forced checkout approval\', \'nest_rejected\')\n            ) AS ongoing_today_sessions\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY extension_rate_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'nest_extension'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_session_id', 'nas_market', 'nas_project_category', 'nas_status_nest_ext', 'nas_session_create_time', 'nas_last_event'], kpi_dimensions: ['market', 'project_category'], kpi_business_logic: '"COUNT(DISTINCT session) FILTER (nas_status_nest_ext = \'1\') with rate and ongoing-today count"', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_nest_extension_rate", "node_type": "kpi", "node_id": "kpi_nest_extension_rate", "node_label": "NEST Extension Rate", "description": "Sessions that needed a NEST extension (status flag = 1) by market and project_category, plus those currently ongoing today.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_e911_readiness_index', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_e911_readiness_index', label: 'E911 Readiness Index', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Count + % of sites with E911 readiness = Ready (or Ready_Completed), by region × market.', nl_description: 'Count + % of sites with E911 readiness = Ready (or Ready_Completed), by region × market.', nl_business_rule: 'E911 Readiness Index measures the share and count of sites that are ready for E911 service activation. It helps answer how prepared the network is for E911 rollout and where readiness gaps remain. You can analyze it by region and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_e911_readiness_index', kpi_name: 'E911 Readiness Index', kpi_description: 'Count + % of sites with E911 readiness = Ready (or Ready_Completed), by region × market.', kpi_formula_description: '100 * COUNT(DISTINCT nas_site_id) FILTER (nas_validate_e911_readiness ILIKE \'Ready%\') / COUNT(DISTINCT nas_site_id)', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_e911_readiness_index(execute_query, filters=None):\n    """KPI 7 — count of sites with E911 readiness = \'Ready\', plus readiness % per market."""\n    where, params = apply_filters(\n        "stg_nas_e911_readiness_riot_validation", filters,\n        time_column="nas_e911_validation_date",\n    )\n    sql = f"""\n        SELECT\n            "nas_region" AS region,\n            "nas_market" AS market,\n            COUNT(DISTINCT "nas_site_id") AS total_sites,\n            COUNT(DISTINCT "nas_site_id") FILTER (\n                WHERE "nas_validate_e911_readiness" ILIKE \'Ready%%\'\n            ) AS ready_sites,\n            ROUND(100.0 * COUNT(DISTINCT "nas_site_id") FILTER (\n                WHERE "nas_validate_e911_readiness" ILIKE \'Ready%%\'\n            ) / NULLIF(COUNT(DISTINCT "nas_site_id"), 0), 2) AS ready_pct\n        FROM {fq("stg_nas_e911_readiness_riot_validation")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2\n        ORDER BY ready_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e911_validation', 'site'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_e911_readiness_riot_validation'], kpi_source_columns: ['nas_si