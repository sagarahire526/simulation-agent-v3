CREATE (:BKGNode {node_id: 'workflow_phase', session_id: '6a079b6bc1ea92432985ef54', name: 'workflow_phase', label: 'Workflow Phase', node_type: 'CORE', entity_type: 'reference', status: 'confirmed', definition: 'A phase of the NAS site-delivery lifecycle (Site Assignment, INTP Pre-requisites, Construction, Tower Construction, Integration, Post Integration). Backed by NAS_Workflow_Diagram.json.', nl_description: 'A phase of the NAS site-delivery lifecycle (Site Assignment, INTP Pre-requisites, Construction, Tower Construction, Integration, Post Integration). Backed by NAS_Workflow_Diagram.json.', nl_business_rule: 'One of the 6 canonical phases of NAS site delivery: Site Assignment, INTP Pre-requisites, Construction, Tower Construction, Integration, Post Integration. Every workflow step belongs to exactly one phase. Sourced from documents/NAS_Workflow_Diagram.json.', is_skipped: false, skip_reason: '', map_table_name: '_findings/01_workflow_steps.json', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'phase_id', map_label_column: 'phase_name', map_sql_template: '-- JSON-backed; no Postgres query. Returns 6 phases derived from NAS_Workflow_Diagram.json.', map_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\nWORKFLOW_PHASES = [{\'phase_id\': 1, \'phase_name\': \'Site Assignment\', \'step_count\': 2}, {\'phase_id\': 6, \'phase_name\': \'INTP (Integration Pre-requisites)\', \'step_count\': 3}, {\'phase_id\': 8, \'phase_name\': \'Construction\', \'step_count\': 8}, {\'phase_id\': 10, \'phase_name\': \'Tower Construction\', \'step_count\': 1}, {\'phase_id\': 11, \'phase_name\': \'Integration\', \'step_count\': 9}, {\'phase_id\': 12, \'phase_name\': \'Post Integration\', \'step_count\': 6}]\n# ─────────── end inlined prelude ───────────\n\ndef get_workflow_phase(execute_query, filters=None):\n    """Workflow Phase — 6 phases of the NAS site-delivery lifecycle.\n    Backed by documents/NAS_Workflow_Diagram.json (loaded at module import).\n    Filters honoured: phase_id, phase_name (ILIKE).\n    """\n    filters = filters or {}\n    rows = list(WORKFLOW_PHASES)\n    pid = filters.get("phase_id")\n    if pid is not None:\n        try:\n            pid_int = int(pid)\n            rows = [r for r in rows if r.get("phase_id") == pid_int]\n        except (TypeError, ValueError):\n            rows = []\n    pname = filters.get("phase_name")\n    if pname:\n        rows = [r for r in rows if pname.lower() in (r.get("phase_name") or "").lower()]\n    return rows\n', filters: '[{"name": "region", "type": "string", "description": "filter by region", "required": false}, {"name": "area", "type": "string", "description": "filter by area", "required": false}, {"name": "market", "type": "string", "description": "filter by market", "required": false}, {"name": "gc_name", "type": "string", "description": "filter by GC name", "required": false}, {"name": "site_id", "type": "string", "description": "filter by site id", "required": false}, {"name": "session_id", "type": "string", "description": "filter by session id", "required": false}, {"name": "project_category", "type": "string", "description": "filter by project category", "required": false}, {"name": "start_date", "type": "date", "description": "start of time range", "required": false}, {"name": "end_date", "type": "date", "description": "end of time range", "required": false}]', map_contract: '{"function_name": "get_workflow_phase", "node_type": "core", "node_id": "workflow_phase", "node_label": "Workflow Phase", "description": "A phase of the NAS site-delivery lifecycle (Site Assignment, INTP Pre-requisites, Construction, Tower Construction, Integration, Post Integration). Backed by NAS_Workflow_Diagram.json.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
