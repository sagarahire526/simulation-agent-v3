n filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_onair_milestone_count(execute_query, filters=None):\n    """KPI — On-Air Milestone Count: distinct sites with mb_status = \'Done\'."""\n    where, params = apply_filters(\n        "stg_nas_rf010_dashboard", filters,\n        time_column="task_received_datetime",\n        extra_required=["\\"mb_status\\" ILIKE \'Done\'"],\n    )\n    sql = f"""\n        SELECT\n            "region_id" AS region,\n            "market_id" AS market,\n            COUNT(DISTINCT "project_site_id") AS on_air_sites\n        FROM {fq("stg_nas_rf010_dashboard")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY on_air_sites DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['rf010_task', 'site', 'integration_milestone'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_rf010_dashboard'], kpi_source_columns: ['project_site_id', 'mb_status', 'region_id', 'market_id'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"(1) Filter rf010 to rows where mb_status ILIKE \'Done\'. (2) Group by region_id \\u00d7 market_id. (3) Return COUNT(DISTINCT project_site_id)."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_onair_milestone_count", "node_type": "kpi", "node_id": "kpi_onair_milestone_count", "node_label": "On-Air Milestone Count", "description": "Distinct count of project_site_id values whose RF010 mb_status is \'Done\' \\u2014 the canonical definition of an on-air site in the RF010 dashboard.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_rf010_sla_adherence', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_rf010_sla_adherence', label: 'RF010 SLA Adherence Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Percentage of RF010 tasks whose turnaround (task_completed_datetime - task_received_datetime) is at or below the 240-minute SLA. Threshold from KPI catalog.', nl_description: 'Percentage of RF010 tasks whose turnaround (task_completed_datetime - task_received_datetime) is at or below the 240-minute SLA. Threshold from KPI catalog.', nl_business_rule: 'RF010 SLA Adherence Rate measures the share of RF010 tasks completed within the 240-minute service-level target. It helps answer how consistently teams are meeting the promised turnaround time and where SLA performance is slipping. This metric can be analyzed by region and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_rf010_sla_adherence', kpi_name: 'RF010 SLA Adherence Rate', kpi_description: 'Percentage of RF010 tasks whose turnaround (task_completed_datetime - task_received_datetime) is at or below the 240-minute SLA. Threshold from KPI catalog.', kpi_formula_description: '100 * COUNT FILTER (turnaround_min <= 240) / COUNT(*)', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_rf010_sla_adherence(execute_query, filters=None):\n    """KPI — RF010 SLA Adherence Rate (240 min threshold from KPI catalog)."""\n    where, params = apply_filters(\n        "stg_nas_rf010_dashboard", filters,\n        time_column="task_received_datetime",\n        extra_required=[\n            \'"task_received_datetime" IS NOT NULL\',\n            \'"task_completed_datetime" IS NOT NULL\',\n            \'"task_completed_datetime"::timestamp >= "task_received_datetime"::timestamp\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            "region_id" AS region,\n            "market_id" AS market,\n            COUNT(*) AS total_tasks,\n            COUNT(*) FILTER (\n                WHERE EXTRACT(EPOCH FROM ("task_completed_datetime"::timestamp - "task_received_datetime"::timestamp))/60.0 <= 240\n            ) AS within_sla,\n            ROUND(100.0 * COUNT(*) FILTER (\n                WHERE EXTRACT(EPOCH FROM ("task_completed_datetime"::timestamp - "task_received_datetime"::timestamp))/60.0 <= 240\n            ) / NULLIF(COUNT(*), 0), 2) AS sla_adherence_pct\n        FROM {fq("stg_nas_rf010_dashboard")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY sla_adherence_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['rf010_task'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_rf010_dashboard'], kpi_source_columns: ['task_received_datetime', 'task_completed_datetime', 'region_id', 'market_id'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"(1) Restrict to rows where both task_received_datetime and task_completed_datetime are NOT NULL and completed >= received. (2) turnaround_min = EPOCH(completed - received)/60. (3) within_sla = COUNT FILTER (turnaround_min <= 240). (4) Return 100 * within_sla/total grouped by region_id \\u00d7 market_id."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_rf010_sla_adherence", "node_type": "kpi", "node_id": "kpi_rf010_sla_adherence", "node_label": "RF010 SLA Adherence Rate", "description": "Percentage of RF010 tasks whose turnaround (task_completed_datetime - task_received_datetime) is at or below the 240-minute SLA. Threshold from KPI catalog.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_rf010_delivery_duration_avg', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_rf010_delivery_duration_avg', label: 'RF010 Delivery Duration (avg)', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Average RF010 task duration in minutes, with p50 and p95. Mirrors kpi_rf010_turnaround but emphasizes the delivery-duration framing requested by the dashboard, grouped per region_id × market_id.', nl_description: 'Average RF010 task duration in minutes, with p50 and p95. Mirrors kpi_rf010_turnaround but emphasizes the delivery-duration framing requested by the dashboard, grouped per region_id × market_id.', nl_business_rule: 'This metric shows the average time it takes to complete an RF010 task from when it is received to when it is finished, along with typical and high-end delivery durations. It helps answer how quickly RF010 work is being delivered and where delays or long-tail completion times are occurring. It can be broken down by region and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_rf010_delivery_duration_avg', kpi_name: 'RF010 Delivery Duration (avg)', kpi_description: 'Average RF010 task duration in minutes, with p50 and p95. Mirrors kpi_rf010_turnaround but emphasizes the delivery-duration framing requested by the dashboard, grouped per region_id × market_id.', kpi_formula_description: 'AVG / p50 / p95 of (task_completed_datetime - task_received_datetime) in minutes', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_rf010_delivery_duration_avg(execute_query, filters=None):\n    """KPI — RF010 Delivery Duration (avg / p50 / p95) in minutes."""\n    where, params = apply_filters(\n        "stg_nas_rf010_dashboard", filters,\n        time_column="task_received_datetime",\n        extra_required=[\n            \'"task_received_datetime" IS NOT NULL\',\n            \'"task_completed_datetime" IS NOT NULL\',\n            \'"task_completed_datetime"::timestamp >= "task_received_datetime"::timestamp\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            "region_id" AS region,\n            "market_id" AS market,\n            COUNT(*) AS tasks,\n            ROUND(AVG(EXTRACT(EPOCH FROM ("task_completed_datetime"::timestamp - "task_received_datetime"::timestamp))/60.0)::numeric, 2) AS avg_duration_minutes,\n            ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("task_completed_datetime"::timestamp - "task_received_datetime"::timestamp))/60.0))::numeric, 2) AS p50_minutes,\n            ROUND((PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("task_completed_datetime"::timestamp - "task_received_datetime"::timestamp))/60.0))::numeric, 2) AS p95_minutes\n        FROM {fq("stg_nas_rf010_dashboard")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY avg_duration_minutes DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['rf010_task'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_rf010_dashboard'], kpi_source_columns: ['task_received_datetime', 'task_completed_datetime', 'region_id', 'market_id'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"(1) Restrict to rows where both task_received_datetime and task_completed_datetime are NOT NULL and completed >= received. (2) duration_min = EPOCH(completed - received)/60. (3) Return AVG, p50, p95, COUNT grouped by region_id \\u00d7 market_id."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_rf010_delivery_duration_avg", "node_type": "kpi", "node_id": "kpi_rf010_delivery_duration_avg", "node_label": "RF010 Delivery Duration (avg)", "description": "Average RF010 task duration in minutes, with p50 and p95. Mirrors kpi_rf010_turnaround but emphasizes the delivery-duration framing requested by the dashboard, grouped per region_id \\u00d7 market_id.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_construction_complete_latency', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_construction_complete_latency', label: 'Construction Complete Latency', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Average elapsed days from project construction-start (ms_1550_construction_start_actual) to construction-complete (ms_1555_construction_complete_actual) per site, grouped by region/market/GC crew. Captures GC delivery speed for the full construction phase.', nl_description: 'Average elapsed days from project construction-start (ms_1550_construction_start_actual) to construction-complete (ms_1555_construction_complete_actual) per site, grouped by region/market/GC crew. Captures GC delivery speed for the full construction phase.', nl_business_rule: 'Construction Complete Latency measures the average number of days it takes a site to move from construction start to construction complete. It helps answer how quickly general contractors are delivering the full construction phase and where completion timelines are slowing down. You can analyze it by region, market, and GC crew.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_construction_complete_latency', kpi_name: 'Construction Complete Latency', kpi_description: 'Average elapsed days from project construction-start (ms_1550_construction_start_actual) to construction-complete (ms_1555_construction_complete_actual) per site, grouped by region/market/GC crew. Captures GC delivery speed for the full construction phase.', kpi_formula_description: 'AVG((ms_1555_construction_complete_actual - ms_1550_construction_start_actual) in days)', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_construction_complete_latency(execute_query, filters=None):\n    """KPI — Construction Complete Latency: avg days from construction start to ms_1555 actual."""\n    where, params = apply_filters(\n        "stg_ndpd_mbt_tmobile_macro_combined", filters,\n        time_column="ms_1550_construction_start_actual",\n        extra_required=[\n            \'"ms_1550_construction_start_actual" IS NOT NULL\',\n            \'"ms_1555_construction_complete_actual" IS NOT NULL\',\n            \'"ms_1555_construction_complete_actual"::timestamp >= "ms_1550_construction_start_actual"::timestamp\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            "rgn_region" AS region,\n            "m_market" AS market,\n            "pj_gc_crew_name" AS gc_name,\n            COUNT(*) AS sites,\n            ROUND(AVG(EXTRACT(EPOCH FROM ("ms_1555_construction_complete_actual"::timestamp - "ms_1550_construction_start_actual"::timestamp))/86400.0)::numeric, 2) AS avg_latency_days,\n            ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("ms_1555_construction_complete_actual"::timestamp - "ms_1550_construction_start_actual"::timestamp))/86400.0))::numeric, 2) AS p50_days,\n            ROUND((PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("ms_1555_construction_complete_actual"::timestamp - "ms_1550_construction_start_actual"::timestamp))/86400.0))::numeric, 2) AS p95_days\n        FROM {fq("stg_ndpd_mbt_tmobile_macro_combined")}\n        WHERE {where}\n        GROUP BY 1, 2, 3\n        ORDER BY avg_latency_days DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['site', 'project', 'gc', 'integration_milestone'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_ndpd_mbt_tmobile_macro_combined'], kpi_source_columns: ['s_site_id', 'ms_1550_construction_start_actual', 'ms_1555_construction_complete_actual', 'rgn_region', 'm_market', 'pj_gc_crew_name'], kpi_dimensions: ['region', 'market', 'gc_name'], kpi_business_logic: '"(1) Restrict to rows where both ms_1550_construction_start_actual and ms_1555_construction_complete_actual are NOT NULL and complete >= start. (2) days = EPOCH(complete - start)/86400. (3) Return AVG, p50, p95, COUNT grouped by rgn_region \\u00d7 m_market \\u00d7 pj_gc_crew_name."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by area", "name": "area"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_construction_complete_latency", "node_type": "kpi", "node_id": "kpi_construction_complete_latency", "node_label": "Construction Complete Latency", "description": "Average elapsed days from project construction-start (ms_1550_construction_start_actual) to construction-complete (ms_1555_construction_complete_actual) per site, grouped by region/market/GC crew. Captures GC delivery speed for the full construction phase.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_civil_construction_latency', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_civil_construction_latency', label: 'Civil Construction Complete Latency', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Average elapsed days from construction-start (ms_1550_construction_start_actual) to civil construction complete (ms_1551_civil_construction_complete_actual_date). Civil-only sub-phase latency.', nl_description: 'Average elapsed days from construction-start (ms_1550_construction_start_actual) to civil construction complete (ms_1551_civil_construction_complete_actual_date). Civil-only sub-phase latency.', nl_business_rule: 'Civil Construction Complete Latency measures the average number of days it takes to move from construction start to civil construction completion for the civil sub-phase of a site build. It helps answer how long civil works are taking and where delivery may be slowing down. You can analyze it by region and market, and review it across sites, projects, or milestone groups.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_civil_construction_latency', kpi_name: 'Civil Construction Complete Latency', kpi_description: 'Average elapsed days from construction-start (ms_1550_construction_start_actual) to civil construction complete (ms_1551_civil_construction_complete_actual_date). Civil-only sub-phase latency.', kpi_formula_description: 'AVG((ms_1551_civil_construction_complete_actual_date - ms_1550_construction_start_actual) in days)', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_le