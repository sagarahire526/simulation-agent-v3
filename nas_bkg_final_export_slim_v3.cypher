       pid = int(filters["phase_id"])\n            rows = [r for r in rows if r.get("phase_id") == pid]\n        except (TypeError, ValueError):\n            rows = []\n    if filters.get("phase_name"):\n        pn = filters["phase_name"].lower()\n        rows = [r for r in rows if pn in (r.get("phase_name") or "").lower()]\n    if filters.get("step_name"):\n        sn = filters["step_name"].lower()\n        rows = [r for r in rows if sn in (r.get("step_name") or "").lower()]\n    if filters.get("source_table"):\n        rows = [r for r in rows if (r.get("source_table") or "") == filters["source_table"]]\n    return rows\n', filters: '[{"name": "region", "type": "string", "description": "filter by region", "required": false}, {"name": "area", "type": "string", "description": "filter by area", "required": false}, {"name": "market", "type": "string", "description": "filter by market", "required": false}, {"name": "gc_name", "type": "string", "description": "filter by GC name", "required": false}, {"name": "site_id", "type": "string", "description": "filter by site id", "required": false}, {"name": "session_id", "type": "string", "description": "filter by session id", "required": false}, {"name": "project_category", "type": "string", "description": "filter by project category", "required": false}, {"name": "start_date", "type": "date", "description": "start of time range", "required": false}, {"name": "end_date", "type": "date", "description": "end of time range", "required": false}]', map_contract: '{"function_name": "get_workflow_step", "node_type": "core", "node_id": "workflow_step", "node_label": "Workflow Step", "description": "An individual step in the NAS workflow (29 total, e.g. \'NAS Check in \\u00d7 Rejection\', \'e911 call testing Final Green\'). Carries its parent phase, dependency list, and the staging table that feeds it.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
