, \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\nCAUSE_TAXONOMIES = {\'check_in_rejection\': {\'Invalid CR\': [\'invalid\', \'cr \', \' cr.\'], \'Outage Pending\': [\'outage\', \'pending\'], \'Unavailable PO\': [\'po \', \'unavail\', \'purchase\'], \'Existing Layer Outage\': [\'layer\', \'outage\'], \'Duplicate Session\': [\'duplicate\', \'duplicat\']}, \'checkout_rejection\': {\'Alarms\': [\'alarm\'], \'Cell Down\': [\'cell down\', \'cell-down\'], \'RTWP\': [\'rtwp\'], \'Pending Clearance\': [\'clearance\', \'pending\'], \'Open Incident\': [\'incident\', \'ticket\']}, \'e911_red\': {\'RIOT Mismatch\': [\'riot\', \'mismatch\'], \'CBN Issue\': [\'cbn\'], \'Duplicate CGI\': [\'cgi\', \'duplicate\'], \'New Layer Failure\': [\'new layer\', \'layer failure\'], \'GMLC/eSMLC Sync\': [\'gmlc\', \'esmlc\', \'sync\']}, \'intp_delay\': {\'Dependency Delay\': [\'dependency\', \'depend\'], \'Approval Pending\': [\'approval\', \'pending\'], \'Resource Shortage\': [\'resource\', \'staffing\'], \'Tool Downtime\': [\'tool\', \'downtime\', \'outage\'], \'Backlog\': [\'backlog\']}, \'nest_extension_rejection\': {\'Invalid Request\': [\'invalid\', \'incorrect\'], \'Missing Approval\': [\'approval\', \'missing\'], \'SLA Exceeded\': [\'sla\', \'exceeded\'], \'Site ID Mismatch\': [\'site id\', \'mismatch\'], \'Duplicate Request\': [\'duplicate\']}}\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_remediation_planner(execute_query, filters=None):\n    """Universal: for any flagged failure surface (NOT-READY E911, RED call test,\n    pending RF010), classify failure layer and assign owner + remediation step.\n\n    `filters[\'failure_source\']` ∈ {\'e911\',\'call_test\',\'rf010\'}; default \'e911\'.\n    """\n    filt = dict(filters or {})\n    source = filt.pop("failure_source", "e911")\n    out = []\n    step_map = {\n        "RIOT Mismatch":     "Re-run RIOT validation; compare against RFCIQ",\n        "CBN Issue":         "Re-test CBN connectivity from PSAP",\n        "Duplicate CGI":     "Resolve CGI conflict with TMO",\n        "New Layer Failure": "Validate new-layer config via NEST",\n        "GMLC/eSMLC Sync":   "Trigger GMLC/eSMLC re-sync",\n        "Alarms":            "Restore from MOP, retest",\n        "Cell Down":         "Field engineer on-site; replace SFP/RRU",\n    }\n\n    if source == "e911":\n        where, params = apply_filters(\n            "stg_nas_e911_readiness_riot_validation", filt,\n            time_column="nas_e911_validation_date",\n            extra_required=["\\"nas_validate_e911_readiness\\" NOT ILIKE \'Ready%%\'"],\n        )\n        rows = execute_query(f"""\n            SELECT "nas_site_id" AS site_id, "nas_market" AS market, "nas_engineer" AS engineer,\n                   "nas_validate_e911_readiness" AS readiness, "nas_consolidation_check_all_layers" AS consolidation\n            FROM {fq("stg_nas_e911_readiness_riot_validation")} WHERE {where} LIMIT 200\n        """, params)\n        for r in rows:\n            layer = _classify(f"{r.get(\'readiness\',\'\')} {r.get(\'consolidation\',\'\')}", CAUSE_TAXONOMIES["e911_red"])\n            out.append({\n                "entity": r["site_id"],\n                "decision": "remediate",\n                "reason": f"E911 failure layer: {layer}",\n                "evidence": {"owner": r.get("engineer") or "PM", "remediation_step": step_map.get(layer, "Manual review"), "market": r.get("market"), "readiness": r.get("readiness")},\n            })\n\n    elif source == "call_test":\n        where, params = apply_filters(\n            "stg_nas_e2e_call_test_completion", filt,\n            time_column="nas_integration_date",\n            extra_required=["\\"nas_call_test_completion_status\\" ILIKE \'RED\'"],\n        )\n        rows = execute_query(f"""\n            SELECT "nas_site_id" AS site_id, "nas_market" AS market, "nas_go_email_responsibility" AS engineer\n            FROM {fq("stg_nas_e2e_call_test_completion")} WHERE {where} LIMIT 200\n        """, params)\n        for r in rows:\n            out.append({\n                "entity": r["site_id"],\n                "decision": "remediate",\n                "reason": "RED call test — cross-check RIOT and CBN",\n                "evidence": {"owner": r.get("engineer") or "PM", "remediation_step": "RIOT/CBN reconciliation", "market": r.get("market")},\n            })\n\n    elif source == "rf010":\n        where, params = apply_filters(\n            "stg_nas_rf010_dashboard", filt,\n            time_column="task_received_datetime",\n            extra_required=["\\"activity_tracker_state\\" NOT ILIKE \'Completed\'"],\n        )\n        rows = execute_query(f"""\n            SELECT "project_site_id" AS site_id, "market_id" AS market, "activity_tracker_state" AS state\n            FROM {fq("stg_nas_rf010_dashboard")} WHERE {where} LIMIT 200\n        """, params)\n        for r in rows:\n            out.append({\n                "entity": r["site_id"],\n                "decision": "remediate",\n                "reason": f"RF010 task state \'{r.get(\'state\')}\'",\n                "evidence": {"owner": "RF010 PM", "remediation_step": "Re-trigger health check, escalate if blocked", "market": r.get("market")},\n            })\n    return out\n', kpi_relationship_type: 'DECIDES_BASED_ON', kpi_related_core_node_ids: ['e911_validation', 'e2e_call_test', 'rf010_task'], kpi_related_kpi_ids: ['kpi_e911_readiness_index', 'kpi_call_test_red_wip'], kpi_decision_logic: '"Remediation Planner"', kpi_contract: '{"function_name": "evaluate_remediation_planner", "node_type": "decision", "node_id": "dec_remediation_planner", "node_label": "Remediation Planner", "description": "Open-ended remediation capability. Pass failure_source \\u2208 {e911, call_test, rf010} to focus, or leave default. Returns one row per failing entity with classified failure layer, suggested owner, and prescribed remediation step.", "parameters": [], "output_columns": ["entity", "decision", "reason", "evidence"], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'dec_queue_monitor', session_id: '6a079b6bc1ea92432985ef54', name: 'dec_queue_monitor', label: 'Queue Monitor', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended queue surveillance. Pass queue_kind ∈ {checkin, checkout, rf010, e911} and threshold_pct. Returns markets exceeding the pending-volume threshold with escalation recommendation.', nl_description: 'Open-ended queue surveillance. Pass queue_kind ∈ {checkin, checkout, rf010, e911} and threshold_pct. Returns markets exceeding the pending-volume threshold with escalation recommendation.', nl_business_rule: 'Universal pending-queue surveillance across check-in / check-out / RF010 / e911 queues. Markets where pending % exceeds the threshold (default 50%) are escalated; below threshold they’re monitored.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'dec_queue_monitor', kpi_name: 'Queue Monitor', kpi_description: 'Open-ended queue surveillance. Pass queue_kind ∈ {checkin, checkout, rf010, e911} and threshold_pct. Returns markets exceeding the pending-volume threshold with escalation recommendation.', kpi_formula_description: 'Queue Monitor', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_queue_monitor(execute_query, filters=None):\n    """Universal: for any queue (check-in, check-out, RF010, e911), recommend\n    escalation when pending volume exceeds threshold.\n\n    `filters[\'queue_kind\']` ∈ {\'checkin\',\'checkout\',\'rf010\',\'e911\'}; default \'checkin\'.\n    `filters[\'threshold_pct\']` (default 50) — pending % above which to escalate.\n    """\n    filt = dict(filters or {})\n    kind = filt.pop("queue_kind", "checkin")\n    threshold = float(filt.pop("threshold_pct", 50))\n    out = []\n\n    if kind in ("checkin", "checkout"):\n        where, params = apply_filters("stg_nas_session_level_combined_data", filt, time_column="nas_nest_start_time",\n                                       extra_required=[\'"nas_nest_start_time" IS NOT NULL\'])\n        pending_pred = \'"nas_checkout_approve_time" IS NULL\' if kind == "checkout" else \'"nas_checkout_time" IS NULL\'\n        rows = execute_query(f"""\n            SELECT "nas_market" AS market,\n                   COUNT(*)                              AS total,\n                   COUNT(*) FILTER (WHERE {pending_pred}) AS pending,\n                   ROUND(100.0 * COUNT(*) FILTER (WHERE {pending_pred}) / NULLIF(COUNT(*),0), 2) AS pending_pct\n            FROM {fq("stg_nas_session_level_combined_data")} WHERE {where} GROUP BY 1 ORDER BY pending_pct DESC NULLS LAST\n        """, params)\n    elif kind == "rf010":\n        where, params = apply_filters("stg_nas_rf010_dashboard", filt, time_column="task_received_datetime")\n        rows = execute_query(f"""\n            SELECT "market_id" AS market, COUNT(*) AS total,\n                   COUNT(*) FILTER (WHERE "activity_tracker_state" NOT ILIKE \'Completed\') AS pending,\n                   ROUND(100.0 * COUNT(*) FILTER (WHERE "activity_tracker_state" NOT ILIKE \'Completed\') / NULLIF(COUNT(*),0), 2) AS pending_pct\n            FROM {fq("stg_nas_rf010_dashboard")} {f"WHERE {where}" if where else ""} GROUP BY 1\n        """, params)\n    elif kind == "e911":\n        where, params = apply_filters("stg_nas_e911_readiness_riot_validation", filt, time_column="nas_e911_validation_date")\n        rows = execute_query(f"""\n            SELECT "nas_market" AS market, COUNT(*) AS total,\n                   COUNT(*) FILTER (WHERE "nas_validate_e911_readiness" NOT ILIKE \'Ready%%\') AS pending,\n                   ROUND(100.0 * COUNT(*) FILTER (WHERE "nas_validate_e911_readiness" NOT ILIKE \'Ready%%\') / NULLIF(COUNT(*),0), 2) AS pending_pct\n            FROM {fq("stg_nas_e911_readiness_riot_validation")} {f"WHERE {where}" if where else ""} GROUP BY 1\n        """, params)\n    else:\n        return []\n    for r in rows:\n        pct = r.get("pending_pct") or 0\n        out.append({\n            "entity": r.get("market"),\n            "decision": "escalate" if pct >= threshold else "monitor",\n            "reason": f"{kind} queue pending {pct}% (threshold {threshold}%)",\n            "evidence": {"queue_kind": kind, "total": r.get("total"), "pending": r.get("pending"), "threshold_pct": threshold},\n        })\n    return out\n', kpi_relationship_type: 'DECIDES_BASED_ON', kpi_related_core_node_ids: ['nas_session', 'rf010_task', 'e911_validation'], kpi_related_kpi_ids: ['kpi_nas_session_count', 'kpi_rf010_completion_rate', 'kpi_e911_readiness_index'], kpi_decision_logic: '"Queue Monitor"', kpi_contract: '{"function_name": "evaluate_queue_monitor", "node_type": "decision", "node_id": "dec_queue_monitor", "node_label": "Queue Monitor", "description": "Open-ended queue surveillance. Pass queue_kind \\u2208 {checkin, checkout, rf010, e911} and threshold_pct. Returns markets exceeding the pending-volume threshold with escalation recommendation.", "parameters": [], "output_columns": ["entity", "decision", "reason", "evidence"], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'dec_performance_ranker', session_id: '6a079b6bc1ea92432985ef54', name: 'dec_performance_ranker', label: 'Performance Ranker', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended top-N ranking. Pass metric ∈ {rejection, red_wip, nest_extension, rf010_pending} and n. Returns ranked offenders with evidence — used for \'who is the worst at X?\' style questions.', nl_description: 'Open-ended top-N ranking. Pass metric ∈ {rejection, red_wip, nest_extension, rf010_pending} and n. Returns ranked offenders with evidence — used for \'who is the worst at X?\' style questions.', nl_business_rule: 'Universal top-N offender ranker across rejection, red_wip, nest_extension, and rf010_pending metrics. Used for ’who is the worst at X right now?’ questions — returns top N entities per metric with full evidence.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'dec_performance_ranker', kpi_name: 'Performance Ranker', kpi_description: 'Open-ended top-N ranking. Pass metric ∈ {rejection, red_wip, nest_extension, rf010_pending} and n. Returns ranked offenders with evidence — used for \'who is the worst at X?\' style questions.', kpi_formula_description: 'Performance Ranker', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_performance_ranker(execute_query, filters=None):\n    """Universal top-N ranking. `filters[\'metric\']` ∈\n    {\'rejection\',\'red_wip\',\'nest_extension\',\'rf010_pending\'}; default \'rejection\'.\n    `filters[\'n\']` (default 10).\n    """\n    filt = dict(filters or {})\n    metric = filt.pop("metric", "rejection")\n    n = int(filt.pop("n", 10))\n    out = []\n\n    if metric == "rejection":\n        rows = get_rejection_rate(execute_query, filt)\n        rows.sort(key=lambda r: -(r.get("rejection_events") or 0))\n        for r in rows[:n]:\n            out.append({"entity": r.get("market"), "decision": "investigate", "reason": f"{r.get(\'rejection_events\')} rejection events", "evidence": r})\n\n    elif metric == "red_wip":\n        rows = get_call_test_red_wip(execute_query, filt)\n        rows.sort(key=lambda r: -(r.get("red_wip_sites") or 0))\n        for r in rows[:n]:\n            out.append({"entity": r.get("engineer") or r.get("market"), "decision": "investigate", "reason": f"{r.get(\'red_wip_sites\')} RED WIP sites", "evidence": r})\n\n    elif metric == "nest_extension":\n        rows = get_nest_extension_rate(execute_query, filt)\n        rows.sort(key=lambda r: -(r.get("extension_sessions") or 0))\n        for r in rows[:n]:\n            out.append({"entity": r.get("vendor"), "decision": "audit", "reason": f"{r.get(\'extension_sessions\')} extensions in {r.get(\'market\')}", "evidence": r})\n\n    elif metric == "rf010_pending":\n        rows = get_rf010_completion_rate(execute_query, filt)\n        rows.sort(key=lambda r: ((r.get("total_tasks") or 0) - (r.get("completed") or 0)), reverse=True)\n        for r in rows[:n]:\n            pending = (r.get("total_tasks") or 0) - (r.get("completed") or 0)\n            out.append({"entity": r.get("market"), "decision": "accelerate", "reason": f"{pending} RF010 tasks pending", "evidence": r})\n    return out\n', kpi_relationship_type: 'DECIDES_BASED_ON', kpi_related_core_node_ids: ['nas_log_event', 'e2e_call_test', 'nest_extension', 'rf010_task'], kpi_related_kpi_ids: ['kpi_rejection_rate', 'kpi_call_test_red_wip', 'kpi_nest_extension_rate', 'kpi_rf010_completion_rate'], kpi_decision_logic: '"Performance Ranker"', kpi_contract: '{"function_name": "evaluate_performance_ranker", "node_type": "decision", "node_id": "dec_performance_ranker", "node_label": "Performance Ranker", "description": "Open-ended top-N ranking. Pass metric \\u2208 {rejection, red_wip, nest_extension, rf010_pending} and n. Returns ranked offenders with evidence \\u2014 used for \'who is the worst at X?\' style questions.", "parameters": [], "output_columns": ["entity", "decision", "reason", "evidence"], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'dec_capacity_planner', session_id: '6a079b6bc1ea92432985ef54', name: 'dec_capacity_planner', label: 'Capacity Planner', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended capacity simulator. Every assumption is a filter override (target_sites, sessions_per_site, engineers, productivity, working_days). Powers any \'how many people/days do we need for X sites?\' question.', nl_description: 'Open-ended capacity simulator. Every assumption is a filter override (target_sites, sessions_per_site, engineers, productivity, working_days). Powers any \'how many people/days do we need for X sites?\' question.', nl_business_rule: 'Universal capacity simulator. Computes FTE-days required, daily and monthly throughput, and SLA-breach risk given assumption inputs (target_sites, sessions_per_site, engineer productivity). Anchors projections to live observed throughput.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'dec_capacity_planner', kpi_name: 'Capacity Planner', kpi_description: 'Open-ended capacity simulator. Every assumption is a filter override (target_sites, sessions_per_site, engineers, productivity, working_days). Powers any \'how many people/days do we need for X sites?\' question.', kpi_formula_description: 'Capacity Planner', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_capacity_planner(execute_query, filters=None):\n    """Universal capacity simulator. All inputs are filter overrides:\n      target_sites (default 1000), sessions_per_site (2.5), reattempt_pct (10),\n      engineer_sessions_per_day (8), engineers (10), working_days_per_year (250).\n    Output: FTE-days, daily sites, monthly sites, anchor to live observed throughput.\n    """\n    cfg = dict(filters or {})\n    target_sites              = float(cfg.get("target_sites", 1000))\n    sessions_per_site         = float(cfg.get("sessions_per_site", 2.5))\n    reattempt_pct             = float(cfg.get("reattempt_pct", 10))\n    engineer_sessions_per_day = float(cfg.get("engineer_sessions_per_day", 8))\n    engineers                 = float(cfg.get("engineers", 10))\n    working_days_per_year     = float(cfg.get("working_days_per_year", 250))\n\n    total_sessions    = target_sites * sessions_per_site\n    expected_sessions = total_sessions * (1 + reattempt_pct / 100)\n    fte_days          = expected_sessions / engineer_sessions_per_day if engineer_sessions_per_day else 0\n    daily_sessions    = engineer_sessions_per_day * engineers\n    daily_sites       = daily_sessions / sessions_per_site if sessions_per_site else 0\n    monthly_sites     = daily_sites * 20\n\n    current = execute_query(f"""\n        SELECT COUNT(DISTINCT "nas_session_id") AS observed_sessions,\n               COUNT(DISTINCT "nas_site_id")    AS observed_sites\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE "nas_nest_start_time" IS NOT NULL\n    """)\n    obs = current[0] if current else {"observed_sessions": 0, "observed_sites": 0}\n    return [{\n        "entity": "capacity_plan",\n        "decision": "plan",\n        "reason": f"Need {fte_days:.0f} FTE-days to deliver {int(target_sites)} sites",\n        "evidence": {\n            "inputs": {"target_sites": target_sites, "sessions_per_site": sessions_per_site, "reattempt_pct": reattempt_pct, "engineer_sessions_per_day": engineer_sessions_per_day, "engineers": engineers, "working_days_per_year": working_days_per_year},\n            "outputs": {"total_sessions": total_sessions, "expected_sessions_with_reattempt": round(expected_sessions, 1), "fte_days_needed": round(fte_days, 1), "daily_sites": round(daily_sites, 1), "monthly_sites": round(monthly_sites, 0)},\n            "live_anchor": {"observed_sessions": obs["observed_sessions"], "observed_sites": obs["observed_sites"]},\n        },\n    }]\n', kpi_relationship_type: 'DECIDES_BASED_ON', kpi_related_core_node_ids: ['nas_session', 'site'], kpi_related_kpi_ids: ['kpi_nas_session_count', 'kpi_nas_assignment_count'], kpi_decision_logic: '"Capacity Planner"', kpi_contract: '{"function_name": "evaluate_capacity_planner", "node_type": "decision", "node_id": "dec_capacity_planner", "node_label": "Capacity Planner", "description": "Open-ended capacity simulator. Every assumption is a filter override (target_sites, sessions_per_site, engineers, productivity, working_days). Powers any \'how many people/days do we need for X sites?\' question.", "parameters": [], "output_columns": ["entity", "decision", "reason", "evidence"], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'dec_scenario_modeler', session_id: '6a079b6bc1ea92432985ef54', name: 'dec_scenario_modeler', label: 'Scenario Modeler', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended what-if simulator over staffing/throughput. Inputs (staff_pct, weeks, sla_impact_factor) handle holiday plans, attrition, surges, weekend-only operation, etc.', nl_description: 'Open-ended what-if simulator over staffing/throughput. Inputs (staff_pct, weeks, sla_impact_factor) handle holiday plans, attrition, surges, weekend-only operation, etc.', nl_business_rule: 'Universal what-if simulator over staffing × duration × SLA-impact-factor. Handles holiday plans, attrition, surges, weekend-only operation. Markets with projected SLA-breach risk ≥30% trigger ’prepare’ decisions.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'dec_scenario_modeler', kpi_name: 'Scenario Modeler', kpi_description: 'Open-ended what-if simulator over staffing/throughput. Inputs (staff_pct, weeks, sla_impact_factor) handle holiday plans, attrition, surges, weekend-only operation, etc.', kpi_formula_description: 'Scenario Modeler', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_scenario_modeler(execute_query, filters=None):\n    """Universal resource-reduction simulator. Inputs (filter overrides):\n      staff_pct (default 50), weeks (default 2), sla_impact_factor (default 0.3).\n    Output: projected weekly throughput drop, SLA breach probability, escalation rec.\n    """\n    cfg = dict(filters or {})\n    weeks    = float(cfg.get("weeks", 2))\n    staff_pct = float(cfg.get("staff_pct", 50))\n    sla_impact_factor = float(cfg.get("sla_impact_factor", 0.3))\n\n    where, params = apply_filters("stg_nas_session_level_combined_data", filters,\n                                   time_column="nas_nest_start_time",\n                                   extra_required=[\'"nas_nest_start_time" IS NOT NULL\'])\n    sql = f"""\n        SELECT "nas_market" AS market,\n               COUNT(DISTINCT "nas_session_id")::numeric\n                   / GREATEST(EXTRACT(EPOCH FROM (MAX("nas_nest_start_time"::timestamp) - MIN("nas_nest_start_time"::timestamp)))/(86400*7), 1) AS sessions_per_week\n        FROM {fq("stg_nas_session_level_combined_data")} WHERE {where}\n        GROUP BY 1 ORDER BY sessions_per_week DESC NULLS LAST LIMIT 50\n    """\n    rows = execute_query(sql, params)\n    out = []\n    factor = staff_pct / 100.0\n    drop_pct = 100 * (1 - factor)\n    for r in rows:\n        full = float(r.get("sessions_per_week") or 0)\n        reduced = full * factor\n        sla_risk = min(100.0, drop_pct * weeks * sla_impact_factor)\n        out.append({\n            "entity": r.get("market"),\n            "decision": "prepare" if sla_risk >= 30 else "monitor",\n            "reason": f"At {staff_pct:.0f}% staffing for {weeks:.0f} wks → throughput drop {drop_pct:.0f}%, SLA breach risk {sla_risk:.0f}%",\n            "evidence": {"baseline_per_week": round(full, 1), "projected_per_week": round(reduced, 1), "throughput_drop_pct": round(drop_pct, 1), "sla_breach_probability_pct": round(sla_risk, 1)},\n        })\n    return out\n', kpi_relationship_type: 'DECIDES_BASED_ON', kpi_related_core_node_ids: ['nas_session'], kpi_related_kpi_ids: ['kpi_nas_session_count', 'kpi_checkout_sla_compliance'], kpi_decision_logic: '"Scenario Modeler"', kpi_contract: '{"function_name": "evaluate_scenario_modeler", "node_type": "decision", "node_id": "dec_scenario_modeler", "node_label": "Scenario Modeler", "description": "Open-ended what-if simulator over staffing/throughput. Inputs (staff_pct, weeks, sla_impact_factor) handle holiday plans, attrition, surges, weekend-only operation, etc.", "parameters": [], "output_columns": ["entity", "decision", "reason", "evidence"], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'dec_backlog_forecaster', session_id: '6a079b6bc1ea92432985ef54', name: 'dec_backlog_forecaster', label: 'Backlog Forecaster', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended burn-down projection. Pass backlog_kind ∈ {rf010, call_test_red, e911_not_ready, checkout_pending}. Returns weeks-to-burndown for any chosen backlog at the current run-rate.', nl_description: 'Open-ended burn-down projection. Pass backlog_kind ∈ {rf010, call_test_red, e911_not_ready, checkout_pending}. Returns weeks-to-burndown for any chosen backlog at the current run-rate.', nl_business_rule: 'Universal backlog burn-down projection across RF010 / call_test_red / e911_not_ready / checkout_pending backlogs. Returns weeks-to-burndown at the current run-rate; markets >8 weeks trigger ’accelerate’ decisions.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'dec_backlog_forecaster', kpi_name: 'Backlog Forecaster', kpi_description: 'Open-ended burn-down projection. Pass backlog_kind ∈ {rf010, call_test_red, e911_not_ready, checkout_pending}. Returns weeks-to-burndown for any chosen backlog at the current run-rate.', kpi_formula_description: 'Backlog Forecaster', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_backlog_forecaster(execute_query, filters=None):\n    """Universal backlog burn-down. `filters[\'backlog_kind\']` ∈\n    {\'rf010\',\'call_test_red\',\'e911_not_ready\',\'checkout_pending\'}; default \'rf010\'.\n    """\n    filt = dict(filters or {})\n    kind = filt.pop("backlog_kind", "rf010")\n    out = []\n\n    if kind == "rf010":\n        rates = get_rf010_completion_rate(execute_query, filt)\n        for r in rates:\n            total = r.get("total_tasks") or 0\n            done  = r.get("completed") or 0\n            pending = total - done\n            weekly_velocity = max(done / 12, 1)\n            weeks = pending / weekly_velocity if weekly_velocity else None\n            out.append({"entity": r.get("market"), "decision": "accelerate" if (weeks or 0) > 8 else "track",\n                        "reason": f"RF010 backlog burns down in {weeks:.1f} weeks" if weeks is not None else "Insufficient data",\n                        "evidence": {"kind": kind, "total": total, "completed": done, "pending": pending, "weekly_velocity": round(weekly_velocity, 1), "weeks_to_burndown": round(weeks, 1) if weeks else None}})\n    elif kind == "call_test_red":\n        rows = get_call_test_completion_rate(execute_query, filt)\n        for r in rows:\n            red = r.get("red") or 0\n            green = r.get("green") or 0\n            weekly_velocity = max(green / 12, 1)\n            weeks = red / weekly_velocity if weekly_velocity else None\n            out.append({"entity": r.get("market"), "decision": "accelerate" if (weeks or 0) > 8 else "track",\n                        "reason": f"Red WIP burns down in {weeks:.1f} weeks" if weeks else "—",\n                        "evidence": {"kind": kind, "red": red, "weekly_velocity": round(weekly_velocity, 1), "weeks_to_burndown": round(weeks, 1) if weeks else None}})\n    elif kind == "e911_not_ready":\n        rows = get_e911_readiness_index(execute_query, filt)\n        for r in rows:\n            total = r.get("total_sites") or 0\n            ready = r.get("ready_sites") or 0\n            pending = total - ready\n            weekly_velocity = max(ready / 12, 1)\n            weeks = pending / weekly_velocity if weekly_velocity else None\n            out.append({"entity": r.get("market"), "decision": "accelerate" if (weeks or 0) > 8 else "track",\n                        "reason": f"E911 NOT-READY burns down in {weeks:.1f} weeks" if weeks else "—",\n                        "evidence": {"kind": kind, "pending": pending, "weekly_velocity": round(weekly_velocity, 1)}})\n    elif kind == "checkout_pending":\n        rows = get_checkout_sla_compliance(execute_query, filt)\n        for r in rows:\n            total = r.get("total_checkouts") or 0\n            within = r.get("within_sla") or 0\n            pending = total - within\n            weekly_velocity = max(within / 12, 1)\n            weeks = pending / weekly_velocity if weekly_velocity else None\n            out.append({"entity": r.get("market"), "decision": "accelerate" if (weeks or 0) > 8 else "track",\n                        "reason": f"Checkout-SLA breach burns down in {weeks:.1f} weeks" if weeks else "—",\n                        "evidence": {"kind": kind, "pending": pending, "weekly_velocity": round(weekly_velocity, 1)}})\n    return out\n', kpi_relationship_type: 'DECIDES_BASED_ON', kpi_related_core_node_ids: ['rf010_task', 'e2e_call_test', 'e911_validation', 'nas_session'], kpi_related_kpi_ids: ['kpi_rf010_completion_rate', 'kpi_call_test_completion_rate', 'kpi_e911_readiness_index', 'kpi_checkout_sla_compliance'], kpi_decision_logic: '"Backlog Forecaster"', kpi_contract: '{"function_name": "evaluate_backlog_forecaster", "node_type": "decision", "node_id": "dec_backlog_forecaster", "node_label": "Backlog Forecaster", "description": "Open-ended burn-down projection. Pass backlog_kind \\u2208 {rf010, call_test_red, e911_not_ready, checkout_pending}. Returns weeks-to-burndown for any chosen backlog at the current run-rate.", "parameters": [], "output_columns": ["entity", "decision", "reason", "evidence"], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'dec_site_state_inspector', session_id: '6a079b6bc1ea92432985ef54', name: 'dec_site_state_inspector', label: 'Site State Inspector', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended site-state lookup. Filter by site_id or market and get current workflow stage (assigned / checked-in / checkout-pending / approved). Powers \'where is site X right now?\' type questions.', nl_description: 'Open-ended site-state lookup. Filter by site_id or market and get current workflow stage (assigned / checked-in / checkout-pending / approved). Powers \'where is site X right now?\' type questions.', nl_business_rule: 'Universal site-state lookup. For each filtered site, derives its current workflow stage (Phase 1 assigned / Phase 8 checked-in / Phase 8 checkout pending / Phase 11+ approved) from the presence/absence of session milestones.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'dec_site_state_inspector', kpi_name: 'Site State Inspector', kpi_description: 'Open-ended site-state lookup. Filter by site_id or market and get current workflow stage (assigned / checked-in / checkout-pending / approved). Powers \'where is site X right now?\' type questions.', kpi_formula_description: 'Site State Inspector', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_site_state_inspector(execute_query, filters=None):\n    """Universal site/session workflow-progression diagnoser.\n\n    Given filters (site_id or market scope), returns each site with its current\n    workflow stage derived from the presence/absence of phase milestones.\n    """\n    filt = dict(filters or {})\n    where, params = apply_filters("stg_nas_session_level_combined_data", filt,\n                                   time_column="nas_nest_start_time")\n    sites = execute_query(f"""\n        SELECT "nas_site_id" AS site_id, "nas_market" AS market, "nas_project_category" AS project_category,\n               MAX("nas_nest_start_time"::timestamp)         AS last_nest_start,\n               MAX("nas_checkout_time"::timestamp)            AS last_checkout,\n               MAX("nas_checkout_approve_time"::timestamp)    AS last_checkout_approve\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2, 3\n        LIMIT 500\n    """, params)\n    out = []\n    for s in sites:\n        if s.get("last_checkout_approve") is not None:\n            stage = "Phase 11+ (checkout approved)"\n            decision = "track"\n        elif s.get("last_checkout") is not None:\n            stage = "Phase 8 (checkout pending approval)"\n            decision = "monitor"\n        elif s.get("last_nest_start") is not None:\n            stage = "Phase 8 (checked-in, NEST window)"\n            decision = "monitor"\n        else:\n            stage = "Phase 1 (assigned, not started)"\n            decision = "monitor"\n        out.append({\n            "entity": s["site_id"],\n            "decision": decision,\n            "reason": f"Current stage: {stage}",\n            "evidence": {"market": s.get("market"), "project_category": s.get("project_category"),\n                         "last_nest_start": str(s.get("last_nest_start", "")), "last_checkout": str(s.get("last_checkout", "")), "last_checkout_approve": str(s.get("last_checkout_approve", ""))},\n        })\n    return out\n', kpi_relationship_type: 'DECIDES_BASED_ON', kpi_related_core_node_ids: ['site', 'nas_session', 'rf010_task'], kpi_related_kpi_ids: ['kpi_nas_session_count'], kpi_decision_logic: '"Site State Inspector"', kpi_contract: '{"function_name": "evaluate_site_state_inspector", "node_type": "decision", "node_id": "dec_site_state_inspector", "node_label": "Site State Inspector", "description": "Open-ended site-state lookup. Filter by site_id or market and get current workflow stage (assigned / checked-in / checkout-pending / approved). Powers \'where is site X right now?\' type questions.", "parameters": [], "output_columns": ["entity", "decision", "reason", "evidence"], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'dec_funnel_analyzer', session_id: '6a079b6bc1ea92432985ef54', name: 'dec_funnel_analyzer', label: 'Funnel Analyzer', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended pipeline funnel analysis. Returns per-market funnel (assigned → checkin → checkout → approval → on-air) with drop-off % at every stage — the universal tool for conversion / bottleneck questions.', nl_description: 'Open-ended pipeline funnel analysis. Returns per-market funnel (assigned → checkin → checkout → approval → on-air) with drop-off % at every stage — the universal tool for conversion / bottleneck questions.', nl_business_rule: 'Universal pipeline funnel analyzer: assigned → checked-in → checked-out → approved → on-air. Returns drop-off % at every stage per market — the canonical tool for conversion and bottleneck analysis across the 29-step workflow.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'dec_funnel_analyzer', kpi_name: 'Funnel Analyzer', kpi_description: 'Open-ended pipeline funnel analysis. Returns per-market funnel (assigned → checkin → checkout → approval → on-air) with drop-off % at every stage — the universal tool for conversion / bottleneck questions.', kpi_formula_description: 'Funnel Analyzer', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_funnel_analyzer(execute_query, filters=None):\n    """Universal pipeline funnel: assignment → check-in → checkout → integration → on-air.\n    Returns one row per market with stage counts + drop-off percentages.\n    """\n    filt = dict(filters or {})\n    # Stage 1: assigned sites\n    sites_where, sites_params = apply_filters("stg_nas_session_level_combined_data", filt)\n    stages = execute_query(f"""\n        SELECT\n            "nas_market" AS market,\n            COUNT(DISTINCT "nas_site_id") AS assigned_sites,\n            COUNT(DISTINCT "nas_site_id") FILTER (WHERE "nas_nest_start_time" IS NOT NULL) AS checked_in_sites,\n            COUNT(DISTINCT "nas_site_id") FILTER (WHERE "nas_checkout_time" IS NOT NULL) AS checked_out_sites,\n            COUNT(DISTINCT "nas_site_id") FILTER (WHERE "nas_checkout_approve_time" IS NOT NULL) AS approved_sites\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {sites_where}" if sites_where else ""}\n        GROUP BY 1\n        ORDER BY assigned_sites DESC NULLS LAST\n        LIMIT 50\n    """, sites_params)\n    # Stage 5: on-air sites by market from rf010\n    rf_where, rf_params = apply_filters("stg_nas_rf010_dashboard", filt)\n    on_air = execute_query(f"""\n        SELECT "market_id" AS market,\n               COUNT(*) FILTER (WHERE "mb_status" ILIKE \'Done\') AS on_air_sites\n        FROM {fq("stg_nas_rf010_dashboard")}\n        {f"WHERE {rf_where}" if rf_where else ""}\n        GROUP BY 1\n    """, rf_params)\n    on_air_lookup = {r["market"]: r["on_air_sites"] for r in on_air}\n    out = []\n    for s in stages:\n        a = s.get("assigned_sites") or 0\n        ci = s.get("checked_in_sites") or 0\n        co = s.get("checked_out_sites") or 0\n        ap = s.get("approved_sites") or 0\n        oa = on_air_lookup.get(s.get("market"), 0)\n        out.append({\n            "entity": s.get("market"),\n            "decision": "monitor" if a >= 5 else "ignore",\n            "reason": f"Funnel: {a} assigned → {ci} checked-in → {co} checked-out → {ap} approved → {oa} on-air",\n            "evidence": {\n                "assigned_sites": a, "checked_in_sites": ci, "checked_out_sites": co,\n                "approved_sites": ap, "on_air_sites": oa,\n                "drop_off_pct": {\n                    "assigned_to_checkin": round(100 * (a - ci) / a, 2) if a else 0,\n                    "checkin_to_checkout": round(100 * (ci - co) / ci, 2) if ci else 0,\n                    "checkout_to_approval": round(100 * (co - ap) / co, 2) if co else 0,\n                    "approval_to_on_air":  round(100 * (ap - oa) / ap, 2) if ap else 0,\n                }\n            }\n        })\n    return out\n', kpi_relationship_type: 'DECIDES_BASED_ON', kpi_related_core_node_ids: ['site', 'nas_session', 'rf010_task'], kpi_related_kpi_ids: ['kpi_nas_assignment_count', 'kpi_nas_session_count', 'kpi_rf010_completion_rate'], kpi_decision_logic: '"Funnel Analyzer"', kpi_contract: '{"function_name": "evaluate_funnel_analyzer", "node_type": "decision", "node_id": "dec_funnel_analyzer", "node_label": "Funnel Analyzer", "description": "Open-ended pipeline funnel analysis. Returns per-market funnel (assigned \\u2192 checkin \\u2192 checkout \\u2192 approval \\u2192 on-air) with drop-off % at every stage \\u2014 the universal tool for conversion / bottleneck questions.", "parameters": [], "output_columns": ["entity", "decision", "reason", "evidence"], "sample_output": [], "row_count": 0}'});

