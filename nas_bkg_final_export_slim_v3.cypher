ers = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_rf010_task(execute_query, filters=None):\n    """RF010 task lifecycle (post-integration health & on-air)."""\n    where, params = apply_filters(\n        "stg_nas_rf010_dashboard", filters, time_column="task_received_datetime"\n    )\n    sql = f"""\n        SELECT "id", "project_id", "project_site_id" AS site_id,\n               "region_id" AS region, "market_id" AS market,\n               "project_category",\n               "task_received_datetime"::timestamp  AS task_received,\n               "task_completed_datetime"::timestamp AS task_completed,\n               "activity_tracker_state" AS tracker_state, "mb_status" AS mb_status,\n               "on_hold_status" AS on_hold_status\n        FROM {fq("stg_nas_rf010_dashboard")}\n        {f"WHERE {where}" if where else ""}\n    """\n    return execute_query(sql, params)\n', filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "n