     if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_nest_snapshot(execute_query, filters=None):\n    """NEST DB current-state snapshots (per site × market)."""\n    where, params = apply_filters(\n        "stg_nas_nest_db_sp", filters, time_column="nas_local_time"\n    )\n    sql = f"""\n        SELECT "id", "nas_site_id" AS site_id, "nas_market" AS market,\n               "nas_current_state" AS current_state,\n               "nas_local_time"::timestamp AS local_time,\n               "nas_revert_on"::timestamp  AS revert_on\n        FROM {fq("stg_nas_nest_db_sp")}\n        {f"WHERE {where}" if where else ""}\n    """\n    return execute_query(sql, params)\n', filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_nest_snapshot", "node_type": "core", "node_id": "nest_snapshot", "node_label": "NEST DB Snapshot", "description": "Snapshot of NEST current state per site \\u00d7 market \\u2014 used to detect premature NEST exits.", "parameters": [