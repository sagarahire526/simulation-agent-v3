CREATE (:BKGNode {node_id: 'kpi_hop_validation_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_hop_validation_count', label: 'HOP Validation Count', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Count of RF010 tasks whose activity_tracker_state contains \'HOP\' — indicates Hand-Off Procedure validation activity (ACS-only sub-flow). Useful for tracking HOP workflow throughput.', nl_description: 'Count of RF010 tasks whose activity_tracker_state contains \'HOP\' — indicates Hand-Off Procedure validation activity (ACS-only sub-flow). Useful for tracking HOP workflow throughput.', nl_business_rule: 'HOP Validation Count measures how many RF010 tasks are in a Hand-Off Procedure validation step, reflecting throughput in this ACS-only workflow. It helps answer how much HOP validation activity is happening and where that work is concentrated. You can break it down by region and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_hop_validation_count', kpi_name: 'HOP Validation Count', kpi_description: 'Count of RF010 tasks whose activity_tracker_state contains \'HOP\' — indicates Hand-Off Procedure validation activity (ACS-only sub-flow). Useful for tracking HOP workflow throughput.', kpi_formula_description: 'COUNT(*) WHERE activity_tracker_state ILIKE \'%HOP%\'', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_hop_validation_count(execute_query, filters=None):\n    """KPI — HOP Validation Count (ACS-specific RF010 completions).\n\n    The findings catalog defines HOP Validation as an *ACS-specific* milestone\n    that follows the RF010 task lifecycle. Production data does NOT carry a\n    literal \'HOP\' token in any tracked column — neither in stg_nas_rf010_dashboard\n    nor anywhere else in the schema — so we proxy the metric the way the\n    catalog scoped it: completed RF010 tasks whose project_category is the\n    ACS family. ACS project categories in production: \'ACS DAS Venue\' (and any\n    other \'ACS …\' variant if introduced). Match via `ILIKE \'ACS%\'` so future\n    ACS-prefixed categories are picked up automatically.\n    """\n    where, params = apply_filters(\n        "stg_nas_rf010_dashboard", filters,\n        time_column="task_received_datetime",\n        extra_required=[\n            "\\"activity_tracker_state\\" ILIKE \'Completed\'",\n            "\\"project_category\\" ILIKE \'ACS%%\'",\n        ],\n    )\n    sql = f"""\n        SELECT\n            "region_id" AS region,\n            "market_id" AS market,\n            COUNT(*) AS hop_event_count,\n            COUNT(DISTINCT "project_site_id") AS hop_sites\n        FROM {fq("stg_nas_rf010_dashboard")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY hop_event_count DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['rf010_task'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_rf010_dashboard'], kpi_source_columns: ['activity_tracker_state', 'region_id', 'market_id', 'project_site_id'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"(1) Filter rf010 to rows where activity_tracker_state ILIKE \'%%HOP%%\'. (2) Group by region_id \\u00d7 market_id. (3) Return COUNT(*) and COUNT(DISTINCT project_site_id)."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_hop_validation_count", "node_type": "kpi", "node_id": "kpi_hop_validation_count", "node_label": "HOP Validation Count", "description": "Count of RF010 tasks whose activity_tracker_state contains \'HOP\' \\u2014 in