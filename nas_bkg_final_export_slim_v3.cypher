s or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_rejection_event(execute_query, filters=None):\n    """Rejection events of the last 30 days, including the free-text reason\n    columns. The reason fields answer "why was this check-in/check-out rejected?"\n    questions — the BKG previously exposed only IDs/timestamps, dropping the\n    richest data on this table.\n\n    Columns:\n      id, region, market, site_id, user_id, session_id,\n      request_time, rejection_time,\n      check_in_reject_reason, check_out_reject_reason  ← reason text\n    """\n    # Time filter anchored on rejection_time. We avoid nas_rej_requesttime\n    # because it is 100% NULL in production — any date filter on it would\n    # silently match zero rows.\n    where, params = apply_filters(\n        "stg_nas_rejection_data_last_30_days", filters,\n        time_column="nas_rej_rejection_time",\n    )\n    sql = f"""\n        SELECT "id", "nas_rej_region" AS region, "nas_rej_market" AS market,\n               "nas_rej_siteid" AS site_id,\n               "nas_rej_userid" AS user_id, 