lue in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_site(execute_query, filters=None):\n    """Site — canonical 1000-site list from stg_nas_session_level_combined_data.\n    Returns one row per distinct nas_site_id with its NAS-tracked market.\n    """\n    where, params = apply_filters("stg_nas_session_level_combined_data", filters)\n    sql = f"""\n        SELECT DISTINCT "nas_site_id" AS site_id, "nas_market" AS market,\n               "nas_project_category" AS project_category\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {where}" if where else ""}\n        ORDER BY site_id\n    """\n    return execute_query(sql, params)\n', filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"