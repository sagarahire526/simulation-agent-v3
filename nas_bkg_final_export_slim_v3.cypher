id_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_civil_construction_latency(execute_query, filters=None):\n    """KPI — Civil Construction Latency (ms_1551 actual_date)."""\n    where, params = apply_filters(\n        "stg_ndpd_mbt_tmobile_macro_combined", filters,\n        time_column="ms_1550_construction_start_actual",\n        extra_required=[\n            \'"ms_1550_construction_start_actual" IS NOT NULL\',\n            \'"ms_1551_civil_construction_complete_actual_date" IS NOT NULL\',\n            \'"ms_1551_civil_construction_complete_actual_date"::timestamp >= "ms_1550_construction_start_actual"::timestamp\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            "rgn_region" AS region,\n            "m_market" AS market,\n            COUNT(*) AS sites,\n            ROUND(AVG(EXTRACT(EPOCH FROM ("ms_1551_civil_construction_complete_actual_date"::timestamp - "ms_1550_construction_start_actual"::timestamp))/86400.0)::numeric, 2) AS avg_civil_latency_days,\n            ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("ms_1551_civil_construction_complete_actual_date"::timestamp - "ms_1550_construction_start_actual"::timestamp))/86400.0))::numeric, 2) AS p50_days,\n            ROUND((PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("ms_1551_civil_construction_complete_actual_date"::timestamp - "ms_1550_construction_start_actual"::timestamp))/86400.0))::numeric, 2) AS p95_days\n        FROM {fq("stg_ndpd_mbt_tmobile_macro_combined")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY avg_civil_latency_days DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['site', 'project', 'integration_milestone'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_ndpd_mbt_tmobile_macro_combined'], kpi_source_columns: ['s_site_id', 'ms_1550_construction_start_actual', 'ms_1551_civil_construction_complete_actual_date', 'rgn_region', 'm_market'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"(1) Restrict to rows where both ms_1550_construction_start_actual and ms_1551_civil_construction_complete_actual_date are NOT NULL and complete >= start. (2) days = EPOCH(complete - start)/86400. (3) Return AVG, p50, p95, COUNT grouped by rgn_region \\u00d7 m_market."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by area", "name": "area"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project id", "name": "project_id"}, {"type": "string", "description": "filter by site id", "name": "site_