.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_daily_dashboard(execute_query, filters=None):\n    """Daily operational rollup — region/market/site/session keyed."""\n    where, params = apply_filters(\n        "stg_tmo_nas_daily_dashboard", filters, time_column="checkin_latest_start_time"\n    )\n    sql = f"""\n        SELECT "id", "region", "market", "site_id", "session_id",\n               "project_category",\n               "activity_status", "current_layers_sector_status" AS layer_status,\n               "checkin_latest_start_time"::timestamp AS checkin_start_time,\n               "checkout_os"::timestamp               AS checkout_time\n        FROM {fq("stg_tmo_nas_daily_dashboard")}\n        {f"WHERE {where}" if where else ""}\n    """\n    return execute_query(sql, params)\n', filters: '[{"name": "region", "type": "string", "description": "filter by region", "required": false}, {"name": "area", "type": "string", "description": "filter by area", "req