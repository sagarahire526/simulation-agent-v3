d\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_gc(execute_query, filters=None):\n    """GC (General Contractor) — distinct primary GCs from session table with\n    session and site participation counts.\n    """\n    where, params = apply_filters("stg_nas_session_level_combined_data", filters)\n    sql = f"""\n        SELECT "nas_primary_gc" AS gc_name,\n               COUNT(DISTINCT "nas_session_id") AS session_count,\n               COUNT(DISTINCT "nas_site_id")    AS site_count\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {where}" if where else "WHERE 1=1"}\n          AND "nas_primary_gc" IS NOT NULL\n        GROUP BY "nas_primary_gc"\n        ORDER BY session_count DESC\n    """\n    return execute_query(sql, params)\n', filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_gc", "node_type": "core", "node_id": "gc", "node_label": "General Contractor", "description": "A general contractor (GC) participating in NAS sessions. Sourced from stg_nas_session_level_combined_data.nas_primary_gc with session and site participation counts.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'engineer', session_id: '6a079b6bc1ea92432985ef54', name: 'engineer', label: 'Engineer', node_type: 'CORE', entity_type: 'core', status: 'confirmed', definition: 'An engineer (Nokia / vendor) responsible for site delivery. Union of stg_nas_e911_readiness_riot_validation.nas_engineer and stg_nas_e2e_call_test_completion.nas_go_email_responsibility with combined site counts.', nl_description: 'An engineer (Nokia / vendor) responsible for site delivery. Union of stg_nas_e911_readiness_riot_validation.nas_engineer and stg_nas_e2e_call_test_completion.nas_go_email_responsibility with combined site counts.', nl_business_rule: 'An engineer is the Nokia or vendor person accountable for delivering telecom sites. This node helps answer who owns site delivery work, how many sites each engineer is responsible for, and where workload is concentrated. It can be analyzed by engineer, organization type such as Nokia versus vendor, and site counts.', is_skipped: false, skip_reason: '', map_table_name: 'stg_nas_e911_readiness_riot_validation', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'nas_engineer', map_label_column: 'nas_engineer', map_sql_template: 'UNION ALL of distinct nas_engineer (RIOT) and nas_go_email_responsibility (call test) with site_count per engineer.', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_engineer(execute_query, filters=None):\n    """Engineer — union of NAS engineers from RIOT validation\n    (nas_engineer) and call-test responsibility (nas_go_email_responsibility).\n    Returns distinct engineer name with site-coverage counts from both feeds.\n    """\n    e911_where, e911_params = apply_filters(\n        "stg_nas_e911_readiness_riot_validation", filters\n    )\n    call_where, call_params = apply_filters(\n        "stg_nas_e2e_call_test_completion", filters\n    )\n    # Namespace the params so the UNION doesn\'t see colliding placeholders.\n    e911_params_ns = {f"e911_{k}": v for k, v in e911_params.items()}\n    call_params_ns = {f"call_{k}": v for k, v in call_params.items()}\n    e911_where_ns = e911_where\n    for k in e911_params.keys():\n        e911_where_ns = e911_where_ns.replace(f"%({k})s", f"%(e911_{k})s")\n    call_where_ns = call_where\n    for k in call_params.keys():\n        call_where_ns = call_where_ns.replace(f"%({k})s", f"%(call_{k})s")\n\n    sql = f"""\n        SELECT engineer, SUM(site_count) AS site_count\n        FROM (\n            SELECT "nas_engineer" AS engineer,\n                   COUNT(DISTINCT "nas_site_id") AS site_count\n            FROM {fq("stg_nas_e911_readiness_riot_validation")}\n            {f"WHERE {e911_where_ns}" if e911_where_ns else "WHERE 1=1"}\n              AND "nas_engineer" IS NOT NULL\n            GROUP BY "nas_engineer"\n            UNION ALL\n            SELECT "nas_go_email_responsibility" AS engineer,\n                   COUNT(DISTINCT "nas_site_id") AS site_count\n            FROM {fq("stg_nas_e2e_call_test_completion")}\n            {f"WHERE {call_where_ns}" if call_where_ns else "WHERE 1=1"}\n              AND "nas_go_email_responsibility" IS NOT NULL\n            GROUP BY "nas_go_email_responsibility"\n        ) AS sub\n        GROUP BY engineer\n        ORDER BY site_count DESC NULLS LAST\n    """\n    merged = {**e911_params_ns, **call_params_ns}\n    return execute_query(sql, merged)\n', filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_engineer", "node_type": "core", "node_id": "engineer", "node_label": "Engineer", "description": "An engineer (Nokia / vendor) responsible for site delivery. Union of stg_nas_e911_readiness_riot_validation.nas_engineer and stg_nas_e2e_call_test_completion.nas_go_email_responsibility with combined site counts.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'psap', session_id: '6a079b6bc1ea92432985ef54', name: 'psap', label: 'PSAP', node_type: 'CORE', entity_type: 'core', status: 'confirmed', definition: 'A Public Safety Answering Point (PSAP) assigned via RIOT to one or more NAS sites. Joined with E2E call-test counts for the same site to expose call-test volume per PSAP.', nl_description: 'A Public Safety Answering Point (PSAP) assigned via RIOT to one or more NAS sites. Joined with E2E call-test counts for the same site to expose call-test volume per PSAP.', nl_business_rule: 'PSAP represents the public safety answering point associated with one or more NAS sites. It helps answer which emergency call centers are tied to sites and how much end-to-end call-test activity is flowing through each one. You can break it down by PSAP and NAS site, and compare call-test volume across locations.', is_skipped: false, skip_reason: '', map_table_name: 'stg_nas_e911_readiness_riot_validation', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'nas_psap_id', map_label_column: 'nas_psap_id', map_sql_template: 'SELECT distinct nas_psap_id and nas_psap_name with site_count and call_test_count from RIOT joined with E2E call test completion.', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_psap(execute_query, filters=None):\n    """PSAP (Public Safety Answering Point) — distinct PSAP IDs assigned to\n    sites via RIOT, with the count of distinct sites per PSAP and the count\n    of E2E call tests recorded against those sites.\n\n    Filters are applied to the RIOT (validation) table\u003B the call-test count\n    is taken via a scalar subquery aggregate keyed by site.\n    """\n    where, params = apply_filters("stg_nas_e911_readiness_riot_validation", filters)\n    sql = f"""\n        SELECT "nas_psap_id" AS psap_id,\n               "nas_psap_name" AS psap_name,\n               COUNT(DISTINCT "nas_site_id") AS site_count,\n               COALESCE(SUM(\n                   (SELECT COUNT(*)\n                    FROM {fq("stg_nas_e2e_call_test_completion")} c\n                    WHERE c."nas_site_id" = "stg_nas_e911_readiness_riot_validation"."nas_site_id")\n               ), 0) AS call_test_count\n        FROM {fq("stg_nas_e911_readiness_riot_validation")}\n        {f"WHERE {where}" if where else "WHERE 1=1"}\n          AND "nas_psap_id" IS NOT NULL\n        GROUP BY "nas_psap_id", "nas_psap_name"\n        ORDER BY site_count DESC\n    """\n    return execute_query(sql, params)\n', filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_psap", "node_type": "core", "node_id": "psap", "node_label": "PSAP", "description": "A Public Safety Answering Point (PSAP) assigned via RIOT to one or more NAS sites. Joined with E2E call-test counts for the same site to expose call-test volume per PSAP.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'project_category', session_id: '6a079b6bc1ea92432985ef54', name: 'project_category', label: 'Project Category', node_type: 'CORE', entity_type: 'core', status: 'confirmed', definition: 'A nas_project_category bucket (canonical values: Macro, Hardening, ACS DAS Venue, Param Audit (Nokia Only), Baseband Swap (non L4L), AHLOA-B Swap, Microwave, Special Projects, Small Cell). Returns distinct categories with their site and session counts for KPI filter targeting.', nl_description: 'A nas_project_category bucket (canonical values: Macro, Hardening, ACS DAS Venue, Param Audit (Nokia Only), Baseband Swap (non L4L), AHLOA-B Swap, Microwave, Special Projects, Small Cell). Returns distinct categories with their site and session counts for KPI filter targeting.', nl_business_rule: 'Project Category groups network work into business buckets such as Macro, Hardening, Microwave, Small Cell, and other project types. It helps answer which types of projects are driving site volume or NAS session activity, and supports KPI filter selection for targeted analysis. It can be broken down by project category, site counts, and session counts.', is_skipped: false, skip_reason: '', map_table_name: 'stg_nas_session_level_combined_data', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'nas_project_category', map_label_column: 'nas_project_category', map_sql_template: 'SELECT distinct nas_project_category with site_count and session_count from stg_nas_session_level_combined_data where nas_project_category IS NOT NULL.', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_project_category(execute_query, filters=None):\n    """Project Category — distinct nas_project_category values with their\n    site counts. Functionally similar to `project` but enumerated as its own\n    Core for cleaner KPI filter targeting.\n    """\n    where, params = apply_filters("stg_nas_session_level_combined_data", filters)\n    sql = f"""\n        SELECT "nas_project_category" AS project_category,\n               COUNT(DISTINCT "nas_site_id")    AS site_count,\n               COUNT(DISTINCT "nas_session_id") AS session_count\n        FROM {fq("stg_nas_session_level_combined_data")}\n        {f"WHERE {where}" if where else "WHERE 1=1"}\n          AND "nas_project_category" IS NOT NULL\n        GROUP BY "nas_project_category"\n        ORDER BY site_count DESC\n    """\n    return execute_query(sql, params)\n', filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_project_category", "node_type": "core", "node_id": "project_category", "node_label": "Project Category", "description": "A nas_project_category bucket (canonical values: Macro, Hardening, ACS DAS Venue, Param Audit (Nokia Only), Baseband Swap (non L4L), AHLOA-B Swap, Microwave, Special Projects, Small Cell). Returns distinct categories with their site and session counts for KPI filter targeting.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'layer', session_id: '6a079b6bc1ea92432985ef54', name: 'layer', label: 'Network Layer', node_type: 'CORE', entity_type: 'core', status: 'confirmed', definition: 'A distinct RF / network layer (e.g. g1900, l600, n2500) referenced in the comma-separated nas_nsi_outage_layers text field across NAS sessions. One row per layer with the count of sessions and sites that mentioned it.', nl_description: 'A distinct RF / network layer (e.g. g1900, l600, n2500) referenced in the comma-separated nas_nsi_outage_layers text field across NAS sessions. One row per layer with the count of sessions and sites that mentioned it.', nl_business_rule: 'Network Layer represents a specific radio or network layer referenced in NAS session outage records, such as a particular frequency band or technology layer. It helps answer which layers are most often associated with outages and how broadly each layer affects sessions or sites. You can break it down by layer name and compare impact using session counts versus site counts.', is_skipped: false, skip_reason: '', map_table_name: 'stg_nas_session_level_combined_data', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'layer_name', map_label_column: 'layer_name', map_sql_template: 'Expand nas_nsi_outage_layers (CSV text) via regexp_split_to_table, then SELECT distinct layer with session_count and site_count.', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_layer(execute_query, filters=None):\n    """Layer — distinct RF/network layers referenced in nas_nsi_outage_layers\n    (comma-separated text). Each row in the source table can name multiple\n    layers\u003B this function expands them into one row per layer with the count\n    of sessions that mentioned that layer in an NSI outage.\n    """\n    where, params = apply_filters("stg_nas_session_level_combined_data", filters)\n    sql = f"""\n        SELECT TRIM(layer) AS layer_name,\n               COUNT(DISTINCT "nas_session_id") AS session_count,\n               COUNT(DISTINCT "nas_site_id")    AS site_count\n        FROM {fq("stg_nas_session_level_combined_data")}\n        CROSS JOIN LATERAL regexp_split_to_table(\n                       COALESCE("nas_nsi_outage_layers", \'\'), \',\'\n                   ) AS layer\n        {f"WHERE {where}" if where else "WHERE 1=1"}\n          AND "nas_nsi_outage_layers" IS NOT NULL\n          AND TRIM(layer) <> \'\'\n        GROUP BY TRIM(layer)\n        ORDER BY session_count DESC\n    """\n    return execute_query(sql, params)\n', filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_layer", "node_type": "core", "node_id": "layer", "node_label": "Network Layer", "description": "A distinct RF / network layer (e.g. g1900, l600, n2500) referenced in the comma-separated nas_nsi_outage_layers text field across NAS sessions. One row per layer with the count of sessions and sites that mentioned it.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'integration_milestone', session_id: '6a079b6bc1ea92432985ef54', name: 'integration_milestone', label: 'Integration Milestone', node_type: 'CORE', entity_type: 'core', status: 'confirmed', definition: 'A static reference list of the three Magenta-MBT construction-completion milestones tracked downstream of NAS: ms_1551 (civil construction complete), ms_1555 (construction complete), ms_15550 (GC construction complete). Returned in Python (no SQL).', nl_description: 'A static reference list of the three Magenta-MBT construction-completion milestones tracked downstream of NAS: ms_1551 (civil construction complete), ms_1555 (construction complete), ms_15550 (GC construction complete). Returned in Python (no SQL).', nl_business_rule: 'Integration Milestone represents the standard construction-completion checkpoints used to track progress after NAS in the Magenta-MBT process. It helps answer which completion stage a project or site has reached and supports reporting on downstream delivery status. Results are typically viewed by milestone type, project, and site or geography.', is_skipped: false, skip_reason: '', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'milestone_id', map_label_column: 'milestone_name', map_sql_template: 'Hard-coded list[dict] returned in Python\u003B references actual_date_column names in stg_ndpd_mbt_tmobile_macro_combined.', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n# ─────────── end inlined prelude ───────────\n\ndef get_integration_milestone(execute_query, filters=None):\n    """Integration Milestone — static reference list of the three Magenta-MBT\n    construction-completion milestones tracked downstream of NAS:\n\n      - ms_1551 — civil construction complete\n      - ms_1555 — construction complete (BTS / tower)\n      - ms_15550 — GC construction complete\n\n    Returned as a hard-coded list (no SQL). This node is a static reference\n    so KPI/Decision functions can join activity rows back to the milestone\n    they represent. Filters parameter is ignored.\n    """\n    return [\n        {\n            "milestone_id": "ms_1551",\n            "milestone_name": "Civil Construction Complete",\n            "actual_date_column": "ms_1551_civil_construction_complete_actual_date",\n            "phase": "Construction",\n        },\n        {\n            "milestone_id": "ms_1555",\n            "milestone_name": "Construction Complete",\n            "actual_date_column": "ms_1555_construction_complete_actual",\n            "phase": "Construction",\n        },\n        {\n            "milestone_id": "ms_15550",\n            "milestone_name": "GC Construction Complete",\n            "actual_date_column": "ms_15550_gc_construction_complete_actual",\n            "phase": "Construction",\n        },\n    ]\n', filters: '[{"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_integration_milestone", "node_type": "core", "node_id": "integration_milestone", "node_label": "Integration Milestone", "description": "A static reference list of the three Magenta-MBT construction-completion milestones tracked downstream of NAS: ms_1551 (civil construction complete), ms_1555 (construction complete), ms_15550 (GC construction complete). Returned in Python (no SQL).", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'e911_consolidation_check', session_id: '6a079b6bc1ea92432985ef54', name: 'e911_consolidation_check', label: 'E911 Consolidation Check', node_type: 'CORE', entity_type: 'core', status: 'confirmed', definition: 'Per-site E911 consolidation outcome (composite of nas_site_id + nas_consolidation_check_all_layers result) with the count of layer-level RIOT validation rows and the latest validation timestamp.', nl_description: 'Per-site E911 consolidation outcome (composite of nas_site_id + nas_consolidation_check_all_layers result) with the count of layer-level RIOT validation rows and the latest validation timestamp.', nl_business_rule: 'E911 Consolidation Check shows each site’s overall E911 consolidation status, combining the site-level outcome with supporting validation activity. It helps answer which sites have passed or failed consolidation checks, how much validation evidence exists, and when the latest validation occurred. You can break it down by site, consolidation result, and recency of validation.', is_skipped: false, skip_reason: '', map_table_name: 'stg_nas_e911_readiness_riot_validation', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'nas_site_id', map_label_column: 'nas_site_id', map_sql_template: 'GROUP BY nas_site_id, nas_consolidation_check_all_layers, nas_validate_e911_readiness, nas_market, nas_region, nas_engineer with layer_check_count and last_validation.', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_e911_consolidation_check(execute_query, filters=None):\n    """E911 Consolidation Check — per-site consolidation result (PASS / FAIL /\n    UNKNOWN) with a layer-by-layer breakdown count of RIOT validation entries.\n    Composite identity: (nas_site_id, consolidation outcome).\n    """\n    where, params = apply_filters(\n        "stg_nas_e911_readiness_riot_validation", filters,\n        time_column="nas_e911_validation_date",\n    )\n    sql = f"""\n        SELECT "nas_site_id" AS site_id,\n               "nas_consolidation_check_all_layers" AS consolidation_status,\n               "nas_validate_e911_readiness"        AS e911_readiness,\n               "nas_market" AS market,\n               "nas_region" AS region,\n               "nas_engineer" AS engineer,\n               COUNT(*) AS layer_check_count,\n               MAX("nas_e911_validation_date"::timestamp) AS last_validation\n        FROM {fq("stg_nas_e911_readiness_riot_validation")}\n        {f"WHERE {where}" if where else "WHERE 1=1"}\n          AND "nas_site_id" IS NOT NULL\n        GROUP BY "nas_site_id",\n                 "nas_consolidation_check_all_layers",\n                 "nas_validate_e911_readiness",\n                 "nas_market", "nas_region", "nas_engineer"\n        ORDER BY site_id\n    """\n    return execute_query(sql, params)\n', filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_e911_consolidation_check", "node_type": "core", "node_id": "e911_consolidation_check", "node_label": "E911 Consolidation Check", "description": "Per-site E911 consolidation outcome (composite of nas_site_id + nas_consolidation_check_all_layers result) with the count of layer-level RIOT validation rows and the latest validation timestamp.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'escalation', session_id: '6a079b6bc1ea92432985ef54', name: 'escalation', label: 'Escalation', node_type: 'CORE', entity_type: 'core', status: 'confirmed', definition: 'Derived per-site escalation list. Three union branches: (a) RF010 turnaround > 240 min, (b) E2E call test RED for > 7 days post-integration, (c) rejection count > 3 in 30 days. Composite identity (source, site_id). No source table — computed from rf010, call-test, and rejection feeds.', nl_description: 'Derived per-site escalation list. Three union branches: (a) RF010 turnaround > 240 min, (b) E2E call test RED for > 7 days post-integration, (c) rejection count > 3 in 30 days. Composite identity (source, site_id). No source table — computed from rf010, call-test, and rejection feeds.', nl_business_rule: 'Escalation represents sites that need management attention because they breach key operational thresholds after integration. It helps answer which sites are at risk, why they were escalated, and where follow-up is most urgent. You can analyze it by escalation reason, source, and site.', is_skipped: false, skip_reason: '', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'site_id', map_label_column: 'site_id', map_sql_template: 'UNION ALL of three derived branches against stg_nas_rf010_dashboard, stg_nas_e2e_call_test_completion, and stg_nas_rejection_data_last_30_days.', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_escalation(execute_query, filters=None):\n    """Escalation — derived per-site escalation list. Three derivation rules\n    are unioned (no separate source table exists for escalations):\n\n      (a) RF010 task turnaround > 240 minutes\n            source = \'rf010_long_tat\'\n      (b) E2E call test still RED for > 7 days after integration\n            source = \'call_test_red_aged\'\n      (c) Rejection count for a site > 3 within 30 days\n            source = \'rejection_streak\'\n\n    Composite identity: (source, site_id).\n    """\n    rf010_where, rf010_params = apply_filters(\n        "stg_nas_rf010_dashboard", filters,\n        time_column="task_received_datetime",\n    )\n    call_where, call_params = apply_filters(\n        "stg_nas_e2e_call_test_completion", filters,\n        time_column="nas_integration_date",\n    )\n    rej_where, rej_params = apply_filters(\n        "stg_nas_rejection_data_last_30_days", filters,\n        time_column="nas_rej_requesttime",\n    )\n    # Namespace each branch\'s params to avoid placeholder collisions.\n    rf010_ns = {f"rf010_{k}": v for k, v in rf010_params.items()}\n    call_ns = {f"call_{k}": v for k, v in call_params.items()}\n    rej_ns = {f"rej_{k}": v for k, v in rej_params.items()}\n    for k in rf010_params:\n        rf010_where = rf010_where.replace(f"%({k})s", f"%(rf010_{k})s")\n    for k in call_params:\n        call_where = call_where.replace(f"%({k})s", f"%(call_{k})s")\n    for k in rej_params:\n        rej_where = rej_where.replace(f"%({k})s", f"%(rej_{k})s")\n\n    sql = f"""\n        SELECT \'rf010_long_tat\' AS source,\n               "project_site_id" AS site_id,\n               EXTRACT(EPOCH FROM ("task_completed_datetime"::timestamp\n                                  - "task_received_datetime"::timestamp))/60.0\n                    AS turnaround_minutes,\n               "task_received_datetime"::timestamp  AS event_time,\n               NULL::text AS detail\n        FROM {fq("stg_nas_rf010_dashboard")}\n        {f"WHERE {rf010_where}" if rf010_where else "WHERE 1=1"}\n          AND "task_received_datetime" IS NOT NULL\n          AND "task_completed_datetime" IS NOT NULL\n          AND EXTRACT(EPOCH FROM ("task_completed_datetime"::timestamp\n                                 - "task_received_datetime"::timestamp))/60.0 > 240\n\n        UNION ALL\n\n        SELECT \'call_test_red_aged\' AS source,\n               "nas_site_id" AS site_id,\n               NULL::numeric AS turnaround_minutes,\n               "nas_integration_date"::timestamp AS event_time,\n               "nas_call_test_completion_status" AS detail\n        FROM {fq("stg_nas_e2e_call_test_completion")}\n        {f"WHERE {call_where}" if call_where else "WHERE 1=1"}\n          AND "nas_call_test_completion_status" ILIKE \'%%RED%%\'\n          AND "nas_integration_date" IS NOT NULL\n          AND ("nas_integration_date"::timestamp) < (CURRENT_DATE - 7)\n\n        UNION ALL\n\n        SELECT \'rejection_streak\' AS source,\n               "nas_rej_siteid" AS site_id,\n               COUNT(*)::numeric AS turnaround_minutes,\n               MAX("nas_rej_requesttime"::timestamp) AS event_time,\n               \'rejection_count_30d\' AS detail\n        FROM {fq("stg_nas_rejection_data_last_30_days")}\n        {f"WHERE {rej_where}" if rej_where else "WHERE 1=1"}\n          AND "nas_rej_siteid" IS NOT NULL\n        GROUP BY "nas_rej_siteid"\n        HAVING COUNT(*) > 3\n    """\n    merged = {**rf010_ns, **call_ns, **rej_ns}\n    return execute_query(sql, merged)\n', filters: '[{"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', map_contract: '{"function_name": "get_escalation", "node_type": "core", "node_id": "escalation", "node_label": "Escalation", "description": "Derived per-site escalation list. Three union branches: (a) RF010 turnaround > 240 min, (b) E2E call test RED for > 7 days post-integration, (c) rejection count > 3 in 30 days. Composite identity (source, site_id). No source table \\u2014 computed from rf010, call-test, and rejection feeds.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'planned_outage', session_id: '6a079b6bc1ea92432985ef54', name: 'planned_outage', label: 'Planned Outage', node_type: 'CORE', entity_type: 'transaction', status: 'confirmed', definition: 'Planned maintenance windows (work-order grain). Captures blast radius via co-located / wm-connected site references.', nl_description: 'Planned maintenance windows (work-order grain). Captures blast radius via co-located / wm-connected site references.', nl_business_rule: 'Planned Outage represents scheduled maintenance work orders and the expected service impact of each outage. It helps answer questions about what maintenance is planned, which sites may be affected, and the likely blast radius of a work order. It can be analyzed by work order, maintenance window timing, and affected or connected sites.', is_skipped: false, skip_reason: '', map_table_name: 'stg_nas_planned_outage_activity', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'nas_workorder_id', map_label_column: 'nas_workorder_id', map_sql_template: 'SELECT "id", "nas_workorder_id", "nas_site_id", "nas_market", "nas_project_category", "nas_status", "nas_request_time"::timestamp AS request_time, "nas_activity_start_date"::timestamp AS activity_start, "nas_activity_end_date"::timestamp AS activity_end FROM "pwc_macro_staging_schema"."stg_nas_planned_outage_activity"', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_planned_outage(execute_query, filters=None):\n    """Planned outage activity (work-order grain)."""\n    where, params = apply_filters(\n        "stg_nas_planned_outage_activity", filters, time_column="nas_request_time"\n    )\n    sql = f"""\n        SELECT "id", "nas_workorder_id" AS workorder_id, "nas_site_id" AS site_id,\n               "nas_market" AS market, "nas_project_category" AS project_category,\n               "nas_status" AS status,\n               "nas_request_time"::timestamp        AS request_time,\n               "nas_activity_start_date"::timestamp AS activity_start,\n               "nas_activity_end_date"::timestamp   AS activity_end\n        FROM {fq("stg_nas_planned_outage_activity")}\n        {f"WHERE {where}" if where else ""}\n    """\n    return execute_query(sql, params)\n', filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by 