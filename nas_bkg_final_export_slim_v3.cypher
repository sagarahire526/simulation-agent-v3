CREATE (:BKGNode {node_id: 'nas_session', session_id: '6a079b6bc1ea92432985ef54', name: 'nas_session', label: 'NAS Session', node_type: 'CORE', entity_type: 'transaction', status: 'confirmed', definition: 'A NAS work session including check-in, NEST window, checkout request and approval. The fact table for SLA computation.', nl_description: 'A NAS work session including check-in, NEST window, checkout request and approval. The fact table for SLA computation.', nl_business_rule: 'A NAS Session represents one complete NAS work session, from check-in through the NEST window to checkout request and approval. It helps answer questions about session volumes, turnaround times, and SLA performance across the end-to-end process. You can analyze it by site, date or time period, and session status or approval stage.', is_skipped: false, skip_reason: '', map_table_name: 'stg_nas_session_level_combined_data', map_database_name: 'pwc_macro_staging_schema', map_key_column: 'nas_session_id', map_label_column: 'nas_session_id', map_sql_template: 'SELECT "nas_session_id", "nas_site_id", "nas_market", "nas_project_category", "nas_primary_gc", "nas_nest_start_time"::timestamp AS nest_start_time, "nas_checkout_time"::timestamp AS checkout_time, "nas_checkout_approve_time"::timestamp AS checkout_approve_time, "nas_checkout_reject_time"::timestamp AS checkout_reject_time FROM "pwc_macro_staging_schema"."stg_nas_session_level_combined_data"', map_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_nas_session(execute_query, filters=None):\n    """NAS Session — one row per session with key timestamps + reject reasons.\n\n    Also exposes the free-text reason columns so "why was this session rejected?"\n    questions can be answered without joining to rejection_event:\n      • checkout_reject_reason   — explicit checkout rejection text\n      • nest_rejection_notes     — operator-entered NEST rejection notes\n    """\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters, time_column="nas_nest_start_time"\n    )\n    sql = f"""\n        SELECT "nas_session_id" AS session_id, "nas_site_id" AS site_id,\n               "nas_market" AS market, "nas_project_category" AS project_category,\n               "nas_primary_gc" AS primary_gc,\n               "nas_nest_start_time"::timestamp     AS nest_start_time,\n               "nas_chec