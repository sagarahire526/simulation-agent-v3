'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\nDERIVED_REGION_SQL = \'\\nCASE\\n  WHEN LOWER("nas_market") IN (\\\'seattle\\\',\\\'phoenix\\\',\\\'spokane\\\',\\\'montana\\\',\\\'portland\\\') THEN \\\'West\\\'\\n  WHEN LOWER("nas_market") IN (\\\'atlanta\\\',\\\'austin\\\',\\\'dallas\\\',\\\'bhm-mem\\\',\\\'mobile\\\',\\\'puertorico\\\',\\\'houston\\\') THEN \\\'South\\\'\\n  WHEN LOWER("nas_market") IN (\\\'chicago\\\',\\\'milwaukee\\\',\\\'detroit\\\',\\\'minneapolis\\\',\\\'denver\\\',\\\'dakotas\\\',\\\'omaha\\\',\\\'des moines\\\',\\\'oklahoma\\\',\\\'kansascity\\\',\\\'arkansas\\\',\\\'indianapolis\\\',\\\'wichita\\\',\\\'tulsa\\\',\\\'stlouis\\\',\\\'columbus\\\',\\\'cleveland\\\',\\\'nashville\\\',\\\'louisville\\\',\\\'knoxville\\\',\\\'westvirginia\\\',\\\'cincinnati\\\',\\\'pittsburgh\\\') THEN \\\'Central\\\'\\n  ELSE NULL\\nEND\\n\'\n# ─────────── end inlined prelude ───────────\n\ndef get_check_in_sla_compliance(execute_query, filters=None):\n    """KPI — Check-in SLA Compliance Rate (15 min SLA from KPI catalog)."""\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_nest_start_time",\n        extra_required=[\n            \'"nas_nest_start_time" IS NOT NULL\',\n            \'"nas_nest_start_time_requested" IS NOT NULL\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            {DERIVED_REGION_SQL} AS region,\n            "nas_market" AS market,\n            COUNT(*) AS total_checkins,\n            COUNT(*) FILTER (\n                WHERE EXTRACT(EPOCH FROM ("nas_nest_start_time"::timestamp - "nas_nest_start_time_requested"::timestamp))/60.0 <= 15\n            ) AS within_sla,\n            ROUND(100.0 * COUNT(*) FILTER (\n                WHERE EXTRACT(EPOCH FROM ("nas_nest_start_time"::timestamp - "nas_nest_start_time_requested"::timestamp))/60.0 <= 15\n            ) / NULLIF(COUNT(*), 0), 2) AS sla_compliance_pct\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY sla_compliance_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'site'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_nest_start_time', 'nas_nest_start_time_requested', 'nas_market'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"(1) Restrict to rows where both nas_nest_start_time_requested AND nas_nest_start_time are NOT NULL. (2) delta_min = EPOCH(nest_start - requested) / 60. (3) Total = COUNT(*)\u003B WithinSLA = COUNT FILTER (delta_min <= 15). (4) Return 100 * WithinSLA / Total grouped by derived_region \\u00d7 market."', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_check_in_sla_compliance", "node_type": "kpi", "node_id": "kpi_check_in_sla_compliance", "node_label": "Check-in SLA Compliance Rate", "description": "Percentage of NAS check-ins whose elapsed time between requested check-in (nas_nest_start_time_requested) and actual check-in (nas_nest_start_time) is at or below the 15-minute SLA. Both timestamps must be present. Threshold from KPI catalog.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_avg_check_in_time', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_avg_check_in_time', label: 'Average Check-in Time', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Average, median (p50), and 95th-percentile elapsed time in minutes between requested check-in and actual check-in across all NAS sessions. Indicates centrally-trended GC promptness with tail risk.', nl_description: 'Average, median (p50), and 95th-percentile elapsed time in minutes between requested check-in and actual check-in across all NAS sessions. Indicates centrally-trended GC promptness with tail risk.', nl_business_rule: 'Average Check-in Time measures how long, in minutes, it takes on average for NAS sessions to start after the requested check-in time, including typical performance and late-start risk. It helps answer whether check-ins are happening promptly and where delays are most severe. It can be analyzed by region and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_avg_check_in_time', kpi_name: 'Average Check-in Time', kpi_description: 'Average, median (p50), and 95th-percentile elapsed time in minutes between requested check-in and actual check-in across all NAS sessions. Indicates centrally-trended GC promptness with tail risk.', kpi_formula_description: 'AVG / PCT 0.5 / PCT 0.95 of (nas_nest_start_time - nas_nest_start_time_requested) in minutes', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\nDERIVED_REGION_SQL = \'\\nCASE\\n  WHEN LOWER("nas_market") IN (\\\'seattle\\\',\\\'phoenix\\\',\\\'spokane\\\',\\\'montana\\\',\\\'portland\\\') THEN \\\'West\\\'\\n  WHEN LOWER("nas_market") IN (\\\'atlanta\\\',\\\'austin\\\',\\\'dallas\\\',\\\'bhm-mem\\\',\\\'mobile\\\',\\\'puertorico\\\',\\\'houston\\\') THEN \\\'South\\\'\\n  WHEN LOWER("nas_market") IN (\\\'chicago\\\',\\\'milwaukee\\\',\\\'detroit\\\',\\\'minneapolis\\\',\\\'denver\\\',\\\'dakotas\\\',\\\'omaha\\\',\\\'des moines\\\',\\\'oklahoma\\\',\\\'kansascity\\\',\\\'arkansas\\\',\\\'indianapolis\\\',\\\'wichita\\\',\\\'tulsa\\\',\\\'stlouis\\\',\\\'columbus\\\',\\\'cleveland\\\',\\\'nashville\\\',\\\'louisville\\\',\\\'knoxville\\\',\\\'westvirginia\\\',\\\'cincinnati\\\',\\\'pittsburgh\\\') THEN \\\'Central\\\'\\n  ELSE NULL\\nEND\\n\'\n# ─────────── end inlined prelude ───────────\n\ndef get_avg_check_in_time(execute_query, filters=None):\n    """KPI — Average Check-in Time: avg/p50/p95 minutes from request to actual start."""\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_nest_start_time",\n        extra_required=[\n            \'"nas_nest_start_time" IS NOT NULL\',\n            \'"nas_nest_start_time_requested" IS NOT NULL\',\n            \'"nas_nest_start_time"::timestamp >= "nas_nest_start_time_requested"::timestamp\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            {DERIVED_REGION_SQL} AS region,\n            "nas_market" AS market,\n            COUNT(*) AS sessions,\n            ROUND(AVG(EXTRACT(EPOCH FROM ("nas_nest_start_time"::timestamp - "nas_nest_start_time_requested"::timestamp))/60.0)::numeric, 2) AS avg_check_in_minutes,\n            ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("nas_nest_start_time"::timestamp - "nas_nest_start_time_requested"::timestamp))/60.0))::numeric, 2) AS p50_minutes,\n            ROUND((PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("nas_nest_start_time"::timestamp - "nas_nest_start_time_requested"::timestamp))/60.0))::numeric, 2) AS p95_minutes,\n            ROUND(AVG(CASE\n                WHEN "nas_sla_sla_nest" ~ \'^[0-9]+(\\\\.[0-9]+)?$\'\n                THEN "nas_sla_sla_nest"::numeric ELSE NULL\n            END)::numeric, 2) AS avg_checkin_sla_minutes\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY avg_check_in_minutes DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_nest_start_time', 'nas_nest_start_time_requested', 'nas_market'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"(1) Restrict to rows where both nas_nest_start_time_requested AND nas_nest_start_time are NOT NULL and the actual is at or after the requested time. (2) Compute delta_min = EPOCH(actual - requested) / 60. (3) Return AVG, p50, p95, and COUNT grouped by derived_region \\u00d7 market."', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_avg_check_in_time", "node_type": "kpi", "node_id": "kpi_avg_check_in_time", "node_label": "Average Check-in Time", "description": "Average, median (p50), and 95th-percentile elapsed time in minutes between requested check-in and actual check-in across all NAS sessions. Indicates centrally-trended GC promptness with tail risk.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_avg_check_out_time', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_avg_check_out_time', label: 'Average Check-out Time', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Average, median, and 95th-percentile minutes between checkout request and checkout approval across all NAS sessions. Indicates centrally-trended NAS-side approval latency.', nl_description: 'Average, median, and 95th-percentile minutes between checkout request and checkout approval across all NAS sessions. Indicates centrally-trended NAS-side approval latency.', nl_business_rule: 'Average Check-out Time measures how long NAS sessions typically take from a checkout request to checkout approval, using average, median, and 95th-percentile minutes. It helps answer whether approval latency is improving, where delays are occurring, and how severe long-tail wait times are. You can analyze it by region and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_avg_check_out_time', kpi_name: 'Average Check-out Time', kpi_description: 'Average, median, and 95th-percentile minutes between checkout request and checkout approval across all NAS sessions. Indicates centrally-trended NAS-side approval latency.', kpi_formula_description: 'AVG / PCT 0.5 / PCT 0.95 of (nas_checkout_approve_time - nas_checkout_time) in minutes', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\nDERIVED_REGION_SQL = \'\\nCASE\\n  WHEN LOWER("nas_market") IN (\\\'seattle\\\',\\\'phoenix\\\',\\\'spokane\\\',\\\'montana\\\',\\\'portland\\\') THEN \\\'West\\\'\\n  WHEN LOWER("nas_market") IN (\\\'atlanta\\\',\\\'austin\\\',\\\'dallas\\\',\\\'bhm-mem\\\',\\\'mobile\\\',\\\'puertorico\\\',\\\'houston\\\') THEN \\\'South\\\'\\n  WHEN LOWER("nas_market") IN (\\\'chicago\\\',\\\'milwaukee\\\',\\\'detroit\\\',\\\'minneapolis\\\',\\\'denver\\\',\\\'dakotas\\\',\\\'omaha\\\',\\\'des moines\\\',\\\'oklahoma\\\',\\\'kansascity\\\',\\\'arkansas\\\',\\\'indianapolis\\\',\\\'wichita\\\',\\\'tulsa\\\',\\\'stlouis\\\',\\\'columbus\\\',\\\'cleveland\\\',\\\'nashville\\\',\\\'louisville\\\',\\\'knoxville\\\',\\\'westvirginia\\\',\\\'cincinnati\\\',\\\'pittsburgh\\\') THEN \\\'Central\\\'\\n  ELSE NULL\\nEND\\n\'\n# ─────────── end inlined prelude ───────────\n\ndef get_avg_check_out_time(execute_query, filters=None):\n    """KPI — Average Check-out Time: avg/p50/p95 minutes from checkout request to approval.\n\n    Includes both formulations:\n      - avg_check_out_minutes  : derived from timestamps (nas_checkout_approve_time − nas_checkout_time)\n      - avg_checkout_sla_minutes : direct mean of nas_sla_sla_checkout (canonical SLA column from catalog KPI #32)\n    """\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_checkout_time",\n        extra_required=[\n            \'"nas_checkout_time" IS NOT NULL\',\n            \'"nas_checkout_approve_time" IS NOT NULL\',\n            \'"nas_checkout_approve_time"::timestamp >= "nas_checkout_time"::timestamp\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            {DERIVED_REGION_SQL} AS region,\n            "nas_market" AS market,\n            COUNT(*) AS sessions,\n            ROUND(AVG(EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_checkout_time"::timestamp))/60.0)::numeric, 2) AS avg_check_out_minutes,\n            ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_checkout_time"::timestamp))/60.0))::numeric, 2) AS p50_minutes,\n            ROUND((PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_checkout_time"::timestamp))/60.0))::numeric, 2) AS p95_minutes,\n            ROUND(AVG(CASE\n                WHEN "nas_sla_sla_checkout" ~ \'^[0-9]+(\\\\.[0-9]+)?$\'\n                THEN "nas_sla_sla_checkout"::numeric ELSE NULL\n            END)::numeric, 2) AS avg_checkout_sla_minutes\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY avg_check_out_minutes DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_checkout_time', 'nas_checkout_approve_time', 'nas_market'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"(1) Restrict to rows where both nas_checkout_time AND nas_checkout_approve_time are NOT NULL and approve_time >= checkout_time. (2) Compute delta_min = EPOCH(approve - checkout) / 60. (3) Return AVG, p50, p95, COUNT grouped by derived_region \\u00d7 market."', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_avg_check_out_time", "node_type": "kpi", "node_id": "kpi_avg_check_out_time", "node_label": "Average Check-out Time", "description": "Average, median, and 95th-percentile minutes between checkout request and checkout approval across all NAS sessions. Indicates centrally-trended NAS-side approval latency.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_check_in_rejection_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_check_in_rejection_count', label: 'Check-in Rejection Count', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Raw count of NAS log events whose nas_event_type starts with \'Nest Rejected\' — i.e., check-in attempts that NAS rejected. Complements kpi_rejection_rate (which returns percentages)\u003B this returns absolute counts useful for backlog/queue dashboards.', nl_description: 'Raw count of NAS log events whose nas_event_type starts with \'Nest Rejected\' — i.e., check-in attempts that NAS rejected. Complements kpi_rejection_rate (which returns percentages)\u003B this returns absolute counts useful for backlog/queue dashboards.', nl_business_rule: 'Check-in Rejection Count measures the total number of check-in attempts that were rejected by NAS. It helps answer how many rejections occurred in a period and where operational backlogs or queue issues may be building. You can break it down by region, market, and GC.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_check_in_rejection_count', kpi_name: 'Check-in Rejection Count', kpi_description: 'Raw count of NAS log events whose nas_event_type starts with \'Nest Rejected\' — i.e., check-in attempts that NAS rejected. Complements kpi_rejection_rate (which returns percentages)\u003B this returns absolute counts useful for backlog/queue dashboards.', kpi_formula_description: 'COUNT(*) WHERE nas_event_type ILIKE \'Nest Rejected%\'', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_check_in_rejection_count(execute_query, filters=None):\n    """KPI — Check-in Rejection Count (raw, by region/market/gc)."""\n    import re\n    log_where, log_params = apply_filters(\n        "stg_nas_log_data", filters, time_column="nas_event_time",\n        extra_required=["l.\\"nas_event_type\\" ILIKE \'Nest Rejected%%\'"],\n    )\n    # Prefix every "nas_*" identifier with the log_data alias to disambiguate the JOIN.\n    log_where = re.sub(r\'(?<![\\w.])"nas_\\w+"\', lambda m: \'l.\' + m.group(), log_where)\n    sql = f"""\n        SELECT\n            l."nas_region" AS region,\n            l."nas_market" AS market,\n            sess."nas_primary_gc" AS gc_name,\n            COUNT(*) AS check_in_rejection_count\n        FROM {fq("stg_nas_log_data")} l\n        LEFT JOIN {fq("stg_nas_session_level_combined_data")} sess\n               ON sess."nas_session_id" = l."nas_session_id"\n        WHERE {log_where}\n        GROUP BY 1, 2, 3\n        ORDER BY check_in_rejection_count DESC NULLS LAST\n    """\n    return execute_query(sql, log_params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_log_event', 'rejection_event', 'gc'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_log_data'], kpi_source_columns: ['nas_event_type', 'nas_region', 'nas_market', 'nas_session_id'], kpi_dimensions: ['region', 'market', 'gc_name'], kpi_business_logic: '"(1) Filter nas_log_data to nas_event_type ILIKE \'Nest Rejected%\'. (2) LEFT JOIN session-level table to bring in nas_primary_gc (gc_name). (3) Group by nas_region \\u00d7 nas_market \\u00d7 gc_name. (4) Return COUNT(*)."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_check_in_rejection_count", "node_type": "kpi", "node_id": "kpi_check_in_rejection_count", "node_label": "Check-in Rejection Count", "description": "Raw count of NAS log events whose nas_event_type starts with \'Nest Rejected\' \\u2014 i.e., check-in attempts that NAS rejected. Complements kpi_rejection_rate (which returns percentages)\u003B this returns absolute counts useful for backlog/queue dashboards.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_checkout_rejection_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_checkout_rejection_count', label: 'Check-out Rejection Count by Engineer & Month', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Raw count of NAS log events whose nas_event_type starts with \'Conditional Approval-Rejected\' — i.e., checkout attempts that NAS rejected. Broken out by engineer (nas_user_id) and event-month so monthly per-engineer workload questions are answerable directly.', nl_description: 'Raw count of NAS log events whose nas_event_type starts with \'Conditional Approval-Rejected\' — i.e., checkout attempts that NAS rejected. Broken out by engineer (nas_user_id) and event-month so monthly per-engineer workload questions are answerable directly.', nl_business_rule: 'This metric tracks how many checkout attempts were rejected in NAS, shown as a monthly count for each engineer. It helps answer questions about rejection workload, trends over time, and which engineers or areas are seeing the most rejected checkouts. You can break it down by engineer, month, and geography such as region, market, or GC.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_checkout_rejection_count', kpi_name: 'Check-out Rejection Count by Engineer & Month', kpi_description: 'Raw count of NAS log events whose nas_event_type starts with \'Conditional Approval-Rejected\' — i.e., checkout attempts that NAS rejected. Broken out by engineer (nas_user_id) and event-month so monthly per-engineer workload questions are answerable directly.', kpi_formula_description: 'COUNT(*) WHERE nas_event_type ILIKE \'Conditional Approval-Rejected%\' GROUP BY region, market, gc, engineer, month', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_checkout_rejection_count(execute_query, filters=None):\n    """KPI — Checkout Rejection Count, broken out by engineer (nas_user_id) and month.\n\n    Ground-truth shape from semantic_question_bank.csv: ``GROUP BY nas_user_id, month``.\n    We retain region/market/gc for traditional dimensional drilldown.\n    Filterable by ``engineer`` (canonical key → nas_user_id) via TABLE_FILTER_MAPPING.\n    """\n    import re\n    log_where, log_params = apply_filters(\n        "stg_nas_log_data", filters, time_column="nas_event_time",\n        extra_required=["l.\\"nas_event_type\\" ILIKE \'Conditional Approval-Rejected%%\'"],\n    )\n    log_where = re.sub(r\'(?<![\\w.])"nas_\\w+"\', lambda m: \'l.\' + m.group(), log_where)\n    sql = f"""\n        SELECT\n            l."nas_region" AS region,\n            l."nas_market" AS market,\n            sess."nas_primary_gc" AS gc_name,\n            l."nas_user_id" AS engineer,\n            TO_CHAR(DATE_TRUNC(\'month\', l."nas_event_time"::date), \'Mon\'\'YY\') AS month,\n            COUNT(*) AS checkout_rejection_count\n        FROM {fq("stg_nas_log_data")} l\n        LEFT JOIN {fq("stg_nas_session_level_combined_data")} sess\n               ON sess."nas_session_id" = l."nas_session_id"\n        WHERE {log_where}\n        GROUP BY 1, 2, 3, 4, 5\n        ORDER BY checkout_rejection_count DESC NULLS LAST\n    """\n    return execute_query(sql, log_params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_log_event', 'rejection_event', 'gc', 'engineer'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_log_data'], kpi_source_columns: ['nas_event_type', 'nas_region', 'nas_market', 'nas_session_id', 'nas_user_id', 'nas_event_time'], kpi_dimensions: ['region', 'market', 'gc_name', 'engineer', 'month'], kpi_business_logic: '"(1) Filter nas_log_data to nas_event_type ILIKE \'Conditional Approval-Rejected%\'. (2) LEFT JOIN session-level table for nas_primary_gc. (3) Group by region \\u00d7 market \\u00d7 gc \\u00d7 engineer (nas_user_id) \\u00d7 month (TO_CHAR DATE_TRUNC month). (4) Return COUNT(*)."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_checkout_rejection_count", "node_type": "kpi", "node_id": "kpi_checkout_rejection_count", "node_label": "Check-out Rejection Count by Engineer & Month", "description": "Raw count of NAS log events whose nas_event_type starts with \'Conditional Approval-Rejected\' \\u2014 i.e., checkout attempts that NAS rejected. Broken out by engineer (nas_user_id) and event-month so monthly per-engineer workload questions are answerable directly.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_total_rejection_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_total_rejection_count', label: 'Total NAS Rejection Count', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Combined raw count of both check-in and check-out NAS rejection events with a side-by-side breakdown column for each type. Provides a single-number rollup of NAS rejection volume per region/market/gc.', nl_description: 'Combined raw count of both check-in and check-out NAS rejection events with a side-by-side breakdown column for each type. Provides a single-number rollup of NAS rejection volume per region/market/gc.', nl_business_rule: 'Total NAS Rejection Count measures the combined number of NAS check-in and check-out rejections for a business area. It helps answer where rejection volume is highest and how much of it comes from check-in versus check-out activity. You can break it down by region, market, and GC.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_total_rejection_count', kpi_name: 'Total NAS Rejection Count', kpi_description: 'Combined raw count of both check-in and check-out NAS rejection events with a side-by-side breakdown column for each type. Provides a single-number rollup of NAS rejection volume per region/market/gc.', kpi_formula_description: 'COUNT(check_in_rejection) + COUNT(checkout_rejection) per region/market/gc', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_total_rejection_count(execute_query, filters=None):\n    """KPI — Total NAS Rejection Count with breakdown."""\n    import re\n    log_where, log_params = apply_filters(\n        "stg_nas_log_data", filters, time_column="nas_event_time",\n    )\n    log_where = re.sub(r\'(?<![\\w.])"nas_\\w+"\', lambda m: \'l.\' + m.group(), log_where)\n    sql = f"""\n        SELECT\n            l."nas_region" AS region,\n            l."nas_market" AS market,\n            sess."nas_primary_gc" AS gc_name,\n            COUNT(*) FILTER (WHERE l."nas_event_type" ILIKE \'Nest Rejected%%\') AS check_in_rejections,\n            COUNT(*) FILTER (WHERE l."nas_event_type" ILIKE \'Conditional Approval-Rejected%%\') AS checkout_rejections,\n            COUNT(*) FILTER (WHERE l."nas_event_type" ILIKE \'Nest Rejected%%\'\n                              OR l."nas_event_type" ILIKE \'Conditional Approval-Rejected%%\') AS total_rejections\n        FROM {fq("stg_nas_log_data")} l\n        LEFT JOIN {fq("stg_nas_session_level_combined_data")} sess\n               ON sess."nas_session_id" = l."nas_session_id"\n        {f"WHERE {log_where}" if log_where else ""}\n        GROUP BY 1, 2, 3\n        HAVING COUNT(*) FILTER (WHERE l."nas_event_type" ILIKE \'Nest Rejected%%\'\n                                  OR l."nas_event_type" ILIKE \'Conditional Approval-Rejected%%\') > 0\n        ORDER BY total_rejections DESC NULLS LAST\n    """\n    return execute_query(sql, log_params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_log_event', 'rejection_event', 'gc'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_log_data'], kpi_source_columns: ['nas_event_type', 'nas_region', 'nas_market', 'nas_session_id'], kpi_dimensions: ['region', 'market', 'gc_name'], kpi_business_logic: '"(1) Read nas_log_data joined to session-level for nas_primary_gc. (2) Compute count_filter for each event_type pattern. (3) Sum both into total_rejections. (4) Group by region \\u00d7 market \\u00d7 gc_name."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_total_rejection_count", "node_type": "kpi", "node_id": "kpi_total_rejection_count", "node_label": "Total NAS Rejection Count", "description": "Combined raw count of both check-in and check-out NAS rejection events with a side-by-side breakdown column for each type. Provides a single-number rollup of NAS rejection volume per region/market/gc.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_ftr_checkout_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_ftr_checkout_rate', label: 'First-Time-Right Checkout Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Percentage of NAS sessions that completed their checkout cleanly the first time within 24 hours of check-in AND without requiring a NEST extension. A \'first-time-right\' session is one whose checkout was approved (nas_checkout_approve_time present), happened within 1440 minutes of the nest start, and has NO matching extension row.', nl_description: 'Percentage of NAS sessions that completed their checkout cleanly the first time within 24 hours of check-in AND without requiring a NEST extension. A \'first-time-right\' session is one whose checkout was approved (nas_checkout_approve_time present), happened within 1440 minutes of the nest start, and has NO matching extension row.', nl_business_rule: 'First-Time-Right Checkout Rate measures the share of NAS sessions that complete checkout successfully on the first attempt within 24 hours of check-in, without needing a NEST extension. It helps answer how often checkout works cleanly end to end and where avoidable friction or rework is occurring. You can analyze it by region, market, and GC.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_ftr_checkout_rate', kpi_name: 'First-Time-Right Checkout Rate', kpi_description: 'Percentage of NAS sessions that completed their checkout cleanly the first time within 24 hours of check-in AND without requiring a NEST extension. A \'first-time-right\' session is one whose checkout was approved (nas_checkout_approve_time present), happened within 1440 minutes of the nest start, and has NO matching extension row.', kpi_formula_description: '100 * COUNT FILTER (approve <= 1440 min from start AND no extension) / COUNT total sessions', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\nDERIVED_REGION_SQL = \'\\nCASE\\n  WHEN LOWER("nas_market") IN (\\\'seattle\\\',\\\'phoenix\\\',\\\'spokane\\\',\\\'montana\\\',\\\'portland\\\') THEN \\\'West\\\'\\n  WHEN LOWER("nas_market") IN (\\\'atlanta\\\',\\\'austin\\\',\\\'dallas\\\',\\\'bhm-mem\\\',\\\'mobile\\\',\\\'puertorico\\\',\\\'houston\\\') THEN \\\'South\\\'\\n  WHEN LOWER("nas_market") IN (\\\'chicago\\\',\\\'milwaukee\\\',\\\'detroit\\\',\\\'minneapolis\\\',\\\'denver\\\',\\\'dakotas\\\',\\\'omaha\\\',\\\'des moines\\\',\\\'oklahoma\\\',\\\'kansascity\\\',\\\'arkansas\\\',\\\'indianapolis\\\',\\\'wichita\\\',\\\'tulsa\\\',\\\'stlouis\\\',\\\'columbus\\\',\\\'cleveland\\\',\\\'nashville\\\',\\\'louisville\\\',\\\'knoxville\\\',\\\'westvirginia\\\',\\\'cincinnati\\\',\\\'pittsburgh\\\') THEN \\\'Central\\\'\\n  ELSE NULL\\nEND\\n\'\n# ─────────── end inlined prelude ───────────\n\ndef get_ftr_checkout_rate(execute_query, filters=None):\n    """KPI — First-Time-Right Checkout Rate: single approval within 24h, no extension."""\n    sess_where, sess_params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_nest_start_time",\n        extra_required=[\'"nas_nest_start_time" IS NOT NULL\'],\n    )\n    sql = f"""\n        SELECT\n            {DERIVED_REGION_SQL.replace(\'"nas_market"\', \'sess."nas_market"\')} AS region,\n            sess."nas_market" AS market,\n            sess."nas_primary_gc" AS gc_name,\n            COUNT(DISTINCT sess."nas_session_id") AS total_sessions,\n            COUNT(DISTINCT sess."nas_session_id") FILTER (\n                WHERE sess."nas_checkout_approve_time" IS NOT NULL\n                  AND EXTRACT(EPOCH FROM (sess."nas_checkout_approve_time"::timestamp - sess."nas_nest_start_time"::timestamp))/60.0 <= 1440\n                  AND ext."nas_session_id" IS NULL\n            ) AS ftr_sessions,\n            ROUND(100.0 * COUNT(DISTINCT sess."nas_session_id") FILTER (\n                WHERE sess."nas_checkout_approve_time" IS NOT NULL\n                  AND EXTRACT(EPOCH FROM (sess."nas_checkout_approve_time"::timestamp - sess."nas_nest_start_time"::timestamp))/60.0 <= 1440\n                  AND ext."nas_session_id" IS NULL\n            ) / NULLIF(COUNT(DISTINCT sess."nas_session_id"), 0), 2) AS ftr_rate_pct\n        FROM {fq("stg_nas_session_level_combined_data")} sess\n        LEFT JOIN (\n            SELECT DISTINCT "nas_session_id"\n            FROM {fq("stg_nas_nest_ext_raw_by_session")}\n            WHERE "nas_session_id" IS NOT NULL\n        ) ext ON ext."nas_session_id" = sess."nas_session_id"\n        WHERE {sess_where}\n        GROUP BY 1, 2, 3\n        ORDER BY ftr_rate_pct DESC NULLS LAST\n    """\n    return execute_query(sql, sess_params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'nest_extension', 'gc'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data', 'stg_nas_nest_ext_raw_by_session'], kpi_source_columns: ['nas_session_id', 'nas_nest_start_time', 'nas_checkout_approve_time', 'nas_market', 'nas_primary_gc'], kpi_dimensions: ['region', 'market', 'gc_name'], kpi_business_logic: '"(1) Start with sessions where nas_nest_start_time IS NOT NULL. (2) LEFT JOIN extension table on nas_session_id. (3) Compute total_sessions = COUNT(DISTINCT session). (4) ftr_sessions = COUNT(DISTINCT session) FILTER (checkout_approve IS NOT NULL AND EPOCH(approve - start)/60 <= 1440 AND ext.nas_session_id IS NULL). (5) Return 100 * ftr/total grouped by derived_region \\u00d7 market \\u00d7 gc_name."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_ftr_checkout_rate", "node_type": "kpi", "node_id": "kpi_ftr_checkout_rate", "node_label": "First-Time-Right Checkout Rate", "description": "Percentage of NAS sessions that completed their checkout cleanly the first time within 24 hours of check-in AND without requiring a NEST extension. A \'first-time-right\' session is one whose checkout was approved (nas_checkout_approve_time present), happened within 1440 minutes of the nest start, and has NO matching extension row.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_gc_activity_turnaround', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_gc_activity_turnaround', label: 'GC Activity Turnaround Time', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Average hours between nas_nest_start_time and nas_checkout_approve_time per Primary GC. Captures end-to-end on-site GC duration including any wait time for NAS approval. Lower is better.', nl_description: 'Average hours between nas_nest_start_time and nas_checkout_approve_time per Primary GC. Captures end-to-end on-site GC duration including any wait time for NAS approval. Lower is better.', nl_business_rule: 'GC Activity Turnaround Time measures the average number of hours a GC spends from starting on site to final checkout approval, including any approval wait time. It helps answer which GCs are completing work faster or slower and where turnaround delays are occurring. It can be compared by GC and by market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_gc_activity_turnaround', kpi_name: 'GC Activity Turnaround Time', kpi_description: 'Average hours between nas_nest_start_time and nas_checkout_approve_time per Primary GC. Captures end-to-end on-site GC duration including any wait time for NAS approval. Lower is better.', kpi_formula_description: 'AVG((nas_checkout_approve_time - nas_nest_start_time) in hours) grouped by nas_primary_gc', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_gc_activity_turnaround(execute_query, filters=None):\n    """KPI — GC Activity Turnaround Time: avg hours from nest start to checkout approve, per GC."""\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_nest_start_time",\n        extra_required=[\n            \'"nas_nest_start_time" IS NOT NULL\',\n            \'"nas_checkout_approve_time" IS NOT NULL\',\n            \'"nas_primary_gc" IS NOT NULL\',\n            \'"nas_checkout_approve_time"::timestamp >= "nas_nest_start_time"::timestamp\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            "nas_primary_gc" AS gc_name,\n            "nas_market" AS market,\n            COUNT(*) AS sessions,\n            ROUND(AVG(EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_nest_start_time"::timestamp))/3600.0)::numeric, 2) AS avg_turnaround_hours,\n            ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_nest_start_time"::timestamp))/3600.0))::numeric, 2) AS p50_hours,\n            ROUND((PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM ("nas_checkout_approve_time"::timestamp - "nas_nest_start_time"::timestamp))/3600.0))::numeric, 2) AS p95_hours\n        FROM {fq("stg_nas_session_level_combined_data")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY avg_turnaround_hours DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'gc'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_session_level_combined_data'], kpi_source_columns: ['nas_nest_start_time', 'nas_checkout_approve_time', 'nas_primary_gc', 'nas_market'], kpi_dimensions: ['gc_name', 'market'], kpi_business_logic: '"(1) Restrict to rows where nas_nest_start_time and nas_checkout_approve_time are both NOT NULL, primary_gc IS NOT NULL, and approve >= start. (2) Compute hours = EPOCH(approve - start)/3600. (3) Return AVG, p50, p95, COUNT grouped by nas_primary_gc \\u00d7 nas_market. (4) Sort by avg hours descending (longest GC turnarounds first)."', kpi_filters: '[{"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by General Contractor", "name": "gc_name"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "string", "description": "filter by NAS session id", "name": "session_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_gc_activity_turnaround", "node_type": "kpi", "node_id": "kpi_gc_activity_turnaround", "node_label": "GC Activity Turnaround Time", "description": "Average hours between nas_nest_start_time and nas_checkout_approve_time per Primary GC. Captures end-to-end on-site GC duration including any wait time for NAS approval. Lower is better.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_intp_completion_rate', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_intp_completion_rate', label: 'iNTP Workflow Completion Rate', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Percentage of INTP-assigned sites whose E911 readiness has progressed all the way to \'Ready_Completed\' (or equivalent \'Ready ... Complete\' text variants). Indicates iNTP workflow throughput.', nl_description: 'Percentage of INTP-assigned sites whose E911 readiness has progressed all the way to \'Ready_Completed\' (or equivalent \'Ready ... Complete\' text variants). Indicates iNTP workflow throughput.', nl_business_rule: 'iNTP Workflow Completion Rate measures the share of iNTP-assigned sites that have fully reached E911 readiness completion. It answers how effectively the iNTP workflow is moving sites through to a completed ready state and where throughput may be lagging. It can be analyzed by region and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_intp_completion_rate', kpi_name: 'iNTP Workflow Completion Rate', kpi_description: 'Percentage of INTP-assigned sites whose E911 readiness has progressed all the way to \'Ready_Completed\' (or equivalent \'Ready ... Complete\' text variants). Indicates iNTP workflow throughput.', kpi_formula_description: '100 * COUNT(nas_validate_e911_readiness ILIKE \'Ready%Complete%\') / COUNT(*)', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_intp_completion_rate(execute_query, filters=None):\n    """KPI — iNTP Workflow Completion Rate."""\n    where, params = apply_filters(\n        "stg_nas_e911_readiness_riot_validation", filters,\n        time_column="nas_e911_validation_date",\n    )\n    sql = f"""\n        SELECT\n            "nas_region" AS region,\n            "nas_market" AS market,\n            COUNT(DISTINCT "nas_site_id") AS total_sites,\n            COUNT(DISTINCT "nas_site_id") FILTER (\n                WHERE "nas_validate_e911_readiness" ILIKE \'Ready%%Complete%%\'\n            ) AS completed_sites,\n            ROUND(100.0 * COUNT(DISTINCT "nas_site_id") FILTER (\n                WHERE "nas_validate_e911_readiness" ILIKE \'Ready%%Complete%%\'\n            ) / NULLIF(COUNT(DISTINCT "nas_site_id"), 0), 2) AS completion_rate_pct\n        FROM {fq("stg_nas_e911_readiness_riot_validation")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2\n        ORDER BY completion_rate_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e911_validation', 'site', 'integration_milestone'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_e911_readiness_riot_validation'], kpi_source_columns: ['nas_site_id', 'nas_validate_e911_readiness', 'nas_market'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"(1) Read all e911_readiness rows. (2) total = COUNT(DISTINCT nas_site_id). (3) completed = COUNT(DISTINCT nas_site_id) FILTER (nas_validate_e911_readiness ILIKE \'Ready%Complete%\'). (4) Return 100 * completed/total grouped by nas_region \\u00d7 nas_market."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_intp_completion_rate", "node_type": "kpi", "node_id": "kpi_intp_completion_rate", "node_label": "iNTP Workflow Completion Rate", "description": "Percentage of INTP-assigned sites whose E911 readiness has progressed all the way to \'Ready_Completed\' (or equivalent \'Ready ... Complete\' text variants). Indicates iNTP workflow throughput.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_consolidation_sites_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_consolidation_sites_count', label: 'Consolidation Sites Count', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Count of sites whose nas_consolidation_check_all_layers field indicates a positive (Pass) consolidation result across all layers — meaning the site has been validated as ready for consolidation/cutover.', nl_description: 'Count of sites whose nas_consolidation_check_all_layers field indicates a positive (Pass) consolidation result across all layers — meaning the site has been validated as ready for consolidation/cutover.', nl_business_rule: 'Consolidation Sites Count measures how many sites have passed the full consolidation check and are confirmed ready for consolidation or cutover. It helps answer how many sites are deployment-ready and where consolidation readiness is strongest or lagging. You can break it down by region and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_consolidation_sites_count', kpi_name: 'Consolidation Sites Count', kpi_description: 'Count of sites whose nas_consolidation_check_all_layers field indicates a positive (Pass) consolidation result across all layers — meaning the site has been validated as ready for consolidation/cutover.', kpi_formula_description: 'COUNT(DISTINCT site WHERE nas_consolidation_check_all_layers ILIKE \'Pass%\')', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\', \'engineer\': \'nas_user_id\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        # Case-insensitive equality on both sides — robust to mixed-case data.\n        where.append(f\'LOWER("{col}"::text) = LOWER(%({canonical})s::text)\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n# ─────────── end inlined prelude ───────────\n\ndef get_consolidation_sites_count(execute_query, filters=None):\n    """KPI — Consolidation Sites Count (no-duplicate consolidation across all layers).\n\n    Production data stores the consolidation outcome as free text:\n      \'No Duplicates found\'           (passed, ~40k rows)\n      \'L1900 ABG Duplicates found …\'   (failed, sub-typed by layer)\n      \'LTE TAC Mismatch\' / etc.        (other anomalies)\n    The "pass" predicate is therefore `ILIKE \'No Duplicate%\'` (covers both\n    \'No Duplicates found\' and the typo \'No Duplicatest found\').\n    """\n    where, params = apply_filters(\n        "stg_nas_e911_readiness_riot_validation", filters,\n        time_column="nas_e911_validation_date",\n        extra_required=["\\"nas_consolidation_check_all_layers\\" ILIKE \'No Duplicate%%\'"],\n    )\n    sql = f"""\n        SELECT\n            "nas_region" AS region,\n            "nas_market" AS market,\n            COUNT(DISTINCT "nas_site_id") AS consolidation_pass_sites\n        FROM {fq("stg_nas_e911_readiness_riot_validation")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY consolidation_pass_sites DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e911_validation', 'site', 'e911_consolidation_check'], kpi_related_kpi_ids: [], kpi_source_tables: ['stg_nas_e911_readiness_riot_validation'], kpi_source_columns: ['nas_site_id', 'nas_consolidation_check_all_layers', 'nas_region', 'nas_market'], kpi_dimensions: ['region', 'market'], kpi_business_logic: '"(1) Read e911_readiness rows. (2) Restrict to rows where nas_consolidation_check_all_layers ILIKE \'Pass%\'. (3) Return COUNT(DISTINCT nas_site_id) grouped by nas_region \\u00d7 nas_market. (4) Total row also computed by summing."', kpi_filters: '[{"type": "string", "description": "filter by NAS region (West / Central / South)", "name": "region"}, {"type": "string", "description": "filter by NAS market", "name": "market"}, {"type": "string", "description": "filter by responsible engineer", "name": "engineer"}, {"type": "string", "description": "filter by project category", "name": "project_category", "sample_values": ["Macro", "Hardening", "ACS DAS Venue", "Param Audit (Nokia Only)", "Baseband Swap (non L4L)", "AHLOA-B Swap", "Microwave", "Special Projects", "Small Cell"]}, {"type": "string", "description": "filter by site id", "name": "site_id"}, {"type": "date", "description": "start of time range (inclusive)", "name": "start_date"}, {"type": "date", "description": "end of time range (exclusive)", "name": "end_date"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_consolidation_sites_count", "node_type": "kpi", "node_id": "kpi_consolidation_sites_count", "node_label": "Consolidation Sites Count", "description": "Count of sites whose nas_consolidation_check_all_layers field indicates a positive (Pass) consolidation result across all layers \\u2014 meaning the site has been validated as ready for consolidation/cutover.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_e911_ready_count', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_e911_ready_count', label: 'E911 Ready Count', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Count of distinct sites whose nas_validate_e911_readiness is exactly \'Ready\' (not \'Ready_Completed\') — these are sites that have passed E911 readiness but the workflow has not yet been formally closed/completed.', nl_description: 'Count of distinct sites whose nas_validate_e911_readiness is exactly \'Ready\' (not \'Ready_Completed\') — these are sites that have passed E911 readiness but the workflow has not yet been formally closed/completed.', nl_business_rule: 'E911 Ready Count measures how many distinct sites have passed E911 readiness and are currently marked Ready, but are not yet formally completed. It helps answer how many sites are ready for the next step and where E911 workflow closure is still pending. You can break it down by region and market.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_e911_ready_count', kpi_name: 'E911 Ready Count', kpi_description: 'Count of distinct sites whose nas_validate_e911_readiness is exactly \'Ready\' (not \'Ready_Completed\') — these are sites that have passed E911 readiness but the workflow has not yet been formally closed/completed.', kpi_formula_description: 'COUNT(DISTINCT site WHERE nas_validate_e911_readiness ILIKE \'Ready\')', kpi_python_function: '# ─────────── inlined prelude (selective) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_se