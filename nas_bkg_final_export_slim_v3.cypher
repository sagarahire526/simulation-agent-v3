timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_call_test_red_wip(execute_query, filters=None):\n    """KPI 10 — count of sites currently RED in call test, by engineer × market."""\n    where, params = apply_filters(\n        "stg_nas_e2e_call_test_completion", filters,\n        time_column="nas_integration_date",\n        extra_required=["\\"nas_call_test_completion_status\\" ILIKE \'RED\'"],\n    )\n    sql = f"""\n        SELECT\n            "nas_market" AS market,\n            "nas_go_email_responsibility" AS engineer,\n            COUNT(*) AS red_wip_sites\n        FROM {fq("stg_nas_e2e_call_test_completion")}\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY red_wip_sites DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['e2e_call_test'], kpi_source_tables: ['stg_nas_e2e_call_test_completion'], kpi_source_columns: ['nas_call_test_completion_status', 'nas_go_email_responsibility', 'nas_market'], kpi_dimensions: ['market', 'engineer'], kpi_business_logic: '"COUNT(*) WHERE nas_call_test_completion_status ILIKE ’RED’"', kpi_filters: '[{"name": "region", "type": "string", "description": "filter by NAS region"}, {"name": "area", "type": "string", "description": "filter by area"}, {"name": "market", "type": "string", "description": "filter by NAS market"}, {"name