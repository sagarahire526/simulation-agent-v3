"end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_nest_snapshot(execute_query, filters=None):\n    """NEST DB current-state snapshots (per site × market)."""\n    where, params = apply_filters(\n        "stg_nas_nest_db_sp", filters, time_column="nas_local_time"\n    )\n    sql = f"""\n        SELECT "id", "nas_site_id" AS site_id, "nas_market" AS market,\n               "nas_current_state" AS current_state,\n               "nas_local_time"::timestamp AS local_time,\n               "nas_revert_on"::timestamp  AS revert_on\n        FROM {fq("stg_nas_nest_db_sp")}\n        {f"WHERE {where}" if where else ""}\n    """\n    return execute_query(sql, params)\n', filters: '[{"name": "region", "type": "string", "description": "filter by region", "required": false}, {"name": "area", "type": "string", "description": "filter by area", "required": false}, {"name": "market", "type": "string", "description": "filter by market", "required": false}, {"name": "gc_name", "type": "string", "description": "filter by GC name", "required": false}, {"name": "site_id", "type": "string", "description": "filter by site id", "required": false}, {"name": "session_id", "type": "stri