" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_rf010_completion_rate(execute_query, filters=None):\n    """KPI 11 — % RF010 tasks with activity_tracker_state=\'Completed\', by market."""\n    where, params = apply_filters(\n        "stg_nas_rf010_dashboard", filters,\n        time_column="task_received_datetime",\n    )\n    sql = f"""\n        SELECT\n            "market_id" AS market,\n            "project_category" AS project_category,\n            COUNT(*) AS total_tasks,\n            COUNT(*) FILTER (WHERE "activity_tracker_state" ILIKE \'Completed\') AS completed,\n            ROUND(100.0 * COUNT(*) FILTER (WHERE "activity_tracker_state" ILIKE \'Completed\')\n                  / NULLIF(COUNT(*), 0), 2) AS completion_pct,\n            COUNT(*) FILTER (WHERE "mb_status" ILIKE \'Done\') AS on_air_sites\n        FROM {fq("stg_nas_rf010_dashboard")}\n        {f"WHERE {where}" if where else ""}\n        GROUP BY 1, 2\n        ORDER BY completion_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['rf010_task'], kpi_source_tables: ['stg_nas_rf010_dashboard'], kpi_source_columns: ['activity_tracker_state', 'mb_status', 'market_id', 'project_category'], kpi_dimensions: ['market', 'project_category'], kpi_business_logic: '"100 * COUNT FILTER (tracker_state=’Completed’) / COUNT(*)"', kpi_filters: '[{"name": "region", "type": "string", "description": "filter by NAS region"}, {"name": "area", "type": "string", "description": "filter by area"}, {"name": "market", "type": "string", "description": "filter by NAS market"}, {"name": "gc_name", "type": "string", "description": "filter by General Contractor"}, {"name": "start_date", "type": "date", "description": "start of time range"}, {"name": "end_date", "type": "date", "description": "end of time range"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_rf010_completion_rate", "node_type": "kpi", "node_id": "kpi_rf010_completion_rate", "node_label": "RF010 Completion Rate", "description": "% RF010 tasks with activity_tracker_state=\'Completed\', plus count of on-air (mb_status=\'Done\').", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_rf010_turnaround', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_rf010_turnaround', label: 'RF010 Average Turnaround (minutes)', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'AVG and SLA-adherence (≤240 min) for RF010 task turnaround.', nl_description: 'AVG and SLA-adherence (≤240 min) for RF010 task turnaround.', nl_business_rule: 'Average RF010 task turnaround in minutes, with SLA compliance computed against the 240-minute target. Markets persistently above 240 min get capacity-planning attention via the Capacity Planner.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_rf010_turnaround', kpi_name: 'RF010 Average Turnaround (minutes)', kpi_description: 'AVG and SLA-adherence (≤240 min) for RF010 task turnaround.', kpi_formula_description: 'AVG(EPOCH(completed - received)/60); SLA = 240 min', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_rf010_turnaround(execute_query, filters=None):\n    """KPI 12 — RF010 average task turnaround in minutes (target: ≤240)."""\n    where, params = apply_filters(\n        "stg_nas_rf010_dashboard", filters,\n        time_column="task_received_datetime",\n        extra_required=[\n            \'"task_received_datetime" IS NOT NULL\',\n            \'"task_completed_datetime" IS NOT NULL\',\n            \'"task_completed_datetime"::timestamp >= "task_received_datetime"::timestamp\',\n        ],\n    )\n    sql = f"""\n        SELECT\n            "market_id" AS market,\n            COUNT(*) AS tasks,\n            ROUND(AVG(EXTRACT(EPOCH FROM ("task_completed_datetime"::timestamp - "task_received_datetime"::timestamp))/60.0)::numeric, 2) AS avg_turnaround_minutes,\n            COUNT(*) FILTER (\n                WHERE EXTRACT(EPOCH FROM ("task_completed_datetime"::timestamp - "task_received_datetime"::timestamp))/60.0 <= 240\n            ) AS within_sla,\n            ROUND(100.0 * COUNT(*) FILTER (\n                WHERE EXTRACT(EPOCH FROM ("task_completed_datetime"::timestamp - "task_received_datetime"::timestamp))/60.0 <= 240\n            ) / NULLIF(COUNT(*), 0), 2) AS sla_compliance_pct\n        FROM {fq("stg_nas_rf010_dashboard")}\n        WHERE {where}\n        GROUP BY 1\n        ORDER BY avg_turnaround_minutes DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['rf010_task'], kpi_source_tables: ['stg_nas_rf010_dashboard'], kpi_source_columns: ['task_received_datetime', 'task_completed_datetime', 'market_id'], kpi_dimensions: ['market'], kpi_business_logic: '"AVG(EPOCH(completed - received)/60); SLA = 240 min"', kpi_filters: '[{"name": "region", "type": "string", "description": "filter by NAS region"}, {"name": "area", "type": "string", "description": "filter by area"}, {"name": "market", "type": "string", "description": "filter by NAS market"}, {"name": "gc_name", "type": "string", "description": "filter by General Contractor"}, {"name": "start_date", "type": "date", "description": "start of time range"}, {"name": "end_date", "type": "date", "description": "end of time range"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_rf010_turnaround", "node_type": "kpi", "node_id": "kpi_rf010_turnaround", "node_label": "RF010 Average Turnaround (minutes)", "description": "AVG and SLA-adherence (\\u2264240 min) for RF010 task turnaround.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'kpi_gc_quality_index', session_id: '6a079b6bc1ea92432985ef54', name: 'kpi_gc_quality_index', label: 'GC Quality & Compliance Index', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Per-GC: % sessions with no rejection AND no NEST extension AND no NSI outage.', nl_description: 'Per-GC: % sessions with no rejection AND no NEST extension AND no NSI outage.', nl_business_rule: 'Per-GC percentage of ’clean’ sessions: NO rejection event, NO NEST extension, NO NSI outage. The single quality metric used by the Workload Optimizer to decide GC rebalances.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'kpi_gc_quality_index', kpi_name: 'GC Quality & Compliance Index', kpi_description: 'Per-GC: % sessions with no rejection AND no NEST extension AND no NSI outage.', kpi_formula_description: '100 * COUNT(clean_sessions) / COUNT(total_sessions); clean = no_reject ∧ no_ext ∧ no_NSI', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef get_gc_quality_index(execute_query, filters=None):\n    """KPI 13 — GC Quality & Compliance Index: % sessions per GC with NO rejection, NO extension, NO NSI outage."""\n    where, params = apply_filters(\n        "stg_nas_session_level_combined_data", filters,\n        time_column="nas_nest_start_time",\n        extra_required=[\'"nas_primary_gc" IS NOT NULL\'],\n    )\n    sql = f"""\n        SELECT\n            sess."nas_primary_gc" AS gc_name,\n            sess."nas_market"     AS market,\n            COUNT(DISTINCT sess."nas_session_id") AS total_sessions,\n            COUNT(DISTINCT sess."nas_session_id") FILTER (\n                WHERE NOT EXISTS (\n                    SELECT 1 FROM {fq("stg_nas_log_data")} l\n                    WHERE l."nas_session_id" = sess."nas_session_id"\n                      AND l."nas_event_type" IN (\'Nest Rejected\',\'Conditional Approval-Rejected\')\n                )\n                AND NOT EXISTS (\n                    SELECT 1 FROM {fq("stg_nas_nest_ext_raw_by_session")} e\n                    WHERE e."nas_session_id" = sess."nas_session_id"\n                      AND e."nas_total_ext_count_approved" IS NOT NULL\n                )\n                AND sess."nas_nsi_outage_layers" IS NULL\n            ) AS clean_sessions,\n            ROUND(100.0 * COUNT(DISTINCT sess."nas_session_id") FILTER (\n                WHERE NOT EXISTS (\n                    SELECT 1 FROM {fq("stg_nas_log_data")} l\n                    WHERE l."nas_session_id" = sess."nas_session_id"\n                      AND l."nas_event_type" IN (\'Nest Rejected\',\'Conditional Approval-Rejected\')\n                )\n                AND NOT EXISTS (\n                    SELECT 1 FROM {fq("stg_nas_nest_ext_raw_by_session")} e\n                    WHERE e."nas_session_id" = sess."nas_session_id"\n                      AND e."nas_total_ext_count_approved" IS NOT NULL\n                )\n                AND sess."nas_nsi_outage_layers" IS NULL\n            ) / NULLIF(COUNT(DISTINCT sess."nas_session_id"), 0), 2) AS quality_index_pct\n        FROM {fq("stg_nas_session_level_combined_data")} sess\n        WHERE {where}\n        GROUP BY 1, 2\n        ORDER BY quality_index_pct DESC NULLS LAST\n    """\n    return execute_query(sql, params)\n', kpi_relationship_type: 'COMPUTES_FROM', kpi_related_core_node_ids: ['nas_session', 'nest_extension', 'nas_log_event'], kpi_source_tables: ['stg_nas_session_level_combined_data', 'stg_nas_log_data', 'stg_nas_nest_ext_raw_by_session'], kpi_source_columns: ['nas_primary_gc', 'nas_session_id', 'nas_event_type', 'nas_total_ext_count_approved', 'nas_nsi_outage_layers'], kpi_dimensions: ['gc_name', 'market'], kpi_business_logic: '"100 * COUNT(clean_sessions) / COUNT(total_sessions); clean = no_reject \\u2227 no_ext \\u2227 no_NSI"', kpi_filters: '[{"name": "region", "type": "string", "description": "filter by NAS region"}, {"name": "area", "type": "string", "description": "filter by area"}, {"name": "market", "type": "string", "description": "filter by NAS market"}, {"name": "gc_name", "type": "string", "description": "filter by General Contractor"}, {"name": "start_date", "type": "date", "description": "start of time range"}, {"name": "end_date", "type": "date", "description": "end of time range"}]', kpi_output_schema: '[]', kpi_contract: '{"function_name": "get_gc_quality_index", "node_type": "kpi", "node_id": "kpi_gc_quality_index", "node_label": "GC Quality & Compliance Index", "description": "Per-GC: % sessions with no rejection AND no NEST extension AND no NSI outage.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}'});

