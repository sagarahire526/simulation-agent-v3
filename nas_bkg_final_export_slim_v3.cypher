CREATE (:BKGNode {node_id: 'dec_event_diagnoser', session_id: '6a079b6bc1ea92432985ef54', name: 'dec_event_diagnoser', label: 'Event Diagnoser', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended diagnostic capability over the NAS event log. Accepts any event_type (or event_types list) and auto-selects the right cause taxonomy. Used to answer ANY question about why events of a given category occurred (rejection causes, pending reasons, failure breakdowns).', nl_description: 'Open-ended diagnostic capability over the NAS event log. Accepts any event_type (or event_types list) and auto-selects the right cause taxonomy. Used to answer ANY question about why events of a given category occurred (rejection causes, pending reasons, failure breakdowns).', nl_business_rule: 'Universal RCA over the NAS log stream. Given an event_type (e.g. ’Nest Rejected’), it auto-picks the right cause taxonomy from CAUSE_TAXONOMIES and ranks contributing causes per market. Markets with ≥5 matching events are flagged for investigation.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'dec_event_diagnoser', kpi_name: 'Event Diagnoser', kpi_description: 'Open-ended diagnostic capability over the NAS event log. Accepts any event_type (or event_types list) and auto-selects the right cause taxonomy. Used to answer ANY question about why events of a given category occurred (rejection causes, pending reasons, failure breakdowns).', kpi_formula_description: 'Event Diagnoser', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\nCAUSE_TAXONOMIES = {\'check_in_rejection\': {\'Invalid CR\': [\'invalid\', \'cr \', \' cr.\'], \'Outage Pending\': [\'outage\', \'pending\'], \'Unavailable PO\': [\'po \', \'unavail\', \'purchase\'], \'Existing Layer Outage\': [\'layer\', \'outage\'], \'Duplicate Session\': [\'duplicate\', \'duplicat\']}, \'checkout_rejection\': {\'Alarms\': [\'alarm\'], \'Cell Down\': [\'cell down\', \'cell-down\'], \'RTWP\': [\'rtwp\'], \'Pending Clearance\': [\'clearance\', \'pending\'], \'Open Incident\': [\'incident\', \'ticket\']}, \'e911_red\': {\'RIOT Mismatch\': [\'riot\', \'mismatch\'], \'CBN Issue\': [\'cbn\'], \'Duplicate CGI\': [\'cgi\', \'duplicate\'], \'New Layer Failure\': [\'new layer\', \'layer failure\'], \'GMLC/eSMLC Sync\': [\'gmlc\', \'esmlc\', \'sync\']}, \'intp_delay\': {\'Dependency Delay\': [\'dependency\', \'depend\'], \'Approval Pending\': [\'approval\', \'pending\'], \'Resource Shortage\': [\'resource\', \'staffing\'], \'Tool Downtime\': [\'tool\', \'downtime\', \'outage\'], \'Backlog\': [\'backlog\']}, \'nest_extension_rejection\': {\'Invalid Request\': [\'invalid\', \'incorrect\'], \'Missing Approval\': [\'approval\', \'missing\'], \'SLA Exceeded\': [\'sla\', \'exceeded\'], \'Site ID Mismatch\': [\'site id\', \'mismatch\'], \'Duplicate Request\': [\'duplicate\']}}\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_event_diagnoser(execute_query, filters=None):\n    """Universal RCA for any failure event recorded in `stg_nas_log_data`.\n\n    Pass `filters[\'event_type\']` (or `event_types` list) to focus on one or\n    more event categories (e.g. \'Nest Rejected\', \'Conditional Approval-Rejected\',\n    \'Nest Pending\'). Omit it to scan ALL non-approval events.\n\n    Classification is taxonomy-driven (CAUSE_TAXONOMIES) and chosen automatically\n    from the event_type label.\n    """\n    filt = dict(filters or {})\n    event_types = filt.pop("event_types", None) or ([filt.pop("event_type")] if filt.get("event_type") else None)\n    extras = []\n    params_overlay = {}\n    if event_types:\n        extras.append(\'"nas_event_type" = ANY(%(_event_types)s::text[])\')\n        params_overlay["_event_types"] = event_types\n    else:\n        extras.append("(\\"nas_event_type\\" ILIKE \'%%reject%%\' OR \\"nas_event_type\\" ILIKE \'%%pending%%\' OR \\"nas_event_type\\" ILIKE \'%%fail%%\')")\n    where, params = apply_filters("stg_nas_log_data", filt, time_column="nas_event_time", extra_required=extras)\n    params.update(params_overlay)\n    sql = f"""\n        SELECT "nas_event_type" AS event_type, "nas_region" AS region, "nas_market" AS market,\n               "nas_site_id" AS site_id, "nas_session_id" AS session_id,\n               "nas_activity_type" AS activity_type, "nas_event_time"::timestamp AS event_time\n        FROM {fq("stg_nas_log_data")}\n        WHERE {where}\n        ORDER BY event_time DESC NULLS LAST\n        LIMIT 500\n    """\n    rows = execute_query(sql, params)\n    # Pick taxonomy by majority event_type signal\n    sample_event = (rows[0]["event_type"] if rows else "").lower()\n    taxonomy_key = (\n        "check_in_rejection" if "nest rejected" in sample_event else\n        "checkout_rejection" if "conditional" in sample_event else\n        "intp_delay" if "intp" in sample_event else\n        "check_in_rejection"\n    )\n    taxonomy = CAUSE_TAXONOMIES[taxonomy_key]\n    by_market: dict[str, dict] = {}\n    for r in rows:\n        m = r.get("market") or "UNKNOWN"\n        cause = _classify(f"{r.get(\'event_type\',\'\')} {r.get(\'activity_type\',\'\')}", taxonomy)\n        bucket = by_market.setdefault(m, {"causes": {}, "samples": [], "total": 0, "event_types": set()})\n        bucket["causes"][cause] = bucket["causes"].get(cause, 0) + 1\n        bucket["total"] += 1\n        bucket["event_types"].add(r.get("event_type"))\n        if len(bucket["samples"]) < 3:\n            bucket["samples"].append({"site_id": r.get("site_id"), "session_id": r.get("session_id"), "event_time": str(r.get("event_time", ""))})\n    out = []\n    for m, b in sorted(by_market.items(), key=lambda kv: -kv[1]["total"]):\n        top = max(b["causes"], key=b["causes"].get) if b["causes"] else "—"\n        out.append({\n            "entity": m,\n            "decision": "investigate" if b["total"] >= 5 else "monitor",\n            "reason": f"Top cause: {top} ({b[\'causes\'].get(top, 0)} of {b[\'total\']} events)",\n            "evidence": {\n                "causes": b["causes"],\n                "event_types_seen": sorted(b["event_types"]),\n                "samples": b["samples"],\n                "taxonomy_used": taxonomy_key,\n            },\n        })\n    return out\n', kpi_relationship_type: 'DECIDES_BASED_ON', kpi_related_core_node_ids: ['nas_log_event', 'rejection_event', 'nas_session'], kpi_related_kpi_ids: ['kpi_rejection_rate'], kpi_decision_logic: '"Event Diagnoser"', kpi_contract: '{"function_name": "evaluate_event_diagnoser", "node_type": "decision", "node_id": "dec_event_diagnoser", "node_label": "Event Diagnoser", "description": "Open-ended diagnostic capability over the NAS event log. Accepts any event_type (or event_types list) and auto-selects the right cause taxonomy. Used to answer ANY question about why events of a given category occurred (rejection causes, pending reasons, failure breakdowns).", "parameters": [], "output_columns": ["entity", "decision", "reason", "evidence"], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'dec_sla_compliance_diagnoser', session_id: '6a079b6bc1ea92432985ef54', name: 'dec_sla_compliance_diagnoser', label: 'SLA Compliance Diagnoser', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended SLA compliance lens. Pass sla_kind ∈ {checkin, checkout, rf010} or omit it to evaluate all three SLA families. Powers any question about SLA breach magnitude, market hotspots, or trend.', nl_description: 'Open-ended SLA compliance lens. Pass sla_kind ∈ {checkin, checkout, rf010} or omit it to evaluate all three SLA families. Powers any question about SLA breach magnitude, market hotspots, or trend.', nl_business_rule: 'Universal SLA-breach lens across check-in, check-out, and RF010 SLA families. Computes compliance % per market and flags every market <70% compliance for the relevant SLA. Used to answer ’which SLAs are breaching where?’ questions.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'dec_sla_compliance_diagnoser', kpi_name: 'SLA Compliance Diagnoser', kpi_description: 'Open-ended SLA compliance lens. Pass sla_kind ∈ {checkin, checkout, rf010} or omit it to evaluate all three SLA families. Powers any question about SLA breach magnitude, market hotspots, or trend.', kpi_formula_description: 'SLA Compliance Diagnoser', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_sla_compliance_diagnoser(execute_query, filters=None):\n    """Universal SLA-breach RCA. Pass `filters[\'sla_kind\']` ∈ {\'checkin\',\'checkout\',\'rf010\'}\n    to focus on a specific SLA family; omit to evaluate all three side-by-side.\n    Returns one row per (entity, sla_kind) combination with compliance %, threshold,\n    and the top breach contributor where derivable.\n    """\n    filt = dict(filters or {})\n    sla_kind = filt.pop("sla_kind", None)\n    out = []\n\n    def add(rows, sla_label, threshold, value_key, pct_key):\n        for r in rows:\n            pct = r.get(pct_key)\n            avg = r.get(value_key)\n            breach = pct is not None and pct < 70\n            out.append({\n                "entity": r.get("market"),\n                "decision": "investigate" if breach else "monitor",\n                "reason": f"{sla_label} compliance {pct}% (target ≥ 70%, threshold {threshold})",\n                "evidence": {"sla_kind": sla_label, "avg_value": avg, "threshold": threshold, "compliance_pct": pct},\n            })\n\n    if sla_kind in (None, "checkout"):\n        add(get_checkout_sla_compliance(execute_query, filt), "checkout", "15 min", "total_checkouts", "sla_compliance_pct")\n    if sla_kind in (None, "rf010"):\n        add(get_rf010_turnaround(execute_query, filt), "rf010", "240 min", "avg_turnaround_minutes", "sla_compliance_pct")\n    if sla_kind in (None, "checkin"):\n        # Surrogate: % sessions where (checkout_time - nest_start_time) <= 60 min (proxy for check-in efficiency)\n        where, params = apply_filters("stg_nas_session_level_combined_data", filt, time_column="nas_nest_start_time",\n                                       extra_required=[\'"nas_nest_start_time" IS NOT NULL\', \'"nas_checkout_time" IS NOT NULL\'])\n        rows = execute_query(f"""\n            SELECT "nas_market" AS market, COUNT(*) AS total,\n                   ROUND(100.0 * COUNT(*) FILTER (\n                       WHERE EXTRACT(EPOCH FROM ("nas_checkout_time"::timestamp - "nas_nest_start_time"::timestamp))/60 <= 60\n                   ) / NULLIF(COUNT(*),0), 2) AS sla_compliance_pct\n            FROM {fq("stg_nas_session_level_combined_data")}\n            WHERE {where}\n            GROUP BY 1 ORDER BY sla_compliance_pct DESC NULLS LAST\n        """, params)\n        for r in rows:\n            pct = r.get("sla_compliance_pct")\n            out.append({\n                "entity": r.get("market"),\n                "decision": "investigate" if pct is not None and pct < 70 else "monitor",\n                "reason": f"check-in window compliance {pct}% (proxy: nest→checkout ≤ 60 min)",\n                "evidence": {"sla_kind": "checkin_proxy", "total_sessions": r.get("total"), "compliance_pct": pct},\n            })\n    return out\n', kpi_relationship_type: 'DECIDES_BASED_ON', kpi_related_core_node_ids: ['nas_session', 'rf010_task'], kpi_related_kpi_ids: ['kpi_checkout_sla_compliance', 'kpi_rf010_turnaround'], kpi_decision_logic: '"SLA Compliance Diagnoser"', kpi_contract: '{"function_name": "evaluate_sla_compliance_diagnoser", "node_type": "decision", "node_id": "dec_sla_compliance_diagnoser", "node_label": "SLA Compliance Diagnoser", "description": "Open-ended SLA compliance lens. Pass sla_kind \\u2208 {checkin, checkout, rf010} or omit it to evaluate all three SLA families. Powers any question about SLA breach magnitude, market hotspots, or trend.", "parameters": [], "output_columns": ["entity", "decision", "reason", "evidence"], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'dec_gate_blocker_finder', session_id: '6a079b6bc1ea92432985ef54', name: 'dec_gate_blocker_finder', label: 'Gate Blocker Finder', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended gate-blocker locator. Pass gate_kind ∈ {e911, call_test, rf010_oa} or omit to scan all gates. Surfaces every site currently held at any workflow gate and classifies the blocking layer.', nl_description: 'Open-ended gate-blocker locator. Pass gate_kind ∈ {e911, call_test, rf010_oa} or omit to scan all gates. Surfaces every site currently held at any workflow gate and classifies the blocking layer.', nl_business_rule: 'Universal workflow-gate-blocker locator across e911, call-test, and RF010 gates. Returns every site currently held at any chosen gate, with the blocking layer classified via the gate-specific cause taxonomy.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'dec_gate_blocker_finder', kpi_name: 'Gate Blocker Finder', kpi_description: 'Open-ended gate-blocker locator. Pass gate_kind ∈ {e911, call_test, rf010_oa} or omit to scan all gates. Surfaces every site currently held at any workflow gate and classifies the blocking layer.', kpi_formula_description: 'Gate Blocker Finder', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\nCAUSE_TAXONOMIES = {\'check_in_rejection\': {\'Invalid CR\': [\'invalid\', \'cr \', \' cr.\'], \'Outage Pending\': [\'outage\', \'pending\'], \'Unavailable PO\': [\'po \', \'unavail\', \'purchase\'], \'Existing Layer Outage\': [\'layer\', \'outage\'], \'Duplicate Session\': [\'duplicate\', \'duplicat\']}, \'checkout_rejection\': {\'Alarms\': [\'alarm\'], \'Cell Down\': [\'cell down\', \'cell-down\'], \'RTWP\': [\'rtwp\'], \'Pending Clearance\': [\'clearance\', \'pending\'], \'Open Incident\': [\'incident\', \'ticket\']}, \'e911_red\': {\'RIOT Mismatch\': [\'riot\', \'mismatch\'], \'CBN Issue\': [\'cbn\'], \'Duplicate CGI\': [\'cgi\', \'duplicate\'], \'New Layer Failure\': [\'new layer\', \'layer failure\'], \'GMLC/eSMLC Sync\': [\'gmlc\', \'esmlc\', \'sync\']}, \'intp_delay\': {\'Dependency Delay\': [\'dependency\', \'depend\'], \'Approval Pending\': [\'approval\', \'pending\'], \'Resource Shortage\': [\'resource\', \'staffing\'], \'Tool Downtime\': [\'tool\', \'downtime\', \'outage\'], \'Backlog\': [\'backlog\']}, \'nest_extension_rejection\': {\'Invalid Request\': [\'invalid\', \'incorrect\'], \'Missing Approval\': [\'approval\', \'missing\'], \'SLA Exceeded\': [\'sla\', \'exceeded\'], \'Site ID Mismatch\': [\'site id\', \'mismatch\'], \'Duplicate Request\': [\'duplicate\']}}\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_gate_blocker_finder(execute_query, filters=None):\n    """Universal readiness-gap analysis. `filters[\'gate_kind\']` ∈\n    {\'e911\',\'call_test\',\'rf010_oa\'} chooses the gate; omit to scan all.\n    Surfaces sites blocked at that gate and classifies the blocking layer.\n    """\n    filt = dict(filters or {})\n    gate = filt.pop("gate_kind", None)\n    out = []\n\n    if gate in (None, "e911"):\n        where, params = apply_filters(\n            "stg_nas_e911_readiness_riot_validation", filt,\n            time_column="nas_e911_validation_date",\n            extra_required=["\\"nas_validate_e911_readiness\\" NOT ILIKE \'Ready%%\'"],\n        )\n        rows = execute_query(f"""\n            SELECT "nas_site_id" AS site_id, "nas_market" AS market, "nas_engineer" AS engineer,\n                   "nas_validate_e911_readiness" AS readiness,\n                   "nas_consolidation_check_all_layers" AS consolidation\n            FROM {fq("stg_nas_e911_readiness_riot_validation")}\n            WHERE {where}\n            LIMIT 200\n        """, params)\n        for r in rows:\n            layer = _classify(f"{r.get(\'readiness\',\'\')} {r.get(\'consolidation\',\'\')}", CAUSE_TAXONOMIES["e911_red"])\n            out.append({\n                "entity": r["site_id"],\n                "decision": "remediate",\n                "reason": f"E911 gate blocked — failure layer: {layer}",\n                "evidence": {"gate": "e911", "market": r.get("market"), "engineer": r.get("engineer"), "readiness": r.get("readiness")},\n            })\n\n    if gate in (None, "call_test"):\n        where, params = apply_filters(\n            "stg_nas_e2e_call_test_completion", filt,\n            time_column="nas_integration_date",\n            extra_required=["\\"nas_call_test_completion_status\\" ILIKE \'RED\'"],\n        )\n        rows = execute_query(f"""\n            SELECT "nas_site_id" AS site_id, "nas_market" AS market, "nas_go_email_responsibility" AS engineer\n            FROM {fq("stg_nas_e2e_call_test_completion")}\n            WHERE {where}\n            LIMIT 200\n        """, params)\n        for r in rows:\n            out.append({\n                "entity": r["site_id"],\n                "decision": "remediate",\n                "reason": "Call test gate blocked — status RED",\n                "evidence": {"gate": "call_test", "market": r.get("market"), "engineer": r.get("engineer")},\n            })\n\n    if gate in (None, "rf010_oa"):\n        where, params = apply_filters(\n            "stg_nas_rf010_dashboard", filt,\n            time_column="task_received_datetime",\n            extra_required=["\\"activity_tracker_state\\" NOT ILIKE \'Completed\'"],\n        )\n        rows = execute_query(f"""\n            SELECT "project_site_id" AS site_id, "market_id" AS market, "activity_tracker_state" AS state,\n                   "on_hold_status" AS on_hold\n            FROM {fq("stg_nas_rf010_dashboard")}\n            WHERE {where}\n            LIMIT 200\n        """, params)\n        for r in rows:\n            out.append({\n                "entity": r["site_id"],\n                "decision": "remediate",\n                "reason": f"RF010 gate not Completed — state \'{r.get(\'state\')}\'",\n                "evidence": {"gate": "rf010_oa", "market": r.get("market"), "on_hold": r.get("on_hold")},\n            })\n    return out\n', kpi_relationship_type: 'DECIDES_BASED_ON', kpi_related_core_node_ids: ['e911_validation', 'e2e_call_test', 'rf010_task'], kpi_related_kpi_ids: ['kpi_e911_readiness_index', 'kpi_call_test_completion_rate', 'kpi_rf010_completion_rate'], kpi_decision_logic: '"Gate Blocker Finder"', kpi_contract: '{"function_name": "evaluate_gate_blocker_finder", "node_type": "decision", "node_id": "dec_gate_blocker_finder", "node_label": "Gate Blocker Finder", "description": "Open-ended gate-blocker locator. Pass gate_kind \\u2208 {e911, call_test, rf010_oa} or omit to scan all gates. Surfaces every site currently held at any workflow gate and classifies the blocking layer.", "parameters": [], "output_columns": ["entity", "decision", "reason", "evidence"], "sample_output": [], "row_count": 0}'});
CREATE (:BKGNode {node_id: 'dec_workload_optimizer', session_id: '6a079b6bc1ea92432985ef54', name: 'dec_workload_optimizer', label: 'Workload Optimizer', node_type: 'CORE', entity_type: 'kpi', status: 'confirmed', definition: 'Open-ended workload-rebalance capability. Pass entity_dim ∈ {gc, engineer, market} to choose the comparison plane and quality_threshold_pct to tune sensitivity. Powers any rebalance/reassignment question.', nl_description: 'Open-ended workload-rebalance capability. Pass entity_dim ∈ {gc, engineer, market} to choose the comparison plane and quality_threshold_pct to tune sensitivity. Powers any rebalance/reassignment question.', nl_business_rule: 'Universal workload-rebalance recommender across GC, engineer, and market dimensions. Flags entities whose quality_pct is below the quality_threshold AND whose load exceeds the dimension’s market median. Suggests a top-quartile peer for reassignment.', is_skipped: false, skip_reason: '', kpi_kpi_id: 'dec_workload_optimizer', kpi_name: 'Workload Optimizer', kpi_description: 'Open-ended workload-rebalance capability. Pass entity_dim ∈ {gc, engineer, market} to choose the comparison plane and quality_threshold_pct to tune sensitivity. Powers any rebalance/reassignment question.', kpi_formula_description: 'Workload Optimizer', kpi_python_function: '# ─────────── inlined prelude (auto-generated, do not edit) ───────────\nimport json as _json\nimport re as _re\n\nPG_SCHEMA = "pwc_macro_staging_schema"\n\ndef fq(table):\n    return f\'"{PG_SCHEMA}"."{table}"\'\n\nTABLE_FILTER_MAPPING = {\'stg_tmo_nas_mbt\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'project_category\': \'por_category\'}, \'stg_nas_session_level_combined_data\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_primary_gc\', \'project_category\': \'nas_project_category\'}, \'stg_nas_log_data\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e911_readiness_riot_validation\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_engineer\', \'project_category\': \'nas_project_category\'}, \'stg_nas_nest_ext_raw_by_session\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'session_id\': \'nas_session_id\', \'gc_name\': \'nas_vendorname\', \'project_category\': \'nas_project_category\'}, \'stg_nas_e2e_call_test_completion\': {\'region\': \'nas_region\', \'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'engineer\': \'nas_go_email_responsibility\'}, \'stg_nas_rf010_dashboard\': {\'region\': \'region_id\', \'market\': \'market_id\', \'site_id\': \'project_site_id\', \'project_id\': \'project_id\', \'project_category\': \'project_category\'}, \'stg_nas_planned_outage_activity\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\', \'project_category\': \'nas_project_category\'}, \'stg_nas_rejection_data_last_30_days\': {\'region\': \'nas_rej_region\', \'market\': \'nas_rej_market\', \'site_id\': \'nas_rej_siteid\'}, \'stg_nas_nest_db_sp\': {\'market\': \'nas_market\', \'site_id\': \'nas_site_id\'}, \'stg_tmo_nas_daily_dashboard\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_id\', \'project_category\': \'project_category\'}, \'stg_ndpd_mbt_tmobile_macro_combined\': {\'region\': \'rgn_region\', \'area\': \'m_area\', \'market\': \'m_market\', \'site_id\': \'s_site_id\', \'project_id\': \'pj_project_id\', \'gc_name\': \'pj_gc_crew_name\'}, \'stg_nas_projectid_and_smpid_tracker\': {\'region\': \'region\', \'market\': \'market\', \'site_id\': \'site_name\', \'project_id\': \'project_code\'}}\n\ndef apply_filters(table, filters, time_column=None, extra_required=()):\n    filters = filters or {}\n    mapping = TABLE_FILTER_MAPPING.get(table, {})\n    where = []\n    params = {}\n    for canonical, value in filters.items():\n        if value is None or value == "":\n            continue\n        if canonical in ("start_date", "end_date"):\n            if not time_column:\n                continue\n            op = ">=" if canonical == "start_date" else "<"\n            where.append(f\'"{time_column}"::timestamp {op} %({canonical})s::timestamp\')\n            params[canonical] = str(value)\n            continue\n        col = mapping.get(canonical)\n        if not col:\n            continue\n        where.append(f\'"{col}" = %({canonical})s\')\n        params[canonical] = value\n    for predicate in extra_required:\n        where.append(predicate)\n    return (" AND ".join(where), params)\n\ndef _classify(text, taxonomy):\n    if not text:\n        return "Uncategorised"\n    t = str(text).lower()\n    for label, keywords in taxonomy.items():\n        if any(k in t for k in keywords):\n            return label\n    return "Other"\n# ─────────── end inlined prelude ───────────\n\ndef evaluate_workload_optimizer(execute_query, filters=None):\n    """Universal: identify entities (GCs / engineers / markets) that are under-\n    performing while over-loaded, recommend rebalance.\n\n    `filters[\'entity_dim\']` ∈ {\'gc\',\'engineer\',\'market\'}; default \'gc\'.\n    `filters[\'quality_threshold_pct\']` (default 70).\n    """\n    filt = dict(filters or {})\n    dim = filt.pop("entity_dim", "gc")\n    threshold = float(filt.pop("quality_threshold_pct", 70))\n    out = []\n\n    if dim == "gc":\n        rows = get_gc_quality_index(execute_query, filt)\n        by_market: dict[str, list] = {}\n        for r in rows:\n            by_market.setdefault(r.get("market") or "UNKNOWN", []).append(r)\n        for m, gcs in by_market.items():\n            if not gcs:\n                continue\n            sessions_sorted = sorted([g.get("total_sessions") or 0 for g in gcs])\n            median = sessions_sorted[len(sessions_sorted) // 2]\n            for g in gcs:\n                qi = g.get("quality_index_pct") or 0\n                ts = g.get("total_sessions") or 0\n                if qi < threshold and ts > median:\n                    peer = max(gcs, key=lambda x: x.get("quality_index_pct") or 0)\n                    out.append({\n                        "entity": g.get("gc_name"),\n                        "decision": "rebalance",\n                        "reason": f"GC quality {qi}% < {threshold}% AND load {ts} > market_median {median}",\n                        "evidence": {"dim": "gc", "market": m, "current_quality": qi, "load": ts, "suggested_peer": peer.get("gc_name"), "peer_quality": peer.get("quality_index_pct")},\n                    })\n\n    elif dim == "engineer":\n        # Use call_test_red_wip as the engineer-level metric\n        rows = get_call_test_red_wip(execute_query, filt)\n        by_market: dict[str, list] = {}\n        for r in rows:\n            by_market.setdefault(r.get("market") or "UNKNOWN", []).append(r)\n        for m, engs in by_market.items():\n            if not engs:\n                continue\n            med = sorted([e.get("red_wip_sites") or 0 for e in engs])[len(engs) // 2]\n            for e in engs:\n                wip = e.get("red_wip_sites") or 0\n                if wip > 2 * med and wip >= 5:\n                    out.append({\n                        "entity": e.get("engineer"),\n                        "decision": "rebalance",\n                        "reason": f"Engineer Red WIP {wip} > 2× market median ({med})",\n                        "evidence": {"dim": "engineer", "market": m, "red_wip": wip, "market_median": med},\n                    })\n\n    elif dim == "market":\n        rates = get_call_test_completion_rate(execute_query, filt)\n        for r in rates:\n            green = r.get("green_pct") or 0\n            if green < threshold:\n                out.append({\n                    "entity": r.get("market"),\n                    "decision": "rebalance",\n                    "reason": f"Market green-rate {green}% < {threshold}%",\n                    "evidence": {"dim": "market", "region": r.get("region"), "green_pct": green, "total_tests": r.get("total_tests")},\n                })\n    return out\n', kpi_relationship_type: 'DECIDES_BASED_ON', kpi_related_core_node_ids: ['nas_session'], kpi_related_kpi_ids: ['kpi_gc_quality_index', 'kpi_call_test_red_wip', 'kpi_call_test_completion_rate'], kpi_decision_logic: '"Workload Optimizer"', kpi_contract: '{"function_name": "evaluate_workload_optimizer", "node_type": "decision", "node_id": "dec_workload_optimizer", "node_label": "Workload Optimizer", "description": "Open-ended workload-rebalance capability. Pass entity_dim \\u2208 {gc, engineer, market} to choose the comparison plane and quality_threshold_pct to tune sensitivity. Powers any rebalance/reassignment question.", "parameters": [], "output_columns": ["entity", "decision", "reason", "evidence"], "sample_output": [], "row_count": 0}'});
