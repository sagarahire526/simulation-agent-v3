: "COALESCE(nas_rej_checkin_reject_reason", "type": "string", "nullable": false}, {"name": "nas_rej_checkout_reject_reason) AS rejection_reason", "type": "string", "nullable": false}], "row_count": 3}', node_type: 'CORE', entity_type: 'core', map_python_function: 'def get_change_request(execute_query, filters=None):\n    """Fetch Change Request (integration gating rejection) records.\n    Node: Change Request | Table: stg_nas_rejection_data_last_30_days | Key: nas_rej_sessionid | DB: public\n    """\n    filters = filters or {}\n\n    def esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    where_parts = [\n        "(nas_rej_checkin_reject_reason IS NOT NULL OR nas_rej_checkout_reject_reason IS NOT NULL)"\n    ]\n\n    for k in ["nas_rej_market", "nas_rej_region", "nas_rej_siteid", "nas_rej_userid", "nas_rej_sessionid"]:\n        if filters.get(k) is not None:\n            where_parts.append(f"{k} = \'{esc(filters[k])}\'")\n\n    if filters.get("start_date"):\n        where_parts.append(f"nas_rej_rejection_time >= \'{esc(filters[\'start_date\'])}\'")\n    if filters.get("end_date"):\n        where_parts.append(f"nas_rej_rejection_time < \'{esc(filters[\'end_date\'])}\'")\n\n    sql = (\n        "SELECT id, nas_rej_userid, nas_rej_sessionid, nas_rej_requesttime, "\n        "nas_rej_market, nas_rej_region, nas_rej_siteid, "\n        "nas_rej_checkin_reject_reason, nas_rej_checkout_reject_reason, "\n        "nas_rej_checkout_notes, nas_rej_rejection_time, "\n        "COALESCE(nas_rej_checkin_reject_reason, nas_rej_checkout_reject_reason) AS rejection_reason "\n        "FROM pwc_macro_staging_schema.stg_nas_rejection_data_last_30_days "\n        "WHERE " + " AND ".join(where_parts)\n    )\n\n    return execute_query(sql) or []', is_skipped: false, name: 'change_request', definition: 'A project-specific change request (CR) prerequisite that must be in a valid state for downstream work (notably integration) to proceed. Can block or cause rejections when invalid; treated as an integration-related artifact with its own validity status lifecycle.', map_database_name: 'public', skip_reason: '', status: 'mentioned', node_id: 'change_request'});
