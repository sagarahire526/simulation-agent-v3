       where_parts.append(f"{k} = \'{esc(filters[k])}\'")\n\n    sql = (\n        "SELECT pj_project_id, s_site_id, m_market, m_area, rgn_region, "\n        "construction_gc, pj_project_status, por_category, "\n        "ms_1313_pre_construction_package_validated_actual, "\n        "ms_1315_pre_construction_package_rejected_actual, "\n        "ms_1333_scoping_package_approved_by_customer_actual, "\n        "ms_1407_tower_ntp_validated_actual, "\n        "ms_1408_tower_ntp_rejected_actual, "\n        "ms_1507_tower_ntp_approved_actual, "\n        "pj_a_4100_construction_ntp_accepted_by_gc_finish, "\n        "ms_1556_punch_checklist_audit_completed_by_nokia_actual, "\n        "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl, "\n        "ms_1559_cop_approved_by_t_mobile_actual, "\n        "pj_a_5525_approve_close_out_binder_finish, "\n        "ms_2400_contractual_customer_acceptance_actual, "\n        "ms_2450_customer_payment_release_actual, "\n        "gdc_quality_audit_date, "\n        "customer_quality_audit_date "\n        "FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined"\n    )\n\n    if where_parts:\n        sql += " WHERE " + " AND ".join(where_parts)\n\n    return execute_query(sql) or []\n', is_skipped: false, name: 'approval', definition: 'A lightweight approval touchpoint/event between Nokia and T-Mobile for a specific Project (e.g., NTP, Scoping Package Approval, Punch Checklist review, Closeout Package/COP, Customer Acceptance). Has type and status (pending/approved/rejected) and is evidenced/controlled via project milestone fields. Created only when the approval gate applies (e.g., NTP approval created when NTP_required=true).', map_database_name: 'public', skip_reason: '', status: 'mentioned', node_id: 'approval'});
