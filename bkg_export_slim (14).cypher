\n    Node: Site Access | Table: stg_ndpd_mbt_tmobile_macro_combined | Key: pj_project_id | DB: public\n    """\n    base_sql = \'SELECT\\n  "id",\\n  "pj_project_id",\\n  "s_site_id",\\n  "s_24x7_site_access",\\n  "s_facility_access_description",\\n  "s_facility_access_gate_combo",\\n  "s_facility_access_notes",\\n  "s_facility_access_notes_history",\\n  "s_site_access_details",\\n  "s_directions_to_site"\\nFROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\'\n    where_parts = []\n    if filters:\n        for k, v in filters.items():\n            col = \'"\' + k + \'"\'\n            if v is None:\n                where_parts.append(col + " IS NULL")\n            else:\n                escaped = str(v).replace("\'", "\'\'")\n                where_parts.append(col + " = \'" + escaped + "\'")\n    if where_parts:\n        if " WHERE " in base_sql.upper():\n            base_sql += " AND " + " AND ".join(where_parts)\n        else:\n            base_sql += " WHERE " + " AND ".join(where_parts)\n    rows = execute_query(base_sql)\n    return rows if rows else []', is_skipped: false, name: 'site_access', definition: 'Operational site access coordination/tracking for a Site (distinct from formal permits). Captures access constraints (e.g., restricted hours, escort requirement, key/lockbox issues, night-only windows), current access status (cleared/blocked/conditional), and blocker reason when applicable.', map_database_name: 'public', skip_reason: '', status: 'mentioned', node_id: 'site_access'});
