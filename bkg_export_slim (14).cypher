WHERE " + " AND ".join(where_parts)\n    rows = execute_query(base_sql)\n    return rows if rows else []', is_skipped: false, name: 'scoping_package', definition: 'A project scoping deliverable document set assembled/validated by Nokia (Scoping Team) and submitted to T-Mobile for review; determines/validates scope and drives downstream planning. Reviewed via a Scoping Package Approval.', map_database_name: 'public', skip_reason: '', status: 'mentioned', node_id: 'scoping_package'});
CREATE (:BKGNode {map_table_name: 'stg_ndpd_mbt_tmobile_macro_combined', map_key_column: 'pj_project_id', nl_business_rule: '', session_id: '69a3d22f26e208edc083a06e', label: 'General Contractor Assignment', map_sql_template: 'SELECT\n    pj_project_id,\n    s_site_id,\n    m_market,\n    m_area,\n    rgn_region,\n    construction_gc,\n    ci_gc,\n    confirm_split_spo,\n    por_category,\n    pj_project_status,\n    construction_gc_assigned_date,\n    pj_a_3775_gc_selected_finish,\n    pj_a_4075_construction_ntp_submitted_to_gc_finish,\n    pj_a_4100_construction_ntp_accepted_by_gc_finish,\n    pj_a_4025_civil_ntp_submitted_to_gc_finish,\n    pj_a_4050_civil_ntp_accepted_by_gc_finish\nFROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\nWHERE construction_gc IS NOT NULL', map_label_column: 'pj_project_id', nl_description: 'A scoped assignment of a General Contractor to a Site/Project for a specific construction scope segment. Used to represent normal single-vendor cases and split-scope cases where different GCs handle civil vs tower. Tracks assignment status (pending/accepted/rejected/reassigned) and effective dates. Scope is constrained to {civil, tower}.', map_contract: '{"function_name": "get_general_contractor_assignment", "node_type": "core", "node_id": "general_contractor_assignment", "node_label": "general_contractor_assignment", "description": "Query general_contractor_assignment data from stg_ndpd_mbt_tmobile_macro_combined", "parameters": [{"name": "pj_project_id", "type": "string", "description": "Filter by pj_project_id (primary key)", "required": false, "sample_values": ["CH10000A-0002000000", "DE10001A-0002000001", "IN10002A-0002000002"]}, {"name": "m_area", "type": "string", "description": "Filter by m_area", "required": false, "sample_values": ["GREAT LAKES"]}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn_region", "required": false, "sample_values": ["CENTRAL"]}, {"name": "pj_project_status", "type": "string", "description": "Filter by pj_project_status", "required": false, "sample_values": ["Dead", "Completed"]}, {"name": "m_market", "type": "string", "description": "Filter by m_market", "required": false, "sample_values": ["CHICAGO", "DETROIT", "INDIANAPOLIS"]}, {"name": "por_category", "type": "string", "description": "Filter by por_category", "required": false, "sample_values": ["NTM", "LTW", "Site Mod"]}, {"name": "ci_gc", "type": "string", "description": "Filter by ci_gc", "required": false, "sample_values": ["nokia"]}, {"name": "confirm_split_spo", "type": "string", "description": "Filter by confirm_split_spo", "required": false, "sample_values": []}, {"name": "construction_gc_assigned_date", "type": "string", "description": "Filter by construction_gc_assigned_date", "required": false, "sample_values": []}, {"name": "pj_a_4075_construction_ntp_submitted_to_gc_finish", "type": "string", "description": "Filter by pj_a_4075_construction_ntp_submitted_to_gc_finish", "required": false, "sample_values": ["2024-11-20 10:31:00"]}, {"name": "pj_a_4100_construction_ntp_accepted_by_gc_finish", "type": "string", "description": "Filter by pj_a_4100_construction_ntp_accepted_by_gc_finish", "required": false, "sample_values": ["2025-08-08 16:42:00"]}], "output_columns": [{"name": "pj_project_id", "type": "string", "nullable": false}, {"name": "s_site_id", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "rgn_region", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "ci_gc", "type": "string", "nullable": true}, {"name": "confirm_split_spo", "type": "string", "nullable": true}, {"name": "por_category", "type": "string", "nullable": false}, {"name": "pj_project_status", "type": "string", "nullable": false}, {"name": "construction_gc_assigned_date", "type": "string", "nullable": true}, {"name": "pj_a_3775_gc_selected_finish", "type": "string", "nullable": true}, {"name": "pj_a_4075_construction_ntp_submitted_to_gc_finish", "type": "string", "nullable": true}, {"name": "pj_a_4100_construction_ntp_accepted_by_gc_finish", "type": "string", "nullable": true}, {"name": "pj_a_4025_civil_ntp_submitted_to_gc_finish", "type": "string", "nullable": true}, {"name": "pj_a_4050_civil_ntp_accepted_by_gc_finish", "type": "string", "nullable": true}], "sample_output": [], "row_count": 3}', entity_type: 'transaction', node_type: 'CORE', map_python_function: 'def get_general_contractor_assignment(execute_query, filters=None):\n    """Fetch GC Assignment records showing which GC is assigned to which project/site.\n\n    Notes:\n      - This dataset is denormalized: one row per project; split-scope signals are represented via\n        columns like `confirm_split_spo` and separate civil vs construction NTP timestamps.\n\n    Node: General Contractor Assignment | Table: stg_ndpd_mbt_tmobile_macro_combined | Key: pj_project_id | DB: public\n    """\n    filters = filters or {}\n\n    def esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    where_parts = ["construction_gc IS NOT NULL"]\n\n    for k in [\n        "pj_project_id",\n        "s_site_id",\n        "construction_gc",\n        "ci_gc",\n        "m_market",\n        "m_area",\n        "rgn_region",\n        "por_category",\n        "pj_project_status",\n        "confirm_split_spo",\n    ]:\n        if filters.get(k) is not None:\n            where_parts.append(f"{k} = \'{esc(filters[k])}\'")\n\n    sql = (\n        "SELECT "\n        "pj_project_id, s_site_id, m_market, m_area, rgn_region, "\n        "construction_gc, ci_gc, confirm_split_spo, "\n        "por_category, pj_project_status, construction_gc_assigned_date, "\n        "pj_a_3775_gc_selected_finish, "\n        "pj_a_4075_construction_ntp_submitted_to_gc_finish, "\n        "pj_a_4100_construction_ntp_accepted_by_gc_finish, "\n        "pj_a_4025_civil_ntp_submitted_to_gc_finish, "\n        "pj_a_4050_civil_ntp_accepted_by_gc_finish "\n        "FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined "\n        "WHERE " + " AND ".join(where_parts)\n    )\n\n    return execute_query(sql) or []\n', is_skipped: false, name: 'general_contractor_assignment', definition: 'A scoped assignment of a General Contractor to a Site/Project for a specific construction scope segment. Used to represent normal single-vendor cases and split-scope cases where different GCs handle civil vs tower. Tracks assignment status (pending/accepted/rejected/reassigned) and effective dates. Scope is constrained to {civil, tower}.', map_database_name: 'public', skip_reason: '', status: 'mentioned', node_id: 'general_contractor_assignment'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_nas_session_level_combined_data'], nl_business_rule: '', kpi_formula_description: 'Per (nas_market, nas_activity_type, nas_company_name, date_bucket) over completed sessions (nas_checkout_approve_time IS NOT NULL): completed_sessions = COUNT(DISTINCT nas_session_id); checkout_sla_rate_pct = 100 * COUNT(DISTINCT completed sessions with extension proxy = no extension) / NULLIF(COUNT(DISTINCT completed sessions),0); extension_rate_pct = 100 * COUNT(DISTINCT completed sessions with extension proxy = extension) / NULLIF(COUNT(DISTINCT completed sessions),0); avg_extensions_per_session = AVG(nas_total_ext_count_approved) over completed sessions where COALESCE(nas_total_ext_count_approved,0)>0; avg_activity_duration = AVG(nas_total_activity_duration).', kpi_output_schema: '[{"column": "nas_market", "type": "string", "description": "NAS market grouping dimension."}, {"column": "nas_activity_type", "type": "string", "description": "NAS activity type grouping dimension."}, {"column": "nas_company_name", "type": "string", "description": "NAS company name grouping dimension."}, {"column": "date_bucket", "type": "string", "description": "Time bucket derived from nas_checkout_approve_time at the selected grain (day or week)."}, {"column": "completed_sessions", "type": "int", "description": "Distinct count of completed sessions."}, {"column": "checkout_sla_rate_pct", "type": "float", "description": "Percent of completed sessions completed without needing an extension (SLA proxy)."}, {"column": "extension_rate_pct", "type": "float", "description": "Percent of completed sessions that required an extension (proxy)."}, {"column": "avg_extensions_per_session", "type": "float", "description": "Average approved extensions among completed sessions with at least one approved extension."}, {"column": "avg_activity_duration", "type": "float", "description": "Average total activity duration over completed sessions (may be NULL if duration is stored as non-numeric text)."}]', kpi_business_logic: '1) Start from stg_nas_session_level_combined_data (session-level).\n2) Keep only completed sessions where nas_checkout_approve_time IS NOT NULL.\n3) Derive date_bucket from nas_checkout_approve_time (day: cast to date; week: date_trunc(\'week\')::date).\n4) Group by nas_market, nas_activity_type, nas_company_name, date_bucket.\n5) Compute completed_sessions as COUNT(DISTINCT nas_session_id).\n6) Compute checkout_sla_rate_pct as percent of completed sessions with no approved extensions (either COALESCE(nas_total_ext_count_approved,0)=0 or, in the provided SQL option, nas_status_nest_ext IS NULL).\n7) Compute extension_rate_pct as percent of completed sessions with extensions (either COALESCE(nas_total_ext_count_approved,0)>0 or, in the provided SQL option, nas_status_nest_ext IS NOT NULL).\n8) Compute avg_extensions_per_session as AVG(nas_total_ext_count_approved) over completed sessions with COALESCE(nas_total_ext_count_approved,0)>0.\n9) Compute avg_activity_duration as AVG(nas_total_activity_duration) over completed sessions (SQL casts to numeric; may be NULL if non-numeric text).', kpi_filters: '[{"name": "completed_sessions_only", "type": "string", "description": "Includes only sessions where nas_checkout_approve_time IS NOT NULL."}, {"name": "start_date", "type": "date", "description": "Filters nas_checkout_approve_time to be >= start_date."}, {"name": "end_date", "type": "date", "description": "Filters nas_checkout_approve_time to be < end_date."}, {"name": "nas_market", "type": "string", "description": "Limits results to a specific nas_market."}, {"name": "nas_activity_type", "type": "string", "description": "Limits results to a specific nas_activity_type."}, {"name": "nas_company_name", "type": "string", "description": "Limits results to a specific nas_company_name."}, {"name": "nas_vendor_name", "type": "string", "description": "Optional filter for nas_vendor_name."}, {"name": "nas_primary_gc", "type": "string", "description": "Optional filter for nas_primary_gc."}, {"name": "nas_session_id", "type": "string", "description": "Optional filter for a specific nas_session_id."}, {"name": "nas_site_id", "type": "string", "description": "Optional filter for a specific nas_site_id."}, {"name": "nas_project_category", "type": "string", "description": "Optional filter for a specific nas_project_category."}, {"name": "nas_date_period", "type": "string", "description": "Optional filter for a specific nas_date_period."}, {"name": "time_grain", "type": "string", "description": "Controls date_bucket derivation: daily (nas_checkout_approve_time::date) or weekly (date_trunc(\'week\', nas_checkout_approve_time)::date)."}]', kpi_contract: '{"function_name": "get_nas_integration_sla", "node_type": "kpi", "node_id": "dc2892a1-5c59-4892-b008-e30afd4df123", "node_label": "NAS Integration SLA", "description": "Combined NAS integration capacity KPI returning multiple measures per (nas_market, nas_activity_type, nas_company_name, date_bucket) from `stg_nas_session_level_combined_data`. A session is considered completed when `nas_checkout_approve_time IS NOT NULL` and is counted as `COUNT(DISTINCT nas_session_id)`.\\n\\nOutput columns per row:\\n1) completed_sessions: COUNT(DISTINCT nas_session_id) over completed sessions.\\n2) checkout_sla_rate_pct: 100 * (COUNT(DISTINCT nas_session_id) where completed AND COALESCE(nas_total_ext_count_approved,0)=0) / NULLIF(COUNT(DISTINCT nas_session_id) where completed, 0). (SLA proxy = completed without any approved extensions.)\\n3) extension_rate_pct: 100 * (COUNT(DISTINCT nas_session_id) where completed AND COALESCE(nas_total_ext_count_approved,0)>0) / NULLIF(COUNT(DISTINCT nas_session_id) where completed, 0).\\n4) avg_extensions_per_session: AVG(nas_total_ext_count_approved) over completed sessions with COALESCE(nas_total_ext_count_approved,0)>0.\\n5) avg_activity_duration: AVG(nas_total_activity_duration) over completed sessions.\\n\\nTime grouping: date_bucket derived from `nas_checkout_approve_time` (daily: `nas_checkout_approve_time::date`; weekly: `date_trunc(\'week\', nas_checkout_approve_time)::date`). Grouping dimensions: nas_market, nas_activity_type, nas_company_name, date_bucket. Optional additional dimensions if needed: nas_vendor_name, nas_primary_gc.\\n\\nPrimary entities involved: Integration Activity (session-level records) joined conceptually to Market and vendor/company; computed directly from NAS session fact table without requiring additional joins.", "parameters": [{"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}, {"name": "time_grain", "type": "date", "description": "Filter by time grain", "required": false, "sample_values": []}, {"name": "date_bucket_grain", "type": "date", "description": "Filter by date bucket grain", "required": false, "sample_values": []}], "output_columns": [{"name": "nas_market", "type": "string", "nullable": false}, {"name": "nas_activity_type", "type": "string", "nullable": false}, {"name": "nas_company_name", "type": "string", "nullable": false}, {"name": "date_bucket", "type": "date", "nullable": false}, {"name": "completed_sessions", "type": "number", "nullable": false}, {"name": "checkout_sla_rate_pct", "type": "string", "nullable": false}, {"name": "extension_rate_pct", "type": "string", "nullable": false}, {"name": "avg_activity_duration", "type": "null", "nullable": true}], "sample_output": [{"nas_market": "Cincinnati", "nas_activity_type": "Radio Upgrade NR", "nas_company_name": "PM Communications", "date_bucket": "2025-10-01", "completed_sessions": 1, "checkout_sla_rate_pct": "100.0000000000000000", "extension_rate_pct": "0E-20", "avg_activity_duration": null}, {"nas_market": "Los Angeles", "nas_activity_type": "Punch Items", "nas_company_name": "ClearPath Telecom", "date_bucket": "2025-10-01", "completed_sessions": 1, "checkout_sla_rate_pct": "100.0000000000000000", "extension_rate_pct": "0E-20", "avg_activity_duration": null}, {"nas_market": "Kansas City", "nas_activity_type": "Tower Inspection", "nas_company_name": "On Air Solutions", "date_bucket": "2025-10-02", "completed_sessions": 1, "checkout_sla_rate_pct": "100.0000000000000000", "extension_rate_pct": "0E-20", "avg_activity_duration": null}], "row_count": 10}', nl_description: 'KPI = aggregates over completed Integration Activity sessions grouped by (nas_market, nas_activity_type, nas_company_name, date_bucket) where completed sessions are those with nas_checkout_approve_time not null. Uses single-table extension proxy: sessions with nas_status_nest_ext IS NULL are treated as completed within original window (checkout_sla_rate_pct), while nas_status_nest_ext IS NOT NULL indicates an extension was needed (extension_rate_pct). Note: avg_activity_duration is included as a throughput/capacity signal, but may be NULL if nas_total_activity_duration is stored as non-numeric text (e.g., \'1h 19m\'); parsing to minutes would be a future enhancement.', node_type: 'CORE', definition: 'KPI = aggregates over completed Integration Activity sessions grouped by (nas_market, nas_activity_type, nas_company_name, date_bucket) where completed sessions are those with nas_checkout_approve_time not null. Uses single-table extension proxy: sessions with nas_status_nest_ext IS NULL are treated as completed within original window (checkout_sla_rate_pct), while nas_status_nest_ext IS NOT NULL indicates an extension was needed (extension_rate_pct). Note: avg_activity_duration is included as a throughput/capacity signal, but may be NULL if nas_total_activity_duration is stored as non-numeric text (e.g., \'1h 19m\'); parsing to minutes would be a future enhancement.', kpi_python_function: 'def get_nas_integration_sla(execute_query, filters=None) -> list[dict]:\n    filters = filters or {}\n\n    # Integration Activity accessor doesn\'t expose required measure fields,\n    # so we aggregate via raw SQL from the session-level combined table.\n\n    # Base predicate: only completed sessions (approve time present)\n    where = ["nas_checkout_approve_time IS NOT NULL"]\n\n    # Date range filtering applies to approve time (the KPI\'s time anchor)\n    if filters.get(\'start_date\') is not None:\n        sd = str(filters.get(\'start_date\')).replace("\'", "\'\'")\n        where.append(f"nas_checkout_approve_time >= \'{sd}\'")\n    if filters.get(\'end_date\') is not None:\n        ed = str(filters.get(\'end_date\')).replace("\'", "\'\'")\n        where.append(f"nas_checkout_approve_time < \'{ed}\'")\n\n    # Optional dimension filters\n    dim_filter_map = {\n        \'nas_market\': \'nas_market\',\n        \'nas_activity_type\': \'nas_activity_type\',\n        \'nas_company_name\': \'nas_company_name\',\n        \'nas_vendor_name\': \'nas_vendor_name\',\n        \'nas_primary_gc\': \'nas_primary_gc\',\n        \'nas_session_id\': \'nas_session_id\',\n        \'nas_site_id\': \'nas_site_id\',\n        \'nas_project_category\': \'nas_project_category\',\n        \'nas_date_period\': \'nas_date_period\'\n    }\n    for fk, col in dim_filter_map.items():\n        if filters.get(fk) is not None:\n            val = str(filters.get(fk)).replace("\'", "\'\'")\n            where.append(f"{col} = \'{val}\'")\n\n    # Time grouping\n    time_grain = (filters.get(\'time_grain\') or filters.get(\'date_bucket_grain\') or \'day\').lower()\n    if time_grain in (\'week\', \'weekly\'):\n        date_bucket_expr = "date_trunc(\'week\', nas_checkout_approve_time)::date"\n    else:\n        date_bucket_expr = "nas_checkout_approve_time::date"\n\n    where_sql = "\\n  AND ".join(where)\n\n    # Option A (single-table): use nas_status_nest_ext as extension proxy.\n    sql = f"""\nSELECT\n  nas_market,\n  nas_activity_type,\n  nas_company_name,\n  {date_bucket_expr} AS date_bucket,\n\n  COUNT(DISTINCT nas_session_id) AS completed_sessions,\n\n  100.0 * COUNT(DISTINCT CASE WHEN nas_status_nest_ext IS NULL THEN nas_session_id END)\n    / NULLIF(COUNT(DISTINCT nas_session_id), 0) AS checkout_sla_rate_pct,\n\n  100.0 * COUNT(DISTINCT CASE WHEN nas_status_nest_ext IS NOT NULL THEN nas_session_id END)\n    / NULLIF(COUNT(DISTINCT nas_session_id), 0) AS extension_rate_pct,\n\n  AVG(nas_total_activity_duration::numeric) AS avg_activity_duration\n\nFROM pwc_macro_staging_schema.stg_nas_session_level_combined_data\nWHERE {where_sql}\nGROUP BY\n  nas_market,\n  nas_activity_type,\n  nas_company_name,\n  {date_bucket_expr}\nORDER BY\n  date_bucket,\n  nas_market,\n  nas_activity_type,\n  nas_company_name\n"""\n\n    return execute_query(sql)\n', kpi_source_columns: ['nas_market', 'nas_activity_type', 'nas_company_name', 'nas_checkout_approve_time', 'nas_session_id', 'nas_total_ext_count_approved', 'nas_total_activity_duration', 'nas_status_nest_ext', 'nas_vendor_name', 'nas_primary_gc', 'nas_site_id', 'nas_project_category', 'nas_date_period'], session_id: '69a3d22f26e208edc083a06e', label: 'NAS Integration SLA', kpi_related_core_node_ids: ['integration_activity'], kpi_relationship_type: 'AGGREGATES', kpi_kpi_id: 'dc2892a1-5c59-4892-b008-e30afd4df123', entity_type: 'kpi', kpi_name: 'NAS Integration SLA', name: 'dc2892a1-5c59-4892-b008-e30afd4df123', kpi_dimensions: ['nas_market', 'nas_activity_type', 'nas_company_name', 'date_bucket', 'nas_vendor_name', 'nas_primary_gc'], kpi_description: 'Measures NAS integration capacity and a proxy for checkout SLA by summarizing completed integration activity sessions. It reports how many sessions were completed and the share completed without needing an extension, segmented by market, activity type, company, and time period.', status: 'mentioned', node_id: 'dc2892a1-5c59-4892-b008-e30afd4df123'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'COUNT(DISTINCT pj_project_id) where pj_a_4425_mw_installation_complete_finish IS NOT NULL AND pj_a_5300_mw_link_final_accepted_and_operational_finish IS NULL.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping field."}, {"column": "m_area", "type": "string", "description": "Area grouping field."}, {"column": "m_market", "type": "string", "description": "Market grouping field."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping field (optional)."}, {"column": "por_regional_dev_initiatives", "type": "string", "description": "Regional development initiative / build plan year or program segmentation grouping field (optional)."}, {"column": "pj_program_name", "type": "string", "description": "Program name grouping field (optional)."}, {"column": "pending_mw_acceptance_count", "type": "int", "description": "Count of distinct projects pending MW link final acceptance."}]', kpi_business_logic: '1) Start with records from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.\n2) Keep only rows where MW installation complete finish date is present (pj_a_4425_mw_installation_complete_finish IS NOT NULL).\n3) Also require MW link final accepted/operational finish date is missing (pj_a_5300_mw_link_final_accepted_and_operational_finish IS NULL).\n4) Count distinct pj_project_id.\n5) Optionally group results by rgn_region, m_area, m_market, and/or construction_gc, por_regional_dev_initiatives, pj_program_name.', kpi_filters: '[{"name": "pj_a_4425_mw_installation_complete_finish", "type": "date", "description": "Include only records where MW installation complete finish date is not null."}, {"name": "pj_a_5300_mw_link_final_accepted_and_operational_finish", "type": "date", "description": "Include only records where MW link final accepted/operational finish date is null."}, {"name": "rgn_region", "type": "string", "description": "Optional slice/filter by region."}, {"name": "m_area", "type": "string", "description": "Optional slice/filter by area."}, {"name": "m_market", "type": "string", "description": "Optional slice/filter by market."}, {"name": "construction_gc", "type": "string", "description": "Optional slice/filter by general contractor."}, {"name": "por_regional_dev_initiatives", "type": "string", "description": "Optional slice/filter by regional development initiative / build plan year or program segmentation."}, {"name": "pj_program_name", "type": "string", "description": "Optional slice/filter by program name."}, {"name": "pj_project_id", "type": "string", "description": "Optional filter to a specific project id."}, {"name": "s_site_id", "type": "string", "description": "Optional filter to a specific site id."}, {"name": "smp_name", "type": "string", "description": "Filter by program name (e.g., NTM, AHLOB Modernization). When NTM, additionally requires smp_status=Active and excludes specific ntm_project_type values."}]', kpi_contract: '{"function_name": "get_pending_mw_acceptance", "node_type": "kpi", "node_id": "86351076-dcbb-42b7-83bf-58eae5481ae8", "node_label": "Pending MW Acceptance", "description": "Counts the number of distinct projects/sites pending microwave link final acceptance. Calculation: COUNT(DISTINCT pj_project_id) from stg_ndpd_mbt_tmobile_macro_combined where pj_a_4425_mw_installation_complete_finish IS NOT NULL (MW installation completed) AND pj_a_5300_mw_link_final_accepted_and_operational_finish IS NULL (MW link not formally accepted/operational). Reportable/groupable by rgn_region, m_area, m_market, and optionally construction_gc and por_regional_dev_initiatives (build plan year/program segmentation). No joins required; all fields are in the same table.", "parameters": [{"name": "group_by", "type": "string", "description": "Filter by group by", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "pending_mw_acceptance_count", "type": "number", "nullable": false}], "sample_output": [{"rgn_region": "CENTRAL", "m_area": "GREAT LAKES", "m_market": "CHICAGO", "pending_mw_acceptance_count": 1}, {"rgn_region": "CENTRAL", "m_area": "GREAT LAKES", "m_market": "CINCINNATI", "pending_mw_acceptance_count": 5}, {"rgn_region": "CENTRAL", "m_area": "GREAT LAKES", "m_market": "CLEVELAND", "pending_mw_acceptance_count": 7}], "row_count": 10}', nl_description: 'Pending MW Acceptance = count of distinct pj_project_id where MW installation complete finish date is present and MW link final accepted/operational finish date is missing, optionally grouped by region/area/market and program segmentation fields.', node_type: 'CORE', definition: 'Pending MW Acceptance = count of distinct pj_project_id where MW installation complete finish date is present and MW link final accepted/operational finish date is missing, optionally grouped by region/area/market and program segmentation fields.', kpi_python_function: 'def get_pending_mw_acceptance(execute_query, filters=None) -> list[dict]:\n    """Counts distinct projects pending MW link final acceptance.\n\n    Definition:\n      MW installation complete date is NOT NULL\n      AND MW link final accepted/operational date is NULL\n      KPI = COUNT(DISTINCT pj_project_id)\n\n    Groupable by: rgn_region, m_area, m_market; optionally construction_gc, por_regional_dev_initiatives.\n\n    Notes:\n      The Tier-1 get_project accessor does not expose the two MW milestone columns, so we use raw SQL.\n    """\n\n    filters = filters or {}\n\n    # Dimensions to group by\n    group_by = filters.get("group_by")\n    if not group_by:\n        group_by_cols = ["rgn_region", "m_area", "m_market"]\n    else:\n        if isinstance(group_by, str):\n            group_by_cols = [c.strip() for c in group_by.split(",") if c.strip()]\n        else:\n            group_by_cols = [str(c).strip() for c in group_by if str(c).strip()]\n\n    # Allowlist group-by columns for safety\n    allowed_group_bys = {\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "por_regional_dev_initiatives",\n        "pj_program_name"\n    }\n    group_by_cols = [c for c in group_by_cols if c in allowed_group_bys]\n    if not group_by_cols:\n        group_by_cols = ["rgn_region", "m_area", "m_market"]\n\n    select_dims = ", ".join(group_by_cols)\n    group_by_sql = ", ".join(group_by_cols)\n\n    where_parts = [\n        "pj_a_4425_mw_installation_complete_finish IS NOT NULL",\n        "pj_a_5300_mw_link_final_accepted_and_operational_finish IS NULL"\n    ]\n\n    # Optional filters\n    # (No explicit date filtering since KPI definition is based on milestone null-ness;\n    #  but allow slicing by region/area/market/gc/program/project/site if provided.)\n    allowed_filters = {\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "por_regional_dev_initiatives",\n        "pj_program_name",\n        "pj_project_id",\n        "s_site_id"\n    }\n    for k, v in (filters or {}).items():\n        if k in ("group_by", "start_date", "end_date"):\n            continue\n        if k not in allowed_filters:\n            continue\n        if v is None or v == "":\n            continue\n        escaped = str(v).replace("\'", "\'\'")\n        where_parts.append(f"{k} = \'{escaped}\'")\n\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = (\n        f"""SELECT {select_dims}, COUNT(DISTINCT pj_project_id) AS pending_mw_acceptance_count FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined WHERE {where_sql} GROUP BY {group_by_sql} ORDER BY {group_by_sql}"""\n    )\n\n    rows = execute_query(sql)\n    return rows\n', kpi_source_columns: ['pj_project_id', 'pj_a_4425_mw_installation_complete_finish', 'pj_a_5300_mw_link_final_accepted_and_operational_finish', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_regional_dev_initiatives', 'pj_program_name', 's_site_id', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Pending MW Acceptance', kpi_related_core_node_ids: ['project'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '86351076-dcbb-42b7-83bf-58eae5481ae8', entity_type: 'kpi', kpi_name: 'Pending MW Acceptance', name: '86351076-dcbb-42b7-83bf-58eae5481ae8', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_regional_dev_initiatives', 'pj_program_name'], kpi_description: 'Counts the number of distinct projects/sites that are pending microwave link final acceptance. This indicates work where MW installation is complete but the link has not yet been formally accepted/operational. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: '86351076-dcbb-42b7-83bf-58eae5481ae8'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined', 'pwc_macro_staging_schema.stg_nas_planned_outage_activity'], nl_business_rule: '', kpi_formula_description: 'ready_site_backlog = COUNT(DISTINCT pj_project_id) per (rgn_region, m_area, m_market, construction_gc) where all universal gates AND all program-branch gates are satisfied. Output is scalar per geo group.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor dimension."}, {"column": "ready_site_backlog", "type": "int", "description": "Count of distinct ready-but-not-started projects in the group."}]', kpi_business_logic: 'Start from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined m. Apply optional dimension/entity equality filters when provided: rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id, pj_program_name, pj_project_status, pj_project_type. Apply universal gates (always): ms_1550_construction_start_actual IS NULL; (ms_1507_tower_ntp_approved_actual IS NOT NULL OR pj_a_4100_construction_ntp_accepted_by_gc_finish IS NOT NULL); pj_a_3925_msl_pickup_date_finish IS NOT NULL; pj_a_4525_power_ready_finish IS NOT NULL; (pj_a_4925_aav_fiber_ready_finish IS NOT NULL OR pj_a_4425_mw_installation_complete_finish IS NOT NULL). If smp_name provided, apply smp_name = \'<value>\'; if smp_name = \'NTM\', also enforce smp_status = \'Active\' and ntm_project_type NOT IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\'). Branch by smp_name containing \'AHLOB\' (case-insensitive). AHLOA branch: LEFT JOIN to a per-site MAX(nas_activity_end_date) sub-query from stg_nas_planned_outage_activity filtered to nas_project_category = \'AHLOB\'; then require the 12 client AHLOA gates above as additional WHERE predicates (CPO, SPO, scoping_package_create_date, punch checklist, crane decision, NAS upload, LL-NTP, 4075/4100 NTP, 3850/3875 BOM). MACRO/default branch: require the 14 client MACRO gates as additional WHERE predicates (3710 RAN, 1310 pre-con package, 1316/1321 walk/drone, 1323 ready-for-scoping, 1327 scoping & quoting, 3850/3875 BOM, steel, 3925 already universal, 1331 scoping package submitted, CPO 1555 so_header, 1555 SPO issued date, 4000 LL-NTP, 1407 tower NTP). Group by (rgn_region, m_area, m_market, construction_gc) and return COUNT(DISTINCT pj_project_id) AS ready_site_backlog.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "pj_program_name", "type": "string", "description": ""}, {"name": "pj_project_status", "type": "string", "description": ""}, {"name": "pj_project_type", "type": "string", "description": ""}, {"name": "start_date", "type": "string", "description": "Accepted but ignored (snapshot as-of now)."}, {"name": "end_date", "type": "string", "description": "Accepted but ignored (snapshot as-of now)."}, {"name": "smp_name", "type": "string", "description": "Filter by program name. AHLOB-substring switches to client\'s 12-gate AHLOA prerequisite set (incl. NAS planned-outage upload). NTM/else uses client\'s 14-gate MACRO set. When NTM, additionally requires smp_status=\'Active\' and excludes specific ntm_project_type values."}]', kpi_contract: '{"function_name": "get_ready_site_backlog", "node_type": "kpi", "node_id": "5976040b-71f0-4f2b-a57e-8db52d8c853d", "node_label": "Ready Site Backlog", "description": "Counts projects that are ready to start construction but have not yet started, shown by market and general contractor as of the current date. Aligned with client\'s Milestone Readiness (AHLOA-B / Macro) gate columns: smp_name containing \'AHLOB\' branches to the 12 client AHLOA prerequisites (incl. NAS planned-outage JOIN); otherwise to the 14 client MACRO prerequisites. Legacy universal gates (NTP, MSL, power, backhaul) are retained and AND\'d with the program gates. All gates are hard WHERE predicates.", "parameters": [], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "ready_site_backlog", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Counts distinct projects that are ready to start construction but have not yet started, shown by (rgn_region, m_area, m_market, construction_gc). Universal hard gates: ms_1550_construction_start_actual IS NULL; NTP cleared (ms_1507_tower_ntp_approved_actual OR pj_a_4100); pj_a_3925 MSL pickup; pj_a_4525 power ready; (pj_a_4925 AAV fiber OR pj_a_4425 MW installation) backhaul. Program-specific gates are added based on smp_name: if smp_name contains \'AHLOB\' (case-insensitive), the 12 client AHLOA-B prerequisites are added (CPO 1555 cpo_custom_field, SPO 1555 spo_issued_date, scoping_package_create_date, ms_1557 punch checklist, scoping_package_crane_required IN (\'Yes\',\'No\'), NAS planned-outage upload via LEFT JOIN to stg_nas_planned_outage_activity (category=\'AHLOB\'), pj_a_4000 LL-NTP received, pj_a_4075/4100 construction NTP, pj_a_3850/3875 BOM); otherwise the 14 client MACRO prerequisites are added (pj_a_3710 RAN entitlement, ms_1310 pre-construction package, ms_1316/1321 site-walk or drone, ms_1323 ready-for-scoping, ms_1327 scoping & quoting validated, pj_a_3850/3875 BOM, steel received/NA, ms_1331 scoping package submitted, CPO 1555 so_header non-empty, 1555 SPO issued date, pj_a_4000 LL-NTP received, ms_1407 tower NTP validated). All gates are hard WHERE predicates — a project must satisfy them all to be counted. start_date/end_date inputs accepted but ignored (snapshot as-of now).', node_type: 'CORE', definition: 'Counts distinct projects that are ready to start construction but have not yet started, shown by (rgn_region, m_area, m_market, construction_gc). Universal hard gates: ms_1550_construction_start_actual IS NULL; NTP cleared (ms_1507_tower_ntp_approved_actual OR pj_a_4100); pj_a_3925 MSL pickup; pj_a_4525 power ready; (pj_a_4925 AAV fiber OR pj_a_4425 MW installation) backhaul. Program-specific gates are added based on smp_name: if smp_name contains \'AHLOB\' (case-insensitive), the 12 client AHLOA-B prerequisites are added (CPO 1555 cpo_custom_field, SPO 1555 spo_issued_date, scoping_package_create_date, ms_1557 punch checklist, scoping_package_crane_required IN (\'Yes\',\'No\'), NAS planned-outage upload via LEFT JOIN to stg_nas_planned_outage_activity (category=\'AHLOB\'), pj_a_4000 LL-NTP received, pj_a_4075/4100 construction NTP, pj_a_3850/3875 BOM); otherwise the 14 client MACRO prerequisites are added (pj_a_3710 RAN entitlement, ms_1310 pre-construction package, ms_1316/1321 site-walk or drone, ms_1323 ready-for-scoping, ms_1327 scoping & quoting validated, pj_a_3850/3875 BOM, steel received/NA, ms_1331 scoping package submitted, CPO 1555 so_header non-empty, 1555 SPO issued date, pj_a_4000 LL-NTP received, ms_1407 tower NTP validated). All gates are hard WHERE predicates — a project must satisfy them all to be counted. start_date/end_date inputs accepted but ignored (snapshot as-of now).', kpi_python_function: 'def get_ready_site_backlog(execute_query, filters=None) -> list[dict]:\n    """Counts ready-but-not-started projects per (rgn_region, m_area, m_market, construction_gc) as-of CURRENT_DATE.\n\n    Hard-required gates: a project must satisfy ALL gates (AND\'d in WHERE) to be counted.\n\n    Universal gates (always required):\n      - ms_1550_construction_start_actual IS NULL                 (CX not started)\n      - ms_1507_tower_ntp_approved_actual IS NOT NULL OR\n        pj_a_4100_construction_ntp_accepted_by_gc_finish IS NOT NULL  (NTP cleared)\n      - pj_a_3925_msl_pickup_date_finish IS NOT NULL              (MSL pickup)\n      - pj_a_4525_power_ready_finish IS NOT NULL                  (Power ready)\n      - pj_a_4925_aav_fiber_ready_finish IS NOT NULL OR\n        pj_a_4425_mw_installation_complete_finish IS NOT NULL     (Backhaul ready)\n\n    Program-specific gates (branched by smp_name):\n      - If smp_name contains AHLOB (case-insensitive) → 12 AHLOA prerequisites are added:\n          CPO (1555 cpo custom field), SPO (1555 spo_issued_date), scoping_package_create_date,\n          ms_1557 punch checklist, scoping_package_crane_required IN (\'Yes\',\'No\'),\n          NAS planned-outage upload (LEFT JOIN stg_nas_planned_outage_activity category=\'AHLOB\'),\n          pj_a_4000_ll_ntp_received, pj_a_4075 NTP submitted, pj_a_4100 NTP accepted,\n          pj_a_3850 BOM submitted, pj_a_3875 BOM received, pj_a_3925 MSL pickup.\n      - Otherwise (MACRO/default) → 14 MACRO prerequisites are added:\n          pj_a_3710 RAN entitlement, ms_1310 pre-construction package,\n          ms_1316 site-walk OR ms_1321 drone, ms_1323 ready-for-scoping,\n          ms_1327 scoping & quoting validated, pj_a_3850 BOM submitted,\n          pj_a_3875 BOM received, steel received/NA logic, pj_a_3925 MSL pickup,\n          ms_1331 scoping package submitted, CPO (1555 so_header non-empty),\n          1555 SPO issued date, pj_a_4000 LL-NTP received, ms_1407 tower NTP validated.\n\n    Allowed filters (date filters accepted but ignored):\n      rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id,\n      pj_program_name, pj_project_status, pj_project_type, start_date, end_date,\n      smp_name (with NTM conditional extras).\n    """\n    filters = filters or {}\n\n    def _esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    where_parts = []\n\n    # Optional entity filters (non-date). Unknown keys are ignored.\n    for k in (\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "pj_project_id",\n        "s_site_id",\n        "pj_program_name",\n        "pj_project_status",\n        "pj_project_type",\n    ):\n        v = filters.get(k)\n        if v is None:\n            continue\n        where_parts.append(f"m.{k} = \'{_esc(v)}\'")\n\n    # ---- Universal gates (kept from original logic) ----\n    where_parts.append("m.ms_1550_construction_start_actual IS NULL")\n    where_parts.append(\n        "(m.ms_1507_tower_ntp_approved_actual IS NOT NULL "\n        "OR m.pj_a_4100_construction_ntp_accepted_by_gc_finish IS NOT NULL)"\n    )\n    where_parts.append(\'m."pj_a_3925_msl_pickup_date_finish" IS NOT NULL\')\n    where_parts.append("m.pj_a_4525_power_ready_finish IS NOT NULL")\n    where_parts.append(\n        "(m.pj_a_4925_aav_fiber_ready_finish IS NOT NULL "\n        "OR m.pj_a_4425_mw_installation_complete_finish IS NOT NULL)"\n    )\n\n    # ---- Program detection ----\n    smp_name = filters.get("smp_name")\n    is_ahlob = bool(smp_name) and ("AHLOB" in str(smp_name).upper())\n\n    # Program filter with NTM conditional\n    if smp_name:\n        v = str(smp_name).replace("\'", "\'\'")\n        where_parts.append(f"m.\\"smp_name\\" = \'{v}\'")\n        if v.strip().upper() == \'NTM\':\n            where_parts.append("m.\\"smp_status\\" = \'Active\'")\n            where_parts.append("m.\\"ntm_project_type\\" NOT IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\')")\n\n    # ---- Program-specific client gates (added on top of universals) ----\n    needs_nas_join = False\n\n    if is_ahlob:\n        # 12 client AHLOA gates\n        where_parts.extend([\n            # 1) CPO (AHLOA column)\n            "COALESCE(TRIM(m.ms_1555_construction_complete_cpo_custom_field::text), \'\') <> \'\'",\n            # 2) SPO / GC-CX\n            "m.ms1555_construction_complete_spo_issued_date IS NOT NULL",\n            # 3) Talon scoping package\n            "m.scoping_package_create_date IS NOT NULL",\n            # 4) Punch checklist submitted to TMO ATL\n            "m.ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl IS NOT NULL",\n            # 5) Crane decision\n            "m.scoping_package_crane_required IN (\'Yes\', \'No\')",\n            # 6) NAS planned-outage upload (requires JOIN; gate predicate added below)\n            # 7) LL-NTP received\n            "COALESCE(TRIM(m.pj_a_4000_ll_ntp_received::text), \'\') <> \'\'",\n            # 8) 4075 construction NTP submitted to GC\n            "m.pj_a_4075_construction_ntp_submitted_to_gc_finish IS NOT NULL",\n            # 9) 4100 already covered by universal NTP OR; explicitly require it too\n            "m.pj_a_4100_construction_ntp_accepted_by_gc_finish IS NOT NULL",\n            # 10) BOM submitted (BAT)\n            "m.pj_a_3850_bom_submitted_bom_in_bat_finish IS NOT NULL",\n            # 11) BOM received in AIMS\n            "m.pj_a_3875_bom_received_bom_in_aims_finish IS NOT NULL",\n            # 12) 3925 MSL pickup already in universal gates\n        ])\n        # NAS planned-outage upload gate\n        needs_nas_join = True\n        where_parts.append("nas.nas_activity_end_date IS NOT NULL")\n    else:\n        # 14 client MACRO gates\n        where_parts.extend([\n            # 1) RAN entitlement\n            "m.pj_a_3710_ran_entitlement_complete_finish IS NOT NULL",\n            # 2) Pre-construction package received\n            "m.ms_1310_pre_construction_package_received_actual IS NOT NULL",\n            # 3) Site-walk OR drone\n            "(m.ms_1316_pre_con_site_walk_completed_actual IS NOT NULL "\n            "OR m.ms_1321_talon_view_drone_svcs_actual IS NOT NULL)",\n            # 4) Ready for scoping\n            "m.ms_1323_ready_for_scoping_actual IS NOT NULL",\n            # 5) Scoping & quoting validated\n            "m.ms_1327_scoping_and_quoting_package_validated_actual IS NOT NULL",\n            # 6) BOM submitted (BAT)\n            "m.pj_a_3850_bom_submitted_bom_in_bat_finish IS NOT NULL",\n            # 7) BOM received in AIMS\n            "m.pj_a_3875_bom_received_bom_in_aims_finish IS NOT NULL",\n            # 8) Steel received / NA\n            "(COALESCE(TRIM(m.pj_steel_received_status), \'\') IN (\'N\', \'Not Applicable\', \'\') "\n            "OR (TRIM(m.pj_steel_received_status) = \'A\' AND m.pj_steel_received_date IS NOT NULL))",\n            # 9) 3925 MSL pickup already in universal gates\n            # 10) Scoping package submitted\n            "m.ms_1331_scoping_package_submitted_actual IS NOT NULL",\n            # 11) CPO (MACRO column)\n            "COALESCE(TRIM(m.ms1555_construction_complete_so_header::text), \'\') <> \'\'",\n            # 12) 1555 SPO issued\n            "m.ms1555_construction_complete_spo_issued_date IS NOT NULL",\n            # 13) LL-NTP received\n            "COALESCE(TRIM(m.pj_a_4000_ll_ntp_received::text), \'\') <> \'\'",\n            # 14) Tower NTP validated\n            "m.ms_1407_tower_ntp_validated_actual IS NOT NULL",\n        ])\n\n    where_sql = " AND ".join(where_parts) if where_parts else "TRUE"\n\n    join_sql = ""\n    if needs_nas_join:\n        join_sql = (\n            "LEFT JOIN ("\n            "SELECT nas_site_id, MAX(nas_activity_end_date) AS nas_activity_end_date "\n            "FROM pwc_macro_staging_schema.stg_nas_planned_outage_activity "\n            "WHERE nas_project_category = \'AHLOB\' "\n            "GROUP BY nas_site_id"\n            ") nas ON nas.nas_site_id = m.s_site_id"\n        )\n\n    sql = f"""\n        SELECT\n            m.rgn_region,\n            m.m_area,\n            m.m_market,\n            m.construction_gc,\n            COUNT(DISTINCT m.pj_project_id) AS ready_site_backlog\n        FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined m\n        {join_sql}\n        WHERE {where_sql}\n        GROUP BY m.rgn_region, m.m_area, m.m_market, m.construction_gc\n        ORDER BY m.rgn_region, m.m_area, m.m_market, m.construction_gc\n    """.strip()\n\n    return execute_query(sql)\n', kpi_source_columns: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_project_id', 's_site_id', 'pj_program_name', 'pj_project_status', 'pj_project_type', 'ms_1550_construction_start_actual', 'ms_1507_tower_ntp_approved_actual', 'pj_a_4100_construction_ntp_accepted_by_gc_finish', 'pj_a_3925_msl_pickup_date_finish', 'pj_a_4525_power_ready_finish', 'pj_a_4925_aav_fiber_ready_finish', 'pj_a_4425_mw_installation_complete_finish', 'smp_name', 'smp_status', 'ntm_project_type', 'ms_1555_construction_complete_cpo_custom_field', 'ms1555_construction_complete_spo_issued_date', 'scoping_package_create_date', 'ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl', 'scoping_package_crane_required', 'pj_a_4000_ll_ntp_received', 'pj_a_4075_construction_ntp_submitted_to_gc_finish', 'pj_a_3850_bom_submitted_bom_in_bat_finish', 'pj_a_3875_bom_received_bom_in_aims_finish', 'pj_a_3710_ran_entitlement_complete_finish', 'ms_1310_pre_construction_package_received_actual', 'ms_1316_pre_con_site_walk_completed_actual', 'ms_1321_talon_view_drone_svcs_actual', 'ms_1323_ready_for_scoping_actual', 'ms_1327_scoping_and_quoting_package_validated_actual', 'pj_steel_received_status', 'pj_steel_received_date', 'ms_1331_scoping_package_submitted_actual', 'ms1555_construction_complete_so_header', 'ms_1407_tower_ntp_validated_actual', 'nas_site_id', 'nas_activity_end_date', 'nas_project_category'], session_id: '69a3d22f26e208edc083a06e', label: 'Ready Site Backlog', kpi_related_core_node_ids: ['project', 'market', 'general_contractor'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '5976040b-71f0-4f2b-a57e-8db52d8c853d', entity_type: 'kpi', kpi_name: 'Ready Site Backlog', name: '5976040b-71f0-4f2b-a57e-8db52d8c853d', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Counts distinct projects that are ready to start construction but have not yet started, shown by (rgn_region, m_area, m_market, construction_gc). Universal hard gates: ms_1550_construction_start_actual IS NULL; NTP cleared (ms_1507_tower_ntp_approved_actual OR pj_a_4100); pj_a_3925 MSL pickup; pj_a_4525 power ready; (pj_a_4925 AAV fiber OR pj_a_4425 MW installation) backhaul. Program-specific gates are added based on smp_name: if smp_name contains \'AHLOB\' (case-insensitive), the 12 client AHLOA-B prerequisites are added (CPO 1555 cpo_custom_field, SPO 1555 spo_issued_date, scoping_package_create_date, ms_1557 punch checklist, scoping_package_crane_required IN (\'Yes\',\'No\'), NAS planned-outage upload via LEFT JOIN to stg_nas_planned_outage_activity (category=\'AHLOB\'), pj_a_4000 LL-NTP received, pj_a_4075/4100 construction NTP, pj_a_3850/3875 BOM); otherwise the 14 client MACRO prerequisites are added (pj_a_3710 RAN entitlement, ms_1310 pre-construction package, ms_1316/1321 site-walk or drone, ms_1323 ready-for-scoping, ms_1327 scoping & quoting validated, pj_a_3850/3875 BOM, steel received/NA, ms_1331 scoping package submitted, CPO 1555 so_header non-empty, 1555 SPO issued date, pj_a_4000 LL-NTP received, ms_1407 tower NTP validated). All gates are hard WHERE predicates — a project must satisfy them all to be counted. start_date/end_date inputs accepted but ignored (snapshot as-of now).', status: 'mentioned', node_id: '5976040b-71f0-4f2b-a57e-8db52d8c853d'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_hse_site_checklist', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'compliance_rate_pct = 100.0 * compliant_reviews / NULLIF(attempted_reviews, 0), where attempted_reviews = COUNT(a.smp_id) (NON-distinct, matches client) over the hse_table CTE (checklist rows where gsd_hse_review_check_date IS NOT NULL AND check_in_status IS NOT NULL AND non_compliance_status IS NOT NULL plus optional smp_name and other checklist-side filters). compliant_reviews = COUNT(CASE WHEN LOWER(a.non_compliance_status) = \'ok\' THEN a.smp_id END). Joined to combined_table (SELECT DISTINCT smp_id, rgn_region, m_area, m_market, construction_gc FROM macro_combined - no WHERE) on smp_id. Optional geo filters are applied in the outer WHERE so combined_table stays unfiltered. Grouped by rgn_region, m_area, m_market, construction_gc.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region from macro_combined."}, {"column": "m_area", "type": "string", "description": "Area from macro_combined."}, {"column": "m_market", "type": "string", "description": "Market from macro_combined."}, {"column": "construction_gc", "type": "string", "description": "General contractor from macro_combined."}, {"column": "attempted_reviews", "type": "int", "description": "COUNT(a.smp_id) over hse_table after filters; non-distinct review-row count."}, {"column": "compliant_reviews", "type": "int", "description": "Review rows where LOWER(non_compliance_status) = \'ok\'."}, {"column": "compliance_rate_pct", "type": "float", "description": "100 * compliant_reviews / attempted_reviews."}, {"column": "non_compliant_count", "type": "int", "description": "Review rows where LOWER(non_compliance_status) = \'not ok\'."}, {"column": "fail_check_in_count", "type": "int", "description": "Review rows where LOWER(check_in_status) = \'not done\'."}, {"column": "fail_ppe_count", "type": "int", "description": "Review rows where LOWER(ppe_validation) IN (\'fail\',\'failed\')."}, {"column": "fail_jsa_count", "type": "int", "description": "Review rows where LOWER(jsa_completion_status) = \'not completed\'."}, {"column": "fail_ptid_l2w_count", "type": "int", "description": "Review rows where LOWER(each_crew_ptid_l2w_status) = \'not available\'."}]', kpi_business_logic: 'Two-CTE pattern (matches client query). 1) hse_table CTE: SELECT smp_id, non_compliance_status, check_in_status, ppe_validation, jsa_completion_status, each_crew_ptid_l2w_status FROM stg_ndpd_hse_site_checklist with WHERE gsd_hse_review_check_date IS NOT NULL AND check_in_status IS NOT NULL AND non_compliance_status IS NOT NULL, plus optional date range (gsd_hse_review_check_date::date between start_date and end_date), optional smp_name (applied to checklist\'s smp_name column, not macro), and optional checklist-side filters (customer_name, hse_status, non_compliance_status, hse_engineer_name). 2) combined_table CTE: SELECT DISTINCT smp_id, rgn_region, m_area, m_market, construction_gc FROM stg_ndpd_mbt_tmobile_macro_combined - NO WHERE clause; this side stays clean. 3) Outer query: hse_table a JOIN combined_table b ON a.smp_id = b.smp_id, optionally constrained by post-JOIN geo filters (b.rgn_region, b.m_area, b.m_market, b.construction_gc, b.smp_id) supplied via filters dict. 4) GROUP BY b.rgn_region, b.m_area, b.m_market, b.construction_gc. 5) attempted_reviews = COUNT(a.smp_id) (NON-distinct - one count per surviving review row). 6) compliant_reviews = COUNT(CASE WHEN LOWER(a.non_compliance_status) = \'ok\' THEN a.smp_id END). 7) compliance_rate_pct = 100.0 * compliant_reviews / NULLIF(attempted_reviews, 0). 8) Diagnostic gate counts (each non-distinct, LOWER-matched): non_compliant_count where LOWER(non_compliance_status) = \'not ok\'; fail_check_in_count where LOWER(check_in_status) = \'not done\'; fail_ppe_count where LOWER(ppe_validation) IN (\'fail\',\'failed\'); fail_jsa_count where LOWER(jsa_completion_status) = \'not completed\'; fail_ptid_l2w_count where LOWER(each_crew_ptid_l2w_status) = \'not available\'.', kpi_filters: '[{"name": "start_date", "type": "date", "description": "Inside hse_table: gsd_hse_review_check_date::date >= DATE \'start_date\'."}, {"name": "end_date", "type": "date", "description": "Inside hse_table: gsd_hse_review_check_date::date < DATE \'end_date\'."}, {"name": "smp_name", "type": "string", "description": "Inside hse_table: filters by checklist\'s smp_name (e.g., \'NTM\', \'AHLOB Modernization\')."}, {"name": "rgn_region", "type": "string", "description": "Outer WHERE on b.rgn_region (post-JOIN; combined_table stays unfiltered)."}, {"name": "m_area", "type": "string", "description": "Outer WHERE on b.m_area."}, {"name": "m_market", "type": "string", "description": "Outer WHERE on b.m_market."}, {"name": "construction_gc", "type": "string", "description": "Outer WHERE on b.construction_gc."}, {"name": "smp_id", "type": "string", "description": "Outer WHERE on b.smp_id."}, {"name": "customer_name", "type": "string", "description": "Inside hse_table: filters by customer_name."}, {"name": "hse_status", "type": "string", "description": "Inside hse_table: filters by hse_status."}, {"name": "non_compliance_status", "type": "string", "description": "Inside hse_table: filters by non_compliance_status (case-sensitive equality; \'Ok\' / \'Not Ok\')."}, {"name": "hse_engineer_name", "type": "string", "description": "Inside hse_table: filters by hse_engineer_name."}]', kpi_contract: '{"function_name": "get_hse_compliance_rate", "node_type": "kpi", "node_id": "313756f8-da42-470a-998f-dc558b1940f3", "node_label": "H&S/HSE Compliance Rate", "description": "Percent of HSE reviews that pass H&S/HSE compliance, computed at non-distinct review-row grain and rolled up by macro project geo dims (rgn_region, m_area, m_market, construction_gc). Two-CTE structure mirrors client query: `hse_table` carries all row-level filters (3 mandatory NOT NULL filters + optional date range, smp_name, and checklist-side filters); `combined_table` is `SELECT DISTINCT smp_id, geo_dims FROM macro_combined` with NO WHERE clause. Inner JOIN on smp_id; optional geo filters apply in the outer WHERE.\\n\\nattempted_reviews = COUNT(a.smp_id) (NON-distinct).\\ncompliant_reviews = COUNT(CASE WHEN LOWER(non_compliance_status) = \'ok\' THEN smp_id END).\\ncompliance_rate_pct = 100.0 * compliant_reviews / NULLIF(attempted_reviews, 0).\\n\\nPer-gate diagnostic fail counts (also non-distinct, LOWER-matched):\\n- non_compliant_count: LOWER(non_compliance_status) = \'not ok\'\\n- fail_check_in_count: LOWER(check_in_status) = \'not done\'\\n- fail_ppe_count: LOWER(ppe_validation) IN (\'fail\',\'failed\')\\n- fail_jsa_count: LOWER(jsa_completion_status) = \'not completed\'\\n- fail_ptid_l2w_count: LOWER(each_crew_ptid_l2w_status) = \'not available\'\\n\\nH&S and HSE are synonyms - both refer to this same KPI.", "parameters": [{"name": "start_date", "type": "date", "description": "hse_table WHERE: gsd_hse_review_check_date::date >= DATE.", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "hse_table WHERE: gsd_hse_review_check_date::date < DATE.", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "hse_table WHERE on checklist smp_name (e.g., \'NTM\', \'AHLOB Modernization\').", "required": false, "sample_values": ["NTM", "AHLOB Modernization"]}, {"name": "rgn_region", "type": "string", "description": "Outer WHERE on b.rgn_region.", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Outer WHERE on b.m_area.", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Outer WHERE on b.m_market.", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Outer WHERE on b.construction_gc.", "required": false, "sample_values": []}, {"name": "non_compliance_status", "type": "string", "description": "hse_table WHERE on non_compliance_status (\'Ok\' or \'Not Ok\').", "required": false, "sample_values": ["Ok", "Not Ok"]}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": true}, {"name": "m_area", "type": "string", "nullable": true}, {"name": "m_market", "type": "string", "nullable": true}, {"name": "construction_gc", "type": "string", "nullable": true}, {"name": "attempted_reviews", "type": "number", "nullable": false}, {"name": "compliant_reviews", "type": "number", "nullable": false}, {"name": "compliance_rate_pct", "type": "number", "nullable": true}, {"name": "non_compliant_count", "type": "number", "nullable": false}, {"name": "fail_check_in_count", "type": "number", "nullable": false}, {"name": "fail_ppe_count", "type": "number", "nullable": false}, {"name": "fail_jsa_count", "type": "number", "nullable": false}, {"name": "fail_ptid_l2w_count", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'H&S/HSE Compliance Rate = 100 * (review rows with LOWER(non_compliance_status) = \'ok\') / (review rows with all three of gsd_hse_review_check_date, check_in_status, non_compliance_status NOT NULL), grouped by (rgn_region, m_area, m_market, construction_gc). Built via two CTEs: hse_table (checklist + filters) and combined_table (SELECT DISTINCT smp_id, geo_dims FROM macro - no WHERE). INNER JOIN on smp_id. Counts are NON-distinct (each surviving review row counts). Includes diagnostic per-gate fail counts (PPE, JSA, PTID L2W, check-in). H&S and HSE are synonyms.', node_type: 'CORE', definition: 'H&S/HSE Compliance Rate = 100 * (review rows with LOWER(non_compliance_status) = \'ok\') / (review rows with all three of gsd_hse_review_check_date, check_in_status, non_compliance_status NOT NULL), grouped by (rgn_region, m_area, m_market, construction_gc). Built via two CTEs: hse_table (checklist + filters) and combined_table (SELECT DISTINCT smp_id, geo_dims FROM macro - no WHERE). INNER JOIN on smp_id. Counts are NON-distinct (each surviving review row counts). Includes diagnostic per-gate fail counts (PPE, JSA, PTID L2W, check-in). H&S and HSE are synonyms.', kpi_python_function: 'def get_hse_compliance_rate(execute_query, filters=None) -> list[dict]:\n    """H&S/HSE Compliance Rate.\n\n    Grain: one row per (rgn_region, m_area, m_market, construction_gc).\n\n    Two-CTE structure (matches client pattern):\n      - `hse_table`: pulls checklist rows with all row-level filters applied\n        (3 mandatory NOT NULL filters + optional date range, smp_name,\n        customer_name, hse_status, non_compliance_status, hse_engineer_name). No DISTINCT here -\n        each surviving review row is one count unit.\n      - `combined_table`: `SELECT DISTINCT smp_id, rgn_region, m_area,\n        m_market, construction_gc` from macro_combined. NO WHERE - the\n        client\'s pattern keeps this side clean.\n\n    Then INNER JOIN on smp_id and aggregate. Optional geo filters\n    (rgn_region, m_area, m_market, construction_gc, smp_id) are applied in\n    the outer WHERE so combined_table stays unfiltered.\n\n    Counting (matches client - no DISTINCT, case-insensitive match on the\n    pass/fail signal columns):\n      - attempted_reviews   = COUNT(a.smp_id)\n      - compliant_reviews   = COUNT(CASE WHEN LOWER(non_compliance_status)=\'ok\'      THEN smp_id END)\n      - non_compliant_count = COUNT(CASE WHEN LOWER(non_compliance_status)=\'not ok\'  THEN smp_id END)\n      - compliance_rate_pct = 100.0 * compliant_reviews / NULLIF(attempted_reviews, 0)\n\n    Diagnostic per-gate fail counts (also non-distinct, LOWER-matched):\n      - fail_check_in_count  : check_in_status            = \'not done\'\n      - fail_ppe_count       : ppe_validation             IN (\'fail\',\'failed\')\n      - fail_jsa_count       : jsa_completion_status      = \'not completed\'\n      - fail_ptid_l2w_count  : each_crew_ptid_l2w_status  = \'not available\'\n    """\n\n    def _esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    filters = filters or {}\n\n    # ---- hse_table filters (checklist side; client\'s pattern) ----\n    hse_where = [\n        "\\"gsd_hse_review_check_date\\" IS NOT NULL",\n        "\\"check_in_status\\" IS NOT NULL",\n        "\\"non_compliance_status\\" IS NOT NULL",\n    ]\n    if filters.get("start_date"):\n        hse_where.append(\n            f"\\"gsd_hse_review_check_date\\"::date >= DATE \'{_esc(filters[\'start_date\'])}\'"\n        )\n    if filters.get("end_date"):\n        hse_where.append(\n            f"\\"gsd_hse_review_check_date\\"::date < DATE \'{_esc(filters[\'end_date\'])}\'"\n        )\n    if filters.get("smp_name"):\n        hse_where.append(f"\\"smp_name\\" = \'{_esc(filters[\'smp_name\'])}\'")\n\n    for k in [\n        "customer_name",\n        "hse_status",\n        "non_compliance_status",\n        "hse_engineer_name",\n    ]:\n        v = filters.get(k)\n        if v is not None and v != "":\n            hse_where.append(f"\\"{k}\\" = \'{_esc(v)}\'")\n\n    hse_where_sql = "WHERE " + " AND ".join(hse_where)\n\n    # ---- Outer (post-JOIN) geo filters; combined_table itself stays unfiltered ----\n    outer_where = []\n    for k in ["rgn_region", "m_area", "m_market", "construction_gc"]:\n        v = filters.get(k)\n        if v is not None and v != "":\n            outer_where.append(f"b.\\"{k}\\" = \'{_esc(v)}\'")\n    if filters.get("smp_id"):\n        outer_where.append(f"b.\\"smp_id\\" = \'{_esc(filters[\'smp_id\'])}\'")\n    outer_where_sql = ("WHERE " + " AND ".join(outer_where)) if outer_where else ""\n\n    sql = f"""\n        WITH hse_table AS (\n            SELECT\n                "smp_id",\n                "non_compliance_status",\n                "check_in_status",\n                "ppe_validation",\n                "jsa_completion_status",\n                "each_crew_ptid_l2w_status"\n            FROM "pwc_macro_staging_schema"."stg_ndpd_hse_site_checklist"\n            {hse_where_sql}\n        ),\n        combined_table AS (\n            SELECT DISTINCT\n                "smp_id",\n                "rgn_region",\n                "m_area",\n                "m_market",\n                "construction_gc"\n            FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n        )\n        SELECT\n            b."rgn_region",\n            b."m_area",\n            b."m_market",\n            b."construction_gc",\n\n            COUNT(a."smp_id") AS attempted_reviews,\n\n            COUNT(CASE WHEN LOWER(a."non_compliance_status") = \'ok\'\n                       THEN a."smp_id" END) AS compliant_reviews,\n\n            (100.0 *\n                COUNT(CASE WHEN LOWER(a."non_compliance_status") = \'ok\'\n                           THEN a."smp_id" END)\n                / NULLIF(COUNT(a."smp_id"), 0)\n            ) AS compliance_rate_pct,\n\n            COUNT(CASE WHEN LOWER(a."non_compliance_status") = \'not ok\'\n                       THEN a."smp_id" END) AS non_compliant_count,\n\n            COUNT(CASE WHEN LOWER(a."check_in_status") = \'not done\'\n                       THEN a."smp_id" END) AS fail_check_in_count,\n\n            COUNT(CASE WHEN LOWER(a."ppe_validation") IN (\'fail\',\'failed\')\n                       THEN a."smp_id" END) AS fail_ppe_count,\n\n            COUNT(CASE WHEN LOWER(a."jsa_completion_status") = \'not completed\'\n                       THEN a."smp_id" END) AS fail_jsa_count,\n\n            COUNT(CASE WHEN LOWER(a."each_crew_ptid_l2w_status") = \'not available\'\n                       THEN a."smp_id" END) AS fail_ptid_l2w_count\n\n        FROM hse_table a\n        JOIN combined_table b\n            ON a."smp_id" = b."smp_id"\n        {outer_where_sql}\n        GROUP BY\n            b."rgn_region",\n            b."m_area",\n            b."m_market",\n            b."construction_gc"\n        ORDER BY\n            b."rgn_region",\n            b."m_area",\n            b."m_market",\n            b."construction_gc"\n    """\n\n    return execute_query(sql, db="public")', kpi_source_columns: ['stg_ndpd_hse_site_checklist.smp_id', 'stg_ndpd_hse_site_checklist.smp_name', 'stg_ndpd_hse_site_checklist.gsd_hse_review_check_date', 'stg_ndpd_hse_site_checklist.check_in_status', 'stg_ndpd_hse_site_checklist.ppe_validation', 'stg_ndpd_hse_site_checklist.jsa_completion_status', 'stg_ndpd_hse_site_checklist.each_crew_ptid_l2w_status', 'stg_ndpd_hse_site_checklist.non_compliance_status', 'stg_ndpd_hse_site_checklist.customer_name', 'stg_ndpd_hse_site_checklist.hse_status', 'stg_ndpd_hse_site_checklist.hse_engineer_name', 'stg_ndpd_mbt_tmobile_macro_combined.smp_id', 'stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'stg_ndpd_mbt_tmobile_macro_combined.m_area', 'stg_ndpd_mbt_tmobile_macro_combined.m_market', 'stg_ndpd_mbt_tmobile_macro_combined.construction_gc'], session_id: '69a3d22f26e208edc083a06e', label: 'H&S/HSE Compliance Rate', kpi_related_core_node_ids: ['customer'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '313756f8-da42-470a-998f-dc558b1940f3', entity_type: 'kpi', kpi_name: 'H&S/HSE Compliance Rate', name: '313756f8-da42-470a-998f-dc558b1940f3', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Percent of HSE reviews that pass H&S/HSE compliance at review-row grain, rolled up by macro project geo dims (rgn_region, m_area, m_market, construction_gc). Built via two CTEs: hse_table holds the filtered checklist rows (3 mandatory NOT NULL filters: gsd_hse_review_check_date, check_in_status, non_compliance_status; plus optional smp_name (checklist-side), date range, and other checklist filters); combined_table is SELECT DISTINCT smp_id + geo dims from macro_combined with NO WHERE. INNER JOIN on smp_id. Counts are NON-distinct so the same project can contribute multiple review rows. compliant_reviews uses LOWER(non_compliance_status) = \'ok\'. Per-gate diagnostic fail counts use LOWER-matched values for \'Not Done\', \'Fail/Failed\', \'Not Completed\', \'Not Available\'. H&S and HSE are synonyms.', status: 'mentioned', node_id: '313756f8-da42-470a-998f-dc558b1940f3'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Computes Capacity vs Demand Gap by (rgn_region, m_area, m_market, construction_gc). Let N = trailing_weeks (default 12). run_rate = COUNT(DISTINCT projects with ms_1555_construction_complete_actual in the last N weeks) / N. backlog = COUNT(DISTINCT projects where ms_1550_construction_start_actual is NULL and the 4 readiness gates are satisfied). gap = run_rate − backlog.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region."}, {"column": "m_area", "type": "string", "description": "Area."}, {"column": "m_market", "type": "string", "description": "Market."}, {"column": "construction_gc", "type": "string", "description": "General contractor."}, {"column": "run_rate", "type": "float", "description": "Average weekly distinct completed projects over the trailing 12 weeks (completed_12w / 12)."}, {"column": "backlog", "type": "int", "description": "Count of distinct projects that meet readiness gates and have not started as of CURRENT_DATE."}, {"column": "gap", "type": "float", "description": "Capacity vs demand gap (run_rate minus backlog)."}]', kpi_business_logic: 'Read trailing_weeks from filters (default 12); coerce to a positive integer; if invalid/non-positive, use 12.\nConstruct a WHERE clause seeded with \'1=1\' and append allowlisted optional filters: rgn_region, m_area, m_market, construction_gc, pj_program_name, pj_project_type. This ensures subqueries can safely append additional predicates with AND.\nBuild a group spine as distinct (rgn_region, m_area, m_market, construction_gc) from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined, excluding NULL construction_gc and NULL m_market.\nCompute completed_nw per group by counting distinct pj_project_id where ms_1555_construction_complete_actual is not NULL and is within the trailing window: completed_ts >= CURRENT_DATE - (N*7 days) and < CURRENT_DATE + 1 day.\nCompute ready_not_started per group by counting distinct pj_project_id where ms_1550_construction_start_actual is NULL and readiness gates are satisfied: (ms_1507_tower_ntp_approved_actual OR pj_a_4100_construction_ntp_accepted_by_gc_finish) AND pj_a_3925_msl_pickup_date_finish AND pj_a_4525_power_ready_finish AND (pj_a_4925_aav_fiber_ready_finish OR pj_a_4425_mw_installation_complete_finish).\nLEFT JOIN the completed_nw and ready_not_started aggregates onto the spine using (rgn_region, m_area, m_market, construction_gc).\nReturn run_rate = completed_nw / N, backlog = ready_not_started, and gap = run_rate - backlog, plus trailing_weeks.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "pj_program_name", "type": "string", "description": ""}, {"name": "pj_project_type", "type": "string", "description": ""}, {"name": "trailing_weeks", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": "Optional program filter. Values: \'NTM\', \'AHLOB Modernization\'."}]', kpi_contract: '{"function_name": "get_capacity_vs_demand_gap", "node_type": "kpi", "node_id": "ea9583cb-1701-45ef-a2db-5cc07b01948c", "node_label": "Capacity vs Demand Gap", "description": "Measures the execution capacity versus near-term demand by comparing observed weekly delivery capacity to the count of ready-but-not-started sites for each Market and General Contractor, anchored to the current date. Positive values indicate implied spare capacity, while negative values indicate backlog pressure.", "parameters": [{"name": "trailing_weeks", "type": "string", "description": "Filter by trailing weeks", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "pj_program_name", "type": "string", "description": "Filter by pj program name", "required": false, "sample_values": []}, {"name": "pj_project_type", "type": "string", "description": "Filter by pj project type", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "run_rate", "type": "string", "nullable": false}, {"name": "backlog", "type": "number", "nullable": false}, {"name": "gap", "type": "string", "nullable": false}, {"name": "trailing_weeks", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Computes Capacity vs Demand Gap by (rgn_region, m_area, m_market, construction_gc). Let N = trailing_weeks (default 12). run_rate = COUNT(DISTINCT projects with ms_1555_construction_complete_actual in the last N weeks) / N. backlog = COUNT(DISTINCT projects where ms_1550_construction_start_actual is NULL and the 4 readiness gates are satisfied). gap = run_rate − backlog. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', node_type: 'CORE', definition: 'Computes Capacity vs Demand Gap by (rgn_region, m_area, m_market, construction_gc). Let N = trailing_weeks (default 12). run_rate = COUNT(DISTINCT projects with ms_1555_construction_complete_actual in the last N weeks) / N. backlog = COUNT(DISTINCT projects where ms_1550_construction_start_actual is NULL and the 4 readiness gates are satisfied). gap = run_rate − backlog.', kpi_python_function: 'def get_capacity_vs_demand_gap(execute_query, filters=None) -> list[dict]:\n    """Capacity vs Demand Gap per (rgn_region, m_area, m_market, construction_gc).\n\n    Definitions (per group):\n      - completed_nw = COUNT(DISTINCT projects with construction complete in the trailing N weeks)\n      - run_rate     = completed_nw / N\n      - backlog      = COUNT(DISTINCT projects not started as-of CURRENT_DATE that pass the 4 readiness gates)\n      - gap          = run_rate - backlog\n\n    Parameter:\n      - trailing_weeks (int, default 12)\n\n    Optional filters:\n      - rgn_region, m_area, m_market, construction_gc, pj_program_name, pj_project_type\n    """\n\n    filters = filters or {}\n\n    def esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    trailing_weeks = filters.get("trailing_weeks", 12)\n    try:\n        trailing_weeks = int(trailing_weeks)\n    except Exception:\n        trailing_weeks = 12\n    if trailing_weeks <= 0:\n        trailing_weeks = 12\n\n    # Always-true seed so WHERE is always present\n    where_parts = ["1=1"]\n    if filters.get("rgn_region") is not None:\n        where_parts.append(f"rgn_region = \'{esc(filters[\'rgn_region\'])}\'")\n    if filters.get("m_area") is not None:\n        where_parts.append(f"m_area = \'{esc(filters[\'m_area\'])}\'")\n    if filters.get("m_market") is not None:\n        where_parts.append(f"m_market = \'{esc(filters[\'m_market\'])}\'")\n    if filters.get("construction_gc") is not None:\n        where_parts.append(f"construction_gc = \'{esc(filters[\'construction_gc\'])}\'")\n    if filters.get("pj_program_name") is not None:\n        where_parts.append(f"pj_program_name = \'{esc(filters[\'pj_program_name\'])}\'")\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        # NTM-specific filters (per Nokia Question Bank)\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n    if filters.get("pj_project_type") is not None:\n        where_parts.append(f"pj_project_type = \'{esc(filters[\'pj_project_type\'])}\'")\n\n    where_sql = "WHERE " + " AND ".join(where_parts)\n\n    completed_col = \'"ms_1555_construction_complete_actual"\'\n    started_col = \'"ms_1550_construction_start_actual"\'\n\n    readiness_expr = """\n    (\n      ("ms_1507_tower_ntp_approved_actual" IS NOT NULL\n         OR "pj_a_4100_construction_ntp_accepted_by_gc_finish" IS NOT NULL)\n      AND "pj_a_3925_msl_pickup_date_finish" IS NOT NULL\n      AND "pj_a_4525_power_ready_finish" IS NOT NULL\n      AND ("pj_a_4925_aav_fiber_ready_finish" IS NOT NULL\n         OR "pj_a_4425_mw_installation_complete_finish" IS NOT NULL)\n    )\n    """\n\n    days = trailing_weeks * 7\n\n    sql = f"""\n    SELECT\n      g.rgn_region,\n      g.m_area,\n      g.m_market,\n      g.construction_gc,\n      COALESCE(r.completed_nw, 0)::numeric / {trailing_weeks}::numeric AS run_rate,\n      COALESCE(b.ready_not_started, 0) AS backlog,\n      (COALESCE(r.completed_nw, 0)::numeric / {trailing_weeks}::numeric) - COALESCE(b.ready_not_started, 0) AS gap,\n      {trailing_weeks}::int AS trailing_weeks\n    FROM (\n      SELECT DISTINCT rgn_region, m_area, m_market, construction_gc\n      FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n      {where_sql}\n        AND construction_gc IS NOT NULL\n        AND m_market IS NOT NULL\n    ) g\n    LEFT JOIN (\n      SELECT\n        rgn_region,\n        m_area,\n        m_market,\n        construction_gc,\n        COUNT(DISTINCT pj_project_id) AS completed_nw\n      FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n      {where_sql}\n        AND {completed_col} IS NOT NULL\n        AND {completed_col}::timestamp >= (CURRENT_DATE - ({days} * INTERVAL \'1 day\'))\n        AND {completed_col}::timestamp < (CURRENT_DATE + INTERVAL \'1 day\')\n      GROUP BY 1,2,3,4\n    ) r\n      ON r.rgn_region = g.rgn_region\n     AND r.m_area = g.m_area\n     AND r.m_market = g.m_market\n     AND r.construction_gc = g.construction_gc\n    LEFT JOIN (\n      SELECT\n        rgn_region,\n        m_area,\n        m_market,\n        construction_gc,\n        COUNT(DISTINCT pj_project_id) AS ready_not_started\n      FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n      {where_sql}\n        AND {started_col} IS NULL\n        AND {readiness_expr}\n      GROUP BY 1,2,3,4\n    ) b\n      ON b.rgn_region = g.rgn_region\n     AND b.m_area = g.m_area\n     AND b.m_market = g.m_market\n     AND b.construction_gc = g.construction_gc\n    ORDER BY g.rgn_region, g.m_area, g.m_market, g.construction_gc\n    ;\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_project_id', 'pj_program_name', 'pj_project_type', 'ms_1555_construction_complete_actual', 'ms_1550_construction_start_actual', 'ms_1507_tower_ntp_approved_actual', 'pj_a_4100_construction_ntp_accepted_by_gc_finish', 'pj_a_3925_msl_pickup_date_finish', 'pj_a_4525_power_ready_finish', 'pj_a_4925_aav_fiber_ready_finish', 'pj_a_4425_mw_installation_complete_finish', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Capacity vs Demand Gap', kpi_related_core_node_ids: ['project', 'market', 'general_contractor'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'ea9583cb-1701-45ef-a2db-5cc07b01948c', entity_type: 'kpi', kpi_name: 'Capacity vs Demand Gap', name: 'ea9583cb-1701-45ef-a2db-5cc07b01948c', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures the execution capacity versus near-term demand by comparing observed weekly delivery capacity to the count of ready-but-not-started sites for each Market and General Contractor, anchored to the current date. Positive values indicate implied spare capacity, while negative values indicate backlog pressure. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', status: 'mentioned', node_id: 'ea9583cb-1701-45ef-a2db-5cc07b01948c'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'For projects with pj_project_status!=\'Dead\' AND ms_1550_construction_start_actual IS NULL, compute five boolean blockers from milestone NULL checks, then aggregate COUNT(DISTINCT pj_project_id) by (rgn_region, m_area, m_market) [optional + construction_gc] into total_pipeline, fully_ready (0 blockers), each blocked_by_* (blocker true), and blocked_multi (>=2 blockers).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region for aggregation."}, {"column": "m_area", "type": "string", "description": "Area for aggregation."}, {"column": "m_market", "type": "string", "description": "Market for aggregation."}, {"column": "construction_gc", "type": "string", "description": "General contractor (present only when optional grouping by GC is enabled)."}, {"column": "total_pipeline", "type": "int", "description": "Count of distinct active projects that have not started construction."}, {"column": "fully_ready", "type": "int", "description": "Count of distinct projects with none of the five blockers present."}, {"column": "blocked_by_ntp", "type": "int", "description": "Count of distinct projects blocked due to missing NTP approvals/acceptance per definition."}, {"column": "blocked_by_material", "type": "int", "description": "Count of distinct projects blocked due to missing material pickup milestone."}, {"column": "blocked_by_power", "type": "int", "description": "Count of distinct projects blocked due to missing power-ready milestone."}, {"column": "blocked_by_backhaul", "type": "int", "description": "Count of distinct projects blocked due to missing both fiber-ready and MW-install-complete milestones."}, {"column": "blocked_by_access", "type": "int", "description": "Count of distinct projects blocked due to missing pre-construction walk completion milestone."}, {"column": "blocked_multi", "type": "int", "description": "Count of distinct projects with two or more blockers simultaneously."}]', kpi_business_logic: '1) Select population where pj_project_status != \'Dead\' AND ms_1550_construction_start_actual IS NULL.\n2) For each distinct pj_project_id, derive blockers:\n   - blocked_ntp = (ms_1507_tower_ntp_approved_actual IS NULL) AND (pj_a_4100_construction_ntp_accepted_by_gc_finish IS NULL)\n   - blocked_material = (pj_a_3925_msl_pickup_date_finish IS NULL)\n   - blocked_power = (pj_a_4525_power_ready_finish IS NULL)\n   - blocked_backhaul = (pj_a_4925_aav_fiber_ready_finish IS NULL) AND (pj_a_4425_mw_installation_complete_finish IS NULL)  # cleared if either is present\n   - blocked_access = (pj_a_3825_pre_construction_walk_complete_finish IS NULL)\n3) Compute blocker_count = number of true blockers among the five.\n4) Group by rgn_region, m_area, m_market (optionally also construction_gc):\n   - total_pipeline = COUNT(DISTINCT pj_project_id)\n   - fully_ready = COUNT(DISTINCT pj_project_id) where blocker_count = 0\n   - blocked_by_ntp/material/power/backhaul/access = COUNT(DISTINCT pj_project_id) where corresponding blocker is true\n   - blocked_multi = COUNT(DISTINCT pj_project_id) where blocker_count >= 2.', kpi_filters: '[{"name": "pj_project_status", "type": "string", "description": "Limits population to active projects (pj_project_status != \'Dead\')."}, {"name": "ms_1550_construction_start_actual", "type": "date", "description": "Limits population to projects that have not started construction yet (ms_1550_construction_start_actual IS NULL)."}, {"name": "rgn_region", "type": "string", "description": "Optional filter to restrict results to a specific region."}, {"name": "m_area", "type": "string", "description": "Optional filter to restrict results to a specific area."}, {"name": "m_market", "type": "string", "description": "Optional filter to restrict results to a specific market."}, {"name": "construction_gc", "type": "string", "description": "Optional filter for drill-down to a specific general contractor."}, {"name": "pj_project_id", "type": "string", "description": "Optional filter to restrict results to a specific project."}, {"name": "pj_program_name", "type": "string", "description": "Optional filter to restrict results to a specific program name."}, {"name": "pj_project_type", "type": "string", "description": "Optional filter to restrict results to a specific project type."}, {"name": "group_by_gc", "type": "string", "description": "Optional flag to add construction_gc as a secondary grouping dimension."}, {"name": "smp_name", "type": "string", "description": "Filter by program name (e.g., NTM, AHLOB Modernization). When NTM, additionally requires smp_status=Active and excludes specific ntm_project_type values."}]', kpi_contract: '{"function_name": "get_site_blocker_analysis", "node_type": "kpi", "node_id": "df549b33-4d47-4927-9a25-1c9b61911c90", "node_label": "Site Blocker Analysis", "description": "Market-level breakdown of prerequisite blockers for active projects that have not started construction yet. Population: projects where pj_project_status != \'Dead\' AND ms_1550_construction_start_actual IS NULL in stg_ndpd_mbt_tmobile_macro_combined. For each project, compute boolean gate blockers: blocked_ntp = (ms_1507_tower_ntp_approved_actual IS NULL AND pj_a_4100_construction_ntp_accepted_by_gc_finish IS NULL); blocked_material = (\\"pj_a_3925_msl_pickup_date_finish\\" IS NULL); blocked_power = (pj_a_4525_power_ready_finish IS NULL); blocked_backhaul = (pj_a_4925_aav_fiber_ready_finish IS NULL AND pj_a_4425_mw_installation_complete_finish IS NULL) meaning either fiber-ready OR MW-complete clears backhaul; blocked_access = (pj_a_3825_pre_construction_walk_complete_finish IS NULL). Aggregate by (rgn_region, m_area, m_market): total_pipeline = COUNT(DISTINCT pj_project_id) over population; fully_ready = count where none of the 5 blockers are true; blocked_by_ntp/material/power/backhaul/access = counts where respective blocker is true; blocked_multi = count where two or more blockers are simultaneously true (sum of boolean flags >= 2). Output is a scorecard table per region/area/market. Optional enhancement: allow filtering or secondary grouping by construction_gc for drill-down, without changing the base market-level KPI.", "parameters": [{"name": "group_by_gc", "type": "string", "description": "Filter by group by gc", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "total_pipeline", "type": "number", "nullable": false}, {"name": "fully_ready", "type": "number", "nullable": false}, {"name": "blocked_by_ntp", "type": "number", "nullable": false}, {"name": "blocked_by_material", "type": "number", "nullable": false}, {"name": "blocked_by_power", "type": "number", "nullable": false}, {"name": "blocked_by_backhaul", "type": "number", "nullable": false}, {"name": "blocked_by_access", "type": "number", "nullable": false}, {"name": "blocked_multi", "type": "number", "nullable": false}], "sample_output": [{"rgn_region": "CENTRAL", "m_area": "GREAT LAKES", "m_market": "CHICAGO", "total_pipeline": 2, "fully_ready": 0, "blocked_by_ntp": 1, "blocked_by_material": 1, "blocked_by_power": 1, "blocked_by_backhaul": 2, "blocked_by_access": 0, "blocked_multi": 1}, {"rgn_region": "CENTRAL", "m_area": "GREAT LAKES", "m_market": "CINCINNATI", "total_pipeline": 3, "fully_ready": 0, "blocked_by_ntp": 2, "blocked_by_material": 2, "blocked_by_power": 3, "blocked_by_backhaul": 3, "blocked_by_access": 2, "blocked_multi": 3}, {"rgn_region": "CENTRAL", "m_area": "GREAT LAKES", "m_market": "CLEVELAND", "total_pipeline": 3, "fully_ready": 0, "blocked_by_ntp": 1, "blocked_by_material": 1, "blocked_by_power": 3, "blocked_by_backhaul": 1, "blocked_by_access": 2, "blocked_multi": 2}], "row_count": 10}', nl_description: 'KPI = for projects with pj_project_status!=\'Dead\' and ms_1550_construction_start_actual IS NULL, compute five boolean blockers (NTP, material, power, backhaul, access) from milestone-null conditions per project, then aggregate distinct pj_project_id counts by (rgn_region, m_area, m_market) [optionally + construction_gc] into total_pipeline, fully_ready (no blockers), each blocked_by_* count, and blocked_multi (>=2 blockers).', node_type: 'CORE', definition: 'KPI = for projects with pj_project_status!=\'Dead\' and ms_1550_construction_start_actual IS NULL, compute five boolean blockers (NTP, material, power, backhaul, access) from milestone-null conditions per project, then aggregate distinct pj_project_id counts by (rgn_region, m_area, m_market) [optionally + construction_gc] into total_pipeline, fully_ready (no blockers), each blocked_by_* count, and blocked_multi (>=2 blockers).', kpi_python_function: 'def get_site_blocker_analysis(execute_query, filters=None) -> list[dict]:\n    """Market-level breakdown of prerequisite blockers for active projects not started.\n\n    Population:\n      pj_project_status != \'Dead\'\n      AND ms_1550_construction_start_actual IS NULL\n\n    Optional enhancement:\n      If filters contains \'group_by_gc\': truthy, include construction_gc in grouping.\n      You can also filter by construction_gc / rgn_region / m_area / m_market via filters.\n    """\n\n    filters = filters or {}\n\n    # Build SQL WHERE clause (PostgreSQL)\n    where_parts = [\n        "pj_project_status != \'Dead\'",\n        "ms_1550_construction_start_actual IS NULL"\n    ]\n\n    # Allow common dimension filters (and passthrough of any additional column filters)\n    passthrough_keys = [\n        \'rgn_region\', \'m_area\', \'m_market\',\n        \'construction_gc\', \'pj_project_id\',\n        \'pj_program_name\', \'pj_project_type\'\n    ]\n\n    for k in passthrough_keys:\n        if k in filters and filters.get(k) is not None and filters.get(k) != \'\':\n            v = str(filters.get(k)).replace("\'", "\'\'")\n            where_parts.append(f"{k} = \'{v}\'")\n\n    # NOTE: No date filter is applied because the KPI definition is point-in-time and\n    # milestone fields are nullable timestamps rather than event records.\n\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " AND ".join(where_parts)\n\n    group_by_gc = bool(filters.get(\'group_by_gc\'))\n\n    group_cols = ["rgn_region", "m_area", "m_market"]\n    if group_by_gc:\n        group_cols.append("construction_gc")\n\n    select_group_cols = ",\\n            ".join(group_cols)\n    group_by_sql = ", ".join(group_cols)\n\n    # Raw SQL is required because Tier-1 accessors do not expose the milestone columns needed.\n    sql = f"""\n        SELECT\n            {select_group_cols},\n            pj_project_id,\n            ms_1550_construction_start_actual,\n            ms_1507_tower_ntp_approved_actual,\n            pj_a_4100_construction_ntp_accepted_by_gc_finish,\n            "pj_a_3925_msl_pickup_date_finish",\n            pj_a_4525_power_ready_finish,\n            pj_a_4925_aav_fiber_ready_finish,\n            pj_a_4425_mw_installation_complete_finish,\n            pj_a_3825_pre_construction_walk_complete_finish\n        FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n        WHERE {where_sql}\n    """\n\n    rows = execute_query(sql)\n\n    def is_null(x):\n        # Treat None and empty-string as null-like; do NOT treat \'0\' as null.\n        return x is None or (isinstance(x, str) and x.strip() == \'\')\n\n    # Aggregate per group key with DISTINCT project ids\n    agg = {}\n\n    for r in rows:\n        key_vals = []\n        for c in group_cols:\n            key_vals.append(r.get(c))\n        key = tuple(key_vals)\n\n        if key not in agg:\n            agg[key] = {\n                "rgn_region": r.get("rgn_region"),\n                "m_area": r.get("m_area"),\n                "m_market": r.get("m_market"),\n                **({"construction_gc": r.get("construction_gc")} if group_by_gc else {}),\n                "_projects": set(),\n                "total_pipeline": 0,\n                "fully_ready": 0,\n                "blocked_by_ntp": 0,\n                "blocked_by_material": 0,\n                "blocked_by_power": 0,\n                "blocked_by_backhaul": 0,\n                "blocked_by_access": 0,\n                "blocked_multi": 0\n            }\n\n        project_id = r.get("pj_project_id")\n        if project_id in agg[key]["_projects"]:\n            continue\n        agg[key]["_projects"].add(project_id)\n\n        blocked_ntp = is_null(r.get("ms_1507_tower_ntp_approved_actual")) and is_null(r.get("pj_a_4100_construction_ntp_accepted_by_gc_finish"))\n        blocked_material = is_null(r.get("pj_a_3925_msl_pickup_date_finish"))\n        blocked_power = is_null(r.get("pj_a_4525_power_ready_finish"))\n        # Backhaul is cleared if either fiber-ready OR MW-complete is present\n        blocked_backhaul = is_null(r.get("pj_a_4925_aav_fiber_ready_finish")) and is_null(r.get("pj_a_4425_mw_installation_complete_finish"))\n        blocked_access = is_null(r.get("pj_a_3825_pre_construction_walk_complete_finish"))\n\n        blockers = [blocked_ntp, blocked_material, blocked_power, blocked_backhaul, blocked_access]\n        blocker_count = sum(1 for b in blockers if b)\n\n        agg[key]["total_pipeline"] += 1\n        if blocker_count == 0:\n            agg[key]["fully_ready"] += 1\n        if blocked_ntp:\n            agg[key]["blocked_by_ntp"] += 1\n        if blocked_material:\n            agg[key]["blocked_by_material"] += 1\n        if blocked_power:\n            agg[key]["blocked_by_power"] += 1\n        if blocked_backhaul:\n            agg[key]["blocked_by_backhaul"] += 1\n        if blocked_access:\n            agg[key]["blocked_by_access"] += 1\n        if blocker_count >= 2:\n            agg[key]["blocked_multi"] += 1\n\n    # finalize\n    out = []\n    for k, v in agg.items():\n        v.pop("_projects", None)\n        out.append(v)\n\n    # Stable ordering\n    def sort_key(d):\n        base = (\n            str(d.get(\'rgn_region\') or \'\'),\n            str(d.get(\'m_area\') or \'\'),\n            str(d.get(\'m_market\') or \'\')\n        )\n        if group_by_gc:\n            base = base + (str(d.get(\'construction_gc\') or \'\'),)\n        return base\n\n    out.sort(key=sort_key)\n    return out\n', kpi_source_columns: ['pj_project_status', 'ms_1550_construction_start_actual', 'pj_project_id', 'ms_1507_tower_ntp_approved_actual', 'pj_a_4100_construction_ntp_accepted_by_gc_finish', 'pj_a_3925_msl_pickup_date_finish', 'pj_a_4525_power_ready_finish', 'pj_a_4925_aav_fiber_ready_finish', 'pj_a_4425_mw_installation_complete_finish', 'pj_a_3825_pre_construction_walk_complete_finish', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_program_name', 'pj_project_type', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Site Blocker Analysis', kpi_related_core_node_ids: ['project', 'market', 'general_contractor'], kpi_relationship_type: 'AGGREGATES', kpi_kpi_id: 'df549b33-4d47-4927-9a25-1c9b61911c90', entity_type: 'kpi', kpi_name: 'Site Blocker Analysis', name: 'df549b33-4d47-4927-9a25-1c9b61911c90', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Market-level breakdown of prerequisite blockers preventing active projects from starting construction. It quantifies how many not-yet-started active projects are ready versus blocked by key prerequisites, supporting prioritization and unblock efforts by market. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: 'df549b33-4d47-4927-9a25-1c9b61911c90'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_nas_rejection_data_last_30_days', 'pwc_macro_staging_schema.stg_nas_session_level_combined_data'], nl_business_rule: '', kpi_formula_description: 'checkout_rejection_rate_pct = (COUNT(DISTINCT rejected checkout sessions) / COUNT(DISTINCT sessions that reached checkout gate)) * 100; also produces distinct-session counts by check-in and check-out rejection reason.', kpi_output_schema: '[{"column": "result_set", "type": "string", "description": "Discriminator for which result set the row belongs to: \'A\' (rate scorecard) or \'B\' (reason breakdown)."}, {"column": "nas_rej_region", "type": "string", "description": "Rejection region."}, {"column": "nas_rej_market", "type": "string", "description": "Rejection market (also used to align/join to session market)."}, {"column": "checkout_rejection_count", "type": "int", "description": "Distinct rejected sessions with a non-null checkout rejection reason (Result set A only)."}, {"column": "checkin_rejection_count", "type": "int", "description": "Distinct rejected sessions with a non-null check-in rejection reason (Result set A only)."}, {"column": "total_rejection_sessions", "type": "int", "description": "Distinct rejected sessions in the filtered rejection dataset (Result set A only)."}, {"column": "total_completed_sessions", "type": "int", "description": "Distinct sessions that reached checkout gate in the filtered session dataset (Result set A only)."}, {"column": "checkout_rejection_rate_pct", "type": "float", "description": "Checkout rejection percentage = checkout_rejection_count / total_completed_sessions * 100; NULL when total_completed_sessions = 0 (Result set A only)."}, {"column": "reason_type", "type": "string", "description": "Reason category: \'checkin\' or \'checkout\' (Result set B only)."}, {"column": "reason_value", "type": "string", "description": "Rejection reason value from the corresponding reason column (Result set B only)."}, {"column": "reason_count", "type": "int", "description": "Distinct rejected sessions for the given reason (Result set B only)."}]', kpi_business_logic: '1) (Optional) Apply date range filters.\n2) From stg_nas_rejection_data_last_30_days, filter by nas_rej_rejection_time within the date range; group by nas_rej_region, nas_rej_market.\n3) Compute: checkout_rejection_count = COUNT(DISTINCT nas_rej_sessionid) where nas_rej_checkout_reject_reason IS NOT NULL; checkin_rejection_count = COUNT(DISTINCT nas_rej_sessionid) where nas_rej_checkin_reject_reason IS NOT NULL; total_rejection_sessions = COUNT(DISTINCT nas_rej_sessionid).\n4) Build denominator from stg_nas_session_level_combined_data: keep sessions that reached checkout gate (nas_checkout_approve_time IS NOT NULL OR nas_checkout_reject_time IS NOT NULL) and whose COALESCE(nas_checkout_approve_time, nas_checkout_reject_time) is within the same date range; group by nas_market (treated as nas_rej_market) and compute total_completed_sessions = COUNT(DISTINCT nas_session_id).\n5) Left join numerator to denominator on nas_rej_market.\n6) Compute checkout_rejection_rate_pct = (checkout_rejection_count / total_completed_sessions) * 100; if total_completed_sessions = 0 return NULL.\n7) Reason breakdown: using the same rejection-table date filter, emit rows grouped by nas_rej_region, nas_rej_market, reason_type, reason_value where reason_type is \'checkin\' with reason_value = nas_rej_checkin_reject_reason (non-null) and \'checkout\' with reason_value = nas_rej_checkout_reject_reason (non-null); reason_count = COUNT(DISTINCT nas_rej_sessionid).', kpi_filters: '[{"name": "start_date", "type": "date", "description": "Lower bound (inclusive) for filtering nas_rej_rejection_time in the rejection table and COALESCE(nas_checkout_approve_time, nas_checkout_reject_time) in the session table."}, {"name": "end_date", "type": "date", "description": "Upper bound (exclusive) for filtering nas_rej_rejection_time in the rejection table and COALESCE(nas_checkout_approve_time, nas_checkout_reject_time) in the session table."}, {"name": "nas_rej_*", "type": "string", "description": "Optional drill-down equality filters applied to the rejection table (any filter key starting with \'nas_rej_\')."}, {"name": "session_table_*", "type": "string", "description": "Optional drill-down equality filters applied to the session table for non-\'nas_rej_\' keys (e.g., nas_session_id, nas_market)."}]', kpi_contract: '{"function_name": "get_nas_checkout_rejection", "node_type": "kpi", "node_id": "41414556-b0ca-4b2c-8acd-4214a700b491", "node_label": "NAS Checkout Rejection", "description": "Measures NAS session rejection and rework signals by market/region, including checkout-gate rejection rate and rejection reason breakdown. Use `stg_nas_rejection_data_last_30_days` (rejections) joined to `stg_nas_session_level_combined_data` (session denominator) on `nas_rej_sessionid = nas_session_id`. Accept optional date range parameters `(start_date, end_date)`.\\n\\nResult set A \\u2014 Rate scorecard (one row per `nas_rej_region, nas_rej_market`):\\n- Population: rows from `stg_nas_rejection_data_last_30_days` where `nas_rej_rejection_time` is within the optional date range.\\n- `checkout_rejection_count`: COUNT(DISTINCT nas_rej_sessionid) FILTER (WHERE nas_rej_checkout_reject_reason IS NOT NULL).\\n- `checkin_rejection_count`: COUNT(DISTINCT nas_rej_sessionid) FILTER (WHERE nas_rej_checkin_reject_reason IS NOT NULL).\\n- `total_rejection_sessions`: COUNT(DISTINCT nas_rej_sessionid) over the filtered rejection dataset.\\n- Denominator population: `stg_nas_session_level_combined_data` rows where the session reached checkout gate, defined as `(nas_checkout_approve_time IS NOT NULL OR nas_checkout_reject_time IS NOT NULL)` AND `COALESCE(nas_checkout_approve_time, nas_checkout_reject_time)` falls within the same optional date range.\\n- `total_completed_sessions`: COUNT(DISTINCT nas_session_id) over the filtered denominator population, grouped by the session market mapped to rejection market (use `nas_market` for grouping, aligned to `nas_rej_market`).\\n- `checkout_rejection_rate_pct`: `checkout_rejection_count / total_completed_sessions * 100`, with divide-by-zero protection (return NULL when `total_completed_sessions = 0`).\\n\\nResult set B \\u2014 Reason breakdown (one row per `nas_rej_region, nas_rej_market, reason_type, reason_value`):\\n- Filter by the same optional date range on `nas_rej_rejection_time`.\\n- Emit one row for each distinct reason value with counts:\\n  - For check-in: `reason_type=\'checkin\'`, `reason_value=nas_rej_checkin_reject_reason`, `reason_count=COUNT(DISTINCT nas_rej_sessionid)` (or COUNT(*) if you prefer event-count; default is distinct sessions).\\n  - For check-out: `reason_type=\'checkout\'`, `reason_value=nas_rej_checkout_reject_reason`, `reason_count=COUNT(DISTINCT nas_rej_sessionid)`.\\n\\nDefault behavior when no date parameters are supplied: compute over all available data in both tables. Supports drill-down by adding optional dimensions (e.g., `nas_rej_userid`, `nas_rej_siteid`) without changing core definitions.", "parameters": [{"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}], "output_columns": [{"name": "result_set", "type": "string", "nullable": false}, {"name": "nas_rej_region", "type": "string", "nullable": false}, {"name": "nas_rej_market", "type": "string", "nullable": false}, {"name": "checkout_rejection_count", "type": "number", "nullable": false}, {"name": "checkin_rejection_count", "type": "number", "nullable": false}, {"name": "total_rejection_sessions", "type": "number", "nullable": false}, {"name": "total_completed_sessions", "type": "number", "nullable": false}, {"name": "checkout_rejection_rate_pct", "type": "string", "nullable": false}, {"name": "reason_type", "type": "null", "nullable": true}, {"name": "reason_value", "type": "null", "nullable": true}, {"name": "reason_count", "type": "null", "nullable": true}], "sample_output": [{"result_set": "A", "nas_rej_region": "Central", "nas_rej_market": "Chicago", "checkout_rejection_count": 15, "checkin_rejection_count": 8, "total_rejection_sessions": 19, "total_completed_sessions": 15, "checkout_rejection_rate_pct": "100.00000000000000000000", "reason_type": null, "reason_value": null, "reason_count": null}, {"result_set": "A", "nas_rej_region": "Central", "nas_rej_market": "Cincinnati", "checkout_rejection_count": 13, "checkin_rejection_count": 12, "total_rejection_sessions": 19, "total_completed_sessions": 15, "checkout_rejection_rate_pct": "86.66666666666666666700", "reason_type": null, "reason_value": null, "reason_count": null}, {"result_set": "A", "nas_rej_region": "Central", "nas_rej_market": "Cleveland", "checkout_rejection_count": 16, "checkin_rejection_count": 15, "total_rejection_sessions": 19, "total_completed_sessions": 17, "checkout_rejection_rate_pct": "94.11764705882352941200", "reason_type": null, "reason_value": null, "reason_count": null}], "row_count": 10}', nl_description: 'KPI = f(Integration Activity sessions, NAS rejection events) where checkout rejection rate by (nas_rej_region, nas_rej_market) equals distinct rejected checkout sessions in stg_nas_rejection_data_last_30_days divided by distinct sessions that reached checkout gate in stg_nas_session_level_combined_data (date-aligned), multiplied by 100, plus reason-level distinct-session counts for check-in and check-out rejection reasons.', node_type: 'CORE', definition: 'KPI = f(Integration Activity sessions, NAS rejection events) where checkout rejection rate by (nas_rej_region, nas_rej_market) equals distinct rejected checkout sessions in stg_nas_rejection_data_last_30_days divided by distinct sessions that reached checkout gate in stg_nas_session_level_combined_data (date-aligned), multiplied by 100, plus reason-level distinct-session counts for check-in and check-out rejection reasons.', kpi_python_function: 'def get_nas_checkout_rejection(execute_query, filters=None) -> list[dict]:\n    """NAS Checkout Rejection KPI.\n\n    Returns a single list containing BOTH result sets with a discriminator column:\n      - result_set = \'A\' (rate scorecard)\n      - result_set = \'B\' (reason breakdown)\n\n    Notes:\n      - Uses raw SQL because the rejection table is not exposed as a Tier-1 core node accessor.\n      - Uses plain SELECT statements with inline subqueries (no CTE/WITH) because the runtime\n        rejects non-SELECT syntax.\n      - Supports optional filters: start_date, end_date, plus optional drilldown fields such as\n        nas_rej_region, nas_rej_market, nas_rej_userid, nas_rej_siteid, nas_session_id, nas_market, etc.\n    """\n\n    filters = filters or {}\n\n    def esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    start_date = filters.get(\'start_date\')\n    end_date = filters.get(\'end_date\')\n\n    # Split filters into: rejection-table filters vs session-table filters.\n    # Convention: anything starting with \'nas_rej_\' applies to rejection table.\n    # IMPORTANT: do NOT prefix with table aliases (r./s.) because queries use inline subqueries.\n    rej_filter_parts = []\n    sess_filter_parts = []\n\n    for k, v in filters.items():\n        if v is None:\n            continue\n        if k in (\'start_date\', \'end_date\'):\n            continue\n        # Basic allowlist-ish behavior: only simple equality predicates; callers can pass known columns.\n        if k.startswith(\'nas_rej_\'):\n            rej_filter_parts.append(f"{k} = \'{esc(v)}\'")\n        else:\n            sess_filter_parts.append(f"{k} = \'{esc(v)}\'")\n\n    # Date predicates\n    rej_date_pred = "TRUE"\n    if start_date and end_date:\n        rej_date_pred = (\n            f"nas_rej_rejection_time >= \'{esc(start_date)}\' "\n            f"AND nas_rej_rejection_time < \'{esc(end_date)}\'"\n        )\n    elif start_date:\n        rej_date_pred = f"nas_rej_rejection_time >= \'{esc(start_date)}\'"\n    elif end_date:\n        rej_date_pred = f"nas_rej_rejection_time < \'{esc(end_date)}\'"\n\n    denom_date_pred = "TRUE"\n    # denominator time uses COALESCE(approve, reject)\n    if start_date and end_date:\n        denom_date_pred = (\n            f"COALESCE(nas_checkout_approve_time, nas_checkout_reject_time) >= \'{esc(start_date)}\' "\n            f"AND COALESCE(nas_checkout_approve_time, nas_checkout_reject_time) < \'{esc(end_date)}\'"\n        )\n    elif start_date:\n        denom_date_pred = f"COALESCE(nas_checkout_approve_time, nas_checkout_reject_time) >= \'{esc(start_date)}\'"\n    elif end_date:\n        denom_date_pred = f"COALESCE(nas_checkout_approve_time, nas_checkout_reject_time) < \'{esc(end_date)}\'"\n\n    rej_extra_pred = " AND ".join(rej_filter_parts) if rej_filter_parts else "TRUE"\n    sess_extra_pred = " AND ".join(sess_filter_parts) if sess_filter_parts else "TRUE"\n\n    sql_a = f"""\n    SELECT\n      \'A\'::text AS result_set,\n      ra.nas_rej_region,\n      ra.nas_rej_market,\n      ra.checkout_rejection_count,\n      ra.checkin_rejection_count,\n      ra.total_rejection_sessions,\n      COALESCE(da.total_completed_sessions, 0) AS total_completed_sessions,\n      CASE\n        WHEN COALESCE(da.total_completed_sessions, 0) = 0 THEN NULL\n        ELSE (ra.checkout_rejection_count::numeric / da.total_completed_sessions::numeric) * 100\n      END AS checkout_rejection_rate_pct,\n      NULL::text AS reason_type,\n      NULL::text AS reason_value,\n      NULL::bigint AS reason_count\n    FROM (\n      SELECT\n        nas_rej_region,\n        nas_rej_market,\n        COUNT(DISTINCT nas_rej_sessionid) FILTER (WHERE nas_rej_checkout_reject_reason IS NOT NULL) AS checkout_rejection_count,\n        COUNT(DISTINCT nas_rej_sessionid) FILTER (WHERE nas_rej_checkin_reject_reason IS NOT NULL) AS checkin_rejection_count,\n        COUNT(DISTINCT nas_rej_sessionid) AS total_rejection_sessions\n      FROM pwc_macro_staging_schema.stg_nas_rejection_data_last_30_days\n      WHERE {rej_date_pred}\n        AND ({rej_extra_pred})\n      GROUP BY 1, 2\n    ) ra\n    LEFT JOIN (\n      SELECT\n        nas_market AS nas_rej_market,\n        COUNT(DISTINCT nas_session_id) AS total_completed_sessions\n      FROM pwc_macro_staging_schema.stg_nas_session_level_combined_data\n      WHERE (nas_checkout_approve_time IS NOT NULL OR nas_checkout_reject_time IS NOT NULL)\n        AND {denom_date_pred}\n        AND ({sess_extra_pred})\n      GROUP BY 1\n    ) da\n      ON da.nas_rej_market = ra.nas_rej_market\n    """\n\n    sql_b = f"""\n    SELECT\n      \'B\'::text AS result_set,\n      x.nas_rej_region,\n      x.nas_rej_market,\n      NULL::bigint AS checkout_rejection_count,\n      NULL::bigint AS checkin_rejection_count,\n      NULL::bigint AS total_rejection_sessions,\n      NULL::bigint AS total_completed_sessions,\n      NULL::numeric AS checkout_rejection_rate_pct,\n      x.reason_type,\n      x.reason_value,\n      x.reason_count\n    FROM (\n      SELECT\n        nas_rej_region,\n        nas_rej_market,\n        \'checkin\'::text AS reason_type,\n        nas_rej_checkin_reject_reason::text AS reason_value,\n        COUNT(DISTINCT nas_rej_sessionid) AS reason_count\n      FROM pwc_macro_staging_schema.stg_nas_rejection_data_last_30_days\n      WHERE {rej_date_pred}\n        AND ({rej_extra_pred})\n        AND nas_rej_checkin_reject_reason IS NOT NULL\n      GROUP BY 1, 2, 3, 4\n\n      UNION ALL\n\n      SELECT\n        nas_rej_region,\n        nas_rej_market,\n        \'checkout\'::text AS reason_type,\n        nas_rej_checkout_reject_reason::text AS reason_value,\n        COUNT(DISTINCT nas_rej_sessionid) AS reason_count\n      FROM pwc_macro_staging_schema.stg_nas_rejection_data_last_30_days\n      WHERE {rej_date_pred}\n        AND ({rej_extra_pred})\n        AND nas_rej_checkout_reject_reason IS NOT NULL\n      GROUP BY 1, 2, 3, 4\n    ) x\n    """\n\n    rows_a = execute_query(sql_a)\n    rows_b = execute_query(sql_b)\n\n    # Return combined result for callers; they can split by result_set.\n    return (rows_a or []) + (rows_b or [])\n', kpi_source_columns: ['nas_rej_sessionid', 'nas_session_id', 'nas_rej_rejection_time', 'nas_rej_region', 'nas_rej_market', 'nas_rej_checkout_reject_reason', 'nas_rej_checkin_reject_reason', 'nas_checkout_approve_time', 'nas_checkout_reject_time', 'nas_market', 'nas_rej_userid', 'nas_rej_siteid'], session_id: '69a3d22f26e208edc083a06e', label: 'NAS Checkout Rejection', kpi_related_core_node_ids: ['integration_activity', 'nas_rejection'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '41414556-b0ca-4b2c-8acd-4214a700b491', entity_type: 'kpi', kpi_name: 'NAS Checkout Rejection', name: '41414556-b0ca-4b2c-8acd-4214a700b491', kpi_dimensions: ['nas_rej_region', 'nas_rej_market', 'reason_type', 'reason_value'], kpi_description: 'Measures NAS session rejection and rework signals by market/region, including the checkout-gate rejection rate and a breakdown of rejection reasons. This helps understand how often sessions are rejected at checkout and why, enabling monitoring and drill-down by geography and other attributes.', status: 'mentioned', node_id: '41414556-b0ca-4b2c-8acd-4214a700b491'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined', 'public.tmo_macro_copilot_ahloa_reschedule_delay_code'], nl_business_rule: '', kpi_formula_description: 'revisit_reschedule_percentage = ROUND(100.0 * COUNT(DISTINCT pj_project_id with a reschedule entry) / NULLIF(COUNT(DISTINCT pj_project_id completed), 0), 2), grouped by (rgn_region, m_area, m_market, construction_gc); completion enforced via pj_a_5175_construction_complete_finish IS NOT NULL; revisit set joins stg_ndpd_mbt_tmobile_macro_combined.s_site_id = tmo_macro_copilot_ahloa_reschedule_delay_code.mb_s_site_code with status IS NOT NULL. All filters (smp_name, rgn_region, m_area, m_market, construction_gc) are optional and applied dynamically by the agent.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region from the macro project record."}, {"column": "m_area", "type": "string", "description": "Area from the macro project record."}, {"column": "m_market", "type": "string", "description": "Market from the macro project record."}, {"column": "construction_gc", "type": "string", "description": "General Contractor from the macro project record."}, {"column": "revisit_reschedule_percentage", "type": "number", "description": "Percentage (0-100, rounded to 2 decimals) of completed projects in the (region, area, market, GC) group whose site has at least one reschedule/delay-code entry (status IS NOT NULL)."}]', kpi_business_logic: '1) From stg_ndpd_mbt_tmobile_macro_combined (alias a), keep rows with pj_a_5175_construction_complete_finish IS NOT NULL — these are the completed projects. 2) Apply any agent-provided filters (smp_name, rgn_region, m_area, m_market, construction_gc) — all optional. 3) total_sites CTE: GROUP BY (a.rgn_region, a.m_area, a.m_market, a.construction_gc) and compute total_count = COUNT(DISTINCT a.pj_project_id) per group. 4) revisit_sites CTE: INNER JOIN the same filtered project set to tmo_macro_copilot_ahloa_reschedule_delay_code (alias b) on a.s_site_id = b.mb_s_site_code with b.status IS NOT NULL; GROUP BY the same dimensions and compute revisit_reschedule_count = COUNT(DISTINCT a.pj_project_id) per group. 5) LEFT JOIN total_sites to revisit_sites on the four geo dimensions (NULL-safe via COALESCE) and emit revisit_reschedule_percentage = ROUND(100.0 * COALESCE(revisit_reschedule_count, 0) / NULLIF(total_count, 0), 2) per group.', kpi_filters: '[{"name": "smp_name", "type": "string", "description": "Optional program filter on a.smp_name (e.g., \'AHLOB Modernization\', \'NTM\')."}, {"name": "rgn_region", "type": "string", "description": "Optional region filter on a.rgn_region."}, {"name": "m_area", "type": "string", "description": "Optional area filter on a.m_area."}, {"name": "m_market", "type": "string", "description": "Optional market filter on a.m_market."}, {"name": "construction_gc", "type": "string", "description": "Optional General Contractor filter on a.construction_gc."}]', kpi_contract: '{"function_name": "get_site_revisit_rate", "node_type": "kpi", "node_id": "30e3c50e-a44c-4e27-8153-71741e2507d0", "node_label": "Site Revisit Rate", "description": "Per (rgn_region, m_area, m_market, construction_gc) bucket, the percentage of completed projects whose site has at least one entry in the reschedule/delay-code table. Sources: `stg_ndpd_mbt_tmobile_macro_combined` (project + completion + program + geo dims) joined to `tmo_macro_copilot_ahloa_reschedule_delay_code` on `s_site_id = mb_s_site_code` with `status IS NOT NULL`. Completion is enforced via `pj_a_5175_construction_complete_finish IS NOT NULL`. All filters (smp_name, rgn_region, m_area, m_market, construction_gc) are optional and are applied dynamically by the agent.", "parameters": [{"name": "smp_name", "type": "string", "description": "Filter by program (e.g., \'AHLOB Modernization\', \'NTM\').", "required": false, "sample_values": ["AHLOB Modernization", "NTM"]}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn region.", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area.", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market.", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc.", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": true}, {"name": "m_area", "type": "string", "nullable": true}, {"name": "m_market", "type": "string", "nullable": true}, {"name": "construction_gc", "type": "string", "nullable": true}, {"name": "revisit_reschedule_percentage", "type": "number", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Site Revisit Rate (%) = 100 * (distinct completed projects with at least one reschedule/delay-code entry on the matching site) / (distinct completed projects), grouped by (rgn_region, m_area, m_market, construction_gc). All filters (smp_name, rgn_region, m_area, m_market, construction_gc) are optional and applied dynamically by the agent.', node_type: 'CORE', definition: 'Site Revisit Rate (%) = 100 * (distinct completed projects with at least one reschedule/delay-code entry on the matching site) / (distinct completed projects), grouped by (rgn_region, m_area, m_market, construction_gc). All filters (smp_name, rgn_region, m_area, m_market, construction_gc) are optional and applied dynamically by the agent.', kpi_python_function: 'def get_site_revisit_rate(execute_query, filters=None) -> list[dict]:\n    filters = filters or {}\n\n    where_parts = [\'a."pj_a_5175_construction_complete_finish" IS NOT NULL\']\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f"a.\\"smp_name\\" = \'{v}\'")\n    if filters.get("rgn_region"):\n        v = str(filters["rgn_region"]).replace("\'", "\'\'")\n        where_parts.append(f"a.\\"rgn_region\\" = \'{v}\'")\n    if filters.get("m_area"):\n        v = str(filters["m_area"]).replace("\'", "\'\'")\n        where_parts.append(f"a.\\"m_area\\" = \'{v}\'")\n    if filters.get("m_market"):\n        v = str(filters["m_market"]).replace("\'", "\'\'")\n        where_parts.append(f"a.\\"m_market\\" = \'{v}\'")\n    if filters.get("construction_gc"):\n        v = str(filters["construction_gc"]).replace("\'", "\'\'")\n        where_parts.append(f"a.\\"construction_gc\\" = \'{v}\'")\n    base_where = " AND ".join(where_parts)\n\n    sql = f"""\n        WITH revisit_sites AS (\n            SELECT\n                a."rgn_region",\n                a."m_area",\n                a."m_market",\n                a."construction_gc",\n                COUNT(DISTINCT a."pj_project_id") AS revisit_reschedule_count\n            FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined a\n            JOIN public.tmo_macro_copilot_ahloa_reschedule_delay_code b\n                ON a."s_site_id" = b."mb_s_site_code"\n            WHERE {base_where}\n              AND b."status" IS NOT NULL\n            GROUP BY a."rgn_region", a."m_area", a."m_market", a."construction_gc"\n        ),\n        total_sites AS (\n            SELECT\n                a."rgn_region",\n                a."m_area",\n                a."m_market",\n                a."construction_gc",\n                COUNT(DISTINCT a."pj_project_id") AS total_count\n            FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined a\n            WHERE {base_where}\n            GROUP BY a."rgn_region", a."m_area", a."m_market", a."construction_gc"\n        )\n        SELECT\n            t."rgn_region" AS "rgn_region",\n            t."m_area" AS "m_area",\n            t."m_market" AS "m_market",\n            t."construction_gc" AS "construction_gc",\n            ROUND(\n                100.0 * COALESCE(r.revisit_reschedule_count, 0)\n                      / NULLIF(t.total_count, 0),\n                2\n            ) AS "revisit_reschedule_percentage"\n        FROM total_sites t\n        LEFT JOIN revisit_sites r\n            ON COALESCE(t."rgn_region", \'\') = COALESCE(r."rgn_region", \'\')\n           AND COALESCE(t."m_area", \'\') = COALESCE(r."m_area", \'\')\n           AND COALESCE(t."m_market", \'\') = COALESCE(r."m_market", \'\')\n           AND COALESCE(t."construction_gc", \'\') = COALESCE(r."construction_gc", \'\')\n        ORDER BY t."rgn_region", t."m_area", t."m_market", t."construction_gc"\n    """\n    return execute_query(sql)', kpi_source_columns: ['stg_ndpd_mbt_tmobile_macro_combined.pj_project_id', 'stg_ndpd_mbt_tmobile_macro_combined.s_site_id', 'stg_ndpd_mbt_tmobile_macro_combined.smp_name', 'stg_ndpd_mbt_tmobile_macro_combined.pj_a_5175_construction_complete_finish', 'stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'stg_ndpd_mbt_tmobile_macro_combined.m_area', 'stg_ndpd_mbt_tmobile_macro_combined.m_market', 'stg_ndpd_mbt_tmobile_macro_combined.construction_gc', 'tmo_macro_copilot_ahloa_reschedule_delay_code.mb_s_site_code', 'tmo_macro_copilot_ahloa_reschedule_delay_code.status'], session_id: '69a3d22f26e208edc083a06e', label: 'Site Revisit Rate', kpi_related_core_node_ids: ['integration_activity'], kpi_relationship_type: 'AGGREGATES', kpi_kpi_id: '30e3c50e-a44c-4e27-8153-71741e2507d0', entity_type: 'kpi', kpi_name: 'Site Revisit Rate', name: '30e3c50e-a44c-4e27-8153-71741e2507d0', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures post-construction rework as the percentage of completed projects whose site has one or more reschedule/delay-code records, rolled up by (rgn_region, m_area, m_market, construction_gc). Pulled from stg_ndpd_mbt_tmobile_macro_combined (filtered by pj_a_5175_construction_complete_finish IS NOT NULL plus any agent-supplied filters) joined to tmo_macro_copilot_ahloa_reschedule_delay_code on s_site_id = mb_s_site_code with status IS NOT NULL. All filters (smp_name, rgn_region, m_area, m_market, construction_gc) are optional and dynamic.', status: 'mentioned', node_id: '30e3c50e-a44c-4e27-8153-71741e2507d0'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_nas_e911_readiness_riot_validation'], nl_business_rule: '', kpi_formula_description: 'From rows with nas_site_id IS NOT NULL, unpivot configured RIOT band status columns into (band_name, band_status); then compute distinct-site counts and rates per (nas_region, nas_market, vendor_dim/drilldown) including any-failure rate and per-band NOT READY rate.', kpi_output_schema: '[{"column": "view_type", "type": "string", "description": "Indicates which view the row belongs to: \'summary\' or \'band_breakdown\'."}, {"column": "nas_region", "type": "string", "description": "Region grouping."}, {"column": "nas_market", "type": "string", "description": "Market grouping."}, {"column": "drilldown_dim", "type": "string", "description": "Present when drilldown is enabled; indicates the drilldown dimension name (e.g., \'nas_engineer\')."}, {"column": "nas_engineer", "type": "string", "description": "Engineer drilldown value when drilldown_dim is \'nas_engineer\'."}, {"column": "total_validated_sites", "type": "int", "description": "Distinct count of nas_site_id in the group (validation attempted by virtue of being present with non-null nas_site_id)."}, {"column": "sites_passing_all_bands", "type": "int", "description": "Distinct sites where all configured band statuses are READY (subject to null_handling behavior)."}, {"column": "sites_with_any_failure", "type": "int", "description": "Distinct sites with at least one configured band status equal to NOT READY."}, {"column": "failure_rate_pct", "type": "float", "description": "Percentage of validated sites with any failure: sites_with_any_failure / total_validated_sites * 100."}, {"column": "e911_ready_sites", "type": "int", "description": "Distinct sites where nas_validate_e911_readiness is READY."}, {"column": "e911_not_ready_sites", "type": "int", "description": "Distinct sites where nas_validate_e911_readiness is NOT READY."}, {"column": "band_name", "type": "string", "description": "Unpivoted RIOT band/technology column name (present in band_breakdown view)."}, {"column": "failed_sites_band", "type": "int", "description": "Distinct sites with band_status = NOT READY for the given band_name (band_breakdown view)."}, {"column": "band_failure_rate_pct", "type": "float", "description": "Percentage of validated sites failing the specific band: failed_sites_band / total_validated_sites * 100 (band_breakdown view)."}]', kpi_business_logic: '1) Select rows from stg_nas_e911_readiness_riot_validation where nas_site_id is not null.\n2) Choose the set of RIOT band columns (defaults provided; can be overridden by filters.band_columns).\n3) Unpivot the chosen band columns into rows with fields: nas_site_id, nas_region, nas_market, (vendor/drilldown dim), band_name, band_status.\n4) Group by (nas_region, nas_market, vendor_dim) (vendor_dim defaults to nas_primary_gc; if filters[\'vendor_dim\']=\'nas_vendor_name\' then use nas_vendor_name instead).\n5) For each group compute:\n   - total_validated_sites = count distinct nas_site_id\n   - sites_passing_all_bands = count distinct nas_site_id where all configured band_status values are \'READY\' (NULL treated as not-ready unless filters.null_handling=\'ignore\', in which case NULLs are excluded from the all-bands-ready evaluation)\n   - sites_with_any_failure = count distinct nas_site_id where any configured band_status = \'NOT READY\'\n   - failure_rate_pct = sites_with_any_failure / total_validated_sites * 100\n   - e911_ready_sites = count distinct nas_site_id where nas_validate_e911_readiness = \'READY\'\n   - e911_not_ready_sites = count distinct nas_site_id where nas_validate_e911_readiness = \'NOT READY\'\n   - optionally filter to a specific nas_activity_type via filters[\'nas_activity_type\'].\n6) For each (nas_region, nas_market, vendor_dim, band_name) compute:\n   - failed_sites_band = count distinct nas_site_id where band_status=\'NOT READY\'\n   - total_validated_sites = same distinct-site denominator for the parent (nas_region, nas_market, vendor_dim)\n   - band_failure_rate_pct = failed_sites_band / total_validated_sites * 100.', kpi_filters: '[{"name": "band_columns", "type": "string", "description": "Overrides the default set of RIOT band status columns to unpivot/analyze."}, {"name": "vendor_dim", "type": "string", "description": "Selects the vendor grouping dimension; defaults to nas_primary_gc, or can be set to nas_vendor_name."}, {"name": "null_handling", "type": "string", "description": "Controls how NULL/missing band statuses affect all-bands-ready evaluation: \'not_ready\' (default) treats NULL as not-ready; \'ignore\' excludes NULLs from the all-bands-ready check."}, {"name": "nas_activity_type", "type": "string", "description": "Limits the population to a specific activity type."}, {"name": "drilldown_dim", "type": "string", "description": "Controls whether to include a drilldown grouping; allowed: \'nas_engineer\' or \'none\' (region/market only)."}]', kpi_contract: '{"function_name": "get_riot_failure_breakdown", "node_type": "kpi", "node_id": "8e19ae1f-5519-44ca-9a00-56a65e8f7184", "node_label": "RIOT Failure Breakdown", "description": "Analyzes RIOT/iNTP readiness validation outcomes and failure prevalence by band/technology, market/region, and (by default) primary GC. Source table: `stg_nas_e911_readiness_riot_validation`. Population: rows where `nas_site_id IS NOT NULL` (presence in the table implies validation attempted); no reliance on `nas_riot_overall_status`.\\n\\nLogic (single-table, internal unpivot):\\n1) Define band columns to analyze (defaults, overridable): `nas_validate_n41_riot`, `nas_validate_n71_riot`, `nas_validate_n25_riot`, `nas_validate_n66_riot`, `nas_validate_n2_riot`, `nas_validate_b2_riot`, `nas_validate_b66_riot`, `nas_validate_b71_riot`, `nas_validate_b41_riot`, `nas_validate_b12_riot`. Unpivot into rows: (`nas_site_id`, `nas_region`, `nas_market`, vendor_dim, `band_name`, `band_status`).\\n2) Summary per grouping key `(nas_region, nas_market, vendor_dim)` (vendor_dim defaults to `nas_primary_gc`; if `filters[\'vendor_dim\']=\'nas_vendor_name\'`, use that instead):\\n   - `total_validated_sites`: COUNT(DISTINCT nas_site_id)\\n   - `sites_passing_all_bands`: COUNT(DISTINCT nas_site_id) where for that site all configured band_status values are \'READY\' (treat missing/NULL band statuses as not-ready unless `filters[\'null_handling\']=\'ignore\'` is specified)\\n   - `sites_with_any_failure`: COUNT(DISTINCT nas_site_id) where any configured band_status = \'NOT READY\'\\n   - `failure_rate_pct`: sites_with_any_failure / NULLIF(total_validated_sites,0) * 100\\n   - `e911_ready_sites`: COUNT(DISTINCT nas_site_id) where `nas_validate_e911_readiness`=\'READY\'\\n   - `e911_not_ready_sites`: COUNT(DISTINCT nas_site_id) where `nas_validate_e911_readiness`=\'NOT READY\'\\n   - Optional filters: `filters[\'nas_activity_type\']` to limit to a specific activity type if needed.\\n3) Per-band failure breakdown per `(nas_region, nas_market, vendor_dim, band_name)`:\\n   - `failed_sites_band`: COUNT(DISTINCT nas_site_id) where band_status=\'NOT READY\'\\n   - `total_validated_sites`: COUNT(DISTINCT nas_site_id) within the same `(nas_region, nas_market, vendor_dim)` grouping (repeated denominator for context)\\n   - `band_failure_rate_pct`: failed_sites_band / NULLIF(total_validated_sites,0) * 100\\n\\nOutputs: KPI returns a dataset suitable for dashboarding with two views: (A) overall validation/failure summary by market/region/vendor, and (B) band_name-level failure breakdown to identify the most prevalent failing technologies. Key columns used: `nas_site_id`, `nas_market`, `nas_region`, `nas_activity_type`, `nas_primary_gc`, `nas_vendor_name`, `nas_validate_e911_readiness`, and the configured `nas_validate_*_riot` band columns.", "parameters": [{"name": "band_columns", "type": "string", "description": "Filter by band columns", "required": false, "sample_values": []}, {"name": "drilldown_dim", "type": "string", "description": "Filter by drilldown dim", "required": false, "sample_values": []}, {"name": "null_handling", "type": "string", "description": "Filter by null handling", "required": false, "sample_values": []}], "output_columns": [{"name": "view_type", "type": "string", "nullable": false}, {"name": "nas_region", "type": "null", "nullable": true}, {"name": "nas_market", "type": "string", "nullable": false}, {"name": "total_validated_sites", "type": "number", "nullable": false}, {"name": "sites_passing_all_bands", "type": "number", "nullable": false}, {"name": "sites_with_any_failure", "type": "number", "nullable": false}, {"name": "failure_rate_pct", "type": "number", "nullable": false}, {"name": "e911_ready_sites", "type": "number", "nullable": false}, {"name": "e911_not_ready_sites", "type": "number", "nullable": false}, {"name": "drilldown_dim", "type": "string", "nullable": false}, {"name": "nas_engineer", "type": "string", "nullable": true}], "sample_output": [{"view_type": "summary", "nas_region": null, "nas_market": "CH", "total_validated_sites": 1, "sites_passing_all_bands": 0, "sites_with_any_failure": 0, "failure_rate_pct": 0.0, "e911_ready_sites": 0, "e911_not_ready_sites": 0, "drilldown_dim": "nas_engineer", "nas_engineer": "N/A"}, {"view_type": "summary", "nas_region": "Central", "nas_market": "DE", "total_validated_sites": 3, "sites_passing_all_bands": 0, "sites_with_any_failure": 0, "failure_rate_pct": 0.0, "e911_ready_sites": 0, "e911_not_ready_sites": 0, "drilldown_dim": "nas_engineer", "nas_engineer": "PASS"}, {"view_type": "summary", "nas_region": null, "nas_market": "IN", "total_validated_sites": 3, "sites_passing_all_bands": 0, "sites_with_any_failure": 0, "failure_rate_pct": 0.0, "e911_ready_sites": 0, "e911_not_ready_sites": 0, "drilldown_dim": "nas_engineer", "nas_engineer": null}], "row_count": 10}', nl_description: 'KPI = unpivot the RIOT band columns on stg_nas_e911_readiness_riot_validation (nas_g1900_riot, nas_l600_riot, nas_l700_riot, nas_l850_riot, nas_laws3_riot, nas_l1900_c1_riot, nas_l1900_c2_riot, nas_l2100_c1_riot, nas_l2100_c2_riot, nas_l2500_c1_riot, nas_l2500_c2_riot, nas_n600_c1_riot, nas_n600_c2_riot, nas_n1900_c1_riot, nas_n1900_c2_riot, nas_n2500_c1_riot, nas_n2500_c2_riot, nas_n2500_c3_riot, nas_n2100_c1_riot, nas_u2100_c1_riot, nas_u1900_c1_riot, nas_n24g_c3_riot) over rows with nas_site_id not null; then for each (nas_region, nas_market) and optionally nas_engineer, compute distinct-site totals, all-bands-ready counts, any-failure counts/rates, and E911 readiness counts; additionally compute per-band distinct-site NOT READY counts and per-band failure rates using the same group denominator.', node_type: 'CORE', definition: 'KPI = unpivot the RIOT band columns on stg_nas_e911_readiness_riot_validation (nas_g1900_riot, nas_l600_riot, nas_l700_riot, nas_l850_riot, nas_laws3_riot, nas_l1900_c1_riot, nas_l1900_c2_riot, nas_l2100_c1_riot, nas_l2100_c2_riot, nas_l2500_c1_riot, nas_l2500_c2_riot, nas_n600_c1_riot, nas_n600_c2_riot, nas_n1900_c1_riot, nas_n1900_c2_riot, nas_n2500_c1_riot, nas_n2500_c2_riot, nas_n2500_c3_riot, nas_n2100_c1_riot, nas_u2100_c1_riot, nas_u1900_c1_riot, nas_n24g_c3_riot) over rows with nas_site_id not null; then for each (nas_region, nas_market) and optionally nas_engineer, compute distinct-site totals, all-bands-ready counts, any-failure counts/rates, and E911 readiness counts; additionally compute per-band distinct-site NOT READY counts and per-band failure rates using the same group denominator.', kpi_python_function: 'def get_riot_failure_breakdown(execute_query, filters=None) -> list[dict]:\n    filters = filters or {}\n\n    # Actual RIOT band columns on stg_nas_e911_readiness_riot_validation\n    default_band_columns = [\n        "nas_g1900_riot",\n        "nas_l600_riot",\n        "nas_l700_riot",\n        "nas_l850_riot",\n        "nas_laws3_riot",\n        "nas_l1900_c1_riot",\n        "nas_l1900_c2_riot",\n        "nas_l2100_c1_riot",\n        "nas_l2100_c2_riot",\n        "nas_l2500_c1_riot",\n        "nas_l2500_c2_riot",\n        "nas_n600_c1_riot",\n        "nas_n600_c2_riot",\n        "nas_n1900_c1_riot",\n        "nas_n1900_c2_riot",\n        "nas_n2500_c1_riot",\n        "nas_n2500_c2_riot",\n        "nas_n2500_c3_riot",\n        "nas_n2100_c1_riot",\n        "nas_u2100_c1_riot",\n        "nas_u1900_c1_riot",\n        "nas_n24g_c3_riot",\n    ]\n\n    band_columns = filters.get("band_columns") or default_band_columns\n    if isinstance(band_columns, str):\n        band_columns = [c.strip() for c in band_columns.split(",") if c.strip()]\n\n    # Only available drill-down dim on this table is nas_engineer.\n    # Allow turning it off to group by region/market only.\n    drilldown_dim = (filters.get("drilldown_dim") or "nas_engineer").strip()\n    allowed_drilldowns = {"nas_engineer", "none"}\n    if drilldown_dim not in allowed_drilldowns:\n        drilldown_dim = "nas_engineer"\n\n    null_handling = (filters.get("null_handling") or "not_ready").lower()\n    # null_handling: \'not_ready\' (default) treats NULL/missing as not-ready; \'ignore\' excludes NULLs from all-bands-ready evaluation\n    if null_handling not in {"not_ready", "ignore"}:\n        null_handling = "not_ready"\n\n    select_cols = [\n        "nas_site_id",\n        "nas_region",\n        "nas_market",\n        "nas_engineer",\n        "nas_validate_e911_readiness",\n    ] + band_columns\n\n    def _ident(col: str) -> str:\n        return \'"\' + col.replace(\'"\', \'""\') + \'"\'\n\n    sql = (\n        f"""SELECT {\', \'.join((_ident(c) for c in select_cols))} FROM pwc_macro_staging_schema.stg_nas_e911_readiness_riot_validation WHERE "nas_site_id" IS NOT NULL"""\n    )\n\n    rows = execute_query(sql)\n\n    def _norm_status(v):\n        if v is None:\n            return None\n        s = str(v).strip().upper()\n        if s == "":\n            return None\n        return s\n\n    # Groupings\n    total_sites = {}          # key -> set(site_id)\n    passing_all_bands = {}    # key -> set(site_id)\n    any_failure = {}          # key -> set(site_id)\n    e911_ready = {}           # key -> set(site_id)\n    e911_not_ready = {}       # key -> set(site_id)\n    band_failed_sites = {}    # (key, band_name) -> set(site_id)\n\n    for r in rows:\n        site_id = r.get("nas_site_id")\n        if site_id is None:\n            continue\n\n        region = r.get("nas_region")\n        market = r.get("nas_market")\n        engineer = r.get("nas_engineer")\n\n        if drilldown_dim == "nas_engineer":\n            key = (region, market, engineer)\n        else:\n            key = (region, market)\n\n        total_sites.setdefault(key, set()).add(site_id)\n\n        # E911 readiness\n        e911_stat = _norm_status(r.get("nas_validate_e911_readiness"))\n        if e911_stat == "READY":\n            e911_ready.setdefault(key, set()).add(site_id)\n        elif e911_stat == "NOT READY":\n            e911_not_ready.setdefault(key, set()).add(site_id)\n\n        # Evaluate band statuses for this site\n        statuses = [(bc, _norm_status(r.get(bc))) for bc in band_columns]\n\n        # any failure = any configured band_status == \'NOT READY\'\n        if any(st == "NOT READY" for _, st in statuses):\n            any_failure.setdefault(key, set()).add(site_id)\n\n        # per-band failures\n        for band_name, st in statuses:\n            if st == "NOT READY":\n                band_failed_sites.setdefault((key, band_name), set()).add(site_id)\n\n        # sites_passing_all_bands\n        if null_handling == "ignore":\n            considered = [st for _, st in statuses if st is not None]\n            if considered and all(st == "READY" for st in considered):\n                passing_all_bands.setdefault(key, set()).add(site_id)\n        else:\n            if all(st == "READY" for _, st in statuses):\n                passing_all_bands.setdefault(key, set()).add(site_id)\n\n    results = []\n\n    # Summary rows\n    for key, sites_set in total_sites.items():\n        total = len(sites_set)\n        pass_all = len(passing_all_bands.get(key, set()))\n        any_fail = len(any_failure.get(key, set()))\n        e911_r = len(e911_ready.get(key, set()))\n        e911_nr = len(e911_not_ready.get(key, set()))\n        failure_rate_pct = (any_fail / total * 100.0) if total else None\n\n        if drilldown_dim == "nas_engineer":\n            region, market, engineer = key\n        else:\n            region, market = key\n            engineer = None\n\n        row = {\n            "view_type": "summary",\n            "nas_region": region,\n            "nas_market": market,\n            "total_validated_sites": total,\n            "sites_passing_all_bands": pass_all,\n            "sites_with_any_failure": any_fail,\n            "failure_rate_pct": failure_rate_pct,\n            "e911_ready_sites": e911_r,\n            "e911_not_ready_sites": e911_nr,\n        }\n        if drilldown_dim == "nas_engineer":\n            row.update({\n                "drilldown_dim": "nas_engineer",\n                "nas_engineer": engineer,\n            })\n        results.append(row)\n\n    # Band breakdown rows\n    for key, sites_set in total_sites.items():\n        total = len(sites_set)\n\n        if drilldown_dim == "nas_engineer":\n            region, market, engineer = key\n        else:\n            region, market = key\n            engineer = None\n\n        for band_name in band_columns:\n            failed = len(band_failed_sites.get((key, band_name), set()))\n            band_failure_rate_pct = (failed / total * 100.0) if total else None\n            row = {\n                "view_type": "band_breakdown",\n                "nas_region": region,\n                "nas_market": market,\n                "band_name": band_name,\n                "failed_sites_band": failed,\n                "total_validated_sites": total,\n                "band_failure_rate_pct": band_failure_rate_pct,\n            }\n            if drilldown_dim == "nas_engineer":\n                row.update({\n                    "drilldown_dim": "nas_engineer",\n                    "nas_engineer": engineer,\n                })\n            results.append(row)\n\n    return results\n', kpi_source_columns: ['nas_site_id', 'nas_region', 'nas_market', 'nas_activity_type', 'nas_primary_gc', 'nas_vendor_name', 'nas_engineer', 'nas_validate_e911_readiness', 'nas_validate_n41_riot', 'nas_validate_n71_riot', 'nas_validate_n25_riot', 'nas_validate_n66_riot', 'nas_validate_n2_riot', 'nas_validate_b2_riot', 'nas_validate_b66_riot', 'nas_validate_b71_riot', 'nas_validate_b41_riot', 'nas_validate_b12_riot', 'nas_g1900_riot', 'nas_l600_riot', 'nas_l700_riot', 'nas_l850_riot', 'nas_laws3_riot', 'nas_l1900_c1_riot', 'nas_l1900_c2_riot', 'nas_l2100_c1_riot', 'nas_l2100_c2_riot', 'nas_l2500_c1_riot', 'nas_l2500_c2_riot', 'nas_n600_c1_riot', 'nas_n600_c2_riot', 'nas_n1900_c1_riot', 'nas_n1900_c2_riot', 'nas_n2500_c1_riot', 'nas_n2500_c2_riot', 'nas_n2500_c3_riot', 'nas_n2100_c1_riot', 'nas_u2100_c1_riot', 'nas_u1900_c1_riot', 'nas_n24g_c3_riot'], session_id: '69a3d22f26e208edc083a06e', label: 'RIOT Failure Breakdown', kpi_related_core_node_ids: ['integration_activity'], kpi_relationship_type: 'DERIVED_FROM', kpi_kpi_id: '8e19ae1f-5519-44ca-9a00-56a65e8f7184', entity_type: 'kpi', kpi_name: 'RIOT Failure Breakdown', name: '8e19ae1f-5519-44ca-9a00-56a65e8f7184', kpi_dimensions: ['nas_region', 'nas_market', 'nas_primary_gc', 'nas_vendor_name', 'nas_engineer', 'band_name'], kpi_description: 'Analyzes RIOT/iNTP readiness validation outcomes to quantify how prevalent failures are across technologies (bands) by geography and a primary vendor grouping. It supports dashboarding to identify markets/regions and technologies with the highest NOT READY rates and to compare overall readiness versus E911 readiness.', status: 'mentioned', node_id: '8e19ae1f-5519-44ca-9a00-56a65e8f7184'});
CREATE (:BKGNode {map_table_name: 'stg_nas_planned_outage_activity', map_key_column: 'id', nl_business_rule: '', session_id: '69a3d22f26e208edc083a06e', label: 'Planned Outage', map_sql_template: 'SELECT "id", "nas_status", "nas_project_category", "nas_site_id", "nas_nest_type", "nas_workorder_id", "nas_market", "nas_activity_details", "nas_activity_start_date", "nas_activity_end_date", "nas_activity_duration", "nas_request_time", "nas_colocated_sites", "nas_company_name", "nas_wm_connected_sites" FROM "pwc_macro_staging_schema"."stg_nas_planned_outage_activity"', map_label_column: 'nas_workorder_id', nl_description: 'A scheduled NAS maintenance/outage window for a primary Site, coordinated/owned by NAS (Nokia), during which network services are intentionally taken offline to enable integration/construction completion/troubleshooting. Includes requested start/end, duration, NEST type (e.g., NSI/SI), status lifecycle (pending/approved/active/completed/rejected/cancelled), work-order identifier, and overrun/extension handling. Tracks secondary impacted co-located/neighbor Sites via impacts_site; primary work Site is linked via is_for_site. The company performing the work requiring the outage (nas_company_name) is modeled via work_performed_by when not Nokia.', map_contract: '{"function_name": "get_planned_outage", "node_type": "core", "node_id": "planned_outage", "node_label": "Planned Outage", "description": "Query Planned Outage data from stg_nas_planned_outage_activity", "parameters": [{"name": "id", "type": "number", "description": "Filter by id (primary key)", "required": false, "sample_values": ["2340", "2341", "2342"]}, {"name": "nas_workorder_id", "type": "string", "description": "Filter by nas_workorder_id", "required": false, "sample_values": ["CHG084348788", "CHG0290391330", "CHG0291029710"]}, {"name": "nas_nest_type", "type": "string", "description": "Filter by nas_nest_type", "required": false, "sample_values": ["NSI", "SI"]}, {"name": "nas_status", "type": "string", "description": "Filter by nas_status", "required": false, "sample_values": ["cancelled", "rejected", "approved"]}, {"name": "nas_market", "type": "string", "description": "Filter by nas_market", "required": false, "sample_values": ["Chicago", "Detroit", "Indianapolis"]}, {"name": "nas_project_category", "type": "string", "description": "Filter by nas_project_category", "required": false, "sample_values": ["ACS DAS Venue", "AHLOA-B SWAP", "Microwave"]}, {"name": "nas_colocated_sites", "type": "string", "description": "Filter by nas_colocated_sites", "required": false, "sample_values": ["IN10002A, ML10003A"]}, {"name": "nas_site_id", "type": "string", "description": "Filter by nas_site_id", "required": false, "sample_values": ["CH10000A", "DE10001A", "IN10002A"]}, {"name": "nas_request_time", "type": "string", "description": "Filter by nas_request_time", "required": false, "sample_values": ["2026-02-24 17:49:34", "2026-03-05 18:23:43", "2025-12-30 01:37:44"]}, {"name": "nas_company_name", "type": "string", "description": "Filter by nas_company_name", "required": false, "sample_values": ["Nokia", "Telcom Construction", "KCCTech"]}, {"name": "nas_activity_start_date", "type": "string", "description": "Filter by nas_activity_start_date", "required": false, "sample_values": ["2026-03-01 17:49:34", "2026-03-09 18:23:43", "2026-01-08 01:37:44"]}, {"name": "nas_activity_end_date", "type": "string", "description": "Filter by nas_activity_end_date", "required": false, "sample_values": ["2026-03-02 00:49:34", "2026-03-10 01:23:43", "2026-01-08 11:37:44"]}], "output_columns": [{"name": "id", "type": "number", "nullable": false}, {"name": "nas_status", "type": "string", "nullable": false}, {"name": "nas_project_category", "type": "string", "nullable": false}, {"name": "nas_site_id", "type": "string", "nullable": false}, {"name": "nas_nest_type", "type": "string", "nullable": false}, {"name": "nas_workorder_id", "type": "string", "nullable": false}, {"name": "nas_market", "type": "string", "nullable": false}, {"name": "nas_activity_details", "type": "string", "nullable": false}, {"name": "nas_activity_start_date", "type": "string", "nullable": false}, {"name": "nas_activity_end_date", "type": "string", "nullable": false}, {"name": "nas_activity_duration", "type": "string", "nullable": true}, {"name": "nas_request_time", "type": "string", "nullable": false}, {"name": "nas_colocated_sites", "type": "string", "nullable": true}, {"name": "nas_company_name", "type": "string", "nullable": false}, {"name": "nas_wm_connected_sites", "type": "string", "nullable": true}], "sample_output": [], "row_count": 3}', entity_type: 'transaction', node_type: 'CORE', map_python_function: 'def get_planned_outage(execute_query: callable, filters: dict = None) -> list[dict]:\n    """Fetch Planned Outage records with curated columns and common filters.\n\n    Supported equality filters (by column name):\n      - nas_status, nas_market, nas_site_id, nas_nest_type, nas_project_category, nas_company_name\n\n    Supported date range filters (applied to nas_activity_start_date):\n      - start_date_from: inclusive lower bound (ISO timestamp string)\n      - start_date_to: exclusive upper bound (ISO timestamp string)\n\n    Node: Planned Outage | Table: stg_nas_planned_outage_activity | Key: id | DB: public\n    """\n\n    select_sql = (\n        \'SELECT "id", "nas_status", "nas_project_category", "nas_site_id", "nas_nest_type", \'\n        \'"nas_workorder_id", "nas_market", "nas_activity_details", "nas_activity_start_date", \'\n        \'"nas_activity_end_date", "nas_activity_duration", "nas_request_time", \'\n        \'"nas_colocated_sites", "nas_company_name", "nas_wm_connected_sites" \'\n        \'FROM "pwc_macro_staging_schema"."stg_nas_planned_outage_activity"\'\n    )\n\n    where_parts = []\n\n    if filters:\n        # Date range filters (special keys)\n        start_from = filters.get(\'start_date_from\')\n        start_to = filters.get(\'start_date_to\')\n        if start_from is not None:\n            escaped = str(start_from).replace("\'", "\'\'")\n            where_parts.append(f\'"nas_activity_start_date" >= \\\'{escaped}\\\'\')\n        if start_to is not None:\n            escaped = str(start_to).replace("\'", "\'\'")\n            where_parts.append(f\'"nas_activity_start_date" < \\\'{escaped}\\\'\')\n\n        # Column equality filters\n        allowed_eq = {\n            \'nas_status\',\n            \'nas_market\',\n            \'nas_site_id\',\n            \'nas_nest_type\',\n            \'nas_project_category\',\n            \'nas_company_name\',\n        }\n\n        for k, v in filters.items():\n            if k in (\'start_date_from\', \'start_date_to\'):\n                continue\n            if k not in allowed_eq:\n                continue\n\n            if v is None:\n                where_parts.append(f\'"{k}" IS NULL\')\n            elif isinstance(v, (list, tuple, set)):\n                values = [item for item in v if item is not None]\n                if not values:\n                    where_parts.append(\'1=0\')\n                else:\n                    in_list = []\n                    for item in values:\n                        escaped = str(item).replace("\'", "\'\'")\n                        in_list.append(f"\'{escaped}\'")\n                    where_parts.append(f\'"{k}" IN ({", ".join(in_list)})\')\n            else:\n                escaped = str(v).replace("\'", "\'\'")\n                where_parts.append(f\'"{k}" = \\\'{escaped}\\\'\')\n\n    sql = select_sql\n    if where_parts:\n        sql += \' WHERE \' + \' AND \'.join(where_parts)\n\n    rows = execute_query(sql)\n    return rows if rows else []\n', is_skipped: false, name: 'planned_outage', definition: 'A scheduled NAS maintenance/outage window for a primary Site, coordinated/owned by NAS (Nokia), during which network services are intentionally taken offline to enable integration/construction completion/troubleshooting. Includes requested start/end, duration, NEST type (e.g., NSI/SI), status lifecycle (pending/approved/active/completed/rejected/cancelled), work-order identifier, and overrun/extension handling. Tracks secondary impacted co-located/neighbor Sites via impacts_site; primary work Site is linked via is_for_site. The company performing the work requiring the outage (nas_company_name) is modeled via work_performed_by when not Nokia.', map_database_name: 'public', skip_reason: '', status: 'mentioned', node_id: 'planned_outage'});
CREATE (:BKGNode {map_table_name: 'stg_nas_nest_ext_raw_by_session', map_key_column: 'id', nl_business_rule: '', session_id: '69a3d22f26e208edc083a06e', label: 'NEST Extension', map_sql_template: 'SELECT "id", "nas_session_id", "nas_date_requested", "nas_region", "nas_market", "nas_project_category", "nas_site_id", "nas_category", "nas_vendorname", "nas_company_name" FROM "pwc_macro_staging_schema"."stg_nas_nest_ext_raw_by_session"', map_label_column: 'nas_session_id', nl_description: 'A formal NAS request to extend an approved maintenance/outage (NEST) window beyond its scheduled end time when work cannot be completed within the originally approved Planned Outage window. In data, the NEST Extension is keyed by nas_session_id and links reliably to Integration Activity; linkage to a specific Planned Outage is inferred (site+time overlap) and may be optional.', map_contract: '{"function_name": "get_nest_extension", "node_type": "core", "node_id": "nest_extension", "node_label": "NEST Extension", "description": "Query NEST Extension data from stg_nas_nest_ext_raw_by_session", "parameters": [{"name": "id", "type": "number", "description": "Filter by id (primary key)", "required": false, "sample_values": ["7675467", "7675468", "7675469"]}, {"name": "nas_session_id", "type": "string", "description": "Filter by nas_session_id", "required": false, "sample_values": ["300000", "300001", "300002"]}, {"name": "nas_region", "type": "string", "description": "Filter by nas_region", "required": false, "sample_values": ["Central"]}, {"name": "nas_category", "type": "string", "description": "Filter by nas_category", "required": false, "sample_values": ["Integration Work", "Backhaul Issues"]}, {"name": "nas_project_category", "type": "string", "description": "Filter by nas_project_category", "required": false, "sample_values": ["Equipment Upgrade", "ABIO Swap plus 5G Midband"]}, {"name": "nas_market", "type": "string", "description": "Filter by nas_market", "required": false, "sample_values": ["Chicago", "Detroit", "Indianapolis"]}, {"name": "nas_vendorname", "type": "string", "description": "Filter by nas_vendorname", "required": false, "sample_values": ["ONT", "CPT", "EWS"]}, {"name": "nas_date_requested", "type": "string", "description": "Filter by nas_date_requested", "required": false, "sample_values": ["2026-01-23 09:29:25", "2025-12-07 03:13:39", "2026-01-20 02:44:56"]}, {"name": "nas_site_id", "type": "string", "description": "Filter by nas_site_id", "required": false, "sample_values": ["CH10000A", "DE10001A", "IN10002A"]}, {"name": "nas_company_name", "type": "string", "description": "Filter by nas_company_name", "required": false, "sample_values": ["Ontivity", "ClearPath Telecom", "EWS Group"]}], "output_columns": [{"name": "id", "type": "number", "nullable": false}, {"name": "nas_session_id", "type": "string", "nullable": false}, {"name": "nas_date_requested", "type": "string", "nullable": false}, {"name": "nas_region", "type": "string", "nullable": false}, {"name": "nas_market", "type": "string", "nullable": false}, {"name": "nas_project_category", "type": "string", "nullable": false}, {"name": "nas_site_id", "type": "string", "nullable": false}, {"name": "nas_category", "type": "string", "nullable": false}, {"name": "nas_vendorname", "type": "string", "nullable": false}, {"name": "nas_company_name", "type": "string", "nullable": false}], "sample_output": [], "row_count": 3}', entity_type: 'transaction', node_type: 'CORE', map_python_function: 'def get_nest_extension(execute_query: callable, filters: dict = None) -> list[dict]:\n    """Fetch all NEST Extension records.\n    Node: NEST Extension | Table: stg_nas_nest_ext_raw_by_session | Key: id | DB: public\n    """\n    base_sql = (\n        \'SELECT "id", "nas_session_id", "nas_date_requested", "nas_region", "nas_market", \'\n        \'"nas_project_category", "nas_site_id", "nas_category", "nas_vendorname", \'\n        \'"nas_company_name" FROM "pwc_macro_staging_schema"."stg_nas_nest_ext_raw_by_session"\'\n    )\n\n    where_parts = []\n    if filters:\n        for k, v in filters.items():\n            escaped = str(v).replace("\'", "\'\'")\n            where_parts.append(f\'"{k}" = \\\'{escaped}\\\'\')\n\n    if where_parts:\n        base_sql += " WHERE " + " AND ".join(where_parts)\n\n    rows = execute_query(base_sql)\n    return rows if rows else []', is_skipped: false, name: 'nest_extension', definition: 'A formal NAS request to extend an approved maintenance/outage (NEST) window beyond its scheduled end time when work cannot be completed within the originally approved Planned Outage window. In data, the NEST Extension is keyed by nas_session_id and links reliably to Integration Activity; linkage to a specific Planned Outage is inferred (site+time overlap) and may be optional.', map_database_name: 'public', skip_reason: '', status: 'mentioned', node_id: 'nest_extension'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'For sites where pj_a_3875 (BOM received) IS NOT NULL and pj_a_3925 (material pickup) IS NULL, compute aging = CURRENT_DATE - pj_a_3875::date. Report count, avg/p50/p90 aging, and count >30 days.', kpi_output_schema: '[{"column": "rgn_region", "type": "string"}, {"column": "m_area", "type": "string"}, {"column": "m_market", "type": "string"}, {"column": "construction_gc", "type": "string"}, {"column": "unpicked_site_count", "type": "int", "description": "Sites with BOM received but not picked up"}, {"column": "avg_aging_days", "type": "float", "description": "Average days since BOM receipt"}, {"column": "over_30_day_count", "type": "int", "description": "Sites exceeding 30-day threshold"}]', kpi_business_logic: '1) From stg_ndpd_mbt_tmobile_macro_combined, exclude Dead projects. 2) Keep rows where pj_a_3875_bom_received_bom_in_aims_finish IS NOT NULL (BOM received at warehouse) AND pj_a_3925_msl_pickup_date_finish IS NULL (material not yet picked up). 3) Compute aging_days = CURRENT_DATE - pj_a_3875::date. 4) Group by rgn_region, m_area, m_market, construction_gc. 5) Report: unpicked_site_count, avg/p50/p90 aging days, count exceeding 30-day threshold.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Filter by region"}, {"name": "m_area", "type": "string", "description": "Filter by area"}, {"name": "m_market", "type": "string", "description": "Filter by market"}, {"name": "construction_gc", "type": "string", "description": "Filter by GC"}, {"name": "smp_name", "type": "string", "description": "Optional program filter. Values: \'NTM\', \'AHLOB Modernization\'."}]', kpi_contract: '{"function_name": "get_material_pickup_timeliness", "node_type": "kpi", "node_id": "72cf6b23-27b4-4a7d-92ba-e258e2444be2", "node_label": "Material Pickup Timeliness", "description": "Reveals whether projects are waiting on GC material pickup/validation after materials become available, helping reduce idle time before construction and integration.", "parameters": [], "output_columns": [], "sample_output": [], "row_count": 0}', nl_description: 'Identifies sites where material has been received at the warehouse but not picked up by the GC, with aging days since BOM receipt. Highlights sites exceeding the 30-day threshold. Optionally filterable by program via smp_name.', node_type: 'CORE', definition: 'Reveals whether projects are waiting on GC material pickup/validation after materials become available, helping reduce idle time before construction and integration.', kpi_python_function: 'def get_material_pickup_timeliness(execute_query, filters=None) -> list[dict]:\n    """Material Pickup Timeliness\n\n    Sites where BOM received at warehouse but not picked up for >30 days.\n    Source: pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n    """\n    filters = filters or {}\n\n    where_parts = [\n        "1=1",\n        "COALESCE(\\"pj_project_status\\", \'\') <> \'Dead\'",\n        "\\"pj_a_3875_bom_received_bom_in_aims_finish\\" IS NOT NULL",\n        "\\"pj_a_3925_msl_pickup_date_finish\\" IS NULL"\n    ]\n\n    if filters.get("rgn_region"):\n        v = str(filters["rgn_region"]).replace("\'", "\'\'")\n        where_parts.append(f\'"rgn_region" = \\\'{v}\\\'\')\n    if filters.get("m_area"):\n        v = str(filters["m_area"]).replace("\'", "\'\'")\n        where_parts.append(f\'"m_area" = \\\'{v}\\\'\')\n    if filters.get("m_market"):\n        v = str(filters["m_market"]).replace("\'", "\'\'")\n        where_parts.append(f\'"m_market" = \\\'{v}\\\'\')\n    if filters.get("construction_gc"):\n        v = str(filters["construction_gc"]).replace("\'", "\'\'")\n        where_parts.append(f\'"construction_gc" = \\\'{v}\\\'\')\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        # NTM-specific filters (per Nokia Question Bank)\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n    SELECT\n      "rgn_region", "m_area", "m_market", "construction_gc",\n      COUNT(DISTINCT "pj_project_id") AS "unpicked_site_count",\n      AVG(CURRENT_DATE - "pj_a_3875_bom_received_bom_in_aims_finish"::date)\n        AS "avg_aging_days",\n      COUNT(DISTINCT "pj_project_id") FILTER (\n        WHERE (CURRENT_DATE - "pj_a_3875_bom_received_bom_in_aims_finish"::date) > 30\n      ) AS "over_30_day_count"\n    FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n    WHERE {where_sql}\n    GROUP BY "rgn_region", "m_area", "m_market", "construction_gc"\n    ORDER BY "rgn_region", "m_area", "m_market", "construction_gc"\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_project_status', 'pj_a_3875_bom_received_bom_in_aims_finish', 'pj_a_3925_msl_pickup_date_finish', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Material Pickup Timeliness', kpi_related_core_node_ids: ['project', 'site', 'material_equipment', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '72cf6b23-27b4-4a7d-92ba-e258e2444be2', entity_type: 'kpi', kpi_name: 'Material Pickup Timeliness', name: '72cf6b23-27b4-4a7d-92ba-e258e2444be2', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_project_status', 'site_code', 'pj_project_id'], kpi_description: 'Identifies sites where material has been received at the warehouse but not picked up by the GC, with aging days since BOM receipt. Highlights sites exceeding the 30-day threshold. Optionally filterable by program via smp_name.', status: 'mentioned', node_id: '72cf6b23-27b4-4a7d-92ba-e258e2444be2'});
CREATE (:BKGNode {map_table_name: 'stg_tmo_nas_daily_dashboard', map_key_column: 'id', nl_business_rule: '', session_id: '69a3d22f26e208edc083a06e', label: 'NAS Daily Dashboard Entry', map_sql_template: 'SELECT "id", "region", "market", "project_category", "sow", "nest_type", "session_id", "site_id", "on_site", "company_name", "activity", "activity_status", "current_layers_sector_status", "checkin_latest_start_time", "checkout_os", "totalActivity_duration", "initial_nest_approved", "nest_extension_hrs", "nest_extension_approver", "pre_rtwp", "post_rtwp", "pre_alarm", "pre_2g_3g_alarm", "post_2g_3g_alarm", "post_alarm", "warroom_comments", "create_uid", "create_date", "write_uid", "write_date" FROM "public"."stg_tmo_nas_daily_dashboard"', map_label_column: 'session_id', nl_description: 'Shift-level war room snapshot row for an NAS integration session (daily-refreshed operational view). Grain: 1 row per NAS session (not per day). Enriches Integration Activity with real-time RF quality signals (pre/post RTWP, pre/post alarm states across layers, sector/layer status) and free-text war room comments. Contains timestamps for latest check-in start and checkout on-site. Includes nest_type as an attribute (NSI/SI) but has no direct outage/workorder FK; outage linkage is via site+time inference if needed.', map_contract: '{"function_name": "get_nas_daily_dashboard_entry", "node_type": "core", "node_id": "nas_daily_dashboard_entry", "node_label": "NAS Daily Dashboard Entry", "description": "Query NAS Daily Dashboard Entry data from stg_tmo_nas_daily_dashboard", "parameters": [{"name": "id", "type": "number", "description": "Filter by id (primary key)", "required": false, "sample_values": ["400000", "400001", "400002"]}, {"name": "session_id", "type": "string", "description": "Filter by session_id", "required": false, "sample_values": ["300000", "300001", "300002"]}, {"name": "region", "type": "string", "description": "Filter by region", "required": false, "sample_values": ["Central"]}, {"name": "project_category", "type": "string", "description": "Filter by project_category", "required": false, "sample_values": []}, {"name": "activity_status", "type": "string", "description": "Filter by activity_status", "required": false, "sample_values": ["Completed"]}, {"name": "current_layers_sector_status", "type": "string", "description": "Filter by current_layers_sector_status", "required": false, "sample_values": ["Pending"]}, {"name": "market", "type": "string", "description": "Filter by market", "required": false, "sample_values": ["Chicago", "Detroit", "Indianapolis"]}, {"name": "nest_type", "type": "string", "description": "Filter by nest_type", "required": false, "sample_values": ["shoulder", "gas"]}, {"name": "sow", "type": "string", "description": "Filter by sow", "required": false, "sample_values": ["go"]}, {"name": "on_site", "type": "string", "description": "Filter by on_site", "required": false, "sample_values": ["control"]}, {"name": "activity", "type": "string", "description": "Filter by activity", "required": false, "sample_values": ["across"]}, {"name": "checkout_os", "type": "string", "description": "Filter by checkout_os", "required": false, "sample_values": ["2026-02-10 08:01:58"]}], "output_columns": [{"name": "id", "type": "number", "nullable": false}, {"name": "region", "type": "string", "nullable": false}, {"name": "market", "type": "string", "nullable": false}, {"name": "project_category", "type": "string", "nullable": true}, {"name": "sow", "type": "string", "nullable": true}, {"name": "nest_type", "type": "string", "nullable": true}, {"name": "session_id", "type": "string", "nullable": false}, {"name": "site_id", "type": "string", "nullable": false}, {"name": "on_site", "type": "string", "nullable": true}, {"name": "company_name", "type": "string", "nullable": false}, {"name": "activity", "type": "string", "nullable": true}, {"name": "activity_status", "type": "string", "nullable": true}, {"name": "current_layers_sector_status", "type": "string", "nullable": true}, {"name": "checkin_latest_start_time", "type": "string", "nullable": false}, {"name": "checkout_os", "type": "string", "nullable": true}, {"name": "totalActivity_duration", "type": "string", "nullable": false}, {"name": "initial_nest_approved", "type": "string", "nullable": true}, {"name": "nest_extension_hrs", "type": "string", "nullable": true}, {"name": "nest_extension_approver", "type": "string", "nullable": true}, {"name": "pre_rtwp", "type": "string", "nullable": true}, {"name": "post_rtwp", "type": "string", "nullable": true}, {"name": "pre_alarm", "type": "string", "nullable": false}, {"name": "pre_2g_3g_alarm", "type": "string", "nullable": true}, {"name": "post_2g_3g_alarm", "type": "string", "nullable": true}, {"name": "post_alarm", "type": "string", "nullable": false}, {"name": "warroom_comments", "type": "string", "nullable": false}, {"name": "create_uid", "type": "number", "nullable": false}, {"name": "create_date", "type": "string", "nullable": false}, {"name": "write_uid", "type": "number", "nullable": false}, {"name": "write_date", "type": "string", "nullable": false}], "sample_output": [], "row_count": 3}', entity_type: 'transaction', node_type: 'CORE', map_python_function: 'def get_nas_daily_dashboard_entry(execute_query: callable, filters: dict = None) -> list[dict]:\n    """Fetch NAS Daily Dashboard Entry records.\n\n    Node: NAS Daily Dashboard Entry | Table: stg_tmo_nas_daily_dashboard | Key: id | DB: public\n\n    Supported filters (curated):\n      - session_id, site_id, market, region, company_name, activity_status, nest_type\n      - checkin_start_from, checkin_start_to (applied to checkin_latest_start_time)\n\n    Notes:\n      - Date filters expect ISO-8601 strings (e.g., \'2026-02-01\' or \'2026-02-01T00:00:00\').\n      - Unknown filter keys are ignored (to avoid accidental SQL injection via column names).\n    """\n\n    base_sql = (\n        \'SELECT \'\n        \'"id", "region", "market", "project_category", "sow", "nest_type", "session_id", "site_id", \'\n        \'"on_site", "company_name", \'\n        \'"activity", "activity_status", "current_layers_sector_status", \'\n        \'"checkin_latest_start_time", "checkout_os", "totalActivity_duration", \'\n        \'"initial_nest_approved", "nest_extension_hrs", "nest_extension_approver", \'\n        \'"pre_rtwp", "post_rtwp", "pre_alarm", "pre_2g_3g_alarm", "post_2g_3g_alarm", "post_alarm", \'\n        \'"warroom_comments", "create_uid", "create_date", "write_uid", "write_date" \'\n        \'FROM "public"."stg_tmo_nas_daily_dashboard"\'\n    )\n\n    allowed_equals = {\n        "session_id",\n        "site_id",\n        "market",\n        "region",\n        "company_name",\n        "activity_status",\n        "nest_type",\n    }\n\n    where_parts = []\n\n    def _escape(val: str) -> str:\n        return str(val).replace("\'", "\'\'")\n\n    if filters:\n        # equality filters\n        for key in allowed_equals:\n            if key in filters and filters[key] is not None:\n                where_parts.append(f\'"{key}" = \\\'{_escape(filters[key])}\\\'\')\n            elif key in filters and filters[key] is None:\n                where_parts.append(f\'"{key}" IS NULL\')\n\n        # date range filters on checkin_latest_start_time\n        if filters.get("checkin_start_from") is not None:\n            where_parts.append(\n                f\'"checkin_latest_start_time" >= \\\'{_escape(filters["checkin_start_from"])}\\\'\'\n            )\n        if filters.get("checkin_start_to") is not None:\n            where_parts.append(\n                f\'"checkin_latest_start_time" <= \\\'{_escape(filters["checkin_start_to"])}\\\'\'\n            )\n\n    if where_parts:\n        base_sql += " WHERE " + " AND ".join(where_parts)\n\n    rows = execute_query(base_sql)\n    return rows if rows else []\n', is_skipped: false, name: 'nas_daily_dashboard_entry', definition: 'Shift-level war room snapshot row for an NAS integration session (daily-refreshed operational view). Grain: 1 row per NAS session (not per day). Enriches Integration Activity with real-time RF quality signals (pre/post RTWP, pre/post alarm states across layers, sector/layer status) and free-text war room comments. Contains timestamps for latest check-in start and checkout on-site. Includes nest_type as an attribute (NSI/SI) but has no direct outage/workorder FK; outage linkage is via site+time inference if needed.', map_database_name: 'public', skip_reason: '', status: 'mentioned', node_id: 'nas_daily_dashboard_entry'});
CREATE (:BKGNode {map_table_name: 'stg_nas_rf010_dashboard', map_key_column: 'id', nl_business_rule: '', session_id: '69a3d22f26e208edc083a06e', label: 'NAS Task Tracker Item', map_sql_template: 'SELECT "id", "project_id", "project_activity_id", "project_site_id", "region_id", "market_id", "project_ref_id", "project_category", "work_package_id", "activity_tracker_state", "stage_id", "project_task_delivery_id", "task_received_datetime", "task_completed_datetime", "ps_rpm_nas_nnr_eventtime", "ps_rpm_nas_nnr_eventtype", "ps_rpm_nas_nnr_userid", "ps_rpm_nas_nnr_session_id", "mb_status", "on_hold_status", "create_uid", "create_date", "write_uid", "write_date" FROM "public"."stg_nas_rf010_dashboard"', map_label_column: 'work_package_id', nl_description: 'A task/work-package tracking record in the NAS Task Tracker (RF010) representing a dispatchable unit of NAS work (e.g., RTT Support) with received/completed timestamps, stage/state transitions, hold/MB status flags, and NNR event audit metadata. Multiple task tracker items may reference the same Integration Activity session via ps_rpm_nas_nnr_session_id (many-to-one).', map_contract: '{"function_name": "get_nas_task_tracker_item", "node_type": "core", "node_id": "nas_task_tracker_item", "node_label": "nas_task_tracker_item", "description": "Query nas_task_tracker_item data from stg_nas_rf010_dashboard", "parameters": [{"name": "id", "type": "number", "description": "Filter by id (primary key)", "required": false, "sample_values": ["1007881", "1007882", "1007883"]}, {"name": "work_package_id", "type": "string", "description": "Filter by work_package_id", "required": false, "sample_values": ["RTT Support"]}, {"name": "region_id", "type": "string", "description": "Filter by region_id", "required": false, "sample_values": ["Central"]}, {"name": "project_category", "type": "string", "description": "Filter by project_category", "required": false, "sample_values": ["BAU/E2E"]}, {"name": "mb_status", "type": "string", "description": "Filter by mb_status", "required": false, "sample_values": ["DONE", "IN_PROGRESS"]}, {"name": "on_hold_status", "type": "string", "description": "Filter by on_hold_status", "required": false, "sample_values": []}, {"name": "ps_rpm_nas_nnr_eventtype", "type": "string", "description": "Filter by ps_rpm_nas_nnr_eventtype", "required": false, "sample_values": ["RF010 Support"]}, {"name": "market_id", "type": "string", "description": "Filter by market_id", "required": false, "sample_values": ["Chicago", "Detroit", "Indianapolis"]}, {"name": "project_id", "type": "string", "description": "Filter by project_id", "required": false, "sample_values": ["TMO"]}, {"name": "project_activity_id", "type": "string", "description": "Filter by project_activity_id", "required": false, "sample_values": ["TMO-RPM-NAS"]}, {"name": "stage_id", "type": "string", "description": "Filter by stage_id", "required": false, "sample_values": ["Daily Report (RPM-NAS)"]}, {"name": "create_uid", "type": "number", "description": "Filter by create_uid", "required": false, "sample_values": ["1573", "1678"]}], "output_columns": [{"name": "id", "type": "number", "nullable": false}, {"name": "project_id", "type": "string", "nullable": false}, {"name": "project_activity_id", "type": "string", "nullable": false}, {"name": "project_site_id", "type": "string", "nullable": false}, {"name": "region_id", "type": "string", "nullable": false}, {"name": "market_id", "type": "string", "nullable": false}, {"name": "project_ref_id", "type": "string", "nullable": true}, {"name": "project_category", "type": "string", "nullable": false}, {"name": "work_package_id", "type": "string", "nullable": false}, {"name": "activity_tracker_state", "type": "string", "nullable": false}, {"name": "stage_id", "type": "string", "nullable": false}, {"name": "project_task_delivery_id", "type": "string", "nullable": false}, {"name": "task_received_datetime", "type": "string", "nullable": false}, {"name": "task_completed_datetime", "type": "string", "nullable": false}, {"name": "ps_rpm_nas_nnr_eventtime", "type": "string", "nullable": true}, {"name": "ps_rpm_nas_nnr_eventtype", "type": "string", "nullable": false}, {"name": "ps_rpm_nas_nnr_userid", "type": "string", "nullable": false}, {"name": "ps_rpm_nas_nnr_session_id", "type": "string", "nullable": false}, {"name": "mb_status", "type": "string", "nullable": false}, {"name": "on_hold_status", "type": "string", "nullable": true}, {"name": "create_uid", "type": "number", "nullable": false}, {"name": "create_date", "type": "string", "nullable": false}, {"name": "write_uid", "type": "number", "nullable": false}, {"name": "write_date", "type": "string", "nullable": false}], "sample_output": [], "row_count": 3}', entity_type: 'transaction', node_type: 'CORE', map_python_function: 'def get_nas_task_tracker_item(execute_query: callable, filters: dict = None) -> list[dict]:\n    """Fetch NAS Task Tracker Item (RF010) records.\n\n    Curated filters only.\n\n    Allowed equality filters:\n      - project_site_id, market_id, region_id, project_category,\n        activity_tracker_state, work_package_id, on_hold_status,\n        ps_rpm_nas_nnr_session_id\n\n    Allowed date range filters (on task_received_datetime):\n      - task_received_datetime_start (>=)\n      - task_received_datetime_end (<=)\n\n    Node: NAS Task Tracker Item | Table: stg_nas_rf010_dashboard | Key: id | DB: public\n    """\n\n    base_sql = (\n        \'SELECT "id", "project_id", "project_activity_id", "project_site_id", "region_id", "market_id", \'\n        \'"project_ref_id", "project_category", "work_package_id", "activity_tracker_state", "stage_id", \'\n        \'"project_task_delivery_id", "task_received_datetime", "task_completed_datetime", \'\n        \'"ps_rpm_nas_nnr_eventtime", "ps_rpm_nas_nnr_eventtype", "ps_rpm_nas_nnr_userid", \'\n        \'"ps_rpm_nas_nnr_session_id", "mb_status", "on_hold_status", \'\n        \'"create_uid", "create_date", "write_uid", "write_date" \'\n        \'FROM "public"."stg_nas_rf010_dashboard"\'\n    )\n\n    allowed_eq = {\n        "project_site_id",\n        "market_id",\n        "region_id",\n        "project_category",\n        "activity_tracker_state",\n        "work_package_id",\n        "on_hold_status",\n        "ps_rpm_nas_nnr_session_id",\n    }\n\n    where_parts = []\n    if filters:\n        # Equality filters\n        for col in sorted(allowed_eq):\n            if col in filters:\n                v = filters.get(col)\n                if v is None:\n                    where_parts.append(f\'"{col}" IS NULL\')\n                elif isinstance(v, (int, float)):\n                    where_parts.append(f\'"{col}" = {v}\')\n                else:\n                    escaped = str(v).replace("\'", "\'\'")\n                    where_parts.append(f\'"{col}" = \\\'{escaped}\\\'\')\n\n        # Date range filters (received datetime)\n        start = filters.get("task_received_datetime_start")\n        end = filters.get("task_received_datetime_end")\n\n        if start is not None:\n            escaped = str(start).replace("\'", "\'\'")\n            where_parts.append(f\'"task_received_datetime" >= \\\'{escaped}\\\'\')\n        if end is not None:\n            escaped = str(end).replace("\'", "\'\'")\n            where_parts.append(f\'"task_received_datetime" <= \\\'{escaped}\\\'\')\n\n    if where_parts:\n        base_sql += " WHERE " + " AND ".join(where_parts)\n\n    rows = execute_query(base_sql)\n    return rows if rows else []\n', is_skipped: false, name: 'nas_task_tracker_item', definition: 'A task/work-package tracking record in the NAS Task Tracker (RF010) representing a dispatchable unit of NAS work (e.g., RTT Support) with received/completed timestamps, stage/state transitions, hold/MB status flags, and NNR event audit metadata. Multiple task tracker items may reference the same Integration Activity session via ps_rpm_nas_nnr_session_id (many-to-one).', map_database_name: 'public', skip_reason: '', status: 'mentioned', node_id: 'nas_task_tracker_item'});
CREATE (:BKGNode {map_key_column: 'id', map_table_name: 'stg_nas_log_data', nl_business_rule: '', session_id: '69a3d22f26e208edc083a06e', label: 'NAS Event Log Event', map_sql_template: 'SELECT "id", "nas_region", "nas_market", "nas_site_id", "nas_session_id", "nas_activity_type", "nas_nest_type", "nas_project_category", "nas_event_type", "nas_sla_nest", "nas_event_time", "nas_user_id" FROM "pwc_macro_staging_schema"."stg_nas_log_data"', map_label_column: 'nas_event_type', nl_description: 'A timestamped audit-trail record of a discrete NAS session lifecycle event (e.g., NEST approved, check-in, check-out, extension requested, session cancelled). Used for process mining/forensics; ties to a NAS Integration Activity session and to the acting user.', map_contract: '{"function_name": "get_nas_event_log_event", "node_type": "core", "node_id": "nas_event_log_event", "node_label": "NAS Event Log Event", "description": "Query NAS Event Log Event data from stg_nas_log_data", "parameters": [{"name": "id", "type": "number", "description": "Filter by id (primary key)", "required": false, "sample_values": ["7625982", "7625983", "7625984"]}, {"name": "nas_event_type", "type": "string", "description": "Filter by nas_event_type", "required": false, "sample_values": ["Nest Approved", "Conditional Approval-Approved"]}, {"name": "nas_region", "type": "string", "description": "Filter by nas_region", "required": false, "sample_values": ["Central"]}, {"name": "nas_nest_type", "type": "string", "description": "Filter by nas_nest_type", "required": false, "sample_values": ["NSI", "SI"]}, {"name": "nas_market", "type": "string", "description": "Filter by nas_market", "required": false, "sample_values": ["Chicago", "Detroit", "Indianapolis"]}, {"name": "nas_activity_type", "type": "string", "description": "Filter by nas_activity_type", "required": false, "sample_values": ["[E911 Testing]", "[iNTP Validation]", "[Punch Items]"]}, {"name": "nas_project_category", "type": "string", "description": "Filter by nas_project_category", "required": false, "sample_values": ["Equipment Upgrade", "ABIO Swap plus 5G Midband", "Anchor Phase 3"]}, {"name": "nas_site_id", "type": "string", "description": "Filter by nas_site_id", "required": false, "sample_values": ["CH10000A", "DE10001A", "IN10002A"]}, {"name": "nas_session_id", "type": "string", "description": "Filter by nas_session_id", "required": false, "sample_values": ["300000", "300001", "300002"]}, {"name": "nas_sla_nest", "type": "string", "description": "Filter by nas_sla_nest", "required": false, "sample_values": ["5", "2", "6"]}, {"name": "nas_event_time", "type": "string", "description": "Filter by nas_event_time", "required": false, "sample_values": ["2025-11-12 16:41:35", "2026-02-08 01:50:07", "2025-11-12 18:41:44"]}, {"name": "nas_user_id", "type": "string", "description": "Filter by nas_user_id", "required": false, "sample_values": ["dre.longoria.ext@nokia.com", "pradeep.r.ext@nokia.com", "cuthbert.cuffy.ext@nokia.com"]}], "output_columns": [{"name": "id", "type": "number", "nullable": false}, {"name": "nas_region", "type": "string", "nullable": false}, {"name": "nas_market", "type": "string", "nullable": false}, {"name": "nas_site_id", "type": "string", "nullable": false}, {"name": "nas_session_id", "type": "string", "nullable": false}, {"name": "nas_activity_type", "type": "string", "nullable": false}, {"name": "nas_nest_type", "type": "string", "nullable": false}, {"name": "nas_project_category", "type": "string", "nullable": false}, {"name": "nas_event_type", "type": "string", "nullable": false}, {"name": "nas_sla_nest", "type": "string", "nullable": false}, {"name": "nas_event_time", "type": "string", "nullable": false}, {"name": "nas_user_id", "type": "string", "nullable": false}], "sample_output": [], "row_count": 3}', entity_type: 'transaction', node_type: 'CORE', map_python_function: 'def get_nas_event_log_event(execute_query: callable, filters: dict | None = None) -> list[dict]:\n    """Fetch NAS Event Log Event records with curated filters.\n\n    Node: NAS Event Log Event | Table: stg_nas_log_data | Key: id | DB: public\n\n    Allowed filters:\n      - nas_session_id, nas_site_id, nas_market, nas_region, nas_event_type,\n        nas_nest_type, nas_project_category, nas_user_id\n      - nas_event_time_from (inclusive), nas_event_time_to (exclusive)\n\n    Notes:\n      - List values create an IN (...) predicate.\n      - Timestamp filters expect values castable by PostgreSQL (e.g., \'2026-02-01\', \'2026-02-01T00:00:00\').\n    """\n\n    base_sql = (\n        \'SELECT "id", "nas_region", "nas_market", "nas_site_id", "nas_session_id", \'\n        \'"nas_activity_type", "nas_nest_type", "nas_project_category", "nas_event_type", \'\n        \'"nas_sla_nest", "nas_event_time", "nas_user_id" \'\n        \'FROM "pwc_macro_staging_schema"."stg_nas_log_data"\'\n    )\n\n    allowed_eq = {\n        "nas_session_id",\n        "nas_site_id",\n        "nas_market",\n        "nas_region",\n        "nas_event_type",\n        "nas_nest_type",\n        "nas_project_category",\n        "nas_user_id",\n    }\n\n    where_parts: list[str] = []\n\n    def esc(val: object) -> str:\n        return str(val).replace("\'", "\'\'")\n\n    if filters:\n        # equality / IN filters\n        for k in sorted(set(filters.keys()) & allowed_eq):\n            v = filters.get(k)\n            if v is None:\n                where_parts.append(f\'"{k}" IS NULL\')\n            elif isinstance(v, (list, tuple, set)):\n                vals = list(v)\n                if not vals:\n                    where_parts.append("1=0")\n                else:\n                    escaped_vals = [f"\'{esc(item)}\'" for item in vals]\n                    where_parts.append(f\'"{k}" IN ({", ".join(escaped_vals)})\')\n            else:\n                where_parts.append(f\'"{k}" = \\\'{esc(v)}\\\'\')\n\n        # time range filters\n        t_from = filters.get("nas_event_time_from")\n        t_to = filters.get("nas_event_time_to")\n        if t_from is not None:\n            where_parts.append(f\'"nas_event_time" >= \\\'{esc(t_from)}\\\'\')\n        if t_to is not None:\n            where_parts.append(f\'"nas_event_time" < \\\'{esc(t_to)}\\\'\')\n\n    if where_parts:\n        base_sql += " WHERE " + " AND ".join(where_parts)\n\n    rows = execute_query(base_sql)\n    return rows if rows else []\n', is_skipped: false, name: 'nas_event_log_event', definition: 'A timestamped audit-trail record of a discrete NAS session lifecycle event (e.g., NEST approved, check-in, check-out, extension requested, session cancelled). Used for process mining/forensics; ties to a NAS Integration Activity session and to the acting user.', map_database_name: 'public', skip_reason: '', status: 'mentioned', node_id: 'nas_event_log_event'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_nas_log_data', 'pwc_macro_staging_schema.stg_nas_planned_outage_activity', 'pwc_macro_staging_schema.stg_nas_session_level_combined_data', 'public.stg_tmo_nas_daily_dashboard'], nl_business_rule: '', kpi_formula_description: 'Check-In SLA Rate computed by joining session-level NEST start time from pwc_macro_staging_schema.stg_nas_session_level_combined_data (s) with check-in time from public.stg_tmo_nas_daily_dashboard (d). Join key: CAST(d.session_id AS TEXT) = CAST(s.nas_session_id AS TEXT) to handle type mismatches. Denominator = COUNT(DISTINCT s.nas_session_id) where d.checkin_latest_start_time IS NOT NULL and s.nas_nest_start_time IS NOT NULL (and optional filters). Numerator = COUNT(DISTINCT s.nas_session_id) from the same population where delta_minutes = EXTRACT(EPOCH FROM (d.checkin_latest_start_time - s.nas_nest_start_time))/60.0 is <= sla_minutes (default 30). Date filters (optional) apply to d.checkin_latest_start_time. Output includes denominator_sessions, numerator_within_sla, check_in_sla_rate, and sla_minutes. No CTEs and no INTERVAL literals.', kpi_output_schema: '[{"column": "metric_name", "type": "string", "description": "Metric identifier (check_in_sla_rate)."}, {"column": "numerator_sessions_within_sla", "type": "integer", "description": "Count of aligned on-site sessions whose check-in occurred within the SLA threshold."}, {"column": "denominator_on_site_sessions", "type": "integer", "description": "Count of aligned on-site sessions included in the calculation."}, {"column": "check_in_sla_rate", "type": "float", "description": "Numerator divided by denominator."}, {"column": "sla_minutes", "type": "integer", "description": "SLA threshold in minutes used for the computation."}]', kpi_business_logic: '1) Select Planned Outage windows with nas_activity_start_date within [start_date, end_date] (and optional site/market/category/company filters). 2) Select Integration Activity sessions for those sites (and optional vendor/company/activity-type filters). 3) From NAS Event Log, find the earliest \'Check-in\' event timestamp per nas_session_id. 4) Align each session to the nearest planned outage start for the same site (by absolute time difference). 5) Optionally restrict to sessions flagged on-site in NAS Daily Dashboard. 6) Denominator = aligned on-site sessions; Numerator = denominator sessions whose check-in is within SLA threshold (outage_start + sla_minutes). 7) Rate = Numerator / Denominator.', kpi_filters: '[{"name": "start_date", "type": "date", "description": "Include planned outages whose nas_activity_start_date is on/after this timestamp."}, {"name": "end_date", "type": "date", "description": "Include planned outages whose nas_activity_start_date is on/before this timestamp."}, {"name": "nas_region", "type": "string", "description": "Filter sessions/outages to a NAS region (applied indirectly where available)."}, {"name": "nas_market", "type": "string", "description": "Filter sessions/outages to a NAS market."}, {"name": "nas_site_id", "type": "string", "description": "Filter to a specific site."}, {"name": "nas_project_category", "type": "string", "description": "Filter to a project category."}, {"name": "nas_activity_type", "type": "string", "description": "Filter to an activity type."}, {"name": "nas_vendor_name", "type": "string", "description": "Filter to a vendor (from integration_activity)."}, {"name": "nas_company_name", "type": "string", "description": "Filter to a company (from integration_activity/outage)."}, {"name": "sla_minutes", "type": "integer", "description": "Allowed minutes after scheduled outage start for check-in to still be considered within SLA (default 0)."}, {"name": "require_on_site", "type": "boolean", "description": "If true (default), only include sessions marked on_site in NAS daily dashboard when available."}]', kpi_contract: '{"function_name": "get_check_in_sla_rate", "node_type": "kpi", "node_id": "ab4754a9-dca8-46dc-bf86-c2758dcd703a", "node_label": "Check-In SLA Rate", "description": "Measures the percentage of NAS on-site integration sessions where the engineer check-in occurs within the allowed SLA threshold relative to the scheduled outage start. This indicates operational discipline and effective use of the approved maintenance window, and serves as a leading indicator of capacity strain and process non-adherence by market, vendor/company, and activity type.", "parameters": [{"name": "sla_minutes", "type": "string", "description": "Filter by sla minutes", "required": false, "sample_values": []}, {"name": "nas_site_id", "type": "string", "description": "Filter by nas site id", "required": false, "sample_values": []}, {"name": "nas_market", "type": "string", "description": "Filter by nas market", "required": false, "sample_values": []}, {"name": "nas_project_category", "type": "string", "description": "Filter by nas project category", "required": false, "sample_values": []}, {"name": "nas_company_name", "type": "string", "description": "Filter by nas company name", "required": false, "sample_values": []}, {"name": "nas_vendor_name", "type": "string", "description": "Filter by nas vendor name", "required": false, "sample_values": []}, {"name": "nas_activity_type", "type": "string", "description": "Filter by nas activity type", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}], "output_columns": [{"name": "metric_name", "type": "string", "nullable": false}, {"name": "sla_minutes", "type": "number", "nullable": false}, {"name": "denominator_sessions", "type": "number", "nullable": false}, {"name": "numerator_within_sla", "type": "number", "nullable": false}, {"name": "check_in_sla_rate", "type": "number", "nullable": false}], "sample_output": [], "row_count": 1}', nl_description: 'Check-In SLA Rate computed by joining session-level NEST start time from pwc_macro_staging_schema.stg_nas_session_level_combined_data (s) with check-in time from public.stg_tmo_nas_daily_dashboard (d). Join key: CAST(d.session_id AS TEXT) = CAST(s.nas_session_id AS TEXT) to handle type mismatches. Denominator = COUNT(DISTINCT s.nas_session_id) where d.checkin_latest_start_time IS NOT NULL and s.nas_nest_start_time IS NOT NULL (and optional filters). Numerator = COUNT(DISTINCT s.nas_session_id) from the same population where delta_minutes = EXTRACT(EPOCH FROM (d.checkin_latest_start_time - s.nas_nest_start_time))/60.0 is <= sla_minutes (default 30). Date filters (optional) apply to d.checkin_latest_start_time. Output includes denominator_sessions, numerator_within_sla, check_in_sla_rate, and sla_minutes. No CTEs and no INTERVAL literals.', node_type: 'CORE', definition: 'Check-In SLA Rate computed by joining session-level NEST start time from pwc_macro_staging_schema.stg_nas_session_level_combined_data (s) with check-in time from public.stg_tmo_nas_daily_dashboard (d). Join key: CAST(d.session_id AS TEXT) = CAST(s.nas_session_id AS TEXT) to handle type mismatches. Denominator = COUNT(DISTINCT s.nas_session_id) where d.checkin_latest_start_time IS NOT NULL and s.nas_nest_start_time IS NOT NULL (and optional filters). Numerator = COUNT(DISTINCT s.nas_session_id) from the same population where delta_minutes = EXTRACT(EPOCH FROM (d.checkin_latest_start_time - s.nas_nest_start_time))/60.0 is <= sla_minutes (default 30). Date filters (optional) apply to d.checkin_latest_start_time. Output includes denominator_sessions, numerator_within_sla, check_in_sla_rate, and sla_minutes. No CTEs and no INTERVAL literals.', kpi_python_function: 'def get_check_in_sla_rate(execute_query, filters=None) -> list[dict]:\n    """Check-In SLA Rate (two-table join).\n\n    Core SQL pattern is intentionally kept identical to the working diagnostic:\n      - same SELECT aggregates\n      - same JOIN with CAST(... AS TEXT)\n      - same EXTRACT(EPOCH...) / 60.0 delta computation\n      - same s.nas_nest_start_time::timestamp cast\n\n    Adds:\n      - sla_minutes parameter (default 30)\n      - optional equality filters on s-dimension columns\n      - optional date range filters on d.checkin_latest_start_time\n\n    No CTEs, no INTERVAL, no additional joins.\n    """\n\n    filters = filters or {}\n    sla_minutes = int(filters.get(\'sla_minutes\', 30))\n\n    def _sql_literal(value):\n        if value is None:\n            return \'NULL\'\n        if isinstance(value, bool):\n            return \'TRUE\' if value else \'FALSE\'\n        if isinstance(value, (int, float)):\n            return str(value)\n        return "\'" + str(value).replace("\'", "\'\'") + "\'"\n\n    where_clauses = [\n        "d.checkin_latest_start_time IS NOT NULL",\n        "s.nas_nest_start_time IS NOT NULL",\n    ]\n\n    # Equality filters on session dimensions\n    eq_map = {\n        \'nas_site_id\': filters.get(\'nas_site_id\'),\n        \'nas_market\': filters.get(\'nas_market\'),\n        \'nas_project_category\': filters.get(\'nas_project_category\'),\n        \'nas_company_name\': filters.get(\'nas_company_name\'),\n        \'nas_vendor_name\': filters.get(\'nas_vendor_name\'),\n        \'nas_activity_type\': filters.get(\'nas_activity_type\'),\n    }\n\n    for col, val in eq_map.items():\n        if val is None or val == \'\':\n            continue\n        where_clauses.append(f"s.{col} = {_sql_literal(val)}")\n\n    # Date range filters on dashboard check-in time\n    start_date = filters.get(\'start_date\')\n    end_date = filters.get(\'end_date\')\n    if start_date:\n        where_clauses.append(f"d.checkin_latest_start_time >= {_sql_literal(start_date)}")\n    if end_date:\n        where_clauses.append(f"d.checkin_latest_start_time < {_sql_literal(end_date)}")\n\n    where_sql = " AND ".join(where_clauses)\n\n    sql = (\n        f"""SELECT COUNT(DISTINCT s.nas_session_id) AS denominator_sessions, COUNT(DISTINCT CASE WHEN (EXTRACT(EPOCH FROM (d.checkin_latest_start_time - s.nas_nest_start_time::timestamp)) / 60.0) <= {sla_minutes} THEN s.nas_session_id END) AS numerator_within_sla FROM stg_nas_session_level_combined_data s JOIN stg_tmo_nas_daily_dashboard d ON CAST(d.session_id AS TEXT) = CAST(s.nas_session_id AS TEXT) WHERE {where_sql}"""\n    )\n\n    rows = execute_query(sql) or []\n    r = rows[0] if rows else {}\n\n    denom = int(r.get("denominator_sessions") or 0)\n    num = int(r.get("numerator_within_sla") or 0)\n    rate = (float(num) / float(denom)) if denom else None\n\n    return [{\n        "metric_name": "check_in_sla_rate",\n        "sla_minutes": sla_minutes,\n        "denominator_sessions": denom,\n        "numerator_within_sla": num,\n        "check_in_sla_rate": rate\n    }]\n', kpi_source_columns: ['stg_nas_log_data.nas_session_id', 'stg_nas_log_data.nas_site_id', 'stg_nas_log_data.nas_event_type', 'stg_nas_log_data.nas_event_time', 'stg_nas_planned_outage_activity.nas_site_id', 'stg_nas_planned_outage_activity.nas_activity_start_date', 'stg_nas_planned_outage_activity.nas_market', 'stg_nas_planned_outage_activity.nas_project_category', 'stg_nas_planned_outage_activity.nas_company_name', 'stg_nas_session_level_combined_data.nas_session_id', 'stg_nas_session_level_combined_data.nas_site_id', 'stg_nas_session_level_combined_data.nas_market', 'stg_nas_session_level_combined_data.nas_vendor_name', 'stg_nas_session_level_combined_data.nas_company_name', 'stg_nas_session_level_combined_data.nas_activity_type', 'stg_tmo_nas_daily_dashboard.session_id', 'stg_tmo_nas_daily_dashboard.on_site'], session_id: '69a3d22f26e208edc083a06e', label: 'Check-In SLA Rate', kpi_related_core_node_ids: ['nas_session_level_combined_data', 'stg_tmo_nas_daily_dashboard', 'integration_activity', 'site', 'market', 'external_vendor', 'person'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'ab4754a9-dca8-46dc-bf86-c2758dcd703a', entity_type: 'kpi', kpi_name: 'Check-In SLA Rate', name: 'ab4754a9-dca8-46dc-bf86-c2758dcd703a', kpi_dimensions: ['nas_region', 'nas_market', 'nas_company_name', 'nas_vendor_name', 'nas_activity_type', 'nas_project_category', 'time_period'], kpi_description: 'Measures the percentage of NAS on-site integration sessions where the engineer check-in occurs within the allowed SLA threshold relative to the scheduled outage start. This indicates operational discipline and effective use of the approved maintenance window, and serves as a leading indicator of capacity strain and process non-adherence by market, vendor/company, and activity type.', status: 'mentioned', node_id: 'ab4754a9-dca8-46dc-bf86-c2758dcd703a'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_nas_log_data', 'pwc_macro_staging_schema.stg_nas_planned_outage_activity', 'public.stg_tmo_nas_daily_dashboard', 'pwc_macro_staging_schema.stg_nas_nest_ext_raw_by_session'], nl_business_rule: '', kpi_formula_description: 'Check-Out SLA Rate = (# NAS on-site integration sessions with latest check-out time on/before approved outage end time + approved extension hours) / (# such sessions with a matched approved outage window and a check-out time).', kpi_output_schema: '[{"column": "check_out_sla_rate", "type": "float", "description": "Share of sessions that checked out on/before approved outage end (including extensions if extension hours are available)."}, {"column": "sessions_in_scope", "type": "integer", "description": "Count of sessions included in the denominator (must have a check-out event and a matched planned outage window)."}, {"column": "sessions_on_time", "type": "integer", "description": "Count of sessions meeting the SLA (on-time checkout)."}, {"column": "sessions_late", "type": "integer", "description": "Count of sessions breaching the SLA (late checkout)."}]', kpi_business_logic: '1) Identify NAS integration sessions in scope by finding the latest \'check-out\' event per nas_session_id from NAS Event Log within optional date/site/market/region filters. 2) For each session, match an approved outage window by selecting a Planned Outage for the same nas_site_id whose start/end overlaps the session check-out time (or nearest end time if none overlap). 3) Determine approved outage end as nas_activity_end_date plus any extension hours (prefer nest_extension_hrs from NAS Daily Dashboard; if unavailable, treat extension duration as 0 while still allowing a flag that an extension existed). 4) Mark session on-time if checkout_time <= approved_end_with_extensions, else late. 5) Compute rate as on_time_sessions / sessions_in_scope; optionally return grouped results by region/market/site.', kpi_filters: '[{"name": "start_date", "type": "date", "description": "Include only sessions whose check-out event_time is on/after this timestamp."}, {"name": "end_date", "type": "date", "description": "Include only sessions whose check-out event_time is on/before this timestamp."}, {"name": "nas_site_id", "type": "string", "description": "Restrict to a specific site (maps to nas_site_id/site_id)."}, {"name": "nas_market", "type": "string", "description": "Restrict to a specific NAS market."}, {"name": "nas_region", "type": "string", "description": "Restrict to a specific NAS region."}, {"name": "nas_session_id", "type": "string", "description": "Restrict to a specific NAS session id."}, {"name": "group_by", "type": "string", "description": "Optional aggregation dimension: one of [\'nas_market\',\'nas_region\',\'nas_site_id\']."}]', kpi_contract: '{"function_name": "get_check_out_sla_rate", "node_type": "kpi", "node_id": "11e30252-98cd-42c0-be71-ea837f02e3c6", "node_label": "Check-Out SLA Rate", "description": "Measures the share of NAS on-site integration sessions that check out on or before the approved outage window end (including any approved extensions). This KPI surfaces outage governance risk and vendor/market non-adherence patterns, enabling sustained-breach detection and escalation when repeated overruns occur.", "parameters": [{"name": "sla_minutes", "type": "string", "description": "Filter by sla minutes", "required": false, "sample_values": []}, {"name": "nas_site_id", "type": "string", "description": "Filter by nas site id", "required": false, "sample_values": []}, {"name": "nas_market", "type": "string", "description": "Filter by nas market", "required": false, "sample_values": []}, {"name": "nas_project_category", "type": "string", "description": "Filter by nas project category", "required": false, "sample_values": []}, {"name": "nas_company_name", "type": "string", "description": "Filter by nas company name", "required": false, "sample_values": []}, {"name": "nas_vendor_name", "type": "string", "description": "Filter by nas vendor name", "required": false, "sample_values": []}, {"name": "nas_activity_type", "type": "string", "description": "Filter by nas activity type", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}], "output_columns": [{"name": "metric_name", "type": "string", "nullable": false}, {"name": "sla_minutes", "type": "number", "nullable": false}, {"name": "denominator_sessions", "type": "number", "nullable": false}, {"name": "numerator_within_sla", "type": "number", "nullable": false}, {"name": "check_out_sla_rate", "type": "number", "nullable": false}], "sample_output": [], "row_count": 1}', nl_description: 'Check-Out SLA Rate = (# NAS on-site integration sessions with latest check-out time on/before approved outage end time + approved extension hours) / (# such sessions with a matched approved outage window and a check-out time).', node_type: 'CORE', definition: 'Check-Out SLA Rate = (# NAS on-site integration sessions with latest check-out time on/before approved outage end time + approved extension hours) / (# such sessions with a matched approved outage window and a check-out time).', kpi_python_function: 'def get_check_out_sla_rate(execute_query, filters=None) -> list[dict]:\n    """Check-Out SLA Rate (two-table join, no CTEs, no INTERVAL).\n\n    Source tables:\n      - stg_nas_session_level_combined_data s (NEST start time + approved duration)\n      - stg_tmo_nas_daily_dashboard d (checkout timestamp)\n\n    Denominator: sessions with non-null checkout_os, nas_nest_start_time, nas_nest_time_requested_cng\n    Numerator: sessions where checkout <= window end (nest_start + requested_minutes), plus sla_minutes tolerance\n\n    Filters (optional):\n      - nas_site_id, nas_market, nas_project_category, nas_company_name,\n        nas_vendor_name, nas_activity_type (equality on session table)\n      - start_date / end_date (applied to d.checkout_os)\n      - sla_minutes: default 0\n    """\n\n    filters = filters or {}\n    sla_minutes = int(filters.get(\'sla_minutes\', 0))\n\n    def _sql_literal(value):\n        if value is None:\n            return \'NULL\'\n        if isinstance(value, (int, float)):\n            return str(value)\n        return "\'" + str(value).replace("\'", "\'\'") + "\'"\n\n    where_clauses = [\n        "d.checkout_os IS NOT NULL",\n        "s.nas_nest_start_time IS NOT NULL",\n        "s.nas_nest_time_requested_cng IS NOT NULL",\n    ]\n\n    eq_map = {\n        \'nas_site_id\': filters.get(\'nas_site_id\'),\n        \'nas_market\': filters.get(\'nas_market\'),\n        \'nas_project_category\': filters.get(\'nas_project_category\'),\n        \'nas_company_name\': filters.get(\'nas_company_name\'),\n        \'nas_vendor_name\': filters.get(\'nas_vendor_name\'),\n        \'nas_activity_type\': filters.get(\'nas_activity_type\'),\n    }\n\n    for col, val in eq_map.items():\n        if val is None or val == \'\':\n            continue\n        where_clauses.append(f"s.{col} = {_sql_literal(val)}")\n\n    start_date = filters.get(\'start_date\')\n    end_date = filters.get(\'end_date\')\n    if start_date:\n        where_clauses.append(f"d.checkout_os >= {_sql_literal(start_date)}")\n    if end_date:\n        where_clauses.append(f"d.checkout_os < {_sql_literal(end_date)}")\n\n    where_sql = " AND ".join(where_clauses)\n\n    sql = (\n        f"""SELECT COUNT(DISTINCT s.nas_session_id) AS denominator_sessions, COUNT(DISTINCT CASE WHEN ((EXTRACT(EPOCH FROM d.checkout_os) - (EXTRACT(EPOCH FROM s.nas_nest_start_time::timestamp) + CAST(s.nas_nest_time_requested_cng AS NUMERIC) * 60)) / 60.0) <= {sla_minutes} THEN s.nas_session_id END) AS numerator_within_sla FROM stg_nas_session_level_combined_data s JOIN stg_tmo_nas_daily_dashboard d ON CAST(d.session_id AS TEXT) = CAST(s.nas_session_id AS TEXT) WHERE {where_sql}"""\n    )\n\n    rows = execute_query(sql) or []\n    r = rows[0] if rows else {}\n\n    denom = int(r.get("denominator_sessions") or 0)\n    num = int(r.get("numerator_within_sla") or 0)\n    rate = (float(num) / float(denom)) if denom else None\n\n    return [{\n        "metric_name": "check_out_sla_rate",\n        "sla_minutes": sla_minutes,\n        "denominator_sessions": denom,\n        "numerator_within_sla": num,\n        "check_out_sla_rate": rate\n    }]\n', kpi_source_columns: ['stg_nas_log_data.nas_session_id', 'stg_nas_log_data.nas_site_id', 'stg_nas_log_data.nas_market', 'stg_nas_log_data.nas_region', 'stg_nas_log_data.nas_event_type', 'stg_nas_log_data.nas_event_time', 'stg_nas_planned_outage_activity.nas_site_id', 'stg_nas_planned_outage_activity.nas_activity_start_date', 'stg_nas_planned_outage_activity.nas_activity_end_date', 'stg_nas_planned_outage_activity.nas_status', 'stg_tmo_nas_daily_dashboard.session_id', 'stg_tmo_nas_daily_dashboard.site_id', 'stg_tmo_nas_daily_dashboard.checkout_os', 'stg_tmo_nas_daily_dashboard.initial_nest_approved', 'stg_tmo_nas_daily_dashboard.nest_extension_hrs', 'stg_nas_nest_ext_raw_by_session.nas_session_id', 'stg_nas_nest_ext_raw_by_session.nas_date_requested'], session_id: '69a3d22f26e208edc083a06e', label: 'Check-Out SLA Rate', kpi_related_core_node_ids: ['planned_outage', 'nas_event_log_event', 'nest_extension', 'integration_activity', 'site'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '11e30252-98cd-42c0-be71-ea837f02e3c6', entity_type: 'kpi', kpi_name: 'Check-Out SLA Rate', name: '11e30252-98cd-42c0-be71-ea837f02e3c6', kpi_dimensions: ['nas_region', 'nas_market', 'nas_site_id', 'time_period'], kpi_description: 'Measures the share of NAS on-site integration sessions that check out on or before the approved outage window end (including any approved extensions). This KPI surfaces outage governance risk and vendor/market non-adherence patterns, enabling sustained-breach detection and escalation when repeated overruns occur.', status: 'mentioned', node_id: '11e30252-98cd-42c0-be71-ea837f02e3c6'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'RF010 Overdue Count = count(distinct pj_project_id) where integration_start (pj_a_5270_integration_start_finish) is not null AND planned_technologies_integrated (ms_1899_all_planned_technologies_integrated_actual) is null AND (now - integration_start) > overdue_days, grouped by region/area/market/GC.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension (nullable for overall total row)."}, {"column": "m_area", "type": "string", "description": "Area dimension (nullable for overall total row)."}, {"column": "m_market", "type": "string", "description": "Market dimension (nullable for overall total row)."}, {"column": "construction_gc", "type": "string", "description": "General contractor dimension as stored on the project record (nullable for overall total row)."}, {"column": "overdue_days_threshold", "type": "integer", "description": "The overdue-days threshold used in the calculation."}, {"column": "rf010_overdue_project_count", "type": "float", "description": "Distinct count of overdue projects for the dimension slice."}]', kpi_business_logic: '1) Start from the macro combined project table (one row per project).\n2) Apply optional filters for rgn_region, m_area, m_market, construction_gc and optional integration-start date range.\n3) Keep projects where pj_a_5270_integration_start_finish is populated (integration has started).\n4) Exclude projects where ms_1899_all_planned_technologies_integrated_actual is populated (milestone completed).\n5) Compute days_since_start = (NOW() - integration_start) in days using EXTRACT(EPOCH)/86400 and keep only days_since_start > overdue_days (configurable, default 7).\n6) Count distinct pj_project_id overall and by (rgn_region, m_area, m_market, construction_gc).', kpi_filters: '[{"name": "overdue_days", "type": "integer", "description": "Number of days after integration start beyond which a project is considered overdue (default 7)."}, {"name": "start_date", "type": "date", "description": "Include only projects with integration start timestamp >= start_date."}, {"name": "end_date", "type": "date", "description": "Include only projects with integration start timestamp <= end_date."}, {"name": "rgn_region", "type": "string", "description": "Filter to a specific region."}, {"name": "m_area", "type": "string", "description": "Filter to a specific area."}, {"name": "m_market", "type": "string", "description": "Filter to a specific market."}, {"name": "construction_gc", "type": "string", "description": "Filter to a specific general contractor (free-text in source)."}, {"name": "smp_name", "type": "string", "description": "Filter by program name (e.g., NTM, AHLOB Modernization). When NTM, additionally requires smp_status=Active and excludes specific ntm_project_type values."}]', kpi_contract: '{"function_name": "get_rf010_overdue_count", "node_type": "kpi", "node_id": "00ca1547-a729-48d4-85da-2e886c6630a2", "node_label": "RF010 Overdue Count", "description": "Counts distinct projects where integration has started but the planned-technologies-integrated completion milestone is still missing beyond a configurable number of days since integration start. This matters because it identifies the overdue population that triggers the RF010 Delivery Delay escalation and indicates near-term on-air slippage risk. Intended to be sliced by region/area/market and general contractor for accountability and escalation routing.", "parameters": [{"name": "overdue_days", "type": "string", "description": "Filter by overdue days", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by pj general contractor", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "null", "nullable": true}, {"name": "m_area", "type": "null", "nullable": true}, {"name": "m_market", "type": "null", "nullable": true}, {"name": "construction_gc", "type": "null", "nullable": true}, {"name": "overdue_days_threshold", "type": "number", "nullable": false}, {"name": "rf010_overdue_project_count", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'RF010 Overdue Count = count(distinct pj_project_id) where integration_start (pj_a_5270_integration_start_finish) is not null AND planned_technologies_integrated (ms_1899_all_planned_technologies_integrated_actual) is null AND (now - integration_start) > overdue_days, grouped by region/area/market/GC.', node_type: 'CORE', definition: 'RF010 Overdue Count = count(distinct pj_project_id) where integration_start (pj_a_5270_integration_start_finish) is not null AND planned_technologies_integrated (ms_1899_all_planned_technologies_integrated_actual) is null AND (now - integration_start) > overdue_days, grouped by region/area/market/GC.', kpi_python_function: 'def get_rf010_overdue_count(execute_query, filters=None) -> list[dict]:\n    """RF010 Overdue Count\n\n    Counts distinct projects where integration has started but the\n    \'all planned technologies integrated\' milestone is still missing AND the\n    project is overdue by > N days from integration start.\n\n    Filters (allowlist only):\n      - start_date (date/datetime string): restricts integration start to >= this\n      - end_date (date/datetime string): restricts integration start to <= this\n      - rgn_region (string)\n      - m_area (string)\n      - m_market (string)\n      - construction_gc (string)\n      - overdue_days (int, default 7)\n\n    Output grain: one row per (region, area, market, general_contractor) plus overall total.\n    """\n\n    filters = filters or {}\n\n    # configurable threshold (days since integration start)\n    try:\n        overdue_days = int(filters.get(\'overdue_days\', 7))\n    except Exception:\n        overdue_days = 7\n\n    # Core KPI conditions must always be present so WHERE is always emitted.\n    # Note: use epoch arithmetic; no INTERVAL literals.\n    where_parts = [\n        \'"pj_a_5270_integration_start_finish" IS NOT NULL\',\n        \'"ms_1899_all_planned_technologies_integrated_actual" IS NULL\',\n        f\'(EXTRACT(EPOCH FROM (NOW() - ("pj_a_5270_integration_start_finish"::timestamp))) / 86400.0) > {overdue_days}\',\n    ]\n\n    # allowlisted dimensional filters\n    if filters.get(\'rgn_region\'):\n        v = str(filters[\'rgn_region\']).replace("\'", "\'\'")\n        where_parts.append(f\'"rgn_region" = \\\'{v}\\\'\')\n    if filters.get(\'m_area\'):\n        v = str(filters[\'m_area\']).replace("\'", "\'\'")\n        where_parts.append(f\'"m_area" = \\\'{v}\\\'\')\n    if filters.get(\'m_market\'):\n        v = str(filters[\'m_market\']).replace("\'", "\'\'")\n        where_parts.append(f\'"m_market" = \\\'{v}\\\'\')\n    if filters.get(\'construction_gc\'):\n        v = str(filters[\'construction_gc\']).replace("\'", "\'\'")\n        where_parts.append(f\'"construction_gc" = \\\'{v}\\\'\')\n\n    # allowlisted date range filters apply to integration start\n    # (stored in a milestone column; cast defensively)\n    if filters.get(\'start_date\'):\n        v = str(filters[\'start_date\']).replace("\'", "\'\'")\n        where_parts.append(f\'("pj_a_5270_integration_start_finish"::timestamp) >= \\\'{v}\\\'::timestamp\')\n    if filters.get(\'end_date\'):\n        v = str(filters[\'end_date\']).replace("\'", "\'\'")\n        where_parts.append(f\'("pj_a_5270_integration_start_finish"::timestamp) <= \\\'{v}\\\'::timestamp\')\n\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_clause = "WHERE " + " AND ".join(where_parts)\n\n    # Single-table query (no JOIN needed)\n    sql = f"""\n        SELECT\n            \\"pj_project_id\\" AS project_id,\n            \\"rgn_region\\" AS rgn_region,\n            \\"m_area\\" AS m_area,\n            \\"m_market\\" AS m_market,\n            \\"construction_gc\\" AS construction_gc\n        FROM \\"pwc_macro_staging_schema\\".\\"stg_ndpd_mbt_tmobile_macro_combined\\"\n        {where_clause}\n    """\n\n    rows = execute_query(sql)\n\n    # Aggregate distinct projects by requested escalation/accountability dimensions.\n    by_dim = {}\n    overall_projects = set()\n\n    for r in rows or []:\n        pid = r.get(\'project_id\')\n        if pid is None:\n            continue\n        overall_projects.add(pid)\n\n        key = (\n            r.get(\'rgn_region\'),\n            r.get(\'m_area\'),\n            r.get(\'m_market\'),\n            r.get(\'construction_gc\')\n        )\n        if key not in by_dim:\n            by_dim[key] = set()\n        by_dim[key].add(pid)\n\n    out = []\n    # overall total row\n    out.append({\n        \'rgn_region\': None,\n        \'m_area\': None,\n        \'m_market\': None,\n        \'construction_gc\': None,\n        \'overdue_days_threshold\': overdue_days,\n        \'rf010_overdue_project_count\': float(len(overall_projects))\n    })\n\n    # dimensional rows\n    for (rgn_region, m_area, m_market, gc), pset in sorted(\n        by_dim.items(),\n        key=lambda x: (str(x[0][0]), str(x[0][1]), str(x[0][2]), str(x[0][3]))\n    ):\n        out.append({\n            \'rgn_region\': rgn_region,\n            \'m_area\': m_area,\n            \'m_market\': m_market,\n            \'construction_gc\': gc,\n            \'overdue_days_threshold\': overdue_days,\n            \'rf010_overdue_project_count\': float(len(pset))\n        })\n\n    return out\n', kpi_source_columns: ['pj_project_id', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_a_5270_integration_start_finish', 'ms_1899_all_planned_technologies_integrated_actual', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'RF010 Overdue Count', kpi_related_core_node_ids: ['integration_artifact', 'project'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '00ca1547-a729-48d4-85da-2e886c6630a2', entity_type: 'kpi', kpi_name: 'RF010 Overdue Count', name: '00ca1547-a729-48d4-85da-2e886c6630a2', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Counts distinct projects where integration has started but the planned-technologies-integrated completion milestone is still missing beyond a configurable number of days since integration start. This matters because it identifies the overdue population that triggers the RF010 Delivery Delay escalation and indicates near-term on-air slippage risk. Intended to be sliced by region/area/market and general contractor for accountability and escalation routing. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: '00ca1547-a729-48d4-85da-2e886c6630a2'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'RF010 Completion Rate = (# distinct projects with integration start in period and ms_1899_all_planned_technologies_integrated_actual populated) ÷ (# distinct projects with integration start in period), grouped by region/area/market/general contractor.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor dimension (as recorded on the project)."}, {"column": "integration_started_projects", "type": "int", "description": "Denominator: distinct projects with integration start in the selected period."}, {"column": "planned_technologies_integrated_projects", "type": "int", "description": "Numerator: distinct projects in denominator with planned technologies integrated milestone completed."}, {"column": "rf010_completion_rate", "type": "float", "description": "Numerator divided by denominator; null when denominator is 0."}]', kpi_business_logic: '1) Pull project-level integration milestone fields from Integration Artifact (wide project table). 2) Denominator set: projects where pj_a_5270_integration_start_finish exists and falls within [start_date, end_date] (if provided). 3) Numerator set: subset of denominator where ms_1899_all_planned_technologies_integrated_actual is not null. 4) Group by rgn_region, m_area, m_market, construction_gc and compute rate = numerator/denominator; also return numerator and denominator counts.', kpi_filters: '[{"name": "start_date", "type": "date", "description": "Start of integration-start window (inclusive) applied to pj_a_5270_integration_start_finish."}, {"name": "end_date", "type": "date", "description": "End of integration-start window (inclusive) applied to pj_a_5270_integration_start_finish."}, {"name": "rgn_region", "type": "string", "description": "Limit KPI to a specific region."}, {"name": "m_area", "type": "string", "description": "Limit KPI to a specific area."}, {"name": "m_market", "type": "string", "description": "Limit KPI to a specific market."}, {"name": "construction_gc", "type": "string", "description": "Limit KPI to a specific general contractor (free-text field)."}, {"name": "pj_project_status", "type": "string", "description": "Optional filter on project status (e.g., Active/Dead)."}, {"name": "por_category", "type": "string", "description": "Optional filter on POR category (e.g., LTW/NTM)."}, {"name": "smp_name", "type": "string", "description": "Filter by program name (e.g., NTM, AHLOB Modernization). When NTM, additionally requires smp_status=Active and excludes specific ntm_project_type values."}]', kpi_contract: '{"function_name": "get_rf010_completion_rate", "node_type": "kpi", "node_id": "97e41968-84fe-434d-823e-2fae706ce764", "node_label": "RF010 Completion Rate", "description": "Measures the share of projects that have completed the planned-technologies-integrated milestone among all projects that have started integration within the selected period. This matters because it quantifies integration throughput and predictability, enabling early detection of delivery slowdowns by market, region, and general contractor.", "parameters": [{"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by pj general contractor", "required": false, "sample_values": []}, {"name": "pj_project_status", "type": "string", "description": "Filter by pj project status", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "integration_started_projects", "type": "number", "nullable": false}, {"name": "planned_technologies_integrated_projects", "type": "number", "nullable": false}, {"name": "rf010_completion_rate", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'RF010 Completion Rate = (# distinct projects with integration start in period and ms_1899_all_planned_technologies_integrated_actual populated) ÷ (# distinct projects with integration start in period), grouped by region/area/market/general contractor.', node_type: 'CORE', definition: 'RF010 Completion Rate = (# distinct projects with integration start in period and ms_1899_all_planned_technologies_integrated_actual populated) ÷ (# distinct projects with integration start in period), grouped by region/area/market/general contractor.', kpi_python_function: 'def get_rf010_completion_rate(execute_query, filters=None) -> list[dict]:\n    """RF010 Completion Rate\n\n    Share of projects that completed \'All planned technologies integrated\' among projects\n    that started integration within the selected period.\n\n    Numerator: count(distinct pj_project_id) with ms_1899_all_planned_technologies_integrated_actual NOT NULL\n               AND integration start timestamp within [start_date, end_date]\n    Denominator: count(distinct pj_project_id) with integration start timestamp within [start_date, end_date]\n\n    Dimensions: rgn_region, m_area, m_market, construction_gc\n\n    Filters (allowlist): start_date, end_date, rgn_region, m_area, m_market, construction_gc, pj_project_status, por_category\n    """\n    filters = filters or {}\n\n    # Use Integration Artifact node because it exposes both integration start and planned-tech completion milestone.\n    rows = get_integration_artifact(execute_query, filters=None)\n\n    # ---- helpers ----\n    def _to_ts(val):\n        if val is None:\n            return None\n        s = str(val).strip()\n        if not s:\n            return None\n        # Best-effort parsing without external libs\n        # Expected forms: \'YYYY-MM-DD\' or \'YYYY-MM-DD HH:MM:SS\' (possibly with timezone)\n        try:\n            # Python 3.11+ supports fromisoformat for many variants\n            from datetime import datetime\n            s2 = s.replace(\'Z\', \'+00:00\')\n            return datetime.fromisoformat(s2)\n        except Exception:\n            # Fallback: try common \'YYYY-MM-DD HH:MM:SS\'\n            try:\n                from datetime import datetime\n                return datetime.strptime(s[:19], \'%Y-%m-%d %H:%M:%S\')\n            except Exception:\n                try:\n                    from datetime import datetime\n                    return datetime.strptime(s[:10], \'%Y-%m-%d\')\n                except Exception:\n                    return None\n\n    from datetime import datetime\n\n    start_dt = None\n    end_dt = None\n    if filters:\n        if filters.get(\'start_date\'):\n            start_dt = _to_ts(filters.get(\'start_date\'))\n        if filters.get(\'end_date\'):\n            end_dt = _to_ts(filters.get(\'end_date\'))\n            # If end_date provided as a date (no time), treat as inclusive end-of-day\n            if end_dt and len(str(filters.get(\'end_date\')).strip()) <= 10:\n                end_dt = end_dt.replace(hour=23, minute=59, second=59)\n\n    def _matches_dim_filters(r):\n        if not filters:\n            if filters.get(\'smp_name\') and str(r.get(\'smp_name\')) != str(filters.get(\'smp_name\')):\n                return False\n            return True\n        if filters.get(\'rgn_region\') and str(r.get(\'rgn_region\')) != str(filters.get(\'rgn_region\')):\n            return False\n        if filters.get(\'m_area\') and str(r.get(\'m_area\')) != str(filters.get(\'m_area\')):\n            return False\n        if filters.get(\'m_market\') and str(r.get(\'m_market\')) != str(filters.get(\'m_market\')):\n            return False\n        if filters.get(\'construction_gc\') and str(r.get(\'construction_gc\')) != str(filters.get(\'construction_gc\')):\n            return False\n        if filters.get(\'pj_project_status\') and str(r.get(\'pj_project_status\')) != str(filters.get(\'pj_project_status\')):\n            return False\n        if filters.get(\'por_category\') and str(r.get(\'por_category\')) != str(filters.get(\'por_category\')):\n            return False\n        return True\n\n    def _in_range(dt):\n        if dt is None:\n            return False\n        if start_dt and dt < start_dt:\n            return False\n        if end_dt and dt > end_dt:\n            return False\n        return True\n\n    # ---- aggregate ----\n    # group_key -> {\'started_projects\': set(), \'completed_projects\': set()}\n    groups = {}\n\n    for r in rows:\n        if not _matches_dim_filters(r):\n            continue\n\n        project_id = r.get(\'pj_project_id\')\n        if not project_id:\n            continue\n\n        # Integration start for denominator\n        integ_start = _to_ts(r.get(\'pj_a_5270_integration_start_finish\'))\n        if not _in_range(integ_start):\n            continue\n\n        # Dimensional attributes\n        key = (\n            r.get(\'rgn_region\'),\n            r.get(\'m_area\'),\n            r.get(\'m_market\'),\n            r.get(\'construction_gc\')\n        )\n\n        if key not in groups:\n            groups[key] = {\n                \'started_projects\': set(),\n                \'completed_projects\': set()\n            }\n\n        groups[key][\'started_projects\'].add(project_id)\n\n        # Numerator condition: planned-technologies-integrated milestone completed (timestamp exists)\n        planned_tech_done = _to_ts(r.get(\'ms_1899_all_planned_technologies_integrated_actual\'))\n        if planned_tech_done is not None:\n            groups[key][\'completed_projects\'].add(project_id)\n\n    # ---- format output ----\n    out = []\n    for (rgn_region, m_area, m_market, construction_gc), agg in groups.items():\n        denom = len(agg[\'started_projects\'])\n        numer = len(agg[\'completed_projects\'])\n        rate = (float(numer) / float(denom)) if denom else None\n\n        out.append({\n            \'rgn_region\': rgn_region,\n            \'m_area\': m_area,\n            \'m_market\': m_market,\n            \'construction_gc\': construction_gc,\n            \'integration_started_projects\': denom,\n            \'planned_technologies_integrated_projects\': numer,\n            \'rf010_completion_rate\': rate\n        })\n\n    # Stable ordering for BI consumers\n    out.sort(key=lambda x: (\n        str(x.get(\'rgn_region\') or \'\'),\n        str(x.get(\'m_area\') or \'\'),\n        str(x.get(\'m_market\') or \'\'),\n        str(x.get(\'construction_gc\') or \'\')\n    ))\n\n    return out\n', kpi_source_columns: ['pj_project_id', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_project_status', 'por_category', 'pj_a_5270_integration_start_finish', 'ms_1899_all_planned_technologies_integrated_actual', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'RF010 Completion Rate', kpi_related_core_node_ids: ['integration_artifact', 'project'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '97e41968-84fe-434d-823e-2fae706ce764', entity_type: 'kpi', kpi_name: 'RF010 Completion Rate', name: '97e41968-84fe-434d-823e-2fae706ce764', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures the share of projects that have completed the planned-technologies-integrated milestone among all projects that have started integration within the selected period. This matters because it quantifies integration throughput and predictability, enabling early detection of delivery slowdowns by market, region, and general contractor. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: '97e41968-84fe-434d-823e-2fae706ce764'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_nas_log_data', 'pwc_macro_staging_schema.stg_nas_nest_ext_raw_by_session'], nl_business_rule: '', kpi_formula_description: 'Outage Compliance Rate (%) computed from pwc_macro_staging_schema.stg_nas_session_level_combined_data (single source table). Denominator = count of sessions where nas_checkout_approve_time IS NOT NULL (completed) AND nas_nest_start_time IS NOT NULL (had a NEST window). Numerator = denominator sessions where nas_status_nest_ext IS NULL OR nas_status_nest_ext=\'0\' (no extension requested). Rate = (Numerator ÷ Denominator) × 100. Filters apply to nas_checkout_approve_time (start_date/end_date cast to timestamp). Supports optional single-dimension grouping by nas_market, nas_activity_type, nas_company_name, nas_primary_gc, or nas_site_id.', kpi_output_schema: '[{"column": "outage_compliance_rate_pct", "type": "float", "description": "Percent of completed NAS sessions with NEST approved and no NEST extension request."}, {"column": "completed_sessions_count", "type": "int", "description": "Denominator: number of completed sessions."}, {"column": "compliant_sessions_count", "type": "int", "description": "Numerator: completed sessions with NEST approved and no extension."}, {"column": "noncompliant_sessions_count", "type": "int", "description": "Completed sessions that failed compliance criteria."}]', kpi_business_logic: '1) From NAS Event Log, collapse events to session-level flags: has_completed if any check-out/completed event exists; has_nest_approved if any \'Nest Approved\' event exists; has_extension_event if any extension-request event exists. 2) Define denominator as all sessions with has_completed = true. 3) From NEST Extension table, collect all nas_session_id values with any extension request (optionally filtered by date_requested/region/market/site). 4) A completed session is compliant if has_nest_approved = true AND it is NOT present in the extension set AND has_extension_event = false. 5) Rate = compliant_completed / completed * 100; also return counts.', kpi_filters: '[{"name": "start_date", "type": "date", "description": "Include sessions/events on or after this timestamp (applied to nas_event_time and nas_date_requested as text comparisons)."}, {"name": "end_date", "type": "date", "description": "Include sessions/events on or before this timestamp (applied to nas_event_time and nas_date_requested as text comparisons)."}, {"name": "nas_region", "type": "string", "description": "Filter to a NAS region (e.g., \'Central\')."}, {"name": "nas_market", "type": "string", "description": "Filter to a NAS market (e.g., \'Chicago\')."}, {"name": "nas_site_id", "type": "string", "description": "Filter to a specific site code."}, {"name": "nas_session_id", "type": "string", "description": "Filter to a specific NAS session id."}, {"name": "nas_project_category", "type": "string", "description": "Filter to a NAS project category."}, {"name": "nas_nest_type", "type": "string", "description": "Filter to a NEST type (e.g., NSI/SI) if populated in event log."}]', kpi_contract: '{"function_name": "get_outage_compliance_rate", "node_type": "kpi", "node_id": "af90e98a-a8be-4f00-a97f-39b56c7ad2d1", "node_label": "Outage Compliance Rate", "description": "Measures the percentage of completed NAS integration sessions that had an approved NEST outage window and finished without any NEST extension request, indicating adherence to outage governance and reducing audit/process non-compliance risk. A low rate signals frequent maintenance-window overruns and potential governance escalation needs.", "parameters": [], "output_columns": [{"name": "total_completed_with_nest", "type": "number", "nullable": false}, {"name": "compliant_sessions", "type": "number", "nullable": false}, {"name": "noncompliant_sessions", "type": "number", "nullable": false}, {"name": "outage_compliance_rate_pct", "type": "number", "nullable": false}], "sample_output": [], "row_count": 1}', nl_description: 'Outage Compliance Rate (%) computed from pwc_macro_staging_schema.stg_nas_session_level_combined_data (single source table). Denominator = count of sessions where nas_checkout_approve_time IS NOT NULL (completed) AND nas_nest_start_time IS NOT NULL (had a NEST window). Numerator = denominator sessions where nas_status_nest_ext IS NULL OR nas_status_nest_ext=\'0\' (no extension requested). Rate = (Numerator ÷ Denominator) × 100. Filters apply to nas_checkout_approve_time (start_date/end_date cast to timestamp). Supports optional single-dimension grouping by nas_market, nas_activity_type, nas_company_name, nas_primary_gc, or nas_site_id.', node_type: 'CORE', definition: 'Outage Compliance Rate (%) computed from pwc_macro_staging_schema.stg_nas_session_level_combined_data (single source table). Denominator = count of sessions where nas_checkout_approve_time IS NOT NULL (completed) AND nas_nest_start_time IS NOT NULL (had a NEST window). Numerator = denominator sessions where nas_status_nest_ext IS NULL OR nas_status_nest_ext=\'0\' (no extension requested). Rate = (Numerator ÷ Denominator) × 100. Filters apply to nas_checkout_approve_time (start_date/end_date cast to timestamp). Supports optional single-dimension grouping by nas_market, nas_activity_type, nas_company_name, nas_primary_gc, or nas_site_id.', kpi_python_function: 'def get_outage_compliance_rate(execute_query, filters=None) -> list[dict]:\n    """Outage Compliance Rate (%) computed from pwc_macro_staging_schema.stg_nas_session_level_combined_data.\n\n    Denominator: completed sessions with a NEST window\n      - nas_checkout_approve_time IS NOT NULL\n      - nas_nest_start_time IS NOT NULL\n\n    Numerator: denominator sessions with no extension request\n      - nas_status_nest_ext IS NULL OR nas_status_nest_ext = \'0\'\n\n    Supported filters:\n      - nas_market, nas_activity_type, nas_company_name, nas_primary_gc, nas_site_id\n      - start_date, end_date applied to nas_checkout_approve_time (timestamp)\n\n    Optional grouping:\n      - group_by in {nas_market, nas_activity_type, nas_company_name, nas_primary_gc, nas_site_id}\n        (single dimension)\n    """\n\n    f = filters or {}\n\n    allowed_filters = {\n        "nas_market",\n        "nas_activity_type",\n        "nas_company_name",\n        "nas_primary_gc",\n        "nas_site_id",\n        "start_date",\n        "end_date",\n        "group_by",\n    }\n    # Ignore any non-allowlisted keys\n    start_date = f.get("start_date")\n    end_date = f.get("end_date")\n    group_by = f.get("group_by")\n\n    allowed_group_bys = {\n        None,\n        "nas_market",\n        "nas_activity_type",\n        "nas_company_name",\n        "nas_primary_gc",\n        "nas_site_id",\n    }\n    if group_by not in allowed_group_bys:\n        raise ValueError(f"Unsupported group_by: {group_by}. Allowed: {sorted([g for g in allowed_group_bys if g])}")\n\n    where_parts = [\n        "nas_checkout_approve_time IS NOT NULL",\n        "nas_nest_start_time IS NOT NULL",\n    ]\n\n    # Dimension filters\n    if f.get("nas_market") is not None:\n        where_parts.append("nas_market = %(nas_market)s")\n    if f.get("nas_activity_type") is not None:\n        where_parts.append("nas_activity_type = %(nas_activity_type)s")\n    if f.get("nas_company_name") is not None:\n        where_parts.append("nas_company_name = %(nas_company_name)s")\n    if f.get("nas_primary_gc") is not None:\n        where_parts.append("nas_primary_gc = %(nas_primary_gc)s")\n    if f.get("nas_site_id") is not None:\n        where_parts.append("nas_site_id = %(nas_site_id)s")\n\n    # Date filters on completion time\n    if start_date is not None:\n        where_parts.append("nas_checkout_approve_time >= %(start_date)s::timestamp")\n    if end_date is not None:\n        where_parts.append("nas_checkout_approve_time <= %(end_date)s::timestamp")\n\n    where_sql = " AND ".join(where_parts)\n\n    # Build SELECT/GROUP BY\n    select_dim = ""\n    group_sql = ""\n    order_sql = ""\n    if group_by:\n        select_dim = f"{group_by} AS group_value,\\n"\n        group_sql = f"GROUP BY {group_by}"\n        order_sql = f"ORDER BY {group_by}"\n\n    sql = f"""\n        SELECT\n            {select_dim}\n            COUNT(*)::float AS total_completed_with_nest,\n            SUM(CASE WHEN (nas_status_nest_ext IS NULL OR nas_status_nest_ext = \'0\') THEN 1 ELSE 0 END)::float AS compliant_sessions,\n            SUM(CASE WHEN NOT (nas_status_nest_ext IS NULL OR nas_status_nest_ext = \'0\') THEN 1 ELSE 0 END)::float AS noncompliant_sessions,\n            CASE\n                WHEN COUNT(*) = 0 THEN NULL\n                ELSE (SUM(CASE WHEN (nas_status_nest_ext IS NULL OR nas_status_nest_ext = \'0\') THEN 1 ELSE 0 END)::float / COUNT(*)::float) * 100.0\n            END AS outage_compliance_rate_pct\n        FROM pwc_macro_staging_schema.stg_nas_session_level_combined_data\n        WHERE {where_sql}\n        {group_sql}\n        {order_sql}\n    """\n\n    params = {\n        "nas_market": f.get("nas_market"),\n        "nas_activity_type": f.get("nas_activity_type"),\n        "nas_company_name": f.get("nas_company_name"),\n        "nas_primary_gc": f.get("nas_primary_gc"),\n        "nas_site_id": f.get("nas_site_id"),\n        "start_date": start_date,\n        "end_date": end_date,\n    }\n\n    return execute_query(sql, params)\n', kpi_source_columns: ['stg_nas_log_data.nas_session_id', 'stg_nas_log_data.nas_event_type', 'stg_nas_log_data.nas_event_time', 'stg_nas_log_data.nas_region', 'stg_nas_log_data.nas_market', 'stg_nas_log_data.nas_site_id', 'stg_nas_log_data.nas_project_category', 'stg_nas_log_data.nas_nest_type', 'stg_nas_nest_ext_raw_by_session.nas_session_id', 'stg_nas_nest_ext_raw_by_session.nas_date_requested', 'stg_nas_nest_ext_raw_by_session.nas_region', 'stg_nas_nest_ext_raw_by_session.nas_market', 'stg_nas_nest_ext_raw_by_session.nas_site_id', 'stg_nas_nest_ext_raw_by_session.nas_project_category'], session_id: '69a3d22f26e208edc083a06e', label: 'Outage Compliance Rate', kpi_related_core_node_ids: ['integration_activity', 'nest_extension', 'planned_outage', 'site'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'af90e98a-a8be-4f00-a97f-39b56c7ad2d1', entity_type: 'kpi', kpi_name: 'Outage Compliance Rate', name: 'af90e98a-a8be-4f00-a97f-39b56c7ad2d1', kpi_dimensions: ['nas_region', 'nas_market', 'nas_project_category', 'nas_nest_type'], kpi_description: 'Measures the percentage of completed NAS integration sessions that had an approved NEST outage window and finished without any NEST extension request, indicating adherence to outage governance and reducing audit/process non-compliance risk. A low rate signals frequent maintenance-window overruns and potential governance escalation needs.', status: 'mentioned', node_id: 'af90e98a-a8be-4f00-a97f-39b56c7ad2d1'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_nas_log_data', 'pwc_macro_staging_schema.stg_nas_nest_ext_raw_by_session'], nl_business_rule: '', kpi_formula_description: 'Active Outage Violations (point-in-time snapshot) = COUNT(DISTINCT nas_session_id) from pwc_macro_staging_schema.stg_nas_session_level_combined_data where: (1) nas_nest_start_time IS NOT NULL (NEST window started), (2) nas_checkout_approve_time IS NULL (session still open), and (3) nas_nest_start_time_requested IS NULL (no extension initiated). Optional filters (allowlist): nas_market, nas_activity_type, nas_company_name, nas_primary_gc, nas_site_id. Optional group_by over: nas_market, nas_activity_type, nas_company_name, nas_primary_gc, nas_site_id. Caveats: Computed from pwc_macro_staging_schema.stg_nas_session_level_combined_data using three direct column checks—no event parsing, no cross-table joins. nas_nest_start_time is CHARACTER VARYING; IS NOT NULL works without casting. Snapshot KPI (no date filters); counts fluctuate with currently open sessions. Any count > 0 warrants immediate Escalation #2 action.', kpi_output_schema: '[{"column": "kpi_name", "type": "string", "description": "Static label for the KPI."}, {"column": "active_outage_violations", "type": "float", "description": "Number of violating (currently open) NAS sessions."}, {"column": "violating_session_count", "type": "int", "description": "Same as active_outage_violations, as an integer."}]', kpi_business_logic: '1) From NAS Event Log Event, group records by nas_session_id. 2) Mark each session as \'outage started\' if any event_type contains both \'NEST\' and \'APPROV\' (i.e., Nest Approved). 3) Mark each session as checked out if any event_type indicates checkout; and checkout approved if checkout event also contains \'APPROV\'. 4) From NEST Extension, build a set of session_ids that have any extension request row (extension initiated). 5) A session is an Active Outage Violation if: has_nest_approved = true AND has_checkout = false AND has_checkout_approved = false AND session_id not in extension_sessions. 6) KPI returns the count of such sessions.', kpi_filters: '[{"name": "start_date", "type": "date", "description": "Optional lower bound on nas_event_time (best-effort string compare if timestamps are text)."}, {"name": "end_date", "type": "date", "description": "Optional upper bound on nas_event_time (best-effort string compare if timestamps are text)."}, {"name": "nas_region", "type": "string", "description": "Filter to a NAS region (matches nas_region in event log and extension tables)."}, {"name": "nas_market", "type": "string", "description": "Filter to a NAS market (matches nas_market in event log and extension tables)."}, {"name": "nas_site_id", "type": "string", "description": "Filter to a specific site_id (matches nas_site_id in event log and extension tables)."}, {"name": "nas_session_id", "type": "string", "description": "Filter to a specific NAS session."}]', kpi_contract: '{"function_name": "get_active_outage_violations", "node_type": "kpi", "node_id": "38b69e8f-1d2d-4ca1-8067-1503119b9924", "node_label": "Active Outage Violations", "description": "Counts the number of currently open NAS sessions where the NEST outage window has started but checkout has not yet been approved and no outage extension request has been initiated. This KPI is a real-time governance/compliance trigger used to determine whether Escalation #2 actions are required, since it indicates crews are operating beyond the approved outage window without attempting to regularize the window through a formal extension request.", "parameters": [{"name": "nas_market", "type": "string", "description": "Filter by nas market", "required": false, "sample_values": []}, {"name": "market", "type": "string", "description": "Filter by market", "required": false, "sample_values": []}, {"name": "nas_activity_type", "type": "string", "description": "Filter by nas activity type", "required": false, "sample_values": []}, {"name": "nas_company_name", "type": "string", "description": "Filter by nas company name", "required": false, "sample_values": []}, {"name": "nas_primary_gc", "type": "string", "description": "Filter by nas primary gc", "required": false, "sample_values": []}, {"name": "nas_site_id", "type": "string", "description": "Filter by nas site id", "required": false, "sample_values": []}, {"name": "site_id", "type": "string", "description": "Filter by site id", "required": false, "sample_values": []}, {"name": "group_by", "type": "string", "description": "Filter by group by", "required": false, "sample_values": []}], "output_columns": [{"name": "kpi_name", "type": "string", "nullable": false}, {"name": "active_violation_count", "type": "number", "nullable": false}], "sample_output": [], "row_count": 1}', nl_description: 'Active Outage Violations (point-in-time snapshot) = COUNT(DISTINCT nas_session_id) from pwc_macro_staging_schema.stg_nas_session_level_combined_data where: (1) nas_nest_start_time IS NOT NULL (NEST window started), (2) nas_checkout_approve_time IS NULL (session still open), and (3) nas_nest_start_time_requested IS NULL (no extension initiated). Optional filters (allowlist): nas_market, nas_activity_type, nas_company_name, nas_primary_gc, nas_site_id. Optional group_by over: nas_market, nas_activity_type, nas_company_name, nas_primary_gc, nas_site_id. Caveats: Computed from pwc_macro_staging_schema.stg_nas_session_level_combined_data using three direct column checks—no event parsing, no cross-table joins. nas_nest_start_time is CHARACTER VARYING; IS NOT NULL works without casting. Snapshot KPI (no date filters); counts fluctuate with currently open sessions. Any count > 0 warrants immediate Escalation #2 action.', node_type: 'CORE', definition: 'Active Outage Violations (point-in-time snapshot) = COUNT(DISTINCT nas_session_id) from pwc_macro_staging_schema.stg_nas_session_level_combined_data where: (1) nas_nest_start_time IS NOT NULL (NEST window started), (2) nas_checkout_approve_time IS NULL (session still open), and (3) nas_nest_start_time_requested IS NULL (no extension initiated). Optional filters (allowlist): nas_market, nas_activity_type, nas_company_name, nas_primary_gc, nas_site_id. Optional group_by over: nas_market, nas_activity_type, nas_company_name, nas_primary_gc, nas_site_id. Caveats: Computed from pwc_macro_staging_schema.stg_nas_session_level_combined_data using three direct column checks—no event parsing, no cross-table joins. nas_nest_start_time is CHARACTER VARYING; IS NOT NULL works without casting. Snapshot KPI (no date filters); counts fluctuate with currently open sessions. Any count > 0 warrants immediate Escalation #2 action.', kpi_python_function: 'def get_active_outage_violations(execute_query, filters=None) -> list[dict]:\n    """Active Outage Violations (point-in-time snapshot).\n\n    Counts distinct NAS sessions that are currently in an active NEST outage window,\n    have not yet been checkout-approved, and have no extension initiated.\n\n    Source of truth: pwc_macro_staging_schema.stg_nas_session_level_combined_data\n    (NO event parsing, NO Python-side joins).\n\n    Optional filters (allowlist):\n      - nas_market\n      - nas_activity_type\n      - nas_company_name\n      - nas_primary_gc\n      - nas_site_id\n      - group_by: list/CSV of dimensions to group results by\n\n    Returns rows with active_violation_count and any requested grouping dimensions.\n    """\n\n    # ---- allowlisted filters ----\n    nas_market = None\n    nas_activity_type = None\n    nas_company_name = None\n    nas_primary_gc = None\n    nas_site_id = None\n    group_by = None\n\n    if filters:\n        nas_market = filters.get("nas_market") or filters.get("market")\n        nas_activity_type = filters.get("nas_activity_type")\n        nas_company_name = filters.get("nas_company_name")\n        nas_primary_gc = filters.get("nas_primary_gc")\n        nas_site_id = filters.get("nas_site_id") or filters.get("site_id")\n        group_by = filters.get("group_by")\n\n    allowed_dims = {\n        "nas_market": \'"nas_market"\',\n        "nas_activity_type": \'"nas_activity_type"\',\n        "nas_company_name": \'"nas_company_name"\',\n        "nas_primary_gc": \'"nas_primary_gc"\',\n        "nas_site_id": \'"nas_site_id"\',\n    }\n\n    # Normalize group_by input\n    group_dims = []\n    if group_by:\n        if isinstance(group_by, str):\n            req = [x.strip() for x in group_by.split(",") if x.strip()]\n        elif isinstance(group_by, (list, tuple)):\n            req = [str(x).strip() for x in group_by if str(x).strip()]\n        else:\n            req = []\n        for d in req:\n            if d in allowed_dims and d not in group_dims:\n                group_dims.append(d)\n\n    select_cols = []\n    group_cols = []\n    for d in group_dims:\n        select_cols.append(f"{allowed_dims[d]} AS {d}")\n        group_cols.append(allowed_dims[d])\n\n    select_prefix = (", ".join(select_cols) + ", ") if select_cols else ""\n\n    # Core 3-condition WHERE pattern from the confirmed document\n    sql = (\n        f"""SELECT {select_prefix}COUNT(DISTINCT "nas_session_id") AS active_violation_count FROM pwc_macro_staging_schema.stg_nas_session_level_combined_data WHERE "nas_nest_start_time" IS NOT NULL AND "nas_checkout_approve_time" IS NULL AND "nas_nest_start_time_requested" IS NULL """\n    )\n\n    # Add optional filters (explicit allowlist; no generic loops)\n    if nas_market is not None and str(nas_market).strip() != "":\n        sql += f"AND \\"nas_market\\" = \'{str(nas_market).replace("\'", "\'\'")}\' "\n    if nas_activity_type is not None and str(nas_activity_type).strip() != "":\n        sql += f"AND \\"nas_activity_type\\" = \'{str(nas_activity_type).replace("\'", "\'\'")}\' "\n    if nas_company_name is not None and str(nas_company_name).strip() != "":\n        sql += f"AND \\"nas_company_name\\" = \'{str(nas_company_name).replace("\'", "\'\'")}\' "\n    if nas_primary_gc is not None and str(nas_primary_gc).strip() != "":\n        sql += f"AND \\"nas_primary_gc\\" = \'{str(nas_primary_gc).replace("\'", "\'\'")}\' "\n    if nas_site_id is not None and str(nas_site_id).strip() != "":\n        sql += f"AND \\"nas_site_id\\" = \'{str(nas_site_id).replace("\'", "\'\'")}\' "\n\n    if group_cols:\n        sql += "GROUP BY " + ", ".join(group_cols) + " "\n\n    rows = execute_query(sql) or []\n\n    # Standardize output keys\n    out = []\n    for r in rows:\n        rec = {"kpi_name": "Active Outage Violations"}\n        for d in group_dims:\n            rec[d] = r.get(d)\n        # ensure numeric\n        avc = r.get("active_violation_count")\n        rec["active_violation_count"] = float(avc) if avc is not None else 0.0\n        out.append(rec)\n\n    # If no group_by, always return a single row\n    if not group_dims and not out:\n        out = [{"kpi_name": "Active Outage Violations", "active_violation_count": 0.0}]\n\n    return out\n', kpi_source_columns: ['stg_nas_log_data.nas_session_id', 'stg_nas_log_data.nas_event_type', 'stg_nas_log_data.nas_event_time', 'stg_nas_log_data.nas_region', 'stg_nas_log_data.nas_market', 'stg_nas_log_data.nas_site_id', 'stg_nas_nest_ext_raw_by_session.nas_session_id', 'stg_nas_nest_ext_raw_by_session.nas_date_requested', 'stg_nas_nest_ext_raw_by_session.nas_region', 'stg_nas_nest_ext_raw_by_session.nas_market', 'stg_nas_nest_ext_raw_by_session.nas_site_id'], session_id: '69a3d22f26e208edc083a06e', label: 'Active Outage Violations', kpi_related_core_node_ids: ['integration_activity', 'nest_extension', 'planned_outage', 'site'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '38b69e8f-1d2d-4ca1-8067-1503119b9924', entity_type: 'kpi', kpi_name: 'Active Outage Violations', name: '38b69e8f-1d2d-4ca1-8067-1503119b9924', kpi_dimensions: ['nas_region', 'nas_market', 'nas_site_id', 'nas_session_id'], kpi_description: 'Counts the number of currently open NAS sessions where the NEST outage window has started but checkout has not yet been approved and no outage extension request has been initiated. This KPI is a real-time governance/compliance trigger used to determine whether Escalation #2 actions are required, since it indicates crews are operating beyond the approved outage window without attempting to regularize the window through a formal extension request.', status: 'mentioned', node_id: '38b69e8f-1d2d-4ca1-8067-1503119b9924'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_nas_nest_ext_raw_by_session', 'public.stg_tmo_nas_daily_dashboard'], nl_business_rule: '', kpi_formula_description: 'Pending NEST Extensions = count(distinct nas_session_id) from pwc_macro_staging_schema.stg_nas_session_level_combined_data where nas_nest_start_time_requested IS NOT NULL (extension requested) AND nas_checkout_approve_time IS NULL (session still open). Supports the same SQL-only filtering and optional group_by dimensional breakdowns as the Active Outage Violations KPI. Dimensions: nas_market, nas_activity_type, nas_company_name, nas_primary_gc, nas_site_id.', kpi_output_schema: '[{"column": "pending_nest_extensions", "type": "float", "description": "Count of distinct NAS sessions that are open and have at least one NEST extension request."}, {"column": "pending_session_count", "type": "integer", "description": "Same as pending_nest_extensions but as an integer."}, {"column": "as_of_session_rows_considered", "type": "integer", "description": "Number of session rows meeting the condition after filtering (useful for sanity checks)."}]', kpi_business_logic: '1) Pull all NEST Extension rows and group by nas_session_id (optionally filter by nas_date_requested within start_date/end_date). 2) Pull NAS Daily Dashboard rows keyed by session_id. 3) For each session with >=1 extension request, keep it only if the dashboard row exists and checkout_os is null/blank (interpreted as not yet checked out). 4) Apply optional dimension filters (region, market, site_id, nest_type, project_category, nas_session_id). 5) KPI value is the number of distinct remaining session_ids.', kpi_filters: '[{"name": "start_date", "type": "date", "description": "Include only extension requests with nas_date_requested >= start_date (interpreted at 00:00:00 if date-only)."}, {"name": "end_date", "type": "date", "description": "Include only extension requests with nas_date_requested <= end_date (interpreted at 23:59:59 if date-only)."}, {"name": "region", "type": "string", "description": "Filter to a NAS region (from NAS Daily Dashboard Entry.region)."}, {"name": "market", "type": "string", "description": "Filter to a NAS market (from NAS Daily Dashboard Entry.market)."}, {"name": "site_id", "type": "string", "description": "Filter to a site (from NAS Daily Dashboard Entry.site_id)."}, {"name": "nas_session_id", "type": "string", "description": "Filter to a specific NAS session id."}, {"name": "nest_type", "type": "string", "description": "Filter to a NEST type (from NAS Daily Dashboard Entry.nest_type)."}, {"name": "project_category", "type": "string", "description": "Filter to a project category (from NAS Daily Dashboard Entry.project_category)."}]', kpi_contract: '{"function_name": "get_pending_nest_extensions", "node_type": "kpi", "node_id": "b3c481e0-cb8d-4c81-ae35-0e01f0c69f46", "node_label": "Pending NEST Extensions", "description": "Counts NAS sessions that are currently open and have a NEST extension request initiated but are not yet checked out. This measures the volume of in-progress sessions that followed the extension process and are at risk of overrunning their outage window, supporting proactive monitoring and escalation management alongside Active Outage Violations.", "parameters": [{"name": "group_by", "type": "string", "description": "Filter by group by", "required": false, "sample_values": []}, {"name": "nas_market", "type": "string", "description": "Filter by nas market", "required": false, "sample_values": []}, {"name": "nas_activity_type", "type": "string", "description": "Filter by nas activity type", "required": false, "sample_values": []}, {"name": "nas_company_name", "type": "string", "description": "Filter by nas company name", "required": false, "sample_values": []}, {"name": "nas_primary_gc", "type": "string", "description": "Filter by nas primary gc", "required": false, "sample_values": []}, {"name": "nas_site_id", "type": "string", "description": "Filter by nas site id", "required": false, "sample_values": []}, {"name": "nas_session_id", "type": "string", "description": "Filter by nas session id", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}], "output_columns": [{"name": "pending_nest_extensions", "type": "number", "nullable": false}], "sample_output": [], "row_count": 1}', nl_description: 'Pending NEST Extensions = count(distinct nas_session_id) from pwc_macro_staging_schema.stg_nas_session_level_combined_data where nas_nest_start_time_requested IS NOT NULL (extension requested) AND nas_checkout_approve_time IS NULL (session still open). Supports the same SQL-only filtering and optional group_by dimensional breakdowns as the Active Outage Violations KPI. Dimensions: nas_market, nas_activity_type, nas_company_name, nas_primary_gc, nas_site_id.', node_type: 'CORE', definition: 'Pending NEST Extensions = count(distinct nas_session_id) from pwc_macro_staging_schema.stg_nas_session_level_combined_data where nas_nest_start_time_requested IS NOT NULL (extension requested) AND nas_checkout_approve_time IS NULL (session still open). Supports the same SQL-only filtering and optional group_by dimensional breakdowns as the Active Outage Violations KPI. Dimensions: nas_market, nas_activity_type, nas_company_name, nas_primary_gc, nas_site_id.', kpi_python_function: 'def get_pending_nest_extensions(execute_query, filters=None) -> list[dict]:\n    """Pending NEST Extensions (SQL-only, single source table).\n\n    Single source of truth: pwc_macro_staging_schema.stg_nas_session_level_combined_data\n\n    Pending = extension requested AND session still open:\n      - nas_nest_start_time_requested IS NOT NULL\n      - nas_checkout_approve_time IS NULL\n\n    Supports optional group_by across allowed dimensions and allowlisted filters,\n    matching the pattern used for the Active Outage Violations KPI.\n    """\n\n    filters = filters or {}\n\n    # ---- Allowlisted dimensions (for group_by) ----\n    allowed_group_bys = {\n        "nas_market",\n        "nas_activity_type",\n        "nas_company_name",\n        "nas_primary_gc",\n        "nas_site_id",\n    }\n\n    group_by = filters.get("group_by") or []\n    if isinstance(group_by, str):\n        group_by = [group_by]\n    group_by = [g for g in group_by if g in allowed_group_bys]\n\n    # ---- Allowlisted filters (keep aligned with Active Outage Violations pattern) ----\n    # NOTE: We intentionally do not iterate arbitrary filters to avoid SQL injection / silent failures.\n    where = [\n        "nas_nest_start_time_requested IS NOT NULL",\n        "nas_checkout_approve_time IS NULL",\n    ]\n\n    params = {}\n\n    # Common dimension filters\n    if filters.get("nas_market") is not None:\n        where.append("nas_market = %(nas_market)s")\n        params["nas_market"] = filters["nas_market"]\n\n    if filters.get("nas_activity_type") is not None:\n        where.append("nas_activity_type = %(nas_activity_type)s")\n        params["nas_activity_type"] = filters["nas_activity_type"]\n\n    if filters.get("nas_company_name") is not None:\n        where.append("nas_company_name = %(nas_company_name)s")\n        params["nas_company_name"] = filters["nas_company_name"]\n\n    if filters.get("nas_primary_gc") is not None:\n        where.append("nas_primary_gc = %(nas_primary_gc)s")\n        params["nas_primary_gc"] = filters["nas_primary_gc"]\n\n    if filters.get("nas_site_id") is not None:\n        where.append("nas_site_id = %(nas_site_id)s")\n        params["nas_site_id"] = filters["nas_site_id"]\n\n    # Optional session filter (commonly used for debugging)\n    if filters.get("nas_session_id") is not None:\n        where.append("nas_session_id = %(nas_session_id)s")\n        params["nas_session_id"] = filters["nas_session_id"]\n\n    # Optional date range handling (kept consistent with the Active Outage Violations approach)\n    # We apply date range to the request timestamp column since it is the event defining this KPI.\n    if filters.get("start_date") is not None:\n        where.append("nas_nest_start_time_requested >= %(start_date)s::timestamp")\n        params["start_date"] = str(filters["start_date"])  # accept \'YYYY-MM-DD\' or full timestamp\n\n    if filters.get("end_date") is not None:\n        where.append("nas_nest_start_time_requested <= %(end_date)s::timestamp")\n        params["end_date"] = str(filters["end_date"])  # accept \'YYYY-MM-DD\' or full timestamp\n\n    select_dims = (", ".join(group_by) + ", ") if group_by else ""\n    group_clause = (" GROUP BY " + ", ".join(group_by)) if group_by else ""\n    order_clause = (" ORDER BY " + ", ".join(group_by)) if group_by else ""\n\n    sql = (\n        f"""SELECT {select_dims}COUNT(DISTINCT nas_session_id) AS pending_nest_extensions FROM pwc_macro_staging_schema.stg_nas_session_level_combined_data WHERE {\' AND \'.join(where)}{group_clause}{order_clause}"""\n    )\n\n    rows = execute_query(sql, params) or []\n\n    # Normalize output shape: always return numeric metric key plus any grouped dimensions\n    out = []\n    for r in rows:\n        rec = {}\n        for d in group_by:\n            rec[d] = r.get(d)\n        rec["pending_nest_extensions"] = float(r.get("pending_nest_extensions") or 0)\n        out.append(rec)\n\n    # If no group_by, still return one row (even if empty result set)\n    if not group_by and not out:\n        out = [{"pending_nest_extensions": 0.0}]\n\n    return out\n', kpi_source_columns: ['stg_nas_nest_ext_raw_by_session.nas_session_id', 'stg_nas_nest_ext_raw_by_session.nas_date_requested', 'stg_nas_nest_ext_raw_by_session.nas_region', 'stg_nas_nest_ext_raw_by_session.nas_market', 'stg_nas_nest_ext_raw_by_session.nas_site_id', 'stg_tmo_nas_daily_dashboard.session_id', 'stg_tmo_nas_daily_dashboard.region', 'stg_tmo_nas_daily_dashboard.market', 'stg_tmo_nas_daily_dashboard.site_id', 'stg_tmo_nas_daily_dashboard.project_category', 'stg_tmo_nas_daily_dashboard.nest_type', 'stg_tmo_nas_daily_dashboard.checkout_os'], session_id: '69a3d22f26e208edc083a06e', label: 'Pending NEST Extensions', kpi_related_core_node_ids: ['integration_activity', 'nest_extension', 'planned_outage', 'site'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'b3c481e0-cb8d-4c81-ae35-0e01f0c69f46', entity_type: 'kpi', kpi_name: 'Pending NEST Extensions', name: 'b3c481e0-cb8d-4c81-ae35-0e01f0c69f46', kpi_dimensions: ['region', 'market', 'site_id', 'project_category', 'nest_type'], kpi_description: 'Counts NAS sessions that are currently open and have a NEST extension request initiated but are not yet checked out. This measures the volume of in-progress sessions that followed the extension process and are at risk of overrunning their outage window, supporting proactive monitoring and escalation management alongside Active Outage Violations.', status: 'mentioned', node_id: 'b3c481e0-cb8d-4c81-ae35-0e01f0c69f46'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Market Dependency Blocked = COUNT(DISTINCT pj_project_id) from stg_ndpd_mbt_tmobile_macro_combined where pj_a_3710_ran_entitlement_complete_finish IS NOT NULL AND ms_1310_pre_construction_package_received_actual IS NOT NULL AND pj_a_5250_intp_clearance_received_finish IS NULL. Optional filters: m_market, m_area, rgn_region, construction_gc, s_site_id. Optional grouping: rgn_region, m_area, m_market, construction_gc.', kpi_output_schema: '[{"column": "metric", "type": "string", "description": "Metric identifier (market_dependency_blocked)."}, {"column": "blocked_project_count", "type": "integer", "description": "Number of active projects blocked by pending INTP/market clearance after pre-con package received."}, {"column": "dimension", "type": "string", "description": "Returned only when group_by is provided."}, {"column": "dimension_value", "type": "string", "description": "Returned only when group_by is provided."}]', kpi_business_logic: '1) Start from Project rows (optionally filtered by region/area/market/GC). 2) Keep entitled projects (pj_a_3710_ran_entitlement_complete_finish IS NOT NULL) (unless caller explicitly provides pj_project_status). 3) For each project, look up Site Survey milestone ms_1310_pre_construction_package_received_actual; require it to be populated (pre-con package received). 4) Look up Integration Artifact clearance: treat INTP/market clearance as received if pj_a_5250_intp_clearance_received_finish is populated; otherwise fall back to i_ntp_received when available. 5) Count projects meeting: pre-con received AND INTP clearance not received. 6) Optionally return counts by a requested dimension (market/area/region/GC).', kpi_filters: '[{"name": "m_market", "type": "string", "description": "Filter projects to a specific market (exact match as stored)."}, {"name": "m_area", "type": "string", "description": "Filter projects to a specific area."}, {"name": "rgn_region", "type": "string", "description": "Filter projects to a specific region."}, {"name": "pj_project_status", "type": "string", "description": "Override default Active-only behavior (e.g., include all statuses)."}, {"name": "group_by", "type": "string", "description": "Optional rollup dimension: one of rgn_region, m_area, m_market, construction_gc."}, {"name": "smp_name", "type": "string", "description": "Filter by program name (e.g., NTM, AHLOB Modernization). When NTM, additionally requires smp_status=Active and excludes specific ntm_project_type values."}]', kpi_contract: '{"function_name": "get_market_dependency_blocked", "node_type": "kpi", "node_id": "2dbe987e-8f55-41c5-aad0-f11abeb78580", "node_label": "Market Dependency Blocked", "description": "Counts active projects where the pre-construction package has been received but INTP/market clearance is still pending. This highlights sites blocked by external market/customer dependencies despite Nokia readiness, and serves as the escalation trigger for Market Dependency Risk (Escalation #6) to drive timely cross-party action.", "parameters": [{"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by pj general contractor", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}, {"name": "group_by", "type": "string", "description": "Filter by group by", "required": false, "sample_values": []}], "output_columns": [{"name": "metric", "type": "string", "nullable": false}, {"name": "blocked_project_count", "type": "number", "nullable": false}], "sample_output": [], "row_count": 1}', nl_description: 'Market Dependency Blocked = COUNT(DISTINCT pj_project_id) from stg_ndpd_mbt_tmobile_macro_combined where pj_a_3710_ran_entitlement_complete_finish IS NOT NULL AND ms_1310_pre_construction_package_received_actual IS NOT NULL AND pj_a_5250_intp_clearance_received_finish IS NULL. Optional filters: m_market, m_area, rgn_region, construction_gc, s_site_id. Optional grouping: rgn_region, m_area, m_market, construction_gc.', node_type: 'CORE', definition: 'Market Dependency Blocked = COUNT(DISTINCT pj_project_id) from stg_ndpd_mbt_tmobile_macro_combined where pj_a_3710_ran_entitlement_complete_finish IS NOT NULL AND ms_1310_pre_construction_package_received_actual IS NOT NULL AND pj_a_5250_intp_clearance_received_finish IS NULL. Optional filters: m_market, m_area, rgn_region, construction_gc, s_site_id. Optional grouping: rgn_region, m_area, m_market, construction_gc.', kpi_python_function: 'def get_market_dependency_blocked(execute_query, filters=None) -> list[dict]:\n    """Market Dependency Blocked: entitled projects where pre-construction package received but INTP clearance not received."""\n\n    filters = filters or {}\n\n    # Explicit allowlist filters (no generic loops)\n    m_market = filters.get("m_market")\n    m_area = filters.get("m_area")\n    rgn_region = filters.get("rgn_region")\n    construction_gc = filters.get("construction_gc")\n    s_site_id = filters.get("s_site_id")\n\n    group_by = filters.get("group_by")\n    allowed_group_bys = {"rgn_region", "m_area", "m_market", "construction_gc"}\n    if group_by is not None and group_by not in allowed_group_bys:\n        raise ValueError(f"Unsupported group_by \'{group_by}\'. Allowed: {sorted(allowed_group_bys)}")\n\n    base_where = """\n        pj_a_3710_ran_entitlement_complete_finish IS NOT NULL\n        AND ms_1310_pre_construction_package_received_actual IS NOT NULL\n        AND pj_a_5250_intp_clearance_received_finish IS NULL\n    """\n\n    where_clauses = [base_where]\n\n    if m_market:\n        where_clauses.append(f\'"m_market" = \\\'{str(filters.get("m_market", "")).replace("\\\'", "\\\'\\\'")}\\\'\')\n    if m_area:\n        where_clauses.append(f\'"m_area" = \\\'{str(filters.get("m_area", "")).replace("\\\'", "\\\'\\\'")}\\\'\')\n    if rgn_region:\n        where_clauses.append(f\'"rgn_region" = \\\'{str(filters.get("rgn_region", "")).replace("\\\'", "\\\'\\\'")}\\\'\')\n    if construction_gc:\n        where_clauses.append(f\'"construction_gc" = \\\'{str(filters.get("construction_gc", "")).replace("\\\'", "\\\'\\\'")}\\\'\')\n    if s_site_id:\n        where_clauses.append(f\'"s_site_id" = \\\'{str(filters.get("s_site_id", "")).replace("\\\'", "\\\'\\\'")}\\\'\')\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        val = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_clauses.append(f\'"smp_name" = \\\'{val}\\\'\')\n        if val.strip().upper() == \'NTM\':\n            where_clauses.append(\'"smp_status" = \\\'Active\\\'\')\n            where_clauses.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n\n    where_sql = " WHERE " + " AND ".join(f"({c.strip()})" for c in where_clauses)\n\n    if group_by:\n        sql = f"""\n            SELECT\n                {group_by} AS dimension_value,\n                COUNT(DISTINCT pj_project_id) AS blocked_project_count\n            FROM stg_ndpd_mbt_tmobile_macro_combined\n            {where_sql}\n            GROUP BY {group_by}\n            ORDER BY {group_by}\n        """\n        rows = execute_query(sql)\n        return [\n            {\n                "metric": "market_dependency_blocked",\n                "dimension": group_by,\n                "dimension_value": r.get("dimension_value") if r.get("dimension_value") is not None else "(NULL)",\n                "blocked_project_count": r.get("blocked_project_count") or 0,\n            }\n            for r in (rows or [])\n        ]\n\n    sql = f"""\n        SELECT\n            COUNT(DISTINCT pj_project_id) AS blocked_project_count\n        FROM stg_ndpd_mbt_tmobile_macro_combined\n        {where_sql}\n    """\n    rows = execute_query(sql)\n    count_val = 0\n    if rows and isinstance(rows, list):\n        count_val = rows[0].get("blocked_project_count") or 0\n\n    return [{\n        "metric": "market_dependency_blocked",\n        "blocked_project_count": count_val\n    }]\n', kpi_source_columns: ['pj_project_id', 'pj_project_status', 's_site_id', 'm_market', 'm_area', 'rgn_region', 'construction_gc', 'ms_1310_pre_construction_package_received_actual', 'pj_a_5250_intp_clearance_received_finish', 'i_ntp_received', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Market Dependency Blocked', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '2dbe987e-8f55-41c5-aad0-f11abeb78580', entity_type: 'kpi', kpi_name: 'Market Dependency Blocked', name: '2dbe987e-8f55-41c5-aad0-f11abeb78580', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Counts active projects where the pre-construction package has been received but INTP/market clearance is still pending. This highlights sites blocked by external market/customer dependencies despite Nokia readiness, and serves as the escalation trigger for Market Dependency Risk (Escalation #6) to drive timely cross-party action. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: '2dbe987e-8f55-41c5-aad0-f11abeb78580'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Tool Access Blocked = count of distinct entitled projects where construction PO has been pulled (milestone pj_a_4200_pull_construction_po_number_finish is not null) and tool access is blocked because CR is missing/blank OR CR status is null or not in the caller-provided resolved_statuses set (default: [\'approved\',\'SCHEDULED\'], overridable via filter). Output is grouped by region/area/market/general_contractor/construction_gc and split into CR missing vs CR stuck.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region of the project/site."}, {"column": "m_area", "type": "string", "description": "Area of the project/site."}, {"column": "m_market", "type": "string", "description": "Market of the project/site."}, {"column": "construction_gc", "type": "string", "description": "General contractor assigned on the project record (free-text)."}, {"column": "construction_gc", "type": "string", "description": "Construction GC field on the project record (may differ from construction_gc in split-scope cases)."}, {"column": "tool_access_blocked_projects", "type": "integer", "description": "Distinct active projects with construction NTP accepted and CR missing or not resolved."}, {"column": "cr_missing_projects", "type": "integer", "description": "Distinct active projects where CR id is missing/blank (subset of tool_access_blocked_projects)."}, {"column": "cr_stuck_projects", "type": "integer", "description": "Distinct active projects where CR exists but status is null or not in the resolved set (subset of tool_access_blocked_projects)."}]', kpi_business_logic: '1) Start from stg_ndpd_mbt_tmobile_macro_combined (one row per project).\n2) Keep only pj_a_3710_ran_entitlement_complete_finish IS NOT NULL.\n3) Identify projects where construction has pulled a PO: pj_a_4200_pull_construction_po_number_finish IS NOT NULL.\n4) Among those, flag as tool-access-blocked if pj_cr_id IS NULL/blank OR pj_cr_status IS NULL OR LOWER(TRIM(pj_cr_status)) NOT IN the caller-provided resolved_statuses set (default: [\'approved\', \'scheduled\'], overridable via filter).\n5) Aggregate counts of distinct pj_project_id grouped by rgn_region, m_area, m_market, construction_gc, construction_gc, split into CR missing vs CR stuck (CR exists but not resolved).', kpi_filters: '[{"name": "start_date", "type": "date", "description": "Include projects whose construction NTP accepted timestamp is on/after this datetime (pj_a_4100_construction_ntp_accepted_by_gc_finish)."}, {"name": "end_date", "type": "date", "description": "Include projects whose construction NTP accepted timestamp is before this datetime (pj_a_4100_construction_ntp_accepted_by_gc_finish)."}, {"name": "rgn_region", "type": "string", "description": "Filter to a specific region."}, {"name": "m_area", "type": "string", "description": "Filter to a specific area."}, {"name": "m_market", "type": "string", "description": "Filter to a specific market."}, {"name": "construction_gc", "type": "string", "description": "Filter to a specific general contractor (free-text field)."}, {"name": "construction_gc", "type": "string", "description": "Filter to a specific construction GC alias field."}, {"name": "smp_name", "type": "string", "description": "Filter by program name (e.g., NTM, AHLOB Modernization). When NTM, additionally requires smp_status=Active and excludes specific ntm_project_type values."}]', kpi_contract: '{"function_name": "get_tool_access_blocked", "node_type": "kpi", "node_id": "d43ba249-174c-46e6-9ba2-cce0c84cd312", "node_label": "Tool Access Blocked", "description": "Counts active projects that have reached the point where construction has pulled a PO but tool access is blocked because the project\\u2019s Change Request is missing or not yet in a resolved state. This KPI is used as an escalation trigger to prevent integration delays by separating cases where a CR was never raised from cases where a CR exists but is stuck in approval/processing, enabling targeted follow-up by market and contractor.", "parameters": [{"name": "resolved_statuses", "type": "string", "description": "Filter by resolved statuses", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by pj general contractor", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "tool_access_blocked_projects", "type": "number", "nullable": false}, {"name": "cr_missing_projects", "type": "number", "nullable": false}, {"name": "cr_stuck_projects", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Tool Access Blocked = count of distinct entitled projects where construction PO has been pulled (milestone pj_a_4200_pull_construction_po_number_finish is not null) and tool access is blocked because CR is missing/blank OR CR status is null or not in the caller-provided resolved_statuses set (default: [\'approved\',\'SCHEDULED\'], overridable via filter). Output is grouped by region/area/market/general_contractor/construction_gc and split into CR missing vs CR stuck.', node_type: 'CORE', definition: 'Tool Access Blocked = count of distinct entitled projects where construction PO has been pulled (milestone pj_a_4200_pull_construction_po_number_finish is not null) and tool access is blocked because CR is missing/blank OR CR status is null or not in the caller-provided resolved_statuses set (default: [\'approved\',\'SCHEDULED\'], overridable via filter). Output is grouped by region/area/market/general_contractor/construction_gc and split into CR missing vs CR stuck.', kpi_python_function: 'def get_tool_access_blocked(execute_query, filters=None) -> list[dict]:\n    """Counts active projects where construction has pulled a PO (via PO pull milestone)\n    but tool access is blocked because CR is missing or not resolved.\n\n    Output is grouped by region/area/market/GC with split into CR missing vs CR stuck.\n\n    Filters (allowlist):\n      - start_date, end_date (applied to pj_a_4200_pull_construction_po_number_finish)\n      - rgn_region, m_area, m_market, construction_gc, construction_gc\n      - resolved_statuses: list[str] or comma-separated str; defaults to [\'approved\',\'SCHEDULED\']\n    """\n\n    filters = filters or {}\n\n    # Parse/normalize resolved statuses\n    resolved_statuses = filters.get("resolved_statuses", ["approved", "SCHEDULED"])\n    if isinstance(resolved_statuses, str):\n        resolved_statuses = [s.strip() for s in resolved_statuses.split(",") if s.strip()]\n    elif isinstance(resolved_statuses, (list, tuple, set)):\n        resolved_statuses = [str(s).strip() for s in resolved_statuses if str(s).strip()]\n    else:\n        resolved_statuses = ["approved", "SCHEDULED"]\n\n    # SQL list literal (lowercased to match LOWER(TRIM()))\n    resolved_list_sql = ", ".join([f"\'{str(s).lower().replace("\'", "\'\'")}\'" for s in resolved_statuses])\n    if not resolved_list_sql:\n        # If caller passes an empty list, treat as "no statuses are resolved"\n        # so NOT IN () doesn\'t break SQL.\n        resolved_list_sql = "\'\'"\n\n    # Allowlisted filters\n    where_parts = [\n        \'p."pj_a_3710_ran_entitlement_complete_finish" IS NOT NULL\',\n        # Proxy for "construction has pulled a PO": PO pull milestone completed\n        \'p."pj_a_4200_pull_construction_po_number_finish" IS NOT NULL\',\n        # Tool access blocked because CR missing or not resolved\n        f\'(p."pj_cr_id" IS NULL OR NULLIF(TRIM(p."pj_cr_id"), \\\'\\\') IS NULL \'\n        f\'OR p."pj_cr_status" IS NULL OR LOWER(TRIM(p."pj_cr_status")) NOT IN ({resolved_list_sql}))\'\n    ]\n\n    if filters.get("start_date"):\n        sd = str(filters["start_date"]).replace("\'", "\'\'")\n        where_parts.append(\n            f\'p."pj_a_4200_pull_construction_po_number_finish"::timestamp >= \\\'{sd}\\\'::timestamp\'\n        )\n    if filters.get("end_date"):\n        ed = str(filters["end_date"]).replace("\'", "\'\'")\n        where_parts.append(\n            f\'p."pj_a_4200_pull_construction_po_number_finish"::timestamp < \\\'{ed}\\\'::timestamp\'\n        )\n\n    if filters.get("rgn_region"):\n        v = str(filters["rgn_region"]).replace("\'", "\'\'")\n        where_parts.append(f\'p."rgn_region" = \\\'{v}\\\'\')\n    if filters.get("m_area"):\n        v = str(filters["m_area"]).replace("\'", "\'\'")\n        where_parts.append(f\'p."m_area" = \\\'{v}\\\'\')\n    if filters.get("m_market"):\n        v = str(filters["m_market"]).replace("\'", "\'\'")\n        where_parts.append(f\'p."m_market" = \\\'{v}\\\'\')\n    if filters.get("construction_gc"):\n        v = str(filters["construction_gc"]).replace("\'", "\'\'")\n        where_parts.append(f\'p."construction_gc" = \\\'{v}\\\'\')\n    if filters.get("construction_gc"):\n        v = str(filters["construction_gc"]).replace("\'", "\'\'")\n        where_parts.append(f\'p."construction_gc" = \\\'{v}\\\'\')\n\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n    SELECT\n      p."rgn_region" AS "rgn_region",\n      p."m_area" AS "m_area",\n      p."m_market" AS "m_market",\n      p."construction_gc" AS "construction_gc",\n      p."construction_gc" AS "construction_gc",\n      COUNT(DISTINCT p."pj_project_id") AS "tool_access_blocked_projects",\n      COUNT(DISTINCT CASE\n        WHEN (p."pj_cr_id" IS NULL OR NULLIF(TRIM(p."pj_cr_id"), \'\') IS NULL)\n          THEN p."pj_project_id"\n      END) AS "cr_missing_projects",\n      COUNT(DISTINCT CASE\n        WHEN (p."pj_cr_id" IS NOT NULL AND NULLIF(TRIM(p."pj_cr_id"), \'\') IS NOT NULL)\n         AND (p."pj_cr_status" IS NULL OR LOWER(TRIM(p."pj_cr_status")) NOT IN ({resolved_list_sql}))\n          THEN p."pj_project_id"\n      END) AS "cr_stuck_projects"\n    FROM pwc_macro_staging_schema."stg_ndpd_mbt_tmobile_macro_combined" p\n    WHERE {where_sql}\n    GROUP BY\n      p."rgn_region", p."m_area", p."m_market", p."construction_gc", p."construction_gc"\n    ORDER BY\n      p."rgn_region", p."m_area", p."m_market", p."construction_gc", p."construction_gc";\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'pj_project_status', 'pj_a_4100_construction_ntp_accepted_by_gc_finish', 'pj_cr_id', 'pj_cr_status', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'construction_gc', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Tool Access Blocked', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'change_request'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'd43ba249-174c-46e6-9ba2-cce0c84cd312', entity_type: 'kpi', kpi_name: 'Tool Access Blocked', name: 'd43ba249-174c-46e6-9ba2-cce0c84cd312', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'construction_gc'], kpi_description: 'Counts active projects that have reached the point where construction has pulled a PO but tool access is blocked because the project’s Change Request is missing or not yet in a resolved state. This KPI is used as an escalation trigger to prevent integration delays by separating cases where a CR was never raised from cases where a CR exists but is stuck in approval/processing, enabling targeted follow-up by market and contractor. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: 'd43ba249-174c-46e6-9ba2-cce0c84cd312'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Vendor Utilization Rate (%) = 100 * (count of distinct entitled projects assigned to a General Contractor that are Work-In-Progress) / (count of distinct Active assigned projects), grouped by construction_gc and geography (region/area/market). A project is considered WIP if ANY of four start/complete milestone pairs indicates started (start field not null) and not completed (complete field null): (ms_1549/ms_1551) OR (ms_1550/ms_1555) OR (pj_a_4250/pj_a_4750) OR (pj_a_4225/pj_a_5175).', kpi_output_schema: '[{"column": "construction_gc", "type": "string", "description": "General Contractor (vendor) name from the project record."}, {"column": "rgn_region", "type": "string", "description": "Region associated with the project/site."}, {"column": "m_area", "type": "string", "description": "Area associated with the project/site."}, {"column": "m_market", "type": "string", "description": "Market associated with the project/site."}, {"column": "active_assigned_projects", "type": "integer", "description": "Count of distinct active projects assigned to the GC in the selected slice."}, {"column": "wip_projects", "type": "integer", "description": "Count of distinct active projects currently in construction WIP (started, not completed)."}, {"column": "vendor_utilization_rate", "type": "float", "description": "wip_projects divided by active_assigned_projects."}]', kpi_business_logic: '1) Filter to rows with non-null pj_project_id, non-empty construction_gc, and pj_a_3710_ran_entitlement_complete_finish IS NOT NULL. 2) Apply optional filters from the allowlist (construction_gc, rgn_region, m_area, m_market, por_category, s_site_id). 3) For each group (construction_gc, rgn_region, m_area, m_market), compute active_assigned_projects = COUNT(DISTINCT pj_project_id). 4) Compute wip_sites = COUNT(DISTINCT pj_project_id) where any of the four WIP start/complete conditions is true. 5) Compute utilization_rate_pct = 100.0 * wip_sites / NULLIF(active_assigned_projects, 0). 6) Return grouped results ordered by utilization_rate_pct desc (nulls last), then wip_sites desc.', kpi_filters: '[{"name": "construction_gc", "type": "string", "description": ""}, {"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "por_category", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": "Optional program filter. Values: \'NTM\', \'AHLOB Modernization\'."}]', kpi_contract: '{"function_name": "get_vendor_utilization_rate", "node_type": "kpi", "node_id": "7768c79b-8ad0-43a5-87f6-88081b7d3296", "node_label": "Vendor Utilization Rate", "description": "Measures how much of each general contractor\\u2019s active assigned project portfolio is currently in work-in-progress (civil or tower). It indicates whether a vendor is capacity-constrained or underutilized, supporting capacity rebalancing and assignment decisions across markets and regions.", "parameters": [{"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}], "output_columns": [{"name": "construction_gc", "type": "string", "nullable": false}, {"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "active_assigned_projects", "type": "number", "nullable": false}, {"name": "wip_sites", "type": "number", "nullable": false}, {"name": "utilization_rate_pct", "type": "string", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Vendor Utilization Rate (%) = 100 * (count of distinct entitled projects assigned to a General Contractor that are Work-In-Progress) / (count of distinct Active assigned projects), grouped by construction_gc and geography (region/area/market). A project is considered WIP if ANY of four start/complete milestone pairs indicates started (start field not null) and not completed (complete field null): (ms_1549/ms_1551) OR (ms_1550/ms_1555) OR (pj_a_4250/pj_a_4750) OR (pj_a_4225/pj_a_5175). Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', node_type: 'CORE', definition: 'Vendor Utilization Rate (%) = 100 * (count of distinct entitled projects assigned to a General Contractor that are Work-In-Progress) / (count of distinct Active assigned projects), grouped by construction_gc and geography (region/area/market). A project is considered WIP if ANY of four start/complete milestone pairs indicates started (start field not null) and not completed (complete field null): (ms_1549/ms_1551) OR (ms_1550/ms_1555) OR (pj_a_4250/pj_a_4750) OR (pj_a_4225/pj_a_5175).', kpi_python_function: 'def get_vendor_utilization_rate(execute_query, filters=None) -> list[dict]:\n    # Vendor Utilization Rate (%) = WIP active assigned projects / active assigned projects * 100\n    # WIP is true if ANY of the 4 construction pathways indicates started but not completed.\n\n    where_parts = [\n        \'"pj_project_id" IS NOT NULL\',\n        \'"construction_gc" IS NOT NULL\',\n        \'TRIM("construction_gc") <> \\\'\\\'\',\n        \'"pj_a_3710_ran_entitlement_complete_finish" IS NOT NULL\'\n    ]\n\n    # Explicit allowlist of supported filters (no date filters; snapshot KPI)\n    if filters:\n        if filters.get(\'construction_gc\'):\n            escaped = str(filters[\'construction_gc\']).replace("\'", "\'\'")\n            where_parts.append(f\'"construction_gc" = \\\'{escaped}\\\'\')\n\n        if filters.get(\'m_market\'):\n            escaped = str(filters[\'m_market\']).replace("\'", "\'\'")\n            where_parts.append(f\'"m_market" = \\\'{escaped}\\\'\')\n\n        if filters.get(\'m_area\'):\n            escaped = str(filters[\'m_area\']).replace("\'", "\'\'")\n            where_parts.append(f\'"m_area" = \\\'{escaped}\\\'\')\n\n        if filters.get(\'rgn_region\'):\n            escaped = str(filters[\'rgn_region\']).replace("\'", "\'\'")\n            where_parts.append(f\'"rgn_region" = \\\'{escaped}\\\'\')\n\n        if filters.get(\'por_category\'):\n            escaped = str(filters[\'por_category\']).replace("\'", "\'\'")\n            where_parts.append(f\'"por_category" = \\\'{escaped}\\\'\')\n\n        if filters.get(\'s_site_id\'):\n            escaped = str(filters[\'s_site_id\']).replace("\'", "\'\'")\n            where_parts.append(f\'"s_site_id" = \\\'{escaped}\\\'\')\n        if filters.get("smp_name"):\n            v = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n            # NTM-specific filters (per Nokia Question Bank)\n            if v.strip().upper() == \'NTM\':\n                where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n                where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n    where_sql = \' WHERE \' + \' AND \'.join(where_parts)\n\n    # NOTE: No CTEs; single-table SQL; explicit column references only.\n    sql = (\n        f"""SELECT   "construction_gc" AS "construction_gc",   "rgn_region" AS "rgn_region",   "m_area" AS "m_area",   "m_market" AS "m_market",   COUNT(DISTINCT "pj_project_id") AS "active_assigned_projects",   COUNT(DISTINCT CASE WHEN (     ("ms_1549_civil_construction_start_actual" IS NOT NULL AND "ms_1551_civil_construction_complete_actual_date" IS NULL)     OR ("ms_1550_construction_start_actual" IS NOT NULL AND "ms_1555_construction_complete_actual" IS NULL)     OR ("pj_a_4250_civil_construction_start_finish" IS NOT NULL AND "pj_a_4750_civil_construction_complete_finish" IS NULL)     OR ("pj_a_4225_construction_start_finish" IS NOT NULL AND "pj_a_5175_construction_complete_finish" IS NULL)   ) THEN "pj_project_id" END) AS "wip_sites",   (100.0 *      COUNT(DISTINCT CASE WHEN (        ("ms_1549_civil_construction_start_actual" IS NOT NULL AND "ms_1551_civil_construction_complete_actual_date" IS NULL)        OR ("ms_1550_construction_start_actual" IS NOT NULL AND "ms_1555_construction_complete_actual" IS NULL)        OR ("pj_a_4250_civil_construction_start_finish" IS NOT NULL AND "pj_a_4750_civil_construction_complete_finish" IS NULL)        OR ("pj_a_4225_construction_start_finish" IS NOT NULL AND "pj_a_5175_construction_complete_finish" IS NULL)      ) THEN "pj_project_id" END)::numeric      / NULLIF(COUNT(DISTINCT "pj_project_id")::numeric, 0)   ) AS "utilization_rate_pct" FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"{where_sql} GROUP BY "construction_gc", "rgn_region", "m_area", "m_market" ORDER BY "utilization_rate_pct" DESC NULLS LAST, "wip_sites" DESC"""\n    )\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'construction_gc', 'pj_project_status', 'rgn_region', 'm_area', 'm_market', 'por_category', 's_site_id', 'ms_1549_civil_construction_start_actual', 'ms_1551_civil_construction_complete_actual_date', 'ms_1550_construction_start_actual', 'ms_1555_construction_complete_actual', 'pj_a_4250_civil_construction_start_finish', 'pj_a_4750_civil_construction_complete_finish', 'pj_a_4225_construction_start_finish', 'pj_a_5175_construction_complete_finish', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Vendor Utilization Rate', kpi_related_core_node_ids: ['general_contractor', 'project'], kpi_relationship_type: 'AGGREGATES', kpi_kpi_id: '7768c79b-8ad0-43a5-87f6-88081b7d3296', entity_type: 'kpi', kpi_name: 'Vendor Utilization Rate', name: '7768c79b-8ad0-43a5-87f6-88081b7d3296', kpi_dimensions: ['construction_gc', 'rgn_region', 'm_area', 'm_market'], kpi_description: 'Measures how much of each general contractor’s active assigned project portfolio is currently in work-in-progress (civil or tower). It indicates whether a vendor is capacity-constrained or underutilized, supporting capacity rebalancing and assignment decisions across markets and regions. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', status: 'mentioned', node_id: '7768c79b-8ad0-43a5-87f6-88081b7d3296'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Snapshot of entitled projects grouped by rgn_region/m_area/m_market/construction_gc/por_category. Computes conditional distinct-project counts: (1) SCOP Pending (NDPD) where ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl is not null AND ms_1559_cop_approved_by_t_mobile_actual is null; (2) SCOP Pending (MB) where pj_a_5500_receive_close_out_binder_finish is not null AND pj_a_5525_approve_close_out_binder_finish is null; (3) Resubmissions where scop_tw_punch_list_re_submitted_to_tmo is not null; (4) First-time-right approved where ms_1559 is not null AND scop_tw_checklist_rejected_by_tmo is null; (5) Total approved where ms_1559 is not null; (6) FTR rate % = 100 * FTR approved / total approved. No pending-only WHERE filter; all metrics are conditional counts over the Active population.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "scop_approval_pending_projects", "type": "integer", "description": "Distinct count of projects with closeout submitted/received but not yet approved by T-Mobile."}, {"column": "first_time_right_pending_projects", "type": "integer", "description": "Distinct count of pending projects flagged as first_time_right (string contains \'Y\')."}, {"column": "not_first_time_right_pending_projects", "type": "integer", "description": "Distinct count of pending projects flagged as not first-time-right (string contains \'N\')."}, {"column": "resubmitted_pending_projects", "type": "integer", "description": "Distinct count of pending projects with a resubmission indicator populated."}, {"column": "avg_punch_checklist_completion_percent_pending", "type": "float", "description": "Average punch_checklist_completion_percent across pending projects (numeric cast)."}]', kpi_business_logic: 'Start from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.\nRestrict population to rows with pj_a_3710_ran_entitlement_complete_finish IS NOT NULL.\nApply optional exact-match filters (allowlist): rgn_region, m_area, m_market, construction_gc, por_category, pj_project_id, s_site_id.\nGroup by rgn_region, m_area, m_market, construction_gc, por_category.\nCompute scop_pending_ndpd as COUNT(DISTINCT pj_project_id) where ms_1557 is not null and ms_1559 is null.\nCompute scop_pending_mb as COUNT(DISTINCT pj_project_id) where pj_a_5500 is not null and pj_a_5525 is null.\nCompute scop_resubmission_count as COUNT(DISTINCT pj_project_id) where scop_tw_punch_list_re_submitted_to_tmo is not null.\nCompute scop_first_time_right_count as COUNT(DISTINCT pj_project_id) where ms_1559 is not null and scop_tw_checklist_rejected_by_tmo is null.\nCompute scop_total_approved_count as COUNT(DISTINCT pj_project_id) where ms_1559 is not null.\nCompute scop_ftr_rate_pct as 100.0 * scop_first_time_right_count / NULLIF(scop_total_approved_count, 0).', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "por_category", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": "Optional program filter. Values: \'NTM\', \'AHLOB Modernization\'."}]', kpi_contract: '{"function_name": "get_scop_approval_pending", "node_type": "kpi", "node_id": "aa4376f5-f790-4cc0-ae24-cabaf23fcd0a", "node_label": "SCOP Approval Pending", "description": "Measures the volume of projects where the closeout package/binder has been submitted or received but is still awaiting T-Mobile approval, and summarizes resubmissions and first-time-right approval performance. This KPI helps identify closeout bottlenecks that delay customer acceptance and downstream payment triggers, and highlights where process or documentation quality is driving rework.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "por_category", "type": "string", "nullable": false}, {"name": "scop_pending_ndpd", "type": "number", "nullable": false}, {"name": "scop_pending_mb", "type": "number", "nullable": false}, {"name": "scop_resubmission_count", "type": "number", "nullable": false}, {"name": "scop_first_time_right_count", "type": "number", "nullable": false}, {"name": "scop_total_approved_count", "type": "number", "nullable": false}, {"name": "scop_ftr_rate_pct", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Snapshot of entitled projects grouped by rgn_region/m_area/m_market/construction_gc/por_category. Computes conditional distinct-project counts: (1) SCOP Pending (NDPD) where ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl is not null AND ms_1559_cop_approved_by_t_mobile_actual is null; (2) SCOP Pending (MB) where pj_a_5500_receive_close_out_binder_finish is not null AND pj_a_5525_approve_close_out_binder_finish is null; (3) Resubmissions where scop_tw_punch_list_re_submitted_to_tmo is not null; (4) First-time-right approved where ms_1559 is not null AND scop_tw_checklist_rejected_by_tmo is null; (5) Total approved where ms_1559 is not null; (6) FTR rate % = 100 * FTR approved / total approved. No pending-only WHERE filter; all metrics are conditional counts over the Active population. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', node_type: 'CORE', definition: 'Snapshot of entitled projects grouped by rgn_region/m_area/m_market/construction_gc/por_category. Computes conditional distinct-project counts: (1) SCOP Pending (NDPD) where ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl is not null AND ms_1559_cop_approved_by_t_mobile_actual is null; (2) SCOP Pending (MB) where pj_a_5500_receive_close_out_binder_finish is not null AND pj_a_5525_approve_close_out_binder_finish is null; (3) Resubmissions where scop_tw_punch_list_re_submitted_to_tmo is not null; (4) First-time-right approved where ms_1559 is not null AND scop_tw_checklist_rejected_by_tmo is null; (5) Total approved where ms_1559 is not null; (6) FTR rate % = 100 * FTR approved / total approved. No pending-only WHERE filter; all metrics are conditional counts over the Active population.', kpi_python_function: 'def get_scop_approval_pending(execute_query, filters=None) -> list[dict]:\n    """SCOP closeout pipeline snapshot metrics grouped by region/area/market/GC/POR."""\n    filters = filters or {}\n\n    # Seed conditions define the snapshot population first\n    where_parts = [\n        \'1=1\',\n        \'"pj_a_3710_ran_entitlement_complete_finish" IS NOT NULL\'\n    ]\n\n    # Explicit allowlist of optional filters (exact match only)\n    rgn_region = None\n    m_area = None\n    m_market = None\n    construction_gc = None\n    por_category = None\n    pj_project_id = None\n    s_site_id = None\n\n    if filters:\n        rgn_region = filters.get(\'rgn_region\')\n        m_area = filters.get(\'m_area\')\n        m_market = filters.get(\'m_market\')\n        construction_gc = filters.get(\'construction_gc\')\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        # NTM-specific filters (per Nokia Question Bank)\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n        por_category = filters.get(\'por_category\')\n        pj_project_id = filters.get(\'pj_project_id\')\n        s_site_id = filters.get(\'s_site_id\')\n\n    def _eq(col: str, val):\n        if val is None or val == \'\':\n            return\n        esc = str(val).replace("\'", "\'\'")\n        where_parts.append(f\'{col} = \\\'{esc}\\\'\')\n\n    _eq(\'"rgn_region"\', rgn_region)\n    _eq(\'"m_area"\', m_area)\n    _eq(\'"m_market"\', m_market)\n    _eq(\'"construction_gc"\', construction_gc)\n    _eq(\'"por_category"\', por_category)\n    _eq(\'"pj_project_id"\', pj_project_id)\n    _eq(\'"s_site_id"\', s_site_id)\n\n    where_clause = \' AND \'.join(where_parts)\n\n    sql = (\n        f\'\'\'SELECT   "rgn_region" AS "rgn_region",  "m_area" AS "m_area",  "m_market" AS "m_market",  "construction_gc" AS "construction_gc",  "por_category" AS "por_category",  COUNT(DISTINCT CASE     WHEN "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl" IS NOT NULL      AND "ms_1559_cop_approved_by_t_mobile_actual" IS NULL     THEN "pj_project_id" END) AS "scop_pending_ndpd",  COUNT(DISTINCT CASE     WHEN "pj_a_5500_receive_close_out_binder_finish" IS NOT NULL      AND "pj_a_5525_approve_close_out_binder_finish" IS NULL     THEN "pj_project_id" END) AS "scop_pending_mb",  COUNT(DISTINCT CASE     WHEN "scop_tw_punch_list_re_submitted_to_tmo" IS NOT NULL     THEN "pj_project_id" END) AS "scop_resubmission_count",  COUNT(DISTINCT CASE     WHEN "ms_1559_cop_approved_by_t_mobile_actual" IS NOT NULL      AND "scop_tw_checklist_rejected_by_tmo" IS NULL     THEN "pj_project_id" END) AS "scop_first_time_right_count",  COUNT(DISTINCT CASE     WHEN "ms_1559_cop_approved_by_t_mobile_actual" IS NOT NULL     THEN "pj_project_id" END) AS "scop_total_approved_count",  100.0 *     COUNT(DISTINCT CASE       WHEN "ms_1559_cop_approved_by_t_mobile_actual" IS NOT NULL        AND "scop_tw_checklist_rejected_by_tmo" IS NULL       THEN "pj_project_id" END)     / NULLIF(COUNT(DISTINCT CASE       WHEN "ms_1559_cop_approved_by_t_mobile_actual" IS NOT NULL       THEN "pj_project_id" END), 0) AS "scop_ftr_rate_pct" FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined" WHERE {where_clause} GROUP BY "rgn_region", "m_area", "m_market", "construction_gc", "por_category" ORDER BY "rgn_region", "m_area", "m_market", "construction_gc", "por_category"\'\'\'\n    )\n\n    return execute_query(sql, db=None, max_rows=None)\n', kpi_source_columns: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 'pj_project_id', 's_site_id', 'pj_project_status', 'ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl', 'ms_1559_cop_approved_by_t_mobile_actual', 'pj_a_5500_receive_close_out_binder_finish', 'pj_a_5525_approve_close_out_binder_finish', 'scop_tw_punch_list_re_submitted_to_tmo', 'scop_tw_checklist_rejected_by_tmo', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'SCOP Approval Pending', kpi_related_core_node_ids: ['closeout_package', 'project'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'aa4376f5-f790-4cc0-ae24-cabaf23fcd0a', entity_type: 'kpi', kpi_name: 'SCOP Approval Pending', name: 'aa4376f5-f790-4cc0-ae24-cabaf23fcd0a', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category'], kpi_description: 'Measures the volume of projects where the closeout package/binder has been submitted or received but is still awaiting T-Mobile approval, and summarizes resubmissions and first-time-right approval performance. This KPI helps identify closeout bottlenecks that delay customer acceptance and downstream payment triggers, and highlights where process or documentation quality is driving rework. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', status: 'mentioned', node_id: 'aa4376f5-f790-4cc0-ae24-cabaf23fcd0a'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'One-sentence formula: KPI = COUNT(DISTINCT pj_project_id) for non-Dead projects where (site walk completed OR Talon drone survey completed) AND scoping package submitted is NULL, with avg/max days since the most recent survey completion timestamp (GREATEST of the two survey completion dates).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Project/site region."}, {"column": "m_area", "type": "string", "description": "Project/site area."}, {"column": "m_market", "type": "string", "description": "Project/site market."}, {"column": "construction_gc", "type": "string", "description": "Assigned general contractor."}, {"column": "por_category", "type": "string", "description": "POR category."}, {"column": "survey_to_scoping_gap_count", "type": "integer", "description": "Distinct active projects with survey complete but scoping package not submitted."}, {"column": "avg_days_since_survey", "type": "float", "description": "Average days elapsed since the most recent survey completion timestamp (max of site-walk vs Talon)."}, {"column": "max_days_since_survey", "type": "float", "description": "Maximum days elapsed since the most recent survey completion timestamp (max of site-walk vs Talon)."}]', kpi_business_logic: '1) Start from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined (one row per project/site). 2) Keep only pj_project_status!=\'Dead\'. 3) Require at least one survey completion timestamp present: ms_1316_pre_con_site_walk_completed_actual OR ms_1321_talon_view_drone_svcs_actual. 4) Require scoping not submitted: ms_1331_scoping_package_submitted_actual IS NULL. 5) Compute survey_to_scoping_gap_count as COUNT(DISTINCT pj_project_id) grouped by rgn_region, m_area, m_market, construction_gc, por_category. 6) For aging, compute days_since_survey per row as EXTRACT(EPOCH FROM (NOW() - GREATEST(ms_1316_pre_con_site_walk_completed_actual, ms_1321_talon_view_drone_svcs_actual)))/86400.0, then aggregate AVG and MAX over the group. 7) Apply optional equality filters (rgn_region, m_area, m_market, construction_gc, por_category, pj_project_id, s_site_id) in the WHERE clause in addition to the core conditions.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Exact-match filter on region."}, {"name": "m_area", "type": "string", "description": "Exact-match filter on area."}, {"name": "m_market", "type": "string", "description": "Exact-match filter on market."}, {"name": "construction_gc", "type": "string", "description": "Exact-match filter on assigned general contractor."}, {"name": "por_category", "type": "string", "description": "Exact-match filter on POR category."}, {"name": "pj_project_id", "type": "string", "description": "Exact-match filter on project id."}, {"name": "s_site_id", "type": "string", "description": "Exact-match filter on site id."}, {"name": "smp_name", "type": "string", "description": "Filter by program name (e.g., NTM, AHLOB Modernization). When NTM, additionally requires smp_status=Active and excludes specific ntm_project_type values."}]', kpi_contract: '{"function_name": "get_survey_to_scoping_gap", "node_type": "kpi", "node_id": "5b7f66f2-fa22-45a9-87f5-178ef86d7501", "node_label": "Survey to Scoping Gap", "description": "Counts active projects/sites where survey is complete (manual site walk or Talon drone) but the scoping package has not yet been submitted, indicating a handoff/capacity bottleneck between survey output and scoping deliverable creation. Includes aging metrics (avg/max days since the most recent survey completion timestamp) to quantify how long sites have been waiting, and supports slicing by region/area/market/GC and POR category for scoping team capacity management and delay remediation.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "por_category", "type": "string", "nullable": false}, {"name": "survey_to_scoping_gap_count", "type": "number", "nullable": false}, {"name": "avg_days_since_survey", "type": "string", "nullable": false}, {"name": "max_days_since_survey", "type": "string", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'One-sentence formula: KPI = COUNT(DISTINCT pj_project_id) for non-Dead projects where (site walk completed OR Talon drone survey completed) AND scoping package submitted is NULL, with avg/max days since the most recent survey completion timestamp (GREATEST of the two survey completion dates).', node_type: 'CORE', definition: 'One-sentence formula: KPI = COUNT(DISTINCT pj_project_id) for non-Dead projects where (site walk completed OR Talon drone survey completed) AND scoping package submitted is NULL, with avg/max days since the most recent survey completion timestamp (GREATEST of the two survey completion dates).', kpi_python_function: 'def get_survey_to_scoping_gap(execute_query, filters=None) -> list[dict]:\n    filters = filters or {}\n    # KPI: Survey to Scoping Gap\n    # Postgres SQL; single-table aggregation from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n\n    where_parts = [\n        \'1=1\',\n        \'"pj_project_status" != \\\'Dead\\\'\',\n        \'(("ms_1316_pre_con_site_walk_completed_actual" IS NOT NULL) OR ("ms_1321_talon_view_drone_svcs_actual" IS NOT NULL))\',\n        \'"ms_1331_scoping_package_submitted_actual" IS NULL\'\n    ]\n\n    if filters:\n        if filters.get(\'rgn_region\') is not None and str(filters.get(\'rgn_region\')) != \'\':\n            v = str(filters[\'rgn_region\']).replace("\'", "\'\'")\n            where_parts.append(f\'"rgn_region" = \\\'{v}\\\'\')\n        if filters.get(\'m_area\') is not None and str(filters.get(\'m_area\')) != \'\':\n            v = str(filters[\'m_area\']).replace("\'", "\'\'")\n            where_parts.append(f\'"m_area" = \\\'{v}\\\'\')\n        if filters.get(\'m_market\') is not None and str(filters.get(\'m_market\')) != \'\':\n            v = str(filters[\'m_market\']).replace("\'", "\'\'")\n            where_parts.append(f\'"m_market" = \\\'{v}\\\'\')\n        if filters.get(\'construction_gc\') is not None and str(filters.get(\'construction_gc\')) != \'\':\n            v = str(filters[\'construction_gc\']).replace("\'", "\'\'")\n            where_parts.append(f\'"construction_gc" = \\\'{v}\\\'\')\n        if filters.get(\'por_category\') is not None and str(filters.get(\'por_category\')) != \'\':\n            v = str(filters[\'por_category\']).replace("\'", "\'\'")\n            where_parts.append(f\'"por_category" = \\\'{v}\\\'\')\n        if filters.get(\'pj_project_id\') is not None and str(filters.get(\'pj_project_id\')) != \'\':\n            v = str(filters[\'pj_project_id\']).replace("\'", "\'\'")\n            where_parts.append(f\'"pj_project_id" = \\\'{v}\\\'\')\n        if filters.get(\'s_site_id\') is not None and str(filters.get(\'s_site_id\')) != \'\':\n            v = str(filters[\'s_site_id\']).replace("\'", "\'\'")\n            where_parts.append(f\'"s_site_id" = \\\'{v}\\\'\')\n\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_clause = \' AND \'.join(where_parts)\n\n    sql = (\n        f\'\'\'SELECT   "rgn_region",   "m_area",   "m_market",   "construction_gc",   "por_category",   COUNT(DISTINCT "pj_project_id") AS "survey_to_scoping_gap_count",   AVG(EXTRACT(EPOCH FROM (NOW() - GREATEST("ms_1316_pre_con_site_walk_completed_actual", "ms_1321_talon_view_drone_svcs_actual"))) / 86400.0) AS "avg_days_since_survey",   MAX(EXTRACT(EPOCH FROM (NOW() - GREATEST("ms_1316_pre_con_site_walk_completed_actual", "ms_1321_talon_view_drone_svcs_actual"))) / 86400.0) AS "max_days_since_survey" FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined" WHERE {where_clause} GROUP BY "rgn_region", "m_area", "m_market", "construction_gc", "por_category" ORDER BY "rgn_region", "m_area", "m_market", "construction_gc", "por_category"\'\'\'\n    )\n\n    return execute_query(sql, db=None, max_rows=None)\n', kpi_source_columns: ['pj_project_id', 'pj_project_status', 'ms_1316_pre_con_site_walk_completed_actual', 'ms_1321_talon_view_drone_svcs_actual', 'ms_1331_scoping_package_submitted_actual', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 's_site_id', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Survey to Scoping Gap', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '5b7f66f2-fa22-45a9-87f5-178ef86d7501', entity_type: 'kpi', kpi_name: 'Survey to Scoping Gap', name: '5b7f66f2-fa22-45a9-87f5-178ef86d7501', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category'], kpi_description: 'Counts active projects/sites where survey is complete (manual site walk or Talon drone) but the scoping package has not yet been submitted, indicating a handoff/capacity bottleneck between survey output and scoping deliverable creation. Includes aging metrics (avg/max days since the most recent survey completion timestamp) to quantify how long sites have been waiting, and supports slicing by region/area/market/GC and POR category for scoping team capacity management and delay remediation. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: '5b7f66f2-fa22-45a9-87f5-178ef86d7501'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'One-sentence formula: Pending Power Installation = grouped counts and aging/cycle-time aggregates on Project/Site rows where permanent power ordered date exists, segmented into pending (ordered not installed AND Active) vs installed (ordered AND installed), with pending aging computed as NOW()-ordered and cycle time as installed_date-ordered_date excluding negatives.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "construction_gc", "type": "string", "description": "Construction general contractor dimension."}, {"column": "por_category", "type": "string", "description": "POR category dimension."}, {"column": "pending_power_count", "type": "integer", "description": "Distinct count of active projects with permanent power ordered but not yet installed."}, {"column": "avg_days_pending", "type": "float", "description": "Average days since power was ordered for pending (active, not installed) projects."}, {"column": "max_days_pending", "type": "float", "description": "Maximum days since power was ordered for pending (active, not installed) projects."}, {"column": "power_installed_count", "type": "integer", "description": "Distinct count of projects where permanent power has both been ordered and installed."}, {"column": "avg_installation_cycle_days", "type": "float", "description": "Average days from power ordered to power installed (installed_date - ordered_date), excluding negative durations."}]', kpi_business_logic: '1) Use stg_ndpd_mbt_tmobile_macro_combined as the single source and group by (rgn_region, m_area, m_market, construction_gc, por_category). 2) pending_power_count: distinct pj_project_id where ordered_finish is not null, installed_finish is null, and pj_a_3710_ran_entitlement_complete_finish IS NOT NULL. 3) avg_days_pending/max_days_pending: for those same pending rows, compute days since ordered as EXTRACT(EPOCH FROM (NOW() - ordered_finish::timestamp))/86400.0, then AVG/MAX. 4) power_installed_count: distinct pj_project_id where ordered_finish and installed_finish are both not null. 5) avg_installation_cycle_days: across rows where both dates exist, compute (installed_finish::date - ordered_finish::date) only when the result is >= 0, then average.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Filter to a specific region (exact match on rgn_region)."}, {"name": "m_area", "type": "string", "description": "Filter to a specific area (exact match on m_area)."}, {"name": "m_market", "type": "string", "description": "Filter to a specific market (exact match on m_market)."}, {"name": "construction_gc", "type": "string", "description": "Filter to a specific construction general contractor (exact match on construction_gc)."}, {"name": "por_category", "type": "string", "description": "Filter to a specific POR category (exact match on por_category)."}, {"name": "pj_project_id", "type": "string", "description": "Filter to a specific project id (exact match on pj_project_id)."}, {"name": "s_site_id", "type": "string", "description": "Filter to a specific site id/code (exact match on s_site_id)."}, {"name": "smp_name", "type": "string", "description": "Filter by program name (e.g., NTM, AHLOB Modernization). When NTM, additionally requires smp_status=Active and excludes specific ntm_project_type values."}]', kpi_contract: '{"function_name": "get_pending_power_installation", "node_type": "kpi", "node_id": "016f1231-f5d4-451e-a5ec-cd79f63511af", "node_label": "Pending Power Installation", "description": "Counts active sites where permanent power has been ordered but not yet installed (a critical prerequisite for tower commissioning/integration). Helps identify utility/power vendor delays and forecast integration start blockers. Also reports pending aging (avg/max days since power was ordered) and, for completed sites, the average power installation cycle time (days from ordered to installed), excluding negative durations.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "por_category", "type": "string", "nullable": false}, {"name": "pending_power_count", "type": "number", "nullable": false}, {"name": "avg_days_pending", "type": "null", "nullable": true}, {"name": "max_days_pending", "type": "null", "nullable": true}, {"name": "power_installed_count", "type": "number", "nullable": false}, {"name": "avg_installation_cycle_days", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'One-sentence formula: Pending Power Installation = grouped counts and aging/cycle-time aggregates on Project/Site rows where permanent power ordered date exists, segmented into pending (ordered not installed AND Active) vs installed (ordered AND installed), with pending aging computed as NOW()-ordered and cycle time as installed_date-ordered_date excluding negatives.', node_type: 'CORE', definition: 'One-sentence formula: Pending Power Installation = grouped counts and aging/cycle-time aggregates on Project/Site rows where permanent power ordered date exists, segmented into pending (ordered not installed AND Active) vs installed (ordered AND installed), with pending aging computed as NOW()-ordered and cycle time as installed_date-ordered_date excluding negatives.', kpi_python_function: 'def get_pending_power_installation(execute_query, filters=None) -> list[dict]:\n    # KPI: Pending Power Installation\n    # Source: pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined (PostgreSQL)\n\n    filters = filters or {}\n\n    where_parts = ["1=1"]\n\n    # Allowlisted filters (exact match)\n    if filters:\n        if filters.get("rgn_region"):\n            v = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"rgn_region\\" = \'{v}\'")\n        if filters.get("m_area"):\n            v = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_area\\" = \'{v}\'")\n        if filters.get("m_market"):\n            v = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_market\\" = \'{v}\'")\n        if filters.get("construction_gc"):\n            v = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"construction_gc\\" = \'{v}\'")\n        if filters.get("por_category"):\n            v = str(filters["por_category"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"por_category\\" = \'{v}\'")\n        if filters.get("pj_project_id"):\n            v = str(filters["pj_project_id"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"pj_project_id\\" = \'{v}\'")\n        if filters.get("s_site_id"):\n            v = str(filters["s_site_id"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"s_site_id\\" = \'{v}\'")\n\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_clause = " AND ".join(where_parts)\n\n    sql = f"""\n    SELECT\n      \\"rgn_region\\",\n      \\"m_area\\",\n      \\"m_market\\",\n      \\"construction_gc\\",\n      \\"por_category\\",\n\n      COUNT(DISTINCT CASE\n        WHEN \\"pj_a_4450_permanent_power_ordered_finish\\" IS NOT NULL\n         AND \\"pj_a_4550_permanent_power_installed_finish\\" IS NULL\n         AND \\"pj_a_3710_ran_entitlement_complete_finish\\" IS NOT NULL\n        THEN \\"pj_project_id\\" END\n      ) AS \\"pending_power_count\\",\n\n      AVG(CASE\n        WHEN \\"pj_a_4450_permanent_power_ordered_finish\\" IS NOT NULL\n         AND \\"pj_a_4550_permanent_power_installed_finish\\" IS NULL\n         AND \\"pj_a_3710_ran_entitlement_complete_finish\\" IS NOT NULL\n        THEN (EXTRACT(EPOCH FROM (NOW() - \\"pj_a_4450_permanent_power_ordered_finish\\"::timestamp)) / 86400.0)\n      END) AS \\"avg_days_pending\\",\n\n      MAX(CASE\n        WHEN \\"pj_a_4450_permanent_power_ordered_finish\\" IS NOT NULL\n         AND \\"pj_a_4550_permanent_power_installed_finish\\" IS NULL\n         AND \\"pj_a_3710_ran_entitlement_complete_finish\\" IS NOT NULL\n        THEN (EXTRACT(EPOCH FROM (NOW() - \\"pj_a_4450_permanent_power_ordered_finish\\"::timestamp)) / 86400.0)\n      END) AS \\"max_days_pending\\",\n\n      COUNT(DISTINCT CASE\n        WHEN \\"pj_a_4450_permanent_power_ordered_finish\\" IS NOT NULL\n         AND \\"pj_a_4550_permanent_power_installed_finish\\" IS NOT NULL\n        THEN \\"pj_project_id\\" END\n      ) AS \\"power_installed_count\\",\n\n      AVG(\n        CASE\n          WHEN \\"pj_a_4450_permanent_power_ordered_finish\\" IS NOT NULL\n           AND \\"pj_a_4550_permanent_power_installed_finish\\" IS NOT NULL\n           AND (\\"pj_a_4550_permanent_power_installed_finish\\"::date - \\"pj_a_4450_permanent_power_ordered_finish\\"::date) >= 0\n          THEN (\\"pj_a_4550_permanent_power_installed_finish\\"::date - \\"pj_a_4450_permanent_power_ordered_finish\\"::date)\n        END\n      ) AS \\"avg_installation_cycle_days\\"\n\n    FROM \\"pwc_macro_staging_schema\\".\\"stg_ndpd_mbt_tmobile_macro_combined\\"\n    WHERE {where_clause}\n    GROUP BY\n      \\"rgn_region\\",\n      \\"m_area\\",\n      \\"m_market\\",\n      \\"construction_gc\\",\n      \\"por_category\\"\n    ORDER BY\n      \\"rgn_region\\",\n      \\"m_area\\",\n      \\"m_market\\",\n      \\"construction_gc\\",\n      \\"por_category\\";\n    """\n\n    return execute_query(sql, db="public")\n', kpi_source_columns: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 'pj_project_id', 's_site_id', 'pj_project_status', 'pj_a_4450_permanent_power_ordered_finish', 'pj_a_4550_permanent_power_installed_finish', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Pending Power Installation', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '016f1231-f5d4-451e-a5ec-cd79f63511af', entity_type: 'kpi', kpi_name: 'Pending Power Installation', name: '016f1231-f5d4-451e-a5ec-cd79f63511af', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category'], kpi_description: 'Counts active sites where permanent power has been ordered but not yet installed (a critical prerequisite for tower commissioning/integration). Helps identify utility/power vendor delays and forecast integration start blockers. Also reports pending aging (avg/max days since power was ordered) and, for completed sites, the average power installation cycle time (days from ordered to installed), excluding negative durations. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: '016f1231-f5d4-451e-a5ec-cd79f63511af'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_hse_site_checklist'], nl_business_rule: '', kpi_formula_description: 'Among completed HSE reviews (LOWER(hse_status)=\'completed\'), One-sentence formula: Stop Work Count = COUNT(DISTINCT site_id) and Stop Work With Notification Count = COUNT(DISTINCT site_id) for rows where level_4_status = \'Not resolved\', with the second count additionally requiring remarks ILIKE \'%Stop Work%\', grouped by gc_name, market, region.', kpi_output_schema: '[{"column": "gc_name", "type": "string", "description": "General contractor name."}, {"column": "market", "type": "string", "description": "Market."}, {"column": "region", "type": "string", "description": "Region."}, {"column": "stop_work_count", "type": "integer", "description": "Count of distinct site_id with level_4_status = \'Not resolved\'."}, {"column": "stop_work_with_notification_count", "type": "integer", "description": "Count of distinct site_id with level_4_status = \'Not resolved\' and remarks containing \'Stop Work\' (case-insensitive)."}]', kpi_business_logic: '1) From stg_ndpd_hse_site_checklist, require LOWER(hse_status) = \'completed\' (only completed reviews). 2) Apply optional filters: gc_name, market, region, site_id, smp_name. 3) stop_work_count = COUNT(DISTINCT site_id) WHERE LOWER(level_4_status) = \'not resolved\'. 4) stop_work_with_notification_count = COUNT(DISTINCT site_id) WHERE LOWER(level_4_status) = \'not resolved\' AND remarks ILIKE \'%Stop Work%\'.', kpi_filters: '[{"name": "gc_name", "type": "string", "description": "Exact-match filter on gc_name."}, {"name": "market", "type": "string", "description": "Exact-match filter on market."}, {"name": "region", "type": "string", "description": "Exact-match filter on region."}, {"name": "site_id", "type": "string", "description": "Exact-match filter on site_id."}, {"name": "smp_name", "type": "string", "description": "Optional program filter."}]', kpi_contract: '{"function_name": "get_stop_work_count", "node_type": "kpi", "node_id": "8c997583-11e3-487f-86d8-52057dc753cc", "node_label": "Stop Work Count", "description": "Counts sites with an unresolved HSE Level-4 stop-work status, and separately counts unresolved sites where the remarks indicate a stop-work notification was sent. Used for executive HSE governance to monitor highest-severity safety escalations that halt field work until resolved, and to track whether stop-work notification communication has been recorded.", "parameters": [{"name": "gc_name", "type": "string", "description": "Filter by gc name", "required": false, "sample_values": []}, {"name": "market", "type": "string", "description": "Filter by market", "required": false, "sample_values": []}, {"name": "region", "type": "string", "description": "Filter by region", "required": false, "sample_values": []}, {"name": "site_id", "type": "string", "description": "Filter by site id", "required": false, "sample_values": []}], "output_columns": [{"name": "gc_name", "type": "string", "nullable": false}, {"name": "market", "type": "string", "nullable": false}, {"name": "region", "type": "null", "nullable": true}, {"name": "stop_work_count", "type": "number", "nullable": false}, {"name": "stop_work_with_notification_count", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'One-sentence formula: Stop Work Count = COUNT(DISTINCT site_id) and Stop Work With Notification Count = COUNT(DISTINCT site_id) for rows where level_4_status = \'Not resolved\', with the second count additionally requiring remarks ILIKE \'%Stop Work%\', grouped by gc_name, market, region. Only evaluates completed HSE reviews (hse_status=completed). Uses case-insensitive matching via LOWER(). Optionally filterable by program via smp_name.', node_type: 'CORE', definition: 'One-sentence formula: Stop Work Count = COUNT(DISTINCT site_id) and Stop Work With Notification Count = COUNT(DISTINCT site_id) for rows where level_4_status = \'Not resolved\', with the second count additionally requiring remarks ILIKE \'%Stop Work%\', grouped by gc_name, market, region.', kpi_python_function: 'def get_stop_work_count(execute_query, filters=None) -> list[dict]:\n    # KPI: Stop Work Count\n    # Source: pwc_macro_staging_schema.stg_ndpd_hse_site_checklist (single-table)\n\n    where_parts = ["1=1", \'LOWER("hse_status") = \\\'completed\\\'\']\n\n    if filters:\n        if filters.get("gc_name") is not None and str(filters.get("gc_name")).strip() != "":\n            val = str(filters["gc_name"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"gc_name\\" = \'{val}\'")\n            if filters.get("smp_name"):\n                v = str(filters["smp_name"]).replace("\'", "\'\'")\n                where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n\n        if filters.get("market") is not None and str(filters.get("market")).strip() != "":\n            val = str(filters["market"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"market\\" = \'{val}\'")\n\n        if filters.get("region") is not None and str(filters.get("region")).strip() != "":\n            val = str(filters["region"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"region\\" = \'{val}\'")\n\n        if filters.get("site_id") is not None and str(filters.get("site_id")).strip() != "":\n            val = str(filters["site_id"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"site_id\\" = \'{val}\'")\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = (\n        f\'\'\'SELECT   "gc_name" AS "gc_name",   "market" AS "market",   "region" AS "region",   COUNT(DISTINCT CASE WHEN LOWER("level_4_status") = \'not resolved\' THEN "site_id" END) AS "stop_work_count",   COUNT(DISTINCT CASE WHEN LOWER("level_4_status") = \'not resolved\'                       AND "remarks" ILIKE \'%Stop Work%\'                  THEN "site_id" END) AS "stop_work_with_notification_count" FROM "pwc_macro_staging_schema"."stg_ndpd_hse_site_checklist" WHERE {where_sql} GROUP BY "gc_name", "market", "region" ORDER BY "gc_name", "market", "region"\'\'\'\n    )\n\n    return execute_query(sql, db="public")\n', kpi_source_columns: ['gc_name', 'market', 'region', 'site_id', 'level_4_status', 'remarks', 'hse_status', 'smp_name'], session_id: '69a3d22f26e208edc083a06e', label: 'Stop Work Count', kpi_related_core_node_ids: ['site', 'general_contractor'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '8c997583-11e3-487f-86d8-52057dc753cc', entity_type: 'kpi', kpi_name: 'Stop Work Count', name: '8c997583-11e3-487f-86d8-52057dc753cc', kpi_dimensions: ['gc_name', 'market', 'region'], kpi_description: 'Counts sites with an unresolved HSE Level-4 stop-work status, and separately counts unresolved sites where the remarks indicate a stop-work notification was sent. Used for executive HSE governance to monitor highest-severity safety escalations that halt field work until resolved, and to track whether stop-work notification communication has been recorded. Only evaluates completed HSE reviews (hse_status=completed). Uses case-insensitive matching via LOWER(). Optionally filterable by program via smp_name.', status: 'mentioned', node_id: '8c997583-11e3-487f-86d8-52057dc753cc'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'One-sentence formula: For entitled projects, group by (rgn_region, m_area, m_market, construction_gc, por_category), count distinct projects by backhaul selection (AAV vs Microwave/MW vs other), then compute AAV% and MW% over total_with_backhaul and compute aav_to_mw_ratio = aav_count/mw_count.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor dimension."}, {"column": "por_category", "type": "string", "description": "POR category dimension."}, {"column": "aav_count", "type": "integer", "description": "Count of distinct active projects whose backhaul selection contains \'AAV\'."}, {"column": "mw_count", "type": "integer", "description": "Count of distinct active projects whose backhaul selection contains \'Microwave\' or \'MW\'."}, {"column": "other_backhaul_count", "type": "integer", "description": "Count of distinct active projects with a non-null backhaul selection that is neither AAV nor Microwave/MW."}, {"column": "total_with_backhaul", "type": "integer", "description": "Count of distinct active projects with a non-null backhaul selection."}, {"column": "aav_pct", "type": "float", "description": "AAV share (%) among active projects with non-null backhaul selection."}, {"column": "mw_pct", "type": "float", "description": "Microwave/MW share (%) among active projects with non-null backhaul selection."}, {"column": "aav_to_mw_ratio", "type": "float", "description": "Ratio of AAV-count to MW-count among active projects (null if mw_count is 0)."}]', kpi_business_logic: '1) Filter to pj_a_3710_ran_entitlement_complete_finish IS NOT NULL plus optional equality filters on rgn_region, m_area, m_market, construction_gc, por_category, pj_project_id, s_site_id.\n2) Within each group (rgn_region, m_area, m_market, construction_gc, por_category), compute:\n   - aav_count = distinct pj_project_id where pj_backhaul_task_selection ILIKE \'%AAV%\'\n   - mw_count = distinct pj_project_id where pj_backhaul_task_selection ILIKE \'%Microwave%\' OR ILIKE \'%MW%\'\n   - other_backhaul_count = distinct pj_project_id where pj_backhaul_task_selection is not null and matches none of the above patterns\n   - total_with_backhaul = distinct pj_project_id where pj_backhaul_task_selection is not null\n3) Compute aav_pct = 100.0 * aav_count / NULLIF(total_with_backhaul,0) and mw_pct similarly.\n4) Compute aav_to_mw_ratio = aav_count::float / NULLIF(mw_count,0).', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Exact match filter on region."}, {"name": "m_area", "type": "string", "description": "Exact match filter on area."}, {"name": "m_market", "type": "string", "description": "Exact match filter on market."}, {"name": "construction_gc", "type": "string", "description": "Exact match filter on general contractor."}, {"name": "por_category", "type": "string", "description": "Exact match filter on POR category."}, {"name": "pj_project_id", "type": "string", "description": "Exact match filter on project id."}, {"name": "s_site_id", "type": "string", "description": "Exact match filter on site id."}, {"name": "smp_name", "type": "string", "description": "Filter by program name (e.g., NTM, AHLOB Modernization). When NTM, additionally requires smp_status=Active and excludes specific ntm_project_type values."}]', kpi_contract: '{"function_name": "get_aav_vs_mw_ratio", "node_type": "kpi", "node_id": "6241f4e8-f4f5-4a72-b293-d8cbf6359528", "node_label": "AAV vs MW Ratio", "description": "Tracks the backhaul technology mix across active sites by counting projects with AAV vs Microwave selections (and other backhaul values), and computing AAV%/MW% and the AAV-to-MW ratio. Used to monitor market shifts away from microwave, forecast AAV vendor capacity needs, and understand vendor/timeline dependencies driven by backhaul choice.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "por_category", "type": "string", "nullable": false}, {"name": "aav_count", "type": "number", "nullable": false}, {"name": "mw_count", "type": "number", "nullable": false}, {"name": "other_backhaul_count", "type": "number", "nullable": false}, {"name": "total_with_backhaul", "type": "number", "nullable": false}, {"name": "aav_pct", "type": "string", "nullable": true}, {"name": "mw_pct", "type": "string", "nullable": true}, {"name": "aav_to_mw_ratio", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'One-sentence formula: For entitled projects, group by (rgn_region, m_area, m_market, construction_gc, por_category), count distinct projects by backhaul selection (AAV vs Microwave/MW vs other), then compute AAV% and MW% over total_with_backhaul and compute aav_to_mw_ratio = aav_count/mw_count.', node_type: 'CORE', definition: 'One-sentence formula: For entitled projects, group by (rgn_region, m_area, m_market, construction_gc, por_category), count distinct projects by backhaul selection (AAV vs Microwave/MW vs other), then compute AAV% and MW% over total_with_backhaul and compute aav_to_mw_ratio = aav_count/mw_count.', kpi_python_function: 'def get_aav_vs_mw_ratio(execute_query, filters=None) -> list[dict]:\n    filters = filters or {}\n    \n    where_parts = [\n        "1=1",\n        "\\"pj_a_3710_ran_entitlement_complete_finish\\" IS NOT NULL"\n    ]\n\n    # Allowlist filters (exact-match equality)\n    if filters:\n        if filters.get("rgn_region") is not None:\n            v = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"rgn_region\\" = \'{v}\'")\n        if filters.get("m_area") is not None:\n            v = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_area\\" = \'{v}\'")\n        if filters.get("m_market") is not None:\n            v = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_market\\" = \'{v}\'")\n        if filters.get("construction_gc") is not None:\n            v = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"construction_gc\\" = \'{v}\'")\n        if filters.get("por_category") is not None:\n            v = str(filters["por_category"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"por_category\\" = \'{v}\'")\n        if filters.get("pj_project_id") is not None:\n            v = str(filters["pj_project_id"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"pj_project_id\\" = \'{v}\'")\n        if filters.get("s_site_id") is not None:\n            v = str(filters["s_site_id"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"s_site_id\\" = \'{v}\'")\n\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = (\n        f\'\'\'SELECT   "rgn_region",   "m_area",   "m_market",   "construction_gc",   "por_category",   COUNT(DISTINCT CASE WHEN "pj_backhaul_task_selection" ILIKE \'%AAV%\' THEN "pj_project_id" END) AS "aav_count",   COUNT(DISTINCT CASE WHEN "pj_backhaul_task_selection" ILIKE \'%Microwave%\' OR "pj_backhaul_task_selection" ILIKE \'%MW%\' THEN "pj_project_id" END) AS "mw_count",   COUNT(DISTINCT CASE WHEN "pj_backhaul_task_selection" IS NOT NULL     AND "pj_backhaul_task_selection" NOT ILIKE \'%AAV%\'     AND "pj_backhaul_task_selection" NOT ILIKE \'%Microwave%\'     AND "pj_backhaul_task_selection" NOT ILIKE \'%MW%\'     THEN "pj_project_id" END) AS "other_backhaul_count",   COUNT(DISTINCT CASE WHEN "pj_backhaul_task_selection" IS NOT NULL THEN "pj_project_id" END) AS "total_with_backhaul",   100.0 *     COUNT(DISTINCT CASE WHEN "pj_backhaul_task_selection" ILIKE \'%AAV%\' THEN "pj_project_id" END)     / NULLIF(COUNT(DISTINCT CASE WHEN "pj_backhaul_task_selection" IS NOT NULL THEN "pj_project_id" END), 0)     AS "aav_pct",   100.0 *     COUNT(DISTINCT CASE WHEN "pj_backhaul_task_selection" ILIKE \'%Microwave%\' OR "pj_backhaul_task_selection" ILIKE \'%MW%\' THEN "pj_project_id" END)     / NULLIF(COUNT(DISTINCT CASE WHEN "pj_backhaul_task_selection" IS NOT NULL THEN "pj_project_id" END), 0)     AS "mw_pct",   (COUNT(DISTINCT CASE WHEN "pj_backhaul_task_selection" ILIKE \'%AAV%\' THEN "pj_project_id" END))::float     / NULLIF(COUNT(DISTINCT CASE WHEN "pj_backhaul_task_selection" ILIKE \'%Microwave%\' OR "pj_backhaul_task_selection" ILIKE \'%MW%\' THEN "pj_project_id" END), 0)     AS "aav_to_mw_ratio" FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined" WHERE {where_sql} GROUP BY "rgn_region", "m_area", "m_market", "construction_gc", "por_category" ORDER BY "rgn_region", "m_area", "m_market", "construction_gc", "por_category"\'\'\'\n    )\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_status', 'pj_backhaul_task_selection', 'pj_project_id', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 's_site_id', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'AAV vs MW Ratio', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '6241f4e8-f4f5-4a72-b293-d8cbf6359528', entity_type: 'kpi', kpi_name: 'AAV vs MW Ratio', name: '6241f4e8-f4f5-4a72-b293-d8cbf6359528', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category'], kpi_description: 'Tracks the backhaul technology mix across active sites by counting projects with AAV vs Microwave selections (and other backhaul values), and computing AAV%/MW% and the AAV-to-MW ratio. Used to monitor market shifts away from microwave, forecast AAV vendor capacity needs, and understand vendor/timeline dependencies driven by backhaul choice. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: '6241f4e8-f4f5-4a72-b293-d8cbf6359528'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'One-sentence formula: Group by region/area/market/GC/PoR category and compute distinct-project counts for ordered/received-but-not-finally-approved (Active only), distinct approved count, plus average (non-negative) days from ordered→approved and received→approved using date differences.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "construction_gc", "type": "string", "description": "Construction general contractor dimension."}, {"column": "por_category", "type": "string", "description": "PoR category dimension."}, {"column": "drawings_ordered_pending_count", "type": "integer", "description": "Distinct active projects with drawings ordered but not finally approved."}, {"column": "drawings_received_pending_count", "type": "integer", "description": "Distinct active projects with drawings received but not finally approved."}, {"column": "drawings_approved_count", "type": "integer", "description": "Distinct projects with final construction drawings approved."}, {"column": "avg_approval_cycle_days", "type": "float", "description": "Average non-negative days from drawings ordered to final approval."}, {"column": "avg_received_to_approved_days", "type": "float", "description": "Average non-negative days from drawings received to final approval."}]', kpi_business_logic: '1) Start from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.\n2) Apply exact-match filters (rgn_region, m_area, m_market, construction_gc, por_category, pj_project_id, s_site_id).\n3) Group by rgn_region, m_area, m_market, construction_gc, por_category.\n4) drawings_ordered_pending_count = COUNT(DISTINCT pj_project_id) for projects with pj_a_2200_construction_drawings_ordered_finish not null AND pj_a_2275_final_construction_drawings_approved_finish null AND pj_project_status!=\'Dead\'.\n5) drawings_received_pending_count = COUNT(DISTINCT pj_project_id) for projects with pj_a_2225_construction_drawings_received_finish not null AND pj_a_2275_final_construction_drawings_approved_finish null AND pj_project_status!=\'Dead\'.\n6) drawings_approved_count = COUNT(DISTINCT pj_project_id) where pj_a_2275_final_construction_drawings_approved_finish is not null.\n7) avg_approval_cycle_days = AVG(approved_date - ordered_date) only when both dates exist and duration >= 0.\n8) avg_received_to_approved_days = AVG(approved_date - received_date) only when both dates exist and duration >= 0.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Exact-match filter on region."}, {"name": "m_area", "type": "string", "description": "Exact-match filter on area."}, {"name": "m_market", "type": "string", "description": "Exact-match filter on market."}, {"name": "construction_gc", "type": "string", "description": "Exact-match filter on construction general contractor."}, {"name": "por_category", "type": "string", "description": "Exact-match filter on PoR category."}, {"name": "pj_project_id", "type": "string", "description": "Exact-match filter on project id."}, {"name": "s_site_id", "type": "string", "description": "Exact-match filter on site id."}, {"name": "smp_name", "type": "string", "description": "Filter by program name (e.g., NTM, AHLOB Modernization). When NTM, additionally requires smp_status=Active and excludes specific ntm_project_type values."}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Optional filter on the construction-start delay code column. When provided, the query adds: pj_construction_start_delay_code IS NOT NULL AND pj_construction_start_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}, {"name": "pj_construction_complete_delay_code", "type": "string", "description": "Optional filter on the construction-complete delay code column. When provided, the query adds: pj_construction_complete_delay_code IS NOT NULL AND pj_construction_complete_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}]', kpi_contract: '{"function_name": "get_construction_drawing_approval", "node_type": "kpi", "node_id": "63b24ac0-e82b-4a1b-b738-9614d4150bd0", "node_label": "Construction Drawing Approval", "description": "Tracks the construction drawing approval pipeline by counting active projects where drawings are ordered or received but not yet finally approved, and computes average drawing approval cycle times. This is a prerequisite gate for construction start and helps identify design/drafting bottlenecks, forecast design-team capacity, and anticipate downstream construction delays by region/market/GC and PoR category.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Filter to projects with a specific construction-start delay code, or any real start delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}, {"name": "pj_construction_complete_delay_code", "type": "string", "description": "Filter to projects with a specific construction-complete delay code, or any real complete delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "por_category", "type": "string", "nullable": false}, {"name": "drawings_ordered_pending_count", "type": "number", "nullable": false}, {"name": "drawings_received_pending_count", "type": "number", "nullable": false}, {"name": "drawings_approved_count", "type": "number", "nullable": false}, {"name": "avg_approval_cycle_days", "type": "null", "nullable": true}, {"name": "avg_received_to_approved_days", "type": "string", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'One-sentence formula: Group by region/area/market/GC/PoR category and compute distinct-project counts for ordered/received-but-not-finally-approved (Active only), distinct approved count, plus average (non-negative) days from ordered→approved and received→approved using date differences.', node_type: 'CORE', definition: 'One-sentence formula: Group by region/area/market/GC/PoR category and compute distinct-project counts for ordered/received-but-not-finally-approved (Active only), distinct approved count, plus average (non-negative) days from ordered→approved and received→approved using date differences.', kpi_python_function: 'def get_construction_drawing_approval(execute_query, filters=None) -> list[dict]:\n    filters = filters or {}\n\n    where_parts = ["1=1"]\n\n    # Allowlisted exact-match filters\n    if filters:\n        if filters.get("rgn_region") is not None and str(filters.get("rgn_region")).strip() != "":\n            v = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"rgn_region\\" = \'{v}\'")\n\n        if filters.get("m_area") is not None and str(filters.get("m_area")).strip() != "":\n            v = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_area\\" = \'{v}\'")\n\n        if filters.get("m_market") is not None and str(filters.get("m_market")).strip() != "":\n            v = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_market\\" = \'{v}\'")\n\n        if filters.get("construction_gc") is not None and str(filters.get("construction_gc")).strip() != "":\n            v = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"construction_gc\\" = \'{v}\'")\n\n        if filters.get("por_category") is not None and str(filters.get("por_category")).strip() != "":\n            v = str(filters["por_category"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"por_category\\" = \'{v}\'")\n\n        if filters.get("pj_project_id") is not None and str(filters.get("pj_project_id")).strip() != "":\n            v = str(filters["pj_project_id"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"pj_project_id\\" = \'{v}\'")\n\n        if filters.get("s_site_id") is not None and str(filters.get("s_site_id")).strip() != "":\n            v = str(filters["s_site_id"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"s_site_id\\" = \'{v}\'")\n\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n\n    # Optional construction delay-code filters (engage when caller wants to narrow to delayed projects)\n\n    for _delay_col in ("pj_construction_start_delay_code", "pj_construction_complete_delay_code"):\n\n        _v = filters.get(_delay_col)\n\n        if _v is None or str(_v).strip() == "":\n\n            continue\n\n        _s = str(_v).strip()\n\n        where_parts.append(f\'"{_delay_col}" IS NOT NULL\')\n\n        where_parts.append(f\'"{_delay_col}" <> \\\'No Delay\\\'\')\n\n        if _s.lower() not in ("any", "true", "yes", "1", "*"):\n\n            _ss = _s.replace("\'", "\'\'")\n\n            where_parts.append(f\'"{_delay_col}" = \\\'{_ss}\\\'\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n        SELECT\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "construction_gc",\n            "por_category",\n\n            COUNT(DISTINCT CASE\n                WHEN "pj_a_2200_construction_drawings_ordered_finish" IS NOT NULL\n                 AND "pj_a_2275_final_construction_drawings_approved_finish" IS NULL\n                 AND "pj_project_status" != \'Dead\'\n                THEN "pj_project_id"\n            END) AS "drawings_ordered_pending_count",\n\n            COUNT(DISTINCT CASE\n                WHEN "pj_a_2225_construction_drawings_received_finish" IS NOT NULL\n                 AND "pj_a_2275_final_construction_drawings_approved_finish" IS NULL\n                 AND "pj_project_status" != \'Dead\'\n                THEN "pj_project_id"\n            END) AS "drawings_received_pending_count",\n\n            COUNT(DISTINCT CASE\n                WHEN "pj_a_2275_final_construction_drawings_approved_finish" IS NOT NULL\n                THEN "pj_project_id"\n            END) AS "drawings_approved_count",\n\n            AVG(CASE\n                WHEN "pj_a_2275_final_construction_drawings_approved_finish" IS NOT NULL\n                 AND "pj_a_2200_construction_drawings_ordered_finish" IS NOT NULL\n                 AND ("pj_a_2275_final_construction_drawings_approved_finish"::date - "pj_a_2200_construction_drawings_ordered_finish"::date) >= 0\n                THEN ("pj_a_2275_final_construction_drawings_approved_finish"::date - "pj_a_2200_construction_drawings_ordered_finish"::date)\n            END) AS "avg_approval_cycle_days",\n\n            AVG(CASE\n                WHEN "pj_a_2275_final_construction_drawings_approved_finish" IS NOT NULL\n                 AND "pj_a_2225_construction_drawings_received_finish" IS NOT NULL\n                 AND ("pj_a_2275_final_construction_drawings_approved_finish"::date - "pj_a_2225_construction_drawings_received_finish"::date) >= 0\n                THEN ("pj_a_2275_final_construction_drawings_approved_finish"::date - "pj_a_2225_construction_drawings_received_finish"::date)\n            END) AS "avg_received_to_approved_days"\n\n        FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n        WHERE {where_sql}\n        GROUP BY\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "construction_gc",\n            "por_category"\n        ORDER BY\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "construction_gc",\n            "por_category";\n    """\n\n    return execute_query(sql)', kpi_source_columns: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 'pj_project_id', 's_site_id', 'pj_project_status', 'pj_a_2200_construction_drawings_ordered_finish', 'pj_a_2225_construction_drawings_received_finish', 'pj_a_2275_final_construction_drawings_approved_finish', 'smp_name', 'smp_status', 'ntm_project_type', 'pj_construction_start_delay_code', 'pj_construction_complete_delay_code'], session_id: '69a3d22f26e208edc083a06e', label: 'Construction Drawing Approval', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '63b24ac0-e82b-4a1b-b738-9614d4150bd0', entity_type: 'kpi', kpi_name: 'Construction Drawing Approval', name: '63b24ac0-e82b-4a1b-b738-9614d4150bd0', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category'], kpi_description: 'Tracks the construction drawing approval pipeline by counting active projects where drawings are ordered or received but not yet finally approved, and computes average drawing approval cycle times. This is a prerequisite gate for construction start and helps identify design/drafting bottlenecks, forecast design-team capacity, and anticipate downstream construction delays by region/market/GC and PoR category. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\'). Optionally filterable by construction delay code: pass pj_construction_start_delay_code or pj_construction_complete_delay_code (any non-empty value engages IS NOT NULL AND <> \'No Delay\'; a specific code value also narrows to that code).', status: 'mentioned', node_id: '63b24ac0-e82b-4a1b-b738-9614d4150bd0'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Civil NTP Acceptance CT = f(Project/Site/Market/General Contractor) computed per (rgn_region, m_area, m_market, construction_gc, por_category) as pending Civil NTP counts and pending/acceptance time deltas using pj_a_4025_* submitted and pj_a_4050_* accepted milestone timestamps.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "construction_gc", "type": "string", "description": "General Contractor dimension."}, {"column": "por_category", "type": "string", "description": "PoR category dimension."}, {"column": "ntp_pending_count", "type": "integer", "description": "Count of distinct non-Dead projects with Civil NTP submitted but not yet accepted by GC."}, {"column": "avg_days_pending", "type": "float", "description": "Average days since Civil NTP submission for pending non-Dead projects."}, {"column": "max_days_pending", "type": "float", "description": "Maximum days since Civil NTP submission for pending non-Dead projects."}, {"column": "ntp_accepted_count", "type": "integer", "description": "Count of distinct projects with both Civil NTP submitted and accepted timestamps populated."}, {"column": "avg_acceptance_cycle_days", "type": "float", "description": "Average (accepted_date - submitted_date) in days for accepted projects, excluding negative durations."}]', kpi_business_logic: '1) Group records by rgn_region, m_area, m_market, construction_gc, por_category.\n2) Pending/WIP definition (Active only): pj_a_4025_civil_ntp_submitted_to_gc_finish IS NOT NULL AND pj_a_4050_civil_ntp_accepted_by_gc_finish IS NULL AND pj_project_status != \'Dead\'.\n3) ntp_pending_count: count distinct pj_project_id that meet pending definition.\n4) avg_days_pending: average over pending rows of (NOW() - submitted_ts) in days, where submitted_ts = pj_a_4025_civil_ntp_submitted_to_gc_finish::timestamp.\n5) max_days_pending: max over pending rows of (NOW() - submitted_ts) in days.\n6) ntp_accepted_count: count distinct pj_project_id where both submitted and accepted timestamps are NOT NULL.\n7) avg_acceptance_cycle_days: average over accepted rows of (accepted_date - submitted_date) in days, excluding negative durations.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Equality filter on rgn_region."}, {"name": "m_area", "type": "string", "description": "Equality filter on m_area."}, {"name": "m_market", "type": "string", "description": "Equality filter on m_market."}, {"name": "construction_gc", "type": "string", "description": "Equality filter on construction_gc (General Contractor)."}, {"name": "por_category", "type": "string", "description": "Equality filter on por_category (PoR category)."}, {"name": "pj_project_id", "type": "string", "description": "Equality filter on pj_project_id."}, {"name": "s_site_id", "type": "string", "description": "Equality filter on s_site_id (site code)."}, {"name": "smp_name", "type": "string", "description": "Filter by program name (e.g., NTM, AHLOB Modernization). When NTM, additionally requires smp_status=Active and excludes specific ntm_project_type values."}]', kpi_contract: '{"function_name": "get_civil_ntp_acceptance_ct", "node_type": "kpi", "node_id": "e928950b-4f04-4016-9c75-c9d82fcb97d7", "node_label": "Civil NTP Acceptance CT", "description": "Measures General Contractor responsiveness to Civil Notice-To-Proceed (NTP) submissions by tracking how long it takes for a GC to accept the Civil NTP after Nokia submits it, plus how many Civil NTPs remain pending. This is a prerequisite for civil construction start; delays indicate vendor bottlenecks and predict downstream civil start slippage. Reported by region/area/market/GC/PoR to support vendor management and forecasting.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "por_category", "type": "string", "nullable": false}, {"name": "ntp_pending_count", "type": "number", "nullable": false}, {"name": "avg_days_pending", "type": "null", "nullable": true}, {"name": "max_days_pending", "type": "null", "nullable": true}, {"name": "ntp_accepted_count", "type": "number", "nullable": false}, {"name": "avg_acceptance_cycle_days", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Civil NTP Acceptance CT = f(Project/Site/Market/General Contractor) computed per (rgn_region, m_area, m_market, construction_gc, por_category) as pending Civil NTP counts and pending/acceptance time deltas using pj_a_4025_* submitted and pj_a_4050_* accepted milestone timestamps.', node_type: 'CORE', definition: 'Civil NTP Acceptance CT = f(Project/Site/Market/General Contractor) computed per (rgn_region, m_area, m_market, construction_gc, por_category) as pending Civil NTP counts and pending/acceptance time deltas using pj_a_4025_* submitted and pj_a_4050_* accepted milestone timestamps.', kpi_python_function: 'def get_civil_ntp_acceptance_ct(execute_query, filters=None) -> list[dict]:\n    filters = filters or {}\n\n    where_parts = ["1=1"]\n\n    # Allowlisted equality filters\n    if filters:\n        if filters.get("rgn_region"):\n            v = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"rgn_region\\" = \'{v}\'")\n        if filters.get("m_area"):\n            v = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_area\\" = \'{v}\'")\n        if filters.get("m_market"):\n            v = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_market\\" = \'{v}\'")\n        if filters.get("construction_gc"):\n            v = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"construction_gc\\" = \'{v}\'")\n        if filters.get("por_category"):\n            v = str(filters["por_category"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"por_category\\" = \'{v}\'")\n        if filters.get("pj_project_id"):\n            v = str(filters["pj_project_id"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"pj_project_id\\" = \'{v}\'")\n        if filters.get("s_site_id"):\n            v = str(filters["s_site_id"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"s_site_id\\" = \'{v}\'")\n\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n    SELECT\n      "rgn_region",\n      "m_area",\n      "m_market",\n      "construction_gc",\n      "por_category",\n\n      COUNT(DISTINCT CASE\n        WHEN "pj_a_4025_civil_ntp_submitted_to_gc_finish" IS NOT NULL\n         AND "pj_a_4050_civil_ntp_accepted_by_gc_finish" IS NULL\n         AND "pj_project_status" != \'Dead\'\n        THEN "pj_project_id" END\n      ) AS "ntp_pending_count",\n\n      AVG(CASE\n        WHEN "pj_a_4025_civil_ntp_submitted_to_gc_finish" IS NOT NULL\n         AND "pj_a_4050_civil_ntp_accepted_by_gc_finish" IS NULL\n         AND "pj_project_status" != \'Dead\'\n        THEN (EXTRACT(EPOCH FROM (NOW() - "pj_a_4025_civil_ntp_submitted_to_gc_finish"::timestamp)) / 86400.0)\n        ELSE NULL END\n      ) AS "avg_days_pending",\n\n      MAX(CASE\n        WHEN "pj_a_4025_civil_ntp_submitted_to_gc_finish" IS NOT NULL\n         AND "pj_a_4050_civil_ntp_accepted_by_gc_finish" IS NULL\n         AND "pj_project_status" != \'Dead\'\n        THEN (EXTRACT(EPOCH FROM (NOW() - "pj_a_4025_civil_ntp_submitted_to_gc_finish"::timestamp)) / 86400.0)\n        ELSE NULL END\n      ) AS "max_days_pending",\n\n      COUNT(DISTINCT CASE\n        WHEN "pj_a_4025_civil_ntp_submitted_to_gc_finish" IS NOT NULL\n         AND "pj_a_4050_civil_ntp_accepted_by_gc_finish" IS NOT NULL\n        THEN "pj_project_id" END\n      ) AS "ntp_accepted_count",\n\n      AVG(CASE\n        WHEN "pj_a_4025_civil_ntp_submitted_to_gc_finish" IS NOT NULL\n         AND "pj_a_4050_civil_ntp_accepted_by_gc_finish" IS NOT NULL\n         AND ("pj_a_4050_civil_ntp_accepted_by_gc_finish"::date - "pj_a_4025_civil_ntp_submitted_to_gc_finish"::date) >= 0\n        THEN ("pj_a_4050_civil_ntp_accepted_by_gc_finish"::date - "pj_a_4025_civil_ntp_submitted_to_gc_finish"::date)\n        ELSE NULL END\n      ) AS "avg_acceptance_cycle_days"\n\n    FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n    WHERE {where_sql}\n    GROUP BY\n      "rgn_region",\n      "m_area",\n      "m_market",\n      "construction_gc",\n      "por_category"\n    ORDER BY\n      "rgn_region",\n      "m_area",\n      "m_market",\n      "construction_gc",\n      "por_category"\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 'pj_project_id', 's_site_id', 'pj_project_status', 'pj_a_4025_civil_ntp_submitted_to_gc_finish', 'pj_a_4050_civil_ntp_accepted_by_gc_finish', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Civil NTP Acceptance CT', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'e928950b-4f04-4016-9c75-c9d82fcb97d7', entity_type: 'kpi', kpi_name: 'Civil NTP Acceptance CT', name: 'e928950b-4f04-4016-9c75-c9d82fcb97d7', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category'], kpi_description: 'Measures General Contractor responsiveness to Civil Notice-To-Proceed (NTP) submissions by tracking how long it takes for a GC to accept the Civil NTP after Nokia submits it, plus how many Civil NTPs remain pending. This is a prerequisite for civil construction start; delays indicate vendor bottlenecks and predict downstream civil start slippage. Reported by region/area/market/GC/PoR to support vendor management and forecasting. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: 'e928950b-4f04-4016-9c75-c9d82fcb97d7'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Grouped by (rgn_region, m_area, m_market, construction_gc): Plan Achievement % = 100 * distinct(pj_project_id with ms_1550_construction_start_actual and ms_1555_construction_complete_actual) / distinct(pj_project_id with ms_1550_construction_start_actual); Avg CX Cycle Days = AVG(ms_1555_construction_complete_actual::date - ms_1550_construction_start_actual::date) where both present; FTR Rate % = 100 * distinct(pj_project_id with ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl present and first_time_right normalized to \'yes\') / distinct(pj_project_id with ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl present); Active Backlog (WIP) = distinct(pj_project_id with ms_1550_construction_start_actual present and ms_1555_construction_complete_actual null); On-Air Pending = distinct(pj_project_id with ms_1555_construction_complete_actual present and pj_completion_objective_actual_date null). Denominator=0 => NULL.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region."}, {"column": "m_area", "type": "string", "description": "Area."}, {"column": "m_market", "type": "string", "description": "Market."}, {"column": "construction_gc", "type": "string", "description": "General contractor."}, {"column": "plan_achievement_pct", "type": "float", "description": "Percent of distinct projects with construction start actual that also have construction complete actual."}, {"column": "avg_cx_cycle_days", "type": "float", "description": "Average days between construction start actual date and construction complete actual date for projects with both dates present."}, {"column": "ftr_rate_pct", "type": "float", "description": "Percent of distinct audited projects that are marked first_time_right=\'Yes\'."}, {"column": "active_backlog_wip", "type": "int", "description": "Count of distinct projects started (construction start actual present) but not completed (construction complete actual null)."}, {"column": "on_air_pending", "type": "int", "description": "Count of distinct projects with construction complete actual present but missing pj_completion_objective_actual_date."}]', kpi_business_logic: '1) Query pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined for the grouping dimensions (rgn_region, m_area, m_market, construction_gc) plus pj_project_id and milestone/date fields ms_1550_construction_start_actual, ms_1555_construction_complete_actual, ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl, pj_completion_objective_actual_date, and first_time_right, applying an explicit allowlist of filters and an optional date range on an allowlisted date_field. WHERE is always seeded with 1=1.\n2) Separately query the same table (same WHERE) to compute cx_cycle_days per pj_project_id as (ms_1555_construction_complete_actual::date - ms_1550_construction_start_actual::date).\n3) Group rows by (rgn_region, m_area, m_market, construction_gc) in Python.\n4) For each group compute distinct-project sets:\n   - Plan denominator: pj_project_id where ms_1550_construction_start_actual is not null.\n   - Plan numerator: pj_project_id where both ms_1550 and ms_1555 are not null.\n   - FTR denominator: pj_project_id where ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl is not null.\n   - FTR numerator: subset of FTR denominator where first_time_right, after str().strip().lower(), equals \'yes\'.\n   - WIP: pj_project_id where ms_1550 not null and ms_1555 is null.\n   - On-air pending: pj_project_id where ms_1555 not null and pj_completion_objective_actual_date is null.\n5) Compute metrics per group:\n   - plan_achievement_pct = 100 * numerator / denominator else NULL if denominator=0.\n   - avg_cx_cycle_days = average of cx_cycle_days for projects with both ms_1550 and ms_1555 else NULL if none.\n   - ftr_rate_pct = 100 * numerator / denominator else NULL if denominator=0.\n   - active_backlog_wip = count of distinct WIP projects.\n   - on_air_pending = count of distinct on-air-pending projects.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Filter to a specific region (exact match)."}, {"name": "m_area", "type": "string", "description": "Filter to a specific area (exact match)."}, {"name": "m_market", "type": "string", "description": "Filter to a specific market (exact match)."}, {"name": "construction_gc", "type": "string", "description": "Filter to a specific general contractor (exact match)."}, {"name": "pj_project_id", "type": "string", "description": "Filter to a specific project id (exact match)."}, {"name": "s_site_id", "type": "string", "description": "Filter to a specific site id (exact match)."}, {"name": "pj_project_status", "type": "string", "description": "Filter to a specific project status (exact match)."}, {"name": "pj_project_type", "type": "string", "description": "Filter to a specific project type (exact match)."}, {"name": "pj_program_name", "type": "string", "description": "Filter to a specific program name (exact match)."}, {"name": "date_field", "type": "string", "description": "Which allowlisted date field to apply the start_date/end_date filter to. One of: ms_1550_construction_start_actual, ms_1555_construction_complete_actual, ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl, pj_completion_objective_actual_date."}, {"name": "start_date", "type": "string", "description": "Inclusive start date (YYYY-MM-DD) applied to date_field (cast via ::date, including for text-stored dates)."}, {"name": "end_date", "type": "string", "description": "Inclusive end date (YYYY-MM-DD) applied to date_field (cast via ::date, including for text-stored dates)."}, {"name": "smp_name", "type": "string", "description": "Optional program filter. Values: \'NTM\', \'AHLOB Modernization\'."}]', kpi_contract: '{"function_name": "get_gc_performance_scorecard", "node_type": "kpi", "node_id": "78408ea3-bf9e-4caa-8516-b7f6d0bf5f68", "node_label": "GC Performance Scorecard", "description": "Composite vendor scorecard to compare General Contractors on delivery, speed, quality, and backlog health for weekly planning and vendor volume allocation.", "parameters": [{"name": "date_field", "type": "date", "description": "Filter by date field", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "plan_achievement_pct", "type": "number", "nullable": true}, {"name": "avg_cx_cycle_days", "type": "number", "nullable": true}, {"name": "ftr_rate_pct", "type": "null", "nullable": true}, {"name": "active_backlog_wip", "type": "number", "nullable": false}, {"name": "on_air_pending", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Grouped by (rgn_region, m_area, m_market, construction_gc): Plan Achievement % = 100 * distinct(pj_project_id with ms_1550_construction_start_actual and ms_1555_construction_complete_actual) / distinct(pj_project_id with ms_1550_construction_start_actual); Avg CX Cycle Days = AVG(ms_1555_construction_complete_actual::date - ms_1550_construction_start_actual::date) where both present; FTR Rate % = 100 * distinct(pj_project_id with ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl present and first_time_right normalized to \'yes\') / distinct(pj_project_id with ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl present); Active Backlog (WIP) = distinct(pj_project_id with ms_1550_construction_start_actual present and ms_1555_construction_complete_actual null); On-Air Pending = distinct(pj_project_id with ms_1555_construction_complete_actual present and pj_completion_objective_actual_date null). Denominator=0 => NULL. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', node_type: 'CORE', definition: 'Grouped by (rgn_region, m_area, m_market, construction_gc): Plan Achievement % = 100 * distinct(pj_project_id with ms_1550_construction_start_actual and ms_1555_construction_complete_actual) / distinct(pj_project_id with ms_1550_construction_start_actual); Avg CX Cycle Days = AVG(ms_1555_construction_complete_actual::date - ms_1550_construction_start_actual::date) where both present; FTR Rate % = 100 * distinct(pj_project_id with ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl present and first_time_right normalized to \'yes\') / distinct(pj_project_id with ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl present); Active Backlog (WIP) = distinct(pj_project_id with ms_1550_construction_start_actual present and ms_1555_construction_complete_actual null); On-Air Pending = distinct(pj_project_id with ms_1555_construction_complete_actual present and pj_completion_objective_actual_date null). Denominator=0 => NULL.', kpi_python_function: 'def get_gc_performance_scorecard(execute_query, filters=None) -> list[dict]:\n    """Composite GC scorecard grouped by (rgn_region, m_area, m_market, construction_gc).\n\n    Measures:\n      1) plan_achievement_pct\n      2) avg_cx_cycle_days\n      3) ftr_rate_pct\n      4) active_backlog_wip\n      5) on_air_pending\n\n    Notes:\n      - NULL-safe denominators: return None when denominator == 0.\n      - Uses raw SQL because required columns (milestone dates, first_time_right)\n        are not exposed by the current accessor return columns.\n      - FTR denominator uses punch checklist reviewed and submitted to T-Mobile milestone\n        (ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl).\n    """\n\n    filters = filters or {}\n\n    def esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    # Explicit allowlist of filterable columns\n    allowed_filters = {\n        \'rgn_region\', \'m_area\', \'m_market\', \'construction_gc\', \'pj_project_id\', \'s_site_id\',\n        \'pj_project_status\', \'pj_project_type\', \'pj_program_name\', \'smp_name\'\n    }\n    # WHERE clause must be seeded with 1=1\n    where_parts = ["1=1"]\n\n    for k in [\n        \'rgn_region\', \'m_area\', \'m_market\', \'construction_gc\', \'pj_project_id\', \'s_site_id\',\n        \'pj_project_status\', \'pj_project_type\', \'pj_program_name\', \'smp_name\'\n    ]:\n        if k in allowed_filters and filters.get(k) is not None:\n            where_parts.append(f"\\"{k}\\" = \'{esc(filters.get(k))}\'")\n\n\n    # NTM-specific filters (per Nokia Question Bank)\n    if filters.get("smp_name") and str(filters["smp_name"]).strip().upper() == \'NTM\':\n        where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n        where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    # Date range filtering (optional). Apply to construction start actual by default.\n    # If you need alternate behavior (e.g., filter by completion date), pass filters[\'date_field\'].\n    allowed_date_fields = {\n        \'ms_1550_construction_start_actual\',\n        \'ms_1555_construction_complete_actual\',\n        \'ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl\',\n        \'pj_completion_objective_actual_date\'\n    }\n    date_field = filters.get(\'date_field\') or \'ms_1550_construction_start_actual\'\n    if date_field not in allowed_date_fields:\n        date_field = \'ms_1550_construction_start_actual\'\n\n    if filters.get(\'start_date\'):\n        where_parts.append(f"\\"{date_field}\\"::date >= \'{esc(filters.get(\'start_date\'))}\'::date")\n    if filters.get(\'end_date\'):\n        where_parts.append(f"\\"{date_field}\\"::date <= \'{esc(filters.get(\'end_date\'))}\'::date")\n\n    where_sql = "WHERE " + " AND ".join(where_parts)\n\n    sql = f"""\n        SELECT\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "construction_gc",\n            "pj_project_id",\n            "ms_1550_construction_start_actual",\n            "ms_1555_construction_complete_actual",\n            "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl",\n            "first_time_right",\n            "pj_completion_objective_actual_date"\n        FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n        {where_sql}\n    """\n\n    rows = execute_query(sql)\n\n    # Compute cycle days via SQL (still one table; no joins)\n    sql_cycle = f"""\n        SELECT\n            "pj_project_id",\n            ("ms_1555_construction_complete_actual"::date - "ms_1550_construction_start_actual"::date) AS "cx_cycle_days"\n        FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n        {where_sql}\n    """\n    cycle_rows = execute_query(sql_cycle)\n    cycle_by_project = {r.get(\'pj_project_id\'): r.get(\'cx_cycle_days\') for r in cycle_rows}\n\n    # Group and aggregate in Python\n    groups = {}\n\n    for r in rows:\n        key = (\n            r.get(\'rgn_region\'),\n            r.get(\'m_area\'),\n            r.get(\'m_market\'),\n            r.get(\'construction_gc\')\n        )\n        if key not in groups:\n            groups[key] = {\n                \'rgn_region\': r.get(\'rgn_region\'),\n                \'m_area\': r.get(\'m_area\'),\n                \'m_market\': r.get(\'m_market\'),\n                \'construction_gc\': r.get(\'construction_gc\'),\n                # sets for distinct counts\n                \'_plan_den\': set(),\n                \'_plan_num\': set(),\n                \'_ftr_den\': set(),\n                \'_ftr_num\': set(),\n                \'_wip\': set(),\n                \'_on_air_pending\': set(),\n                # cycle days\n                \'_cycle_sum\': 0.0,\n                \'_cycle_cnt\': 0\n            }\n\n        g = groups[key]\n        pid = r.get(\'pj_project_id\')\n        if not pid:\n            continue\n\n        start_actual = r.get(\'ms_1550_construction_start_actual\')\n        complete_actual = r.get(\'ms_1555_construction_complete_actual\')\n        punch_reviewed_submitted_tm = r.get(\'ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl\')\n        ftr = r.get(\'first_time_right\')\n        completion_objective_actual = r.get(\'pj_completion_objective_actual_date\')\n\n        # (1) Plan Achievement %\n        if start_actual is not None:\n            g[\'_plan_den\'].add(pid)\n            if complete_actual is not None:\n                g[\'_plan_num\'].add(pid)\n\n        # (2) Avg CX Cycle Days\n        if (start_actual is not None) and (complete_actual is not None):\n            cd = cycle_by_project.get(pid)\n            if cd is not None:\n                try:\n                    g[\'_cycle_sum\'] += float(cd)\n                    g[\'_cycle_cnt\'] += 1\n                except Exception:\n                    pass\n\n        # (3) FTR Rate %\n        # Denominator: punch checklist reviewed and submitted to T-Mobile present\n        if punch_reviewed_submitted_tm is not None:\n            g[\'_ftr_den\'].add(pid)\n            if str(ftr).strip().lower() == \'yes\':\n                g[\'_ftr_num\'].add(pid)\n\n        # (4) Active Backlog (WIP)\n        if (start_actual is not None) and (complete_actual is None):\n            g[\'_wip\'].add(pid)\n\n        # (5) On-Air Pending\n        if (complete_actual is not None) and (completion_objective_actual is None):\n            g[\'_on_air_pending\'].add(pid)\n\n    out = []\n    for _, g in groups.items():\n        plan_den = len(g[\'_plan_den\'])\n        plan_num = len(g[\'_plan_num\'])\n        ftr_den = len(g[\'_ftr_den\'])\n        ftr_num = len(g[\'_ftr_num\'])\n\n        plan_pct = (100.0 * plan_num / plan_den) if plan_den > 0 else None\n        ftr_pct = (100.0 * ftr_num / ftr_den) if ftr_den > 0 else None\n        avg_cycle = (g[\'_cycle_sum\'] / g[\'_cycle_cnt\']) if g[\'_cycle_cnt\'] > 0 else None\n\n        out.append({\n            \'rgn_region\': g[\'rgn_region\'],\n            \'m_area\': g[\'m_area\'],\n            \'m_market\': g[\'m_market\'],\n            \'construction_gc\': g[\'construction_gc\'],\n            \'plan_achievement_pct\': plan_pct,\n            \'avg_cx_cycle_days\': avg_cycle,\n            \'ftr_rate_pct\': ftr_pct,\n            \'active_backlog_wip\': len(g[\'_wip\']),\n            \'on_air_pending\': len(g[\'_on_air_pending\'])\n        })\n\n    return out\n', kpi_source_columns: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_project_id', 's_site_id', 'pj_project_status', 'pj_project_type', 'pj_program_name', 'ms_1550_construction_start_actual', 'ms_1555_construction_complete_actual', 'ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl', 'first_time_right', 'pj_completion_objective_actual_date', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'GC Performance Scorecard', kpi_related_core_node_ids: ['project', 'site', 'general_contractor'], kpi_relationship_type: 'AGGREGATES', kpi_kpi_id: '78408ea3-bf9e-4caa-8516-b7f6d0bf5f68', entity_type: 'kpi', kpi_name: 'GC Performance Scorecard', name: '78408ea3-bf9e-4caa-8516-b7f6d0bf5f68', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Composite vendor scorecard to compare General Contractors on delivery, speed, quality, and backlog health for weekly planning and vendor volume allocation. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', status: 'mentioned', node_id: '78408ea3-bf9e-4caa-8516-b7f6d0bf5f68'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Civil Cycle Time (days) per project is computed as COALESCE( (pj_a_4750_civil_construction_complete_finish::date − pj_a_4250_civil_construction_start_finish::date) when both Magenta dates are present, otherwise (ms_1551_civil_construction_complete_actual_date::date − ms_1549_civil_construction_start_actual::date) when both NDPd dates are present ). Projects with neither complete+start pair populated are excluded, and negative durations are excluded. Output aggregates (COUNT, AVG, P50, P90, MAX) grouped by rgn_region, m_area, m_market, construction_gc, and source_system (Magenta vs NDPd), plus optional por_category and/or s_site_class when enabled.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping field."}, {"column": "m_area", "type": "string", "description": "Area grouping field."}, {"column": "m_market", "type": "string", "description": "Market grouping field."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping field."}, {"column": "por_category", "type": "string", "description": "Optional grouping field when enabled."}, {"column": "s_site_class", "type": "string", "description": "Optional grouping field when enabled."}, {"column": "project_count", "type": "int", "description": "Number of projects (rows) included in the group after filters."}, {"column": "avg_civil_cycle_days", "type": "float", "description": "Average civil cycle time in days for the group."}, {"column": "max_civil_cycle_days", "type": "int", "description": "Maximum civil cycle time in days for the group."}]', kpi_business_logic: 'Seed WHERE clause with 1=1, require confirm_split_spo IS NOT NULL.\nInclude a project only if either: (Magenta complete AND Magenta start) are both non-null, OR (NDPd complete AND NDPd start) are both non-null.\nCompute civil_cycle_days using the required COALESCE(CASE Magenta..., CASE NDPd...) expression; this ensures a project uses Magenta dates together or NDPd dates together, never mixed.\nExclude records where the computed civil_cycle_days is negative.\nDerive source_system as \'Magenta\' when the Magenta pair is present, else \'NDPd\' when the NDPd pair is present.\nApply optional date filters (start_date/end_date) to the effective completion date: Magenta complete date when Magenta pair is present, else NDPd complete date.\nApply optional equality filters for rgn_region, m_area, m_market, construction_gc, por_category, s_site_class.\nAggregate by rgn_region, m_area, m_market, construction_gc, source_system (+ optional por_category / s_site_class) and return project_count, avg, p50, p90, max of civil_cycle_days.', kpi_filters: '[{"name": "start_date", "type": "string", "description": ""}, {"name": "end_date", "type": "string", "description": ""}, {"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "por_category", "type": "string", "description": ""}, {"name": "s_site_class", "type": "string", "description": ""}, {"name": "group_by_por_category", "type": "string", "description": ""}, {"name": "group_by_site_class", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": "Optional program filter. Values: \'NTM\', \'AHLOB Modernization\'."}]', kpi_contract: '{"function_name": "get_civil_cycle_time", "node_type": "kpi", "node_id": "b91a6e98-8c3f-4fae-a943-003665793220", "node_label": "Civil Cycle Time", "description": "Measures the civil construction cycle time in calendar days for split-scope/civil-confirmed sites, used to monitor performance against the civil SLA target (<= 21 days). Results are summarized by market and general contractor (and related regional rollups).", "parameters": [{"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}, {"name": "group_by_por_category", "type": "string", "description": "Filter by group by por category", "required": false, "sample_values": []}, {"name": "group_by_site_class", "type": "string", "description": "Filter by group by site class", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "source_system", "type": "string", "nullable": false}, {"name": "project_count", "type": "number", "nullable": false}, {"name": "avg_civil_cycle_days", "type": "string", "nullable": false}, {"name": "max_civil_cycle_days", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Civil Cycle Time (days) per project is computed as COALESCE( (pj_a_4750_civil_construction_complete_finish::date − pj_a_4250_civil_construction_start_finish::date) when both Magenta dates are present, otherwise (ms_1551_civil_construction_complete_actual_date::date − ms_1549_civil_construction_start_actual::date) when both NDPd dates are present ). Projects with neither complete+start pair populated are excluded, and negative durations are excluded. Output aggregates (COUNT, AVG, P50, P90, MAX) grouped by rgn_region, m_area, m_market, construction_gc, and source_system (Magenta vs NDPd), plus optional por_category and/or s_site_class when enabled. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', node_type: 'CORE', definition: 'Civil Cycle Time (days) per project is computed as COALESCE( (pj_a_4750_civil_construction_complete_finish::date − pj_a_4250_civil_construction_start_finish::date) when both Magenta dates are present, otherwise (ms_1551_civil_construction_complete_actual_date::date − ms_1549_civil_construction_start_actual::date) when both NDPd dates are present ). Projects with neither complete+start pair populated are excluded, and negative durations are excluded. Output aggregates (COUNT, AVG, P50, P90, MAX) grouped by rgn_region, m_area, m_market, construction_gc, and source_system (Magenta vs NDPd), plus optional por_category and/or s_site_class when enabled.', kpi_python_function: 'def get_civil_cycle_time(execute_query, filters=None) -> list[dict]:\n    """Civil Cycle Time (calendar days) for split-scope/civil-confirmed sites.\n\n    Computes cycle days per project using Magenta milestones when both Magenta dates\n    are present; otherwise falls back to NDPd milestones when both NDPd dates are present.\n    Never mixes systems within a project.\n\n    Returns one row per grouping with avg/median/p90/max/count of civil cycle days.\n\n    Expected optional filters keys (all optional):\n      - start_date, end_date: applied to the *effective completion date* (Magenta complete when present, else NDPd complete)\n      - rgn_region, m_area, m_market, construction_gc\n      - por_category, s_site_class\n\n    Optional grouping flags:\n      - group_by_por_category (bool)\n      - group_by_site_class (bool)\n\n    Notes:\n      - Uses raw SQL because the needed milestone columns are not exposed by Tier-1 accessors.\n      - Postgres date math: (complete_date::date - start_date::date) yields integer days.\n    """\n\n    filters = filters or {}\n\n    def _esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    # Base WHERE (seeded with 1=1 per platform convention)\n    where_parts = [\n        "1=1",\n        "\\"confirm_split_spo\\" IS NOT NULL",\n        # Inclusion check: require either the full Magenta pair OR the full NDPd pair\n        "(\\n          (\\"pj_a_4750_civil_construction_complete_finish\\" IS NOT NULL AND \\"pj_a_4250_civil_construction_start_finish\\" IS NOT NULL)\\n          OR\\n          (\\"ms_1551_civil_construction_complete_actual_date\\" IS NOT NULL AND \\"ms_1549_civil_construction_start_actual\\" IS NOT NULL)\\n        )",\n        # Non-negative duration rule using the exact COALESCE pattern\n        "(\\n          COALESCE(\\n            CASE WHEN \\"pj_a_4750_civil_construction_complete_finish\\" IS NOT NULL\\n                   AND \\"pj_a_4250_civil_construction_start_finish\\" IS NOT NULL\\n                  THEN \\"pj_a_4750_civil_construction_complete_finish\\"::date - \\"pj_a_4250_civil_construction_start_finish\\"::date\\n            END,\\n            CASE WHEN \\"ms_1551_civil_construction_complete_actual_date\\" IS NOT NULL\\n                   AND \\"ms_1549_civil_construction_start_actual\\" IS NOT NULL\\n                  THEN \\"ms_1551_civil_construction_complete_actual_date\\"::date - \\"ms_1549_civil_construction_start_actual\\"::date\\n            END\\n          )\\n        ) >= 0"\n    ]\n\n    # Date range filter on *effective completion date* (per request)\n    effective_completion_date_expr = """(\n      COALESCE(\n        CASE WHEN \\"pj_a_4750_civil_construction_complete_finish\\" IS NOT NULL\n               AND \\"pj_a_4250_civil_construction_start_finish\\" IS NOT NULL\n             THEN \\"pj_a_4750_civil_construction_complete_finish\\"::date\n        END,\n        CASE WHEN \\"ms_1551_civil_construction_complete_actual_date\\" IS NOT NULL\n               AND \\"ms_1549_civil_construction_start_actual\\" IS NOT NULL\n             THEN \\"ms_1551_civil_construction_complete_actual_date\\"::date\n        END\n      )\n    )""".strip()\n\n    if filters.get("start_date"):\n        where_parts.append(f"{effective_completion_date_expr} >= \'{_esc(filters[\'start_date\'])}\'")\n    if filters.get("end_date"):\n        where_parts.append(f"{effective_completion_date_expr} <= \'{_esc(filters[\'end_date\'])}\'")\n\n    # Allowlisted equality filters only (no generic filter loops)\n    eq_filter_allowlist = [\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "por_category",\n        "s_site_class",\n    ]\n    for k in eq_filter_allowlist:\n        if filters.get(k) is not None and filters.get(k) != "":\n            where_parts.append(f"\\"{k}\\" = \'{_esc(filters[k])}\'")\n\n\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        # NTM-specific filters (per Nokia Question Bank)\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " AND ".join(where_parts)\n\n    # Group-by dimensions (mandatory set + optional)\n    group_dims = ["rgn_region", "m_area", "m_market", "construction_gc", "source_system"]\n    optional_dims = []\n    if filters.get("group_by_por_category"):\n        optional_dims.append("por_category")\n    if filters.get("group_by_site_class"):\n        optional_dims.append("s_site_class")\n\n    group_dims_all = group_dims + optional_dims\n\n    select_dims_sql = ", ".join([f"\\"{d}\\"" for d in group_dims_all]) if group_dims_all else ""\n    group_by_sql = f"GROUP BY {\', \'.join([f\'\\"{d}\\"\' for d in group_dims_all])}" if group_dims_all else ""\n    order_by_sql = f"ORDER BY {\', \'.join([f\'\\"{d}\\"\' for d in group_dims_all])}" if group_dims_all else ""\n\n    select_prefix = (select_dims_sql + ",\\n       ") if select_dims_sql else ""\n\n    sql = f"""\nSELECT\n       {select_prefix}COUNT(*) AS project_count,\n       AVG(\\"civil_cycle_days\\")::numeric(18,2) AS avg_civil_cycle_days,\n       MAX(\\"civil_cycle_days\\") AS max_civil_cycle_days\nFROM (\n  SELECT\n    \\"rgn_region\\",\n    \\"m_area\\",\n    \\"m_market\\",\n    \\"construction_gc\\",\n    \\"por_category\\",\n    \\"s_site_class\\",\n    CASE\n      WHEN \\"pj_a_4750_civil_construction_complete_finish\\" IS NOT NULL\n       AND \\"pj_a_4250_civil_construction_start_finish\\" IS NOT NULL THEN \'Magenta\'\n      WHEN \\"ms_1551_civil_construction_complete_actual_date\\" IS NOT NULL\n       AND \\"ms_1549_civil_construction_start_actual\\" IS NOT NULL THEN \'NDPd\'\n      ELSE NULL\n    END AS \\"source_system\\",\n    COALESCE(\n      CASE WHEN \\"pj_a_4750_civil_construction_complete_finish\\" IS NOT NULL\n            AND \\"pj_a_4250_civil_construction_start_finish\\" IS NOT NULL\n           THEN \\"pj_a_4750_civil_construction_complete_finish\\"::date - \\"pj_a_4250_civil_construction_start_finish\\"::date\n      END,\n      CASE WHEN \\"ms_1551_civil_construction_complete_actual_date\\" IS NOT NULL\n            AND \\"ms_1549_civil_construction_start_actual\\" IS NOT NULL\n           THEN \\"ms_1551_civil_construction_complete_actual_date\\"::date - \\"ms_1549_civil_construction_start_actual\\"::date\n      END\n    ) AS \\"civil_cycle_days\\"\n  FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n  WHERE {where_sql}\n) base\n{group_by_sql}\n{order_by_sql}\n""".strip()\n\n    # Guardrail: platform does not support CTEs\n    if "WITH " in sql.upper():\n        raise ValueError("CTEs (WITH ...) are not supported in execute_query; rewrite using subqueries.")\n\n    return execute_query(sql)\n', kpi_source_columns: ['confirm_split_spo', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 's_site_class', 'pj_a_4250_civil_construction_start_finish', 'pj_a_4750_civil_construction_complete_finish', 'ms_1549_civil_construction_start_actual', 'ms_1551_civil_construction_complete_actual_date', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Civil Cycle Time', kpi_related_core_node_ids: ['project', 'market', 'general_contractor'], kpi_relationship_type: 'AGGREGATES', kpi_kpi_id: 'b91a6e98-8c3f-4fae-a943-003665793220', entity_type: 'kpi', kpi_name: 'Civil Cycle Time', name: 'b91a6e98-8c3f-4fae-a943-003665793220', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'source_system', 'por_category (optional)', 's_site_class (optional)'], kpi_description: 'Measures the civil construction cycle time in calendar days for split-scope/civil-confirmed sites, used to monitor performance against the civil SLA target (<= 21 days). Results are summarized by market and general contractor (and related regional rollups). Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', status: 'mentioned', node_id: 'b91a6e98-8c3f-4fae-a943-003665793220'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Weekly GC Run Rate (sites/week) = COUNT(DISTINCT pj_project_id with effective completion date in the trailing (trailing_weeks * 7)-day window ending on evaluation_date) / trailing_weeks, grouped by rgn_region, m_area, m_market, construction_gc, and source_system. Effective completion date uses Magenta milestone pj_a_5175_construction_complete_finish when available; otherwise falls back to NDPd milestone ms_1555_construction_complete_actual. A project is attributed to exactly one source_system: Magenta when pj_a_5175 is populated, otherwise NDPd when ms_1555 is populated. trailing_weeks is a parameter (default 12).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping dimension."}, {"column": "m_area", "type": "string", "description": "Area grouping dimension."}, {"column": "m_market", "type": "string", "description": "Market grouping dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping dimension."}, {"column": "weekly_gc_run_rate", "type": "float", "description": "Average completed sites per week over the trailing 12-week window (distinct completed projects / 12)."}, {"column": "completed_projects_trailing_12w", "type": "int", "description": "Count of distinct projects completed within the trailing 12-week window."}, {"column": "evaluation_date", "type": "string", "description": "Evaluation date used to define the trailing window (null when default CURRENT_DATE is used)."}]', kpi_business_logic: '1) Determine evaluation_date: use filters.evaluation_date (or as_of_date/date) if provided, else CURRENT_DATE. 2) Determine trailing_weeks from filters.trailing_weeks, default 12; coerce to int; if <=0 or invalid, fall back to 12. 3) Compute trailing_days = trailing_weeks*7. 4) In an inner subquery over pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined, apply all raw-column filters: seed 1=1; require at least one completion column populated (pj_a_5175 or ms_1555); filter by trailing window using COALESCE(pj_a_5175::date, ms_1555::date) against [evaluation_date - trailing_days, evaluation_date + 1 day); apply optional equality filters on rgn_region, m_area, m_market, construction_gc, pj_project_id. 5) In that same inner subquery, compute completion_date via COALESCE(pj_a_5175::date, ms_1555::date) and compute source_system via CASE (Magenta if pj_a_5175 not null else NDPd if ms_1555 not null). 6) In the outer query, optionally filter by source_system (since it is computed). 7) Group by rgn_region, m_area, m_market, construction_gc, source_system. 8) Compute completed_projects_trailing_window = COUNT(DISTINCT pj_project_id). 9) Compute weekly_gc_run_rate = completed_projects_trailing_window / trailing_weeks.', kpi_filters: '[{"name": "evaluation_date", "type": "string", "description": ""}, {"name": "as_of_date", "type": "string", "description": ""}, {"name": "date", "type": "string", "description": ""}, {"name": "trailing_weeks", "type": "string", "description": ""}, {"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "source_system", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": "Optional program filter. Values: \'NTM\', \'AHLOB Modernization\'."}]', kpi_contract: '{"function_name": "get_weekly_gc_run_rate", "node_type": "kpi", "node_id": "72e61595-33fb-4639-b09b-b20643936de0", "node_label": "Weekly GC Run Rate", "description": "Observed weekly throughput (sites/week) per market and general contractor, used as a capacity proxy input to a capacity-vs-demand gap analysis when explicit crew counts are not available.", "parameters": [{"name": "evaluation_date", "type": "date", "description": "Filter by evaluation date", "required": false, "sample_values": []}, {"name": "as_of_date", "type": "date", "description": "Filter by as of date", "required": false, "sample_values": []}, {"name": "date", "type": "date", "description": "Filter by date", "required": false, "sample_values": []}, {"name": "trailing_weeks", "type": "string", "description": "Filter by trailing weeks", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "source_system", "type": "string", "nullable": false}, {"name": "weekly_gc_run_rate", "type": "number", "nullable": false}, {"name": "completed_projects_trailing_window", "type": "number", "nullable": false}, {"name": "evaluation_date", "type": "null", "nullable": true}, {"name": "trailing_weeks", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Weekly GC Run Rate (sites/week) = COUNT(DISTINCT pj_project_id with effective completion date in the trailing (trailing_weeks * 7)-day window ending on evaluation_date) / trailing_weeks, grouped by rgn_region, m_area, m_market, construction_gc, and source_system. Effective completion date uses Magenta milestone pj_a_5175_construction_complete_finish when available; otherwise falls back to NDPd milestone ms_1555_construction_complete_actual. A project is attributed to exactly one source_system: Magenta when pj_a_5175 is populated, otherwise NDPd when ms_1555 is populated. trailing_weeks is a parameter (default 12). Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', node_type: 'CORE', definition: 'Weekly GC Run Rate (sites/week) = COUNT(DISTINCT pj_project_id with effective completion date in the trailing (trailing_weeks * 7)-day window ending on evaluation_date) / trailing_weeks, grouped by rgn_region, m_area, m_market, construction_gc, and source_system. Effective completion date uses Magenta milestone pj_a_5175_construction_complete_finish when available; otherwise falls back to NDPd milestone ms_1555_construction_complete_actual. A project is attributed to exactly one source_system: Magenta when pj_a_5175 is populated, otherwise NDPd when ms_1555 is populated. trailing_weeks is a parameter (default 12).', kpi_python_function: 'def get_weekly_gc_run_rate(execute_query, filters=None) -> list[dict]:\n    """Weekly GC Run Rate (sites/week) per (rgn_region, m_area, m_market, construction_gc, source_system).\n\n    Definition:\n      weekly_gc_run_rate = COUNT(DISTINCT pj_project_id completed in trailing window) / trailing_weeks\n\n    Completion date (Magenta-preferred / NDPd-fallback):\n      completion_date = COALESCE(\n        "pj_a_5175_construction_complete_finish"::date,\n        "ms_1555_construction_complete_actual"::date\n      )\n\n    Source system assignment (mutually exclusive per project):\n      - \'Magenta\' if pj_a_5175_construction_complete_finish is populated\n      - else \'NDPd\' if ms_1555_construction_complete_actual is populated\n\n    Trailing window (relative to evaluation_date):\n      completion_date >= (evaluation_date - trailing_weeks*7 days)\n      AND completion_date < (evaluation_date + 1 day)\n\n    Filters (optional):\n      - evaluation_date (YYYY-MM-DD). If not provided, uses CURRENT_DATE.\n      - trailing_weeks (int). If not provided, defaults to 12.\n      - rgn_region, m_area, m_market, construction_gc, pj_project_id, source_system\n\n    Returns list[dict] grouped by region/area/market/gc/source_system.\n    """\n\n    filters = filters or {}\n\n    # evaluation_date\n    eval_date = filters.get("evaluation_date") or filters.get("as_of_date") or filters.get("date")\n    if eval_date is None:\n        eval_date_sql = "CURRENT_DATE"\n        eval_date_out = None\n    else:\n        eval_date_escaped = str(eval_date).replace("\'", "\'\'")\n        eval_date_sql = f"DATE \'{eval_date_escaped}\'"\n        eval_date_out = str(eval_date)\n\n    # trailing_weeks parameter (default 12)\n    trailing_weeks_raw = filters.get("trailing_weeks", 12)\n    try:\n        trailing_weeks = int(trailing_weeks_raw)\n    except Exception:\n        trailing_weeks = 12\n\n    if trailing_weeks <= 0:\n        trailing_weeks = 12\n\n    trailing_days = trailing_weeks * 7\n\n    # Build INNER where clause (raw columns live here)\n    inner_where_parts = [\n        "1=1",\n        \'("pj_a_5175_construction_complete_finish" IS NOT NULL OR "ms_1555_construction_complete_actual" IS NOT NULL)\',\n        f"(COALESCE(\\"pj_a_5175_construction_complete_finish\\"::date, \\"ms_1555_construction_complete_actual\\"::date) >= ({eval_date_sql} - {trailing_days}))",\n        f"(COALESCE(\\"pj_a_5175_construction_complete_finish\\"::date, \\"ms_1555_construction_complete_actual\\"::date) < ({eval_date_sql} + 1))",\n    ]\n\n    # Allowlisted equality filters (raw columns)\n    allowed_inner_dim_filters = {\n        "rgn_region": \'"rgn_region"\',\n        "m_area": \'"m_area"\',\n        "m_market": \'"m_market"\',\n        "construction_gc": \'"construction_gc"\',\n        "pj_project_id": \'"pj_project_id"\',\n        "smp_name": "smp_name",\n    }\n\n    for fk, col in allowed_inner_dim_filters.items():\n        if fk in filters and filters[fk] is not None and str(filters[fk]) != "":\n            v = str(filters[fk]).replace("\'", "\'\'")\n            inner_where_parts.append(f"{col} = \'{v}\'")\n\n    # NTM-specific filters (per Nokia Question Bank)\n    if filters.get(\'smp_name\') and str(filters[\'smp_name\']).strip().upper() == \'NTM\':\n        inner_where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n        inner_where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n\n    inner_where_sql = " AND ".join(inner_where_parts)\n\n    # Build OUTER where clause (computed columns live here)\n    outer_where_sql = ""\n    if "source_system" in filters and filters["source_system"] is not None and str(filters["source_system"]) != "":\n        v = str(filters["source_system"]).replace("\'", "\'\'")\n        outer_where_sql = f"WHERE 1=1 AND base.source_system = \'{v}\'"\n\n    sql = f"""\n        SELECT\n            base."rgn_region" AS rgn_region,\n            base."m_area" AS m_area,\n            base."m_market" AS m_market,\n            base."construction_gc" AS construction_gc,\n            base.source_system AS source_system,\n            (COUNT(DISTINCT base."pj_project_id")::numeric / NULLIF({trailing_weeks}::numeric, 0)) AS weekly_gc_run_rate,\n            COUNT(DISTINCT base."pj_project_id") AS completed_projects_trailing_window\n        FROM (\n            SELECT\n                "pj_project_id",\n                "rgn_region",\n                "m_area",\n                "m_market",\n                "construction_gc",\n                COALESCE(\n                    "pj_a_5175_construction_complete_finish"::date,\n                    "ms_1555_construction_complete_actual"::date\n                ) AS completion_date,\n                CASE\n                    WHEN "pj_a_5175_construction_complete_finish" IS NOT NULL THEN \'Magenta\'\n                    WHEN "ms_1555_construction_complete_actual" IS NOT NULL THEN \'NDPd\'\n                    ELSE NULL\n                END AS source_system\n            FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n            WHERE {inner_where_sql}\n        ) base\n        {outer_where_sql}\n        GROUP BY\n            base."rgn_region",\n            base."m_area",\n            base."m_market",\n            base."construction_gc",\n            base.source_system\n    """.strip()\n\n    rows = execute_query(sql)\n\n    out = []\n    for r in rows or []:\n        out.append({\n            "rgn_region": r.get("rgn_region"),\n            "m_area": r.get("m_area"),\n            "m_market": r.get("m_market"),\n            "construction_gc": r.get("construction_gc"),\n            "source_system": r.get("source_system"),\n            "weekly_gc_run_rate": float(r.get("weekly_gc_run_rate")) if r.get("weekly_gc_run_rate") is not None else None,\n            "completed_projects_trailing_window": int(r.get("completed_projects_trailing_window")) if r.get("completed_projects_trailing_window") is not None else 0,\n            "evaluation_date": eval_date_out,\n            "trailing_weeks": trailing_weeks,\n        })\n\n    return out\n', kpi_source_columns: ['pj_project_id', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_a_5175_construction_complete_finish', 'ms_1555_construction_complete_actual', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Weekly GC Run Rate', kpi_related_core_node_ids: ['project', 'market', 'general_contractor'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '72e61595-33fb-4639-b09b-b20643936de0', entity_type: 'kpi', kpi_name: 'Weekly GC Run Rate', name: '72e61595-33fb-4639-b09b-b20643936de0', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'source_system'], kpi_description: 'Observed weekly throughput (sites/week) per market and general contractor, used as a capacity proxy input to a capacity-vs-demand gap analysis when explicit crew counts are not available. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', status: 'mentioned', node_id: '72e61595-33fb-4639-b09b-b20643936de0'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'CX to On-Air Backlog (as-of evaluation_date, default CURRENT_DATE): per (rgn_region, m_area, m_market, construction_gc) count DISTINCT pj_project_id where construction is complete in EITHER system ("pj_a_5175_construction_complete_finish"::date IS NOT NULL) AND integration is NOT complete in EITHER system ("por_first_completion_objective_actual"::date IS NULL). Aging is computed per project as days_in_backlog = evaluation_date - "pj_a_5175_construction_complete_finish"::date; rows with days_in_backlog < 0 are excluded. Output includes total_cx_complete_not_on_air plus aging aggregates avg_days_in_backlog, max_days_in_backlog. Legacy pending_* columns were removed because they were duplicates of the main count under the simplified definition.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping attribute."}, {"column": "m_area", "type": "string", "description": "Area grouping attribute."}, {"column": "m_market", "type": "string", "description": "Market grouping attribute."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping attribute."}, {"column": "total_cx_complete_not_on_air", "type": "int", "description": "Count of distinct projects with construction complete and not yet On-Air."}, {"column": "pending_integration_start", "type": "int", "description": "Count of distinct backlog projects where integration start/finish milestone is not present."}, {"column": "pending_integration_complete", "type": "int", "description": "Count of distinct backlog projects where integration has started but integration complete milestone is not present."}, {"column": "pending_cop_approval", "type": "int", "description": "Count of distinct backlog projects where integration is complete but COP approval milestone is not present."}, {"column": "pending_other", "type": "int", "description": "Count of distinct backlog projects where COP approval is present but the project is still not On-Air."}]', kpi_business_logic: 'Determine eval_date as CURRENT_DATE unless filters.evaluation_date / filters.as_of_date / filters.date is provided; if provided use DATE \'YYYY-MM-DD\'.\nDefine construction_complete_date = "pj_a_5175_construction_complete_finish"::date.\nInclude a project in the backlog base set if ("pj_a_5175_construction_complete_finish"::date IS NOT NULL) AND ("por_first_completion_objective_actual"::date IS NULL).\nIf start_date provided, require construction_complete_date >= start_date. If end_date provided, require construction_complete_date <= end_date.\nApply allowlisted equality filters (rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id) when provided.\nCompute days_in_backlog = eval_date - construction_complete_date; exclude rows where days_in_backlog < 0.\nGroup by (rgn_region, m_area, m_market, construction_gc) and compute: COUNT(DISTINCT pj_project_id) as total_cx_complete_not_on_air; AVG(days_in_backlog), and MAX(days_in_backlog).', kpi_filters: '[{"name": "evaluation_date", "type": "string", "description": ""}, {"name": "as_of_date", "type": "string", "description": ""}, {"name": "date", "type": "string", "description": ""}, {"name": "start_date", "type": "string", "description": ""}, {"name": "end_date", "type": "string", "description": ""}, {"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": "Optional program filter. Values: \'NTM\', \'AHLOB Modernization\'."}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Optional filter on the construction-start delay code column. When provided, the query adds: pj_construction_start_delay_code IS NOT NULL AND pj_construction_start_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}, {"name": "pj_construction_complete_delay_code", "type": "string", "description": "Optional filter on the construction-complete delay code column. When provided, the query adds: pj_construction_complete_delay_code IS NOT NULL AND pj_construction_complete_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}, {"name": "pj_on_air_delay_code", "type": "string", "description": "Optional filter on the on-air delay code column. When provided, the query adds: pj_on_air_delay_code IS NOT NULL AND pj_on_air_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}]', kpi_contract: '{"function_name": "get_cx_to_on_air_backlog", "node_type": "kpi", "node_id": "a9310885-be13-4778-bc99-7ead870d99ee", "node_label": "CX to On-Air Backlog", "description": "Counts projects where construction is complete but the site is not yet On-Air as of a current-state (CURRENT_DATE) snapshot. The KPI also breaks this backlog into blocker-stage buckets to show where projects are stuck in the process.", "parameters": [{"name": "evaluation_date", "type": "date", "description": "Filter by evaluation date", "required": false, "sample_values": []}, {"name": "as_of_date", "type": "date", "description": "Filter by as of date", "required": false, "sample_values": []}, {"name": "date", "type": "date", "description": "Filter by date", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Filter to projects with a specific construction-start delay code, or any real start delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}, {"name": "pj_construction_complete_delay_code", "type": "string", "description": "Filter to projects with a specific construction-complete delay code, or any real complete delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}, {"name": "pj_on_air_delay_code", "type": "string", "description": "Filter to projects with a specific on-air delay code, or any real on-air delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Vendor Delay", "Customer Delay"]}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "total_cx_complete_not_on_air", "type": "number", "nullable": false}, {"name": "avg_days_in_backlog", "type": "number", "nullable": false}, {"name": "max_days_in_backlog", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'CX to On-Air Backlog (as-of evaluation_date, default CURRENT_DATE): per (rgn_region, m_area, m_market, construction_gc) count DISTINCT pj_project_id where construction is complete in EITHER system ("pj_a_5175_construction_complete_finish"::date IS NOT NULL) AND integration is NOT complete in EITHER system ("por_first_completion_objective_actual"::date IS NULL). Aging is computed per project as days_in_backlog = evaluation_date - "pj_a_5175_construction_complete_finish"::date; rows with days_in_backlog < 0 are excluded. Output includes total_cx_complete_not_on_air plus aging aggregates avg_days_in_backlog, max_days_in_backlog. Legacy pending_* columns were removed because they were duplicates of the main count under the simplified definition. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', node_type: 'CORE', definition: 'CX to On-Air Backlog (as-of evaluation_date, default CURRENT_DATE): per (rgn_region, m_area, m_market, construction_gc) count DISTINCT pj_project_id where construction is complete in EITHER system ("pj_a_5175_construction_complete_finish"::date IS NOT NULL) AND integration is NOT complete in EITHER system ("por_first_completion_objective_actual"::date IS NULL). Aging is computed per project as days_in_backlog = evaluation_date - "pj_a_5175_construction_complete_finish"::date; rows with days_in_backlog < 0 are excluded. Output includes total_cx_complete_not_on_air plus aging aggregates avg_days_in_backlog, max_days_in_backlog. Legacy pending_* columns were removed because they were duplicates of the main count under the simplified definition.', kpi_python_function: 'def get_cx_to_on_air_backlog(execute_query, filters=None) -> list[dict]:\n    """CX to On-Air Backlog (evaluation-date snapshot).\n\n    A project is in backlog when:\n      - "pj_a_5175_construction_complete_finish" IS NOT NULL (construction complete)\n      - AND "por_first_completion_objective_actual" IS NULL (not yet on-air)\n\n    Aging (days_in_backlog) is computed per project as:\n      eval_date - "pj_a_5175_construction_complete_finish"::date\n\n    Output:\n      rgn_region, m_area, m_market, construction_gc,\n      total_cx_complete_not_on_air,\n      avg_days_in_backlog, p50_days_in_backlog, p90_days_in_backlog, max_days_in_backlog\n\n    Note: Legacy pending_* columns were removed because under the simplified Nokia definition\n    they became duplicates of the main backlog count.\n    """\n\n    filters = filters or {}\n\n    def _sql_str(v):\n        return str(v).replace("\'", "\'\'")\n\n    # Allowlisted equality filters (no generic filter loops)\n    allowed_filters = {\n        "rgn_region": "rgn_region",\n        "m_area": "m_area",\n        "m_market": "m_market",\n        "construction_gc": "construction_gc",\n        "pj_project_id": "pj_project_id",\n        "s_site_id": "s_site_id",\n        "smp_name": "smp_name",\n    }\n\n    # evaluation date parameter handling (Weekly GC Run Rate-style aliases)\n    evaluation_date = (\n        filters.get("evaluation_date")\n        or filters.get("as_of_date")\n        or filters.get("date")\n    )\n    if evaluation_date:\n        eval_date_sql = f"DATE \'{_sql_str(evaluation_date)}\'"\n    else:\n        eval_date_sql = "CURRENT_DATE"\n\n    # Optional date range filters apply to the construction complete date\n    start_date = filters.get("start_date")\n    end_date = filters.get("end_date")\n\n    # Seed WHERE with 1=1, then add defining metric predicates first\n    where_parts = [\n        "1=1",\n        # Backlog inclusion logic (liberal complete, strict not-complete)\n        "\\"pj_a_5175_construction_complete_finish\\"::date IS NOT NULL",\n        "\\"por_first_completion_objective_actual\\"::date IS NULL",\n    ]\n\n    # Date range filters (construction completion date window)\n    if start_date:\n        sd = _sql_str(start_date)\n        where_parts.append(\n            f"\\"pj_a_5175_construction_complete_finish\\"::date >= DATE \'{sd}\'"\n        )\n    if end_date:\n        ed = _sql_str(end_date)\n        where_parts.append(\n            f"\\"pj_a_5175_construction_complete_finish\\"::date <= DATE \'{ed}\'"\n        )\n\n    # Equality filters\n    for k, col in allowed_filters.items():\n        if k in filters and filters[k] is not None and filters[k] != "":\n            where_parts.append(f"\\"{col}\\" = \'{_sql_str(filters[k])}\'")\n\n    # NTM-specific filters (per Nokia Question Bank)\n    if filters.get(\'smp_name\') and str(filters[\'smp_name\']).strip().upper() == \'NTM\':\n        where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n        where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n\n\n    # Optional construction/on-air delay-code filters (engage when caller wants to narrow to delayed projects)\n\n\n    for _delay_col in ("pj_construction_start_delay_code", "pj_construction_complete_delay_code", "pj_on_air_delay_code"):\n\n\n        _v = filters.get(_delay_col)\n\n\n        if _v is None or str(_v).strip() == "":\n\n\n            continue\n\n\n        _s = str(_v).strip()\n\n\n        where_parts.append(f\'"{_delay_col}" IS NOT NULL\')\n\n\n        where_parts.append(f\'"{_delay_col}" <> \\\'No Delay\\\'\')\n\n\n        if _s.lower() not in ("any", "true", "yes", "1", "*"):\n\n\n            _ss = _s.replace("\'", "\'\'")\n\n\n            where_parts.append(f\'"{_delay_col}" = \\\'{_ss}\\\'\')\n\n\n    where_sql = "WHERE " + " AND ".join(where_parts)\n\n    sql = f"""\n    SELECT\n      base.\\"rgn_region\\" AS rgn_region,\n      base.\\"m_area\\" AS m_area,\n      base.\\"m_market\\" AS m_market,\n      base.\\"construction_gc\\" AS construction_gc,\n\n      COUNT(DISTINCT base.\\"pj_project_id\\") AS total_cx_complete_not_on_air,\n\n      AVG(base.days_in_backlog)::float AS avg_days_in_backlog,\n      MAX(base.days_in_backlog) AS max_days_in_backlog\n\n    FROM (\n      SELECT\n        \\"rgn_region\\",\n        \\"m_area\\",\n        \\"m_market\\",\n        \\"construction_gc\\",\n        \\"pj_project_id\\",\n        (\n          {eval_date_sql}\n          - \\"pj_a_5175_construction_complete_finish\\"::date\n        ) AS days_in_backlog\n      FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n      {where_sql}\n    ) base\n    WHERE base.days_in_backlog >= 0\n    GROUP BY base.\\"rgn_region\\", base.\\"m_area\\", base.\\"m_market\\", base.\\"construction_gc\\"\n    ORDER BY base.\\"rgn_region\\", base.\\"m_area\\", base.\\"m_market\\", base.\\"construction_gc\\"\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_project_id', 's_site_id', 'pj_a_5175_construction_complete_finish', 'smp_name', 'smp_status', 'ntm_project_type', 'por_first_completion_objective_actual', 'pj_construction_start_delay_code', 'pj_construction_complete_delay_code', 'pj_on_air_delay_code'], session_id: '69a3d22f26e208edc083a06e', label: 'CX to On-Air Backlog', kpi_related_core_node_ids: ['project'], kpi_relationship_type: 'AGGREGATES', kpi_kpi_id: 'a9310885-be13-4778-bc99-7ead870d99ee', entity_type: 'kpi', kpi_name: 'CX to On-Air Backlog', name: 'a9310885-be13-4778-bc99-7ead870d99ee', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Counts projects where construction is complete but the site is not yet On-Air as of a current-state (CURRENT_DATE) snapshot. The KPI also breaks this backlog into blocker-stage buckets to show where projects are stuck in the process. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB). Optionally filterable by construction delay code: pass pj_construction_start_delay_code or pj_construction_complete_delay_code (any non-empty value engages IS NOT NULL AND <> \'No Delay\'; a specific code value also narrows to that code). Also filterable by on-air delay code (pj_on_air_delay_code) — any non-empty value engages IS NOT NULL AND <> \'No Delay\'; a specific code value also narrows to that code.', status: 'mentioned', node_id: 'a9310885-be13-4778-bc99-7ead870d99ee'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Measures Nokia\'s scoping package round-trip with T-Mobile. Cycle Time = approval date (ms_1333) − submission date (ms_1331), reported as avg/p50/p90/max in calendar days. Quality dimension reports submitted_count, approved_count, pending_approval_count, and approval_rate_pct (= 100 × approved / submitted). All counts are distinct projects. The base row set is restricted to rows where at least one of ms_1331 or ms_1333 is non-null. Date range filters anchor on submission date (ms_1331::date) so packages still pending approval are not silently excluded. Replaces an earlier implementation that incorrectly used pre-NTP and pre-construction package validation milestones (ms_1310, ms_1323, ms_1327) — those phases have been removed from this KPI.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region for the scorecard row."}, {"column": "m_area", "type": "string", "description": "Area for the scorecard row."}, {"column": "m_market", "type": "string", "description": "Market for the scorecard row."}, {"column": "construction_gc", "type": "string", "description": "General contractor (included when drilling down by contractor)."}, {"column": "avg_pre_ntp_to_scoping_ready_days", "type": "float", "description": "Average days from ms_1310 to ms_1323 for non-negative differences."}, {"column": "avg_scoping_ready_to_validated_days", "type": "float", "description": "Average days from ms_1323 to ms_1327 for non-negative differences."}, {"column": "avg_full_scoping_cycle_days", "type": "float", "description": "Average days from ms_1310 to ms_1327 for non-negative differences."}, {"column": "pending_scoping_count", "type": "int", "description": "Count of distinct active projects with ms_1310 present and ms_1327 missing."}, {"column": "scoping_ftr_pct", "type": "float", "description": "FTR percentage = 100 * (completed with rcm_ftr=\'option1\') / (completed)."}, {"column": "scoping_ftr_numerator_completed_ftr", "type": "int", "description": "Numerator for FTR: count of RCM records with rcm_state=\'completed\' and rcm_ftr=\'option1\'."}, {"column": "scoping_ftr_denominator_completed", "type": "int", "description": "Denominator for FTR: count of RCM records with rcm_state=\'completed\'."}, {"column": "project_count_in_cohort", "type": "int", "description": "Count of distinct projects seen in the macro cohort for the group."}]', kpi_business_logic: 'Query pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.\nSeed WHERE with 1=1.\nApply allowlisted equality filters when provided: rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id.\nRestrict the base row set to rows where ms_1331_scoping_package_submitted_actual IS NOT NULL OR ms_1333_scoping_package_approved_by_customer_actual IS NOT NULL.\nIf start_date/end_date are provided, filter on ms_1331_scoping_package_submitted_actual::date within the specified bounds.\nGroup by rgn_region, m_area, m_market, construction_gc.\nCompute distinct-project counts: submitted_count (ms_1331 not null), approved_count (ms_1333 not null), pending_approval_count (ms_1331 not null and ms_1333 null).\nCompute approval_rate_pct = 100.0 * approved_count / NULLIF(submitted_count, 0).\nFor cycle metrics, compute scoping_cycle_days = ms_1333::date - ms_1331::date and include only rows where both timestamps are present and the day difference is non-negative.\nCompute cycle_project_count as COUNT(DISTINCT pj_project_id) under the cycle-eligible condition; compute avg/p50/p90/max over scoping_cycle_days using conditional expressions so only cycle-eligible values contribute.\nReturn rows ordered by rgn_region, m_area, m_market, construction_gc with the required output column order.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "start_date", "type": "string", "description": ""}, {"name": "end_date", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": "Optional program filter. Values: \'NTM\', \'AHLOB Modernization\'."}]', kpi_contract: '{"function_name": "get_scoping_cycle_time_quality", "node_type": "kpi", "node_id": "9308cdae-49ee-4686-a0f8-c338053aedb5", "node_label": "Scoping Cycle Time & Quality", "description": "Grouped scorecard KPI measuring scoping lifecycle speed, backlog, and first-time-right (FTR) quality. It is used to assess how quickly scoping progresses, how much scoping work is pending, and the quality of completed scoping outcomes.", "parameters": [{"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "submitted_count", "type": "number", "nullable": false}, {"name": "approved_count", "type": "number", "nullable": false}, {"name": "pending_approval_count", "type": "number", "nullable": false}, {"name": "approval_rate_pct", "type": "string", "nullable": true}, {"name": "cycle_project_count", "type": "number", "nullable": false}, {"name": "avg_scoping_cycle_days", "type": "null", "nullable": true}, {"name": "max_scoping_cycle_days", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Measures Nokia\'s scoping package round-trip with T-Mobile. Cycle Time = approval date (ms_1333) − submission date (ms_1331), reported as avg/p50/p90/max in calendar days. Quality dimension reports submitted_count, approved_count, pending_approval_count, and approval_rate_pct (= 100 × approved / submitted). All counts are distinct projects. The base row set is restricted to rows where at least one of ms_1331 or ms_1333 is non-null. Date range filters anchor on submission date (ms_1331::date) so packages still pending approval are not silently excluded. Replaces an earlier implementation that incorrectly used pre-NTP and pre-construction package validation milestones (ms_1310, ms_1323, ms_1327) — those phases have been removed from this KPI. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', node_type: 'CORE', definition: 'Measures Nokia\'s scoping package round-trip with T-Mobile. Cycle Time = approval date (ms_1333) − submission date (ms_1331), reported as avg/p50/p90/max in calendar days. Quality dimension reports submitted_count, approved_count, pending_approval_count, and approval_rate_pct (= 100 × approved / submitted). All counts are distinct projects. The base row set is restricted to rows where at least one of ms_1331 or ms_1333 is non-null. Date range filters anchor on submission date (ms_1331::date) so packages still pending approval are not silently excluded. Replaces an earlier implementation that incorrectly used pre-NTP and pre-construction package validation milestones (ms_1310, ms_1323, ms_1327) — those phases have been removed from this KPI.', kpi_python_function: 'def get_scoping_cycle_time_quality(execute_query, filters=None) -> list[dict]:\n    """Scoping Cycle Time & Quality (Nokia) KPI.\n\n    Measures scoping submission -> customer approval round-trip using:\n      - ms_1331_scoping_package_submitted_actual (submission)\n      - ms_1333_scoping_package_approved_by_customer_actual (approval)\n\n    Grain: (rgn_region, m_area, m_market, construction_gc)\n\n    Allowlisted filters (optional):\n      - rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id (equality)\n      - start_date, end_date (apply to submission date: ms_1331::date)\n\n    Output schema (in order):\n      rgn_region, m_area, m_market, construction_gc,\n      submitted_count, approved_count, pending_approval_count, approval_rate_pct,\n      cycle_project_count, avg_scoping_cycle_days, p50_scoping_cycle_days,\n      p90_scoping_cycle_days, max_scoping_cycle_days\n    """\n\n    filters = filters or {}\n\n    where_parts = ["1=1"]\n\n    def _add_eq(filter_key: str, col_sql: str):\n        v = filters.get(filter_key)\n        if v is None or str(v).strip() == "":\n            return\n        vv = str(v).replace("\'", "\'\'")\n        where_parts.append(f"{col_sql} = \'{vv}\'")\n\n    # allowlisted equality filters\n    _add_eq(\'rgn_region\', \'"rgn_region"\')\n    _add_eq(\'m_area\', \'"m_area"\')\n    _add_eq(\'m_market\', \'"m_market"\')\n    _add_eq(\'smp_name\', \'"smp_name"\')\n    # NTM-specific filters (per Nokia Question Bank)\n    if filters.get(\'smp_name\') and str(filters[\'smp_name\']).strip().upper() == \'NTM\':\n        where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n        where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    _add_eq(\'construction_gc\', \'"construction_gc"\')\n    _add_eq(\'pj_project_id\', \'"pj_project_id"\')\n    _add_eq(\'s_site_id\', \'"s_site_id"\')\n\n    # base restriction: at least one milestone present\n    where_parts.append(\n        "(\\n"\n        "  \\"ms_1331_scoping_package_submitted_actual\\" IS NOT NULL\\n"\n        "  OR \\"ms_1333_scoping_package_approved_by_customer_actual\\" IS NOT NULL\\n"\n        ")"\n    )\n\n    # date filters anchored on submission date\n    start_date = filters.get(\'start_date\')\n    end_date = filters.get(\'end_date\')\n    if start_date is not None and str(start_date).strip() != "":\n        sd = str(start_date).strip().replace("\'", "\'\'")\n        where_parts.append(f"\\"ms_1331_scoping_package_submitted_actual\\"::date >= \'{sd}\'::date")\n    if end_date is not None and str(end_date).strip() != "":\n        ed = str(end_date).strip().replace("\'", "\'\'")\n        where_parts.append(f"\\"ms_1331_scoping_package_submitted_actual\\"::date <= \'{ed}\'::date")\n\n    where_sql = " WHERE " + " AND ".join(where_parts)\n\n    # No CTEs; single-table SQL with SQL-side aggregation\n    sql = (\n        f\'\'\'SELECT   "rgn_region" AS "rgn_region",   "m_area" AS "m_area",   "m_market" AS "m_market",   "construction_gc" AS "construction_gc",   COUNT(DISTINCT CASE WHEN "ms_1331_scoping_package_submitted_actual" IS NOT NULL THEN "pj_project_id" END) AS "submitted_count",   COUNT(DISTINCT CASE WHEN "ms_1333_scoping_package_approved_by_customer_actual" IS NOT NULL THEN "pj_project_id" END) AS "approved_count",   COUNT(DISTINCT CASE WHEN "ms_1331_scoping_package_submitted_actual" IS NOT NULL AND "ms_1333_scoping_package_approved_by_customer_actual" IS NULL THEN "pj_project_id" END) AS "pending_approval_count",   (100.0 *      COUNT(DISTINCT CASE WHEN "ms_1333_scoping_package_approved_by_customer_actual" IS NOT NULL THEN "pj_project_id" END)      / NULLIF(COUNT(DISTINCT CASE WHEN "ms_1331_scoping_package_submitted_actual" IS NOT NULL THEN "pj_project_id" END), 0)   ) AS "approval_rate_pct",   COUNT(DISTINCT CASE WHEN      "ms_1331_scoping_package_submitted_actual" IS NOT NULL      AND "ms_1333_scoping_package_approved_by_customer_actual" IS NOT NULL      AND ("ms_1333_scoping_package_approved_by_customer_actual"::date - "ms_1331_scoping_package_submitted_actual"::date) >= 0     THEN "pj_project_id" END) AS "cycle_project_count",   AVG(CASE WHEN      "ms_1331_scoping_package_submitted_actual" IS NOT NULL      AND "ms_1333_scoping_package_approved_by_customer_actual" IS NOT NULL      AND ("ms_1333_scoping_package_approved_by_customer_actual"::date - "ms_1331_scoping_package_submitted_actual"::date) >= 0     THEN ("ms_1333_scoping_package_approved_by_customer_actual"::date - "ms_1331_scoping_package_submitted_actual"::date) END) AS "avg_scoping_cycle_days",   MAX(CASE WHEN      "ms_1331_scoping_package_submitted_actual" IS NOT NULL      AND "ms_1333_scoping_package_approved_by_customer_actual" IS NOT NULL      AND ("ms_1333_scoping_package_approved_by_customer_actual"::date - "ms_1331_scoping_package_submitted_actual"::date) >= 0     THEN ("ms_1333_scoping_package_approved_by_customer_actual"::date - "ms_1331_scoping_package_submitted_actual"::date) END) AS "max_scoping_cycle_days" FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined {where_sql} GROUP BY "rgn_region", "m_area", "m_market", "construction_gc"  ORDER BY "rgn_region", "m_area", "m_market", "construction_gc"\'\'\'\n    )\n\n    rows = execute_query(sql) or []\n\n    out = []\n    for r in rows:\n        out.append({\n            \'rgn_region\': r.get(\'rgn_region\'),\n            \'m_area\': r.get(\'m_area\'),\n            \'m_market\': r.get(\'m_market\'),\n            \'construction_gc\': r.get(\'construction_gc\'),\n            \'submitted_count\': r.get(\'submitted_count\'),\n            \'approved_count\': r.get(\'approved_count\'),\n            \'pending_approval_count\': r.get(\'pending_approval_count\'),\n            \'approval_rate_pct\': r.get(\'approval_rate_pct\'),\n            \'cycle_project_count\': r.get(\'cycle_project_count\'),\n            \'avg_scoping_cycle_days\': r.get(\'avg_scoping_cycle_days\'),\n            \'p50_scoping_cycle_days\': r.get(\'p50_scoping_cycle_days\'),\n            \'p90_scoping_cycle_days\': r.get(\'p90_scoping_cycle_days\'),\n            \'max_scoping_cycle_days\': r.get(\'max_scoping_cycle_days\')\n        })\n\n    return out\n', kpi_source_columns: ['pj_project_id', 's_site_id', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'ms_1331_scoping_package_submitted_actual', 'ms_1333_scoping_package_approved_by_customer_actual', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Scoping Cycle Time & Quality', kpi_related_core_node_ids: ['project', 'site', 'market', 'general_contractor'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '9308cdae-49ee-4686-a0f8-c338053aedb5', entity_type: 'kpi', kpi_name: 'Scoping Cycle Time & Quality', name: '9308cdae-49ee-4686-a0f8-c338053aedb5', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Grouped scorecard KPI measuring scoping lifecycle speed, backlog, and first-time-right (FTR) quality. It is used to assess how quickly scoping progresses, how much scoping work is pending, and the quality of completed scoping outcomes. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', status: 'mentioned', node_id: '9308cdae-49ee-4686-a0f8-c338053aedb5'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'For active projects, returns market-level counts of distinct projects in WIP for four indicators: (1) civil_wip_ndpd where ms_1549_civil_construction_start_actual is not null AND ms_1551_civil_construction_complete_actual_date is null; (2) tower_wip_ndpd where ms_1550_construction_start_actual is not null AND ms_1555_construction_complete_actual is null; (3) civil_wip_mb where pj_a_4250_civil_construction_start_finish is not null AND pj_a_4750_civil_construction_complete_finish is null; (4) tower_wip_mb where pj_a_4225_construction_start_finish is not null AND pj_a_5175_construction_complete_finish is null. Also computes active_vendor_count as the distinct non-blank construction_gc values among rows where any of the four WIP conditions is true. Results are grouped by rgn_region, m_area, m_market, and por_category (construction_gc is filter-only).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "civil_wip_project_count", "type": "integer", "description": "Distinct active projects currently in Civil WIP."}, {"column": "tower_wip_project_count", "type": "integer", "description": "Distinct active projects currently in Tower WIP."}, {"column": "total_wip_project_count_dedup", "type": "integer", "description": "Distinct active projects in either Civil WIP or Tower WIP (deduplicated across the two signals)."}, {"column": "civil_wip_site_count", "type": "integer", "description": "Distinct sites with at least one active project in Civil WIP."}, {"column": "tower_wip_site_count", "type": "integer", "description": "Distinct sites with at least one active project in Tower WIP."}, {"column": "total_wip_site_count_dedup", "type": "integer", "description": "Distinct sites with any WIP signal (civil or tower), deduplicated."}, {"column": "wip_distinct_gc_count", "type": "integer", "description": "Distinct general contractors (construction_gc) associated with any WIP project/site in the group."}, {"column": "tower_wip_mb", "type": "int", "description": "MB/Magenta tower construction WIP count."}, {"column": "civil_wip_mb", "type": "int", "description": "MB/Magenta civil construction WIP count."}]', kpi_business_logic: '1) Filter rows to entitled projects (pj_a_3710_ran_entitlement_complete_finish IS NOT NULL) with non-null pj_project_id and s_site_id. 2) Apply optional filters: rgn_region, m_area, m_market, construction_gc (filter-only), site_code (mapped to s_site_id), por_category. 3) Group remaining rows by rgn_region, m_area, m_market, por_category. 4) Compute: civil_wip_ndpd = COUNT(DISTINCT pj_project_id) where ms_1549_civil_construction_start_actual is not null and ms_1551_civil_construction_complete_actual_date is null; tower_wip_ndpd = COUNT(DISTINCT pj_project_id) where ms_1550_construction_start_actual is not null and ms_1555_construction_complete_actual is null; civil_wip_mb = COUNT(DISTINCT pj_project_id) where pj_a_4250_civil_construction_start_finish is not null and pj_a_4750_civil_construction_complete_finish is null; tower_wip_mb = COUNT(DISTINCT pj_project_id) where pj_a_4225_construction_start_finish is not null and pj_a_5175_construction_complete_finish is null. 5) active_vendor_count = COUNT(DISTINCT trimmed construction_gc) over rows meeting any WIP condition; blank strings are excluded via NULLIF(BTRIM(construction_gc),\'\').', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "por_category", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "site_code", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": "Optional program filter. Values: \'NTM\', \'AHLOB Modernization\'."}]', kpi_contract: '{"function_name": "get_tower_civil_wip", "node_type": "kpi", "node_id": "0087a40d-da6f-4622-98d5-f3e9b02c81df", "node_label": "Tower & Civil WIP", "description": "Counts distinct projects/sites with active work-in-progress in civil and tower construction, combining both NDPd milestone tracking and Magenta Tracker milestone tracking so WIP is captured regardless of which system a site uses. Provides separate civil WIP and tower WIP counts (which may overlap) plus a deduplicated total WIP count across any WIP signal, and includes the number of distinct active general contractors associated with WIP to support capacity planning and workload balancing by region/area/market and contractor.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "site_code", "type": "string", "description": "Filter by site code", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "por_category", "type": "string", "nullable": false}, {"name": "civil_wip_ndpd", "type": "number", "nullable": false}, {"name": "tower_wip_ndpd", "type": "number", "nullable": false}, {"name": "civil_wip_mb", "type": "number", "nullable": false}, {"name": "tower_wip_mb", "type": "number", "nullable": false}, {"name": "active_vendor_count", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'For active projects, returns market-level counts of distinct projects in WIP for four indicators: (1) civil_wip_ndpd where ms_1549_civil_construction_start_actual is not null AND ms_1551_civil_construction_complete_actual_date is null; (2) tower_wip_ndpd where ms_1550_construction_start_actual is not null AND ms_1555_construction_complete_actual is null; (3) civil_wip_mb where pj_a_4250_civil_construction_start_finish is not null AND pj_a_4750_civil_construction_complete_finish is null; (4) tower_wip_mb where pj_a_4225_construction_start_finish is not null AND pj_a_5175_construction_complete_finish is null. Also computes active_vendor_count as the distinct non-blank construction_gc values among rows where any of the four WIP conditions is true. Results are grouped by rgn_region, m_area, m_market, and por_category (construction_gc is filter-only). Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', node_type: 'CORE', definition: 'For active projects, returns market-level counts of distinct projects in WIP for four indicators: (1) civil_wip_ndpd where ms_1549_civil_construction_start_actual is not null AND ms_1551_civil_construction_complete_actual_date is null; (2) tower_wip_ndpd where ms_1550_construction_start_actual is not null AND ms_1555_construction_complete_actual is null; (3) civil_wip_mb where pj_a_4250_civil_construction_start_finish is not null AND pj_a_4750_civil_construction_complete_finish is null; (4) tower_wip_mb where pj_a_4225_construction_start_finish is not null AND pj_a_5175_construction_complete_finish is null. Also computes active_vendor_count as the distinct non-blank construction_gc values among rows where any of the four WIP conditions is true. Results are grouped by rgn_region, m_area, m_market, and por_category (construction_gc is filter-only).', kpi_python_function: 'def get_tower_civil_wip(execute_query, filters=None) -> list[dict]:\n    # KPI: Civil/Tower WIP (NDPd + Magenta Builder Tracker)\n    # Source of truth: pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n\n    where_parts = [\n        \'"pj_project_id" IS NOT NULL\',\n        \'"s_site_id" IS NOT NULL\',\n        \'"pj_a_3710_ran_entitlement_complete_finish" IS NOT NULL\'\n    ]\n\n    # Explicit allowlist filters only (no date logic; no pj_program_name / pj_project_type)\n    if filters:\n        if filters.get(\'rgn_region\'):\n            val = str(filters[\'rgn_region\']).replace("\'", "\'\'")\n            where_parts.append(f\'"rgn_region" = \\\'{val}\\\'\')\n        if filters.get(\'m_area\'):\n            val = str(filters[\'m_area\']).replace("\'", "\'\'")\n            where_parts.append(f\'"m_area" = \\\'{val}\\\'\')\n        if filters.get(\'m_market\'):\n            val = str(filters[\'m_market\']).replace("\'", "\'\'")\n            where_parts.append(f\'"m_market" = \\\'{val}\\\'\')\n        # filter-only (not a grouping dimension)\n        if filters.get(\'construction_gc\'):\n            val = str(filters[\'construction_gc\']).replace("\'", "\'\'")\n            where_parts.append(f\'"construction_gc" = \\\'{val}\\\'\')\n        if filters.get(\'site_code\'):\n            val = str(filters[\'site_code\']).replace("\'", "\'\'")\n            where_parts.append(f\'"s_site_id" = \\\'{val}\\\'\')\n        if filters.get(\'por_category\'):\n            val = str(filters[\'por_category\']).replace("\'", "\'\'")\n            where_parts.append(f\'"por_category" = \\\'{val}\\\'\')\n        if filters.get("smp_name"):\n            v = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n            # NTM-specific filters (per Nokia Question Bank)\n            if v.strip().upper() == \'NTM\':\n                where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n                where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n    where_sql = \' AND \'.join(where_parts)\n\n    # WIP is a current-state snapshot based on milestone presence/absence.\n    # All logic is inline CASE expressions on the same table (no CTE, no subquery).\n    sql = f"""\n        SELECT\n            "rgn_region" AS "rgn_region",\n            "m_area" AS "m_area",\n            "m_market" AS "m_market",\n            "por_category" AS "por_category",\n\n            COUNT(DISTINCT CASE\n                WHEN "ms_1549_civil_construction_start_actual" IS NOT NULL\n                 AND "ms_1551_civil_construction_complete_actual_date" IS NULL\n                THEN "pj_project_id" END\n            ) AS "civil_wip_ndpd",\n\n            COUNT(DISTINCT CASE\n                WHEN "ms_1550_construction_start_actual" IS NOT NULL\n                 AND "ms_1555_construction_complete_actual" IS NULL\n                THEN "pj_project_id" END\n            ) AS "tower_wip_ndpd",\n\n            COUNT(DISTINCT CASE\n                WHEN "pj_a_4250_civil_construction_start_finish" IS NOT NULL\n                 AND "pj_a_4750_civil_construction_complete_finish" IS NULL\n                THEN "pj_project_id" END\n            ) AS "civil_wip_mb",\n\n            COUNT(DISTINCT CASE\n                WHEN "pj_a_4225_construction_start_finish" IS NOT NULL\n                 AND "pj_a_5175_construction_complete_finish" IS NULL\n                THEN "pj_project_id" END\n            ) AS "tower_wip_mb",\n\n            COUNT(DISTINCT CASE\n                WHEN (\n                    ("ms_1549_civil_construction_start_actual" IS NOT NULL AND "ms_1551_civil_construction_complete_actual_date" IS NULL)\n                    OR ("ms_1550_construction_start_actual" IS NOT NULL AND "ms_1555_construction_complete_actual" IS NULL)\n                    OR ("pj_a_4250_civil_construction_start_finish" IS NOT NULL AND "pj_a_4750_civil_construction_complete_finish" IS NULL)\n                    OR ("pj_a_4225_construction_start_finish" IS NOT NULL AND "pj_a_5175_construction_complete_finish" IS NULL)\n                )\n                THEN NULLIF(BTRIM("construction_gc"), \'\')\n                END\n            ) AS "active_vendor_count"\n\n        FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n        WHERE {where_sql}\n        GROUP BY\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "por_category"\n        ORDER BY\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "por_category";\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 's_site_id', 'pj_project_status', 'rgn_region', 'm_area', 'm_market', 'por_category', 'construction_gc', 'ms_1549_civil_construction_start_actual', 'ms_1551_civil_construction_complete_actual_date', 'ms_1550_construction_start_actual', 'ms_1555_construction_complete_actual', 'pj_a_4250_civil_construction_start_finish', 'pj_a_4750_civil_construction_complete_finish', 'pj_a_4225_construction_start_finish', 'pj_a_5175_construction_complete_finish', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Tower & Civil WIP', kpi_related_core_node_ids: ['project', 'site', 'general_contractor'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '0087a40d-da6f-4622-98d5-f3e9b02c81df', entity_type: 'kpi', kpi_name: 'Tower & Civil WIP', name: '0087a40d-da6f-4622-98d5-f3e9b02c81df', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'por_category'], kpi_description: 'Counts distinct projects/sites with active work-in-progress in civil and tower construction, combining both NDPd milestone tracking and Magenta Tracker milestone tracking so WIP is captured regardless of which system a site uses. Provides separate civil WIP and tower WIP counts (which may overlap) plus a deduplicated total WIP count across any WIP signal, and includes the number of distinct active general contractors associated with WIP to support capacity planning and workload balancing by region/area/market and contractor. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB). Also reports Magenta Builder Tracker (MB) WIP using pj_a_4225/5175 and pj_a_4250/4750 column pairs.', status: 'mentioned', node_id: '0087a40d-da6f-4622-98d5-f3e9b02c81df'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_tmo_hse_daily_tracker_v0_1', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: 'The crew-counting window is program-specific (driven by smp_name):\n\n1) AHLOB Modernization — last-7-days view.\n   a) From stg_tmo_hse_daily_tracker_v0_1, keep rows where crew_lead_name IS NOT NULL and check_in_date >= CURRENT_DATE - INTERVAL \'7 days\'.\n   b) INNER JOIN to stg_ndpd_mbt_tmobile_macro_combined on smp_id, filtered to smp_name = \'AHLOB Modernization\' with construction_gc IS NOT NULL.\n   c) For each (rgn_region, m_area, m_market, construction_gc) group, compute crew_lead_count = COUNT(DISTINCT crew_lead_name).\n\n2) NTM — 4 x 10-day batch average over the last 39 days.\n   a) From stg_tmo_hse_daily_tracker_v0_1, keep rows where crew_lead_name IS NOT NULL and check_in_date >= CURRENT_DATE - INTERVAL \'39 days\'.\n   b) Bucket each check-in into one of four 10-day batches:\n        Batch-1: check_in_date >= CURRENT_DATE - INTERVAL \'9 days\'\n        Batch-2: check_in_date in [CURRENT_DATE - 19 days, CURRENT_DATE - 9 days)\n        Batch-3: check_in_date in [CURRENT_DATE - 29 days, CURRENT_DATE - 19 days)\n        Batch-4: check_in_date in [CURRENT_DATE - 39 days, CURRENT_DATE - 29 days)\n   c) INNER JOIN to stg_ndpd_mbt_tmobile_macro_combined on smp_id, filtered to smp_name = \'NTM\' with construction_gc IS NOT NULL.\n   d) For each (rgn_region, m_area, m_market, construction_gc, batch) group, compute distinct crew-lead count = COUNT(DISTINCT crew_lead_name).\n   e) Average the per-batch counts per (rgn_region, m_area, m_market, construction_gc) — that average is crew_lead_count for the group.\n\n3) Default (no smp_name supplied or any other value) — no date window is applied. Compute COUNT(DISTINCT crew_lead_name) over all HSE check-ins per (rgn_region, m_area, m_market, construction_gc), with crew_lead_name and construction_gc both required to be NOT NULL.\n\nOptional dimension filters (rgn_region, m_area, m_market, construction_gc) are applied to the macro side. The smp_name filter routes the calculation between the three branches above.', kpi_formula_description: 'One-sentence formula: Crew Capacity = COUNT(DISTINCT HSE crew_lead_name) per (rgn_region, m_area, m_market, construction_gc) after INNER JOINing HSE daily tracker to macro projects on smp_id and excluding NULL crew leads and NULL GCs.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region from the macro project record."}, {"column": "m_area", "type": "string", "description": "Area from the macro project record."}, {"column": "m_market", "type": "string", "description": "Market from the macro project record."}, {"column": "construction_gc", "type": "string", "description": "General Contractor name from the macro project record."}, {"column": "crew_lead_count", "type": "integer", "description": "Distinct count of crew_lead_name observed in HSE check-ins, counted once per GC within the grouped geo dimensions."}]', kpi_business_logic: '1) Start with HSE check-in records (stg_tmo_hse_daily_tracker_v0_1). 2) INNER JOIN to macro projects (stg_ndpd_mbt_tmobile_macro_combined) on smp_id to attribute each HSE row to a known macro project and its GC/geo dimensions. 3) Filter to rows where crew_lead_name is not null and construction_gc is not null. 4) Apply optional filters for rgn_region, m_area, m_market, and/or construction_gc (no date filter, no project status filter, no entitlement filter). 5) Group by rgn_region, m_area, m_market, construction_gc. 6) Compute crew_lead_count = COUNT(DISTINCT crew_lead_name) within each group (a crew lead can be counted once per GC).', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Filter results to a single region (t2.rgn_region)."}, {"name": "m_area", "type": "string", "description": "Filter results to a single area (t2.m_area)."}, {"name": "m_market", "type": "string", "description": "Filter results to a single market (t2.m_market)."}, {"name": "construction_gc", "type": "string", "description": "Filter results to a single General Contractor (t2.construction_gc)."}, {"name": "smp_name", "type": "string", "description": "Filter by program name (e.g., NTM, AHLOB Modernization). When NTM, additionally requires smp_status=Active and excludes specific ntm_project_type values."}]', kpi_contract: '{"function_name": "get_crew_capacity", "node_type": "kpi", "node_id": "64a36227-713c-4a1a-9f7d-79079c625345", "node_label": "Crew Capacity", "description": "Counts distinct crew leads per General Contractor (by region/area/market) as a proxy for GC crew capacity/headcount. Uses the HSE daily tracker as the closest available source: any `crew_lead_name` observed in HSE check-ins is treated as a crew belonging to that GC, attributed by joining HSE records to macro projects on `smp_id`. Supports capacity planning, vendor benchmarking, and as an input to Capacity vs Demand Gap analysis. Caveat: proxy metric that may overstate capacity (historical crew leads who left) and understate capacity (crews not yet logging HSE check-ins); should be repointed to a dedicated roster source when available.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "crew_lead_count", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'One-sentence formula: Crew Capacity = COUNT(DISTINCT HSE crew_lead_name) per (rgn_region, m_area, m_market, construction_gc) after INNER JOINing HSE daily tracker to macro projects on smp_id and excluding NULL crew leads and NULL GCs.', node_type: 'CORE', definition: 'Crew Capacity = COUNT(DISTINCT HSE crew_lead_name) per (rgn_region, m_area, m_market, construction_gc) after INNER JOINing the HSE daily tracker to macro projects on smp_id and excluding NULL crew leads and NULL GCs. The window over which distinct crew leads are counted depends on the program (smp_name): for \'AHLOB Modernization\' only the last 7 days of HSE check-ins are used; for \'NTM\' the last 39 days are split into four 10-day batches and the per-batch distinct crew-lead counts are averaged across batches; if no smp_name is supplied, no date window is applied.', kpi_python_function: 'def get_crew_capacity(execute_query, filters=None) -> list[dict]:\n    filters = filters or {}\n    smp_name_raw = filters.get("smp_name")\n    smp_upper = str(smp_name_raw).strip().upper() if smp_name_raw else None\n\n    proj_filters = [\'t2."construction_gc" IS NOT NULL\']\n    if filters.get("rgn_region"):\n        v = str(filters["rgn_region"]).replace("\'", "\'\'")\n        proj_filters.append(f"t2.\\"rgn_region\\" = \'{v}\'")\n    if filters.get("m_area"):\n        v = str(filters["m_area"]).replace("\'", "\'\'")\n        proj_filters.append(f"t2.\\"m_area\\" = \'{v}\'")\n    if filters.get("m_market"):\n        v = str(filters["m_market"]).replace("\'", "\'\'")\n        proj_filters.append(f"t2.\\"m_market\\" = \'{v}\'")\n    if filters.get("construction_gc"):\n        v = str(filters["construction_gc"]).replace("\'", "\'\'")\n        proj_filters.append(f"t2.\\"construction_gc\\" = \'{v}\'")\n\n    if smp_upper == "NTM":\n        # NTM: average distinct crew leads across 4 batches (10-day windows over last 39 days)\n        proj_filters.append("t2.\\"smp_name\\" = \'NTM\'")\n        proj_where = " AND ".join(proj_filters)\n        sql = f"""\n            WITH hse AS (\n                SELECT DISTINCT\n                    "smp_id",\n                    RTRIM(LOWER("crew_lead_name")) AS "crew_lead_name",\n                    "check_in_date",\n                    CASE\n                        WHEN "check_in_date" >= CURRENT_DATE - INTERVAL \'9 days\'\n                            THEN \'Batch-1\'\n                        WHEN "check_in_date" >= CURRENT_DATE - INTERVAL \'19 days\'\n                             AND "check_in_date" < CURRENT_DATE - INTERVAL \'9 days\'\n                            THEN \'Batch-2\'\n                        WHEN "check_in_date" >= CURRENT_DATE - INTERVAL \'29 days\'\n                             AND "check_in_date" < CURRENT_DATE - INTERVAL \'19 days\'\n                            THEN \'Batch-3\'\n                        WHEN "check_in_date" >= CURRENT_DATE - INTERVAL \'39 days\'\n                             AND "check_in_date" < CURRENT_DATE - INTERVAL \'29 days\'\n                            THEN \'Batch-4\'\n                    END AS batch\n                FROM pwc_macro_staging_schema.stg_tmo_hse_daily_tracker_v0_1\n                WHERE "crew_lead_name" IS NOT NULL\n                  AND "check_in_date" >= CURRENT_DATE - INTERVAL \'39 days\'\n            ),\n            proj AS (\n                SELECT DISTINCT\n                    t2."smp_id",\n                    t2."rgn_region",\n                    t2."m_area",\n                    t2."m_market",\n                    t2."construction_gc"\n                FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined t2\n                WHERE {proj_where}\n            ),\n            batch_counts AS (\n                SELECT\n                    p."rgn_region",\n                    p."m_area",\n                    p."m_market",\n                    p."construction_gc",\n                    h.batch,\n                    COUNT(DISTINCT h."crew_lead_name") AS crew_lead_count\n                FROM hse h\n                INNER JOIN proj p ON h."smp_id" = p."smp_id"\n                WHERE h.batch IS NOT NULL\n                GROUP BY\n                    p."rgn_region",\n                    p."m_area",\n                    p."m_market",\n                    p."construction_gc",\n                    h.batch\n            )\n            SELECT\n                "rgn_region",\n                "m_area",\n                "m_market",\n                "construction_gc",\n                AVG(crew_lead_count) AS "crew_lead_count"\n            FROM batch_counts\n            GROUP BY "rgn_region", "m_area", "m_market", "construction_gc"\n            ORDER BY "rgn_region", "m_area", "m_market", "construction_gc"\n        """\n        return execute_query(sql)\n\n    if smp_upper == "AHLOB MODERNIZATION":\n        # AHLOB Modernization: distinct crew leads observed in the last 7 days\n        proj_filters.append("t2.\\"smp_name\\" = \'AHLOB Modernization\'")\n        proj_where = " AND ".join(proj_filters)\n        sql = f"""\n            SELECT\n                t2."rgn_region",\n                t2."m_area",\n                t2."m_market",\n                t2."construction_gc",\n                COUNT(DISTINCT RTRIM(t1."crew_lead_name")) AS "crew_lead_count"\n            FROM pwc_macro_staging_schema.stg_tmo_hse_daily_tracker_v0_1 t1\n            INNER JOIN pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined t2\n                ON t1."smp_id" = t2."smp_id"\n            WHERE {proj_where}\n              AND t1."check_in_date" >= CURRENT_DATE - INTERVAL \'7 days\'\n              AND RTRIM(t1."crew_lead_name") IS NOT NULL\n            GROUP BY t2."rgn_region", t2."m_area", t2."m_market", t2."construction_gc"\n            ORDER BY t2."rgn_region", t2."m_area", t2."m_market", t2."construction_gc"\n        """\n        return execute_query(sql)\n\n    # Default: distinct crew leads per GC, no date window\n    where_parts = [\n        "1=1",\n        \'RTRIM(t1."crew_lead_name") IS NOT NULL\',\n        \'t2."construction_gc" IS NOT NULL\',\n    ]\n    if filters.get("rgn_region"):\n        v = str(filters["rgn_region"]).replace("\'", "\'\'")\n        where_parts.append(f"t2.\\"rgn_region\\" = \'{v}\'")\n    if filters.get("m_area"):\n        v = str(filters["m_area"]).replace("\'", "\'\'")\n        where_parts.append(f"t2.\\"m_area\\" = \'{v}\'")\n    if filters.get("m_market"):\n        v = str(filters["m_market"]).replace("\'", "\'\'")\n        where_parts.append(f"t2.\\"m_market\\" = \'{v}\'")\n    if filters.get("construction_gc"):\n        v = str(filters["construction_gc"]).replace("\'", "\'\'")\n        where_parts.append(f"t2.\\"construction_gc\\" = \'{v}\'")\n    if smp_name_raw:\n        v = str(smp_name_raw).replace("\'", "\'\'")\n        where_parts.append(f"t2.\\"smp_name\\" = \'{v}\'")\n    where_sql = " AND ".join(where_parts)\n    sql = f"""\n        SELECT\n            t2."rgn_region",\n            t2."m_area",\n            t2."m_market",\n            t2."construction_gc",\n            COUNT(DISTINCT RTRIM(t1."crew_lead_name")) AS "crew_lead_count"\n        FROM pwc_macro_staging_schema.stg_tmo_hse_daily_tracker_v0_1 t1\n        INNER JOIN pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined t2\n            ON t1."smp_id" = t2."smp_id"\n        WHERE {where_sql}\n        GROUP BY t2."rgn_region", t2."m_area", t2."m_market", t2."construction_gc"\n        ORDER BY t2."rgn_region", t2."m_area", t2."m_market", t2."construction_gc"\n    """\n    return execute_query(sql)', kpi_source_columns: ['stg_tmo_hse_daily_tracker_v0_1.smp_id', 'stg_tmo_hse_daily_tracker_v0_1.crew_lead_name', 'stg_ndpd_mbt_tmobile_macro_combined.smp_id', 'stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'stg_ndpd_mbt_tmobile_macro_combined.m_area', 'stg_ndpd_mbt_tmobile_macro_combined.m_market', 'stg_ndpd_mbt_tmobile_macro_combined.construction_gc', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Crew Capacity', kpi_related_core_node_ids: ['project'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '64a36227-713c-4a1a-9f7d-79079c625345', entity_type: 'kpi', kpi_name: 'Crew Capacity', name: '64a36227-713c-4a1a-9f7d-79079c625345', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Counts distinct crew leads per General Contractor (by region/area/market) as a proxy for GC crew capacity/headcount. Uses the HSE daily tracker as the closest available source: any `crew_lead_name` observed in HSE check-ins is treated as a crew belonging to that GC, attributed by joining HSE records to macro projects on `smp_id`. Supports capacity planning, vendor benchmarking, and as an input to Capacity vs Demand Gap analysis. Caveat: proxy metric that may overstate capacity (historical crew leads who left) and understate capacity (crews not yet logging HSE check-ins); should be repointed to a dedicated roster source when available. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: '64a36227-713c-4a1a-9f7d-79079c625345'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'KPI = f(Project, Milestone, General Contractor, Market) computed from stg_ndpd_mbt_tmobile_macro_combined by counting integrated projects (ms_1970 not null), counting monitoring-complete projects (ms_2045 not null), and calculating compliance rate plus pending aging and monitoring cycle-time percentiles grouped by region/area/market/GC.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping."}, {"column": "m_area", "type": "string", "description": "Area grouping."}, {"column": "m_market", "type": "string", "description": "Market grouping."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping."}, {"column": "integrated_count", "type": "integer", "description": "Distinct integrated projects (ms_1970_integration_complete_actual not null)."}, {"column": "monitoring_complete_count", "type": "integer", "description": "Distinct projects with 72-hour monitoring complete (ms_2045 parsed date not null)."}, {"column": "monitoring_pending_count", "type": "integer", "description": "Distinct projects integrated but missing monitoring complete."}, {"column": "compliance_rate_pct", "type": "float", "description": "100 * monitoring_complete_count / integrated_count."}, {"column": "avg_pending_aging_days", "type": "float", "description": "Average days since integration complete for pending projects (CURRENT_DATE - ms_1970::date)."}, {"column": "avg_monitoring_days", "type": "float", "description": "Average days from integration complete to monitoring complete for completed projects, excluding negative durations."}]', kpi_business_logic: '1) Start from stg_ndpd_mbt_tmobile_macro_combined (one row per project).\n2) Exclude pj_project_status = \'Dead\'.\n3) Parse ms_2045_72_hours_monitoring_complete_actual into a DATE as follows: if NULL then NULL; else if text matches YYYY-MM-DD then cast to timestamp then ::date; else NULL.\n4) Group by (rgn_region, m_area, m_market, construction_gc).\n5) integrated_count = COUNT(DISTINCT pj_project_id) where ms_1970_integration_complete_actual is not null.\n6) monitoring_complete_count = COUNT(DISTINCT pj_project_id) where parsed ms_2045 date is not null.\n7) monitoring_pending_count = COUNT(DISTINCT pj_project_id) where ms_1970 is not null and parsed ms_2045 date is null.\n8) compliance_rate_pct = 100.0 * monitoring_complete_count / NULLIF(integrated_count, 0).\n9) Pending aging (pending only): compute days since integration complete as CURRENT_DATE - ms_1970::date; return AVG and P90 via PERCENTILE_CONT(0.9).\n10) Monitoring cycle time (completed only): compute days as ms_2045_date - ms_1970::date; exclude negative durations; return AVG, P50, P90 via PERCENTILE_CONT.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Filter to a specific region."}, {"name": "m_area", "type": "string", "description": "Filter to a specific area."}, {"name": "m_market", "type": "string", "description": "Filter to a specific market."}, {"name": "construction_gc", "type": "string", "description": "Filter to a specific general contractor."}, {"name": "smp_name", "type": "string", "description": "Filter to a specific program name (suggested default: \'AHLOB Modernization\'; caller-controlled)."}]', kpi_contract: '{"function_name": "get_72hr_monitoring_compliance", "node_type": "kpi", "node_id": "804fb044-40e7-4d2e-a637-107426e04091", "node_label": "72hr Monitoring Compliance", "description": "Measures AHLOB sites\\u2019 compliance with the mandatory 72-hour post-integration monitoring gate. After Integration Complete (ms_1970_integration_complete_actual), sites must complete the 72-hour monitoring milestone (ms_2045_72_hours_monitoring_complete_actual). Reports (1) compliance rate (% of integrated sites that completed monitoring), (2) pending backlog (integrated but monitoring not complete), (3) pending aging (avg/p90 days since integration complete for pending sites), and (4) monitoring cycle time for completed sites (avg/p50/p90 days from integration complete to monitoring complete, excluding negative durations). Break down by region/area/market and general contractor to drive accountability and escalation. AHLOB-specific: should be tagged with applies_to_programs=[\'AHLOB Modernization\'] and typically filtered by smp_name=\'AHLOB Modernization\' (caller-controlled, not hardcoded).", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "integrated_count", "type": "number", "nullable": false}, {"name": "monitoring_complete_count", "type": "number", "nullable": false}, {"name": "monitoring_pending_count", "type": "number", "nullable": false}, {"name": "compliance_rate_pct", "type": "null", "nullable": true}, {"name": "avg_pending_aging_days", "type": "null", "nullable": true}, {"name": "avg_monitoring_days", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'KPI = f(Project, Milestone, General Contractor, Market) computed from stg_ndpd_mbt_tmobile_macro_combined by counting integrated projects (ms_1970 not null), counting monitoring-complete projects (ms_2045 not null), and calculating compliance rate plus pending aging and monitoring cycle-time percentiles grouped by region/area/market/GC. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB). When filtered to NTM, automatically applies smp_status=\'Active\' and ntm_project_type exclusions.', node_type: 'CORE', definition: 'KPI = f(Project, Milestone, General Contractor, Market) computed from stg_ndpd_mbt_tmobile_macro_combined by counting integrated projects (ms_1970 not null), counting monitoring-complete projects (ms_2045 not null), and calculating compliance rate plus pending aging and monitoring cycle-time percentiles grouped by region/area/market/GC.', kpi_python_function: 'def get_72hr_monitoring_compliance(execute_query, filters=None) -> list[dict]:\n    where_parts = ["1=1", "COALESCE(\\"pj_project_status\\", \'\') <> \'Dead\'"]\n\n    if filters:\n        if filters.get("rgn_region"):\n            escaped = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"rgn_region\\" = \'{escaped}\'")\n        if filters.get("m_area"):\n            escaped = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_area\\" = \'{escaped}\'")\n        if filters.get("m_market"):\n            escaped = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_market\\" = \'{escaped}\'")\n        if filters.get("construction_gc"):\n            escaped = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"construction_gc\\" = \'{escaped}\'")\n        # Caller-controlled; suggested default is \'AHLOB Modernization\' but NOT hardcoded here.\n        if filters.get("smp_name"):\n            escaped = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"smp_name\\" = \'{escaped}\'")\n            # NTM-specific filters (per Nokia Question Bank)\n            if str(filters.get(\'smp_name\', \'\')).strip().upper() == \'NTM\':\n                where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n                where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n    SELECT\n        base."rgn_region",\n        base."m_area",\n        base."m_market",\n        base."construction_gc",\n        COUNT(DISTINCT CASE\n            WHEN base."ms_1970_integration_complete_actual" IS NOT NULL THEN base."pj_project_id"\n        END) AS "integrated_count",\n        COUNT(DISTINCT CASE\n            WHEN base."ms_2045_72_hours_monitoring_complete_actual_date" IS NOT NULL THEN base."pj_project_id"\n        END) AS "monitoring_complete_count",\n        COUNT(DISTINCT CASE\n            WHEN base."ms_1970_integration_complete_actual" IS NOT NULL\n             AND base."ms_2045_72_hours_monitoring_complete_actual_date" IS NULL\n            THEN base."pj_project_id"\n        END) AS "monitoring_pending_count",\n        100.0 *\n        COUNT(DISTINCT CASE\n            WHEN base."ms_2045_72_hours_monitoring_complete_actual_date" IS NOT NULL THEN base."pj_project_id"\n        END)\n        / NULLIF(\n            COUNT(DISTINCT CASE\n                WHEN base."ms_1970_integration_complete_actual" IS NOT NULL THEN base."pj_project_id"\n            END),\n            0\n        ) AS "compliance_rate_pct",\n\n        AVG(CASE\n            WHEN base."ms_1970_integration_complete_actual" IS NOT NULL\n             AND base."ms_2045_72_hours_monitoring_complete_actual_date" IS NULL\n            THEN (CURRENT_DATE - (base."ms_1970_integration_complete_actual"::date))\n        END) AS "avg_pending_aging_days",\n\n        AVG(CASE\n            WHEN base."ms_1970_integration_complete_actual" IS NOT NULL\n             AND base."ms_2045_72_hours_monitoring_complete_actual_date" IS NOT NULL\n             AND (base."ms_2045_72_hours_monitoring_complete_actual_date" - (base."ms_1970_integration_complete_actual"::date)) >= 0\n            THEN (base."ms_2045_72_hours_monitoring_complete_actual_date" - (base."ms_1970_integration_complete_actual"::date))\n        END) AS "avg_monitoring_days"\n    FROM (\n        SELECT\n            "pj_project_id",\n            "ms_1970_integration_complete_actual",\n            CASE\n                WHEN "ms_2045_72_hours_monitoring_complete_actual" IS NULL THEN NULL\n                WHEN ("ms_2045_72_hours_monitoring_complete_actual"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\')\n                    THEN ("ms_2045_72_hours_monitoring_complete_actual"::timestamp)::date\n                ELSE NULL\n            END AS "ms_2045_72_hours_monitoring_complete_actual_date",\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "construction_gc",\n            "smp_name",\n            "pj_project_status"\n        FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n        WHERE {where_sql}\n    ) base\n    GROUP BY\n        base."rgn_region",\n        base."m_area",\n        base."m_market",\n        base."construction_gc"\n    ORDER BY\n        base."rgn_region",\n        base."m_area",\n        base."m_market",\n        base."construction_gc";\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'ms_1970_integration_complete_actual', 'ms_2045_72_hours_monitoring_complete_actual', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'smp_name', 'pj_project_status'], session_id: '69a3d22f26e208edc083a06e', label: '72hr Monitoring Compliance', kpi_related_core_node_ids: ['project', 'milestone', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '804fb044-40e7-4d2e-a637-107426e04091', entity_type: 'kpi', kpi_name: '72hr Monitoring Compliance', name: '804fb044-40e7-4d2e-a637-107426e04091', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures AHLOB sites’ compliance with the mandatory 72-hour post-integration monitoring gate. After Integration Complete (ms_1970_integration_complete_actual), sites must complete the 72-hour monitoring milestone (ms_2045_72_hours_monitoring_complete_actual). Reports (1) compliance rate (% of integrated sites that completed monitoring), (2) pending backlog (integrated but monitoring not complete), (3) pending aging (avg/p90 days since integration complete for pending sites), and (4) monitoring cycle time for completed sites (avg/p50/p90 days from integration complete to monitoring complete, excluding negative durations). Break down by region/area/market and general contractor to drive accountability and escalation. AHLOB-specific: should be tagged with applies_to_programs=[\'AHLOB Modernization\'] and typically filtered by smp_name=\'AHLOB Modernization\' (caller-controlled, not hardcoded).', status: 'mentioned', node_id: '804fb044-40e7-4d2e-a637-107426e04091'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Among projects where COALESCE(pj_project_status,\'\') <> \'Dead\', grouped by rgn_region/m_area/m_market/construction_gc, compute (1) integrated_count = distinct projects with ms_1970_integration_complete_actual present, (2) return_complete_count = distinct projects with ms_1705_ahloa_return_actual present, (3) gc_return_complete_count = distinct projects with ms_17050_gc_ahloa_return_actual present, (4) return_pending_count = integrated but not returned (ms_1970 present AND ms_1705 null), (5) return_completion_rate_pct = 100 * return_complete_count / integrated_count, (6) avg/p90 pending aging days = CURRENT_DATE - ms_1970_dt for pending projects, and (7) avg/p50/p90 return days = ms_1705_dt - ms_1970_dt for completed returns with non-negative duration.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region."}, {"column": "m_area", "type": "string", "description": "Area."}, {"column": "m_market", "type": "string", "description": "Market."}, {"column": "construction_gc", "type": "string", "description": "General contractor name."}, {"column": "integrated_count", "type": "integer", "description": "Distinct projects with integration complete (ms_1970 present)."}, {"column": "return_complete_count", "type": "integer", "description": "Distinct projects with Nokia return confirmation (ms_1705 present)."}, {"column": "gc_return_complete_count", "type": "integer", "description": "Distinct projects with GC return confirmation (ms_17050 present)."}, {"column": "return_pending_count", "type": "integer", "description": "Distinct integrated projects without Nokia return confirmation."}, {"column": "return_completion_rate_pct", "type": "float", "description": "100 * return_complete_count / integrated_count."}, {"column": "avg_pending_aging_days", "type": "float", "description": "Average days since integration complete for pending returns."}, {"column": "avg_return_days", "type": "float", "description": "Average days from integration complete to Nokia-confirmed return (non-negative only)."}]', kpi_business_logic: '1) Filter rows to non-Dead projects using COALESCE(pj_project_status,\'\') <> \'Dead\'. 2) Apply optional dimension filters: rgn_region, m_area, m_market, construction_gc, smp_name. 3) Derive dates: ms_1970_dt = ms_1970_integration_complete_actual::date; ms_1705_dt and ms_17050_dt parsed to date only when value is non-null and matches YYYY-MM-DD prefix (else null). 4) Group by rgn_region, m_area, m_market, construction_gc. 5) Compute distinct project counts for integrated/returned/GC-returned/pending. 6) Compute completion rate as returned/integrated. 7) Compute pending aging stats on (CURRENT_DATE - ms_1970_dt) for pending only. 8) Compute return cycle time stats on (ms_1705_dt - ms_1970_dt) for completed only where duration >= 0.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_radio_return_cycle_time", "node_type": "kpi", "node_id": "79e3602e-e566-457a-b8fe-af772f98715b", "node_label": "Radio Return Cycle Time", "description": "Measures how quickly AHLOB modernization sites complete old radio hardware return after integration. Tracks (a) return completion rate among integrated sites, (b) pending return count and aging (avg/p90 days since integration complete for sites without Nokia return confirmation), and (c) cycle time distribution (avg/p50/p90 days from integration complete to Nokia-confirmed return). Includes GC-confirmed return as a secondary signal for operational comparison. Helps manage warehouse logistics SLAs, identify GC/market bottlenecks, and prevent closeout delays. AHLOB-specific; tag with applies_to_programs [\'AHLOB Modernization\'] and use smp_name as an optional filter (suggested default AHLOB Modernization). Exclude dead projects and exclude negative durations where return precedes integration complete.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "integrated_count", "type": "number", "nullable": false}, {"name": "return_complete_count", "type": "number", "nullable": false}, {"name": "gc_return_complete_count", "type": "number", "nullable": false}, {"name": "return_pending_count", "type": "number", "nullable": false}, {"name": "return_completion_rate_pct", "type": "null", "nullable": true}, {"name": "avg_pending_aging_days", "type": "null", "nullable": true}, {"name": "avg_return_days", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Among projects where COALESCE(pj_project_status,\'\') <> \'Dead\', grouped by rgn_region/m_area/m_market/construction_gc, compute (1) integrated_count = distinct projects with ms_1970_integration_complete_actual present, (2) return_complete_count = distinct projects with ms_1705_ahloa_return_actual present, (3) gc_return_complete_count = distinct projects with ms_17050_gc_ahloa_return_actual present, (4) return_pending_count = integrated but not returned (ms_1970 present AND ms_1705 null), (5) return_completion_rate_pct = 100 * return_complete_count / integrated_count, (6) avg/p90 pending aging days = CURRENT_DATE - ms_1970_dt for pending projects, and (7) avg/p50/p90 return days = ms_1705_dt - ms_1970_dt for completed returns with non-negative duration. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB). When filtered to NTM, automatically applies smp_status=\'Active\' and ntm_project_type exclusions.', node_type: 'CORE', definition: 'Among projects where COALESCE(pj_project_status,\'\') <> \'Dead\', grouped by rgn_region/m_area/m_market/construction_gc, compute (1) integrated_count = distinct projects with ms_1970_integration_complete_actual present, (2) return_complete_count = distinct projects with ms_1705_ahloa_return_actual present, (3) gc_return_complete_count = distinct projects with ms_17050_gc_ahloa_return_actual present, (4) return_pending_count = integrated but not returned (ms_1970 present AND ms_1705 null), (5) return_completion_rate_pct = 100 * return_complete_count / integrated_count, (6) avg/p90 pending aging days = CURRENT_DATE - ms_1970_dt for pending projects, and (7) avg/p50/p90 return days = ms_1705_dt - ms_1970_dt for completed returns with non-negative duration.', kpi_python_function: 'def get_radio_return_cycle_time(execute_query, filters=None) -> list[dict]:\n    # Radio Return Cycle Time (AHLOB)\n    # Source: pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n\n    # Seed core metric-defining filter first; COALESCE pattern avoids OR/AND precedence bugs\n    where_parts = [\n        "1=1",\n        "COALESCE(\\"pj_project_status\\", \'\') <> \'Dead\'"\n    ]\n\n    if filters:\n        if filters.get("rgn_region"):\n            val = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"rgn_region\\" = \'{val}\'")\n        if filters.get("m_area"):\n            val = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_area\\" = \'{val}\'")\n        if filters.get("m_market"):\n            val = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_market\\" = \'{val}\'")\n        if filters.get("construction_gc"):\n            val = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"construction_gc\\" = \'{val}\'")\n        if filters.get("smp_name"):\n            val = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"smp_name\\" = \'{val}\'")\n            # NTM-specific filters (per Nokia Question Bank)\n            if str(filters.get(\'smp_name\', \'\')).strip().upper() == \'NTM\':\n                where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n                where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n    SELECT\n      base."rgn_region",\n      base."m_area",\n      base."m_market",\n      base."construction_gc",\n\n      COUNT(DISTINCT CASE WHEN base."ms_1970_dt" IS NOT NULL THEN base."pj_project_id" END) AS "integrated_count",\n      COUNT(DISTINCT CASE WHEN base."ms_1705_dt" IS NOT NULL THEN base."pj_project_id" END) AS "return_complete_count",\n      COUNT(DISTINCT CASE WHEN base."ms_17050_dt" IS NOT NULL THEN base."pj_project_id" END) AS "gc_return_complete_count",\n      COUNT(DISTINCT CASE WHEN base."ms_1970_dt" IS NOT NULL AND base."ms_1705_dt" IS NULL THEN base."pj_project_id" END) AS "return_pending_count",\n\n      100.0 *\n        COUNT(DISTINCT CASE WHEN base."ms_1705_dt" IS NOT NULL THEN base."pj_project_id" END)\n        / NULLIF(COUNT(DISTINCT CASE WHEN base."ms_1970_dt" IS NOT NULL THEN base."pj_project_id" END), 0)\n        AS "return_completion_rate_pct",\n\n      AVG(\n        CASE\n          WHEN base."ms_1970_dt" IS NOT NULL AND base."ms_1705_dt" IS NULL\n          THEN (CURRENT_DATE - base."ms_1970_dt")\n          ELSE NULL\n        END\n      ) AS "avg_pending_aging_days",\n\n\n      AVG(\n        CASE\n          WHEN base."ms_1970_dt" IS NOT NULL\n           AND base."ms_1705_dt" IS NOT NULL\n           AND (base."ms_1705_dt" - base."ms_1970_dt") >= 0\n          THEN (base."ms_1705_dt" - base."ms_1970_dt")\n          ELSE NULL\n        END\n      ) AS "avg_return_days"\n\n    FROM (\n      SELECT\n        "pj_project_id",\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n\n        ("ms_1970_integration_complete_actual")::date AS "ms_1970_dt",\n\n        CASE\n          WHEN ("ms_1705_ahloa_return_actual") IS NULL THEN NULL\n          WHEN ("ms_1705_ahloa_return_actual")::text ~ \'^\\\\\\\\d{{4}}-\\\\\\\\d{{2}}-\\\\\\\\d{{2}}\'\n            THEN ("ms_1705_ahloa_return_actual")::timestamp::date\n          ELSE NULL\n        END AS "ms_1705_dt",\n\n        CASE\n          WHEN ("ms_17050_gc_ahloa_return_actual") IS NULL THEN NULL\n          WHEN ("ms_17050_gc_ahloa_return_actual")::text ~ \'^\\\\\\\\d{{4}}-\\\\\\\\d{{2}}-\\\\\\\\d{{2}}\'\n            THEN ("ms_17050_gc_ahloa_return_actual")::timestamp::date\n          ELSE NULL\n        END AS "ms_17050_dt"\n\n      FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n      WHERE {where_sql}\n    ) base\n    GROUP BY\n      base."rgn_region",\n      base."m_area",\n      base."m_market",\n      base."construction_gc"\n    ORDER BY\n      base."rgn_region",\n      base."m_area",\n      base."m_market",\n      base."construction_gc";\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'pj_project_status', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'smp_name', 'ms_1970_integration_complete_actual', 'ms_1705_ahloa_return_actual', 'ms_17050_gc_ahloa_return_actual'], session_id: '69a3d22f26e208edc083a06e', label: 'Radio Return Cycle Time', kpi_related_core_node_ids: ['project', 'milestone', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '79e3602e-e566-457a-b8fe-af772f98715b', entity_type: 'kpi', kpi_name: 'Radio Return Cycle Time', name: '79e3602e-e566-457a-b8fe-af772f98715b', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures how quickly AHLOB modernization sites complete old radio hardware return after integration. Tracks (a) return completion rate among integrated sites, (b) pending return count and aging (avg/p90 days since integration complete for sites without Nokia return confirmation), and (c) cycle time distribution (avg/p50/p90 days from integration complete to Nokia-confirmed return). Includes GC-confirmed return as a secondary signal for operational comparison. Helps manage warehouse logistics SLAs, identify GC/market bottlenecks, and prevent closeout delays. AHLOB-specific; tag with applies_to_programs [\'AHLOB Modernization\'] and use smp_name as an optional filter (suggested default AHLOB Modernization). Exclude dead projects and exclude negative durations where return precedes integration complete.', status: 'mentioned', node_id: '79e3602e-e566-457a-b8fe-af772f98715b'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Radio Disposal Cycle Time = f(Project milestones, General Contractor, Market) computed per (rgn_region, m_area, m_market, construction_gc) using Integration Complete date as the start, Nokia disposal certified date as the primary completion, and GC disposal date as a secondary completion signal. Disposal date must be >= construction complete date (temporal ordering guard per QB).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping."}, {"column": "m_area", "type": "string", "description": "Area grouping."}, {"column": "m_market", "type": "string", "description": "Market grouping."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping."}, {"column": "integrated_count", "type": "integer", "description": "Distinct project count with Integration Complete actual date populated."}, {"column": "disposal_complete_count", "type": "integer", "description": "Distinct project count with Nokia AHLOA disposal actual date populated (primary completion gate)."}, {"column": "gc_disposal_complete_count", "type": "integer", "description": "Distinct project count with GC AHLOA disposal actual date populated (secondary signal)."}, {"column": "disposal_pending_count", "type": "integer", "description": "Distinct project count integrated but not yet Nokia-disposal-complete."}, {"column": "disposal_completion_rate_pct", "type": "float", "description": "100 * disposal_complete_count / integrated_count."}, {"column": "avg_pending_aging_days", "type": "float", "description": "Average days since integration complete for pending disposals only."}, {"column": "avg_disposal_days", "type": "float", "description": "Average (Nokia disposal date - integration complete date) in days for completed disposals only, excluding negative durations."}]', kpi_business_logic: '1) Filter out Dead projects via COALESCE(pj_project_status,\'\') <> \'Dead\' and apply optional dimension filters (rgn_region, m_area, m_market, construction_gc, smp_name). 2) Parse ms_1970_integration_complete_actual as ::date. 3) Parse disposal dates (ms_1710_ahloa_disposal_actual, ms_17100_gc_ahloa_disposal_actual) to dates only when value text matches YYYY-MM-DD; otherwise treat as NULL. 4) Group by (rgn_region, m_area, m_market, construction_gc). 5) integrated_count = distinct projects with ms_1970_date not null. 6) disposal_complete_count = distinct projects with Nokia disposal date not null. 7) gc_disposal_complete_count = distinct projects with GC disposal date not null. 8) disposal_pending_count = distinct projects integrated but with no Nokia disposal date. 9) disposal_completion_rate_pct = 100 * disposal_complete_count / integrated_count (NULLIF denominator). 10) Pending aging (days) for pending only = CURRENT_DATE - ms_1970_date; compute avg and p90. 11) Disposal cycle time (days) for completed only = ms_1710_date - ms_1970_date; exclude negative durations; compute avg, p50, p90. Temporal ordering guard: disposal date must be >= construction complete date (COALESCE Magenta/NDPd). Pending aging requires swap completion. Cycle time and pending aging calculations require disposal date >= swap completion date (COALESCE of pj_a_5175/ms_1555) to exclude temporal anomalies per Nokia QB Row 3.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Filter to a specific region (rgn_region)."}, {"name": "m_area", "type": "string", "description": "Filter to a specific area (m_area)."}, {"name": "m_market", "type": "string", "description": "Filter to a specific market (m_market)."}, {"name": "construction_gc", "type": "string", "description": "Filter to a specific general contractor (construction_gc)."}, {"name": "smp_name", "type": "string", "description": "Filter to a specific SMP/program name label (smp_name), e.g., \'AHLOB Modernization\' (not hardcoded)."}]', kpi_contract: '{"function_name": "get_radio_disposal_cycle_time", "node_type": "kpi", "node_id": "9f1749fe-712b-4f40-95c2-4fb15f813dd3", "node_label": "Radio Disposal Cycle Time", "description": "Measures the elapsed time from Integration Complete to certified disposal of old AHLOA radios for AHLOB modernization sites (primarily >8k radio disposal path). Tracks disposal completion rate among integrated sites, pending disposal backlog and aging since integration complete, and the cycle time distribution (avg/p50/p90 days) for completed disposals. Uses Nokia-side disposal confirmation as the primary completion gate and surfaces GC-side confirmation as a secondary signal. Excludes Dead projects and is tagged as AHLOB-specific for program scoping and graph traversal.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "integrated_count", "type": "number", "nullable": false}, {"name": "disposal_complete_count", "type": "number", "nullable": false}, {"name": "gc_disposal_complete_count", "type": "number", "nullable": false}, {"name": "disposal_pending_count", "type": "number", "nullable": false}, {"name": "disposal_completion_rate_pct", "type": "null", "nullable": true}, {"name": "avg_pending_aging_days", "type": "null", "nullable": true}, {"name": "avg_disposal_days", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Radio Disposal Cycle Time = f(Project milestones, General Contractor, Market) computed per (rgn_region, m_area, m_market, construction_gc) using Integration Complete date as the start, Nokia disposal certified date as the primary completion, and GC disposal date as a secondary completion signal. Disposal cycle time excludes sites where the disposal date precedes swap completion (data quality guard per Nokia Question Bank).', node_type: 'CORE', definition: 'Radio Disposal Cycle Time = f(Project milestones, General Contractor, Market) computed per (rgn_region, m_area, m_market, construction_gc) using Integration Complete date as the start, Nokia disposal certified date as the primary completion, and GC disposal date as a secondary completion signal.', kpi_python_function: 'def get_radio_disposal_cycle_time(execute_query, filters=None) -> list[dict]:\n    where_parts = [\n        "1=1",\n        "COALESCE(\\"pj_project_status\\", \'\') <> \'Dead\'"\n    ]\n\n    if filters:\n        if filters.get("rgn_region"):\n            v = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"rgn_region\\" = \'{v}\'")\n        if filters.get("m_area"):\n            v = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_area\\" = \'{v}\'")\n        if filters.get("m_market"):\n            v = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_market\\" = \'{v}\'")\n        if filters.get("construction_gc"):\n            v = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"construction_gc\\" = \'{v}\'")\n        if filters.get("smp_name"):\n            v = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"smp_name\\" = \'{v}\'")\n            # NTM-specific filters (per Nokia Question Bank)\n            if v.strip().upper() == \'NTM\':\n                where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n                where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n    SELECT\n        b."rgn_region" AS "rgn_region",\n        b."m_area" AS "m_area",\n        b."m_market" AS "m_market",\n        b."construction_gc" AS "construction_gc",\n\n        COUNT(DISTINCT CASE WHEN b."ms_1970_date" IS NOT NULL THEN b."pj_project_id" END) AS "integrated_count",\n        COUNT(DISTINCT CASE WHEN b."ms_1710_date" IS NOT NULL THEN b."pj_project_id" END) AS "disposal_complete_count",\n        COUNT(DISTINCT CASE WHEN b."ms_17100_gc_date" IS NOT NULL THEN b."pj_project_id" END) AS "gc_disposal_complete_count",\n        COUNT(DISTINCT CASE WHEN b."ms_1970_date" IS NOT NULL AND b."ms_1710_date" IS NULL THEN b."pj_project_id" END) AS "disposal_pending_count",\n\n        100.0 *\n        COUNT(DISTINCT CASE WHEN b."ms_1710_date" IS NOT NULL THEN b."pj_project_id" END)\n        / NULLIF(COUNT(DISTINCT CASE WHEN b."ms_1970_date" IS NOT NULL THEN b."pj_project_id" END), 0) AS "disposal_completion_rate_pct",\n\n        AVG(CASE WHEN b."pending_aging_days" IS NOT NULL THEN b."pending_aging_days" END) AS "avg_pending_aging_days",\n\n        AVG(CASE WHEN b."disposal_cycle_days" IS NOT NULL THEN b."disposal_cycle_days" END) AS "avg_disposal_days"\n\n    FROM (\n        SELECT\n            "pj_project_id",\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "construction_gc",\n\n            ("ms_1970_integration_complete_actual"::date) AS "ms_1970_date",\n\n            (\n                CASE\n                    WHEN "ms_1710_ahloa_disposal_actual" IS NULL THEN NULL\n                    WHEN "ms_1710_ahloa_disposal_actual"::text ~ \'^\\\\\\\\d{{4}}-\\\\\\\\d{{2}}-\\\\\\\\d{{2}}\' THEN ("ms_1710_ahloa_disposal_actual"::timestamp::date)\n                    ELSE NULL\n                END\n            ) AS "ms_1710_date",\n\n            (\n                CASE\n                    WHEN "ms_17100_gc_ahloa_disposal_actual" IS NULL THEN NULL\n                    WHEN "ms_17100_gc_ahloa_disposal_actual"::text ~ \'^\\\\\\\\d{{4}}-\\\\\\\\d{{2}}-\\\\\\\\d{{2}}\' THEN ("ms_17100_gc_ahloa_disposal_actual"::timestamp::date)\n                    ELSE NULL\n                END\n            ) AS "ms_17100_gc_date",\n\n            CASE\n                WHEN ("ms_1970_integration_complete_actual"::date) IS NOT NULL\n                     AND (\n                        CASE\n                            WHEN "ms_1710_ahloa_disposal_actual" IS NULL THEN NULL\n                            WHEN "ms_1710_ahloa_disposal_actual"::text ~ \'^\\\\\\\\d{{4}}-\\\\\\\\d{{2}}-\\\\\\\\d{{2}}\' THEN ("ms_1710_ahloa_disposal_actual"::timestamp::date)\n                            ELSE NULL\n                        END\n                     ) IS NULL\n                     AND COALESCE("pj_a_5175_construction_complete_finish"::text, "ms_1555_construction_complete_actual"::text) IS NOT NULL\n                THEN (CURRENT_DATE - ("ms_1970_integration_complete_actual"::date))\n                ELSE NULL\n            END AS "pending_aging_days",\n\n            CASE\n                WHEN ("ms_1970_integration_complete_actual"::date) IS NOT NULL\n                     AND (\n                        CASE\n                            WHEN "ms_1710_ahloa_disposal_actual" IS NULL THEN NULL\n                            WHEN "ms_1710_ahloa_disposal_actual"::text ~ \'^\\\\\\\\d{{4}}-\\\\\\\\d{{2}}-\\\\\\\\d{{2}}\' THEN ("ms_1710_ahloa_disposal_actual"::timestamp::date)\n                            ELSE NULL\n                        END\n                     ) IS NOT NULL\n                     AND "ms_1710_ahloa_disposal_actual"::timestamp >= COALESCE("pj_a_5175_construction_complete_finish"::text::timestamp, "ms_1555_construction_complete_actual"::text::timestamp)\n                THEN (\n                    (\n                        CASE\n                            WHEN "ms_1710_ahloa_disposal_actual" IS NULL THEN NULL\n                            WHEN "ms_1710_ahloa_disposal_actual"::text ~ \'^\\\\\\\\d{{4}}-\\\\\\\\d{{2}}-\\\\\\\\d{{2}}\' THEN ("ms_1710_ahloa_disposal_actual"::timestamp::date)\n                            ELSE NULL\n                        END\n                    )::date - ("ms_1970_integration_complete_actual"::date)\n                )\n                ELSE NULL\n            END AS "raw_disposal_cycle_days",\n\n            CASE\n                WHEN (\n                    CASE\n                        WHEN ("ms_1970_integration_complete_actual"::date) IS NOT NULL\n                             AND (\n                                CASE\n                                    WHEN "ms_1710_ahloa_disposal_actual" IS NULL THEN NULL\n                                    WHEN "ms_1710_ahloa_disposal_actual"::text ~ \'^\\\\\\\\d{{4}}-\\\\\\\\d{{2}}-\\\\\\\\d{{2}}\' THEN ("ms_1710_ahloa_disposal_actual"::timestamp::date)\n                                    ELSE NULL\n                                END\n                             ) IS NOT NULL\n                        THEN (\n                            (\n                                CASE\n                                    WHEN "ms_1710_ahloa_disposal_actual" IS NULL THEN NULL\n                                    WHEN "ms_1710_ahloa_disposal_actual"::text ~ \'^\\\\\\\\d{{4}}-\\\\\\\\d{{2}}-\\\\\\\\d{{2}}\' THEN ("ms_1710_ahloa_disposal_actual"::timestamp::date)\n                                    ELSE NULL\n                                END\n                            )::date - ("ms_1970_integration_complete_actual"::date)\n                        )\n                        ELSE NULL\n                    END\n                ) >= 0\n                THEN (\n                    (\n                        CASE\n                            WHEN "ms_1710_ahloa_disposal_actual" IS NULL THEN NULL\n                            WHEN "ms_1710_ahloa_disposal_actual"::text ~ \'^\\\\\\\\d{{4}}-\\\\\\\\d{{2}}-\\\\\\\\d{{2}}\' THEN ("ms_1710_ahloa_disposal_actual"::timestamp::date)\n                            ELSE NULL\n                        END\n                    )::date - ("ms_1970_integration_complete_actual"::date)\n                )\n                ELSE NULL\n            END AS "disposal_cycle_days"\n\n        FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n        WHERE {where_sql}\n    ) b\n    GROUP BY\n        b."rgn_region",\n        b."m_area",\n        b."m_market",\n        b."construction_gc"\n    ORDER BY\n        b."rgn_region",\n        b."m_area",\n        b."m_market",\n        b."construction_gc";\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'ms_1970_integration_complete_actual', 'ms_1710_ahloa_disposal_actual', 'ms_17100_gc_ahloa_disposal_actual', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'smp_name', 'pj_project_status', 'pj_a_5175_construction_complete_finish', 'ms_1555_construction_complete_actual'], session_id: '69a3d22f26e208edc083a06e', label: 'Radio Disposal Cycle Time', kpi_related_core_node_ids: ['project', 'milestone', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '9f1749fe-712b-4f40-95c2-4fb15f813dd3', entity_type: 'kpi', kpi_name: 'Radio Disposal Cycle Time', name: '9f1749fe-712b-4f40-95c2-4fb15f813dd3', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures the elapsed time from Integration Complete to certified disposal of old AHLOA radios for AHLOB modernization sites (primarily >8k radio disposal path). Tracks disposal completion rate among integrated sites, pending disposal backlog and aging since integration complete, and the cycle time distribution (avg/p50/p90 days) for completed disposals. Uses Nokia-side disposal confirmation as the primary completion gate and surfaces GC-side confirmation as a secondary signal. Excludes Dead projects and is tagged as AHLOB-specific for program scoping and graph traversal. Disposal cycle time excludes sites where the disposal date precedes swap completion (data quality guard per Nokia Question Bank). Optionally filterable by program via smp_name (e.g., NTM for Macro, AHLOB Modernization for AHLOB). When filtered to NTM, automatically applies smp_status=Active and ntm_project_type exclusions.', status: 'mentioned', node_id: '9f1749fe-712b-4f40-95c2-4fb15f813dd3'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Return vs Disposal Ratio = counts of distinct integrated projects with AHLOA warehouse return vs certified disposal timestamps (parsed), grouped by region/area/market/GC, plus percent mix and return-to-disposal ratio, with diagnostics for both/neither outcomes.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "construction_gc", "type": "string", "description": "General Contractor dimension."}, {"column": "return_count", "type": "integer", "description": "Distinct project count with parsed AHLOA return date present."}, {"column": "disposal_count", "type": "integer", "description": "Distinct project count with parsed AHLOA disposal date present."}, {"column": "both_count", "type": "integer", "description": "Distinct project count with BOTH parsed return and disposal dates present (diagnostic; should be rare)."}, {"column": "neither_count", "type": "integer", "description": "Distinct project count with integration complete timestamp present but neither parsed return nor parsed disposal present (diagnostic; pending resolution)."}, {"column": "total_resolved", "type": "integer", "description": "Resolved total = return_count + disposal_count - both_count."}, {"column": "return_pct", "type": "float", "description": "100 * return_count / total_resolved (NULL if total_resolved=0)."}, {"column": "disposal_pct", "type": "float", "description": "100 * disposal_count / total_resolved (NULL if total_resolved=0)."}, {"column": "return_to_disposal_ratio", "type": "float", "description": "return_count / disposal_count (NULL if disposal_count=0)."}]', kpi_business_logic: '1) Start from stg_ndpd_mbt_tmobile_macro_combined and exclude projects where COALESCE(pj_project_status,\'\')=\'Dead\'. 2) Parse ms_1705_ahloa_return_actual and ms_1710_ahloa_disposal_actual as dates only when their text matches YYYY-MM-DD; otherwise treat as NULL (use parsed values for all NOT NULL logic). 3) Group by rgn_region, m_area, m_market, construction_gc (optionally filter by rgn_region/m_area/m_market/construction_gc/smp_name). 4) Compute return_count as COUNT(DISTINCT pj_project_id) where parsed_ms_1705 is not null; disposal_count similarly from parsed_ms_1710. 5) Compute both_count where both parsed dates are not null (data-quality diagnostic). 6) Compute neither_count where ms_1970_integration_complete_actual is not null AND both parsed dates are null (pending resolution diagnostic). 7) Compute total_resolved = return_count + disposal_count - both_count. 8) Compute return_pct and disposal_pct as 100 * respective count / total_resolved (NULL when total_resolved=0). 9) Compute return_to_disposal_ratio = return_count / disposal_count (NULL when disposal_count=0).', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Filter to a specific region (exact match on rgn_region)."}, {"name": "m_area", "type": "string", "description": "Filter to a specific area (exact match on m_area)."}, {"name": "m_market", "type": "string", "description": "Filter to a specific market (exact match on m_market)."}, {"name": "construction_gc", "type": "string", "description": "Filter to a specific General Contractor (exact match on construction_gc)."}, {"name": "smp_name", "type": "string", "description": "Filter to a specific SMP name/program label (exact match on smp_name)."}]', kpi_contract: '{"function_name": "get_return_vs_disposal_ratio", "node_type": "kpi", "node_id": "8540b900-55f8-4117-8528-b0db4e8b8533", "node_label": "Return vs Disposal Ratio", "description": "Measures the volume split of AHLOB post-integration radio logistics outcomes\\u2014warehouse return vs certified disposal\\u2014by region/area/market and General Contractor. Provides return_count, disposal_count, percent mix, and return-to-disposal ratio for warehouse capacity planning and compliance oversight. Includes data-quality diagnostics for sites showing both return and disposal (should be rare/zero) and integrated sites showing neither (pending resolution). AHLOB-specific (applies_to_programs: [\'AHLOB Modernization\']).", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "return_count", "type": "number", "nullable": false}, {"name": "disposal_count", "type": "number", "nullable": false}, {"name": "both_count", "type": "number", "nullable": false}, {"name": "neither_count", "type": "number", "nullable": false}, {"name": "total_resolved", "type": "number", "nullable": false}, {"name": "return_pct", "type": "null", "nullable": true}, {"name": "disposal_pct", "type": "null", "nullable": true}, {"name": "return_to_disposal_ratio", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Return vs Disposal Ratio = counts of distinct integrated projects with AHLOA warehouse return vs certified disposal timestamps (parsed), grouped by region/area/market/GC, plus percent mix and return-to-disposal ratio, with diagnostics for both/neither outcomes. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB). When filtered to NTM, automatically applies smp_status=\'Active\' and ntm_project_type exclusions.', node_type: 'CORE', definition: 'Return vs Disposal Ratio = counts of distinct integrated projects with AHLOA warehouse return vs certified disposal timestamps (parsed), grouped by region/area/market/GC, plus percent mix and return-to-disposal ratio, with diagnostics for both/neither outcomes.', kpi_python_function: 'def get_return_vs_disposal_ratio(execute_query, filters=None) -> list[dict]:\n    # KPI: Return vs Disposal Ratio (AHLOB Modernization)\n    where_parts = [\n        "1=1",\n        "COALESCE(\\"pj_project_status\\", \'\') <> \'Dead\'"\n    ]\n\n    allowed_filters = {"rgn_region", "m_area", "m_market", "construction_gc", "smp_name"}\n    if filters:\n        if filters.get("rgn_region"):\n            v = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"rgn_region\\" = \'{v}\'")\n        if filters.get("m_area"):\n            v = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_area\\" = \'{v}\'")\n        if filters.get("m_market"):\n            v = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_market\\" = \'{v}\'")\n        if filters.get("construction_gc"):\n            v = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"construction_gc\\" = \'{v}\'")\n        if filters.get("smp_name"):\n            v = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"smp_name\\" = \'{v}\'")\n            # NTM-specific filters (per Nokia Question Bank)\n            if v.strip().upper() == \'NTM\':\n                where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n                where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n    where_sql = " AND ".join(where_parts)\n\n    # No CTEs: use a derived subquery to parse/guard milestone dates\n    sql = f"""\n    SELECT\n      base."rgn_region",\n      base."m_area",\n      base."m_market",\n      base."construction_gc",\n\n      COUNT(DISTINCT CASE WHEN base."parsed_ms_1705" IS NOT NULL THEN base."pj_project_id" END) AS "return_count",\n      COUNT(DISTINCT CASE WHEN base."parsed_ms_1710" IS NOT NULL THEN base."pj_project_id" END) AS "disposal_count",\n      COUNT(DISTINCT CASE WHEN base."parsed_ms_1705" IS NOT NULL AND base."parsed_ms_1710" IS NOT NULL THEN base."pj_project_id" END) AS "both_count",\n      COUNT(DISTINCT CASE\n        WHEN base."ms_1970_integration_complete_actual" IS NOT NULL\n         AND base."parsed_ms_1705" IS NULL\n         AND base."parsed_ms_1710" IS NULL\n        THEN base."pj_project_id" END) AS "neither_count",\n\n      (\n        COUNT(DISTINCT CASE WHEN base."parsed_ms_1705" IS NOT NULL THEN base."pj_project_id" END)\n        + COUNT(DISTINCT CASE WHEN base."parsed_ms_1710" IS NOT NULL THEN base."pj_project_id" END)\n        - COUNT(DISTINCT CASE WHEN base."parsed_ms_1705" IS NOT NULL AND base."parsed_ms_1710" IS NOT NULL THEN base."pj_project_id" END)\n      ) AS "total_resolved",\n\n      100.0 *\n      COUNT(DISTINCT CASE WHEN base."parsed_ms_1705" IS NOT NULL THEN base."pj_project_id" END)\n      / NULLIF((\n        COUNT(DISTINCT CASE WHEN base."parsed_ms_1705" IS NOT NULL THEN base."pj_project_id" END)\n        + COUNT(DISTINCT CASE WHEN base."parsed_ms_1710" IS NOT NULL THEN base."pj_project_id" END)\n        - COUNT(DISTINCT CASE WHEN base."parsed_ms_1705" IS NOT NULL AND base."parsed_ms_1710" IS NOT NULL THEN base."pj_project_id" END)\n      ), 0) AS "return_pct",\n\n      100.0 *\n      COUNT(DISTINCT CASE WHEN base."parsed_ms_1710" IS NOT NULL THEN base."pj_project_id" END)\n      / NULLIF((\n        COUNT(DISTINCT CASE WHEN base."parsed_ms_1705" IS NOT NULL THEN base."pj_project_id" END)\n        + COUNT(DISTINCT CASE WHEN base."parsed_ms_1710" IS NOT NULL THEN base."pj_project_id" END)\n        - COUNT(DISTINCT CASE WHEN base."parsed_ms_1705" IS NOT NULL AND base."parsed_ms_1710" IS NOT NULL THEN base."pj_project_id" END)\n      ), 0) AS "disposal_pct",\n\n      (COUNT(DISTINCT CASE WHEN base."parsed_ms_1705" IS NOT NULL THEN base."pj_project_id" END))::numeric\n      / NULLIF(COUNT(DISTINCT CASE WHEN base."parsed_ms_1710" IS NOT NULL THEN base."pj_project_id" END), 0) AS "return_to_disposal_ratio"\n\n    FROM (\n      SELECT\n        "pj_project_id",\n        "ms_1970_integration_complete_actual",\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "smp_name",\n        "pj_project_status",\n        CASE\n          WHEN ("ms_1705_ahloa_return_actual"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\')\n            THEN "ms_1705_ahloa_return_actual"::timestamp::date\n          ELSE NULL\n        END AS "parsed_ms_1705",\n        CASE\n          WHEN ("ms_1710_ahloa_disposal_actual"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\')\n            THEN "ms_1710_ahloa_disposal_actual"::timestamp::date\n          ELSE NULL\n        END AS "parsed_ms_1710"\n      FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n      WHERE {where_sql}\n    ) base\n    GROUP BY\n      base."rgn_region",\n      base."m_area",\n      base."m_market",\n      base."construction_gc"\n    ORDER BY\n      base."rgn_region",\n      base."m_area",\n      base."m_market",\n      base."construction_gc";\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'ms_1970_integration_complete_actual', 'ms_1705_ahloa_return_actual', 'ms_1710_ahloa_disposal_actual', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'smp_name', 'pj_project_status'], session_id: '69a3d22f26e208edc083a06e', label: 'Return vs Disposal Ratio', kpi_related_core_node_ids: ['project', 'milestone', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '8540b900-55f8-4117-8528-b0db4e8b8533', entity_type: 'kpi', kpi_name: 'Return vs Disposal Ratio', name: '8540b900-55f8-4117-8528-b0db4e8b8533', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures the volume split of AHLOB post-integration radio logistics outcomes—warehouse return vs certified disposal—by region/area/market and General Contractor. Provides return_count, disposal_count, percent mix, and return-to-disposal ratio for warehouse capacity planning and compliance oversight. Includes data-quality diagnostics for sites showing both return and disposal (should be rare/zero) and integrated sites showing neither (pending resolution). AHLOB-specific (applies_to_programs: [\'AHLOB Modernization\']). Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB). When filtered to NTM, automatically applies smp_status=\'Active\' and ntm_project_type exclusions.', status: 'mentioned', node_id: '8540b900-55f8-4117-8528-b0db4e8b8533'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Completion rate and aging/cycle-time stats computed from Project milestone dates in stg_ndpd_mbt_tmobile_macro_combined, grouped by (rgn_region, m_area, m_market, construction_gc) with Dead projects excluded.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region."}, {"column": "m_area", "type": "string", "description": "Area."}, {"column": "m_market", "type": "string", "description": "Market."}, {"column": "construction_gc", "type": "string", "description": "General Contractor."}, {"column": "ix_complete_count", "type": "int", "description": "Distinct projects with Integration Complete date present."}, {"column": "site_mod_complete_count", "type": "int", "description": "Distinct projects with Site Modification Complete date present."}, {"column": "site_mod_pending_count", "type": "int", "description": "Distinct projects with Integration Complete present and Site Modification Complete missing."}, {"column": "site_mod_completion_rate_pct", "type": "float", "description": "100 * site_mod_complete_count / ix_complete_count (NULL when denominator is 0)."}, {"column": "avg_pending_aging_days", "type": "float", "description": "Average days since Integration Complete for pending projects."}, {"column": "avg_site_mod_days", "type": "float", "description": "Average cycle time in days from Integration Complete to Site Modification Complete for completed projects (negative durations excluded)."}]', kpi_business_logic: '1) Start from stg_ndpd_mbt_tmobile_macro_combined and exclude Dead projects via COALESCE(pj_project_status,\'\') <> \'Dead\'. 2) Parse integration complete date ix_dt from pj_a_5275_integration_complete_finish and site mod complete date site_mod_dt from pj_a_5350_site_modification_complete_finish using a regex guard for YYYY-MM-DD then cast to timestamp::date; else set NULL. 3) Group by rgn_region, m_area, m_market, construction_gc. 4) ix_complete_count = distinct count of pj_project_id with ix_dt not null. 5) site_mod_complete_count = distinct count with site_mod_dt not null. 6) site_mod_pending_count = distinct count with ix_dt not null and site_mod_dt null. 7) site_mod_completion_rate_pct = 100 * site_mod_complete_count / NULLIF(ix_complete_count,0). 8) For pending only: pending aging days = CURRENT_DATE - ix_dt; compute avg and p90 percentile. 9) For completed only: cycle time days = site_mod_dt - ix_dt; exclude negative durations; compute avg and p50/p90 percentiles.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Filter to a specific region (exact match on rgn_region)."}, {"name": "m_area", "type": "string", "description": "Filter to a specific area (exact match on m_area)."}, {"name": "m_market", "type": "string", "description": "Filter to a specific market (exact match on m_market)."}, {"name": "construction_gc", "type": "string", "description": "Filter to a specific General Contractor (exact match on construction_gc)."}, {"name": "smp_name", "type": "string", "description": "Filter to a specific SMP/program rollup name (exact match on smp_name)."}]', kpi_contract: '{"function_name": "get_site_mod_complete_rate", "node_type": "kpi", "node_id": "3f84efd6-da76-40f1-9b59-149ac355cce1", "node_label": "Site Mod Complete Rate", "description": "Measures how reliably AHLOB Modernization projects reach the Site Modification Complete gate after Integration Complete. Tracks completion rate, pending backlog and aging (days since integration complete for sites not yet site-mod complete), and the cycle time distribution from integration complete to site modification complete. Used to manage post-integration operational sign-off performance by region/market and General Contractor and to distinguish operational closure from radio return/disposal logistics.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "ix_complete_count", "type": "number", "nullable": false}, {"name": "site_mod_complete_count", "type": "number", "nullable": false}, {"name": "site_mod_pending_count", "type": "number", "nullable": false}, {"name": "site_mod_completion_rate_pct", "type": "null", "nullable": true}, {"name": "avg_pending_aging_days", "type": "null", "nullable": true}, {"name": "avg_site_mod_days", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Completion rate and aging/cycle-time stats computed from Project milestone dates in stg_ndpd_mbt_tmobile_macro_combined, grouped by (rgn_region, m_area, m_market, construction_gc) with Dead projects excluded.', node_type: 'CORE', definition: 'Completion rate and aging/cycle-time stats computed from Project milestone dates in stg_ndpd_mbt_tmobile_macro_combined, grouped by (rgn_region, m_area, m_market, construction_gc) with Dead projects excluded.', kpi_python_function: 'def get_site_mod_complete_rate(execute_query, filters=None) -> list[dict]:\n    # KPI: Site Modification Complete Rate (AHLOB Modernization)\n    # Source: stg_ndpd_mbt_tmobile_macro_combined (wide project/site table)\n\n    where_parts = [\n        "1=1",\n        "COALESCE(\\"pj_project_status\\", \'\') <> \'Dead\'"\n    ]\n\n    if filters:\n        if filters.get("rgn_region"):\n            val = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"rgn_region\\" = \'{val}\'")\n        if filters.get("m_area"):\n            val = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_area\\" = \'{val}\'")\n        if filters.get("m_market"):\n            val = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_market\\" = \'{val}\'")\n        if filters.get("construction_gc"):\n            val = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"construction_gc\\" = \'{val}\'")\n        if filters.get("smp_name"):\n            val = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"smp_name\\" = \'{val}\'")\n            # NTM-specific filters (per Nokia Question Bank)\n            if str(filters.get(\'smp_name\', \'\')).strip().upper() == \'NTM\':\n                where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n                where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n    SELECT\n      base."rgn_region",\n      base."m_area",\n      base."m_market",\n      base."construction_gc",\n\n      COUNT(DISTINCT CASE WHEN base."ix_dt" IS NOT NULL THEN base."pj_project_id" END) AS "ix_complete_count",\n      COUNT(DISTINCT CASE WHEN base."site_mod_dt" IS NOT NULL THEN base."pj_project_id" END) AS "site_mod_complete_count",\n      COUNT(DISTINCT CASE WHEN base."ix_dt" IS NOT NULL AND base."site_mod_dt" IS NULL THEN base."pj_project_id" END) AS "site_mod_pending_count",\n\n      100.0 * COUNT(DISTINCT CASE WHEN base."site_mod_dt" IS NOT NULL THEN base."pj_project_id" END)\n        / NULLIF(COUNT(DISTINCT CASE WHEN base."ix_dt" IS NOT NULL THEN base."pj_project_id" END), 0) AS "site_mod_completion_rate_pct",\n\n      AVG(CASE\n            WHEN base."ix_dt" IS NOT NULL AND base."site_mod_dt" IS NULL\n            THEN (CURRENT_DATE - base."ix_dt")\n          END) AS "avg_pending_aging_days",\n\n\n      AVG(CASE\n            WHEN base."ix_dt" IS NOT NULL AND base."site_mod_dt" IS NOT NULL\n                 AND (base."site_mod_dt" - base."ix_dt") >= 0\n            THEN (base."site_mod_dt" - base."ix_dt")\n          END) AS "avg_site_mod_days"\n\n    FROM (\n      SELECT\n        "pj_project_id",\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n\n        CASE\n          WHEN "pj_a_5275_integration_complete_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n          THEN "pj_a_5275_integration_complete_finish"::timestamp::date\n          ELSE NULL\n        END AS "ix_dt",\n\n        CASE\n          WHEN "pj_a_5350_site_modification_complete_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n          THEN "pj_a_5350_site_modification_complete_finish"::timestamp::date\n          ELSE NULL\n        END AS "site_mod_dt"\n\n      FROM "stg_ndpd_mbt_tmobile_macro_combined"\n      WHERE {where_sql}\n    ) base\n    GROUP BY\n      base."rgn_region",\n      base."m_area",\n      base."m_market",\n      base."construction_gc"\n    ORDER BY\n      base."rgn_region",\n      base."m_area",\n      base."m_market",\n      base."construction_gc";\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'pj_a_5275_integration_complete_finish', 'pj_a_5350_site_modification_complete_finish', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'smp_name', 'pj_project_status'], session_id: '69a3d22f26e208edc083a06e', label: 'Site Mod Complete Rate', kpi_related_core_node_ids: ['project', 'milestone', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '3f84efd6-da76-40f1-9b59-149ac355cce1', entity_type: 'kpi', kpi_name: 'Site Mod Complete Rate', name: '3f84efd6-da76-40f1-9b59-149ac355cce1', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures how reliably AHLOB Modernization projects reach the Site Modification Complete gate after Integration Complete. Tracks completion rate, pending backlog and aging (days since integration complete for sites not yet site-mod complete), and the cycle time distribution from integration complete to site modification complete. Used to manage post-integration operational sign-off performance by region/market and General Contractor and to distinguish operational closure from radio return/disposal logistics. Optionally filterable by program via smp_name (e.g., NTM for Macro, AHLOB Modernization for AHLOB). When filtered to NTM, automatically applies smp_status=Active and ntm_project_type exclusions.', status: 'mentioned', node_id: '3f84efd6-da76-40f1-9b59-149ac355cce1'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined', 'pwc_macro_staging_schema.stg_ndpd_hse_site_checklist'], nl_business_rule: '', kpi_formula_description: 'Swap FTR rate (%) = 100 * (# distinct swap-complete sites (smp_id) with exactly 1 qualifying HSE checklist visit) / (# distinct swap-complete sites (smp_id) with ≥1 qualifying HSE checklist visit). A qualifying HSE visit is a checklist row whose check_in_date is non-blank (TRIM(COALESCE(check_in_date,\'\')) <> \'\'). Results grouped by rgn_region, m_area, m_market, construction_gc.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region (from macro_combined)."}, {"column": "m_area", "type": "string", "description": "Area (from macro_combined)."}, {"column": "m_market", "type": "string", "description": "Market (from macro_combined)."}, {"column": "construction_gc", "type": "string", "description": "General contractor (from macro_combined)."}, {"column": "total_swap_sites", "type": "int", "description": "Distinct swap-complete sites with at least 1 HSE checklist entry (evaluable denominator)."}, {"column": "ftr_sites", "type": "int", "description": "Distinct evaluable sites with exactly 1 HSE checklist entry (numerator)."}, {"column": "non_ftr_sites", "type": "int", "description": "Distinct evaluable sites with more than 1 HSE checklist entry (total_swap_sites - ftr_sites)."}, {"column": "ftr_rate_pct", "type": "float", "description": "First-time-right success rate percentage (100 * ftr_sites / total_swap_sites)."}, {"column": "avg_visits_per_site", "type": "float", "description": "Average HSE checklist visit count per evaluable site (diagnostic)."}]', kpi_business_logic: '1) Start from swap-complete projects in stg_ndpd_mbt_tmobile_macro_combined where pj_a_5175_construction_complete_finish IS NOT NULL and pj_project_status <> \'Dead\'. 2) Join to stg_ndpd_hse_site_checklist on smp_id. 3) Filter checklist rows to only those with a non-empty check_in_date (TRIM(COALESCE(check_in_date,\'\')) <> \'\'). 4) For each (smp_id, rgn_region, m_area, m_market, construction_gc), count qualifying checklist rows as hse_visit_count. 5) Aggregate by (rgn_region, m_area, m_market, construction_gc): total_swap_sites = distinct smp_id; ftr_sites = distinct smp_id where hse_visit_count = 1; non_ftr_sites = total_swap_sites - ftr_sites; ftr_rate_pct = 100 * ftr_sites / total_swap_sites; avg_visits_per_site = average hse_visit_count.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_swap_ftr", "node_type": "kpi", "node_id": "903edc48-5919-4193-be65-9f0beda2c609", "node_label": "Swap FTR", "description": "Measures first-time-right success rate of AHLOB swap execution based on HSE site visit count. A site is First Time Right (FTR) if exactly one HSE site checklist entry was recorded to complete the swap (no rework visits). Denominator: AHLOB sites with construction/swap complete (pj_a_5175_construction_complete_finish present) and with at least one HSE checklist entry (evaluable population). Numerator: subset of denominator with exactly one HSE checklist entry. Reportable by region/area/market/general contractor to identify execution quality and rework burden. Distinct from Site Revisit Rate (NAS integration session revisits) and HSE Daily Compliance Rate (daily gate pass rate).", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "total_swap_sites", "type": "number", "nullable": false}, {"name": "ftr_sites", "type": "number", "nullable": false}, {"name": "non_ftr_sites", "type": "number", "nullable": false}, {"name": "ftr_rate_pct", "type": "string", "nullable": false}, {"name": "avg_visits_per_site", "type": "string", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Swap FTR rate (%) = 100 * (# distinct swap-complete sites (smp_id) with exactly 1 qualifying HSE checklist visit) / (# distinct swap-complete sites (smp_id) with ≥1 qualifying HSE checklist visit). A qualifying HSE visit is a checklist row whose check_in_date is non-blank (TRIM(COALESCE(check_in_date,\'\')) <> \'\'). Results grouped by rgn_region, m_area, m_market, construction_gc.', node_type: 'CORE', definition: 'Swap FTR rate (%) = 100 * (# distinct swap-complete sites (smp_id) with exactly 1 qualifying HSE checklist visit) / (# distinct swap-complete sites (smp_id) with ≥1 qualifying HSE checklist visit). A qualifying HSE visit is a checklist row whose check_in_date is non-blank (TRIM(COALESCE(check_in_date,\'\')) <> \'\'). Results grouped by rgn_region, m_area, m_market, construction_gc.', kpi_python_function: 'def get_swap_ftr(execute_query, filters=None) -> list[dict]:\n    where_parts = [\n        "1=1",\n        "t1.\\"pj_a_5175_construction_complete_finish\\" IS NOT NULL",\n        "COALESCE(t1.\\"pj_project_status\\", \'\') <> \'Dead\'",\n        "TRIM(COALESCE(t2.\\"check_in_date\\", \'\')) <> \'\'"\n    ]\n\n    # Explicit allowlist filters\n    if filters:\n        if filters.get("rgn_region"):\n            v = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f"t1.\\"rgn_region\\" = \'{v}\'")\n        if filters.get("m_area"):\n            v = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f"t1.\\"m_area\\" = \'{v}\'")\n        if filters.get("m_market"):\n            v = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f"t1.\\"m_market\\" = \'{v}\'")\n        if filters.get("construction_gc"):\n            v = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f"t1.\\"construction_gc\\" = \'{v}\'")\n        if filters.get("smp_name"):\n            v = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f"t1.\\"smp_name\\" = \'{v}\'")\n            # NTM-specific filters (per Nokia Question Bank)\n            if v.strip().upper() == \'NTM\':\n                where_parts.append(\'t1."smp_status" = \\\'Active\\\'\')\n                where_parts.append(\'t1."ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n    SELECT\n      base.\\"rgn_region\\" AS \\"rgn_region\\",\n      base.\\"m_area\\" AS \\"m_area\\",\n      base.\\"m_market\\" AS \\"m_market\\",\n      base.\\"construction_gc\\" AS \\"construction_gc\\",\n      COUNT(DISTINCT base.\\"smp_id\\") AS \\"total_swap_sites\\",\n      COUNT(DISTINCT CASE WHEN base.\\"hse_visit_count\\" = 1 THEN base.\\"smp_id\\" END) AS \\"ftr_sites\\",\n      (\n        COUNT(DISTINCT base.\\"smp_id\\")\n        - COUNT(DISTINCT CASE WHEN base.\\"hse_visit_count\\" = 1 THEN base.\\"smp_id\\" END)\n      ) AS \\"non_ftr_sites\\",\n      100.0\n        * COUNT(DISTINCT CASE WHEN base.\\"hse_visit_count\\" = 1 THEN base.\\"smp_id\\" END)\n        / NULLIF(COUNT(DISTINCT base.\\"smp_id\\"), 0) AS \\"ftr_rate_pct\\",\n      AVG(base.\\"hse_visit_count\\"::numeric) AS \\"avg_visits_per_site\\"\n    FROM (\n      SELECT\n        t1.\\"smp_id\\" AS \\"smp_id\\",\n        t1.\\"rgn_region\\" AS \\"rgn_region\\",\n        t1.\\"m_area\\" AS \\"m_area\\",\n        t1.\\"m_market\\" AS \\"m_market\\",\n        t1.\\"construction_gc\\" AS \\"construction_gc\\",\n        COUNT(t2.\\"id\\") AS \\"hse_visit_count\\"\n      FROM \\"pwc_macro_staging_schema\\".\\"stg_ndpd_mbt_tmobile_macro_combined\\" t1\n      INNER JOIN \\"pwc_macro_staging_schema\\".\\"stg_ndpd_hse_site_checklist\\" t2\n        ON t1.\\"smp_id\\" = t2.\\"smp_id\\"\n      WHERE {where_sql}\n      GROUP BY\n        t1.\\"smp_id\\",\n        t1.\\"rgn_region\\",\n        t1.\\"m_area\\",\n        t1.\\"m_market\\",\n        t1.\\"construction_gc\\"\n    ) base\n    GROUP BY\n      base.\\"rgn_region\\",\n      base.\\"m_area\\",\n      base.\\"m_market\\",\n      base.\\"construction_gc\\"\n    ORDER BY\n      base.\\"rgn_region\\",\n      base.\\"m_area\\",\n      base.\\"m_market\\",\n      base.\\"construction_gc\\";\n    """\n\n    return execute_query(sql, )\n', kpi_source_columns: ['stg_ndpd_mbt_tmobile_macro_combined.smp_id', 'stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'stg_ndpd_mbt_tmobile_macro_combined.m_area', 'stg_ndpd_mbt_tmobile_macro_combined.m_market', 'stg_ndpd_mbt_tmobile_macro_combined.construction_gc', 'stg_ndpd_mbt_tmobile_macro_combined.smp_name', 'stg_ndpd_mbt_tmobile_macro_combined.pj_a_5175_construction_complete_finish', 'stg_ndpd_mbt_tmobile_macro_combined.pj_project_status', 'stg_ndpd_hse_site_checklist.smp_id', 'stg_ndpd_hse_site_checklist.id', 'stg_ndpd_hse_site_checklist.check_in_date'], session_id: '69a3d22f26e208edc083a06e', label: 'Swap FTR', kpi_related_core_node_ids: ['project', 'milestone', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '903edc48-5919-4193-be65-9f0beda2c609', entity_type: 'kpi', kpi_name: 'Swap FTR', name: '903edc48-5919-4193-be65-9f0beda2c609', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures first-time-right success rate of AHLOB swap execution based on HSE site visit count. A site is First Time Right (FTR) if exactly one HSE site checklist entry was recorded to complete the swap (no rework visits). Denominator: AHLOB sites with construction/swap complete (pj_a_5175_construction_complete_finish present) and with at least one HSE checklist entry (evaluable population). Numerator: subset of denominator with exactly one HSE checklist entry. Reportable by region/area/market/general contractor to identify execution quality and rework burden. Distinct from Site Revisit Rate (NAS integration session revisits) and HSE Daily Compliance Rate (daily gate pass rate). Optionally filterable by program via smp_name (e.g., NTM for Macro, AHLOB Modernization for AHLOB). When filtered to NTM, automatically applies smp_status=Active and ntm_project_type exclusions.', status: 'mentioned', node_id: '903edc48-5919-4193-be65-9f0beda2c609'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'KPI = for each (rgn_region, m_area, m_market, construction_gc), compute distinct project counts for permit applied/approved/pending and compute avg/p50/p90 of (approved_dt - applied_dt) in days, where milestone text values are parsed to dates only if YYYY-MM-DD-like, excluding Dead projects and applying an smp_name filter with NTM auto-constraints.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Project region."}, {"column": "m_area", "type": "string", "description": "Project area."}, {"column": "m_market", "type": "string", "description": "Project market."}, {"column": "construction_gc", "type": "string", "description": "Construction general contractor."}, {"column": "permit_applied_count", "type": "integer", "description": "Distinct projects with a parseable building permit applied date."}, {"column": "permit_approved_count", "type": "integer", "description": "Distinct projects with a parseable building permit approved date."}, {"column": "permit_pending_count", "type": "integer", "description": "Distinct projects with applied_dt present and approved_dt missing."}, {"column": "avg_permit_days", "type": "numeric", "description": "Average cycle time in days for projects with both dates parseable and non-negative duration."}]', kpi_business_logic: '1) Start with all rows in pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined and exclude projects where COALESCE(pj_project_status,\'\') = \'Dead\'. 2) Derive applied_dt and approved_dt by parsing pj_a_3650_ran_building_permit_applied_finish and pj_a_3675_ran_building_permit_approved_finish only when the text matches ^\\d{4}-\\d{2}-\\d{2}; otherwise treat as NULL. 3) Apply optional dimension filters: smp_name (and if smp_name=\'NTM\' then also enforce smp_status=\'Active\' and ntm_project_type exclusion list), plus rgn_region, m_area, m_market, construction_gc. 4) Group by rgn_region, m_area, m_market, construction_gc. 5) Compute distinct counts: applied (applied_dt not null), approved (approved_dt not null), pending (applied_dt not null AND approved_dt null). 6) For duration stats, use duration_days = approved_dt - applied_dt and include only records where applied_dt and approved_dt are both not null and duration_days >= 0; compute ROUND(AVG(duration_days),2), PERCENTILE_CONT(0.5), and PERCENTILE_CONT(0.9).', kpi_filters: '[{"name": "smp_name", "type": "string", "description": "Filter to a specific SMP name; if smp_name=\'NTM\' (case-insensitive), auto-applies smp_status=\'Active\' and excludes specific ntm_project_type values."}, {"name": "rgn_region", "type": "string", "description": "Filter to a specific region (rgn_region)."}, {"name": "m_area", "type": "string", "description": "Filter to a specific area (m_area)."}, {"name": "m_market", "type": "string", "description": "Filter to a specific market (m_market)."}, {"name": "construction_gc", "type": "string", "description": "Filter to a specific construction general contractor (construction_gc)."}]', kpi_contract: '{"function_name": "get_building_permit_approval_ct", "node_type": "kpi", "node_id": "2aa86a0e-7ec6-4ce8-89a8-c48aa68eef09", "node_label": "Building Permit Approval CT", "description": "Measures the cycle time (days) from building permit application to final approval using milestone dates pj_a_3650_ran_building_permit_applied_finish \\u2192 pj_a_3675_ran_building_permit_approved_finish. Reports applied/approved/pending distinct project counts and duration statistics (avg, p50, p90) by region/area/market and construction GC. Excludes Dead projects, treats only parseable YYYY-MM-DD-like values as valid dates, and applies an smp_name filter with an auto-triggered NTM constraint when smp_name=\'NTM\'.", "parameters": [{"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "permit_applied_count", "type": "number", "nullable": false}, {"name": "permit_approved_count", "type": "number", "nullable": false}, {"name": "permit_pending_count", "type": "number", "nullable": false}, {"name": "avg_permit_days", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'KPI = for each (rgn_region, m_area, m_market, construction_gc), compute distinct project counts for permit applied/approved/pending and compute avg/p50/p90 of (approved_dt - applied_dt) in days, where milestone text values are parsed to dates only if YYYY-MM-DD-like, excluding Dead projects and applying an smp_name filter with NTM auto-constraints.', node_type: 'CORE', definition: 'KPI = for each (rgn_region, m_area, m_market, construction_gc), compute distinct project counts for permit applied/approved/pending and compute avg/p50/p90 of (approved_dt - applied_dt) in days, where milestone text values are parsed to dates only if YYYY-MM-DD-like, excluding Dead projects and applying an smp_name filter with NTM auto-constraints.', kpi_python_function: 'def get_building_permit_approval_ct(execute_query, filters=None) -> list[dict]:\n    where_parts = [\'1=1\']\n    where_parts.append(\'COALESCE("pj_project_status", \\\'\\\') <> \\\'Dead\\\'\')\n\n    if filters is None:\n        filters = {}\n\n    # CRITICAL smp_name + NTM conditional pattern (use EXACT code)\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        # NTM-specific filters (auto-triggered, not caller-controlled)\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    if filters.get("rgn_region"):\n        v = str(filters["rgn_region"]).replace("\'", "\'\'")\n        where_parts.append(f\'"rgn_region" = \\\'{v}\\\'\')\n\n    if filters.get("m_area"):\n        v = str(filters["m_area"]).replace("\'", "\'\'")\n        where_parts.append(f\'"m_area" = \\\'{v}\\\'\')\n\n    if filters.get("m_market"):\n        v = str(filters["m_market"]).replace("\'", "\'\'")\n        where_parts.append(f\'"m_market" = \\\'{v}\\\'\')\n\n    if filters.get("construction_gc"):\n        v = str(filters["construction_gc"]).replace("\'", "\'\'")\n        where_parts.append(f\'"construction_gc" = \\\'{v}\\\'\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n        SELECT\n            base."rgn_region",\n            base."m_area",\n            base."m_market",\n            base."construction_gc",\n            COUNT(DISTINCT CASE WHEN base."applied_dt" IS NOT NULL THEN base."pj_project_id" END) AS "permit_applied_count",\n            COUNT(DISTINCT CASE WHEN base."approved_dt" IS NOT NULL THEN base."pj_project_id" END) AS "permit_approved_count",\n            COUNT(DISTINCT CASE WHEN base."applied_dt" IS NOT NULL AND base."approved_dt" IS NULL THEN base."pj_project_id" END) AS "permit_pending_count",\n            ROUND(\n                AVG(\n                    CASE\n                        WHEN base."applied_dt" IS NOT NULL\n                         AND base."approved_dt" IS NOT NULL\n                         AND (base."approved_dt" - base."applied_dt") >= 0\n                        THEN (base."approved_dt" - base."applied_dt")\n                    END\n                )::numeric,\n                2\n            ) AS "avg_permit_days"\n        FROM (\n            SELECT\n                "pj_project_id",\n                "rgn_region",\n                "m_area",\n                "m_market",\n                "construction_gc",\n                CASE\n                    WHEN "pj_a_3650_ran_building_permit_applied_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n                    THEN "pj_a_3650_ran_building_permit_applied_finish"::timestamp::date\n                END AS "applied_dt",\n                CASE\n                    WHEN "pj_a_3675_ran_building_permit_approved_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n                    THEN "pj_a_3675_ran_building_permit_approved_finish"::timestamp::date\n                END AS "approved_dt"\n            FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n            WHERE {where_sql}\n        ) base\n        GROUP BY\n            base."rgn_region",\n            base."m_area",\n            base."m_market",\n            base."construction_gc"\n        ORDER BY\n            base."rgn_region",\n            base."m_area",\n            base."m_market",\n            base."construction_gc";\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'pj_project_status', 'smp_name', 'smp_status', 'ntm_project_type', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_a_3650_ran_building_permit_applied_finish', 'pj_a_3675_ran_building_permit_approved_finish'], session_id: '69a3d22f26e208edc083a06e', label: 'Building Permit Approval CT', kpi_related_core_node_ids: ['project', 'permit', 'market', 'general_contractor'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '2aa86a0e-7ec6-4ce8-89a8-c48aa68eef09', entity_type: 'kpi', kpi_name: 'Building Permit Approval CT', name: '2aa86a0e-7ec6-4ce8-89a8-c48aa68eef09', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures the cycle time (days) from building permit application to final approval using milestone dates pj_a_3650_ran_building_permit_applied_finish → pj_a_3675_ran_building_permit_approved_finish. Reports applied/approved/pending distinct project counts and duration statistics (avg, p50, p90) by region/area/market and construction GC. Excludes Dead projects, treats only parseable YYYY-MM-DD-like values as valid dates, and applies an smp_name filter with an auto-triggered NTM constraint when smp_name=\'NTM\'.', status: 'mentioned', node_id: '2aa86a0e-7ec6-4ce8-89a8-c48aa68eef09'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Power Install Cycle Time = (pj_a_4550_permanent_power_installed_finish::date − pj_a_4450_permanent_power_ordered_finish::date) in days per project (non-negative only), excluding projects where pj_project_status = \'Dead\'; results aggregated by rgn_region, m_area, m_market, and construction_gc with ordered/installed/pending counts plus average, p50, and p90 cycle time. Optional filters: rgn_region, m_area, m_market, construction_gc, smp_name; if smp_name = \'NTM\' (case-insensitive) additionally requires smp_status=\'Active\' and excludes specific ntm_project_type values.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping."}, {"column": "m_area", "type": "string", "description": "Area grouping."}, {"column": "m_market", "type": "string", "description": "Market grouping."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping."}, {"column": "power_ordered_count", "type": "int", "description": "Distinct projects with a valid permanent power ordered finish date."}, {"column": "power_installed_count", "type": "int", "description": "Distinct projects with a valid permanent power installed finish date."}, {"column": "power_pending_count", "type": "int", "description": "Distinct projects with ordered date present and installed date missing."}, {"column": "avg_power_days", "type": "float", "description": "Average non-negative days between ordered and installed dates (only when both dates exist)."}]', kpi_business_logic: '1) Build WHERE clause starting with COALESCE(pj_project_status,\'\') <> \'Dead\'. 2) Apply optional filters: rgn_region, m_area, m_market, construction_gc, smp_name. 3) If smp_name is \'NTM\' (case-insensitive), additionally filter smp_status=\'Active\' and ntm_project_type NOT IN (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\'). 4) In a subquery, derive power_ordered_date and power_installed_date by regex-validating YYYY-MM-DD text then casting to timestamp::date; otherwise NULL. 5) Aggregate by rgn_region, m_area, m_market, construction_gc: ordered count (distinct pj_project_id with ordered date), installed count (distinct pj_project_id with installed date), pending count (ordered date present and installed date NULL). 6) Compute avg/p50/p90 of (installed_date - ordered_date) for records where both dates exist and duration >= 0.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_power_install_cycle_time", "node_type": "kpi", "node_id": "e0422f03-938a-4d34-a97a-538c82d0d1e9", "node_label": "Power Install Cycle Time", "description": "Measures the average number of days from permanent power ordering to permanent power installation per project/site, using the milestone dates pj_a_4450_permanent_power_ordered_finish to pj_a_4550_permanent_power_installed_finish. This is distinct from the existing Pending Power Installation KPI (which counts ordered-but-not-installed sites without measuring duration). Reported by region/area/market and general contractor, excluding \'Dead\' projects, and excluding negative durations.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "power_ordered_count", "type": "number", "nullable": false}, {"name": "power_installed_count", "type": "number", "nullable": false}, {"name": "power_pending_count", "type": "number", "nullable": false}, {"name": "avg_power_days", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Power Install Cycle Time = (pj_a_4550_permanent_power_installed_finish::date − pj_a_4450_permanent_power_ordered_finish::date) in days per project (non-negative only), excluding projects where pj_project_status = \'Dead\'; results aggregated by rgn_region, m_area, m_market, and construction_gc with ordered/installed/pending counts plus average, p50, and p90 cycle time. Optional filters: rgn_region, m_area, m_market, construction_gc, smp_name; if smp_name = \'NTM\' (case-insensitive) additionally requires smp_status=\'Active\' and excludes specific ntm_project_type values.', node_type: 'CORE', definition: 'Power Install Cycle Time = (pj_a_4550_permanent_power_installed_finish::date − pj_a_4450_permanent_power_ordered_finish::date) in days per project (non-negative only), excluding projects where pj_project_status = \'Dead\'; results aggregated by rgn_region, m_area, m_market, and construction_gc with ordered/installed/pending counts plus average, p50, and p90 cycle time. Optional filters: rgn_region, m_area, m_market, construction_gc, smp_name; if smp_name = \'NTM\' (case-insensitive) additionally requires smp_status=\'Active\' and excludes specific ntm_project_type values.', kpi_python_function: 'def get_power_install_cycle_time(execute_query, filters=None) -> list[dict]:\n    # KPI: Power Install Cycle Time\n    # Program note: supports smp_name; when smp_name == \'NTM\' (case-insensitive), NTM constraints are auto-applied.\n\n    where_parts = ["1=1", "COALESCE(\\"pj_project_status\\", \'\') <> \'Dead\'"]\n\n    if filters:\n        if filters.get("rgn_region"):\n            v = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f\'"rgn_region" = \\\'{v}\\\'\')\n        if filters.get("m_area"):\n            v = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f\'"m_area" = \\\'{v}\\\'\')\n        if filters.get("m_market"):\n            v = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f\'"m_market" = \\\'{v}\\\'\')\n        if filters.get("construction_gc"):\n            v = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f\'"construction_gc" = \\\'{v}\\\'\')\n\n        # CRITICAL — smp_name + NTM conditional pattern\n        if filters.get("smp_name"):\n            v = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n            # NTM-specific filters (auto-triggered, not caller-controlled)\n            if v.strip().upper() == \'NTM\':\n                where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n                where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\nSELECT\n  base."rgn_region",\n  base."m_area",\n  base."m_market",\n  base."construction_gc",\n\n  COUNT(DISTINCT CASE WHEN base."power_ordered_date" IS NOT NULL THEN base."pj_project_id" END) AS "power_ordered_count",\n  COUNT(DISTINCT CASE WHEN base."power_installed_date" IS NOT NULL THEN base."pj_project_id" END) AS "power_installed_count",\n  COUNT(DISTINCT CASE WHEN base."power_ordered_date" IS NOT NULL AND base."power_installed_date" IS NULL THEN base."pj_project_id" END) AS "power_pending_count",\n\n  AVG(CASE\n    WHEN base."power_ordered_date" IS NOT NULL\n     AND base."power_installed_date" IS NOT NULL\n     AND (base."power_installed_date" - base."power_ordered_date") >= 0\n    THEN (base."power_installed_date" - base."power_ordered_date")\n  END)::float AS "avg_power_days"\n\nFROM (\n  SELECT\n    "pj_project_id",\n    "rgn_region",\n    "m_area",\n    "m_market",\n    "construction_gc",\n    CASE\n      WHEN "pj_a_4450_permanent_power_ordered_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n      THEN "pj_a_4450_permanent_power_ordered_finish"::timestamp::date\n      ELSE NULL\n    END AS "power_ordered_date",\n    CASE\n      WHEN "pj_a_4550_permanent_power_installed_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n      THEN "pj_a_4550_permanent_power_installed_finish"::timestamp::date\n      ELSE NULL\n    END AS "power_installed_date"\n  FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n  WHERE {where_sql}\n) base\nGROUP BY\n  base."rgn_region",\n  base."m_area",\n  base."m_market",\n  base."construction_gc"\nORDER BY\n  base."rgn_region",\n  base."m_area",\n  base."m_market",\n  base."construction_gc"\n"""\n\n    return execute_query(sql, db="public", max_rows=None)\n', kpi_source_columns: ['pj_project_id', 'pj_project_status', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'smp_name', 'smp_status', 'ntm_project_type', 'pj_a_4450_permanent_power_ordered_finish', 'pj_a_4550_permanent_power_installed_finish'], session_id: '69a3d22f26e208edc083a06e', label: 'Power Install Cycle Time', kpi_related_core_node_ids: ['project', 'milestone', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'e0422f03-938a-4d34-a97a-538c82d0d1e9', entity_type: 'kpi', kpi_name: 'Power Install Cycle Time', name: 'e0422f03-938a-4d34-a97a-538c82d0d1e9', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures the average number of days from permanent power ordering to permanent power installation per project/site, using the milestone dates pj_a_4450_permanent_power_ordered_finish to pj_a_4550_permanent_power_installed_finish. This is distinct from the existing Pending Power Installation KPI (which counts ordered-but-not-installed sites without measuring duration). Reported by region/area/market and general contractor, excluding \'Dead\' projects, and excluding negative durations.', status: 'mentioned', node_id: 'e0422f03-938a-4d34-a97a-538c82d0d1e9'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'AAV Construction CT = average (and p50/p90) of (pj_a_4950_aav_construction_complete_finish::date − pj_a_4945_aav_construction_start_finish::date) across projects with non-negative durations, with started/completed/pending counts, grouped by region/area/market and construction_gc, optionally filtered by smp_name (and auto-applying NTM constraints when smp_name=\'NTM\').', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Project region."}, {"column": "m_area", "type": "string", "description": "Project area."}, {"column": "m_market", "type": "string", "description": "Project market."}, {"column": "construction_gc", "type": "string", "description": "Assigned construction general contractor."}, {"column": "aav_started_count", "type": "integer", "description": "Distinct count of projects with a valid AAV construction start date."}, {"column": "aav_completed_count", "type": "integer", "description": "Distinct count of projects with a valid AAV construction complete date."}, {"column": "aav_pending_count", "type": "integer", "description": "Distinct count of projects with a valid start date and no valid complete date."}, {"column": "avg_aav_days", "type": "float", "description": "Average non-negative duration_days from AAV construction start to completion."}]', kpi_business_logic: '1) Read projects from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined and exclude Dead projects via COALESCE(pj_project_status,\'\') <> \'Dead\'. 2) Parse AAV start and complete milestone fields into dates only when the text matches YYYY-MM-DD; otherwise treat as NULL. 3) Compute duration_days = complete_date - start_date when both dates exist; otherwise NULL. 4) Exclude negative durations (keep duration_days >= 0; allow NULLs so started/pending counts still work). 5) Aggregate by rgn_region, m_area, m_market, construction_gc: started_count = distinct projects with start_date not null; completed_count = distinct projects with complete_date not null; pending_count = distinct projects with start_date not null and complete_date null. 6) For duration metrics, compute AVG(duration_days), PERCENTILE_CONT(0.5) and PERCENTILE_CONT(0.9) over duration_days (NULLs ignored by aggregates). 7) Apply optional filters: rgn_region, m_area, m_market, construction_gc, and smp_name; when smp_name=\'NTM\' (case-insensitive after strip), also apply smp_status=\'Active\' and exclude ntm_project_type in the specified list.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Filter to a specific region (exact match on rgn_region)."}, {"name": "m_area", "type": "string", "description": "Filter to a specific area (exact match on m_area)."}, {"name": "m_market", "type": "string", "description": "Filter to a specific market (exact match on m_market)."}, {"name": "construction_gc", "type": "string", "description": "Filter to a specific assigned construction general contractor (exact match on construction_gc)."}, {"name": "smp_name", "type": "string", "description": "Filter by program name (exact match on smp_name). Note: if smp_name is \'NTM\' (case-insensitive), the query auto-applies smp_status=\'Active\' and excludes specified ntm_project_type values."}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Optional filter on the construction-start delay code column. When provided, the query adds: pj_construction_start_delay_code IS NOT NULL AND pj_construction_start_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}, {"name": "pj_construction_complete_delay_code", "type": "string", "description": "Optional filter on the construction-complete delay code column. When provided, the query adds: pj_construction_complete_delay_code IS NOT NULL AND pj_construction_complete_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}]', kpi_contract: '{"function_name": "get_aav_construction_ct", "node_type": "kpi", "node_id": "0e62b7e5-980a-469a-b732-fab166e897d5", "node_label": "AAV Construction CT", "description": "Measures the average number of days from AAV construction start to AAV construction completion for projects, to quantify the duration of the AAV fiber/access construction phase. Computed as the elapsed days between `pj_a_4945_aav_construction_start_finish` and `pj_a_4950_aav_construction_complete_finish`, excluding negative durations. Includes started/completed/pending counts plus average and p50/p90 duration metrics, sliceable by region/area/market and assigned construction GC, with optional program filter `smp_name` (including the NTM auto-constraints when `smp_name = \'NTM\'`). Distinct from AAV vs MW Ratio (backhaul mix) and Civil Cycle Time (civil construction scope).", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Filter to projects with a specific construction-start delay code, or any real start delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}, {"name": "pj_construction_complete_delay_code", "type": "string", "description": "Filter to projects with a specific construction-complete delay code, or any real complete delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "aav_started_count", "type": "number", "nullable": false}, {"name": "aav_completed_count", "type": "number", "nullable": false}, {"name": "aav_pending_count", "type": "number", "nullable": false}, {"name": "avg_aav_days", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'AAV Construction CT = average (and p50/p90) of (pj_a_4950_aav_construction_complete_finish::date − pj_a_4945_aav_construction_start_finish::date) across projects with non-negative durations, with started/completed/pending counts, grouped by region/area/market and construction_gc, optionally filtered by smp_name (and auto-applying NTM constraints when smp_name=\'NTM\').', node_type: 'CORE', definition: 'AAV Construction CT = average (and p50/p90) of (pj_a_4950_aav_construction_complete_finish::date − pj_a_4945_aav_construction_start_finish::date) across projects with non-negative durations, with started/completed/pending counts, grouped by region/area/market and construction_gc, optionally filtered by smp_name (and auto-applying NTM constraints when smp_name=\'NTM\').', kpi_python_function: 'def get_aav_construction_ct(execute_query, filters=None) -> list[dict]:\n    where_parts = ["1=1", "COALESCE(\\"pj_project_status\\", \'\') <> \'Dead\'"]\n\n    # Optional filters (explicit allowlist)\n    if filters:\n        if filters.get("rgn_region"):\n            v = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f\'"rgn_region" = \\\'{v}\\\'\')\n        if filters.get("m_area"):\n            v = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f\'"m_area" = \\\'{v}\\\'\')\n        if filters.get("m_market"):\n            v = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f\'"m_market" = \\\'{v}\\\'\')\n        if filters.get("construction_gc"):\n            v = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f\'"construction_gc" = \\\'{v}\\\'\')\n\n        # Program filter + required NTM auto-constraints (EXACT pattern requested)\n        if filters.get("smp_name"):\n            v = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n            # NTM-specific filters (auto-triggered, not caller-controlled)\n            if v.strip().upper() == \'NTM\':\n                where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n                where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n\n    # Optional construction delay-code filters (engage when caller wants to narrow to delayed projects)\n\n    for _delay_col in ("pj_construction_start_delay_code", "pj_construction_complete_delay_code"):\n\n        _v = filters.get(_delay_col)\n\n        if _v is None or str(_v).strip() == "":\n\n            continue\n\n        _s = str(_v).strip()\n\n        where_parts.append(f\'"{_delay_col}" IS NOT NULL\')\n\n        where_parts.append(f\'"{_delay_col}" <> \\\'No Delay\\\'\')\n\n        if _s.lower() not in ("any", "true", "yes", "1", "*"):\n\n            _ss = _s.replace("\'", "\'\'")\n\n            where_parts.append(f\'"{_delay_col}" = \\\'{_ss}\\\'\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\nSELECT\n  base."rgn_region" AS "rgn_region",\n  base."m_area" AS "m_area",\n  base."m_market" AS "m_market",\n  base."construction_gc" AS "construction_gc",\n\n  COUNT(DISTINCT CASE WHEN base."aav_start_date" IS NOT NULL THEN base."pj_project_id" END) AS "aav_started_count",\n  COUNT(DISTINCT CASE WHEN base."aav_complete_date" IS NOT NULL THEN base."pj_project_id" END) AS "aav_completed_count",\n  COUNT(DISTINCT CASE WHEN base."aav_start_date" IS NOT NULL AND base."aav_complete_date" IS NULL THEN base."pj_project_id" END) AS "aav_pending_count",\n\n  AVG(base."duration_days") AS "avg_aav_days"\nFROM (\n  SELECT\n    "pj_project_id",\n    "rgn_region",\n    "m_area",\n    "m_market",\n    "construction_gc",\n\n    CASE\n      WHEN "pj_a_4945_aav_construction_start_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n      THEN "pj_a_4945_aav_construction_start_finish"::timestamp::date\n      ELSE NULL\n    END AS "aav_start_date",\n\n    CASE\n      WHEN "pj_a_4950_aav_construction_complete_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n      THEN "pj_a_4950_aav_construction_complete_finish"::timestamp::date\n      ELSE NULL\n    END AS "aav_complete_date",\n\n    CASE\n      WHEN\n        (CASE\n           WHEN "pj_a_4945_aav_construction_start_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n           THEN "pj_a_4945_aav_construction_start_finish"::timestamp::date\n           ELSE NULL\n         END) IS NOT NULL\n        AND\n        (CASE\n           WHEN "pj_a_4950_aav_construction_complete_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n           THEN "pj_a_4950_aav_construction_complete_finish"::timestamp::date\n           ELSE NULL\n         END) IS NOT NULL\n      THEN (\n        (CASE\n           WHEN "pj_a_4950_aav_construction_complete_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n           THEN "pj_a_4950_aav_construction_complete_finish"::timestamp::date\n           ELSE NULL\n         END)\n        -\n        (CASE\n           WHEN "pj_a_4945_aav_construction_start_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n           THEN "pj_a_4945_aav_construction_start_finish"::timestamp::date\n           ELSE NULL\n         END)\n      )\n      ELSE NULL\n    END AS "duration_days"\n  FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n  WHERE {where_sql}\n) base\nWHERE base."duration_days" IS NULL OR base."duration_days" >= 0\nGROUP BY\n  base."rgn_region",\n  base."m_area",\n  base."m_market",\n  base."construction_gc"\nORDER BY\n  base."rgn_region",\n  base."m_area",\n  base."m_market",\n  base."construction_gc"\n"""\n\n    return execute_query(sql, db="public")\n', kpi_source_columns: ['pj_project_id', 'pj_project_status', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_a_4945_aav_construction_start_finish', 'pj_a_4950_aav_construction_complete_finish', 'smp_name', 'smp_status', 'ntm_project_type', 'pj_construction_start_delay_code', 'pj_construction_complete_delay_code'], session_id: '69a3d22f26e208edc083a06e', label: 'AAV Construction CT', kpi_related_core_node_ids: ['project', 'milestone', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '0e62b7e5-980a-469a-b732-fab166e897d5', entity_type: 'kpi', kpi_name: 'AAV Construction CT', name: '0e62b7e5-980a-469a-b732-fab166e897d5', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures the average number of days from AAV construction start to AAV construction completion for projects, to quantify the duration of the AAV fiber/access construction phase. Computed as the elapsed days between `pj_a_4945_aav_construction_start_finish` and `pj_a_4950_aav_construction_complete_finish`, excluding negative durations. Includes started/completed/pending counts plus average and p50/p90 duration metrics, sliceable by region/area/market and assigned construction GC, with optional program filter `smp_name` (including the NTM auto-constraints when `smp_name = \'NTM\'`). Distinct from AAV vs MW Ratio (backhaul mix) and Civil Cycle Time (civil construction scope). Optionally filterable by construction delay code: pass pj_construction_start_delay_code or pj_construction_complete_delay_code (any non-empty value engages IS NOT NULL AND <> \'No Delay\'; a specific code value also narrows to that code).', status: 'mentioned', node_id: '0e62b7e5-980a-469a-b732-fab166e897d5'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'One-sentence formula: Close Out Binder Approval = f(Project, Milestone, General Contractor, Market) computed from stg_ndpd_mbt_tmobile_macro_combined as approved/received distinct-project counts plus pending count and approval cycle-time stats (avg/p50/p90 days) between received and approved dates.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "construction_gc", "type": "string", "description": "General Contractor dimension (from construction_gc)."}, {"column": "binder_received_count", "type": "integer", "description": "Distinct project count with a parsed close-out binder received date (pj_a_5500...)."}, {"column": "binder_approved_count", "type": "integer", "description": "Distinct project count with a parsed close-out binder approved date (pj_a_5525...)."}, {"column": "binder_pending_count", "type": "integer", "description": "Distinct project count with received present but approved missing."}, {"column": "approval_rate_pct", "type": "float", "description": "Approval rate percentage = 100 * approved_count / received_count, rounded to 2 decimals."}, {"column": "avg_approval_days", "type": "float", "description": "Average (in days) of (approved_date - received_date) for records where both dates exist and the difference is non-negative."}]', kpi_business_logic: '1) Filter rows from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined with seed condition 1=1 and exclude Dead projects (COALESCE(pj_project_status,\'\')<>\'Dead\'), plus optional dimension filters (rgn_region, m_area, m_market, construction_gc, smp_name) and the required NTM auto-constraints when smp_name == \'NTM\'. 2) Parse pj_a_5500_receive_close_out_binder_finish and pj_a_5525_approve_close_out_binder_finish into dates using regex guard \'^YYYY-MM-DD\' then ::timestamp::date else NULL. 3) Group by rgn_region, m_area, m_market, construction_gc. 4) Denominator binder_received_count = COUNT(DISTINCT pj_project_id) where parsed_5500 is not null. 5) Numerator binder_approved_count = COUNT(DISTINCT pj_project_id) where parsed_5525 is not null. 6) Pending binder_pending_count = COUNT(DISTINCT pj_project_id) where parsed_5500 is not null and parsed_5525 is null. 7) approval_rate_pct = ROUND(100*binder_approved_count/NULLIF(binder_received_count,0),2). 8) Compute approval_days = parsed_5525 - parsed_5500 only when both present and non-negative; report avg_approval_days as AVG(approval_days) and p50/p90 via PERCENTILE_CONT over approval_days.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Filter to a specific region (exact match on rgn_region)."}, {"name": "m_area", "type": "string", "description": "Filter to a specific area (exact match on m_area)."}, {"name": "m_market", "type": "string", "description": "Filter to a specific market (exact match on m_market)."}, {"name": "construction_gc", "type": "string", "description": "Filter to a specific General Contractor (exact match on construction_gc)."}, {"name": "smp_name", "type": "string", "description": "Filter to a specific SMP name; NOTE: when smp_name is \'NTM\' (case-insensitive), the KPI auto-applies smp_status=\'Active\' and excludes certain ntm_project_type values."}]', kpi_contract: '{"function_name": "get_close_out_binder_approval", "node_type": "kpi", "node_id": "45a32135-cea1-4d78-9143-bf67b709de54", "node_label": "Close Out Binder Approval", "description": "Measures the percentage of projects where the close-out binder has been approved after being received, and the typical approval turnaround time. Denominator is projects with a received close-out binder date present; numerator is projects with an approved close-out binder date present. Also reports pending (received but not approved) and approval cycle-time distribution (avg/p50/p90 days) to diagnose documentation gate delays late in Acceptance & Payment.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "binder_received_count", "type": "number", "nullable": false}, {"name": "binder_approved_count", "type": "number", "nullable": false}, {"name": "binder_pending_count", "type": "number", "nullable": false}, {"name": "approval_rate_pct", "type": "null", "nullable": true}, {"name": "avg_approval_days", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'One-sentence formula: Close Out Binder Approval = f(Project, Milestone, General Contractor, Market) computed from stg_ndpd_mbt_tmobile_macro_combined as approved/received distinct-project counts plus pending count and approval cycle-time stats (avg/p50/p90 days) between received and approved dates.', node_type: 'CORE', definition: 'One-sentence formula: Close Out Binder Approval = f(Project, Milestone, General Contractor, Market) computed from stg_ndpd_mbt_tmobile_macro_combined as approved/received distinct-project counts plus pending count and approval cycle-time stats (avg/p50/p90 days) between received and approved dates.', kpi_python_function: 'def get_close_out_binder_approval(execute_query, filters=None) -> list[dict]:\n    # KPI: Close Out Binder Approval\n    # Source: pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n\n    where_parts = [\n        "1=1",\n        "COALESCE(\\"pj_project_status\\", \'\') <> \'Dead\'"\n    ]\n\n    if filters:\n        if filters.get("rgn_region"):\n            v = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f\'"rgn_region" = \\\'{v}\\\'\')\n\n        if filters.get("m_area"):\n            v = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f\'"m_area" = \\\'{v}\\\'\')\n\n        if filters.get("m_market"):\n            v = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f\'"m_market" = \\\'{v}\\\'\')\n\n        if filters.get("construction_gc"):\n            v = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f\'"construction_gc" = \\\'{v}\\\'\')\n\n        # CRITICAL — smp_name + NTM conditional pattern (use EXACT code)\n        if filters.get("smp_name"):\n            v = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n            # NTM-specific filters (auto-triggered, not caller-controlled)\n            if v.strip().upper() == \'NTM\':\n                where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n                where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n    SELECT\n      "rgn_region",\n      "m_area",\n      "m_market",\n      "construction_gc" AS "construction_gc",\n\n      COUNT(DISTINCT CASE WHEN "parsed_5500" IS NOT NULL THEN "pj_project_id" END) AS "binder_received_count",\n      COUNT(DISTINCT CASE WHEN "parsed_5525" IS NOT NULL THEN "pj_project_id" END) AS "binder_approved_count",\n      COUNT(DISTINCT CASE WHEN "parsed_5500" IS NOT NULL AND "parsed_5525" IS NULL THEN "pj_project_id" END) AS "binder_pending_count",\n\n      ROUND(\n        100.0\n        * COUNT(DISTINCT CASE WHEN "parsed_5525" IS NOT NULL THEN "pj_project_id" END)\n        / NULLIF(COUNT(DISTINCT CASE WHEN "parsed_5500" IS NOT NULL THEN "pj_project_id" END), 0)\n      , 2) AS "approval_rate_pct",\n\n      AVG(\n        CASE\n          WHEN "parsed_5500" IS NOT NULL\n           AND "parsed_5525" IS NOT NULL\n           AND ("parsed_5525" - "parsed_5500") >= 0\n          THEN ("parsed_5525" - "parsed_5500")\n          ELSE NULL\n        END\n      ) AS "avg_approval_days"\n\n    FROM (\n      SELECT\n        "pj_project_id",\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n\n        CASE\n          WHEN "pj_a_5500_receive_close_out_binder_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n          THEN "pj_a_5500_receive_close_out_binder_finish"::timestamp::date\n          ELSE NULL\n        END AS "parsed_5500",\n\n        CASE\n          WHEN "pj_a_5525_approve_close_out_binder_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n          THEN "pj_a_5525_approve_close_out_binder_finish"::timestamp::date\n          ELSE NULL\n        END AS "parsed_5525",\n\n        CASE\n          WHEN (CASE\n                  WHEN "pj_a_5500_receive_close_out_binder_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n                  THEN "pj_a_5500_receive_close_out_binder_finish"::timestamp::date\n                  ELSE NULL\n                END) IS NOT NULL\n           AND (CASE\n                  WHEN "pj_a_5525_approve_close_out_binder_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n                  THEN "pj_a_5525_approve_close_out_binder_finish"::timestamp::date\n                  ELSE NULL\n                END) IS NOT NULL\n           AND (\n                (CASE\n                  WHEN "pj_a_5525_approve_close_out_binder_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n                  THEN "pj_a_5525_approve_close_out_binder_finish"::timestamp::date\n                  ELSE NULL\n                 END)\n                -\n                (CASE\n                  WHEN "pj_a_5500_receive_close_out_binder_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n                  THEN "pj_a_5500_receive_close_out_binder_finish"::timestamp::date\n                  ELSE NULL\n                 END)\n              ) >= 0\n          THEN (\n                (CASE\n                  WHEN "pj_a_5525_approve_close_out_binder_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n                  THEN "pj_a_5525_approve_close_out_binder_finish"::timestamp::date\n                  ELSE NULL\n                 END)\n                -\n                (CASE\n                  WHEN "pj_a_5500_receive_close_out_binder_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n                  THEN "pj_a_5500_receive_close_out_binder_finish"::timestamp::date\n                  ELSE NULL\n                 END)\n               )\n          ELSE NULL\n        END AS "approval_days"\n\n      FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n      WHERE {where_sql}\n    ) base\n\n    GROUP BY\n      "rgn_region",\n      "m_area",\n      "m_market",\n      "construction_gc"\n\n    ORDER BY\n      "rgn_region",\n      "m_area",\n      "m_market",\n      "construction_gc";\n    """\n\n    return execute_query(sql, db="public")\n', kpi_source_columns: ['pj_project_id', 'pj_project_status', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'smp_name', 'smp_status', 'ntm_project_type', 'pj_a_5500_receive_close_out_binder_finish', 'pj_a_5525_approve_close_out_binder_finish'], session_id: '69a3d22f26e208edc083a06e', label: 'Close Out Binder Approval', kpi_related_core_node_ids: ['project', 'milestone', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '45a32135-cea1-4d78-9143-bf67b709de54', entity_type: 'kpi', kpi_name: 'Close Out Binder Approval', name: '45a32135-cea1-4d78-9143-bf67b709de54', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures the percentage of projects where the close-out binder has been approved after being received, and the typical approval turnaround time. Denominator is projects with a received close-out binder date present; numerator is projects with an approved close-out binder date present. Also reports pending (received but not approved) and approval cycle-time distribution (avg/p50/p90 days) to diagnose documentation gate delays late in Acceptance & Payment.', status: 'mentioned', node_id: '45a32135-cea1-4d78-9143-bf67b709de54'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Average (and p50/p90) of (RFDS scoping approved date − scoping completion date) in days, using only pj_rfds_scoping_approved_date_rfds as the approval date, for projects with valid parsed YYYY-MM-DD dates; grouped by region/area/market/GC. Also returns counts of scoping-complete (start_date present), approved (end_date present), and pending approvals (start_date present and end_date null).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping."}, {"column": "m_area", "type": "string", "description": "Area grouping."}, {"column": "m_market", "type": "string", "description": "Market grouping."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping."}, {"column": "rfds_scoping_count", "type": "int", "description": "Distinct count of projects with a valid scoping completion (start) date."}, {"column": "rfds_approved_count", "type": "int", "description": "Distinct count of projects with a valid RFDS scoping approval (end) date."}, {"column": "rfds_pending_count", "type": "int", "description": "Distinct count of projects with scoping complete (start present) but RFDS scoping approval missing (end null)."}, {"column": "avg_rfds_days", "type": "float", "description": "Average days between scoping completion and RFDS scoping approval for non-negative durations."}]', kpi_business_logic: 'Filter out projects where pj_project_status = \'Dead\' (null-safe).\nApply optional dimension filters: rgn_region, m_area, m_market, construction_gc.\nIf smp_name is provided, filter to that smp_name; if it equals \'NTM\' (case-insensitive), additionally require smp_status=\'Active\' and exclude specific ntm_project_type values.\nParse scoping completion date start_date from pj_a_1000_ran_project_scoping_finish when it matches YYYY-MM-DD; otherwise null.\nParse RFDS scoping approval date end_date from pj_rfds_scoping_approved_date_rfds when it matches YYYY-MM-DD; otherwise null.\nApply optional start_date/end_date filters to the parsed start_date (scoping completion cohorting).\nCompute duration_days = end_date - start_date (integer days) when both dates exist; keep negative values but exclude them from avg/p50/p90 via duration_days >= 0 condition.\nAggregate by rgn_region, m_area, m_market, construction_gc to produce counts and percentiles.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}, {"name": "start_date", "type": "string", "description": ""}, {"name": "end_date", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_rfds_scoping_approval_ct", "node_type": "kpi", "node_id": "6cd26de0-2250-4d85-bd04-18ac0665eb2d", "node_label": "RFDS Scoping Approval CT", "description": "Measures average days from RFDS scoping completion to RFDS approval, to quantify latency in the RF design specification approval gate. Calculated as the time gap between `pj_a_1000_ran_project_scoping_finish` (scoping complete) and the RFDS scoping approval date (per staging column; validate exact field name). Includes counts for scoping-complete, approved, and pending approvals and percentile cycle times. Useful for surfacing approval bottlenecks by region/market/GC and distinguishing RFDS approval performance from broader scoping package cycle-time metrics.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "rfds_scoping_count", "type": "number", "nullable": false}, {"name": "rfds_approved_count", "type": "number", "nullable": false}, {"name": "rfds_pending_count", "type": "number", "nullable": false}, {"name": "avg_rfds_days", "type": "string", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Average (and p50/p90) of (RFDS scoping approved date − scoping completion date) in days, using only pj_rfds_scoping_approved_date_rfds as the approval date, for projects with valid parsed YYYY-MM-DD dates; grouped by region/area/market/GC. Also returns counts of scoping-complete (start_date present), approved (end_date present), and pending approvals (start_date present and end_date null).', node_type: 'CORE', definition: 'Average (and p50/p90) of (RFDS scoping approved date − scoping completion date) in days, using only pj_rfds_scoping_approved_date_rfds as the approval date, for projects with valid parsed YYYY-MM-DD dates; grouped by region/area/market/GC. Also returns counts of scoping-complete (start_date present), approved (end_date present), and pending approvals (start_date present and end_date null).', kpi_python_function: 'def get_rfds_scoping_approval_ct(execute_query, filters=None) -> list[dict]:\n    # RFDS Scoping Approval CT\n    # Computes cycle time (days) from scoping completion to RFDS scoping approval.\n    # Program note: supports smp_name filter; if smp_name == \'NTM\' then auto-applies NTM-specific constraints.\n\n    allowed_filters = {"rgn_region", "m_area", "m_market", "construction_gc", "smp_name", "start_date", "end_date"}\n    filters = filters or {}\n\n    where_parts = ["1=1", "COALESCE(\\"pj_project_status\\", \'\') <> \'Dead\'"]\n\n    # Explicit allowlist filters (no generic iteration)\n    if filters.get("rgn_region"):\n        v = str(filters["rgn_region"]).replace("\'", "\'\'")\n        where_parts.append(f\'"rgn_region" = \\\'{v}\\\'\')\n\n    if filters.get("m_area"):\n        v = str(filters["m_area"]).replace("\'", "\'\'")\n        where_parts.append(f\'"m_area" = \\\'{v}\\\'\')\n\n    if filters.get("m_market"):\n        v = str(filters["m_market"]).replace("\'", "\'\'")\n        where_parts.append(f\'"m_market" = \\\'{v}\\\'\')\n\n    if filters.get("construction_gc"):\n        v = str(filters["construction_gc"]).replace("\'", "\'\'")\n        where_parts.append(f\'"construction_gc" = \\\'{v}\\\'\')\n\n    # CRITICAL — smp_name + NTM conditional pattern\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    # Date range filter applies to parsed start (scoping finish) date\n    if filters.get("start_date"):\n        v = str(filters["start_date"]).replace("\'", "\'\'")\n        where_parts.append(\n            "(CASE WHEN \\"pj_a_1000_ran_project_scoping_finish\\"::text ~ \'^\\\\\\\\d{4}-\\\\\\\\d{2}-\\\\\\\\d{2}\' "\n            "THEN \\"pj_a_1000_ran_project_scoping_finish\\"::timestamp::date ELSE NULL END) >= "\n            f"\'{v}\'::date"\n        )\n\n    if filters.get("end_date"):\n        v = str(filters["end_date"]).replace("\'", "\'\'")\n        where_parts.append(\n            "(CASE WHEN \\"pj_a_1000_ran_project_scoping_finish\\"::text ~ \'^\\\\\\\\d{4}-\\\\\\\\d{2}-\\\\\\\\d{2}\' "\n            "THEN \\"pj_a_1000_ran_project_scoping_finish\\"::timestamp::date ELSE NULL END) <= "\n            f"\'{v}\'::date"\n        )\n\n    where_clause = " AND ".join(where_parts)\n\n    sql = f"""\nSELECT\n  "rgn_region",\n  "m_area",\n  "m_market",\n  "construction_gc",\n  COUNT(DISTINCT CASE WHEN "start_date" IS NOT NULL THEN "pj_project_id" END) AS "rfds_scoping_count",\n  COUNT(DISTINCT CASE WHEN "end_date" IS NOT NULL THEN "pj_project_id" END) AS "rfds_approved_count",\n  COUNT(DISTINCT CASE WHEN "start_date" IS NOT NULL AND "end_date" IS NULL THEN "pj_project_id" END) AS "rfds_pending_count",\n  AVG(CASE WHEN "duration_days" >= 0 THEN "duration_days" END) AS "avg_rfds_days"\nFROM (\n  SELECT\n    "pj_project_id",\n    "rgn_region",\n    "m_area",\n    "m_market",\n    "construction_gc",\n\n    CASE\n      WHEN "pj_a_1000_ran_project_scoping_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n        THEN "pj_a_1000_ran_project_scoping_finish"::timestamp::date\n      ELSE NULL\n    END AS "start_date",\n\n    CASE\n      WHEN "pj_rfds_scoping_approved_date_rfds"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n        THEN "pj_rfds_scoping_approved_date_rfds"::timestamp::date\n      ELSE NULL\n    END AS "end_date",\n\n    (\n      (\n        CASE\n          WHEN "pj_rfds_scoping_approved_date_rfds"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n            THEN "pj_rfds_scoping_approved_date_rfds"::timestamp::date\n          ELSE NULL\n        END\n      )\n      -\n      (\n        CASE\n          WHEN "pj_a_1000_ran_project_scoping_finish"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n            THEN "pj_a_1000_ran_project_scoping_finish"::timestamp::date\n          ELSE NULL\n        END\n      )\n    )::int AS "duration_days"\n\n  FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n  WHERE {where_clause}\n) base\nGROUP BY\n  "rgn_region",\n  "m_area",\n  "m_market",\n  "construction_gc"\nORDER BY\n  "rgn_region",\n  "m_area",\n  "m_market",\n  "construction_gc";\n"""\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'pj_project_status', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'smp_name', 'smp_status', 'ntm_project_type', 'pj_a_1000_ran_project_scoping_finish', 'pj_rfds_scoping_approved_date_rfds'], session_id: '69a3d22f26e208edc083a06e', label: 'RFDS Scoping Approval CT', kpi_related_core_node_ids: ['project', 'milestone', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '6cd26de0-2250-4d85-bd04-18ac0665eb2d', entity_type: 'kpi', kpi_name: 'RFDS Scoping Approval CT', name: '6cd26de0-2250-4d85-bd04-18ac0665eb2d', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures average days from RFDS scoping completion to RFDS approval, to quantify latency in the RF design specification approval gate. Calculated as the time gap between `pj_a_1000_ran_project_scoping_finish` (scoping complete) and the RFDS scoping approval date (per staging column; validate exact field name). Includes counts for scoping-complete, approved, and pending approvals and percentile cycle times. Useful for surfacing approval bottlenecks by region/market/GC and distinguishing RFDS approval performance from broader scoping package cycle-time metrics.', status: 'mentioned', node_id: '6cd26de0-2250-4d85-bd04-18ac0665eb2d'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Zoning Approval Cycle Time (days) is computed per project as (zoning approved finish date - zoning applied finish date) using pj_a_3575_ran_zoning_approved_finish and pj_a_3550_ran_zoning_applied_finish. The KPI aggregates by rgn_region, m_area, m_market, and construction_gc, returning distinct project counts for applied/approved/pending zoning status plus avg/p50/p90 of non-negative durations for projects with both dates present. Projects with pj_project_status=\'Dead\' are excluded. If smp_name is filtered to \'NTM\' (case/whitespace-insensitive), additional constraints are automatically applied: smp_status=\'Active\' and ntm_project_type NOT IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\').', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension from macro_combined."}, {"column": "m_area", "type": "string", "description": "Area dimension from macro_combined."}, {"column": "m_market", "type": "string", "description": "Market dimension from macro_combined."}, {"column": "construction_gc", "type": "string", "description": "Assigned construction general contractor (free-text)."}, {"column": "zoning_applied_count", "type": "integer", "description": "Distinct count of projects with a valid zoning applied date."}, {"column": "zoning_approved_count", "type": "integer", "description": "Distinct count of projects with a valid zoning approved date."}, {"column": "zoning_pending_count", "type": "integer", "description": "Distinct count of projects with applied date present and approved date missing."}, {"column": "avg_zoning_days", "type": "float", "description": "Average (mean) zoning cycle time in days for projects with both dates present and non-negative duration."}]', kpi_business_logic: '1) Start with all records from stg_ndpd_mbt_tmobile_macro_combined and exclude projects where pj_project_status = \'Dead\'. 2) Apply optional filters: rgn_region, m_area, m_market, construction_gc, and smp_name. 3) If smp_name is provided and equals \'NTM\' after strip().upper(), also require smp_status=\'Active\' and exclude rows where ntm_project_type is in (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\'). 4) Parse pj_a_3550_ran_zoning_applied_finish and pj_a_3575_ran_zoning_approved_finish as dates when they look like ISO dates; otherwise treat as NULL. 5) Compute duration_days = zoning_approved_dt - zoning_applied_dt (date difference in days). 6) Aggregate by rgn_region, m_area, m_market, construction_gc: (a) zoning_applied_count = distinct projects with applied date, (b) zoning_approved_count = distinct projects with approved date, (c) zoning_pending_count = distinct projects with applied date and no approved date, (d) avg/p50/p90 of duration_days for projects with both dates present and duration_days >= 0.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_zoning_approval_ct", "node_type": "kpi", "node_id": "6d46d5d6-98eb-48d4-bfe1-f4c19b6bad2d", "node_label": "Zoning Approval CT", "description": "Measures the cycle time (days) from zoning application submission to zoning approval, using milestones pj_a_3550_ran_zoning_applied_finish (start) and pj_a_3575_ran_zoning_approved_finish (end). Reported by region/area/market and assigned construction GC to monitor pre-construction gate performance, identify bottlenecks, and quantify pending zoning backlog. Includes applied/approved/pending project counts and avg/median/p90 days for projects with valid non-negative durations; excludes Dead projects and supports program filters (smp_name and NTM-conditional constraints when applicable).", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "zoning_applied_count", "type": "number", "nullable": false}, {"name": "zoning_approved_count", "type": "number", "nullable": false}, {"name": "zoning_pending_count", "type": "number", "nullable": false}, {"name": "avg_zoning_days", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Zoning Approval Cycle Time (days) is computed per project as (zoning approved finish date - zoning applied finish date) using pj_a_3575_ran_zoning_approved_finish and pj_a_3550_ran_zoning_applied_finish. The KPI aggregates by rgn_region, m_area, m_market, and construction_gc, returning distinct project counts for applied/approved/pending zoning status plus avg/p50/p90 of non-negative durations for projects with both dates present. Projects with pj_project_status=\'Dead\' are excluded. If smp_name is filtered to \'NTM\' (case/whitespace-insensitive), additional constraints are automatically applied: smp_status=\'Active\' and ntm_project_type NOT IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\').', node_type: 'CORE', definition: 'Zoning Approval Cycle Time (days) is computed per project as (zoning approved finish date - zoning applied finish date) using pj_a_3575_ran_zoning_approved_finish and pj_a_3550_ran_zoning_applied_finish. The KPI aggregates by rgn_region, m_area, m_market, and construction_gc, returning distinct project counts for applied/approved/pending zoning status plus avg/p50/p90 of non-negative durations for projects with both dates present. Projects with pj_project_status=\'Dead\' are excluded. If smp_name is filtered to \'NTM\' (case/whitespace-insensitive), additional constraints are automatically applied: smp_status=\'Active\' and ntm_project_type NOT IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\').', kpi_python_function: 'def get_zoning_approval_ct(execute_query, filters=None) -> list[dict]:\n    where_parts = [\n        "1=1",\n        "COALESCE(m.\\"pj_project_status\\", \'\') <> \'Dead\'"\n    ]\n\n    # Optional filters (explicit allowlist)\n    if filters:\n        if filters.get("rgn_region"):\n            v = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f"m.\\"rgn_region\\" = \'{v}\'")\n        if filters.get("m_area"):\n            v = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f"m.\\"m_area\\" = \'{v}\'")\n        if filters.get("m_market"):\n            v = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f"m.\\"m_market\\" = \'{v}\'")\n        if filters.get("construction_gc"):\n            v = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f"m.\\"construction_gc\\" = \'{v}\'")\n        if filters.get("smp_name"):\n            v = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f"m.\\"smp_name\\" = \'{v}\'")\n\n            if v.strip().upper() == \'NTM\':\n                where_parts.append("m.\\"smp_status\\" = \'Active\'")\n                where_parts.append("m.\\"ntm_project_type\\" NOT IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\')")\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n    SELECT\n      base.\\"rgn_region\\" AS \\"rgn_region\\",\n      base.\\"m_area\\" AS \\"m_area\\",\n      base.\\"m_market\\" AS \\"m_market\\",\n      base.\\"construction_gc\\" AS \\"construction_gc\\",\n\n      COUNT(DISTINCT CASE WHEN base.\\"zoning_applied_dt\\" IS NOT NULL THEN base.\\"pj_project_id\\" END) AS \\"zoning_applied_count\\",\n      COUNT(DISTINCT CASE WHEN base.\\"zoning_approved_dt\\" IS NOT NULL THEN base.\\"pj_project_id\\" END) AS \\"zoning_approved_count\\",\n      COUNT(DISTINCT CASE WHEN base.\\"zoning_applied_dt\\" IS NOT NULL AND base.\\"zoning_approved_dt\\" IS NULL THEN base.\\"pj_project_id\\" END) AS \\"zoning_pending_count\\",\n\n      AVG(base.\\"duration_days\\") FILTER (\n        WHERE base.\\"zoning_applied_dt\\" IS NOT NULL\n          AND base.\\"zoning_approved_dt\\" IS NOT NULL\n          AND base.\\"duration_days\\" >= 0\n      ) AS \\"avg_zoning_days\\"\n\n    FROM (\n      SELECT\n        m.\\"pj_project_id\\" AS \\"pj_project_id\\",\n        m.\\"rgn_region\\" AS \\"rgn_region\\",\n        m.\\"m_area\\" AS \\"m_area\\",\n        m.\\"m_market\\" AS \\"m_market\\",\n        m.\\"construction_gc\\" AS \\"construction_gc\\",\n\n        CASE\n          WHEN m.\\"pj_a_3550_ran_zoning_applied_finish\\"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n          THEN m.\\"pj_a_3550_ran_zoning_applied_finish\\"::timestamp::date\n        END AS \\"zoning_applied_dt\\",\n\n        CASE\n          WHEN m.\\"pj_a_3575_ran_zoning_approved_finish\\"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n          THEN m.\\"pj_a_3575_ran_zoning_approved_finish\\"::timestamp::date\n        END AS \\"zoning_approved_dt\\",\n\n        (\n          CASE\n            WHEN m.\\"pj_a_3575_ran_zoning_approved_finish\\"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n            THEN m.\\"pj_a_3575_ran_zoning_approved_finish\\"::timestamp::date\n          END\n          -\n          CASE\n            WHEN m.\\"pj_a_3550_ran_zoning_applied_finish\\"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n            THEN m.\\"pj_a_3550_ran_zoning_applied_finish\\"::timestamp::date\n          END\n        ) AS \\"duration_days\\"\n\n      FROM pwc_macro_staging_schema.\\"stg_ndpd_mbt_tmobile_macro_combined\\" m\n      WHERE {where_sql}\n    ) base\n\n    GROUP BY\n      base.\\"rgn_region\\",\n      base.\\"m_area\\",\n      base.\\"m_market\\",\n      base.\\"construction_gc\\"\n\n    ORDER BY\n      base.\\"rgn_region\\",\n      base.\\"m_area\\",\n      base.\\"m_market\\",\n      base.\\"construction_gc\\";\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'pj_project_status', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'smp_name', 'smp_status', 'ntm_project_type', 'pj_a_3550_ran_zoning_applied_finish', 'pj_a_3575_ran_zoning_approved_finish'], session_id: '69a3d22f26e208edc083a06e', label: 'Zoning Approval CT', kpi_related_core_node_ids: ['project', 'milestone', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '6d46d5d6-98eb-48d4-bfe1-f4c19b6bad2d', entity_type: 'kpi', kpi_name: 'Zoning Approval CT', name: '6d46d5d6-98eb-48d4-bfe1-f4c19b6bad2d', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures the cycle time (days) from zoning application submission to zoning approval, using milestones pj_a_3550_ran_zoning_applied_finish (start) and pj_a_3575_ran_zoning_approved_finish (end). Reported by region/area/market and assigned construction GC to monitor pre-construction gate performance, identify bottlenecks, and quantify pending zoning backlog. Includes applied/approved/pending project counts and avg/median/p90 days for projects with valid non-negative durations; excludes Dead projects and supports program filters (smp_name and NTM-conditional constraints when applicable).', status: 'mentioned', node_id: '6d46d5d6-98eb-48d4-bfe1-f4c19b6bad2d'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined', 'pwc_macro_staging_schema.stg_services_ndpc_answers_daily_from_sdb'], nl_business_rule: '', kpi_formula_description: 'Computes site-level First-Time-Right (FTR) from NDPc customer decision answers using pwc_macro_staging_schema.stg_services_ndpc_answers_daily_from_sdb joined to pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined on a.sessiontitle = c.scop_title to inherit grouping dimensions (rgn_region, m_area, m_market, construction_gc). Only customer decision statuses are in-scope: formanswerstatus IN (\'6\',\'7\') where 6=approved (accepted) and 7=rejected. A site is FTR if it has ≥1 in-scope answer and zero rejected answers (\'7\'); non-FTR if it has ≥1 rejected answer. Output includes total sites with NDPc decisions, total/accepted/rejected answer counts, and ftr_rate_pct = 100 * ftr_sites / total_sites_with_ndpc. Excludes Dead projects and supports optional program filtering via smp_name (with NTM constraints).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping dimension."}, {"column": "m_area", "type": "string", "description": "Area grouping dimension."}, {"column": "m_market", "type": "string", "description": "Market grouping dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping dimension."}, {"column": "total_sites_with_ndpc", "type": "int", "description": "Count of distinct sites with NDPc decision answers (formanswerstatus IN 6,7)."}, {"column": "total_answers", "type": "int", "description": "Total decision answers (status 6 or 7)."}, {"column": "accepted_answers", "type": "int", "description": "Count of answers with formanswerstatus=6 (customer approved)."}, {"column": "rejected_answers", "type": "int", "description": "Count of answers with formanswerstatus=7 (customer rejected)."}, {"column": "ftr_rate_pct", "type": "float", "description": "First-time-right rate: 100 * FTR sites / total sites with NDPc decisions."}]', kpi_business_logic: 'INNER JOIN macro combined (c) to NDPc answers (a) on a.sessiontitle = c.scop_title.\nSeed WHERE with 1=1, enforce c.scop_title IS NOT NULL, exclude Dead projects via COALESCE(c.pj_project_status,\'\') <> \'Dead\', and scope to customer decision answers only: a.formanswerstatus IN (\'6\',\'7\').\nApply optional date filters on a.formanswerdate::date using start_date/end_date.\nApply optional dimension equality filters on c.rgn_region, c.m_area, c.m_market, c.construction_gc.\nIf smp_name is provided, filter c.smp_name = smp_name; if smp_name == \'NTM\' (case-insensitive, trimmed), additionally require c.smp_status=\'Active\' and exclude specific c.ntm_project_type values.\nInner aggregation (site level): group by (rgn_region, m_area, m_market, construction_gc, scop_title); compute site_has_rejection = MAX(CASE WHEN formanswerstatus=\'7\' THEN 1 ELSE 0 END); compute total_answers (decision answers only), accepted_answers (status \'6\'), rejected_answers (status \'7\').\nOuter aggregation (group level): group by (rgn_region, m_area, m_market, construction_gc); total_sites_with_ndpc = COUNT(DISTINCT scop_title); ftr_sites = COUNT(DISTINCT scop_title where site_has_rejection=0); compute total_answers/accepted_answers/rejected_answers as sums; compute ftr_rate_pct = 100*ftr_sites/total_sites_with_ndpc.', kpi_filters: '[{"name": "start_date", "type": "string", "description": ""}, {"name": "end_date", "type": "string", "description": ""}, {"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_ndpc_quality_ftr_rate", "node_type": "kpi", "node_id": "f44a788a-0aab-4a97-b60e-38a9d43063af", "node_label": "NDPc Quality FTR Rate", "description": "Percentage of projects/sites that pass the NDPc quality gate first-time-right after Nokia audit completion. This indicates how often audited projects meet the quality requirements on the first attempt.", "parameters": [{"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [], "sample_output": [], "row_count": 0}', nl_description: 'Computes site-level First-Time-Right (FTR) from NDPc customer decision answers using pwc_macro_staging_schema.stg_services_ndpc_answers_daily_from_sdb joined to pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined on a.sessiontitle = c.scop_title to inherit grouping dimensions (rgn_region, m_area, m_market, construction_gc). Only customer decision statuses are in-scope: formanswerstatus IN (\'6\',\'7\') where 6=approved (accepted) and 7=rejected. A site is FTR if it has ≥1 in-scope answer and zero rejected answers (\'7\'); non-FTR if it has ≥1 rejected answer. Output includes total sites with NDPc decisions, total/accepted/rejected answer counts, and ftr_rate_pct = 100 * ftr_sites / total_sites_with_ndpc. Excludes Dead projects and supports optional program filtering via smp_name (with NTM constraints).', node_type: 'CORE', definition: 'Computes site-level First-Time-Right (FTR) from NDPc customer decision answers using pwc_macro_staging_schema.stg_services_ndpc_answers_daily_from_sdb joined to pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined on a.sessiontitle = c.scop_title to inherit grouping dimensions (rgn_region, m_area, m_market, construction_gc). Only customer decision statuses are in-scope: formanswerstatus IN (\'6\',\'7\') where 6=approved (accepted) and 7=rejected. A site is FTR if it has ≥1 in-scope answer and zero rejected answers (\'7\'); non-FTR if it has ≥1 rejected answer. Output includes total sites with NDPc decisions, total/accepted/rejected answer counts, and ftr_rate_pct = 100 * ftr_sites / total_sites_with_ndpc. Excludes Dead projects and supports optional program filtering via smp_name (with NTM constraints).', kpi_python_function: 'def get_ndpc_quality_ftr_rate(execute_query, filters=None) -> list[dict]:\n    """NDPc Quality — Site-level First-Time-Right (FTR) based on customer-level NDPc answer decisions.\n\n    Customer-level status codes (per Nokia QB):\n      - \'6\' = customer APPROVED (accepted)\n      - \'7\' = customer REJECTED (creates punch point)\n\n    Scope:\n      - Only sites with NDPc decision activity (answers with formanswerstatus IN (\'6\',\'7\')).\n      - INNER JOIN macro combined (dims) to NDPc answers (decision signals) on scop_title=sessiontitle.\n\n    Output (grouped by region/area/market/GC):\n      rgn_region, m_area, m_market, construction_gc,\n      total_sites_with_ndpc,\n      total_answers, accepted_answers, rejected_answers,\n      ftr_rate_pct\n\n    FTR definition (site-level):\n      - Site is FTR if it has >=1 decision answer AND has zero rejected answers (\'7\').\n      - Site is non-FTR if it has >=1 rejected answer (\'7\').\n\n    Filters (allowlist):\n      - start_date, end_date (applied to a."formanswerdate"::date)\n      - rgn_region, m_area, m_market, construction_gc (applied to c.*)\n      - smp_name (applied to c.* with NTM conditional constraints)\n\n    Hard filter:\n      - Excludes Dead projects: COALESCE(c."pj_project_status", \'\') <> \'Dead\'\n\n    Platform constraints:\n      - No CTEs; uses derived-table subquery.\n      - Double-quoted column names.\n    """\n\n    filters = filters or {}\n\n    # ---- allowlisted filters only (no generic filter loops) ----\n    where_parts = ["1=1"]\n\n    def esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    # Required guards\n    where_parts.append(\'c."scop_title" IS NOT NULL\')\n    where_parts.append("COALESCE(c.\\"pj_project_status\\", \'\') <> \'Dead\'")\n\n    # Decision-status scope (customer-level codes only)\n    where_parts.append("a.\\"formanswerstatus\\" IN (\'6\',\'7\')")\n\n    # Date range filters on answer date\n    start_date = filters.get("start_date")\n    end_date = filters.get("end_date")\n    if start_date:\n        where_parts.append(f"a.\\"formanswerdate\\"::date >= \'{esc(start_date)}\'::date")\n    if end_date:\n        where_parts.append(f"a.\\"formanswerdate\\"::date <= \'{esc(end_date)}\'::date")\n\n    # Dimension filters (existing)\n    for k in ["rgn_region", "m_area", "m_market", "construction_gc"]:\n        v = filters.get(k)\n        if v is not None and v != "":\n            where_parts.append(f\'c."{k}" = \\\'{esc(v)}\\\'\')\n\n    # Program filter (EXACT requested block)\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'c."smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'c."smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'c."ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    inner_where_sql = " AND ".join(where_parts)\n\n    # Two-level aggregation: per-site decision rollup, then group-level KPI\n    sql = f"""\n        SELECT\n          site_level."rgn_region",\n          site_level."m_area",\n          site_level."m_market",\n          site_level."construction_gc",\n          COUNT(DISTINCT site_level."scop_title") AS total_sites_with_ndpc,\n          SUM(site_level."total_answers") AS total_answers,\n          SUM(site_level."accepted_answers") AS accepted_answers,\n          SUM(site_level."rejected_answers") AS rejected_answers,\n          (\n            100.0 *\n            COUNT(DISTINCT CASE WHEN site_level."site_has_rejection" = 0 THEN site_level."scop_title" ELSE NULL END)\n            / NULLIF(COUNT(DISTINCT site_level."scop_title"), 0)\n          ) AS ftr_rate_pct\n        FROM (\n          SELECT\n            c."rgn_region",\n            c."m_area",\n            c."m_market",\n            c."construction_gc",\n            c."scop_title",\n            MAX(CASE WHEN a."formanswerstatus" = \'7\' THEN 1 ELSE 0 END) AS site_has_rejection,\n            COUNT(*) AS total_answers,\n            SUM(CASE WHEN a."formanswerstatus" = \'6\' THEN 1 ELSE 0 END) AS accepted_answers,\n            SUM(CASE WHEN a."formanswerstatus" = \'7\' THEN 1 ELSE 0 END) AS rejected_answers\n          FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined c\n          INNER JOIN pwc_macro_staging_schema.stg_services_ndpc_answers_daily_from_sdb a\n            ON a."sessiontitle" = c."scop_title"\n          WHERE {inner_where_sql}\n          GROUP BY\n            c."rgn_region",\n            c."m_area",\n            c."m_market",\n            c."construction_gc",\n            c."scop_title"\n        ) site_level\n        GROUP BY\n          site_level."rgn_region",\n          site_level."m_area",\n          site_level."m_market",\n          site_level."construction_gc"\n        ORDER BY\n          site_level."rgn_region",\n          site_level."m_area",\n          site_level."m_market",\n          site_level."construction_gc"\n    """\n\n    return execute_query(sql) or []\n', kpi_source_columns: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.scop_title', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.m_area', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.m_market', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.construction_gc', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.pj_project_status', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.smp_name', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.smp_status', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.ntm_project_type', 'pwc_macro_staging_schema.stg_services_ndpc_answers_daily_from_sdb.sessiontitle', 'pwc_macro_staging_schema.stg_services_ndpc_answers_daily_from_sdb.formanswerstatus', 'pwc_macro_staging_schema.stg_services_ndpc_answers_daily_from_sdb.formanswerdate'], session_id: '69a3d22f26e208edc083a06e', label: 'NDPc Quality FTR Rate', kpi_related_core_node_ids: ['project'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'f44a788a-0aab-4a97-b60e-38a9d43063af', entity_type: 'kpi', kpi_name: 'NDPc Quality FTR Rate', name: 'f44a788a-0aab-4a97-b60e-38a9d43063af', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Percentage of projects/sites that pass the NDPc quality gate first-time-right after Nokia audit completion. This indicates how often audited projects meet the quality requirements on the first attempt.', status: 'mentioned', node_id: 'f44a788a-0aab-4a97-b60e-38a9d43063af'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Per project: CX Cycle Time (calendar days) is computed using a coherent source fallback. If both Magenta milestones exist, CX Cycle Time = construction complete (pj_a_5175_construction_complete_finish, Magenta MS 5175)::date − construction start (pj_a_4225_construction_start_finish, Magenta MS 4225)::date. Otherwise, if both NDPd milestones exist, CX Cycle Time = ms_1555_construction_complete_actual::date − ms_1550_construction_start_actual::date. Projects with neither full pair are excluded, and negative durations are excluded. SLA classification is computed per por_category per Nokia Question Bank Rows 216–219: Site Modification <=17 days is In SLA; NSD/New Build/Overlay <=30 days is In SLA (default 30 otherwise). Output is grouped by rgn_region, m_area, m_market, construction_gc, por_category, s_site_class, source_system and includes cycle time distribution metrics plus in_sla_count, out_of_sla_count, and sla_pct.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping dimension."}, {"column": "m_area", "type": "string", "description": "Area grouping dimension."}, {"column": "m_market", "type": "string", "description": "Market grouping dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping dimension."}, {"column": "por_category", "type": "string", "description": "Optional slice dimension for POR category."}, {"column": "s_site_class", "type": "string", "description": "Optional slice dimension for site class."}, {"column": "project_count", "type": "int", "description": "Number of projects in the group."}, {"column": "avg_cx_cycle_days", "type": "float", "description": "Average construction cycle time in days for the group."}, {"column": "max_cx_cycle_days", "type": "int", "description": "Maximum construction cycle time in days for the group."}, {"column": "source_system", "type": "string", "description": "Which milestone system was used: Magenta or NDPd."}, {"column": "in_sla_count", "type": "int", "description": "Distinct projects with cx_days within SLA threshold (Site Mod <=17d, NSD/New Build <=30d)."}, {"column": "out_of_sla_count", "type": "int", "description": "Distinct projects with cx_days exceeding SLA threshold."}, {"column": "sla_pct", "type": "float", "description": "Percentage of projects within SLA: 100 * in_sla_count / total projects with valid cx_days."}]', kpi_business_logic: 'Seed WHERE with 1=1.\nRequire a coherent milestone pair from one system: either both Magenta milestones populated (pj_a_4225 and pj_a_5175) or both NDPd milestones populated (ms_1550 and ms_1555).\nCompute cx_days via COALESCE of CASE expressions: prefer Magenta date-difference when both Magenta dates exist; otherwise use NDPd date-difference when both NDPd dates exist; never mix systems.\nExclude projects with negative cx_days (cx_days >= 0).\nCompute effective completion date with the same fallback and apply optional start_date/end_date filters against it.\nApply allowlisted equality filters for pj_project_id, s_site_id, rgn_region, m_area, m_market, construction_gc, por_category, s_site_class.\nIf smp_name is provided, filter to that value; if smp_name == \'NTM\', also require smp_status=\'Active\' and exclude ntm_project_type in (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\').\nFor each project row, derive source_system (\'Magenta\' or \'NDPd\').\nFor each project row, derive sla_threshold (int) from por_category: Site Mod -> 17; NSD/New Build/Overlay -> 30; else 30.\nAggregate by rgn_region, m_area, m_market, construction_gc, por_category, s_site_class, source_system to compute project_count, avg/p50/p90/max cx_days.\nCompute in_sla_count as distinct projects with cx_days between 0 and sla_threshold (inclusive).\nCompute out_of_sla_count as distinct projects with cx_days > sla_threshold.\nCompute sla_pct as 100 * in_sla_count / distinct projects with cx_days >= 0, rounded to 2 decimals.', kpi_filters: '[{"name": "start_date", "type": "string", "description": ""}, {"name": "end_date", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "por_category", "type": "string", "description": ""}, {"name": "s_site_class", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Optional filter on the construction-start delay code column. When provided, the query adds: pj_construction_start_delay_code IS NOT NULL AND pj_construction_start_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}, {"name": "pj_construction_complete_delay_code", "type": "string", "description": "Optional filter on the construction-complete delay code column. When provided, the query adds: pj_construction_complete_delay_code IS NOT NULL AND pj_construction_complete_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}]', kpi_contract: '{"function_name": "get_cx_cycle_time", "node_type": "kpi", "node_id": "3c1fd435-6d07-4984-9546-45233e3bac72", "node_label": "CX Cycle Time", "description": "Measures the number of calendar days it takes to complete construction for a project/site, from construction start to construction complete. It is used as the primary construction benchmark for planning and capacity modeling. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).", "parameters": [{"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Filter to projects with a specific construction-start delay code, or any real start delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}, {"name": "pj_construction_complete_delay_code", "type": "string", "description": "Filter to projects with a specific construction-complete delay code, or any real complete delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "por_category", "type": "string", "nullable": false}, {"name": "s_site_class", "type": "string", "nullable": false}, {"name": "source_system", "type": "string", "nullable": false}, {"name": "project_count", "type": "number", "nullable": false}, {"name": "avg_cx_cycle_days", "type": "number", "nullable": false}, {"name": "max_cx_cycle_days", "type": "number", "nullable": false}, {"name": "in_sla_count", "type": "number", "nullable": false}, {"name": "out_of_sla_count", "type": "number", "nullable": false}, {"name": "sla_pct", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Per project: CX Cycle Time (calendar days) is computed using a coherent source fallback. If both Magenta milestones exist, CX Cycle Time = construction complete (pj_a_5175_construction_complete_finish, Magenta MS 5175)::date − construction start (pj_a_4225_construction_start_finish, Magenta MS 4225)::date. Otherwise, if both NDPd milestones exist, CX Cycle Time = ms_1555_construction_complete_actual::date − ms_1550_construction_start_actual::date. Projects with neither full pair are excluded, and negative durations are excluded. SLA classification is computed per por_category per Nokia Question Bank Rows 216–219: Site Modification <=17 days is In SLA; NSD/New Build/Overlay <=30 days is In SLA (default 30 otherwise). Output is grouped by rgn_region, m_area, m_market, construction_gc, por_category, s_site_class, source_system and includes cycle time distribution metrics plus in_sla_count, out_of_sla_count, and sla_pct.', node_type: 'CORE', definition: 'Per project: CX Cycle Time (calendar days) is computed using a coherent source fallback. If both Magenta milestones exist, CX Cycle Time = construction complete (pj_a_5175_construction_complete_finish, Magenta MS 5175)::date − construction start (pj_a_4225_construction_start_finish, Magenta MS 4225)::date. Otherwise, if both NDPd milestones exist, CX Cycle Time = ms_1555_construction_complete_actual::date − ms_1550_construction_start_actual::date. Projects with neither full pair are excluded, and negative durations are excluded. SLA classification is computed per por_category per Nokia Question Bank Rows 216–219: Site Modification <=17 days is In SLA; NSD/New Build/Overlay <=30 days is In SLA (default 30 otherwise). Output is grouped by rgn_region, m_area, m_market, construction_gc, por_category, s_site_class, source_system and includes cycle time distribution metrics plus in_sla_count, out_of_sla_count, and sla_pct.', kpi_python_function: 'def get_cx_cycle_time(execute_query, filters=None) -> list[dict]:\n    """CX Cycle Time + SLA classification (Magenta preferred; NDPd fallback)\n\n    Per-project CX Cycle Time (calendar days) uses a coherent source fallback:\n      1) If BOTH Magenta milestones are present, cx_days = pj_a_5175::date - pj_a_4225::date\n      2) Else if BOTH NDPd milestones are present, cx_days = ms_1555::date - ms_1550::date\n      3) Else exclude the project.\n\n    SLA thresholds vary by por_category (per Nokia QB Rows 216/218/219):\n      - Site Modification: <= 17 days (In SLA)\n      - NSD / New Build / Overlay: <= 30 days (In SLA)\n      - Default: 30 days\n\n    Output is grouped by:\n      rgn_region, m_area, m_market, construction_gc, por_category, s_site_class, source_system\n\n    Outputs include cycle-time distribution metrics plus SLA classification counts and percent.\n\n    Filters (allowlist):\n      - start_date/end_date: applied to effective completion date (Magenta completion when Magenta used; else NDPd completion)\n      - pj_project_id, s_site_id, rgn_region, m_area, m_market, construction_gc, por_category, s_site_class\n      - smp_name (and NTM conditional filters)\n    """\n\n    filters = filters or {}\n\n    def esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    # Coherent fallback expressions (use consistently everywhere)\n    cycle_days_expr = """COALESCE(\n      CASE WHEN "pj_a_5175_construction_complete_finish" IS NOT NULL\n            AND "pj_a_4225_construction_start_finish" IS NOT NULL\n           THEN "pj_a_5175_construction_complete_finish"::date - "pj_a_4225_construction_start_finish"::date\n      END,\n      CASE WHEN "ms_1555_construction_complete_actual" IS NOT NULL\n            AND "ms_1550_construction_start_actual" IS NOT NULL\n           THEN "ms_1555_construction_complete_actual"::date - "ms_1550_construction_start_actual"::date\n      END\n    )"""\n\n    effective_complete_date_expr = """COALESCE(\n      CASE WHEN "pj_a_5175_construction_complete_finish" IS NOT NULL\n            AND "pj_a_4225_construction_start_finish" IS NOT NULL\n           THEN "pj_a_5175_construction_complete_finish"::date\n      END,\n      CASE WHEN "ms_1555_construction_complete_actual" IS NOT NULL\n            AND "ms_1550_construction_start_actual" IS NOT NULL\n           THEN "ms_1555_construction_complete_actual"::date\n      END\n    )"""\n\n    # Seed WHERE with 1=1, then metric-defining conditions\n    where_parts = [\n        "1=1",\n        # must have a coherent pair from one system\n        "((\\"pj_a_5175_construction_complete_finish\\" IS NOT NULL AND \\"pj_a_4225_construction_start_finish\\" IS NOT NULL) OR (\\"ms_1555_construction_complete_actual\\" IS NOT NULL AND \\"ms_1550_construction_start_actual\\" IS NOT NULL))",\n        # non-negative duration\n        f"({cycle_days_expr}) >= 0",\n    ]\n\n    # Date range applied to effective completion date\n    if filters.get("start_date"):\n        where_parts.append(f"({effective_complete_date_expr}) >= \'{esc(filters[\'start_date\'])}\'")\n    if filters.get("end_date"):\n        where_parts.append(f"({effective_complete_date_expr}) <= \'{esc(filters[\'end_date\'])}\'")\n\n    # Optional dimensional filters (explicit allowlist)\n    for col in [\n        "pj_project_id",\n        "s_site_id",\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "por_category",\n        "s_site_class",\n    ]:\n        if filters.get(col) is not None:\n            where_parts.append(f\'"{col}" = \\\'{esc(filters[col])}\\\'\')\n\n    # Keep existing smp_name + NTM conditional filter behavior\n    if filters.get("smp_name") is not None:\n        where_parts.append(f\'"smp_name" = \\\'{esc(filters["smp_name"])}\\\'\')\n        if str(filters.get("smp_name", "")).strip().upper() == "NTM":\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n\n    # Optional construction delay-code filters (engage when caller wants to narrow to delayed projects)\n\n    for _delay_col in ("pj_construction_start_delay_code", "pj_construction_complete_delay_code"):\n\n        _v = filters.get(_delay_col)\n\n        if _v is None or str(_v).strip() == "":\n\n            continue\n\n        _s = str(_v).strip()\n\n        where_parts.append(f\'"{_delay_col}" IS NOT NULL\')\n\n        where_parts.append(f\'"{_delay_col}" <> \\\'No Delay\\\'\')\n\n        if _s.lower() not in ("any", "true", "yes", "1", "*"):\n\n            _ss = _s.replace("\'", "\'\'")\n\n            where_parts.append(f\'"{_delay_col}" = \\\'{_ss}\\\'\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n    SELECT\n      base."rgn_region",\n      base."m_area",\n      base."m_market",\n      base."construction_gc",\n      base."por_category",\n      base."s_site_class",\n      base."source_system",\n      COUNT(DISTINCT base."pj_project_id")::int AS project_count,\n      AVG(base."cx_days")::float AS avg_cx_cycle_days,\n      MAX(base."cx_days")::int AS max_cx_cycle_days,\n\n      COUNT(DISTINCT CASE\n        WHEN base."cx_days" >= 0 AND base."cx_days" <= base."sla_threshold"\n        THEN base."pj_project_id"\n      END)::int AS in_sla_count,\n\n      COUNT(DISTINCT CASE\n        WHEN base."cx_days" >= 0 AND base."cx_days" > base."sla_threshold"\n        THEN base."pj_project_id"\n      END)::int AS out_of_sla_count,\n\n      ROUND(\n        100.0 *\n        COUNT(DISTINCT CASE\n          WHEN base."cx_days" >= 0 AND base."cx_days" <= base."sla_threshold"\n          THEN base."pj_project_id"\n        END)\n        /\n        NULLIF(\n          COUNT(DISTINCT CASE\n            WHEN base."cx_days" >= 0\n            THEN base."pj_project_id"\n          END),\n          0\n        )\n      , 2)::float AS sla_pct\n\n    FROM (\n      SELECT\n        "pj_project_id",\n        "s_site_id",\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "por_category",\n        "s_site_class",\n        CASE\n          WHEN "pj_a_5175_construction_complete_finish" IS NOT NULL\n           AND "pj_a_4225_construction_start_finish" IS NOT NULL THEN \'Magenta\'\n          WHEN "ms_1555_construction_complete_actual" IS NOT NULL\n           AND "ms_1550_construction_start_actual" IS NOT NULL THEN \'NDPd\'\n          ELSE NULL\n        END AS source_system,\n        ({cycle_days_expr}) AS "cx_days",\n        CASE\n          WHEN UPPER("por_category") LIKE \'%SITE MOD%\' THEN 17\n          WHEN UPPER("por_category") LIKE \'%NEW%BUILD%\' THEN 30\n          WHEN UPPER("por_category") LIKE \'%NSD%\' THEN 30\n          WHEN UPPER("por_category") LIKE \'%OVERLAY%\' THEN 30\n          ELSE 30\n        END::int AS "sla_threshold"\n      FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n      WHERE {where_sql}\n    ) base\n    GROUP BY 1,2,3,4,5,6,7\n    ORDER BY 1,2,3,4,5,6,7\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 's_site_id', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 's_site_class', 'smp_name', 'smp_status', 'ntm_project_type', 'pj_a_5175_construction_complete_finish', 'pj_a_4225_construction_start_finish', 'ms_1555_construction_complete_actual', 'ms_1550_construction_start_actual', 'pj_construction_start_delay_code', 'pj_construction_complete_delay_code'], session_id: '69a3d22f26e208edc083a06e', label: 'CX Cycle Time', kpi_related_core_node_ids: ['project', 'site'], kpi_relationship_type: 'AGGREGATES', kpi_kpi_id: '3c1fd435-6d07-4984-9546-45233e3bac72', entity_type: 'kpi', kpi_name: 'CX Cycle Time', name: '3c1fd435-6d07-4984-9546-45233e3bac72', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 's_site_class', 'source_system'], kpi_description: 'Measures the number of calendar days it takes to complete construction for a project/site, from construction start to construction complete. It is used as the primary construction benchmark for planning and capacity modeling. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB). Optionally filterable by construction delay code: pass pj_construction_start_delay_code or pj_construction_complete_delay_code (any non-empty value engages IS NOT NULL AND <> \'No Delay\'; a specific code value also narrows to that code).', status: 'mentioned', node_id: '3c1fd435-6d07-4984-9546-45233e3bac72'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined', 'pwc_macro_staging_schema.stg_fast_tracker_copilot (only when smp_name contains \'AHLOB\')'], nl_business_rule: '', kpi_formula_description: 'Integrated Pending Alarm (primary): COUNT(DISTINCT pj_project_id) from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined where ms_1899_all_planned_technologies_integrated_actual IS NOT NULL and ms_1970_integration_complete_actual IS NULL, grouped by rgn_region, m_area, m_market, construction_gc, por_category; also computes avg/max days pending as days since ms_1899 timestamp. Program-aware filter via smp_name; if smp_name=\'NTM\', additionally requires smp_status=\'Active\' and excludes ntm_project_type in (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\'). Supplementary (AHLOB-only when smp_name contains \'AHLOB\'): additionally reports COUNT(DISTINCT s_site_id) with 48hr monitoring pending/complete from pwc_macro_staging_schema.stg_fast_tracker_copilot joined on s_site_id = sn_of_ahloa (fourtyeight_hours_monitering_done = \'No\'/\'Yes\'). When not in AHLOB mode, AHLOB columns return 0 and the query does not reference stg_fast_tracker_copilot.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor dimension."}, {"column": "por_category", "type": "string", "description": "POR category dimension."}, {"column": "pending_alarm_clearance_count", "type": "integer", "description": "Count of distinct projects in the integrated-pending (alarm-clearance validation) state."}, {"column": "avg_days_pending", "type": "float", "description": "Average days since ms_1899_all_planned_technologies_integrated_actual for projects in this state."}, {"column": "max_days_pending", "type": "float", "description": "Maximum days since ms_1899_all_planned_technologies_integrated_actual for projects in this state."}, {"column": "ahlob_48hr_pending_count", "type": "int", "description": "Count of distinct sites with 48hr monitoring pending (fourtyeight_hours_monitering_done=No). Only populated when filtering to AHLOB; otherwise 0."}, {"column": "ahlob_48hr_complete_count", "type": "int", "description": "Count of distinct sites with 48hr monitoring complete (fourtyeight_hours_monitering_done=Yes). Only populated when filtering to AHLOB; otherwise 0."}]', kpi_business_logic: 'Start with base conditions defining the metric on pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined: ms_1899_all_planned_technologies_integrated_actual IS NOT NULL AND ms_1970_integration_complete_actual IS NULL.\nApply optional allowlisted filters: rgn_region, m_area, m_market, construction_gc, por_category, pj_project_id, s_site_id.\nIf smp_name is provided, filter nd.smp_name = <value>.\nIf smp_name equals \'NTM\' (case-insensitive after strip), additionally require nd.smp_status=\'Active\' and nd.ntm_project_type NOT IN (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\').\nDetermine AHLOB mode: is_ahlob = (smp_name provided and contains substring \'AHLOB\' case-insensitively).\nIf AHLOB mode: LEFT JOIN pwc_macro_staging_schema.stg_fast_tracker_copilot ft on nd.s_site_id = ft.sn_of_ahloa and compute AHLOB 48hr pending/complete counts using ft.fourtyeight_hours_monitering_done; otherwise, do not reference fast-tracker and return 0 for the AHLOB columns.\nGroup by rgn_region, m_area, m_market, construction_gc, por_category.\nCompute primary outputs in all modes: pending_alarm_clearance_count = COUNT(DISTINCT pj_project_id); avg_days_pending/max_days_pending = AVG/MAX of (NOW() - ms_1899 timestamp) in days.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "por_category", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_integrated_pending_alarm", "node_type": "kpi", "node_id": "7bdb116a-719c-475b-ad04-da1f796b9209", "node_label": "Integrated Pending Alarm", "description": "Counts active sites/projects where all planned technologies have been integrated (tech integration timestamp present) but full integration completion/sign-off has not yet occurred (integration complete timestamp still null). This represents the transient 48-hour alarm-clearance validation window after technology integration; monitoring volume and aging helps prevent sites from stalling in final validation and improves on-time integration closure.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "por_category", "type": "string", "nullable": false}, {"name": "pending_alarm_clearance_count", "type": "number", "nullable": false}, {"name": "avg_days_pending", "type": "string", "nullable": false}, {"name": "max_days_pending", "type": "string", "nullable": false}, {"name": "ahlob_48hr_pending_count", "type": "number", "nullable": false}, {"name": "ahlob_48hr_complete_count", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Integrated Pending Alarm (primary): COUNT(DISTINCT pj_project_id) from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined where ms_1899_all_planned_technologies_integrated_actual IS NOT NULL and ms_1970_integration_complete_actual IS NULL, grouped by rgn_region, m_area, m_market, construction_gc, por_category; also computes avg/max days pending as days since ms_1899 timestamp. Program-aware filter via smp_name; if smp_name=\'NTM\', additionally requires smp_status=\'Active\' and excludes ntm_project_type in (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\'). Supplementary (AHLOB-only when smp_name contains \'AHLOB\'): additionally reports COUNT(DISTINCT s_site_id) with 48hr monitoring pending/complete from pwc_macro_staging_schema.stg_fast_tracker_copilot joined on s_site_id = sn_of_ahloa (fourtyeight_hours_monitering_done = \'No\'/\'Yes\'). When not in AHLOB mode, AHLOB columns return 0 and the query does not reference stg_fast_tracker_copilot.', node_type: 'CORE', definition: 'Integrated Pending Alarm (primary): COUNT(DISTINCT pj_project_id) from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined where ms_1899_all_planned_technologies_integrated_actual IS NOT NULL and ms_1970_integration_complete_actual IS NULL, grouped by rgn_region, m_area, m_market, construction_gc, por_category; also computes avg/max days pending as days since ms_1899 timestamp. Program-aware filter via smp_name; if smp_name=\'NTM\', additionally requires smp_status=\'Active\' and excludes ntm_project_type in (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\'). Supplementary (AHLOB-only when smp_name contains \'AHLOB\'): additionally reports COUNT(DISTINCT s_site_id) with 48hr monitoring pending/complete from pwc_macro_staging_schema.stg_fast_tracker_copilot joined on s_site_id = sn_of_ahloa (fourtyeight_hours_monitering_done = \'No\'/\'Yes\'). When not in AHLOB mode, AHLOB columns return 0 and the query does not reference stg_fast_tracker_copilot.', kpi_python_function: 'def get_site_integrated_pending_alarm(execute_query, filters=None) -> list[dict]:\n    # KPI: Integrated Pending Alarm (program-aware)\n    # Primary (NTM-validated) pending logic:\n    #   ms_1899_all_planned_technologies_integrated_actual IS NOT NULL\n    #   ms_1970_integration_complete_actual IS NULL\n    # Aging computed as days since ms_1899 timestamp.\n    # Supplementary AHLOB-only outputs (meaningful when filtering to AHLOB):\n    #   counts of 48hr monitoring done Yes/No from stg_fast_tracker_copilot.\n\n    where_parts = [\n        "1=1",\n        \'"ms_1899_all_planned_technologies_integrated_actual" IS NOT NULL\',\n        \'"ms_1970_integration_complete_actual" IS NULL\'\n    ]\n\n    # Explicit allowlist (no generic filter loops)\n    allowed_filter_columns = {\n        "rgn_region": "rgn_region",\n        "m_area": "m_area",\n        "m_market": "m_market",\n        "construction_gc": "construction_gc",\n        "por_category": "por_category",\n        "pj_project_id": "pj_project_id",\n        "s_site_id": "s_site_id",\n        "smp_name": "smp_name"\n    }\n\n    if filters:\n        if filters.get("rgn_region") is not None:\n            v = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f\'"{allowed_filter_columns["rgn_region"]}" = \\\'{v}\\\'\')\n        if filters.get("m_area") is not None:\n            v = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f\'"{allowed_filter_columns["m_area"]}" = \\\'{v}\\\'\')\n        if filters.get("m_market") is not None:\n            v = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f\'"{allowed_filter_columns["m_market"]}" = \\\'{v}\\\'\')\n        if filters.get("construction_gc") is not None:\n            v = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f\'"{allowed_filter_columns["construction_gc"]}" = \\\'{v}\\\'\')\n        if filters.get("por_category") is not None:\n            v = str(filters["por_category"]).replace("\'", "\'\'")\n            where_parts.append(f\'"{allowed_filter_columns["por_category"]}" = \\\'{v}\\\'\')\n        if filters.get("pj_project_id") is not None:\n            v = str(filters["pj_project_id"]).replace("\'", "\'\'")\n            where_parts.append(f\'"{allowed_filter_columns["pj_project_id"]}" = \\\'{v}\\\'\')\n        if filters.get("s_site_id") is not None:\n            v = str(filters["s_site_id"]).replace("\'", "\'\'")\n            where_parts.append(f\'"{allowed_filter_columns["s_site_id"]}" = \\\'{v}\\\'\')\n\n        # Program-aware logic: smp_name filter + NTM conditional\n        if filters.get("smp_name") is not None:\n            v = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f\'"{allowed_filter_columns["smp_name"]}" = \\\'{v}\\\'\')\n            if v.strip().upper() == "NTM":\n                where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n                where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_clause = " AND ".join(where_parts)\n\n    # Build SQL conditionally based on whether AHLOB is selected\n    is_ahlob = bool(filters and filters.get("smp_name") and ("AHLOB" in str(filters["smp_name"]).upper()))\n\n    if is_ahlob:\n        sql = (\n            f\'\'\'SELECT   nd."rgn_region",   nd."m_area",   nd."m_market",   nd."construction_gc",   nd."por_category",   COUNT(DISTINCT nd."pj_project_id") AS "pending_alarm_clearance_count",   AVG(EXTRACT(EPOCH FROM (NOW() - nd."ms_1899_all_planned_technologies_integrated_actual"::timestamp)) / 86400.0) AS "avg_days_pending",   MAX(EXTRACT(EPOCH FROM (NOW() - nd."ms_1899_all_planned_technologies_integrated_actual"::timestamp)) / 86400.0) AS "max_days_pending",   COUNT(DISTINCT CASE WHEN ft."fourtyeight_hours_monitering_done" = \'No\' THEN nd."s_site_id" END) AS "ahlob_48hr_pending_count",   COUNT(DISTINCT CASE WHEN ft."fourtyeight_hours_monitering_done" = \'Yes\' THEN nd."s_site_id" END) AS "ahlob_48hr_complete_count" FROM pwc_macro_staging_schema."stg_ndpd_mbt_tmobile_macro_combined" nd LEFT JOIN pwc_macro_staging_schema."stg_fast_tracker_copilot" ft   ON nd."s_site_id" = ft."sn_of_ahloa" WHERE {where_clause} GROUP BY nd."rgn_region", nd."m_area", nd."m_market", nd."construction_gc", nd."por_category" ORDER BY nd."rgn_region", nd."m_area", nd."m_market", nd."construction_gc", nd."por_category"\'\'\'\n        )\n    else:\n        sql = (\n            f\'\'\'SELECT   "rgn_region",   "m_area",   "m_market",   "construction_gc",   "por_category",   COUNT(DISTINCT "pj_project_id") AS "pending_alarm_clearance_count",   AVG(EXTRACT(EPOCH FROM (NOW() - "ms_1899_all_planned_technologies_integrated_actual"::timestamp)) / 86400.0) AS "avg_days_pending",   MAX(EXTRACT(EPOCH FROM (NOW() - "ms_1899_all_planned_technologies_integrated_actual"::timestamp)) / 86400.0) AS "max_days_pending",   0 AS "ahlob_48hr_pending_count",   0 AS "ahlob_48hr_complete_count" FROM pwc_macro_staging_schema."stg_ndpd_mbt_tmobile_macro_combined" WHERE {where_clause} GROUP BY "rgn_region", "m_area", "m_market", "construction_gc", "por_category" ORDER BY "rgn_region", "m_area", "m_market", "construction_gc", "por_category"\'\'\'\n        )\n\n    return execute_query(sql, db="public")\n', kpi_source_columns: ['stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'stg_ndpd_mbt_tmobile_macro_combined.m_area', 'stg_ndpd_mbt_tmobile_macro_combined.m_market', 'stg_ndpd_mbt_tmobile_macro_combined.construction_gc', 'stg_ndpd_mbt_tmobile_macro_combined.por_category', 'stg_ndpd_mbt_tmobile_macro_combined.pj_project_id', 'stg_ndpd_mbt_tmobile_macro_combined.s_site_id', 'stg_ndpd_mbt_tmobile_macro_combined.ms_1899_all_planned_technologies_integrated_actual', 'stg_ndpd_mbt_tmobile_macro_combined.ms_1970_integration_complete_actual', 'stg_ndpd_mbt_tmobile_macro_combined.smp_name', 'stg_ndpd_mbt_tmobile_macro_combined.smp_status', 'stg_ndpd_mbt_tmobile_macro_combined.ntm_project_type', 'stg_fast_tracker_copilot.sn_of_ahloa (only when smp_name contains \'AHLOB\')', 'stg_fast_tracker_copilot.fourtyeight_hours_monitering_done (only when smp_name contains \'AHLOB\')'], session_id: '69a3d22f26e208edc083a06e', label: 'Integrated Pending Alarm', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '7bdb116a-719c-475b-ad04-da1f796b9209', entity_type: 'kpi', kpi_name: 'Integrated Pending Alarm', name: '7bdb116a-719c-475b-ad04-da1f796b9209', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category'], kpi_description: 'Counts active sites/projects where all planned technologies have been integrated (tech integration timestamp present) but full integration completion/sign-off has not yet occurred (integration complete timestamp still null). This represents the transient 48-hour alarm-clearance validation window after technology integration; monitoring volume and aging helps prevent sites from stalling in final validation and improves on-time integration closure.', status: 'mentioned', node_id: '7bdb116a-719c-475b-ad04-da1f796b9209'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Measures the cycle time from CPO receipt (base_cpo_received) to construction start (ms_1550_construction_start_actual). CPO receipt is parsed from VARCHAR using a regex guard (must start with YYYY-MM-DD), then cast to timestamp::date. Cycle time (days) = ms_1550_construction_start_actual::date - base_cpo_received::timestamp::date. Excludes rows where either date is null, excludes negative durations, and excludes projects with pj_project_status = \'Dead\'. Aggregates by (rgn_region, m_area, m_market, construction_gc) to compute project_count, average, P50, and P90.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping dimension."}, {"column": "m_area", "type": "string", "description": "Area grouping dimension."}, {"column": "m_market", "type": "string", "description": "Market grouping dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping dimension."}, {"column": "project_count", "type": "int", "description": "Count of distinct projects with valid CPO-to-CX-Start duration."}, {"column": "avg_cycle_time_days", "type": "float", "description": "Average cycle time from CPO receipt to CX start in days."}]', kpi_business_logic: '1) Start with rows from "pwc_macro_staging_schema".stg_ndpd_mbt_tmobile_macro_combined.\n2) Apply seeded WHERE conditions: 1=1 and COALESCE(pj_project_status,\'\') <> \'Dead\'.\n3) Apply optional exact-match filters for rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id.\n4) If smp_name filter is provided, filter to smp_name; if the value is \'NTM\' (case-insensitive), additionally require smp_status=\'Active\' and exclude ntm_project_type in (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\').\n5) Optionally filter by date range on ms_1550_construction_start_actual::date using start_date/end_date.\n6) Derive cpo_received_dt: CASE WHEN base_cpo_received matches \'^\\d{4}-\\d{2}-\\d{2}\' THEN base_cpo_received::timestamp::date END.\n7) Keep only rows with ms_1550_construction_start_actual not null, cpo_received_dt not null, and (ms_1550::date - cpo_received_dt) >= 0.\n8) Compute cycle_time_days = ms_1550::date - cpo_received_dt.\n9) Group by rgn_region, m_area, m_market, construction_gc; compute COUNT(DISTINCT pj_project_id), AVG(cycle_time_days), PERCENTILE_CONT(0.5), PERCENTILE_CONT(0.9).', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}, {"name": "start_date", "type": "string", "description": ""}, {"name": "end_date", "type": "string", "description": ""}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Optional filter on the construction-start delay code column. When provided, the query adds: pj_construction_start_delay_code IS NOT NULL AND pj_construction_start_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}, {"name": "pj_construction_complete_delay_code", "type": "string", "description": "Optional filter on the construction-complete delay code column. When provided, the query adds: pj_construction_complete_delay_code IS NOT NULL AND pj_construction_complete_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}]', kpi_contract: '{"function_name": "get_cpo_to_cx_start", "node_type": "kpi", "node_id": "56171ab1-3ce1-44b6-b22e-400f5ffd9552", "node_label": "CPO to Cx Start", "description": "Measures the cycle time (in days) from CPO receipt confirmation to Construction Start Actual for each project/site. This helps track how long it takes to move from CPO receipt to the start of construction and enables performance comparisons across regions/markets/contractors and initiative groupings.", "parameters": [{"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Filter to projects with a specific construction-start delay code, or any real start delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}, {"name": "pj_construction_complete_delay_code", "type": "string", "description": "Filter to projects with a specific construction-complete delay code, or any real complete delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "project_count", "type": "number", "nullable": false}, {"name": "avg_cycle_time_days", "type": "string", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Measures the cycle time from CPO receipt (base_cpo_received) to construction start (ms_1550_construction_start_actual). CPO receipt is parsed from VARCHAR using a regex guard (must start with YYYY-MM-DD), then cast to timestamp::date. Cycle time (days) = ms_1550_construction_start_actual::date - base_cpo_received::timestamp::date. Excludes rows where either date is null, excludes negative durations, and excludes projects with pj_project_status = \'Dead\'. Aggregates by (rgn_region, m_area, m_market, construction_gc) to compute project_count, average, P50, and P90.', node_type: 'CORE', definition: 'Measures the cycle time from CPO receipt (base_cpo_received) to construction start (ms_1550_construction_start_actual). CPO receipt is parsed from VARCHAR using a regex guard (must start with YYYY-MM-DD), then cast to timestamp::date. Cycle time (days) = ms_1550_construction_start_actual::date - base_cpo_received::timestamp::date. Excludes rows where either date is null, excludes negative durations, and excludes projects with pj_project_status = \'Dead\'. Aggregates by (rgn_region, m_area, m_market, construction_gc) to compute project_count, average, P50, and P90.', kpi_python_function: 'def get_cpo_to_cx_start(execute_query, filters=None) -> list[dict]:\n    """CPO to Cx Start cycle time (days).\n\n    Measures cycle time from CPO receipt to construction start.\n    Start (CPO receipt): base_cpo_received (VARCHAR; guarded parse to date)\n    End (Construction start): ms_1550_construction_start_actual (timestamp)\n\n    Output metrics by group: project_count, avg, P50, P90 cycle time (days).\n    Group-by dimensions: rgn_region, m_area, m_market, construction_gc.\n\n    Optional filters supported (exact-match):\n      - rgn_region, m_area, m_market, construction_gc\n      - pj_project_id, s_site_id\n      - smp_name (if \'NTM\', applies additional constraints per requirements)\n      - start_date, end_date (applies to ms_1550_construction_start_actual)\n    """\n\n    filters = filters or {}\n\n    def _to_date_str(v):\n        if v is None:\n            return None\n        s = str(v).strip()\n        if not s:\n            return None\n        return s[:10]\n\n    # Seed WHERE with 1=1 (platform convention)\n    where_parts = ["1=1"]\n\n    # Always exclude Dead projects\n    where_parts.append("COALESCE(\\"pj_project_status\\", \'\') <> \'Dead\'")\n\n    # Dimension / ID filters ONLY\n    for k in [\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "pj_project_id",\n        "s_site_id",\n    ]:\n        if filters.get(k) is not None and str(filters.get(k)).strip() != "":\n            escaped = str(filters[k]).replace("\'", "\'\'")\n            where_parts.append(f\'"{k}" = \\\'{escaped}\\\'\')\n\n    # Program filter with NTM conditional (exact code as requested)\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    # Date range filter: apply to end milestone (construction start actual)\n    start_date = _to_date_str(filters.get("start_date"))\n    end_date = _to_date_str(filters.get("end_date"))\n    if start_date:\n        where_parts.append(f"\\"ms_1550_construction_start_actual\\"::date >= \'{start_date}\'::date")\n    if end_date:\n        where_parts.append(f"\\"ms_1550_construction_start_actual\\"::date <= \'{end_date}\'::date")\n\n\n    # Optional construction delay-code filters (engage when caller wants to narrow to delayed projects)\n\n    for _delay_col in ("pj_construction_start_delay_code", "pj_construction_complete_delay_code"):\n\n        _v = filters.get(_delay_col)\n\n        if _v is None or str(_v).strip() == "":\n\n            continue\n\n        _s = str(_v).strip()\n\n        where_parts.append(f\'"{_delay_col}" IS NOT NULL\')\n\n        where_parts.append(f\'"{_delay_col}" <> \\\'No Delay\\\'\')\n\n        if _s.lower() not in ("any", "true", "yes", "1", "*"):\n\n            _ss = _s.replace("\'", "\'\'")\n\n            where_parts.append(f\'"{_delay_col}" = \\\'{_ss}\\\'\')\n\n    additional_where = " AND ".join(where_parts)\n\n    sql = f"""\n        SELECT\n            sub."rgn_region" AS rgn_region,\n            sub."m_area" AS m_area,\n            sub."m_market" AS m_market,\n            sub."construction_gc" AS construction_gc,\n            COUNT(DISTINCT sub."pj_project_id") AS project_count,\n            AVG(sub.cycle_time_days::numeric) AS avg_cycle_time_days\n        FROM (\n            SELECT\n                t."pj_project_id",\n                t."rgn_region",\n                t."m_area",\n                t."m_market",\n                t."construction_gc",\n                (t."ms_1550_construction_start_actual"::date - cpo_received_dt) AS cycle_time_days\n            FROM (\n                SELECT\n                    "pj_project_id",\n                    "rgn_region",\n                    "m_area",\n                    "m_market",\n                    "construction_gc",\n                    "pj_project_status",\n                    "s_site_id",\n                    "smp_name",\n                    "smp_status",\n                    "ntm_project_type",\n                    "ms_1550_construction_start_actual",\n                    CASE\n                      WHEN "base_cpo_received"::text ~ \'^\\\\d{{4}}-\\\\d{{2}}-\\\\d{{2}}\'\n                      THEN "base_cpo_received"::timestamp::date\n                    END AS cpo_received_dt\n                FROM "pwc_macro_staging_schema".stg_ndpd_mbt_tmobile_macro_combined\n                WHERE {additional_where}\n            ) t\n            WHERE t."ms_1550_construction_start_actual" IS NOT NULL\n              AND t.cpo_received_dt IS NOT NULL\n              AND (t."ms_1550_construction_start_actual"::date - t.cpo_received_dt) >= 0\n        ) sub\n        GROUP BY 1,2,3,4\n        ORDER BY 1,2,3,4\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['"pj_project_id"', '"rgn_region"', '"m_area"', '"m_market"', '"construction_gc"', '"pj_project_status"', '"s_site_id"', '"smp_name"', '"smp_status"', '"ntm_project_type"', '"ms_1550_construction_start_actual"', '"base_cpo_received"', 'pj_construction_start_delay_code', 'pj_construction_complete_delay_code'], session_id: '69a3d22f26e208edc083a06e', label: 'CPO to Cx Start', kpi_related_core_node_ids: ['project'], kpi_relationship_type: 'AGGREGATES_FROM', kpi_kpi_id: '56171ab1-3ce1-44b6-b22e-400f5ffd9552', entity_type: 'kpi', kpi_name: 'CPO to Cx Start', name: '56171ab1-3ce1-44b6-b22e-400f5ffd9552', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Measures the cycle time (in days) from CPO receipt confirmation to Construction Start Actual for each project/site. This helps track how long it takes to move from CPO receipt to the start of construction and enables performance comparisons across regions/markets/contractors and initiative groupings. Optionally filterable by construction delay code: pass pj_construction_start_delay_code or pj_construction_complete_delay_code (any non-empty value engages IS NOT NULL AND <> \'No Delay\'; a specific code value also narrows to that code).', status: 'mentioned', node_id: '56171ab1-3ce1-44b6-b22e-400f5ffd9552'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'For each segment (milestone-pair), compute project lead time in days as (parsed_end_date - parsed_start_date), where each milestone column is regex-validated to start with YYYY-MM-DD (pattern \'^[0-9]{4}-[0-9]{2}-[0-9]{2}\') and then cast to timestamp::date; rows failing validation are excluded. For each segment, aggregate over projects by (rgn_region, m_area, m_market, construction_gc, segment_name) computing AVG(lead_days), PERCENTILE_CONT(0.5), PERCENTILE_CONT(0.9), and COUNT(DISTINCT pj_project_id). Implemented as 18 per-segment SQL queries (no UNION ALL) to avoid timeouts. Includes CX Complete→COP Submission (ms_1555→ms_1557) and COP Submission→COP Approved (ms_1557→ms_1559) sub-segments per QB Rows 230-231. Optionally filterable by program via smp_name with NTM-specific constraints; also supports common dimension filters and start/end date filters applied to parsed end milestone date.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region."}, {"column": "m_area", "type": "string", "description": "Area."}, {"column": "m_market", "type": "string", "description": "Market."}, {"column": "construction_gc", "type": "string", "description": "General contractor."}, {"column": "segment_name", "type": "string", "description": "Intermediate milestone segment name."}, {"column": "avg_days", "type": "float", "description": "Average lead time in calendar days for the segment."}, {"column": "project_count", "type": "int", "description": "Distinct count of projects contributing to the segment metrics."}]', kpi_business_logic: 'Accept optional filters: pj_project_id, rgn_region, m_area, m_market, construction_gc, por_category, smp_name, start_date, end_date.\nInitialize WHERE conditions with 1=1.\nIf smp_name is provided, filter to "smp_name" = smp_name; if smp_name equals \'NTM\' (case-insensitive), additionally require "smp_status" = \'Active\' and exclude two values from "ntm_project_type".\nApply additional pass-through filters on the base table for pj_project_id, rgn_region, m_area, m_market, construction_gc, por_category when provided.\nFor each configured segment:\n  - Parse start and end milestone dates using CASE WHEN (col)::text ~ \'^[0-9]{4}-[0-9]{2}-[0-9]{2}\' THEN (col)::timestamp::date END.\n  - Filter to rows where both start and end match the regex and where (parsed_end_date - parsed_start_date) >= 0.\n  - Optionally filter parsed_end_date within [start_date, end_date].\n  - Run a SQL aggregation grouped by (rgn_region, m_area, m_market, construction_gc) computing avg_days, p50_days, p90_days, and project_count.\n  - Collect results with rows = execute_query(sql) or [], inject segment_name into each row in Python, and append to output.\nReturn the concatenated list of rows from all segments.', kpi_filters: '[{"name": "pj_project_id", "type": "string", "description": ""}, {"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "por_category", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}, {"name": "start_date", "type": "string", "description": ""}, {"name": "end_date", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_intermediate_milestone_lead_time", "node_type": "kpi", "node_id": "2f2e0906-e4e7-42b5-93ed-1431fd7f85f9", "node_label": "Intermediate Milestone Lead Time", "description": "Measures the calendar-day lead time between defined intermediate milestone pairs for each project, then aggregates results to highlight bottleneck segments in the project lifecycle.", "parameters": [{"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "avg_days", "type": "string", "nullable": false}, {"name": "project_count", "type": "number", "nullable": false}, {"name": "segment_name", "type": "string", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'For each segment (milestone-pair), compute project lead time in days as (parsed_end_date - parsed_start_date), where each milestone column is regex-validated to start with YYYY-MM-DD (pattern \'^[0-9]{4}-[0-9]{2}-[0-9]{2}\') and then cast to timestamp::date; rows failing validation are excluded. For each segment, aggregate over projects by (rgn_region, m_area, m_market, construction_gc, segment_name) computing AVG(lead_days), PERCENTILE_CONT(0.5), PERCENTILE_CONT(0.9), and COUNT(DISTINCT pj_project_id). Implemented as 18 per-segment SQL queries (no UNION ALL) to avoid timeouts. Includes CX Complete→COP Submission (ms_1555→ms_1557) and COP Submission→COP Approved (ms_1557→ms_1559) sub-segments per QB Rows 230-231. Optionally filterable by program via smp_name with NTM-specific constraints; also supports common dimension filters and start/end date filters applied to parsed end milestone date.', node_type: 'CORE', definition: 'For each segment (milestone-pair), compute project lead time in days as (parsed_end_date - parsed_start_date), where each milestone column is regex-validated to start with YYYY-MM-DD (pattern \'^[0-9]{4}-[0-9]{2}-[0-9]{2}\') and then cast to timestamp::date; rows failing validation are excluded. For each segment, aggregate over projects by (rgn_region, m_area, m_market, construction_gc, segment_name) computing AVG(lead_days), PERCENTILE_CONT(0.5), PERCENTILE_CONT(0.9), and COUNT(DISTINCT pj_project_id). Implemented as 18 per-segment SQL queries (no UNION ALL) to avoid timeouts. Includes CX Complete→COP Submission (ms_1555→ms_1557) and COP Submission→COP Approved (ms_1557→ms_1559) sub-segments per QB Rows 230-231. Optionally filterable by program via smp_name with NTM-specific constraints; also supports common dimension filters and start/end date filters applied to parsed end milestone date.', kpi_python_function: 'def get_intermediate_milestone_lead_time(execute_query, filters=None) -> list[dict]:\n    """Compute intermediate milestone lead times per segment and aggregate by (region, area, market, GC, segment).\n\n    This implementation runs one SQL query per segment (instead of a large UNION ALL)\n    to avoid platform timeouts.\n\n    Optional filters supported (if provided in `filters`):\n      - por_category: restrict projects to a given POR category (not in default group-by)\n      - smp_name: restrict to a given program name; if smp_name == \'NTM\' (case-insensitive), also applies:\n          smp_status = \'Active\' AND ntm_project_type NOT IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\')\n      - rgn_region, m_area, m_market, construction_gc, pj_project_id: pass-through filters to base table\n      - start_date, end_date: applied to segment end milestone date (applied after regex parsing)\n\n    Returns rows:\n      rgn_region, m_area, m_market, construction_gc, segment_name,\n      avg_days, p50_days, p90_days, project_count\n    """\n\n    filters = filters or {}\n\n    def _escape(v):\n        return str(v).replace("\'", "\'\'")\n\n    # Seed WHERE and append allowlisted filters only\n    where_parts = ["1=1"]\n\n    # Program filter w/ NTM conditional (EXACT logic requested)\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    # Base pass-through filters\n    passthrough_keys = [\n        "pj_project_id",\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "por_category",\n    ]\n    for k in passthrough_keys:\n        if k in filters and filters.get(k) not in (None, ""):\n            where_parts.append(f\'"{k}" = \\\'{_escape(filters.get(k))}\\\'\')\n\n    where_sql = "WHERE " + " AND ".join(where_parts)\n\n    start_date = filters.get("start_date")\n    end_date = filters.get("end_date")\n\n    # Segment definitions: (segment_name, start_column_sql, end_column_sql)\n    segments = [\n        (\n            "Pre-NTP to Scoping Ready",\n            \'"ms_1310_pre_construction_package_received_actual"\',\n            \'"ms_1323_ready_for_scoping_actual"\',\n        ),\n        (\n            "Scoping to NTP Approved",\n            \'"ms_1323_ready_for_scoping_actual"\',\n            \'"ms_1507_tower_ntp_approved_actual"\',\n        ),\n        (\n            "NTP to Material Pickup",\n            \'"ms_1507_tower_ntp_approved_actual"\',\n            \'"pj_a_3925_msl_pickup_date_finish"\',\n        ),\n        (\n            "Material to CX Start",\n            \'"pj_a_3925_msl_pickup_date_finish"\',\n            \'"ms_1550_construction_start_actual"\',\n        ),\n        (\n            "CX Start to CX Complete",\n            \'"ms_1550_construction_start_actual"\',\n            \'"ms_1555_construction_complete_actual"\',\n        ),\n        (\n            "CX Complete to COP Submission",\n            \'"ms_1555_construction_complete_actual"\',\n            \'"ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl"\',\n        ),\n        (\n            "COP Submission to COP Approved",\n            \'"ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl"\',\n            \'"ms_1559_cop_approved_by_t_mobile_actual"\',\n        ),\n        (\n            "CX Complete to IX Start",\n            \'"ms_1555_construction_complete_actual"\',\n            \'"pj_a_5270_integration_start_finish"\',\n        ),\n        (\n            "IX Start to IX Complete",\n            \'"pj_a_5270_integration_start_finish"\',\n            \'"ms_1970_integration_complete_actual"\',\n        ),\n        (\n            "IX Complete to COP",\n            \'"ms_1970_integration_complete_actual"\',\n            \'"ms_1559_cop_approved_by_t_mobile_actual"\',\n        ),\n        (\n            "COP to On-Air",\n            \'"ms_1559_cop_approved_by_t_mobile_actual"\',\n            \'"pj_completion_objective_actual_date"\',\n        ),\n        (\n            "MW Installation (SLA 14d)",\n            \'"pj_a_4400_mw_installation_start_finish"\',\n            \'"pj_a_4425_mw_installation_complete_finish"\',\n        ),\n        (\n            "MW to Integration Start (SLA 7d)",\n            \'"pj_a_4425_mw_installation_complete_finish"\',\n            \'"pj_a_5270_integration_start_finish"\',\n        ),\n        (\n            "COP Received to Approved (MB) (SLA 14d)",\n            \'"pj_a_5500_receive_close_out_binder_finish"\',\n            \'"pj_a_5525_approve_close_out_binder_finish"\',\n        ),\n        (\n            "Pre-NTP to BoM Submission (SLA 10d)",\n            \'"pj_a_3800_pre_ntp_issued_finish"\',\n            \'"pj_a_3850_bom_submitted_bom_in_bat_finish"\',\n        ),\n        (\n            "E2E Cycle Time (SLA 120d)",\n            \'"ms_1313_pre_construction_package_validated_actual"\',\n            \'"ms_1559_cop_approved_by_t_mobile_actual"\',\n        ),\n        (\n            "Quote Approved to CX Start (SLA 21d)",\n            \'"ms_1333_scoping_package_approved_by_customer_actual"\',\n            \'"ms_1550_construction_start_actual"\',\n        ),\n        (\n            "CX Complete to COP Approved",\n            \'"ms_1555_construction_complete_actual"\',\n            \'"ms_1559_cop_approved_by_t_mobile_actual"\',\n        ),\n    ]\n\n    def _parsed_date_expr(col_sql: str) -> str:\n        # Guard dirty non-date text values; parse only YYYY-MM-DD* strings.\n        return (\n            f"CASE WHEN ({col_sql})::text ~ \'^[0-9]{{4}}-[0-9]{{2}}-[0-9]{{2}}\' "\n            f"THEN ({col_sql})::timestamp::date END"\n        )\n\n    all_results = []\n\n    for segment_name, start_col, end_col in segments:\n        start_date_sql = _parsed_date_expr(start_col)\n        end_date_sql = _parsed_date_expr(end_col)\n\n        seg_filters = [\n            f"({start_col})::text ~ \'^[0-9]{{4}}-[0-9]{{2}}-[0-9]{{2}}\'",\n            f"({end_col})::text ~ \'^[0-9]{{4}}-[0-9]{{2}}-[0-9]{{2}}\'",\n            f"(({end_date_sql}) - ({start_date_sql})) >= 0",\n        ]\n        if start_date not in (None, ""):\n            seg_filters.append(f"({end_date_sql}) >= \'{_escape(start_date)}\'::date")\n        if end_date not in (None, ""):\n            seg_filters.append(f"({end_date_sql}) <= \'{_escape(end_date)}\'::date")\n\n        seg_where = " AND ".join(seg_filters)\n\n        sql = f"""\nSELECT\n  \\"rgn_region\\" AS rgn_region,\n  \\"m_area\\" AS m_area,\n  \\"m_market\\" AS m_market,\n  \\"construction_gc\\" AS construction_gc,\n  AVG(({end_date_sql}) - ({start_date_sql}))::numeric(18,2) AS avg_days,\n  COUNT(DISTINCT \\"pj_project_id\\") AS project_count\nFROM \\"pwc_macro_staging_schema\\".\\"stg_ndpd_mbt_tmobile_macro_combined\\"\n{where_sql}\n  AND {seg_where}\nGROUP BY \\"rgn_region\\", \\"m_area\\", \\"m_market\\", \\"construction_gc\\"\nORDER BY \\"rgn_region\\", \\"m_area\\", \\"m_market\\", \\"construction_gc\\"\n"""\n\n        rows = execute_query(sql) or []\n        for row in rows:\n            row["segment_name"] = segment_name\n        all_results.extend(rows)\n\n    return all_results\n', kpi_source_columns: ['pj_project_id', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 'smp_name', 'smp_status', 'ntm_project_type', 'ms_1310_pre_construction_package_received_actual', 'ms_1323_ready_for_scoping_actual', 'ms_1507_tower_ntp_approved_actual', 'pj_a_3925_msl_pickup_date_finish', 'ms_1550_construction_start_actual', 'ms_1555_construction_complete_actual', 'ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl', 'pj_a_5270_integration_start_finish', 'ms_1970_integration_complete_actual', 'ms_1559_cop_approved_by_t_mobile_actual', 'pj_completion_objective_actual_date', 'pj_a_4400_mw_installation_start_finish', 'pj_a_4425_mw_installation_complete_finish', 'pj_a_5500_receive_close_out_binder_finish', 'pj_a_5525_approve_close_out_binder_finish', 'pj_a_3800_pre_ntp_issued_finish', 'pj_a_3850_bom_submitted_bom_in_bat_finish', 'ms_1313_pre_construction_package_validated_actual', 'ms_1333_scoping_package_approved_by_customer_actual'], session_id: '69a3d22f26e208edc083a06e', label: 'Intermediate Milestone Lead Time', kpi_related_core_node_ids: ['project', 'milestone', 'market', 'general_contractor'], kpi_relationship_type: 'AGGREGATES', kpi_kpi_id: '2f2e0906-e4e7-42b5-93ed-1431fd7f85f9', entity_type: 'kpi', kpi_name: 'Intermediate Milestone Lead Time', name: '2f2e0906-e4e7-42b5-93ed-1431fd7f85f9', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'segment_name'], kpi_description: 'Measures the calendar-day lead time between defined intermediate milestone pairs for each project, then aggregates results to highlight bottleneck segments in the project lifecycle.', status: 'mentioned', node_id: '2f2e0906-e4e7-42b5-93ed-1431fd7f85f9'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema."stg_services_ndpc_sessions_daily_from_sdb"', 'pwc_macro_staging_schema."stg_ndpd_mbt_tmobile_macro_combined"'], nl_business_rule: '', kpi_formula_description: 'For each NDPC sessiontitle, select the row with the maximum lastactivity, safely cast completed/approved/rejected/pending percent strings to numeric, join to stg_ndpd_mbt_tmobile_macro_combined on sessiontitle=scop_title, then (rgn_region, m_area, m_market, construction_gc, por_category) compute COUNT(DISTINCT sessiontitle), AVG completed/approved/rejected/pending %, and COUNT(DISTINCT sessiontitle) with approved%>=95. Scoped to WIP sites only (construction started, COP not submitted; non-date ms_1557 treated as not submitted). Optionally filterable by program via smp_name (with NTM constraints).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension from macro_combined."}, {"column": "m_area", "type": "string", "description": "Area dimension from macro_combined."}, {"column": "m_market", "type": "string", "description": "Market dimension from macro_combined."}, {"column": "construction_gc", "type": "string", "description": "General contractor dimension from macro_combined."}, {"column": "por_category", "type": "string", "description": "PoR category dimension from macro_combined."}, {"column": "session_count", "type": "integer", "description": "Count of distinct sessiontitle values after selecting the latest record per sessiontitle."}, {"column": "avg_completed_pct", "type": "numeric", "description": "Average of latest completed percent across sessions in the group (non-numeric/blank treated as NULL)."}, {"column": "avg_approved_pct", "type": "numeric", "description": "Average of latest approved percent across sessions in the group (non-numeric/blank treated as NULL)."}, {"column": "avg_rejected_pct", "type": "numeric", "description": "Average of latest rejected percent across sessions in the group (non-numeric/blank treated as NULL)."}, {"column": "sessions_above_95_count", "type": "integer", "description": "Count of distinct sessions whose latest approved percent is >= 95."}, {"column": "avg_pending_pct", "type": "float", "description": "Average pending percentage across latest NDPC sessions for WIP sites."}]', kpi_business_logic: '1) Build WHERE clause seeded with 1=1. 2) Enforce WIP scope on pj: require ms_1550_construction_start_actual IS NOT NULL and (ms_1557 is NULL OR ms_1557::text does NOT match YYYY-MM-DD) so dirty non-date COP values are treated as not submitted. 3) Apply optional allowlist filters on pj: rgn_region, m_area, m_market, construction_gc, por_category, pj_project_id, s_site_id, smp_name; when smp_name is \'NTM\' (case-insensitive), additionally require smp_status=\'Active\' and exclude ntm_project_type in (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\'). 4) From stg_services_ndpc_sessions_daily_from_sdb, reduce to the latest row per sessiontitle by joining to a grouped subquery selecting MAX(lastactivity). 5) On the latest rows, parse completedpercent/approvedpercent/rejectedpercent/pendingpercent to numeric only when non-empty and regex-valid. 6) Join latest session rows to stg_ndpd_mbt_tmobile_macro_combined on latest.sessiontitle = pj.scop_title. 7) Aggregate by pj rgn_region, m_area, m_market, construction_gc, por_category: compute distinct session count, averages of the four percent metrics, and distinct count of sessions with approved_pct>=95.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Filter by region."}, {"name": "m_area", "type": "string", "description": "Filter by area."}, {"name": "m_market", "type": "string", "description": "Filter by market."}, {"name": "construction_gc", "type": "string", "description": "Filter by general contractor."}, {"name": "por_category", "type": "string", "description": "Filter by POR category."}, {"name": "pj_project_id", "type": "string", "description": "Filter by project ID."}, {"name": "s_site_id", "type": "string", "description": "Filter by site ID."}, {"name": "smp_name", "type": "string", "description": "Filter by program name. If NTM, applies smp_status=Active and ntm_project_type exclusions."}]', kpi_contract: '{"function_name": "get_ndpc_session_quality_metrics", "node_type": "kpi", "node_id": "86da412d-44c9-4f7f-bc59-9c4ebfa82972", "node_label": "NDPC Session Quality Metrics", "description": "Aggregates NDPC session quality percentages (completed/upload, approved, rejected) using the latest record per session title, then averages these percentages across sessions by region/area/market, general contractor, and PoR category. Includes counts of total sessions and sessions meeting the >95% approval threshold to identify GCs/markets with low photo completion, poor customer approval, or high rejection rates.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [], "sample_output": [], "row_count": 0}', nl_description: 'For each NDPC sessiontitle, select the row with the maximum lastactivity, safely cast completed/approved/rejected/pending percent strings to numeric, join to stg_ndpd_mbt_tmobile_macro_combined on sessiontitle=scop_title, then (rgn_region, m_area, m_market, construction_gc, por_category) compute COUNT(DISTINCT sessiontitle), AVG completed/approved/rejected/pending %, and COUNT(DISTINCT sessiontitle) with approved%>=95. Scoped to WIP sites only (construction started, COP not submitted; non-date ms_1557 treated as not submitted). Optionally filterable by program via smp_name (with NTM constraints).', node_type: 'CORE', definition: 'For each NDPC sessiontitle, select the row with the maximum lastactivity, safely cast completed/approved/rejected/pending percent strings to numeric, join to stg_ndpd_mbt_tmobile_macro_combined on sessiontitle=scop_title, then (rgn_region, m_area, m_market, construction_gc, por_category) compute COUNT(DISTINCT sessiontitle), AVG completed/approved/rejected/pending %, and COUNT(DISTINCT sessiontitle) with approved%>=95. Scoped to WIP sites only (construction started, COP not submitted; non-date ms_1557 treated as not submitted). Optionally filterable by program via smp_name (with NTM constraints).', kpi_python_function: 'def get_ndpc_session_quality_metrics(execute_query, filters=None) -> list[dict]:\n    """Aggregates NDPC session quality percentages using latest record per sessiontitle,\n    then averages across sessions by region/area/market, GC, and PoR category.\n\n    Scoped to WIP sites only (construction started, COP not submitted or ms_1557 contains non-date garbage).\n    """\n\n    where_parts = ["1=1"]\n\n    # WIP filter (must be applied to macro_combined alias pj)\n    where_parts.append(\'pj."ms_1550_construction_start_actual" IS NOT NULL\')\n    where_parts.append(\'(\' \n                       \'pj."ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl" IS NULL \'\n                       \'OR pj."ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl"::text !~ \\\'^[0-9]{4}-[0-9]{2}-[0-9]{2}\\\'\'\n                       \')\')\n\n    # Allowlist filters (exact match)\n    if filters:\n        if filters.get("rgn_region"):\n            v = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f\'pj."rgn_region" = \\\'{v}\\\'\')\n        if filters.get("m_area"):\n            v = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f\'pj."m_area" = \\\'{v}\\\'\')\n        if filters.get("m_market"):\n            v = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f\'pj."m_market" = \\\'{v}\\\'\')\n        if filters.get("construction_gc"):\n            v = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f\'pj."construction_gc" = \\\'{v}\\\'\')\n        if filters.get("por_category"):\n            v = str(filters["por_category"]).replace("\'", "\'\'")\n            where_parts.append(f\'pj."por_category" = \\\'{v}\\\'\')\n        if filters.get("pj_project_id"):\n            v = str(filters["pj_project_id"]).replace("\'", "\'\'")\n            where_parts.append(f\'pj."pj_project_id" = \\\'{v}\\\'\')\n        if filters.get("s_site_id"):\n            v = str(filters["s_site_id"]).replace("\'", "\'\'")\n            where_parts.append(f\'pj."s_site_id" = \\\'{v}\\\'\')\n\n        # smp_name filter with NTM conditional (EXACT required logic)\n        if filters.get("smp_name"):\n            v = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f\'pj."smp_name" = \\\'{v}\\\'\')\n            if v.strip().upper() == \'NTM\':\n                where_parts.append(\'pj."smp_status" = \\\'Active\\\'\')\n                where_parts.append(\'pj."ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\nSELECT\n  pj."rgn_region" AS "rgn_region",\n  pj."m_area" AS "m_area",\n  pj."m_market" AS "m_market",\n  pj."construction_gc" AS "construction_gc",\n  pj."por_category" AS "por_category",\n  COUNT(DISTINCT latest."sessiontitle") AS "session_count",\n  AVG(latest."completed_pct") AS "avg_completed_pct",\n  AVG(latest."approved_pct") AS "avg_approved_pct",\n  AVG(latest."rejected_pct") AS "avg_rejected_pct",\n  AVG(latest."pending_pct") AS "avg_pending_pct",\n  COUNT(DISTINCT CASE WHEN latest."approved_pct" >= 95 THEN latest."sessiontitle" END) AS "sessions_above_95_count"\nFROM\n  (\n    SELECT\n      s."sessiontitle" AS "sessiontitle",\n      s."lastactivity" AS "lastactivity",\n      CASE\n        WHEN s."completedpercent" IS NOT NULL\n         AND TRIM(s."completedpercent") <> \'\'\n         AND TRIM(s."completedpercent") ~ \'^[0-9]+(\\\\.[0-9]+)?$\'\n        THEN NULLIF(TRIM(s."completedpercent"), \'\')::numeric\n        ELSE NULL\n      END AS "completed_pct",\n      CASE\n        WHEN s."approvedpercent" IS NOT NULL\n         AND TRIM(s."approvedpercent") <> \'\'\n         AND TRIM(s."approvedpercent") ~ \'^[0-9]+(\\\\.[0-9]+)?$\'\n        THEN NULLIF(TRIM(s."approvedpercent"), \'\')::numeric\n        ELSE NULL\n      END AS "approved_pct",\n      CASE\n        WHEN s."rejectedpercent" IS NOT NULL\n         AND TRIM(s."rejectedpercent") <> \'\'\n         AND TRIM(s."rejectedpercent") ~ \'^[0-9]+(\\\\.[0-9]+)?$\'\n        THEN NULLIF(TRIM(s."rejectedpercent"), \'\')::numeric\n        ELSE NULL\n      END AS "rejected_pct",\n      CASE\n        WHEN s."pendingpercent" IS NOT NULL\n         AND TRIM(s."pendingpercent") <> \'\'\n         AND TRIM(s."pendingpercent") ~ \'^[0-9]+(\\\\.[0-9]+)?$\'\n        THEN NULLIF(TRIM(s."pendingpercent"), \'\')::numeric\n        ELSE NULL\n      END AS "pending_pct"\n    FROM pwc_macro_staging_schema."stg_services_ndpc_sessions_daily_from_sdb" s\n    INNER JOIN (\n      SELECT\n        "sessiontitle",\n        MAX("lastactivity") AS "max_lastactivity"\n      FROM pwc_macro_staging_schema."stg_services_ndpc_sessions_daily_from_sdb"\n      GROUP BY "sessiontitle"\n    ) mx\n      ON s."sessiontitle" = mx."sessiontitle"\n     AND s."lastactivity" = mx."max_lastactivity"\n  ) latest\nINNER JOIN pwc_macro_staging_schema."stg_ndpd_mbt_tmobile_macro_combined" pj\n  ON latest."sessiontitle" = pj."scop_title"\nWHERE {where_sql}\nGROUP BY\n  pj."rgn_region",\n  pj."m_area",\n  pj."m_market",\n  pj."construction_gc",\n  pj."por_category"\nORDER BY\n  pj."rgn_region",\n  pj."m_area",\n  pj."m_market",\n  pj."construction_gc",\n  pj."por_category";\n"""\n\n    return execute_query(sql, db="public")\n', kpi_source_columns: ['stg_services_ndpc_sessions_daily_from_sdb."sessiontitle"', 'stg_services_ndpc_sessions_daily_from_sdb."lastactivity"', 'stg_services_ndpc_sessions_daily_from_sdb."completedpercent"', 'stg_services_ndpc_sessions_daily_from_sdb."approvedpercent"', 'stg_services_ndpc_sessions_daily_from_sdb."rejectedpercent"', 'stg_services_ndpc_sessions_daily_from_sdb."pendingpercent"', 'stg_ndpd_mbt_tmobile_macro_combined."scop_title"', 'stg_ndpd_mbt_tmobile_macro_combined."rgn_region"', 'stg_ndpd_mbt_tmobile_macro_combined."m_area"', 'stg_ndpd_mbt_tmobile_macro_combined."m_market"', 'stg_ndpd_mbt_tmobile_macro_combined."construction_gc"', 'stg_ndpd_mbt_tmobile_macro_combined."por_category"', 'stg_ndpd_mbt_tmobile_macro_combined."pj_project_id"', 'stg_ndpd_mbt_tmobile_macro_combined."s_site_id"', 'stg_ndpd_mbt_tmobile_macro_combined."smp_name"', 'stg_ndpd_mbt_tmobile_macro_combined."smp_status"', 'stg_ndpd_mbt_tmobile_macro_combined."ntm_project_type"', 'stg_ndpd_mbt_tmobile_macro_combined."ms_1550_construction_start_actual"', 'stg_ndpd_mbt_tmobile_macro_combined."ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl"'], session_id: '69a3d22f26e208edc083a06e', label: 'NDPC Session Quality Metrics', kpi_related_core_node_ids: ['project', 'quality_session_ndpc', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '86da412d-44c9-4f7f-bc59-9c4ebfa82972', entity_type: 'kpi', kpi_name: 'NDPC Session Quality Metrics', name: '86da412d-44c9-4f7f-bc59-9c4ebfa82972', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category'], kpi_description: 'Aggregates NDPC session quality percentages (completed/upload, approved, rejected) using the latest record per session title, then averages these percentages across sessions by region/area/market, general contractor, and PoR category. Includes counts of total sessions and sessions meeting the >95% approval threshold to identify GCs/markets with low photo completion, poor customer approval, or high rejection rates.', status: 'mentioned', node_id: '86da412d-44c9-4f7f-bc59-9c4ebfa82972'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'For each active project in pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined, evaluate configured (predecessor_milestone_column → milestone_column) SLA pairs. For each pair where predecessor date is present and current milestone date is null, compute aging_days = (as_of_date - predecessor_date in days) and sla_pct = (aging_days / expected_sla_days) * 100, then classify as On Track / At Risk / Breached using risk_threshold_pct and breach_threshold_pct. In addition, compute Nokia-specific aging bucket classifications for four WIP aging pairs (start populated, end null): CX Start→CX Complete, CX Complete→COP Submission, COP Submission→COP Approved, and Civil Start Delay, using per-pair bucket thresholds to count On Track / Off Track / Intervention Required. The ms_1557 column is guarded in SQL without regex to treat garbage text as NULL. Return aggregated results grouped by rgn_region, m_area, m_market, construction_gc and milestone_name (for SLA pairs) or aging_pair_name (for Nokia bucket pairs), including avg/p90 (SLA) and avg/max (bucket pairs), and echo as_of_date.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping for the aggregated alert metrics."}, {"column": "m_area", "type": "string", "description": "Area grouping for the aggregated alert metrics."}, {"column": "m_market", "type": "string", "description": "Market grouping for the aggregated alert metrics."}, {"column": "milestone_name", "type": "string", "description": "Current (waiting) milestone being monitored for aging/SLA risk."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping (only when include_gc is enabled)."}, {"column": "total_waiting", "type": "int", "description": "Count of distinct projects waiting on the milestone (predecessor complete, current incomplete)."}, {"column": "at_risk_count", "type": "int", "description": "Number of waiting rows classified as \'At Risk\' within the group."}, {"column": "breached_count", "type": "int", "description": "Number of waiting rows classified as \'Breached\' within the group."}, {"column": "avg_aging_days", "type": "float", "description": "Average aging_days for waiting items in the group."}, {"column": "aging_pair_name", "type": "string", "description": "Nokia aging bucket pair name (e.g., CX Start to CX Complete). Populated for Nokia bucket rows only."}, {"column": "on_track_count", "type": "int", "description": "Count of WIP projects classified as On Track per Nokia thresholds."}, {"column": "off_track_count", "type": "int", "description": "Count of WIP projects classified as Off Track per Nokia thresholds."}, {"column": "intervention_count", "type": "int", "description": "Count of WIP projects classified as Intervention Required per Nokia thresholds."}, {"column": "max_aging_days", "type": "int", "description": "Maximum aging days for the WIP population in this bucket pair."}, {"column": "as_of_date", "type": "string", "description": "Reference date used for aging calculations (ISO format)."}]', kpi_business_logic: 'Parse as_of_date from filters (date/datetime or parseable string); if not provided or unparseable, default to the runtime\'s current date.\nLoad SLA milestone pairs (physical column names) unless overridden by filters.milestone_pairs; read sla_config overrides, risk_threshold_pct, breach_threshold_pct.\nDefine Nokia aging bucket configurations for four pairs with start/end columns and bucket thresholds.\nBuild one SQL query against pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined selecting pj_project_id, rgn_region, m_area, m_market, construction_gc and all columns referenced by either SLA pairs or Nokia bucket pairs.\nApply core filter pj_project_status=\'Active\' and optional allowlisted equality filters; apply required smp_name filter with NTM conditional when provided.\nGuard ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl in SQL using LENGTH + first-character numeric check to return NULL for garbage values (avoids regex).\nFor each row and each SLA pair: if predecessor date exists and current milestone date is NULL, compute aging_days, sla_pct and status (On Track / At Risk / Breached), and aggregate by (rgn_region, m_area, m_market, construction_gc, milestone_name).\nFor each row and each Nokia bucket pair: if start date exists and end date is NULL, compute aging_days, classify bucket, and aggregate counts/avg/max by (rgn_region, m_area, m_market, construction_gc, aging_pair_name).\nReturn combined SLA + Nokia bucket aggregation rows, sorted deterministically, and echo as_of_date.', kpi_filters: '[{"name": "as_of_date", "type": "string", "description": "Optional. Reference date for aging calculations; date/datetime or parseable string."}, {"name": "pj_project_id", "type": "string", "description": "Optional. Equality filter."}, {"name": "rgn_region", "type": "string", "description": "Optional. Equality filter."}, {"name": "m_area", "type": "string", "description": "Optional. Equality filter."}, {"name": "m_market", "type": "string", "description": "Optional. Equality filter."}, {"name": "construction_gc", "type": "string", "description": "Optional. Equality filter."}, {"name": "pj_project_type", "type": "string", "description": "Optional. Equality filter."}, {"name": "pj_program_name", "type": "string", "description": "Optional. Equality filter."}, {"name": "smp_name", "type": "string", "description": "Optional. Equality filter; if \'NTM\' (case-insensitive), also requires smp_status=\'Active\' and excludes two ntm_project_type values."}, {"name": "risk_threshold_pct", "type": "string", "description": "Optional numeric. Default 50."}, {"name": "breach_threshold_pct", "type": "string", "description": "Optional numeric. Default 100."}, {"name": "sla_config", "type": "string", "description": "Optional dict mapping milestone_name (current milestone column) -> expected_sla_days override."}, {"name": "milestone_pairs", "type": "string", "description": "Optional list of dicts overriding SLA milestone pairs: {milestone_name, predecessor_name, expected_sla_days}."}]', kpi_contract: '{"function_name": "get_milestone_aging_alert", "node_type": "kpi", "node_id": "b1325712-f39f-4551-ba34-98a0bc767ebe", "node_label": "Milestone Aging Alert", "description": "Detects milestone aging and SLA breach risk for active projects by measuring how long projects have been waiting on specific upcoming milestones after their predecessor milestone was completed. This helps identify projects that are on track, at risk, or breached against expected SLA timelines. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).", "parameters": [{"name": "as_of_date", "type": "date", "description": "Filter by as of date", "required": false, "sample_values": []}, {"name": "sla_config", "type": "string", "description": "Filter by sla config", "required": false, "sample_values": []}, {"name": "risk_threshold_pct", "type": "string", "description": "Filter by risk threshold pct", "required": false, "sample_values": []}, {"name": "breach_threshold_pct", "type": "string", "description": "Filter by breach threshold pct", "required": false, "sample_values": []}, {"name": "milestone_pairs", "type": "string", "description": "Filter by milestone pairs", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "aging_pair_name", "type": "string", "nullable": true}, {"name": "on_track_count", "type": "number", "nullable": true}, {"name": "off_track_count", "type": "number", "nullable": true}, {"name": "intervention_count", "type": "number", "nullable": true}, {"name": "avg_aging_days", "type": "number", "nullable": false}, {"name": "max_aging_days", "type": "number", "nullable": true}, {"name": "as_of_date", "type": "date", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'For each active project in pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined, evaluate configured (predecessor_milestone_column → milestone_column) SLA pairs. For each pair where predecessor date is present and current milestone date is null, compute aging_days = (as_of_date - predecessor_date in days) and sla_pct = (aging_days / expected_sla_days) * 100, then classify as On Track / At Risk / Breached using risk_threshold_pct and breach_threshold_pct. In addition, compute Nokia-specific aging bucket classifications for four WIP aging pairs (start populated, end null): CX Start→CX Complete, CX Complete→COP Submission, COP Submission→COP Approved, and Civil Start Delay, using per-pair bucket thresholds to count On Track / Off Track / Intervention Required. The ms_1557 column is guarded in SQL without regex to treat garbage text as NULL. Return aggregated results grouped by rgn_region, m_area, m_market, construction_gc and milestone_name (for SLA pairs) or aging_pair_name (for Nokia bucket pairs), including avg/p90 (SLA) and avg/max (bucket pairs), and echo as_of_date.', node_type: 'CORE', definition: 'For each active project in pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined, evaluate configured (predecessor_milestone_column → milestone_column) SLA pairs. For each pair where predecessor date is present and current milestone date is null, compute aging_days = (as_of_date - predecessor_date in days) and sla_pct = (aging_days / expected_sla_days) * 100, then classify as On Track / At Risk / Breached using risk_threshold_pct and breach_threshold_pct. In addition, compute Nokia-specific aging bucket classifications for four WIP aging pairs (start populated, end null): CX Start→CX Complete, CX Complete→COP Submission, COP Submission→COP Approved, and Civil Start Delay, using per-pair bucket thresholds to count On Track / Off Track / Intervention Required. The ms_1557 column is guarded in SQL without regex to treat garbage text as NULL. Return aggregated results grouped by rgn_region, m_area, m_market, construction_gc and milestone_name (for SLA pairs) or aging_pair_name (for Nokia bucket pairs), including avg/p90 (SLA) and avg/max (bucket pairs), and echo as_of_date.', kpi_python_function: 'def get_milestone_aging_alert(execute_query, filters=None) -> list[dict]:\n    import datetime\n    from statistics import mean\n\n    filters = filters or {}\n\n    # --- \'As of\' date ---\n    # Allow caller to set the reference date for aging calculations.\n    # Accepted formats: datetime.date/datetime.datetime or strings: YYYY-MM-DD, YYYY-MM-DD HH:MM:SS, ISO-8601\n    as_of_date = filters.get("as_of_date")\n\n    def _to_date(v):\n        if v is None or v == "":\n            return None\n        if isinstance(v, datetime.date) and not isinstance(v, datetime.datetime):\n            return v\n        if isinstance(v, datetime.datetime):\n            return v.date()\n        s = str(v).strip()\n        try:\n            return datetime.datetime.fromisoformat(s.replace("Z", "+00:00")).date()\n        except Exception:\n            pass\n        for fmt in ("%Y-%m-%d", "%Y-%m-%d %H:%M:%S", "%m/%d/%Y", "%m/%d/%Y %H:%M:%S"):\n            try:\n                return datetime.datetime.strptime(s, fmt).date()\n            except Exception:\n                continue\n        return None\n\n    today = _to_date(as_of_date) or datetime.date.today()\n\n    # --- SLA + thresholds configuration (existing logic retained) ---\n    # Physical milestone column names from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n    default_pairs = [\n        ("ms_1323_ready_for_scoping_actual", "ms_1310_pre_construction_package_received_actual", 14),\n        ("ms_1327_scoping_and_quoting_package_validated_actual", "ms_1323_ready_for_scoping_actual", 10),\n        ("ms_1507_tower_ntp_approved_actual", "ms_1327_scoping_and_quoting_package_validated_actual", 21),\n        ("ms_1550_construction_start_actual", "ms_1507_tower_ntp_approved_actual", 14),\n        ("ms_1555_construction_complete_actual", "ms_1550_construction_start_actual", 21),\n        ("ms_1970_integration_complete_actual", "ms_1555_construction_complete_actual", 30),\n        ("ms_1559_cop_approved_by_t_mobile_actual", "ms_1970_integration_complete_actual", 14),\n    ]\n\n    sla_override = filters.get("sla_config") or {}\n    risk_threshold_pct = float(filters.get("risk_threshold_pct", 50))\n    breach_threshold_pct = float(filters.get("breach_threshold_pct", 100))\n\n    # Allow overriding which milestone pairs are evaluated (existing)\n    # Expected format: [{"milestone_name":"<physical_col>","predecessor_name":"<physical_col>","expected_sla_days":14}, ...]\n    if filters.get("milestone_pairs"):\n        milestone_pairs = []\n        for mp in (filters.get("milestone_pairs") or []):\n            milestone_pairs.append(\n                (\n                    mp.get("milestone_name"),\n                    mp.get("predecessor_name"),\n                    int(mp.get("expected_sla_days")) if mp.get("expected_sla_days") is not None else None,\n                )\n            )\n    else:\n        milestone_pairs = list(default_pairs)\n\n    # --- Nokia aging bucket classifications ---\n    aging_buckets = {\n        "CX Start to CX Complete": {\n            "start": "ms_1550_construction_start_actual",\n            "end": "ms_1555_construction_complete_actual",\n            "buckets": [(0, 13, "On Track"), (14, 24, "Intervention Required"), (25, 999999, "Off Track")],\n        },\n        "CX Complete to COP Submission": {\n            "start": "ms_1555_construction_complete_actual",\n            "end": "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl",\n            "buckets": [(0, 6, "On Track"), (7, 14, "Off Track"), (15, 999999, "Intervention Required")],\n        },\n        "COP Submission to COP Approved": {\n            "start": "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl",\n            "end": "ms_1559_cop_approved_by_t_mobile_actual",\n            "buckets": [(0, 29, "On Track"), (30, 60, "Off Track"), (61, 999999, "Intervention Required")],\n        },\n        "Civil Start Delay": {\n            "start": "pj_a_3710_ran_entitlement_complete_finish",\n            "end": "pj_a_4250_civil_construction_start_finish",\n            "buckets": [(0, 60, "On Track"), (61, 999999, "Off Track")],\n        },\n    }\n\n    def _classify_bucket(days, bucket_defs):\n        if days is None:\n            return None\n        for lo, hi, label in bucket_defs:\n            if days >= lo and days <= hi:\n                return label\n        return None\n\n    def _percentile_cont(sorted_vals, p):\n        n = len(sorted_vals)\n        if n == 0:\n            return None\n        if n == 1:\n            return float(sorted_vals[0])\n        if p <= 0:\n            return float(sorted_vals[0])\n        if p >= 1:\n            return float(sorted_vals[-1])\n        k = (n - 1) * p\n        f = int(k)\n        c = min(f + 1, n - 1)\n        if f == c:\n            return float(sorted_vals[f])\n        d0 = sorted_vals[f] * (c - k)\n        d1 = sorted_vals[c] * (k - f)\n        return float(d0 + d1)\n\n    # Determine required milestone columns (SLA pairs + Nokia bucket pairs)\n    needed_ms_cols = set()\n    for milestone_name, predecessor_name, _sla in milestone_pairs:\n        if milestone_name:\n            needed_ms_cols.add(milestone_name)\n        if predecessor_name:\n            needed_ms_cols.add(predecessor_name)\n\n    for cfg in aging_buckets.values():\n        if cfg.get("start"):\n            needed_ms_cols.add(cfg["start"])\n        if cfg.get("end"):\n            needed_ms_cols.add(cfg["end"])\n\n    # Base columns needed for grouping\n    base_cols = ["pj_project_id", "rgn_region", "m_area", "m_market", "construction_gc"]\n    select_cols = base_cols + sorted(needed_ms_cols)\n\n    # Seed core WHERE conditions first\n    where_parts = ["pj_project_status = \'Active\'"]\n\n    # Optional equality filters (explicit allowlist)\n    for fcol in [\n        "pj_project_id",\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "pj_project_type",\n        "pj_program_name",\n    ]:\n        if fcol in filters and filters.get(fcol) not in (None, ""):\n            escaped = str(filters.get(fcol)).replace("\'", "\'\'")\n            where_parts.append(f"{fcol} = \'{escaped}\'")\n\n    # smp_name filter with NTM conditional (exact required code)\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    # Build SELECT; apply ms_1557 guard without regex (pipeline-safe)\n    quoted_select_cols = []\n    for c in select_cols:\n        if c == "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl":\n            quoted_select_cols.append(\n                \'CASE WHEN LENGTH("ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl"::text) >= 10 \'\n                \'AND SUBSTRING("ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl"::text, 1, 1) BETWEEN \\\'0\\\' AND \\\'9\\\' \'\n                \'THEN "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl" ELSE NULL END AS "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl"\'\n            )\n        else:\n            quoted_select_cols.append(f\'"{c}"\')\n\n    sql = (\n        f"""SELECT {\', \'.join(quoted_select_cols)} FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined WHERE {\' AND \'.join(where_parts)}"""\n    )\n\n    # Per request: do not pass max_rows=None; rely on platform default\n    rows = execute_query(sql) or []\n\n    # --- SLA waiting rows ---\n    waiting_rows = []\n    for r in rows:\n        pj_project_id = r.get("pj_project_id")\n        rgn_region = r.get("rgn_region")\n        m_area = r.get("m_area")\n        m_market = r.get("m_market")\n        construction_gc = r.get("construction_gc")\n\n        for milestone_name, predecessor_name, default_sla in milestone_pairs:\n            if not milestone_name or not predecessor_name:\n                continue\n\n            predecessor_date = _to_date(r.get(predecessor_name))\n            current_milestone_date = _to_date(r.get(milestone_name))\n\n            if predecessor_date is None:\n                continue\n            if current_milestone_date is not None:\n                continue\n\n            expected_sla_days = sla_override.get(milestone_name, default_sla)\n            if expected_sla_days in (None, 0, "0"):\n                continue\n            expected_sla_days = float(expected_sla_days)\n\n            aging_days = (today - predecessor_date).days\n            sla_pct = (aging_days / expected_sla_days) * 100.0\n\n            if sla_pct < risk_threshold_pct:\n                status = "On Track"\n            elif sla_pct < breach_threshold_pct:\n                status = "At Risk"\n            else:\n                status = "Breached"\n\n            waiting_rows.append(\n                {\n                    "pj_project_id": pj_project_id,\n                    "rgn_region": rgn_region,\n                    "m_area": m_area,\n                    "m_market": m_market,\n                    "construction_gc": construction_gc,\n                    "milestone_name": milestone_name,\n                    "predecessor_name": predecessor_name,\n                    "predecessor_date": predecessor_date.isoformat(),\n                    "expected_sla_days": expected_sla_days,\n                    "aging_days": aging_days,\n                    "sla_pct": sla_pct,\n                    "status": status,\n                }\n            )\n\n    # --- SLA aggregation output ---\n    agg = {}\n    for wr in waiting_rows:\n        key = (wr.get("rgn_region"), wr.get("m_area"), wr.get("m_market"), wr.get("milestone_name"), wr.get("construction_gc"))\n        if key not in agg:\n            agg[key] = {\n                "rgn_region": wr.get("rgn_region"),\n                "m_area": wr.get("m_area"),\n                "m_market": wr.get("m_market"),\n                "milestone_name": wr.get("milestone_name"),\n                "construction_gc": wr.get("construction_gc"),\n                "_project_ids": set(),\n                "_aging_days": [],\n                "at_risk_count": 0,\n                "breached_count": 0,\n            }\n\n        agg[key]["_project_ids"].add(wr.get("pj_project_id"))\n        agg[key]["_aging_days"].append(int(wr.get("aging_days", 0)))\n        if wr.get("status") == "At Risk":\n            agg[key]["at_risk_count"] += 1\n        elif wr.get("status") == "Breached":\n            agg[key]["breached_count"] += 1\n\n    results = []\n    for v in agg.values():\n        aging = sorted(v["_aging_days"])\n        total_waiting = len(v["_project_ids"])\n        avg_aging_days = float(mean(aging)) if aging else None\n        p90_aging_days = _percentile_cont(aging, 0.9) if aging else None\n\n        results.append(\n            {\n                "rgn_region": v.get("rgn_region"),\n                "m_area": v.get("m_area"),\n                "m_market": v.get("m_market"),\n                "construction_gc": v.get("construction_gc"),\n                "milestone_name": v.get("milestone_name"),\n                "total_waiting": total_waiting,\n                "at_risk_count": int(v.get("at_risk_count", 0)),\n                "breached_count": int(v.get("breached_count", 0)),\n                "avg_aging_days": avg_aging_days,\n                "p90_aging_days": p90_aging_days,\n                "as_of_date": today.isoformat(),\n            }\n        )\n\n    # --- Nokia bucket aggregation output (additional row type) ---\n    bucket_agg = {}\n    for r in rows:\n        rgn_region = r.get("rgn_region")\n        m_area = r.get("m_area")\n        m_market = r.get("m_market")\n        construction_gc = r.get("construction_gc")\n\n        for pair_name, cfg in aging_buckets.items():\n            start_col = cfg.get("start")\n            end_col = cfg.get("end")\n            bucket_defs = cfg.get("buckets") or []\n\n            start_dt = _to_date(r.get(start_col))\n            end_dt = _to_date(r.get(end_col))\n\n            if start_dt is None:\n                continue\n            if end_dt is not None:\n                continue\n\n            aging_days = (today - start_dt).days\n            bucket_label = _classify_bucket(aging_days, bucket_defs)\n\n            key = (rgn_region, m_area, m_market, construction_gc, pair_name)\n            if key not in bucket_agg:\n                bucket_agg[key] = {\n                    "rgn_region": rgn_region,\n                    "m_area": m_area,\n                    "m_market": m_market,\n                    "construction_gc": construction_gc,\n                    "aging_pair_name": pair_name,\n                    "on_track_count": 0,\n                    "off_track_count": 0,\n                    "intervention_count": 0,\n                    "_aging_days": [],\n                }\n\n            bucket_agg[key]["_aging_days"].append(int(aging_days))\n            if bucket_label == "On Track":\n                bucket_agg[key]["on_track_count"] += 1\n            elif bucket_label == "Off Track":\n                bucket_agg[key]["off_track_count"] += 1\n            elif bucket_label == "Intervention Required":\n                bucket_agg[key]["intervention_count"] += 1\n\n    for v in bucket_agg.values():\n        aging = v.get("_aging_days") or []\n        aging_sorted = sorted(aging)\n        results.append(\n            {\n                "rgn_region": v.get("rgn_region"),\n                "m_area": v.get("m_area"),\n                "m_market": v.get("m_market"),\n                "construction_gc": v.get("construction_gc"),\n                "aging_pair_name": v.get("aging_pair_name"),\n                "on_track_count": int(v.get("on_track_count", 0)),\n                "off_track_count": int(v.get("off_track_count", 0)),\n                "intervention_count": int(v.get("intervention_count", 0)),\n                "avg_aging_days": float(mean(aging_sorted)) if aging_sorted else None,\n                "max_aging_days": int(aging_sorted[-1]) if aging_sorted else None,\n                "as_of_date": today.isoformat(),\n            }\n        )\n\n    def _sort_key(x):\n        return (\n            (x.get("rgn_region") or ""),\n            (x.get("m_area") or ""),\n            (x.get("m_market") or ""),\n            (x.get("construction_gc") or ""),\n            (x.get("milestone_name") or ""),\n            (x.get("aging_pair_name") or ""),\n        )\n\n    results.sort(key=_sort_key)\n    return results\n', kpi_source_columns: ['pj_project_status', 'pj_project_id', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_project_type', 'pj_program_name', 'smp_name', 'smp_status', 'ntm_project_type', 'ms_1310_pre_construction_package_received_actual', 'ms_1323_ready_for_scoping_actual', 'ms_1327_scoping_and_quoting_package_validated_actual', 'ms_1507_tower_ntp_approved_actual', 'ms_1550_construction_start_actual', 'ms_1555_construction_complete_actual', 'ms_1970_integration_complete_actual', 'ms_1559_cop_approved_by_t_mobile_actual', 'ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl', 'pj_a_3710_ran_entitlement_complete_finish', 'pj_a_4250_civil_construction_start_finish'], session_id: '69a3d22f26e208edc083a06e', label: 'Milestone Aging Alert', kpi_related_core_node_ids: ['project', 'milestone', 'market', 'general_contractor'], kpi_relationship_type: 'DERIVED_FROM', kpi_kpi_id: 'b1325712-f39f-4551-ba34-98a0bc767ebe', entity_type: 'kpi', kpi_name: 'Milestone Aging Alert', name: 'b1325712-f39f-4551-ba34-98a0bc767ebe', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'milestone_name (for SLA-pair output rows)', 'aging_pair_name (for Nokia bucket output rows)'], kpi_description: 'Detects milestone aging and SLA breach risk for active projects by measuring how long projects have been waiting on specific upcoming milestones after their predecessor milestone was completed. This helps identify projects that are on track, at risk, or breached against expected SLA timelines. Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).', status: 'mentioned', node_id: 'b1325712-f39f-4551-ba34-98a0bc767ebe'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Document Gate Compliance backlog counts Active projects that are stuck at the pre-construction document gate, computed as: (1) arrived_not_validated_count = distinct Active projects with ms_1310_pre_construction_package_received_actual not null AND ms_1313_pre_construction_package_validated_actual is null AND ms_1315_pre_construction_package_rejected_actual is null; plus (2) rejected_without_subsequent_validation_count = distinct Active projects with ms_1315_pre_construction_package_rejected_actual not null AND (ms_1313_pre_construction_package_validated_actual is null OR ms_1313_pre_construction_package_validated_actual::timestamp <= ms_1315_pre_construction_package_rejected_actual::timestamp). The output is grouped by an optional group_by dimension list (default: rgn_region, m_area, m_market; optional additionally: pj_general_contractor).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension from the project record."}, {"column": "m_area", "type": "string", "description": "Area dimension from the project record."}, {"column": "m_market", "type": "string", "description": "Market dimension from the project record."}, {"column": "arrived_not_validated_count", "type": "integer", "description": "Distinct active projects where the pre-con package has been received but neither validated nor rejected."}, {"column": "rejected_without_subsequent_validation_count", "type": "integer", "description": "Distinct active projects where the pre-con package has been rejected and has not been validated after that rejection."}, {"column": "document_gate_backlog_total_count", "type": "integer", "description": "Distinct active projects meeting either backlog condition (union of the two states)."}]', kpi_business_logic: 'Initialize filters to an empty dict when filters is None.\nFilter source rows to pj_project_status = \'Active\'.\nOptionally filter by start_date/end_date such that either package received timestamp OR package rejected timestamp satisfies the bound.\nOptionally filter by rgn_region, m_area, m_market, pj_general_contractor, pj_project_type, por_category, s_site_id, pj_project_id when provided.\nOptionally filter by smp_name; if smp_name is \'NTM\' (case-insensitive after trim), additionally require smp_status = \'Active\' and exclude ntm_project_type in (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\').\nDetermine grouping dimensions from filters[\'group_by\']; default to [\'rgn_region\',\'m_area\',\'m_market\']; allow rgn_region, m_area, m_market, pj_general_contractor only.\nCompute arrived_not_validated_count as COUNT(DISTINCT pj_project_id) where received_actual is not null AND validated_actual is null AND rejected_actual is null.\nCompute rejected_without_subsequent_validation_count as COUNT(DISTINCT pj_project_id) where rejected_actual is not null AND (validated_actual is null OR validated_ts <= rejected_ts).\nCompute document_gate_backlog_total_count as COUNT(DISTINCT pj_project_id) where either of the above conditions is true.\nReturn the grouped rows ordered by the same group_by dimensions.', kpi_filters: '[{"name": "start_date", "type": "string", "description": ""}, {"name": "end_date", "type": "string", "description": ""}, {"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "pj_general_contractor", "type": "string", "description": ""}, {"name": "pj_project_type", "type": "string", "description": ""}, {"name": "por_category", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}, {"name": "group_by", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_document_gate_compliance", "node_type": "kpi", "node_id": "2802fe3a-0451-46ff-849f-7c302aa99335", "node_label": "Document Gate Compliance", "description": "Tracks how many active projects are stuck at the pre-construction document gate after the package has arrived but has not been validated, and how many active projects have had the package rejected without subsequent validation. This highlights process/compliance bottlenecks and audit risk, and is used to trigger Process & Compliance escalation when backlog grows. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').", "parameters": [{"name": "group_by", "type": "string", "description": "Filter by group by", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "pj_general_contractor", "type": "string", "description": "Filter by pj general contractor", "required": false, "sample_values": []}, {"name": "pj_project_type", "type": "string", "description": "Filter by pj project type", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "arrived_not_validated_count", "type": "number", "nullable": false}, {"name": "rejected_without_subsequent_validation_count", "type": "number", "nullable": false}, {"name": "document_gate_backlog_total_count", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Document Gate Compliance backlog counts Active projects that are stuck at the pre-construction document gate, computed as: (1) arrived_not_validated_count = distinct Active projects with ms_1310_pre_construction_package_received_actual not null AND ms_1313_pre_construction_package_validated_actual is null AND ms_1315_pre_construction_package_rejected_actual is null; plus (2) rejected_without_subsequent_validation_count = distinct Active projects with ms_1315_pre_construction_package_rejected_actual not null AND (ms_1313_pre_construction_package_validated_actual is null OR ms_1313_pre_construction_package_validated_actual::timestamp <= ms_1315_pre_construction_package_rejected_actual::timestamp). The output is grouped by an optional group_by dimension list (default: rgn_region, m_area, m_market; optional additionally: pj_general_contractor).', node_type: 'CORE', definition: 'Document Gate Compliance backlog counts Active projects that are stuck at the pre-construction document gate, computed as: (1) arrived_not_validated_count = distinct Active projects with ms_1310_pre_construction_package_received_actual not null AND ms_1313_pre_construction_package_validated_actual is null AND ms_1315_pre_construction_package_rejected_actual is null; plus (2) rejected_without_subsequent_validation_count = distinct Active projects with ms_1315_pre_construction_package_rejected_actual not null AND (ms_1313_pre_construction_package_validated_actual is null OR ms_1313_pre_construction_package_validated_actual::timestamp <= ms_1315_pre_construction_package_rejected_actual::timestamp). The output is grouped by an optional group_by dimension list (default: rgn_region, m_area, m_market; optional additionally: pj_general_contractor).', kpi_python_function: 'def get_document_gate_compliance(execute_query, filters=None) -> list[dict]:\n    """KPI: Document Gate Compliance backlog for active projects.\n\n    Returns counts of active projects stuck at the pre-con doc gate, grouped by requested dimensions.\n\n    Supported group_by dimensions (via filters[\'group_by\']):\n      - rgn_region\n      - m_area\n      - m_market\n      - pj_general_contractor\n\n    If group_by is not provided, defaults to [\'rgn_region\', \'m_area\', \'m_market\'].\n    """\n\n    filters = filters or {}\n\n    # --- Dimensions (optional) ---\n    allowed_group_by = {\n        \'rgn_region\': \'"rgn_region"\',\n        \'m_area\': \'"m_area"\',\n        \'m_market\': \'"m_market"\',\n        \'pj_general_contractor\': \'"pj_general_contractor"\',\n    }\n\n    group_by = filters.get(\'group_by\')\n    if group_by is None:\n        group_by = [\'rgn_region\', \'m_area\', \'m_market\']\n    elif isinstance(group_by, str):\n        group_by = [group_by]\n\n    # validate group_by\n    for d in group_by:\n        if d not in allowed_group_by:\n            raise ValueError(\n                f"Unsupported group_by dimension: {d}. Allowed: {sorted(allowed_group_by.keys())}"\n            )\n\n    select_dim_sql = ", ".join([f"{allowed_group_by[d]} AS \\"{d}\\"" for d in group_by])\n    group_by_sql = ", ".join([allowed_group_by[d] for d in group_by])\n    order_by_sql = ", ".join([allowed_group_by[d] for d in group_by])\n\n    # --- WHERE clause ---\n    where_parts = [\'"pj_project_status" = \\\'Active\\\'\']\n\n    # Allowlist filters (explicit)\n    if filters.get(\'start_date\'):\n        sd = str(filters[\'start_date\']).replace("\'", "\'\'")\n        # Gate is triggered by package arrival OR rejection; include if either occurs in range\n        where_parts.append(\n            "(\\"ms_1310_pre_construction_package_received_actual\\"::timestamp >= \'" + sd + "\'::timestamp "\n            "OR \\"ms_1315_pre_construction_package_rejected_actual\\"::timestamp >= \'" + sd + "\'::timestamp)"\n        )\n\n    if filters.get(\'end_date\'):\n        ed = str(filters[\'end_date\']).replace("\'", "\'\'")\n        where_parts.append(\n            "(\\"ms_1310_pre_construction_package_received_actual\\"::timestamp <= \'" + ed + "\'::timestamp "\n            "OR \\"ms_1315_pre_construction_package_rejected_actual\\"::timestamp <= \'" + ed + "\'::timestamp)"\n        )\n\n    if filters.get(\'rgn_region\'):\n        rr = str(filters[\'rgn_region\']).replace("\'", "\'\'")\n        where_parts.append(f\'"rgn_region" = \\\'{rr}\\\'\')\n\n    if filters.get(\'m_area\'):\n        ma = str(filters[\'m_area\']).replace("\'", "\'\'")\n        where_parts.append(f\'"m_area" = \\\'{ma}\\\'\')\n\n    if filters.get(\'m_market\'):\n        mm = str(filters[\'m_market\']).replace("\'", "\'\'")\n        where_parts.append(f\'"m_market" = \\\'{mm}\\\'\')\n\n    if filters.get(\'pj_general_contractor\'):\n        gc = str(filters[\'pj_general_contractor\']).replace("\'", "\'\'")\n        where_parts.append(f\'"pj_general_contractor" = \\\'{gc}\\\'\')\n\n    if filters.get(\'pj_project_type\'):\n        pt = str(filters[\'pj_project_type\']).replace("\'", "\'\'")\n        where_parts.append(f\'"pj_project_type" = \\\'{pt}\\\'\')\n\n    if filters.get(\'por_category\'):\n        pc = str(filters[\'por_category\']).replace("\'", "\'\'")\n        where_parts.append(f\'"por_category" = \\\'{pc}\\\'\')\n\n    if filters.get(\'s_site_id\'):\n        sid = str(filters[\'s_site_id\']).replace("\'", "\'\'")\n        where_parts.append(f\'"s_site_id" = \\\'{sid}\\\'\')\n\n    if filters.get(\'pj_project_id\'):\n        pid = str(filters[\'pj_project_id\']).replace("\'", "\'\'")\n        where_parts.append(f\'"pj_project_id" = \\\'{pid}\\\'\')\n\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " WHERE " + " AND ".join(where_parts)\n\n    # --- KPI SQL ---\n    # arrived_not_validated_count:\n    #   received is not null AND validated is null AND rejected is null\n    # rejected_without_subsequent_validation_count:\n    #   rejected is not null AND (validated is null OR validated_ts <= rejected_ts)\n    sql = (\n        f"""SELECT {select_dim_sql}{\', \' if select_dim_sql else \'\'}COUNT(DISTINCT CASE   WHEN "ms_1310_pre_construction_package_received_actual" IS NOT NULL    AND "ms_1313_pre_construction_package_validated_actual" IS NULL    AND "ms_1315_pre_construction_package_rejected_actual" IS NULL   THEN "pj_project_id" END) AS "arrived_not_validated_count", COUNT(DISTINCT CASE   WHEN "ms_1315_pre_construction_package_rejected_actual" IS NOT NULL    AND ("ms_1313_pre_construction_package_validated_actual" IS NULL         OR "ms_1313_pre_construction_package_validated_actual"::timestamp <= "ms_1315_pre_construction_package_rejected_actual"::timestamp)   THEN "pj_project_id" END) AS "rejected_without_subsequent_validation_count", COUNT(DISTINCT CASE   WHEN ("ms_1310_pre_construction_package_received_actual" IS NOT NULL         AND "ms_1313_pre_construction_package_validated_actual" IS NULL         AND "ms_1315_pre_construction_package_rejected_actual" IS NULL)     OR ("ms_1315_pre_construction_package_rejected_actual" IS NOT NULL         AND ("ms_1313_pre_construction_package_validated_actual" IS NULL              OR "ms_1313_pre_construction_package_validated_actual"::timestamp <= "ms_1315_pre_construction_package_rejected_actual"::timestamp))   THEN "pj_project_id" END) AS "document_gate_backlog_total_count" FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined" {where_sql}{\' GROUP BY \' + group_by_sql if group_by_sql else \'\'}{\' ORDER BY \' + order_by_sql if order_by_sql else \'\'}"""\n    )\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'pj_project_status', 'rgn_region', 'm_area', 'm_market', 'pj_general_contractor', 'pj_project_type', 'por_category', 's_site_id', 'smp_name', 'smp_status', 'ntm_project_type', 'ms_1310_pre_construction_package_received_actual', 'ms_1313_pre_construction_package_validated_actual', 'ms_1315_pre_construction_package_rejected_actual'], session_id: '69a3d22f26e208edc083a06e', label: 'Document Gate Compliance', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market', 'scoping_package'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '2802fe3a-0451-46ff-849f-7c302aa99335', entity_type: 'kpi', kpi_name: 'Document Gate Compliance', name: '2802fe3a-0451-46ff-849f-7c302aa99335', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'pj_general_contractor'], kpi_description: 'Tracks how many active projects are stuck at the pre-construction document gate after the package has arrived but has not been validated, and how many active projects have had the package rejected without subsequent validation. This highlights process/compliance bottlenecks and audit risk, and is used to trigger Process & Compliance escalation when backlog grows. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: '2802fe3a-0451-46ff-849f-7c302aa99335'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Governance Risk Metrics selected by filters[\'metric_type\'] (one result set per call; schemas differ). All metrics support geo filters (rgn_region, m_area, m_market) plus optional program filter smp_name (and if smp_name=\'NTM\', restrict to smp_status=\'Active\' and exclude specific ntm_project_type values). All metrics query pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined. metric_type=\'action_closure\' returns closeout backlog by geo and construction_gc for Active projects where ms_1555_construction_complete_actual is not null and ms_1559_cop_approved_by_t_mobile_actual is null; includes project_count plus avg/max days since construction complete. metric_type=\'vendor_concentration\' returns vendor concentration by geo and pj_hard_cost_vendor_assignment_po: distinct project_count per (geo, vendor), total_projects_in_geo (sum across vendors within geo), and vendor_project_share = project_count / total_projects_in_geo. metric_type=\'binder_approval_rate\' returns binder_received_count (distinct projects with pj_a_5500_receive_close_out_binder_finish not null), binder_approved_count (distinct projects with pj_a_5525_approve_close_out_binder_finish not null), and binder_approval_rate_pct = 100 * binder_approved_count / binder_received_count, grouped by geo and construction_gc. metric_type=\'scop_pending_mb\' returns scop_pending_count as distinct projects where pj_a_5500_receive_close_out_binder_finish is not null and pj_a_5525_approve_close_out_binder_finish is null, grouped by geo and construction_gc.', kpi_output_schema: '[{"column": "view_name", "type": "string", "description": "Which companion view the row belongs to: \'closeout_backlog\' or \'vendor_concentration\'."}, {"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor (only populated for closeout_backlog rows)."}, {"column": "hard_cost_vendor", "type": "string", "description": "Hard-cost vendor used for concentration (COALESCE(construction_gc, construction_gc)); only populated for vendor_concentration rows."}, {"column": "project_count", "type": "integer", "description": "Distinct count of projects in the group."}, {"column": "avg_days_since_construction_complete", "type": "float", "description": "Average days since construction completion for backlog projects (NULL for vendor_concentration)."}, {"column": "max_days_since_construction_complete", "type": "float", "description": "Maximum days since construction completion for backlog projects (NULL for vendor_concentration)."}, {"column": "total_projects_in_geo", "type": "integer", "description": "Total distinct projects in the geo partition (only for vendor_concentration)."}, {"column": "vendor_project_share", "type": "float", "description": "Vendor concentration share within geo = project_count / total_projects_in_geo (only for vendor_concentration)."}]', kpi_business_logic: 'Initialize filters as an empty dict when None is provided (filters = filters or {}).\nRead filters[\'metric_type\'] (default \'action_closure\'); reject values other than \'action_closure\', \'vendor_concentration\', \'binder_approval_rate\', \'scop_pending_mb\'.\nBuild geo predicate list from allowlisted filters rgn_region, m_area, m_market.\nIf smp_name is provided, add predicate smp_name = value; if smp_name uppercased is \'NTM\', also require smp_status=\'Active\' and exclude ntm_project_type in (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\').\nIf metric_type=\'action_closure\': add required predicates pj_project_status=\'Active\', ms_1555_construction_complete_actual is not null, ms_1559_cop_approved_by_t_mobile_actual is null; optionally add construction_gc predicate; optionally add date predicates on ms_1555_construction_complete_actual using start_date (inclusive) and end_date (exclusive); group by geo + construction_gc; compute COUNT(DISTINCT pj_project_id), AVG and MAX days since construction complete.\nIf metric_type=\'binder_approval_rate\': group by geo + construction_gc; compute binder_received_count (distinct pj_project_id with pj_a_5500... not null), binder_approved_count (distinct pj_project_id with pj_a_5525... not null), binder_approval_rate_pct = 100*binder_approved_count/binder_received_count.\nIf metric_type=\'scop_pending_mb\': filter pj_a_5500... not null and pj_a_5525... is null; group by geo + construction_gc; compute scop_pending_count = COUNT(DISTINCT pj_project_id).\nIf metric_type=\'vendor_concentration\': filter non-null/non-blank pj_hard_cost_vendor_assignment_po; compute vendor_counts grouped by geo + trimmed vendor with COUNT(DISTINCT pj_project_id); compute geo_totals as SUM(vendor_counts.project_count) per geo; join and compute vendor_project_share = project_count/total_projects_in_geo.', kpi_filters: '[{"name": "metric_type", "type": "string", "description": ""}, {"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}, {"name": "construction_gc (action_closure only)", "type": "string", "description": ""}, {"name": "start_date (action_closure only)", "type": "string", "description": ""}, {"name": "end_date (action_closure only)", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_governance_risk_metrics", "node_type": "kpi", "node_id": "083e5b8b-61d1-4bed-83c2-5daa8446fb29", "node_label": "Governance Risk Metrics", "description": "Tracks governance and strategic risk through two companion views: (1) the backlog of active projects where construction is complete but customer closeout package approval has not occurred, indicating stalled action closure and acceptance risk; and (2) vendor concentration by hard-cost vendor assignment PO to highlight potential single-vendor dependency and exposure. Supports slicing by geography and general contractor to pinpoint where governance delays or vendor concentration risk is accumulating. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').", "parameters": [{"name": "metric_type", "type": "string", "description": "Filter by metric type", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "project_count", "type": "number", "nullable": false}, {"name": "avg_days_since_construction_complete", "type": "number", "nullable": false}, {"name": "max_days_since_construction_complete", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Governance Risk Metrics selected by filters[\'metric_type\'] (one result set per call; schemas differ). All metrics support geo filters (rgn_region, m_area, m_market) plus optional program filter smp_name (and if smp_name=\'NTM\', restrict to smp_status=\'Active\' and exclude specific ntm_project_type values). All metrics query pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined. metric_type=\'action_closure\' returns closeout backlog by geo and construction_gc for Active projects where ms_1555_construction_complete_actual is not null and ms_1559_cop_approved_by_t_mobile_actual is null; includes project_count plus avg/max days since construction complete. metric_type=\'vendor_concentration\' returns vendor concentration by geo and pj_hard_cost_vendor_assignment_po: distinct project_count per (geo, vendor), total_projects_in_geo (sum across vendors within geo), and vendor_project_share = project_count / total_projects_in_geo. metric_type=\'binder_approval_rate\' returns binder_received_count (distinct projects with pj_a_5500_receive_close_out_binder_finish not null), binder_approved_count (distinct projects with pj_a_5525_approve_close_out_binder_finish not null), and binder_approval_rate_pct = 100 * binder_approved_count / binder_received_count, grouped by geo and construction_gc. metric_type=\'scop_pending_mb\' returns scop_pending_count as distinct projects where pj_a_5500_receive_close_out_binder_finish is not null and pj_a_5525_approve_close_out_binder_finish is null, grouped by geo and construction_gc.', node_type: 'CORE', definition: 'Governance Risk Metrics selected by filters[\'metric_type\'] (one result set per call; schemas differ). All metrics support geo filters (rgn_region, m_area, m_market) plus optional program filter smp_name (and if smp_name=\'NTM\', restrict to smp_status=\'Active\' and exclude specific ntm_project_type values). All metrics query pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined. metric_type=\'action_closure\' returns closeout backlog by geo and construction_gc for Active projects where ms_1555_construction_complete_actual is not null and ms_1559_cop_approved_by_t_mobile_actual is null; includes project_count plus avg/max days since construction complete. metric_type=\'vendor_concentration\' returns vendor concentration by geo and pj_hard_cost_vendor_assignment_po: distinct project_count per (geo, vendor), total_projects_in_geo (sum across vendors within geo), and vendor_project_share = project_count / total_projects_in_geo. metric_type=\'binder_approval_rate\' returns binder_received_count (distinct projects with pj_a_5500_receive_close_out_binder_finish not null), binder_approved_count (distinct projects with pj_a_5525_approve_close_out_binder_finish not null), and binder_approval_rate_pct = 100 * binder_approved_count / binder_received_count, grouped by geo and construction_gc. metric_type=\'scop_pending_mb\' returns scop_pending_count as distinct projects where pj_a_5500_receive_close_out_binder_finish is not null and pj_a_5525_approve_close_out_binder_finish is null, grouped by geo and construction_gc.', kpi_python_function: 'def get_governance_risk_metrics(execute_query, filters=None) -> list[dict]:\n    """Returns one of four governance risk metric result sets depending on filters[\'metric_type\'].\n\n    metric_type =\n      - \'action_closure\': closeout backlog for active projects where construction complete date is set and COP approval is null.\n      - \'vendor_concentration\': per-geo distribution of hard-cost vendors based on pj_hard_cost_vendor_assignment_po.\n      - \'binder_approval_rate\': close-out binder approval rate per geo/GC.\n      - \'scop_pending_mb\': count of projects where binder received but approval is still pending per geo/GC.\n\n    Platform constraints: no CTEs; use subqueries instead.\n    """\n\n    filters = filters or {}\n    metric_type = filters.get(\'metric_type\', \'action_closure\')\n\n    allowed = (\'action_closure\', \'vendor_concentration\', \'binder_approval_rate\', \'scop_pending_mb\')\n    if metric_type not in allowed:\n        raise ValueError(f"filters[\'metric_type\'] must be one of {allowed}")\n\n    # -------------------------\n    # Allowlisted filters\n    # -------------------------\n    # Shared geo filters\n    geo_predicates = []\n    if filters.get(\'rgn_region\'):\n        val = str(filters[\'rgn_region\']).replace("\'", "\'\'")\n        geo_predicates.append(f\'"rgn_region" = \\\'{val}\\\'\')\n    if filters.get(\'m_area\'):\n        val = str(filters[\'m_area\']).replace("\'", "\'\'")\n        geo_predicates.append(f\'"m_area" = \\\'{val}\\\'\')\n    if filters.get(\'m_market\'):\n        val = str(filters[\'m_market\']).replace("\'", "\'\'")\n        geo_predicates.append(f\'"m_market" = \\\'{val}\\\'\')\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        val = str(filters["smp_name"]).replace("\'", "\'\'")\n        geo_predicates.append(f\'"smp_name" = \\\'{val}\\\'\')\n        if val.strip().upper() == \'NTM\':\n            geo_predicates.append(\'"smp_status" = \\\'Active\\\'\')\n            geo_predicates.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    # Date filters apply ONLY to action_closure and are anchored on construction complete actual.\n    date_predicates = []\n    if metric_type == \'action_closure\':\n        if filters.get(\'start_date\'):\n            val = str(filters[\'start_date\']).replace("\'", "\'\'")\n            date_predicates.append(f\'("ms_1555_construction_complete_actual"::timestamp) >= \\\'{val}\\\'::timestamp\')\n        if filters.get(\'end_date\'):\n            val = str(filters[\'end_date\']).replace("\'", "\'\'")\n            date_predicates.append(f\'("ms_1555_construction_complete_actual"::timestamp) < \\\'{val}\\\'::timestamp\')\n\n    # GC filter applies ONLY to action_closure and uses construction_gc.\n    gc_predicates = []\n    if metric_type == \'action_closure\' and filters.get(\'construction_gc\'):\n        val = str(filters[\'construction_gc\']).replace("\'", "\'\'")\n        gc_predicates.append(f\'"construction_gc" = \\\'{val}\\\'\')\n\n    # -------------------------\n    # Metric: action_closure (closeout backlog)\n    # -------------------------\n    if metric_type == \'action_closure\':\n        where_parts = [\n            \'"pj_project_status" = \\\'Active\\\'\',\n            \'"ms_1555_construction_complete_actual" IS NOT NULL\',\n            \'"ms_1559_cop_approved_by_t_mobile_actual" IS NULL\',\n        ]\n        where_parts += geo_predicates + gc_predicates + date_predicates\n        where_sql = \' AND \'.join(where_parts)\n\n        sql = f"""\n        SELECT\n            "rgn_region" AS "rgn_region",\n            "m_area" AS "m_area",\n            "m_market" AS "m_market",\n            "construction_gc" AS "construction_gc",\n            COUNT(DISTINCT "pj_project_id")::bigint AS "project_count",\n            AVG(EXTRACT(EPOCH FROM (NOW()::timestamp - ("ms_1555_construction_complete_actual"::timestamp))) / 86400.0)::double precision\n                AS "avg_days_since_construction_complete",\n            MAX(EXTRACT(EPOCH FROM (NOW()::timestamp - ("ms_1555_construction_complete_actual"::timestamp))) / 86400.0)::double precision\n                AS "max_days_since_construction_complete"\n        FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n        WHERE {where_sql}\n        GROUP BY\n            "rgn_region", "m_area", "m_market", "construction_gc"\n        ORDER BY\n            "rgn_region", "m_area", "m_market", "project_count" DESC;\n        """\n        return execute_query(sql)\n\n    # -------------------------\n    # Metric: binder_approval_rate\n    # -------------------------\n    if metric_type == \'binder_approval_rate\':\n        where_parts = []\n        where_parts += geo_predicates\n        where_sql = \' AND \'.join(where_parts) if where_parts else \'1=1\'\n\n        sql = f"""\n        SELECT\n            "rgn_region" AS "rgn_region",\n            "m_area" AS "m_area",\n            "m_market" AS "m_market",\n            "construction_gc" AS "construction_gc",\n            COUNT(DISTINCT CASE\n                WHEN "pj_a_5500_receive_close_out_binder_finish" IS NOT NULL THEN "pj_project_id"\n            END)::bigint AS "binder_received_count",\n            COUNT(DISTINCT CASE\n                WHEN "pj_a_5525_approve_close_out_binder_finish" IS NOT NULL THEN "pj_project_id"\n            END)::bigint AS "binder_approved_count",\n            (\n                100.0\n                * COUNT(DISTINCT CASE\n                    WHEN "pj_a_5525_approve_close_out_binder_finish" IS NOT NULL THEN "pj_project_id"\n                  END)::double precision\n                / NULLIF(\n                    COUNT(DISTINCT CASE\n                        WHEN "pj_a_5500_receive_close_out_binder_finish" IS NOT NULL THEN "pj_project_id"\n                    END)::double precision,\n                    0.0\n                  )\n            )::double precision AS "binder_approval_rate_pct"\n        FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n        WHERE {where_sql}\n        GROUP BY\n            "rgn_region", "m_area", "m_market", "construction_gc"\n        ORDER BY\n            "rgn_region", "m_area", "m_market", "binder_received_count" DESC;\n        """\n        return execute_query(sql)\n\n    # -------------------------\n    # Metric: scop_pending_mb\n    # -------------------------\n    if metric_type == \'scop_pending_mb\':\n        where_parts = [\n            \'"pj_a_5500_receive_close_out_binder_finish" IS NOT NULL\',\n            \'"pj_a_5525_approve_close_out_binder_finish" IS NULL\'\n        ]\n        where_parts += geo_predicates\n        where_sql = \' AND \'.join(where_parts)\n\n        sql = f"""\n        SELECT\n            "rgn_region" AS "rgn_region",\n            "m_area" AS "m_area",\n            "m_market" AS "m_market",\n            "construction_gc" AS "construction_gc",\n            COUNT(DISTINCT "pj_project_id")::bigint AS "scop_pending_count"\n        FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n        WHERE {where_sql}\n        GROUP BY\n            "rgn_region", "m_area", "m_market", "construction_gc"\n        ORDER BY\n            "rgn_region", "m_area", "m_market", "scop_pending_count" DESC;\n        """\n        return execute_query(sql)\n\n    # -------------------------\n    # Metric: vendor_concentration\n    # -------------------------\n    vendor_where_parts = [\n        \'"pj_hard_cost_vendor_assignment_po" IS NOT NULL\',\n        \'NULLIF(TRIM("pj_hard_cost_vendor_assignment_po"), \\\'\\\') IS NOT NULL\'\n    ]\n    vendor_where_parts += geo_predicates\n    vendor_where_sql = \' AND \'.join(vendor_where_parts)\n\n    sql = f"""\n    SELECT\n        v."rgn_region" AS "rgn_region",\n        v."m_area" AS "m_area",\n        v."m_market" AS "m_market",\n        v."hard_cost_vendor" AS "hard_cost_vendor",\n        v."project_count"::bigint AS "project_count",\n        g."total_projects_in_geo"::bigint AS "total_projects_in_geo",\n        (v."project_count"::double precision / NULLIF(g."total_projects_in_geo"::double precision, 0.0))::double precision\n            AS "vendor_project_share"\n    FROM (\n        SELECT\n            "rgn_region",\n            "m_area",\n            "m_market",\n            TRIM("pj_hard_cost_vendor_assignment_po") AS "hard_cost_vendor",\n            COUNT(DISTINCT "pj_project_id") AS "project_count"\n        FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n        WHERE {vendor_where_sql}\n        GROUP BY\n            "rgn_region", "m_area", "m_market", TRIM("pj_hard_cost_vendor_assignment_po")\n    ) v\n    JOIN (\n        SELECT\n            vc."rgn_region",\n            vc."m_area",\n            vc."m_market",\n            SUM(vc."project_count") AS "total_projects_in_geo"\n        FROM (\n            SELECT\n                "rgn_region",\n                "m_area",\n                "m_market",\n                TRIM("pj_hard_cost_vendor_assignment_po") AS "hard_cost_vendor",\n                COUNT(DISTINCT "pj_project_id") AS "project_count"\n            FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n            WHERE {vendor_where_sql}\n            GROUP BY\n                "rgn_region", "m_area", "m_market", TRIM("pj_hard_cost_vendor_assignment_po")\n        ) vc\n        GROUP BY\n            vc."rgn_region", vc."m_area", vc."m_market"\n    ) g\n      ON v."rgn_region" = g."rgn_region"\n     AND v."m_area" = g."m_area"\n     AND v."m_market" = g."m_market"\n    ORDER BY\n        v."rgn_region", v."m_area", v."m_market", v."project_count" DESC, v."hard_cost_vendor";\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'pj_project_status', 'ms_1555_construction_complete_actual', 'ms_1559_cop_approved_by_t_mobile_actual', 'rgn_region', 'm_area', 'm_market', 'smp_name', 'smp_status', 'ntm_project_type', 'construction_gc', 'pj_hard_cost_vendor_assignment_po', 'pj_a_5500_receive_close_out_binder_finish', 'pj_a_5525_approve_close_out_binder_finish'], session_id: '69a3d22f26e208edc083a06e', label: 'Governance Risk Metrics', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market', 'closeout_package'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '083e5b8b-61d1-4bed-83c2-5daa8446fb29', entity_type: 'kpi', kpi_name: 'Governance Risk Metrics', name: '083e5b8b-61d1-4bed-83c2-5daa8446fb29', kpi_dimensions: ['action_closure: rgn_region, m_area, m_market, construction_gc', 'vendor_concentration: rgn_region, m_area, m_market, hard_cost_vendor', 'binder_approval_rate: rgn_region, m_area, m_market, construction_gc', 'scop_pending_mb: rgn_region, m_area, m_market, construction_gc'], kpi_description: 'Tracks governance and strategic risk through two companion views: (1) the backlog of active projects where construction is complete but customer closeout package approval has not occurred, indicating stalled action closure and acceptance risk; and (2) vendor concentration by hard-cost vendor assignment PO to highlight potential single-vendor dependency and exposure. Supports slicing by geography and general contractor to pinpoint where governance delays or vendor concentration risk is accumulating. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: '083e5b8b-61d1-4bed-83c2-5daa8446fb29'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Customer Approval Gap (Active Projects) computed from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined. Outputs two counts: (1) distinct Active projects with Nokia pre-con package validated (ms_1313_pre_construction_package_validated_actual not null) but scoping package not yet customer-approved (ms_1333_scoping_package_approved_by_customer_actual null); and (2) distinct Active projects with Nokia pre-con package rejected (ms_1315_pre_construction_package_rejected_actual not null) and not yet re-validated (ms_1313_pre_construction_package_validated_actual null). Default returns a single aggregate row; optionally groups by a caller-provided subset of dimensions (rgn_region, m_area, m_market, pj_general_contractor, por_category, confirm_split_spo). Optional program filter smp_name is supported; when smp_name=NTM, restricts to smp_status=\'Active\' and excludes specific ntm_project_type values.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension from the project record."}, {"column": "m_area", "type": "string", "description": "Area dimension from the project record."}, {"column": "m_market", "type": "string", "description": "Market dimension from the project record."}, {"column": "construction_gc", "type": "string", "description": "General contractor name associated to the project."}, {"column": "por_category", "type": "string", "description": "Scope/POR category used for reporting."}, {"column": "confirm_split_spo", "type": "string", "description": "Split-SPO indicator used to distinguish split-scope cases."}, {"column": "validated_not_customer_approved_active_projects", "type": "integer", "description": "Count of active projects internally validated by Nokia but still lacking customer scoping approval."}, {"column": "internally_rejected_not_revalidated_active_projects", "type": "integer", "description": "Count of active projects internally rejected by Nokia and not yet re-validated (QC backlog)."}]', kpi_business_logic: 'Initialize filters = filters or {} before any filters.get access.\nFilter to pj_project_id is not null and pj_project_status = \'Active\'.\nApply optional equality filters: rgn_region, m_area, m_market, pj_general_contractor, por_category, confirm_split_spo.\nIf smp_name is provided: filter to smp_name = value. If smp_name is \'NTM\' (case-insensitive), additionally require smp_status=\'Active\' and exclude ntm_project_type in (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\').\nIf filters.group_by is empty/omitted: return one row with the two KPI counts (no GROUP BY).\nIf filters.group_by is provided: validate requested dimensions are in the allowlist; then SELECT/GROUP BY/ORDER BY only those dimensions.\nvalidated_not_customer_approved_active_projects = COUNT(DISTINCT pj_project_id) where ms_1313_pre_construction_package_validated_actual is not null AND ms_1333_scoping_package_approved_by_customer_actual is null.\ninternally_rejected_not_revalidated_active_projects = COUNT(DISTINCT pj_project_id) where ms_1315_pre_construction_package_rejected_actual is not null AND ms_1313_pre_construction_package_validated_actual is null.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Optional. Exact match."}, {"name": "m_area", "type": "string", "description": "Optional. Exact match."}, {"name": "m_market", "type": "string", "description": "Optional. Exact match."}, {"name": "pj_general_contractor", "type": "string", "description": "Optional. Exact match."}, {"name": "por_category", "type": "string", "description": "Optional. Exact match."}, {"name": "confirm_split_spo", "type": "string", "description": "Optional. Exact match."}, {"name": "smp_name", "type": "string", "description": "Optional. Exact match program filter. If set to \'NTM\' (case-insensitive), additionally requires smp_status=\'Active\' and excludes ntm_project_type in (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\')."}, {"name": "group_by", "type": "string", "description": "Optional. List[str] of dimensions to group by. Allowed: rgn_region, m_area, m_market, pj_general_contractor, por_category, confirm_split_spo. Default [] (no grouping)."}]', kpi_contract: '{"function_name": "get_customer_approval_gap", "node_type": "kpi", "node_id": "aea80d8b-9e94-40af-989b-ba08f76927f9", "node_label": "Customer Approval Gap", "description": "Tracks misalignment risk between Nokia internal validation and pending T-Mobile scoping approval by counting active projects that are internally validated but not yet customer-approved. Also reports a companion count of active projects that are internally rejected and not yet re-validated, to distinguish Nokia QC issues from customer-approval delays. Used to trigger and monitor Customer Impact escalation risk by region/market/GC and scope category. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "pj_general_contractor", "type": "string", "description": "Filter by pj general contractor", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "confirm_split_spo", "type": "string", "description": "Filter by confirm split spo", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}, {"name": "group_by", "type": "string", "description": "Filter by group by", "required": false, "sample_values": []}], "output_columns": [{"name": "validated_not_customer_approved_active_projects", "type": "number", "nullable": false}, {"name": "internally_rejected_not_revalidated_active_projects", "type": "number", "nullable": false}], "sample_output": [], "row_count": 1}', nl_description: 'Customer Approval Gap (Active Projects) computed from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined. Outputs two counts: (1) distinct Active projects with Nokia pre-con package validated (ms_1313_pre_construction_package_validated_actual not null) but scoping package not yet customer-approved (ms_1333_scoping_package_approved_by_customer_actual null); and (2) distinct Active projects with Nokia pre-con package rejected (ms_1315_pre_construction_package_rejected_actual not null) and not yet re-validated (ms_1313_pre_construction_package_validated_actual null). Default returns a single aggregate row; optionally groups by a caller-provided subset of dimensions (rgn_region, m_area, m_market, pj_general_contractor, por_category, confirm_split_spo). Optional program filter smp_name is supported; when smp_name=NTM, restricts to smp_status=\'Active\' and excludes specific ntm_project_type values.', node_type: 'CORE', definition: 'Customer Approval Gap (Active Projects) computed from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined. Outputs two counts: (1) distinct Active projects with Nokia pre-con package validated (ms_1313_pre_construction_package_validated_actual not null) but scoping package not yet customer-approved (ms_1333_scoping_package_approved_by_customer_actual null); and (2) distinct Active projects with Nokia pre-con package rejected (ms_1315_pre_construction_package_rejected_actual not null) and not yet re-validated (ms_1313_pre_construction_package_validated_actual null). Default returns a single aggregate row; optionally groups by a caller-provided subset of dimensions (rgn_region, m_area, m_market, pj_general_contractor, por_category, confirm_split_spo). Optional program filter smp_name is supported; when smp_name=NTM, restricts to smp_status=\'Active\' and excludes specific ntm_project_type values.', kpi_python_function: 'def get_customer_approval_gap(execute_query, filters=None) -> list[dict]:\n    """Customer Approval Gap KPI.\n\n    Default: returns a single aggregate row (no grouping).\n    Optional: pass filters[\'group_by\'] as a list of allowed dimension keys to group.\n    """\n\n    # Guard must be before any filters.get(...) usage\n    filters = filters or {}\n\n    # Allowed dimensions for grouping/filters (maps request key -> physical column)\n    dim_map = {\n        "rgn_region": \'"rgn_region"\',\n        "m_area": \'"m_area"\',\n        "m_market": \'"m_market"\',\n        "pj_general_contractor": \'"pj_general_contractor"\',\n        "por_category": \'"por_category"\',\n        "confirm_split_spo": \'"confirm_split_spo"\',\n    }\n\n    where_parts = [\n        \'"pj_project_id" IS NOT NULL\',\n        \'"pj_project_status" = \\\'Active\\\'\'\n    ]\n\n    # Explicit allowlist of filterable columns\n    if filters.get("rgn_region") is not None:\n        v = str(filters["rgn_region"]).replace("\'", "\'\'")\n        where_parts.append(f\'{dim_map["rgn_region"]} = \\\'{v}\\\'\')\n    if filters.get("m_area") is not None:\n        v = str(filters["m_area"]).replace("\'", "\'\'")\n        where_parts.append(f\'{dim_map["m_area"]} = \\\'{v}\\\'\')\n    if filters.get("m_market") is not None:\n        v = str(filters["m_market"]).replace("\'", "\'\'")\n        where_parts.append(f\'{dim_map["m_market"]} = \\\'{v}\\\'\')\n    if filters.get("pj_general_contractor") is not None:\n        v = str(filters["pj_general_contractor"]).replace("\'", "\'\'")\n        where_parts.append(f\'{dim_map["pj_general_contractor"]} = \\\'{v}\\\'\')\n    if filters.get("por_category") is not None:\n        v = str(filters["por_category"]).replace("\'", "\'\'")\n        where_parts.append(f\'{dim_map["por_category"]} = \\\'{v}\\\'\')\n    if filters.get("confirm_split_spo") is not None:\n        v = str(filters["confirm_split_spo"]).replace("\'", "\'\'")\n        where_parts.append(f\'{dim_map["confirm_split_spo"]} = \\\'{v}\\\'\')\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " AND ".join(where_parts)\n\n    # Optional grouping\n    group_by = filters.get("group_by")\n    if group_by is None:\n        group_by = []\n    if not isinstance(group_by, list):\n        raise ValueError("filters[\'group_by\'] must be a list of dimension keys")\n\n    invalid = [g for g in group_by if g not in dim_map]\n    if invalid:\n        raise ValueError(f"Invalid group_by dimensions: {invalid}. Allowed: {list(dim_map.keys())}")\n\n    if group_by:\n        select_prefix = ", ".join([f"{dim_map[g]} AS \\"{g}\\"" for g in group_by]) + ","\n        group_by_sql = "\\n        GROUP BY " + ", ".join([dim_map[g] for g in group_by])\n        order_by_sql = "\\n        ORDER BY " + ", ".join([dim_map[g] for g in group_by])\n    else:\n        select_prefix = ""\n        group_by_sql = ""\n        order_by_sql = ""\n\n    sql = f"""\n        SELECT\n            {select_prefix}\n            COUNT(DISTINCT CASE\n                WHEN "ms_1313_pre_construction_package_validated_actual" IS NOT NULL\n                 AND "ms_1333_scoping_package_approved_by_customer_actual" IS NULL\n                THEN "pj_project_id"\n            END) AS "validated_not_customer_approved_active_projects",\n\n            COUNT(DISTINCT CASE\n                WHEN "ms_1315_pre_construction_package_rejected_actual" IS NOT NULL\n                 AND "ms_1313_pre_construction_package_validated_actual" IS NULL\n                THEN "pj_project_id"\n            END) AS "internally_rejected_not_revalidated_active_projects"\n\n        FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n        WHERE {where_sql}\n        {group_by_sql}\n        {order_by_sql}\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'pj_project_status', 'rgn_region', 'm_area', 'm_market', 'pj_general_contractor', 'por_category', 'confirm_split_spo', 'smp_name', 'smp_status', 'ntm_project_type', 'ms_1313_pre_construction_package_validated_actual', 'ms_1333_scoping_package_approved_by_customer_actual', 'ms_1315_pre_construction_package_rejected_actual'], session_id: '69a3d22f26e208edc083a06e', label: 'Customer Approval Gap', kpi_related_core_node_ids: ['project', 'approval', 'site', 'general_contractor', 'market', 'scoping_package'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'aea80d8b-9e94-40af-989b-ba08f76927f9', entity_type: 'kpi', kpi_name: 'Customer Approval Gap', name: 'aea80d8b-9e94-40af-989b-ba08f76927f9', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'pj_general_contractor', 'por_category', 'confirm_split_spo'], kpi_description: 'Tracks misalignment risk between Nokia internal validation and pending T-Mobile scoping approval by counting active projects that are internally validated but not yet customer-approved. Also reports a companion count of active projects that are internally rejected and not yet re-validated, to distinguish Nokia QC issues from customer-approval delays. Used to trigger and monitor Customer Impact escalation risk by region/market/GC and scope category. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: 'aea80d8b-9e94-40af-989b-ba08f76927f9'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Material Availability Rate (%) = 100.0 * COUNT(DISTINCT pj_project_id with planned construction start scheduled AND all BAT orders received) / NULLIF(COUNT(DISTINCT pj_project_id with planned construction start scheduled), 0), grouped by region/area/market/GC/POR category, optionally restricted to an upcoming construction-start date window; optionally filtered by program (smp_name) with an NTM-only conditional filter.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor dimension (free-text)."}, {"column": "por_category", "type": "string", "description": "POR category dimension."}, {"column": "total_upcoming_sites", "type": "integer", "description": "Count of distinct projects with planned construction start scheduled (and within the optional upcoming window, if provided)."}, {"column": "material_ready_sites", "type": "integer", "description": "Count of distinct projects with planned construction start scheduled (and within optional upcoming window) and all BAT orders received."}, {"column": "material_availability_rate_pct", "type": "float", "description": "100.0 * material_ready_sites / total_upcoming_sites (NULL when total_upcoming_sites = 0)."}]', kpi_business_logic: 'Initialize filters to an empty dict if None.\nFilter to rows where planned construction start (pj_p_4225_construction_start_finish) is not null.\nApply optional exact-match dimension/entity filters: rgn_region, m_area, m_market, construction_gc, por_category, pj_project_id, s_site_id.\nIf upcoming_window_days is provided, restrict to planned construction start date between CURRENT_DATE and CURRENT_DATE + upcoming_window_days.\nIf smp_name is provided, filter to that smp_name; if smp_name equals \'NTM\' (case-insensitive), further restrict to smp_status = \'Active\' and exclude specified ntm_project_type values.\nGroup by rgn_region, m_area, m_market, construction_gc, por_category.\nCompute total_upcoming_sites as COUNT(DISTINCT pj_project_id).\nCompute material_ready_sites as COUNT(DISTINCT pj_project_id) where pj_a_3900_all_bat_orders_received_finish is not null.\nCompute material_availability_rate_pct = 100.0 * material_ready_sites / NULLIF(total_upcoming_sites, 0).', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "por_category", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "upcoming_window_days", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_material_availability_rate", "node_type": "kpi", "node_id": "89292bce-c820-4fca-afb4-c3d4e1937916", "node_label": "Material Availability Rate", "description": "Measures the percentage of upcoming construction sites (projects with a planned construction start scheduled) that have full material delivery confirmed (all BAT orders received). Used to identify material readiness gaps before construction starts; critical for capacity planning because sites without materials cannot begin construction even when crews are available. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}, {"name": "upcoming_window_days", "type": "string", "description": "Filter by upcoming window days", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "por_category", "type": "string", "nullable": false}, {"name": "total_upcoming_sites", "type": "number", "nullable": false}, {"name": "material_ready_sites", "type": "number", "nullable": false}, {"name": "material_availability_rate_pct", "type": "string", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Material Availability Rate (%) = 100.0 * COUNT(DISTINCT pj_project_id with planned construction start scheduled AND all BAT orders received) / NULLIF(COUNT(DISTINCT pj_project_id with planned construction start scheduled), 0), grouped by region/area/market/GC/POR category, optionally restricted to an upcoming construction-start date window; optionally filtered by program (smp_name) with an NTM-only conditional filter.', node_type: 'CORE', definition: 'Material Availability Rate (%) = 100.0 * COUNT(DISTINCT pj_project_id with planned construction start scheduled AND all BAT orders received) / NULLIF(COUNT(DISTINCT pj_project_id with planned construction start scheduled), 0), grouped by region/area/market/GC/POR category, optionally restricted to an upcoming construction-start date window; optionally filtered by program (smp_name) with an NTM-only conditional filter.', kpi_python_function: 'def get_material_availability_rate(execute_query, filters=None) -> list[dict]:\n    filters = filters or {}\n\n    where_parts = [\n        "1=1",\n        "\\"pj_p_4225_construction_start_finish\\" IS NOT NULL"\n    ]\n\n    # Exact-match filters (allowlist)\n    if filters.get("rgn_region"):\n        val = str(filters["rgn_region"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"rgn_region\\" = \'{val}\'")\n\n    if filters.get("m_area"):\n        val = str(filters["m_area"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"m_area\\" = \'{val}\'")\n\n    if filters.get("m_market"):\n        val = str(filters["m_market"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"m_market\\" = \'{val}\'")\n\n    if filters.get("construction_gc"):\n        val = str(filters["construction_gc"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"construction_gc\\" = \'{val}\'")\n\n    if filters.get("por_category"):\n        val = str(filters["por_category"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"por_category\\" = \'{val}\'")\n\n    if filters.get("pj_project_id"):\n        val = str(filters["pj_project_id"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"pj_project_id\\" = \'{val}\'")\n\n    if filters.get("s_site_id"):\n        val = str(filters["s_site_id"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"s_site_id\\" = \'{val}\'")\n\n    # Optional upcoming window scoping\n    # Restrict denominator to planned construction start between CURRENT_DATE and CURRENT_DATE + upcoming_window_days\n    if filters.get("upcoming_window_days") is not None:\n        try:\n            days = int(filters["upcoming_window_days"])\n        except Exception:\n            raise ValueError("upcoming_window_days must be an integer or null")\n        where_parts.append(\n            f"(\\"pj_p_4225_construction_start_finish\\"::date BETWEEN CURRENT_DATE AND (CURRENT_DATE + {days}))"\n        )\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_clause = " AND ".join(where_parts)\n\n    sql = (\n        f\'\'\'SELECT   "rgn_region" AS "rgn_region",   "m_area" AS "m_area",   "m_market" AS "m_market",   "construction_gc" AS "construction_gc",   "por_category" AS "por_category",   COUNT(DISTINCT "pj_project_id") AS "total_upcoming_sites",   COUNT(DISTINCT CASE WHEN "pj_a_3900_all_bat_orders_received_finish" IS NOT NULL THEN "pj_project_id" END) AS "material_ready_sites",   (100.0 * COUNT(DISTINCT CASE WHEN "pj_a_3900_all_bat_orders_received_finish" IS NOT NULL THEN "pj_project_id" END)      / NULLIF(COUNT(DISTINCT "pj_project_id"), 0)) AS "material_availability_rate_pct" FROM pwc_macro_staging_schema."stg_ndpd_mbt_tmobile_macro_combined" WHERE {where_clause} GROUP BY "rgn_region", "m_area", "m_market", "construction_gc", "por_category" ORDER BY "rgn_region", "m_area", "m_market", "construction_gc", "por_category"\'\'\'\n    )\n\n    return execute_query(sql)\n', kpi_source_columns: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 'pj_project_id', 's_site_id', 'pj_p_4225_construction_start_finish', 'pj_a_3900_all_bat_orders_received_finish', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Material Availability Rate', kpi_related_core_node_ids: ['project', 'site', 'material_equipment', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '89292bce-c820-4fca-afb4-c3d4e1937916', entity_type: 'kpi', kpi_name: 'Material Availability Rate', name: '89292bce-c820-4fca-afb4-c3d4e1937916', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category'], kpi_description: 'Measures the percentage of upcoming construction sites (projects with a planned construction start scheduled) that have full material delivery confirmed (all BAT orders received). Used to identify material readiness gaps before construction starts; critical for capacity planning because sites without materials cannot begin construction even when crews are available. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: '89292bce-c820-4fca-afb4-c3d4e1937916'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Counts distinct active WIP projects (construction started, not construction complete, and RAN entitlement complete) grouped by region/area/market/GC/POR category, and computes counts with start delay code, complete delay code, any delay code, and delay-coded percent. Supports optional dimensional filters plus smp_name program filtering with special NTM constraints (Active status and excluding certain NTM project types).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region."}, {"column": "m_area", "type": "string", "description": "Area."}, {"column": "m_market", "type": "string", "description": "Market."}, {"column": "construction_gc", "type": "string", "description": "Construction general contractor."}, {"column": "por_category", "type": "string", "description": "POR category."}, {"column": "tower_wip_total", "type": "integer", "description": "Distinct count of active WIP construction projects (started, not complete)."}, {"column": "tower_wip_with_start_delay", "type": "integer", "description": "Distinct count of active WIP projects with a construction start delay code."}, {"column": "tower_wip_with_complete_delay", "type": "integer", "description": "Distinct count of active WIP projects with a construction complete delay code."}, {"column": "tower_wip_with_any_delay_code", "type": "integer", "description": "Distinct count of active WIP projects with either a start or complete delay code."}, {"column": "delay_coded_pct", "type": "float", "description": "Percent of active WIP projects that have any delay code (0-100)."}]', kpi_business_logic: 'Initialize filters to an empty dict when None (filters = filters or {}).\nFilter to WIP projects: construction_start_finish IS NOT NULL, construction_complete_finish IS NULL, and ran_entitlement_complete_finish IS NOT NULL.\nApply optional equality filters for: rgn_region, m_area, m_market, construction_gc, por_category, pj_project_id, s_site_id.\nIf smp_name is provided, filter to that smp_name; if smp_name == \'NTM\' (case-insensitive), additionally require smp_status = \'Active\' and ntm_project_type NOT IN (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\').\nGroup by rgn_region, m_area, m_market, construction_gc, por_category.\nCompute distinct project counts: total WIP, with start delay code, with complete delay code, with any delay code, and delay-coded percent (any-delay / total * 100).', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "por_category", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Optional filter on the construction-start delay code column. When provided, the query adds: pj_construction_start_delay_code IS NOT NULL AND pj_construction_start_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}, {"name": "pj_construction_complete_delay_code", "type": "string", "description": "Optional filter on the construction-complete delay code column. When provided, the query adds: pj_construction_complete_delay_code IS NOT NULL AND pj_construction_complete_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}]', kpi_contract: '{"function_name": "get_cx_wip_delay_code", "node_type": "kpi", "node_id": "ebcbc8c7-2e16-4f75-81e6-f6a16de5aa79", "node_label": "CX WIP Delay Code", "description": "Counts active construction WIP (construction started but not complete) projects that have documented delay codes (start and/or complete). Breaks out WIP with start delay code, WIP with complete delay code, and WIP with any delay code, plus the percent of WIP that is delay-coded. Used to identify systemic construction delay patterns and prioritize escalation by GC, market, region, and POR category. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Filter to projects with a specific construction-start delay code, or any real start delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}, {"name": "pj_construction_complete_delay_code", "type": "string", "description": "Filter to projects with a specific construction-complete delay code, or any real complete delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "por_category", "type": "string", "nullable": false}, {"name": "tower_wip_total", "type": "number", "nullable": false}, {"name": "tower_wip_with_start_delay", "type": "number", "nullable": false}, {"name": "tower_wip_with_complete_delay", "type": "number", "nullable": false}, {"name": "tower_wip_with_any_delay_code", "type": "number", "nullable": false}, {"name": "delay_coded_pct", "type": "string", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Counts distinct active WIP projects (construction started, not construction complete, and RAN entitlement complete) grouped by region/area/market/GC/POR category, and computes counts with start delay code, complete delay code, any delay code, and delay-coded percent. Supports optional dimensional filters plus smp_name program filtering with special NTM constraints (Active status and excluding certain NTM project types).', node_type: 'CORE', definition: 'Counts distinct active WIP projects (construction started, not construction complete, and RAN entitlement complete) grouped by region/area/market/GC/POR category, and computes counts with start delay code, complete delay code, any delay code, and delay-coded percent. Supports optional dimensional filters plus smp_name program filtering with special NTM constraints (Active status and excluding certain NTM project types).', kpi_python_function: 'def get_cx_wip_delay_code(execute_query, filters=None) -> list[dict]:\n    # KPI: CX WIP Delay Code (PostgreSQL)\n    filters = filters or {}\n\n    where_parts = [\n        "1=1",\n        "\\"pj_a_4225_construction_start_finish\\" IS NOT NULL",\n        "\\"pj_a_5175_construction_complete_finish\\" IS NULL",\n        "\\"pj_a_3710_ran_entitlement_complete_finish\\" IS NOT NULL"\n    ]\n\n    # Allowlist filters (exact-match equality)\n    if filters.get("rgn_region"):\n        val = str(filters["rgn_region"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"rgn_region\\" = \'{val}\'")\n\n    if filters.get("m_area"):\n        val = str(filters["m_area"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"m_area\\" = \'{val}\'")\n\n    if filters.get("m_market"):\n        val = str(filters["m_market"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"m_market\\" = \'{val}\'")\n\n    if filters.get("construction_gc"):\n        val = str(filters["construction_gc"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"construction_gc\\" = \'{val}\'")\n\n    if filters.get("por_category"):\n        val = str(filters["por_category"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"por_category\\" = \'{val}\'")\n\n    if filters.get("pj_project_id"):\n        val = str(filters["pj_project_id"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"pj_project_id\\" = \'{val}\'")\n\n    if filters.get("s_site_id"):\n        val = str(filters["s_site_id"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"s_site_id\\" = \'{val}\'")\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n\n    # Optional construction delay-code filters (engage when caller wants to narrow to delayed projects)\n\n    for _delay_col in ("pj_construction_start_delay_code", "pj_construction_complete_delay_code"):\n\n        _v = filters.get(_delay_col)\n\n        if _v is None or str(_v).strip() == "":\n\n            continue\n\n        _s = str(_v).strip()\n\n        where_parts.append(f\'"{_delay_col}" IS NOT NULL\')\n\n        where_parts.append(f\'"{_delay_col}" <> \\\'No Delay\\\'\')\n\n        if _s.lower() not in ("any", "true", "yes", "1", "*"):\n\n            _ss = _s.replace("\'", "\'\'")\n\n            where_parts.append(f\'"{_delay_col}" = \\\'{_ss}\\\'\')\n\n    where_clause = " AND ".join(where_parts)\n\n    sql = (\n        f\'\'\'SELECT   "rgn_region",   "m_area",   "m_market",   "construction_gc",   "por_category",   COUNT(DISTINCT "pj_project_id") AS "tower_wip_total",   COUNT(DISTINCT CASE WHEN "pj_construction_start_delay_code" IS NOT NULL THEN "pj_project_id" END) AS "tower_wip_with_start_delay",   COUNT(DISTINCT CASE WHEN "pj_construction_complete_delay_code" IS NOT NULL THEN "pj_project_id" END) AS "tower_wip_with_complete_delay",   COUNT(DISTINCT CASE WHEN ("pj_construction_start_delay_code" IS NOT NULL OR "pj_construction_complete_delay_code" IS NOT NULL) THEN "pj_project_id" END) AS "tower_wip_with_any_delay_code",   100.0 *     (COUNT(DISTINCT CASE WHEN ("pj_construction_start_delay_code" IS NOT NULL OR "pj_construction_complete_delay_code" IS NOT NULL) THEN "pj_project_id" END))     / NULLIF(COUNT(DISTINCT "pj_project_id"), 0) AS "delay_coded_pct" FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined" WHERE {where_clause} GROUP BY "rgn_region", "m_area", "m_market", "construction_gc", "por_category" ORDER BY "rgn_region", "m_area", "m_market", "construction_gc", "por_category"\'\'\'\n    )\n\n    return execute_query(sql)\n', kpi_source_columns: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 'pj_project_id', 's_site_id', 'smp_name', 'smp_status', 'ntm_project_type', 'pj_a_4225_construction_start_finish', 'pj_a_5175_construction_complete_finish', 'pj_a_3710_ran_entitlement_complete_finish', 'pj_construction_start_delay_code', 'pj_construction_complete_delay_code'], session_id: '69a3d22f26e208edc083a06e', label: 'CX WIP Delay Code', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'ebcbc8c7-2e16-4f75-81e6-f6a16de5aa79', entity_type: 'kpi', kpi_name: 'CX WIP Delay Code', name: 'ebcbc8c7-2e16-4f75-81e6-f6a16de5aa79', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category'], kpi_description: 'Counts active construction WIP (construction started but not complete) projects that have documented delay codes (start and/or complete). Breaks out WIP with start delay code, WIP with complete delay code, and WIP with any delay code, plus the percent of WIP that is delay-coded. Used to identify systemic construction delay patterns and prioritize escalation by GC, market, region, and POR category. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\'). Optionally filterable by construction delay code: pass pj_construction_start_delay_code or pj_construction_complete_delay_code (any non-empty value engages IS NOT NULL AND <> \'No Delay\'; a specific code value also narrows to that code).', status: 'mentioned', node_id: 'ebcbc8c7-2e16-4f75-81e6-f6a16de5aa79'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Pending Building Permit KPI = grouped counts of distinct active projects with building permit applied but not approved, plus pending aging (avg/max days since application) and average apply-to-approve cycle time for approved permits (non-negative durations), filtered by optional exact-match attributes including program (smp_name) with NTM-specific constraints.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor dimension (free-text)."}, {"column": "por_category", "type": "string", "description": "POR category dimension."}, {"column": "pending_permit_count", "type": "integer", "description": "Count of distinct active projects with building permit applied but not yet approved."}, {"column": "avg_days_pending", "type": "float", "description": "Average days since building permit application for pending permits."}, {"column": "max_days_pending", "type": "float", "description": "Maximum days since building permit application for pending permits."}, {"column": "permit_approved_count", "type": "integer", "description": "Count of distinct projects with building permit applied and approved."}, {"column": "avg_approval_cycle_days", "type": "float", "description": "Average application-to-approval cycle time in days for approved permits, excluding negative durations."}]', kpi_business_logic: 'Set `filters = filters or {}` (first executable line).\nApply optional exact-match filters: rgn_region, m_area, m_market, construction_gc, por_category, pj_project_id, s_site_id, smp_name.\nIf smp_name is provided and equals \'NTM\' (case-insensitive), also require smp_status=\'Active\' and exclude ntm_project_type in (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\').\nGroup results by rgn_region, m_area, m_market, construction_gc, por_category.\nCompute pending_permit_count, avg_days_pending, max_days_pending for projects applied but not approved and not Dead.\nCompute permit_approved_count and avg_approval_cycle_days for projects with both applied and approved timestamps, excluding negative cycle durations.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "por_category", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_pending_building_permit", "node_type": "kpi", "node_id": "5839ab81-baa8-4a76-b9c0-d1b1ab946bc2", "node_label": "Pending Building Permit", "description": "Counts active projects/sites where the building permit has been applied for but is not yet approved (a hard prerequisite for civil start), to surface permit/regulatory bottlenecks and forecast civil start delays. Also computes aging for pending permits (avg/max days since application) and the average application-to-approval cycle time for projects where the permit was approved, excluding negative durations. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "por_category", "type": "string", "nullable": false}, {"name": "pending_permit_count", "type": "number", "nullable": false}, {"name": "avg_days_pending", "type": "null", "nullable": true}, {"name": "max_days_pending", "type": "null", "nullable": true}, {"name": "permit_approved_count", "type": "number", "nullable": false}, {"name": "avg_approval_cycle_days", "type": "null", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Pending Building Permit KPI = grouped counts of distinct active projects with building permit applied but not approved, plus pending aging (avg/max days since application) and average apply-to-approve cycle time for approved permits (non-negative durations), filtered by optional exact-match attributes including program (smp_name) with NTM-specific constraints.', node_type: 'CORE', definition: 'Pending Building Permit KPI = grouped counts of distinct active projects with building permit applied but not approved, plus pending aging (avg/max days since application) and average apply-to-approve cycle time for approved permits (non-negative durations), filtered by optional exact-match attributes including program (smp_name) with NTM-specific constraints.', kpi_python_function: 'def get_pending_building_permit(execute_query, filters=None) -> list[dict]:\n    filters = filters or {}\n    where_parts = ["1=1"]\n\n    # Allowlist filters (exact match)\n    if filters.get("rgn_region"):\n        v = str(filters["rgn_region"]).replace("\'", "\'\'")\n        where_parts.append(f\'"rgn_region" = \\\'{v}\\\'\')\n    if filters.get("m_area"):\n        v = str(filters["m_area"]).replace("\'", "\'\'")\n        where_parts.append(f\'"m_area" = \\\'{v}\\\'\')\n    if filters.get("m_market"):\n        v = str(filters["m_market"]).replace("\'", "\'\'")\n        where_parts.append(f\'"m_market" = \\\'{v}\\\'\')\n    if filters.get("construction_gc"):\n        v = str(filters["construction_gc"]).replace("\'", "\'\'")\n        where_parts.append(f\'"construction_gc" = \\\'{v}\\\'\')\n    if filters.get("por_category"):\n        v = str(filters["por_category"]).replace("\'", "\'\'")\n        where_parts.append(f\'"por_category" = \\\'{v}\\\'\')\n    if filters.get("pj_project_id"):\n        v = str(filters["pj_project_id"]).replace("\'", "\'\'")\n        where_parts.append(f\'"pj_project_id" = \\\'{v}\\\'\')\n    if filters.get("s_site_id"):\n        v = str(filters["s_site_id"]).replace("\'", "\'\'")\n        where_parts.append(f\'"s_site_id" = \\\'{v}\\\'\')\n\n    # Program filter with NTM conditional\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = (\n        f\'\'\'SELECT   "rgn_region",   "m_area",   "m_market",   "construction_gc",   "por_category",   COUNT(DISTINCT CASE     WHEN "pj_a_3650_ran_building_permit_applied_finish" IS NOT NULL      AND "pj_a_3675_ran_building_permit_approved_finish" IS NULL      AND "pj_project_status" != \'Dead\'     THEN "pj_project_id" END   ) AS "pending_permit_count",   AVG(CASE     WHEN "pj_a_3650_ran_building_permit_applied_finish" IS NOT NULL      AND "pj_a_3675_ran_building_permit_approved_finish" IS NULL      AND "pj_project_status" != \'Dead\'     THEN (EXTRACT(EPOCH FROM (NOW() - "pj_a_3650_ran_building_permit_applied_finish"::timestamp)) / 86400.0)   END) AS "avg_days_pending",   MAX(CASE     WHEN "pj_a_3650_ran_building_permit_applied_finish" IS NOT NULL      AND "pj_a_3675_ran_building_permit_approved_finish" IS NULL      AND "pj_project_status" != \'Dead\'     THEN (EXTRACT(EPOCH FROM (NOW() - "pj_a_3650_ran_building_permit_applied_finish"::timestamp)) / 86400.0)   END) AS "max_days_pending",   COUNT(DISTINCT CASE     WHEN "pj_a_3650_ran_building_permit_applied_finish" IS NOT NULL      AND "pj_a_3675_ran_building_permit_approved_finish" IS NOT NULL     THEN "pj_project_id" END   ) AS "permit_approved_count",   AVG(CASE     WHEN "pj_a_3650_ran_building_permit_applied_finish" IS NOT NULL      AND "pj_a_3675_ran_building_permit_approved_finish" IS NOT NULL      AND ("pj_a_3675_ran_building_permit_approved_finish"::date - "pj_a_3650_ran_building_permit_applied_finish"::date) >= 0     THEN ("pj_a_3675_ran_building_permit_approved_finish"::date - "pj_a_3650_ran_building_permit_applied_finish"::date)   END) AS "avg_approval_cycle_days" FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined" WHERE {where_sql} GROUP BY   "rgn_region", "m_area", "m_market", "construction_gc", "por_category" ORDER BY   "rgn_region", "m_area", "m_market", "construction_gc", "por_category"\'\'\'\n    )\n\n    return execute_query(sql, db="public")\n', kpi_source_columns: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 'pj_project_id', 'pj_project_status', 'pj_a_3650_ran_building_permit_applied_finish', 'pj_a_3675_ran_building_permit_approved_finish', 's_site_id', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'Pending Building Permit', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '5839ab81-baa8-4a76-b9c0-d1b1ab946bc2', entity_type: 'kpi', kpi_name: 'Pending Building Permit', name: '5839ab81-baa8-4a76-b9c0-d1b1ab946bc2', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category'], kpi_description: 'Counts active projects/sites where the building permit has been applied for but is not yet approved (a hard prerequisite for civil start), to surface permit/regulatory bottlenecks and forecast civil start delays. Also computes aging for pending permits (avg/max days since application) and the average application-to-approval cycle time for projects where the permit was approved, excluding negative durations. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: '5839ab81-baa8-4a76-b9c0-d1b1ab946bc2'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_nas_e911_readiness_riot_validation', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Computes two related E911 metrics: (1) E911 Readiness Rate from stg_nas_e911_readiness_riot_validation using latest validation per site with PASS/PASS criteria (passed/attempted), excluding NULL validation dates; and (2) E911 Requested Rate (%) from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined as 100 * (# distinct pj_project_id with pj_a_5200_e911_routing_received_finish not null) / (# distinct pj_project_id with pj_a_3710_ran_entitlement_complete_finish not null). Optional filter smp_name applies only to the macro portion (macro_combined).', kpi_output_schema: '[{"column": "kpi", "type": "string", "description": "KPI name."}, {"column": "attempted_site_count", "type": "integer", "description": "Number of distinct sites where E911 validation was attempted."}, {"column": "passed_site_count", "type": "integer", "description": "Number of distinct attempted sites that passed all required E911 validation layers (per implemented proxy logic)."}, {"column": "e911_readiness_rate", "type": "float", "description": "passed_site_count / attempted_site_count."}]', kpi_business_logic: '1) RIOT readiness: filter stg_nas_e911_readiness_riot_validation to rows where nas_e911_validation_date is not null and optional filters (nas_site_id, nas_engineer, start_date/end_date). 2) For each nas_site_id, find MAX(nas_e911_validation_date) as latest_validation_date (subquery). 3) Join back to the table on (nas_site_id, latest_validation_date). 4) site_passed = 1 if any row on that latest date has nas_validate_e911_readiness=\'PASS\' AND nas_consolidation_check_all_layers=\'PASS\', else 0. 5) attempted_site_count = number of sites returned; passed_site_count = sum(site_passed); e911_readiness_rate = passed/attempted. 6) Optional: enrich with site dimensions via get_site and optionally aggregate by market or region. 7) Macro companion: query pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined (alias mc) with optional smp_name filter (and if smp_name=\'NTM\', also enforce smp_status=\'Active\' and exclude certain ntm_project_type values). Compute entitled_site_count as distinct pj_project_id with pj_a_3710_ran_entitlement_complete_finish not null, and e911_requested_count as distinct pj_project_id with pj_a_5200_e911_routing_received_finish not null; compute e911_requested_rate_pct = 100*requested/entitled (null if entitled=0). 8) Return both metrics in the output (macro metrics are global and repeated for grouped/site-level outputs).', kpi_filters: '[{"name": "start_date", "type": "string", "description": ""}, {"name": "end_date", "type": "string", "description": ""}, {"name": "nas_site_id", "type": "string", "description": ""}, {"name": "nas_engineer", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "rgn_region", "type": "string", "description": ""}, {"name": "group_by", "type": "string", "description": ""}, {"name": "include_site_level", "type": "string", "description": ""}, {"name": "include_site_details", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_e911_readiness_rate", "node_type": "kpi", "node_id": "4d46b430-b2af-43e7-8a47-0391a2b77c53", "node_label": "E911 Readiness Rate", "description": "Measures the share of sites where E911 validation has been attempted that successfully pass all required E911 validation layers, indicating the site is legally and technically ready to route emergency calls correctly prior to on-air. This KPI is used to quantify integration go-live blocking risk, identify markets/regions/vendors with disproportionate E911 failures, and monitor readiness trends over time. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').", "parameters": [{"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}, {"name": "nas_site_id", "type": "string", "description": "Filter by nas site id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}, {"name": "site_code", "type": "string", "description": "Filter by site code", "required": false, "sample_values": []}, {"name": "nas_engineer", "type": "string", "description": "Filter by nas engineer", "required": false, "sample_values": []}, {"name": "include_site_details", "type": "string", "description": "Filter by include site details", "required": false, "sample_values": []}, {"name": "group_by", "type": "string", "description": "Filter by group by", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}, {"name": "include_site_level", "type": "string", "description": "Filter by include site level", "required": false, "sample_values": []}], "output_columns": [{"name": "kpi", "type": "string", "nullable": false}, {"name": "attempted_site_count", "type": "number", "nullable": false}, {"name": "passed_site_count", "type": "number", "nullable": false}, {"name": "e911_readiness_rate", "type": "number", "nullable": false}, {"name": "entitled_site_count", "type": "number", "nullable": false}, {"name": "e911_requested_count", "type": "number", "nullable": false}, {"name": "e911_requested_rate_pct", "type": "number", "nullable": false}], "sample_output": [], "row_count": 1}', nl_description: 'Computes two related E911 metrics: (1) E911 Readiness Rate from stg_nas_e911_readiness_riot_validation using latest validation per site with PASS/PASS criteria (passed/attempted), excluding NULL validation dates; and (2) E911 Requested Rate (%) from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined as 100 * (# distinct pj_project_id with pj_a_5200_e911_routing_received_finish not null) / (# distinct pj_project_id with pj_a_3710_ran_entitlement_complete_finish not null). Optional filter smp_name applies only to the macro portion (macro_combined).', node_type: 'CORE', definition: 'Computes two related E911 metrics: (1) E911 Readiness Rate from stg_nas_e911_readiness_riot_validation using latest validation per site with PASS/PASS criteria (passed/attempted), excluding NULL validation dates; and (2) E911 Requested Rate (%) from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined as 100 * (# distinct pj_project_id with pj_a_5200_e911_routing_received_finish not null) / (# distinct pj_project_id with pj_a_3710_ran_entitlement_complete_finish not null). Optional filter smp_name applies only to the macro portion (macro_combined).', kpi_python_function: 'def get_e911_readiness_rate(execute_query, filters=None) -> list[dict]:\n    """KPI: E911 Readiness Rate (RIOT) + E911 Requested Rate (macro).\n\n    Outputs\n    -------\n    1) RIOT-based readiness (primary):\n       - attempted_site_count: count of sites with >=1 non-null nas_e911_validation_date record\n       - passed_site_count: count of sites whose latest validation record is PASS/PASS\n       - e911_readiness_rate: passed_site_count / attempted_site_count\n\n    2) Macro-based completion companion (secondary):\n       - entitled_site_count: distinct projects with pj_a_3710_ran_entitlement_complete_finish IS NOT NULL\n       - e911_requested_count: distinct projects with pj_a_5200_e911_routing_received_finish IS NOT NULL\n       - e911_requested_rate_pct: 100 * e911_requested_count / entitled_site_count\n\n    Notes\n    -----\n    * RIOT readiness is sourced from stg_nas_e911_readiness_riot_validation.\n    * E911 Requested Rate is sourced from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.\n    * This function avoids CTEs (no WITH clauses).\n    """\n\n    filters = filters or {}\n\n    # ----------------------------\n    # Part A: RIOT Readiness (latest-status, PASS/PASS)\n    # ----------------------------\n    start_date = filters.get("start_date")\n    end_date = filters.get("end_date")\n    nas_site_id = filters.get("nas_site_id") or filters.get("s_site_id") or filters.get("site_code")\n    nas_engineer = filters.get("nas_engineer")\n\n    where = ["nas_e911_validation_date IS NOT NULL"]\n    if nas_site_id:\n        where.append(f"nas_site_id = \'{nas_site_id}\'")\n    if nas_engineer:\n        where.append(f"nas_engineer = \'{nas_engineer}\'")\n    if start_date:\n        where.append(f"nas_e911_validation_date::date >= \'{str(start_date)[:10]}\'")\n    if end_date:\n        where.append(f"nas_e911_validation_date::date <= \'{str(end_date)[:10]}\'")\n\n    riot_sql = f"""\n        SELECT\n            v.nas_site_id,\n            v.latest_validation_date,\n            MAX(CASE\n                WHEN r.nas_validate_e911_readiness = \'PASS\'\n                 AND r.nas_consolidation_check_all_layers = \'PASS\'\n                THEN 1 ELSE 0 END\n            ) AS site_passed,\n            MAX(CASE\n                WHEN r.nas_validate_e911_readiness <> \'PASS\'\n                THEN r.nas_e911_validation_reason ELSE NULL END\n            ) AS failure_reason\n        FROM (\n            SELECT\n                nas_site_id,\n                MAX(nas_e911_validation_date) AS latest_validation_date\n            FROM stg_nas_e911_readiness_riot_validation\n            WHERE {\' AND \'.join(where)}\n            GROUP BY nas_site_id\n        ) v\n        JOIN stg_nas_e911_readiness_riot_validation r\n          ON r.nas_site_id = v.nas_site_id\n         AND r.nas_e911_validation_date = v.latest_validation_date\n        GROUP BY v.nas_site_id, v.latest_validation_date\n    """\n\n    riot_by_site = execute_query(riot_sql) or []\n\n    include_site_details = bool(filters.get("include_site_details"))\n    need_dims = include_site_details or filters.get("group_by") in ("region", "market") or any(filters.get(k) for k in ("m_market", "m_area", "rgn_region"))\n\n    site_dim = {}\n    if need_dims:\n        site_filters = {}\n        for k in ("m_market", "m_area", "rgn_region"):\n            if filters.get(k) not in (None, ""):\n                site_filters[k] = filters.get(k)\n\n        sites = get_site(execute_query, site_filters)\n        for s in sites or []:\n            key = s.get("nas_site_id") or s.get("s_site_id") or s.get("site_code")\n            if key is not None:\n                site_dim[str(key)] = s\n\n    by_site = []\n    for r in riot_by_site:\n        sid = r.get("nas_site_id")\n        if sid is None:\n            continue\n        sid_key = str(sid)\n        passed = int(r.get("site_passed") or 0)\n        s = site_dim.get(sid_key, {})\n\n        if need_dims and site_dim:\n            if filters.get("m_market") and s.get("m_market") != filters.get("m_market"):\n                continue\n            if filters.get("m_area") and s.get("m_area") != filters.get("m_area"):\n                continue\n            if filters.get("rgn_region") and s.get("rgn_region") != filters.get("rgn_region"):\n                continue\n\n        rec = {\n            "nas_site_id": sid,\n            "attempted": 1,\n            "passed": passed,\n            "latest_validation_date": r.get("latest_validation_date"),\n            "failure_reason": r.get("failure_reason"),\n            "m_market": s.get("m_market"),\n            "m_area": s.get("m_area"),\n            "rgn_region": s.get("rgn_region"),\n        }\n\n        if include_site_details:\n            rec.update({\n                "site_name": s.get("site_name"),\n                "s_city": s.get("s_city"),\n                "s_state": s.get("s_state"),\n            })\n        by_site.append(rec)\n\n    attempted_sites = len(by_site)\n    passed_sites = sum(x["passed"] for x in by_site)\n    riot_rate = (float(passed_sites) / float(attempted_sites)) if attempted_sites else None\n\n    # ----------------------------\n    # Part B: Macro companion - E911 Requested Rate (%)\n    # ----------------------------\n    macro_where_parts = ["1=1"]\n\n    if filters.get("smp_name") not in (None, ""):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        macro_where_parts.append(f"mc.\\"smp_name\\" = \'{v}\'")\n        if v.strip().upper() == "NTM":\n            macro_where_parts.append("mc.\\"smp_status\\" = \'Active\'")\n            macro_where_parts.append("mc.\\"ntm_project_type\\" NOT IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\')")\n\n    macro_sql = f"""\n        SELECT\n            COUNT(DISTINCT CASE\n                WHEN mc.\\"pj_a_3710_ran_entitlement_complete_finish\\" IS NOT NULL\n                THEN mc.\\"pj_project_id\\" END\n            ) AS entitled_site_count,\n            COUNT(DISTINCT CASE\n                WHEN mc.\\"pj_a_5200_e911_routing_received_finish\\" IS NOT NULL\n                THEN mc.\\"pj_project_id\\" END\n            ) AS e911_requested_count\n        FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined mc\n        WHERE {\' AND \'.join(macro_where_parts)}\n    """\n\n    macro_rows = execute_query(macro_sql) or []\n    mr = macro_rows[0] if macro_rows else {}\n    entitled = int(mr.get("entitled_site_count") or 0)\n    requested = int(mr.get("e911_requested_count") or 0)\n    requested_rate_pct = (100.0 * float(requested) / float(entitled)) if entitled else None\n\n    # ----------------------------\n    # Output formatting\n    # ----------------------------\n    if filters.get("group_by") == "region":\n        agg = {}\n        for rec in by_site:\n            key = rec.get("rgn_region") or "(unknown)"\n            a = agg.get(key)\n            if a is None:\n                agg[key] = {"rgn_region": key, "attempted_site_count": 1, "passed_site_count": rec["passed"]}\n            else:\n                a["attempted_site_count"] += 1\n                a["passed_site_count"] += rec["passed"]\n\n        out = []\n        for _, a in sorted(agg.items(), key=lambda x: x[0]):\n            attempted = a["attempted_site_count"]\n            passed = a["passed_site_count"]\n            a["e911_readiness_rate"] = (float(passed) / float(attempted)) if attempted else None\n            a["entitled_site_count"] = entitled\n            a["e911_requested_count"] = requested\n            a["e911_requested_rate_pct"] = requested_rate_pct\n            out.append(a)\n        return out\n\n    if filters.get("group_by") == "market":\n        agg = {}\n        for rec in by_site:\n            key = rec.get("m_market") or "(unknown)"\n            a = agg.get(key)\n            if a is None:\n                agg[key] = {"m_market": key, "attempted_site_count": 1, "passed_site_count": rec["passed"]}\n            else:\n                a["attempted_site_count"] += 1\n                a["passed_site_count"] += rec["passed"]\n\n        out = []\n        for _, a in sorted(agg.items(), key=lambda x: x[0]):\n            attempted = a["attempted_site_count"]\n            passed = a["passed_site_count"]\n            a["e911_readiness_rate"] = (float(passed) / float(attempted)) if attempted else None\n            a["entitled_site_count"] = entitled\n            a["e911_requested_count"] = requested\n            a["e911_requested_rate_pct"] = requested_rate_pct\n            out.append(a)\n        return out\n\n    if filters.get("include_site_level"):\n        for rec in by_site:\n            rec["entitled_site_count"] = entitled\n            rec["e911_requested_count"] = requested\n            rec["e911_requested_rate_pct"] = requested_rate_pct\n        return by_site\n\n    return [{\n        "kpi": "E911 Readiness Rate",\n        "attempted_site_count": attempted_sites,\n        "passed_site_count": passed_sites,\n        "e911_readiness_rate": riot_rate,\n        "entitled_site_count": entitled,\n        "e911_requested_count": requested,\n        "e911_requested_rate_pct": requested_rate_pct\n    }]\n', kpi_source_columns: ['stg_nas_e911_readiness_riot_validation.nas_site_id', 'stg_nas_e911_readiness_riot_validation.nas_e911_validation_date', 'stg_nas_e911_readiness_riot_validation.nas_validate_e911_readiness', 'stg_nas_e911_readiness_riot_validation.nas_consolidation_check_all_layers', 'stg_nas_e911_readiness_riot_validation.nas_e911_validation_reason', 'stg_nas_e911_readiness_riot_validation.nas_engineer', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.pj_project_id', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.pj_a_3710_ran_entitlement_complete_finish', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.pj_a_5200_e911_routing_received_finish', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.smp_name', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.smp_status', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'E911 Readiness Rate', kpi_related_core_node_ids: ['stg_nas_e911_readiness_riot_validation', 'site', 'market', 'project', 'milestone', 'integration_activity', 'person', 'integration_artifact'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '4d46b430-b2af-43e7-8a47-0391a2b77c53', entity_type: 'kpi', kpi_name: 'E911 Readiness Rate', name: '4d46b430-b2af-43e7-8a47-0391a2b77c53', kpi_dimensions: ['nas_site_id', 'rgn_region', 'm_market', 'm_area'], kpi_description: 'Measures the share of sites where E911 validation has been attempted that successfully pass all required E911 validation layers, indicating the site is legally and technically ready to route emergency calls correctly prior to on-air. This KPI is used to quantify integration go-live blocking risk, identify markets/regions/vendors with disproportionate E911 failures, and monitor readiness trends over time. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: '4d46b430-b2af-43e7-8a47-0391a2b77c53'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'For entitled projects in pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined grouped by (rgn_region, m_area, m_market, construction_gc, por_category), compute distinct active site counts split by CPO missing, CPO present but SPO missing, both present, and CPO-unavailable rate = 100*cpo_missing/total. CPO column is program-specific: NTM uses ms1555_construction_complete_so_header (QB Row 254), AHLOB uses ms_1555_construction_complete_cpo_custom_field (QB Row 336). Optionally filterable by program via smp_name.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension."}, {"column": "m_area", "type": "string", "description": "Area dimension."}, {"column": "m_market", "type": "string", "description": "Market dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor dimension."}, {"column": "por_category", "type": "string", "description": "POR category dimension."}, {"column": "total_active_sites", "type": "integer", "description": "Distinct count of active projects/sites."}, {"column": "cpo_not_available_count", "type": "integer", "description": "Distinct count of active projects where CPO (SO header) is missing."}, {"column": "cpo_available_spo_pending_count", "type": "integer", "description": "Distinct count of active projects where CPO exists but SPO is missing."}, {"column": "both_available_count", "type": "integer", "description": "Distinct count of active projects where both CPO and SPO exist."}, {"column": "cpo_unavailable_rate_pct", "type": "float", "description": "100 * cpo_not_available_count / total_active_sites (safe divide by NULLIF)."}]', kpi_business_logic: '1) Initialize filters to an empty dict when None (filters = filters or {}). 2) Start with base gate: include only rows where pj_a_3710_ran_entitlement_complete_finish IS NOT NULL. 3) If smp_name filter is provided, select the CPO availability column program-specifically: default/NTM uses ms1555_construction_complete_so_header; if smp_name contains \'AHLOB\' (case-insensitive), use ms_1555_construction_complete_cpo_custom_field. The column selection is driven by the smp_name filter value. 4) If smp_name is provided, filter to smp_name exact match; additionally if smp_name == \'NTM\' (case-insensitive/trimmed), further constrain to smp_status=\'Active\' and exclude ntm_project_type in (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\'). 5) Apply any additional allowlisted dimension filters (rgn_region, m_area, m_market, construction_gc, por_category, pj_project_id, s_site_id). 6) Group by rgn_region, m_area, m_market, construction_gc, por_category. 7) Compute counts using COUNT(DISTINCT pj_project_id): total_active_sites; cpo_not_available_count where selected CPO column IS NULL; cpo_available_spo_pending_count where selected CPO column IS NOT NULL AND ms1555_construction_complete_spo IS NULL; both_available_count where selected CPO column IS NOT NULL AND ms1555_construction_complete_spo IS NOT NULL. 8) Compute cpo_unavailable_rate_pct = 100.0 * cpo_not_available_count / NULLIF(total_active_sites,0).', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "por_category", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_cpo_spo_availability_gap", "node_type": "kpi", "node_id": "152a2392-d39a-4f5e-8e8f-45f4d3e5701d", "node_label": "CPO/SPO Availability Gap", "description": "Tracks the financial pipeline gap between Customer Purchase Order (CPO) availability and Supplier Purchase Order (SPO) creation for active NTM sites, to support cash-flow forecasting and identify commercial bottlenecks. Measures total active sites, count missing CPO, count with CPO but SPO pending, count with both CPO and SPO available, and the CPO-unavailable rate.", "parameters": [{"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "por_category", "type": "string", "nullable": false}, {"name": "total_active_sites", "type": "number", "nullable": false}, {"name": "cpo_not_available_count", "type": "number", "nullable": false}, {"name": "cpo_available_spo_pending_count", "type": "number", "nullable": false}, {"name": "both_available_count", "type": "number", "nullable": false}, {"name": "cpo_unavailable_rate_pct", "type": "string", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'For entitled projects in pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined grouped by (rgn_region, m_area, m_market, construction_gc, por_category), compute distinct active site counts split by CPO missing, CPO present but SPO missing, both present, and CPO-unavailable rate = 100*cpo_missing/total. CPO column is program-specific: NTM uses ms1555_construction_complete_so_header (QB Row 254), AHLOB uses ms_1555_construction_complete_cpo_custom_field (QB Row 336). Optionally filterable by program via smp_name.', node_type: 'CORE', definition: 'For entitled projects in pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined grouped by (rgn_region, m_area, m_market, construction_gc, por_category), compute distinct active site counts split by CPO missing, CPO present but SPO missing, both present, and CPO-unavailable rate = 100*cpo_missing/total. CPO column is program-specific: NTM uses ms1555_construction_complete_so_header (QB Row 254), AHLOB uses ms_1555_construction_complete_cpo_custom_field (QB Row 336). Optionally filterable by program via smp_name.', kpi_python_function: 'def get_cpo_spo_availability_gap(execute_query, filters=None) -> list[dict]:\n    filters = filters or {}\n\n    # KPI computed from a single wide staging table using SQL-side aggregation.\n    where_parts = [\n        "1=1",\n        "\\"pj_a_3710_ran_entitlement_complete_finish\\" IS NOT NULL"\n    ]\n\n    # Determine CPO column based on program\n    cpo_col = \'"ms1555_construction_complete_so_header"\'  # default / NTM\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        if \'AHLOB\' in v.upper():\n            cpo_col = \'"ms_1555_construction_complete_cpo_custom_field"\'\n\n    # Allowlist filters (exact match to spec)\n    if filters:\n        if filters.get("rgn_region"):\n            v = str(filters["rgn_region"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"rgn_region\\" = \'{v}\'")\n        if filters.get("m_area"):\n            v = str(filters["m_area"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_area\\" = \'{v}\'")\n        if filters.get("m_market"):\n            v = str(filters["m_market"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"m_market\\" = \'{v}\'")\n        if filters.get("construction_gc"):\n            v = str(filters["construction_gc"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"construction_gc\\" = \'{v}\'")\n        if filters.get("por_category"):\n            v = str(filters["por_category"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"por_category\\" = \'{v}\'")\n        if filters.get("pj_project_id"):\n            v = str(filters["pj_project_id"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"pj_project_id\\" = \'{v}\'")\n        if filters.get("s_site_id"):\n            v = str(filters["s_site_id"]).replace("\'", "\'\'")\n            where_parts.append(f"\\"s_site_id\\" = \'{v}\'")\n\n        # Add smp_name filter with NTM conditional (EXACT requested block)\n        if filters.get("smp_name"):\n            v = str(filters["smp_name"]).replace("\'", "\'\'")\n            where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n            if v.strip().upper() == \'NTM\':\n                where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n                where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = (\n        f\'\'\'SELECT   "rgn_region",   "m_area",   "m_market",   "construction_gc",   "por_category",   COUNT(DISTINCT "pj_project_id") AS "total_active_sites",   COUNT(DISTINCT CASE WHEN {cpo_col} IS NULL THEN "pj_project_id" END) AS "cpo_not_available_count",   COUNT(DISTINCT CASE WHEN {cpo_col} IS NOT NULL AND "ms1555_construction_complete_spo" IS NULL THEN "pj_project_id" END) AS "cpo_available_spo_pending_count",   COUNT(DISTINCT CASE WHEN {cpo_col} IS NOT NULL AND "ms1555_construction_complete_spo" IS NOT NULL THEN "pj_project_id" END) AS "both_available_count",   100.0 *     COUNT(DISTINCT CASE WHEN {cpo_col} IS NULL THEN "pj_project_id" END)     / NULLIF(COUNT(DISTINCT "pj_project_id"), 0) AS "cpo_unavailable_rate_pct" FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined" WHERE {where_sql} GROUP BY   "rgn_region", "m_area", "m_market", "construction_gc", "por_category" ORDER BY   "rgn_region", "m_area", "m_market", "construction_gc", "por_category"\'\'\'\n    )\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_a_3710_ran_entitlement_complete_finish', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 'pj_project_id', 's_site_id', 'ms1555_construction_complete_spo', 'ms1555_construction_complete_so_header', 'ms_1555_construction_complete_cpo_custom_field', 'smp_name', 'smp_status', 'ntm_project_type'], session_id: '69a3d22f26e208edc083a06e', label: 'CPO/SPO Availability Gap', kpi_related_core_node_ids: ['project', 'closeout_package', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '152a2392-d39a-4f5e-8e8f-45f4d3e5701d', entity_type: 'kpi', kpi_name: 'CPO/SPO Availability Gap', name: '152a2392-d39a-4f5e-8e8f-45f4d3e5701d', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category'], kpi_description: 'Tracks the financial pipeline gap between Customer Purchase Order (CPO) availability and Supplier Purchase Order (SPO) creation for active NTM sites, to support cash-flow forecasting and identify commercial bottlenecks. Measures total active sites, count missing CPO, count with CPO but SPO pending, count with both CPO and SPO available, and the CPO-unavailable rate.', status: 'mentioned', node_id: '152a2392-d39a-4f5e-8e8f-45f4d3e5701d'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Measures CX Start to On-Air lead time using dual milestone systems: CX Start is COALESCE(pj_a_4225_construction_start_finish::date, ms_1550_construction_start_actual::date) (Magenta preferred, NDPd fallback). On-Air date is por_first_completion_objective_actual, cast to date only when LENGTH(text) >= 10 and the first character is between \'0\' and \'9\' (no regex). For each (rgn_region, m_area, m_market, construction_gc) group, computes lead-time distribution over non-negative durations where both dates exist: avg_cycle_time_days (mean), p50_cycle_time_days (median), p90_cycle_time_days, and max_cycle_time_days, plus cycle_time_project_count. Also computes total_projects_in_scope (distinct pj_project_id), cx_started_count, on_air_count, pending_onair_count (cx_start present, on_air missing), and on_air_completion_rate_pct = 100 × on_air_count / total_projects_in_scope. Date filters (start_date/end_date) constrain the base rows using the guarded On-Air date; denominator_scope=\'entitled\' further restricts base rows to pj_a_3710_ran_entitlement_complete_finish IS NOT NULL.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping dimension."}, {"column": "m_area", "type": "string", "description": "Area grouping dimension."}, {"column": "m_market", "type": "string", "description": "Market grouping dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping dimension."}, {"column": "avg_cycle_time_days", "type": "float", "description": "Average Construction Start to On-Air cycle time in days (pj_a_4225 to pj_completion_objective_actual_date). Excludes negatives."}, {"column": "cycle_time_project_count", "type": "int", "description": "Distinct projects with valid cycle time (both dates present, non-negative duration)."}, {"column": "total_projects_in_scope", "type": "int", "description": "Total distinct projects in the filtered base set."}, {"column": "on_air_projects", "type": "int", "description": "Distinct projects with pj_completion_objective_actual_date populated."}, {"column": "on_air_completion_rate_pct", "type": "float", "description": "On-Air completion rate: 100 * on_air_projects / total_projects_in_scope."}]', kpi_business_logic: 'Initialize filters = filters or {}.\nSeed WHERE with [\'1=1\'] and append allowlisted equality filters: rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id, pj_project_type, pj_program_name.\nApply smp_name filter; if smp_name is \'NTM\' (case-insensitive), also require smp_status=\'Active\' and exclude two ntm_project_type values (exact conditions as specified).\nApply denominator_scope: if \'entitled\', append pj_a_3710_ran_entitlement_complete_finish IS NOT NULL; if \'all_active\', no additional constraint.\nDefine guarded On-Air date in SQL as CASE WHEN LENGTH(por_first_completion_objective_actual::text) >= 10 AND SUBSTRING(...,1,1) BETWEEN \'0\' AND \'9\' THEN por_first_completion_objective_actual::timestamp::date END; apply start_date/end_date filters to this guarded date.\nSelect explicit columns (no SELECT *), including the guarded On-Air date as on_air_date, and pull rows via execute_query(sql).\nGroup rows by (rgn_region, m_area, m_market, construction_gc).\nFor each row, compute cx_start = COALESCE(pj_a_4225_construction_start_finish::date, ms_1550_construction_start_actual::date); derive source_system as \'Magenta\' if pj_a_4225 present else \'NDPd\' if ms_1550 present else NULL (not returned but defines which milestone provided CX Start).\nCompute distinct project sets per group: total_projects_in_scope, cx_started_count (cx_start not null), on_air_count (on_air_date not null), pending_onair_count (cx_start not null and on_air_date null).\nCompute valid durations per group where both dates exist and (on_air - cx_start) >= 0; cycle_time_project_count is count of valid durations.\nCompute avg_cycle_time_days (mean), p50_cycle_time_days (nearest-rank 50th percentile), p90_cycle_time_days (nearest-rank 90th percentile), and max_cycle_time_days from valid durations.\nCompute on_air_completion_rate_pct = 100 × on_air_count / total_projects_in_scope.\nReturn group rows sorted by rgn_region, m_area, m_market, construction_gc.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Exact match filter on rgn_region."}, {"name": "m_area", "type": "string", "description": "Exact match filter on m_area."}, {"name": "m_market", "type": "string", "description": "Exact match filter on m_market."}, {"name": "construction_gc", "type": "string", "description": "Exact match filter on construction_gc."}, {"name": "pj_project_id", "type": "string", "description": "Exact match filter on pj_project_id."}, {"name": "s_site_id", "type": "string", "description": "Exact match filter on s_site_id."}, {"name": "pj_project_type", "type": "string", "description": "Exact match filter on pj_project_type."}, {"name": "pj_program_name", "type": "string", "description": "Exact match filter on pj_program_name."}, {"name": "smp_name", "type": "string", "description": "Exact match filter on smp_name; if value is \'NTM\' (case-insensitive), also applies smp_status=\'Active\' and excludes two ntm_project_type values."}, {"name": "start_date", "type": "date_string_yyyy_mm_dd", "description": "Lower bound applied to guarded por_first_completion_objective_actual date (On-Air date)."}, {"name": "end_date", "type": "date_string_yyyy_mm_dd", "description": "Upper bound applied to guarded por_first_completion_objective_actual date (On-Air date)."}, {"name": "denominator_scope", "type": "enum", "allowed_values": ["all_active", "entitled"], "default": "all_active", "description": "If \'entitled\', restricts base rows to pj_a_3710_ran_entitlement_complete_finish IS NOT NULL."}, {"name": "pj_on_air_delay_code", "type": "string", "description": "Optional filter on the on-air delay code column. When provided, the query adds: pj_on_air_delay_code IS NOT NULL AND pj_on_air_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}]', kpi_contract: '{"function_name": "get_on_air_cycle_time", "node_type": "kpi", "node_id": "d7ffcd7d-93e1-4c31-a9f2-b430e2843f28", "node_label": "On-Air Cycle Time", "description": "Average end-to-end delivery time from construction start to the first On-Air milestone.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}, {"name": "pj_project_type", "type": "string", "description": "Filter by pj project type", "required": false, "sample_values": []}, {"name": "pj_program_name", "type": "string", "description": "Filter by pj program name", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}, {"name": "denominator_scope", "type": "string", "description": "Filter by denominator scope", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}, {"name": "pj_on_air_delay_code", "type": "string", "description": "Filter to projects with a specific on-air delay code, or any real on-air delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Vendor Delay", "Customer Delay"]}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "total_projects_in_scope", "type": "number", "nullable": false}, {"name": "cx_started_count", "type": "number", "nullable": false}, {"name": "on_air_count", "type": "number", "nullable": false}, {"name": "pending_onair_count", "type": "number", "nullable": false}, {"name": "on_air_completion_rate_pct", "type": "number", "nullable": false}, {"name": "cycle_time_project_count", "type": "number", "nullable": false}, {"name": "avg_cycle_time_days", "type": "number", "nullable": true}, {"name": "max_cycle_time_days", "type": "number", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Measures CX Start to On-Air lead time using dual milestone systems: CX Start is COALESCE(pj_a_4225_construction_start_finish::date, ms_1550_construction_start_actual::date) (Magenta preferred, NDPd fallback). On-Air date is por_first_completion_objective_actual, cast to date only when LENGTH(text) >= 10 and the first character is between \'0\' and \'9\' (no regex). For each (rgn_region, m_area, m_market, construction_gc) group, computes lead-time distribution over non-negative durations where both dates exist: avg_cycle_time_days (mean), p50_cycle_time_days (median), p90_cycle_time_days, and max_cycle_time_days, plus cycle_time_project_count. Also computes total_projects_in_scope (distinct pj_project_id), cx_started_count, on_air_count, pending_onair_count (cx_start present, on_air missing), and on_air_completion_rate_pct = 100 × on_air_count / total_projects_in_scope. Date filters (start_date/end_date) constrain the base rows using the guarded On-Air date; denominator_scope=\'entitled\' further restricts base rows to pj_a_3710_ran_entitlement_complete_finish IS NOT NULL.', node_type: 'CORE', definition: 'Measures CX Start to On-Air lead time using dual milestone systems: CX Start is COALESCE(pj_a_4225_construction_start_finish::date, ms_1550_construction_start_actual::date) (Magenta preferred, NDPd fallback). On-Air date is por_first_completion_objective_actual, cast to date only when LENGTH(text) >= 10 and the first character is between \'0\' and \'9\' (no regex). For each (rgn_region, m_area, m_market, construction_gc) group, computes lead-time distribution over non-negative durations where both dates exist: avg_cycle_time_days (mean), p50_cycle_time_days (median), p90_cycle_time_days, and max_cycle_time_days, plus cycle_time_project_count. Also computes total_projects_in_scope (distinct pj_project_id), cx_started_count, on_air_count, pending_onair_count (cx_start present, on_air missing), and on_air_completion_rate_pct = 100 × on_air_count / total_projects_in_scope. Date filters (start_date/end_date) constrain the base rows using the guarded On-Air date; denominator_scope=\'entitled\' further restricts base rows to pj_a_3710_ran_entitlement_complete_finish IS NOT NULL.', kpi_python_function: 'def get_on_air_cycle_time(execute_query, filters=None) -> list[dict]:\n    # 1) required: first executable line\n    filters = filters or {}\n\n    """CX Start -> On-Air Lead Time (Magenta primary, NDPd fallback) + completion/pending + percentiles.\n\n    Source: pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n\n    CX Start date:\n      COALESCE(pj_a_4225_construction_start_finish::date, ms_1550_construction_start_actual::date)\n\n    On-Air date:\n      por_first_completion_objective_actual guarded for VARCHAR using LENGTH>=10 and first-char between \'0\' and \'9\'\n\n    Grouping dimensions (Python-side):\n      (rgn_region, m_area, m_market, construction_gc)\n\n    Outputs per group:\n      total_projects_in_scope, cx_started_count, on_air_count, pending_onair_count,\n      on_air_completion_rate_pct, cycle_time_project_count, avg_cycle_time_days,\n      p50_cycle_time_days, p90_cycle_time_days, max_cycle_time_days\n\n    Allowlisted filters:\n      rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id,\n      pj_project_type, pj_program_name, smp_name, start_date, end_date, denominator_scope\n    """\n\n    # -------------------------\n    # helpers\n    def _esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    def _parse_date(v):\n        """Parse YYYY-MM-DD from strings/timestamps; return ordinal int or None."""\n        if v is None:\n            return None\n        s = str(v).strip()\n        if len(s) < 10:\n            return None\n        # minimal guard equivalent to SQL LENGTH/first-char check\n        c0 = s[0]\n        if c0 < \'0\' or c0 > \'9\':\n            return None\n        try:\n            y = int(s[0:4]); m = int(s[5:7]); d = int(s[8:10])\n        except Exception:\n            return None\n\n        # Gregorian date -> ordinal via JDN\n        a = (14 - m) // 12\n        y2 = y + 4800 - a\n        m2 = m + 12 * a - 3\n        jdn = d + ((153 * m2 + 2) // 5) + 365 * y2 + (y2 // 4) - (y2 // 100) + (y2 // 400) - 32045\n        return jdn\n\n    def _percentile(sorted_vals, p):\n        """Nearest-rank percentile. p in [0,1]."""\n        n = len(sorted_vals)\n        if n == 0:\n            return None\n        if p <= 0:\n            return float(sorted_vals[0])\n        if p >= 1:\n            return float(sorted_vals[-1])\n        # nearest-rank\n        k = int((n * p) + 0.999999999)  # ceil(n*p)\n        idx = max(1, min(n, k)) - 1\n        return float(sorted_vals[idx])\n\n    # -------------------------\n    # 2) Build WHERE with seed\n    where_parts = ["1=1"]\n\n    # 2) allowlisted equality filters\n    if filters.get(\'rgn_region\'):\n        where_parts.append(f"\\"rgn_region\\" = \'{_esc(filters[\'rgn_region\'])}\'")\n    if filters.get(\'m_area\'):\n        where_parts.append(f"\\"m_area\\" = \'{_esc(filters[\'m_area\'])}\'")\n    if filters.get(\'m_market\'):\n        where_parts.append(f"\\"m_market\\" = \'{_esc(filters[\'m_market\'])}\'")\n    if filters.get(\'construction_gc\'):\n        where_parts.append(f"\\"construction_gc\\" = \'{_esc(filters[\'construction_gc\'])}\'")\n    if filters.get(\'pj_project_id\'):\n        where_parts.append(f"\\"pj_project_id\\" = \'{_esc(filters[\'pj_project_id\'])}\'")\n    if filters.get(\'s_site_id\'):\n        where_parts.append(f"\\"s_site_id\\" = \'{_esc(filters[\'s_site_id\'])}\'")\n    if filters.get(\'pj_project_type\'):\n        where_parts.append(f"\\"pj_project_type\\" = \'{_esc(filters[\'pj_project_type\'])}\'")\n    if filters.get(\'pj_program_name\'):\n        where_parts.append(f"\\"pj_program_name\\" = \'{_esc(filters[\'pj_program_name\'])}\'")\n\n    # 3) EXACT smp_name + NTM conditional block as requested\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    # 4) denominator_scope\n    denominator_scope = (filters.get(\'denominator_scope\') or \'all_active\').strip().lower()\n    if denominator_scope not in (\'all_active\', \'entitled\'):\n        denominator_scope = \'all_active\'\n    if denominator_scope == \'entitled\':\n        where_parts.append(\'"pj_a_3710_ran_entitlement_complete_finish" IS NOT NULL\')\n\n    # guarded On-Air date expression (NO regex)\n    on_air_date_expr = (\n        "CASE WHEN LENGTH(\\"por_first_completion_objective_actual\\"::text) >= 10 "\n        "      AND SUBSTRING(\\"por_first_completion_objective_actual\\"::text, 1, 1) BETWEEN \'0\' AND \'9\' "\n        "     THEN \\"por_first_completion_objective_actual\\"::timestamp::date END"\n    )\n\n    # 5) date range filters apply to guarded On-Air date\n    if filters.get(\'start_date\'):\n        where_parts.append(f"({on_air_date_expr}) >= \'{_esc(filters[\'start_date\'])}\'::date")\n    if filters.get(\'end_date\'):\n        where_parts.append(f"({on_air_date_expr}) <= \'{_esc(filters[\'end_date\'])}\'::date")\n\n\n    # Optional on-air delay-code filter\n\n    _v = filters.get("pj_on_air_delay_code")\n\n    if _v is not None and str(_v).strip() != "":\n\n        _s = str(_v).strip()\n\n        where_parts.append(\'"pj_on_air_delay_code" IS NOT NULL\')\n\n        where_parts.append("\\"pj_on_air_delay_code\\" <> \'No Delay\'")\n\n        if _s.lower() not in ("any", "true", "yes", "1", "*"):\n\n            _ss = _s.replace("\'", "\'\'")\n\n            where_parts.append(f\'"pj_on_air_delay_code" = \\\'{_ss}\\\'\')\n\n    where_sql = "WHERE " + " AND ".join(where_parts)\n\n    # 6) explicit SELECT columns only (no SELECT *)\n    sql = (\n        f"""SELECT   "pj_project_id",   "rgn_region",   "m_area",   "m_market",   "construction_gc",   "pj_a_4225_construction_start_finish",   "ms_1550_construction_start_actual",   "por_first_completion_objective_actual",   {on_air_date_expr} AS "on_air_date" FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined {where_sql}"""\n    )\n\n    rows = execute_query(sql) or []\n\n    # -------------------------\n    # 7) compute per group in Python\n    groups = {}  # key -> aggregations\n\n    for r in rows:\n        key = (\n            r.get(\'rgn_region\'),\n            r.get(\'m_area\'),\n            r.get(\'m_market\'),\n            r.get(\'construction_gc\')\n        )\n\n        g = groups.get(key)\n        if g is None:\n            g = {\n                \'project_ids\': set(),\n                \'cx_started_ids\': set(),\n                \'on_air_ids\': set(),\n                \'pending_ids\': set(),\n                \'durations\': []\n            }\n            groups[key] = g\n\n        pid = r.get(\'pj_project_id\')\n        if pid is None:\n            continue\n        g[\'project_ids\'].add(pid)\n\n        # cx_start: COALESCE(pj_a_4225, ms_1550)\n        cx_start_ord = _parse_date(r.get(\'pj_a_4225_construction_start_finish\'))\n        source_system = None\n        if cx_start_ord is not None:\n            source_system = \'Magenta\'\n        else:\n            cx_start_ord = _parse_date(r.get(\'ms_1550_construction_start_actual\'))\n            if cx_start_ord is not None:\n                source_system = \'NDPd\'\n\n        # on_air: use SQL-guarded on_air_date output (already NULL if uncastable)\n        on_air_ord = _parse_date(r.get(\'on_air_date\'))\n\n        if cx_start_ord is not None:\n            g[\'cx_started_ids\'].add(pid)\n\n        if on_air_ord is not None:\n            g[\'on_air_ids\'].add(pid)\n\n        if cx_start_ord is not None and on_air_ord is None:\n            g[\'pending_ids\'].add(pid)\n\n        if cx_start_ord is not None and on_air_ord is not None:\n            d = on_air_ord - cx_start_ord\n            if d >= 0:\n                g[\'durations\'].append(int(d))\n\n    # build output list\n    out = []\n    for key in sorted(groups.keys(), key=lambda x: (x[0] or \'\', x[1] or \'\', x[2] or \'\', x[3] or \'\')):\n        rgn_region, m_area, m_market, construction_gc = key\n        g = groups[key]\n\n        total_projects_in_scope = len(g[\'project_ids\'])\n        cx_started_count = len(g[\'cx_started_ids\'])\n        on_air_count = len(g[\'on_air_ids\'])\n        pending_onair_count = len(g[\'pending_ids\'])\n\n        on_air_completion_rate_pct = (\n            (100.0 * on_air_count / total_projects_in_scope) if total_projects_in_scope else None\n        )\n\n        durations = g[\'durations\']\n        durations.sort()\n        cycle_time_project_count = len(durations)\n        avg_cycle_time_days = (sum(durations) / cycle_time_project_count) if cycle_time_project_count else None\n        p50_cycle_time_days = _percentile(durations, 0.50)\n        p90_cycle_time_days = _percentile(durations, 0.90)\n        max_cycle_time_days = float(durations[-1]) if durations else None\n\n        out.append({\n            \'rgn_region\': rgn_region,\n            \'m_area\': m_area,\n            \'m_market\': m_market,\n            \'construction_gc\': construction_gc,\n            \'total_projects_in_scope\': total_projects_in_scope,\n            \'cx_started_count\': cx_started_count,\n            \'on_air_count\': on_air_count,\n            \'pending_onair_count\': pending_onair_count,\n            \'on_air_completion_rate_pct\': on_air_completion_rate_pct,\n            \'cycle_time_project_count\': cycle_time_project_count,\n            \'avg_cycle_time_days\': float(avg_cycle_time_days) if avg_cycle_time_days is not None else None,\n            \'p50_cycle_time_days\': p50_cycle_time_days,\n            \'p90_cycle_time_days\': p90_cycle_time_days,\n            \'max_cycle_time_days\': max_cycle_time_days\n        })\n\n    return out\n', kpi_source_columns: ['pj_project_id', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_a_4225_construction_start_finish', 'ms_1550_construction_start_actual', 'por_first_completion_objective_actual', 'pj_a_3710_ran_entitlement_complete_finish', 's_site_id', 'pj_project_type', 'pj_program_name', 'smp_name', 'smp_status', 'ntm_project_type', 'pj_on_air_delay_code'], session_id: '69a3d22f26e208edc083a06e', label: 'On-Air Cycle Time', kpi_related_core_node_ids: ['project', 'site'], kpi_relationship_type: 'DERIVED_FROM', kpi_kpi_id: 'd7ffcd7d-93e1-4c31-a9f2-b430e2843f28', entity_type: 'kpi', kpi_name: 'On-Air Cycle Time', name: 'd7ffcd7d-93e1-4c31-a9f2-b430e2843f28', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Average end-to-end delivery time from construction start to the first On-Air milestone. Also filterable by on-air delay code (pj_on_air_delay_code) — any non-empty value engages IS NOT NULL AND <> \'No Delay\'; a specific code value also narrows to that code.', status: 'mentioned', node_id: 'd7ffcd7d-93e1-4c31-a9f2-b430e2843f28'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined', 'pwc_macro_staging_schema.stg_nas_planned_outage_activity'], nl_business_rule: '', kpi_formula_description: 'Prereq Readiness Rate (%) for CX Start = 100.0 * Numerator / NULLIF(Denominator, 0), grouped by (rgn_region, m_area, m_market, construction_gc); HAVING denominator_count > 0. Gate-set is branched by smp_name: AHLOB-substring -> 14-gate AHLOB set; else 20-gate NTM/default set (client MACRO 14 + legacy extras). Per-gate distinct-project counts are returned for every gate name, with program-inapplicable gate counts as NULL. CPO column is program-specific (AHLOA: 1555 cpo_custom_field; MACRO: 1555 so_header). SPO column is the client-aligned 1555 spo_issued_date.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping field."}, {"column": "m_area", "type": "string", "description": "Area grouping field."}, {"column": "m_market", "type": "string", "description": "Market grouping field."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping field."}, {"column": "denominator_count", "type": "int", "description": "Count of distinct active projects where construction has not started."}, {"column": "numerator_count", "type": "int", "description": "Count of distinct denominator projects meeting ALL in-branch prereq gates."}, {"column": "pending_prereq_count", "type": "int", "description": "denominator_count - numerator_count."}, {"column": "kpi_value", "type": "float", "description": "Prereq Readiness % = 100 * numerator / denominator."}, {"column": "ran_entitlement_met", "type": "int", "description": "Distinct projects meeting the \'ran_entitlement_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "bom_aims_met", "type": "int", "description": "Distinct projects meeting the \'bom_aims_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "bom_bat_met", "type": "int", "description": "Distinct projects meeting the \'bom_bat_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "ntp_submitted_met", "type": "int", "description": "Distinct projects meeting the \'ntp_submitted_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "ntp_accepted_met", "type": "int", "description": "Distinct projects meeting the \'ntp_accepted_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "site_access_met", "type": "int", "description": "Distinct projects meeting the \'site_access_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "cpo_met", "type": "int", "description": "Distinct projects meeting the \'cpo_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "spo_met", "type": "int", "description": "Distinct projects meeting the \'spo_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "material_pickup_met", "type": "int", "description": "Distinct projects meeting the \'material_pickup_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "ll_ntp_received_met", "type": "int", "description": "Distinct projects meeting the \'ll_ntp_received_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "scoping_pkg_create_met", "type": "int", "description": "Distinct projects meeting the \'scoping_pkg_create_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "punch_checklist_submitted_met", "type": "int", "description": "Distinct projects meeting the \'punch_checklist_submitted_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "crane_decision_met", "type": "int", "description": "Distinct projects meeting the \'crane_decision_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "nas_outage_upload_met", "type": "int", "description": "Distinct projects meeting the \'nas_outage_upload_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "pre_con_package_met", "type": "int", "description": "Distinct projects meeting the \'pre_con_package_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "site_walk_or_drone_met", "type": "int", "description": "Distinct projects meeting the \'site_walk_or_drone_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "ready_for_scoping_met", "type": "int", "description": "Distinct projects meeting the \'ready_for_scoping_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "scoping_quoting_validated_met", "type": "int", "description": "Distinct projects meeting the \'scoping_quoting_validated_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "steel_received_met", "type": "int", "description": "Distinct projects meeting the \'steel_received_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "scoping_pkg_submitted_met", "type": "int", "description": "Distinct projects meeting the \'scoping_pkg_submitted_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "tower_ntp_validated_met", "type": "int", "description": "Distinct projects meeting the \'tower_ntp_validated_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "precon_walk_met", "type": "int", "description": "Distinct projects meeting the \'precon_walk_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "power_ready_met", "type": "int", "description": "Distinct projects meeting the \'power_ready_met\' gate (NULL when gate is not applicable to the active program branch)."}, {"column": "backhaul_ready_met", "type": "int", "description": "Distinct projects meeting the \'backhaul_ready_met\' gate (NULL when gate is not applicable to the active program branch)."}]', kpi_business_logic: 'Initialize filters = filters or {}. Build WHERE with 1=1 + denominator-defining conditions: pj_project_status != \'Dead\' and ms_1550_construction_start_actual IS NULL. Append optional equality filters (allowlist): rgn_region, m_area, m_market, construction_gc, por_category, pj_project_id, s_site_id. If smp_name provided, add smp_name = \'<value>\'; if smp_name = \'NTM\', also enforce smp_status = \'Active\' and ntm_project_type NOT IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\'). Determine program: smp_name contains \'AHLOB\' (case-insensitive) -> AHLOB branch, else NTM/default branch. CPO column is ms_1555_construction_complete_cpo_custom_field for AHLOB and ms1555_construction_complete_so_header for NTM/default. SPO column (both branches) is ms1555_construction_complete_spo_issued_date. Shared/legacy gates (10): pj_a_3710_ran_entitlement_complete_finish, pj_a_3875_bom_received_bom_in_aims_finish, pj_a_3850_bom_submitted_bom_in_bat_finish, pj_a_4075_construction_ntp_submitted_to_gc_finish, pj_a_4100_construction_ntp_accepted_by_gc_finish, s_24x7_site_access, CPO (per-program), SPO, pj_a_3925_msl_pickup_date_finish, pj_a_4000_ll_ntp_received (non-empty). AHLOB-only gates (4): scoping_package_create_date, ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl, scoping_package_crane_required IN (\'Yes\',\'No\'), nas.nas_activity_end_date IS NOT NULL via LEFT JOIN to stg_nas_planned_outage_activity filtered nas_project_category = \'AHLOB\'. NTM/default-only gates (10): ms_1310_pre_construction_package_received_actual, (ms_1316_pre_con_site_walk_completed_actual OR ms_1321_talon_view_drone_svcs_actual), ms_1323_ready_for_scoping_actual, ms_1327_scoping_and_quoting_package_validated_actual, steel (pj_steel_received_status IN (\'N\',\'Not Applicable\',\'\') OR (\'A\' AND pj_steel_received_date NOT NULL)), ms_1331_scoping_package_submitted_actual, ms_1407_tower_ntp_validated_actual, pj_a_3825_pre_construction_walk_complete_finish (legacy), pj_a_4525_power_ready_finish (legacy), (pj_a_4425_mw_installation_complete_finish OR pj_a_4925_aav_fiber_ready_finish) (legacy). Numerator predicate = AND of all in-branch gates. Aggregate denominator_count, numerator_count, pending_prereq_count = denom - num, prereq_readiness_pct = 100*num/NULLIF(denom,0), and a per-gate distinct-project COUNT for every gate name (program-inapplicable gates returned as NULL::bigint). GROUP BY rgn_region, m_area, m_market, construction_gc; HAVING denom > 0; ORDER BY the same.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "por_category", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": "Filter by program name. AHLOB-substring switches to client\'s AHLOA 14-gate set (incl. NAS planned-outage upload via LEFT JOIN); else MACRO + legacy 24-gate set. When \'NTM\', additionally enforces smp_status=\'Active\' and excludes specific ntm_project_type values."}]', kpi_contract: '{"function_name": "get_prereq_readiness_rate", "node_type": "kpi", "node_id": "dcf98a0e-2891-47a3-a258-ebea62201ba4", "node_label": "Prereq Readiness Rate", "description": "Strict version of prerequisite readiness rate measuring the share of active not-started projects that satisfy ALL prerequisite gates. Aligned with client\'s Milestone Readiness (AHLOA-B / Macro) gate columns. Branched by smp_name: AHLOB-substring applies the client\'s AHLOA-B 14-gate set (incl. NAS planned-outage upload JOIN); else applies the client\'s MACRO 14-gate set plus retained legacy extras (pre-con walk 3825, power 4525, backhaul 4425/4925). Per-gate distinct-project counts are returned for every gate name; program-inapplicable gate counts come back as NULL. Source: macro_combined LEFT JOIN stg_nas_planned_outage_activity (AHLOB-only). Optionally filterable by program via smp_name (e.g., \'NTM\' for Macro, \'AHLOB Modernization\' for AHLOB).", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "denominator_count", "type": "number", "nullable": false}, {"name": "numerator_count", "type": "number", "nullable": false}, {"name": "pending_prereq_count", "type": "number", "nullable": false}, {"name": "prereq_readiness_pct", "type": "string", "nullable": false}, {"name": "ran_entitlement_met", "type": "number", "nullable": true}, {"name": "bom_aims_met", "type": "number", "nullable": true}, {"name": "bom_bat_met", "type": "number", "nullable": true}, {"name": "ntp_submitted_met", "type": "number", "nullable": true}, {"name": "ntp_accepted_met", "type": "number", "nullable": true}, {"name": "site_access_met", "type": "number", "nullable": true}, {"name": "cpo_met", "type": "number", "nullable": true}, {"name": "spo_met", "type": "number", "nullable": true}, {"name": "material_pickup_met", "type": "number", "nullable": true}, {"name": "ll_ntp_received_met", "type": "number", "nullable": true}, {"name": "scoping_pkg_create_met", "type": "number", "nullable": true}, {"name": "punch_checklist_submitted_met", "type": "number", "nullable": true}, {"name": "crane_decision_met", "type": "number", "nullable": true}, {"name": "nas_outage_upload_met", "type": "number", "nullable": true}, {"name": "pre_con_package_met", "type": "number", "nullable": true}, {"name": "site_walk_or_drone_met", "type": "number", "nullable": true}, {"name": "ready_for_scoping_met", "type": "number", "nullable": true}, {"name": "scoping_quoting_validated_met", "type": "number", "nullable": true}, {"name": "steel_received_met", "type": "number", "nullable": true}, {"name": "scoping_pkg_submitted_met", "type": "number", "nullable": true}, {"name": "tower_ntp_validated_met", "type": "number", "nullable": true}, {"name": "precon_walk_met", "type": "number", "nullable": true}, {"name": "power_ready_met", "type": "number", "nullable": true}, {"name": "backhaul_ready_met", "type": "number", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Prereq Readiness Rate (%) for CX Start = 100.0 * Numerator / NULLIF(Denominator, 0), grouped by (rgn_region, m_area, m_market, construction_gc), suppressing groups where Denominator=0 via HAVING. Denominator = COUNT(DISTINCT pj_project_id) of rows where pj_project_status != \'Dead\' AND ms_1550_construction_start_actual IS NULL (CX not started). Numerator = COUNT(DISTINCT pj_project_id) within Denominator where ALL program-specific prerequisite gates are met. Gate set is branched by smp_name: smp_name containing \'AHLOB\' (case-insensitive) applies the client\'s AHLOA-B set (10 shared gates + 4 AHLOB-only: scoping_package_create_date, ms_1557 punch checklist, scoping_package_crane_required IN (\'Yes\',\'No\'), NAS planned-outage upload via LEFT JOIN to stg_nas_planned_outage_activity filtered category=\'AHLOB\'); else (NTM/default) applies the client\'s MACRO set plus retained legacy extras (pre-con walk pj_a_3825, power pj_a_4525, backhaul pj_a_4425/4925). CPO column is selected per program: ms_1555_construction_complete_cpo_custom_field for AHLOA, ms1555_construction_complete_so_header for MACRO. SPO is the client-aligned column ms1555_construction_complete_spo_issued_date for both programs. Per-gate distinct project counts are returned for every gate name; program-inapplicable gate counts are returned as NULL. Source: pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined (m) LEFT JOIN stg_nas_planned_outage_activity (nas, AHLOB-only).', node_type: 'CORE', definition: 'Prereq Readiness Rate (%) for CX Start = 100.0 * Numerator / NULLIF(Denominator, 0), grouped by (rgn_region, m_area, m_market, construction_gc), suppressing groups where Denominator=0 via HAVING. Denominator = COUNT(DISTINCT pj_project_id) of rows where pj_project_status != \'Dead\' AND ms_1550_construction_start_actual IS NULL (CX not started). Numerator = COUNT(DISTINCT pj_project_id) within Denominator where ALL program-specific prerequisite gates are met. Gate set is branched by smp_name: smp_name containing \'AHLOB\' (case-insensitive) applies the client\'s AHLOA-B set (10 shared gates + 4 AHLOB-only: scoping_package_create_date, ms_1557 punch checklist, scoping_package_crane_required IN (\'Yes\',\'No\'), NAS planned-outage upload via LEFT JOIN to stg_nas_planned_outage_activity filtered category=\'AHLOB\'); else (NTM/default) applies the client\'s MACRO set plus retained legacy extras (pre-con walk pj_a_3825, power pj_a_4525, backhaul pj_a_4425/4925). CPO column is selected per program: ms_1555_construction_complete_cpo_custom_field for AHLOA, ms1555_construction_complete_so_header for MACRO. SPO is the client-aligned column ms1555_construction_complete_spo_issued_date for both programs. Per-gate distinct project counts are returned for every gate name; program-inapplicable gate counts are returned as NULL. Source: pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined (m) LEFT JOIN stg_nas_planned_outage_activity (nas, AHLOB-only).', kpi_python_function: 'def get_prereq_readiness_rate(execute_query, filters=None) -> list[dict]:\n    """Prereq Readiness Rate (%) for CX Start.\n\n    Denominator: active (not Dead) projects where CX has not started:\n      - pj_project_status != \'Dead\'\n      - ms_1550_construction_start_actual IS NULL\n\n    Numerator: denominator projects where ALL prerequisite gates are met\n    (program-specific by smp_name):\n      - AHLOB (smp_name contains \'AHLOB\'): client AHLOA-B 12-gate set.\n      - NTM/default                       : client MACRO 14-gate set + retained\n        legacy extras (s_24x7_site_access, pre-con walk, power, backhaul).\n\n    Per-gate distinct project counts are also returned to highlight bottlenecks;\n    program-inapplicable gate counts are returned as NULL.\n\n    Source tables:\n      pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined (m, primary).\n      pwc_macro_staging_schema.stg_nas_planned_outage_activity     (nas, AHLOB-only LEFT JOIN).\n\n    Allowlisted equality filters:\n      rgn_region, m_area, m_market, construction_gc, por_category,\n      pj_project_id, s_site_id, smp_name\n    """\n    filters = filters or {}\n\n    where_parts = [\n        "1=1",\n        "m.pj_project_status != \'Dead\'",\n        "m.ms_1550_construction_start_actual IS NULL",\n    ]\n\n    def _eq_filter(col_alias, key):\n        v = filters.get(key)\n        if v is None:\n            return\n        v = str(v).replace("\'", "\'\'")\n        where_parts.append(f"{col_alias} = \'{v}\'")\n\n    _eq_filter("m.rgn_region", "rgn_region")\n    _eq_filter("m.m_area", "m_area")\n    _eq_filter("m.m_market", "m_market")\n    _eq_filter("m.construction_gc", "construction_gc")\n    _eq_filter("m.por_category", "por_category")\n    _eq_filter("m.pj_project_id", "pj_project_id")\n    _eq_filter("m.s_site_id", "s_site_id")\n\n    smp_name = filters.get("smp_name")\n    if smp_name is not None and str(smp_name).strip() != "":\n        v = str(smp_name).replace("\'", "\'\'")\n        where_parts.append(f"m.\\"smp_name\\" = \'{v}\'")\n        if v.strip().upper() == \'NTM\':\n            where_parts.append("m.\\"smp_status\\" = \'Active\'")\n            where_parts.append(\n                "m.\\"ntm_project_type\\" NOT IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\')"\n            )\n\n    where_clause = "WHERE " + " AND ".join(where_parts)\n\n    is_ahlob = bool(smp_name) and ("AHLOB" in str(smp_name).upper())\n\n    # CPO column: AHLOA uses ms_1555_construction_complete_cpo_custom_field (non-empty text);\n    # MACRO uses ms1555_construction_complete_so_header (non-empty text).\n    if is_ahlob:\n        cpo_expr = "COALESCE(TRIM(m.ms_1555_construction_complete_cpo_custom_field::text), \'\') <> \'\'"\n    else:\n        cpo_expr = "COALESCE(TRIM(m.ms1555_construction_complete_so_header::text), \'\') <> \'\'"\n\n    # ---- Gate expression catalog ----\n    # Shared gates (always applicable to whichever branch we\'re in if listed).\n    gate_exprs = {\n        # Existing shared gates (retained)\n        "ran_entitlement_met":    "m.pj_a_3710_ran_entitlement_complete_finish IS NOT NULL",\n        "bom_aims_met":           "m.pj_a_3875_bom_received_bom_in_aims_finish IS NOT NULL",\n        "bom_bat_met":            "m.pj_a_3850_bom_submitted_bom_in_bat_finish IS NOT NULL",\n        "ntp_submitted_met":      "m.pj_a_4075_construction_ntp_submitted_to_gc_finish IS NOT NULL",\n        "ntp_accepted_met":       "m.pj_a_4100_construction_ntp_accepted_by_gc_finish IS NOT NULL",\n        "site_access_met":        "m.s_24x7_site_access IS NOT NULL",                  # existing extra (kept)\n        "cpo_met":                cpo_expr,\n        "spo_met":                "m.ms1555_construction_complete_spo_issued_date IS NOT NULL",  # client column\n        "material_pickup_met":    "m.pj_a_3925_msl_pickup_date_finish IS NOT NULL",\n        # Newly added gates from client (universal across both branches)\n        "ll_ntp_received_met":    "COALESCE(TRIM(m.pj_a_4000_ll_ntp_received::text), \'\') <> \'\'",\n    }\n\n    needs_nas_join = False\n\n    if is_ahlob:\n        # AHLOB-only client gates added (from the 12-gate AHLOA list)\n        gate_exprs["scoping_pkg_create_met"]      = "m.scoping_package_create_date IS NOT NULL"\n        gate_exprs["punch_checklist_submitted_met"] = "m.ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl IS NOT NULL"\n        gate_exprs["crane_decision_met"]          = "m.scoping_package_crane_required IN (\'Yes\', \'No\')"\n        gate_exprs["nas_outage_upload_met"]       = "nas.nas_activity_end_date IS NOT NULL"\n        needs_nas_join = True\n    else:\n        # NTM/default-only client gates added (from the 14-gate MACRO list)\n        gate_exprs["pre_con_package_met"]         = "m.ms_1310_pre_construction_package_received_actual IS NOT NULL"\n        gate_exprs["site_walk_or_drone_met"]      = (\n            "(m.ms_1316_pre_con_site_walk_completed_actual IS NOT NULL "\n            "OR m.ms_1321_talon_view_drone_svcs_actual IS NOT NULL)"\n        )\n        gate_exprs["ready_for_scoping_met"]       = "m.ms_1323_ready_for_scoping_actual IS NOT NULL"\n        gate_exprs["scoping_quoting_validated_met"] = "m.ms_1327_scoping_and_quoting_package_validated_actual IS NOT NULL"\n        gate_exprs["steel_received_met"]          = (\n            "(COALESCE(TRIM(m.pj_steel_received_status), \'\') IN (\'N\', \'Not Applicable\', \'\') "\n            "OR (TRIM(m.pj_steel_received_status) = \'A\' AND m.pj_steel_received_date IS NOT NULL))"\n        )\n        gate_exprs["scoping_pkg_submitted_met"]   = "m.ms_1331_scoping_package_submitted_actual IS NOT NULL"\n        gate_exprs["tower_ntp_validated_met"]     = "m.ms_1407_tower_ntp_validated_actual IS NOT NULL"\n        # Existing NTM-only extras (kept)\n        gate_exprs["precon_walk_met"]             = "m.pj_a_3825_pre_construction_walk_complete_finish IS NOT NULL"\n        gate_exprs["power_ready_met"]             = "m.pj_a_4525_power_ready_finish IS NOT NULL"\n        gate_exprs["backhaul_ready_met"]          = (\n            "(m.pj_a_4425_mw_installation_complete_finish IS NOT NULL "\n            "OR m.pj_a_4925_aav_fiber_ready_finish IS NOT NULL)"\n        )\n\n    # ---- Build all-gates predicate for numerator ----\n    all_gates_pred = "(" + " AND ".join(f"({expr})" for expr in gate_exprs.values()) + ")"\n\n    group_dims = ["rgn_region", "m_area", "m_market", "construction_gc"]\n    group_by = ", ".join(f"m.{d}" for d in group_dims)\n    select_dims = ", ".join(f"m.{d}" for d in group_dims)\n\n    denominator_expr = "COUNT(DISTINCT m.pj_project_id)"\n    numerator_expr = f"COUNT(DISTINCT CASE WHEN {all_gates_pred} THEN m.pj_project_id END)"\n\n    # ---- Per-gate distinct-project counts (returned regardless of branch) ----\n    ordered_gate_cols = [\n        # Shared/legacy\n        "ran_entitlement_met",\n        "bom_aims_met",\n        "bom_bat_met",\n        "ntp_submitted_met",\n        "ntp_accepted_met",\n        "site_access_met",\n        "cpo_met",\n        "spo_met",\n        "material_pickup_met",\n        "ll_ntp_received_met",\n        # AHLOB-only client gates\n        "scoping_pkg_create_met",\n        "punch_checklist_submitted_met",\n        "crane_decision_met",\n        "nas_outage_upload_met",\n        # NTM-only client gates + legacy extras\n        "pre_con_package_met",\n        "site_walk_or_drone_met",\n        "ready_for_scoping_met",\n        "scoping_quoting_validated_met",\n        "steel_received_met",\n        "scoping_pkg_submitted_met",\n        "tower_ntp_validated_met",\n        "precon_walk_met",\n        "power_ready_met",\n        "backhaul_ready_met",\n    ]\n\n    per_gate_selects = []\n    for col in ordered_gate_cols:\n        if col in gate_exprs:\n            expr = gate_exprs[col]\n            per_gate_selects.append(\n                f"COUNT(DISTINCT CASE WHEN {expr} THEN m.pj_project_id END) AS {col}"\n            )\n        else:\n            per_gate_selects.append(f"NULL::bigint AS {col}")\n    per_gate_sql = ",\\n            ".join(per_gate_selects)\n\n    join_sql = ""\n    if needs_nas_join:\n        join_sql = (\n            "LEFT JOIN ("\n            "SELECT nas_site_id, MAX(nas_activity_end_date) AS nas_activity_end_date "\n            "FROM pwc_macro_staging_schema.stg_nas_planned_outage_activity "\n            "WHERE nas_project_category = \'AHLOB\' "\n            "GROUP BY nas_site_id"\n            ") nas ON nas.nas_site_id = m.s_site_id"\n        )\n\n    sql = f"""\n        SELECT\n            {select_dims},\n            {denominator_expr} AS denominator_count,\n            {numerator_expr} AS numerator_count,\n            ({denominator_expr} - {numerator_expr}) AS pending_prereq_count,\n            100.0 * {numerator_expr} / NULLIF({denominator_expr}, 0) AS prereq_readiness_pct,\n            {per_gate_sql}\n        FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined m\n        {join_sql}\n        {where_clause}\n        GROUP BY {group_by}\n        HAVING {denominator_expr} > 0\n        ORDER BY {group_by}\n    """.strip()\n\n    rows = execute_query(sql)\n\n    out = []\n    for r in rows:\n        rec = {k: r.get(k) for k in group_dims}\n        rec["denominator_count"] = r.get("denominator_count")\n        rec["numerator_count"] = r.get("numerator_count")\n        rec["pending_prereq_count"] = r.get("pending_prereq_count")\n        rec["prereq_readiness_pct"] = r.get("prereq_readiness_pct")\n        for col in ordered_gate_cols:\n            rec[col] = r.get(col)\n        out.append(rec)\n    return out\n', kpi_source_columns: ['rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 'pj_project_id', 's_site_id', 'pj_project_status', 'ms_1550_construction_start_actual', 'smp_name', 'smp_status', 'ntm_project_type', 'pj_a_3710_ran_entitlement_complete_finish', 'pj_a_3875_bom_received_bom_in_aims_finish', 'pj_a_3850_bom_submitted_bom_in_bat_finish', 'pj_a_4075_construction_ntp_submitted_to_gc_finish', 'pj_a_4100_construction_ntp_accepted_by_gc_finish', 's_24x7_site_access', 'ms_1555_construction_complete_cpo_custom_field', 'ms1555_construction_complete_so_header', 'ms1555_construction_complete_spo_issued_date', 'pj_a_3925_msl_pickup_date_finish', 'pj_a_4000_ll_ntp_received', 'scoping_package_create_date', 'ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl', 'scoping_package_crane_required', 'ms_1310_pre_construction_package_received_actual', 'ms_1316_pre_con_site_walk_completed_actual', 'ms_1321_talon_view_drone_svcs_actual', 'ms_1323_ready_for_scoping_actual', 'ms_1327_scoping_and_quoting_package_validated_actual', 'pj_steel_received_status', 'pj_steel_received_date', 'ms_1331_scoping_package_submitted_actual', 'ms_1407_tower_ntp_validated_actual', 'pj_a_3825_pre_construction_walk_complete_finish', 'pj_a_4525_power_ready_finish', 'pj_a_4425_mw_installation_complete_finish', 'pj_a_4925_aav_fiber_ready_finish', 'nas_site_id', 'nas_activity_end_date', 'nas_project_category'], session_id: '69a3d22f26e208edc083a06e', label: 'Prereq Readiness Rate', kpi_related_core_node_ids: ['project'], kpi_relationship_type: 'DERIVED_FROM', kpi_kpi_id: 'dcf98a0e-2891-47a3-a258-ebea62201ba4', entity_type: 'kpi', kpi_name: 'Prereq Readiness Rate', name: 'dcf98a0e-2891-47a3-a258-ebea62201ba4', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Prereq Readiness Rate (%) for CX Start = 100.0 * Numerator / NULLIF(Denominator, 0), grouped by (rgn_region, m_area, m_market, construction_gc), suppressing groups where Denominator=0 via HAVING. Denominator = COUNT(DISTINCT pj_project_id) of rows where pj_project_status != \'Dead\' AND ms_1550_construction_start_actual IS NULL (CX not started). Numerator = COUNT(DISTINCT pj_project_id) within Denominator where ALL program-specific prerequisite gates are met. Gate set is branched by smp_name: smp_name containing \'AHLOB\' (case-insensitive) applies the client\'s AHLOA-B set (10 shared gates + 4 AHLOB-only: scoping_package_create_date, ms_1557 punch checklist, scoping_package_crane_required IN (\'Yes\',\'No\'), NAS planned-outage upload via LEFT JOIN to stg_nas_planned_outage_activity filtered category=\'AHLOB\'); else (NTM/default) applies the client\'s MACRO set plus retained legacy extras (pre-con walk pj_a_3825, power pj_a_4525, backhaul pj_a_4425/4925). CPO column is selected per program: ms_1555_construction_complete_cpo_custom_field for AHLOA, ms1555_construction_complete_so_header for MACRO. SPO is the client-aligned column ms1555_construction_complete_spo_issued_date for both programs. Per-gate distinct project counts are returned for every gate name; program-inapplicable gate counts are returned as NULL. Source: pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined (m) LEFT JOIN stg_nas_planned_outage_activity (nas, AHLOB-only).', status: 'mentioned', node_id: 'dcf98a0e-2891-47a3-a258-ebea62201ba4'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_nas_e911_readiness_riot_validation'], nl_business_rule: '', kpi_formula_description: 'E911 FTR Rate = (count of distinct sites whose FIRST (earliest) E911 RIOT validation record is PASS/PASS) / (count of distinct sites with ANY E911 RIOT validation attempt). Source of truth is stg_nas_e911_readiness_riot_validation. Attempted sites are those with nas_e911_validation_date IS NOT NULL. First-time-right pass requires nas_validate_e911_readiness = \'PASS\' AND nas_consolidation_check_all_layers = \'PASS\' on the earliest (MIN) nas_e911_validation_date per site. Optional filters: start_date/end_date and site_id are applied in SQL; m_market, rgn_region, and m_area are applied via site enrichment (site) to restrict eligible nas_site_id values, then the SQL is rerun constrained to those sites.', kpi_output_schema: '[{"column": "kpi_name", "type": "string", "description": "KPI label."}, {"column": "attempted_sites", "type": "integer", "description": "Distinct sites with an E911 validation attempt (any E911-related NAS event in the filter window)."}, {"column": "first_time_right_pass_sites", "type": "integer", "description": "Distinct sites whose first observed E911 outcome event is a pass."}, {"column": "e911_ftr_rate", "type": "float", "description": "first_time_right_pass_sites / attempted_sites; null if attempted_sites is 0."}, {"column": "start_date", "type": "string", "description": "Echo of the applied start_date filter."}, {"column": "end_date", "type": "string", "description": "Echo of the applied end_date filter."}, {"column": "site_id", "type": "string", "description": "Echo of the applied site_id filter."}, {"column": "m_market", "type": "string", "description": "Echo of the applied market filter."}, {"column": "rgn_region", "type": "string", "description": "Echo of the applied region filter."}]', kpi_business_logic: '1) Read filters: start_date, end_date, site_id, m_market, rgn_region, m_area.\n2) Query stg_nas_e911_readiness_riot_validation to compute attempted_sites and first_time_right_pass_sites by: (a) building a subquery that finds MIN(nas_e911_validation_date) per nas_site_id where nas_e911_validation_date IS NOT NULL, (b) joining back to the table on nas_site_id and that first_validation_date, (c) counting distinct nas_site_id for denominator, and counting distinct nas_site_id meeting PASS/PASS criteria for numerator.\n3) If any of m_market/rgn_region/m_area are provided, load site dimension via get_site(), filter sites to those matching the provided dimension values, rerun the same SQL with an added constraint v.nas_site_id IN (eligible_site_ids).\n4) Compute e911_ftr_rate = first_time_right_pass_sites / attempted_sites (None if denominator is 0).\n5) Return a single-row result with counts, rate, and the provided filter values.', kpi_filters: '[{"name": "start_date", "type": "string", "description": ""}, {"name": "end_date", "type": "string", "description": ""}, {"name": "site_id", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "market", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "region", "type": "string", "description": ""}, {"name": "rgn_region", "type": "string", "description": ""}, {"name": "area", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_e911_ftr_rate", "node_type": "kpi", "node_id": "a90dec51-0e24-4d89-9c5e-e153d3cbea93", "node_label": "E911 FTR Rate", "description": "Measures the share of sites that pass E911 validation on the first attempt out of all sites where E911 validation has been attempted. This KPI distinguishes clean executions from passes achieved only after rework, helping prioritize corrective actions, highlight recurring readiness issues by market/region/vendor, and reduce cycle-time impacts caused by repeated E911 validation failures. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').", "parameters": [{"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}, {"name": "site_id", "type": "string", "description": "Filter by site id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}, {"name": "market", "type": "string", "description": "Filter by market", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "region", "type": "string", "description": "Filter by region", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "area", "type": "string", "description": "Filter by area", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}], "output_columns": [{"name": "kpi_name", "type": "string", "nullable": false}, {"name": "attempted_sites", "type": "number", "nullable": false}, {"name": "first_time_right_pass_sites", "type": "number", "nullable": false}, {"name": "e911_ftr_rate", "type": "number", "nullable": false}, {"name": "start_date", "type": "null", "nullable": true}, {"name": "end_date", "type": "null", "nullable": true}, {"name": "site_id", "type": "null", "nullable": true}, {"name": "m_market", "type": "null", "nullable": true}, {"name": "m_area", "type": "null", "nullable": true}, {"name": "rgn_region", "type": "null", "nullable": true}], "sample_output": [], "row_count": 1}', nl_description: 'E911 FTR Rate = (count of distinct sites whose FIRST (earliest) E911 RIOT validation record is PASS/PASS) / (count of distinct sites with ANY E911 RIOT validation attempt). Source of truth is stg_nas_e911_readiness_riot_validation. Attempted sites are those with nas_e911_validation_date IS NOT NULL. First-time-right pass requires nas_validate_e911_readiness = \'PASS\' AND nas_consolidation_check_all_layers = \'PASS\' on the earliest (MIN) nas_e911_validation_date per site. Optional filters: start_date/end_date and site_id are applied in SQL; m_market, rgn_region, and m_area are applied via site enrichment (site) to restrict eligible nas_site_id values, then the SQL is rerun constrained to those sites.', node_type: 'CORE', definition: 'E911 FTR Rate = (count of distinct sites whose FIRST (earliest) E911 RIOT validation record is PASS/PASS) / (count of distinct sites with ANY E911 RIOT validation attempt). Source of truth is stg_nas_e911_readiness_riot_validation. Attempted sites are those with nas_e911_validation_date IS NOT NULL. First-time-right pass requires nas_validate_e911_readiness = \'PASS\' AND nas_consolidation_check_all_layers = \'PASS\' on the earliest (MIN) nas_e911_validation_date per site. Optional filters: start_date/end_date and site_id are applied in SQL; m_market, rgn_region, and m_area are applied via site enrichment (site) to restrict eligible nas_site_id values, then the SQL is rerun constrained to those sites.', kpi_python_function: 'def get_e911_ftr_rate(execute_query, filters=None) -> list[dict]:\n    """E911 FTR Rate computed from RIOT validation table.\n\n    Mirrors the corrected E911 Readiness Rate pattern, except:\n      - uses MIN(nas_e911_validation_date) (first attempt) instead of MAX(...) (latest)\n\n    Numerator: distinct sites whose first validation is PASS/PASS.\n    Denominator: distinct sites with any validation attempt (nas_e911_validation_date IS NOT NULL).\n    """\n\n    filters = filters or {}\n\n    start_date = filters.get("start_date")\n    end_date = filters.get("end_date")\n\n    f_site_id = filters.get("site_id") or filters.get("s_site_id")\n    f_market = filters.get("market") or filters.get("m_market")\n    f_region = filters.get("region") or filters.get("rgn_region")\n    f_area = filters.get("area") or filters.get("m_area")\n\n    # Optional enrichment (same approach as prior version)\n    sites = get_site(execute_query, filters=None) or []\n\n    def _to_lower(v):\n        return (str(v).strip().lower()) if v is not None else ""\n\n    site_dim = {}\n    for s in sites:\n        sc = s.get("site_code")\n        if sc:\n            site_dim[sc] = {\n                "rgn_region": s.get("rgn_region"),\n                "m_area": s.get("m_area"),\n                "m_market": s.get("m_market"),\n                "s_state": s.get("s_state"),\n                "s_city": s.get("s_city"),\n            }\n\n    # Build SQL (Tier 2) because RIOT validation table is the required source\n    # Pattern: CTE-free subquery selecting MIN(date) per site, then join back to evaluate pass criteria on that first record.\n    where = ["v.nas_e911_validation_date IS NOT NULL"]\n\n    if start_date:\n        where.append(f"v.nas_e911_validation_date >= \'{str(start_date)}\'")\n    if end_date:\n        where.append(f"v.nas_e911_validation_date <= \'{str(end_date)}\'")\n\n    if f_site_id:\n        # Assumes site identifier column on the table is nas_site_id (aligned with prior KPI usage patterns)\n        where.append(f"v.nas_site_id = \'{str(f_site_id)}\'")\n\n    where_sql = " AND ".join(where)\n\n    sql = f"""\n    SELECT\n      COUNT(DISTINCT v.nas_site_id) AS attempted_sites,\n      COUNT(DISTINCT CASE\n        WHEN v.nas_validate_e911_readiness = \'PASS\'\n         AND v.nas_consolidation_check_all_layers = \'PASS\'\n        THEN v.nas_site_id END) AS first_time_right_pass_sites\n    FROM stg_nas_e911_readiness_riot_validation v\n    INNER JOIN (\n      SELECT\n        nas_site_id,\n        MIN(nas_e911_validation_date) AS first_validation_date\n      FROM stg_nas_e911_readiness_riot_validation\n      WHERE nas_e911_validation_date IS NOT NULL\n      GROUP BY nas_site_id\n    ) first_v\n      ON first_v.nas_site_id = v.nas_site_id\n     AND first_v.first_validation_date = v.nas_e911_validation_date\n    WHERE {where_sql}\n    """\n\n    rows = execute_query(sql) or []\n    r0 = rows[0] if rows else {}\n\n    attempted = r0.get("attempted_sites")\n    ftr_pass = r0.get("first_time_right_pass_sites")\n\n    try:\n        denom = int(attempted) if attempted is not None else 0\n    except Exception:\n        denom = 0\n\n    try:\n        numer = int(ftr_pass) if ftr_pass is not None else 0\n    except Exception:\n        numer = 0\n\n    rate = (float(numer) / float(denom)) if denom else None\n\n    # Apply optional dimension filters that depend on site enrichment (market/region/area)\n    # We do this post-query by restricting the *reported* population to only matching sites.\n    # To keep the SQL pattern identical to readiness rate (per your instruction), we avoid adding joins/CTEs here.\n    # If market/region/area filters are provided, we recompute counts by enumerating eligible sites and re-running a constrained query.\n\n    if f_market or f_region or f_area:\n        eligible_sites = []\n        for sc, dim in site_dim.items():\n            if f_market:\n                if dim.get("m_market") is None or _to_lower(dim.get("m_market")) != _to_lower(f_market):\n                    continue\n            if f_region:\n                if dim.get("rgn_region") is None or _to_lower(dim.get("rgn_region")) != _to_lower(f_region):\n                    continue\n            if f_area and dim.get("m_area") != f_area:\n                continue\n            eligible_sites.append(sc)\n\n        # If filters eliminate everything, return zeros.\n        if not eligible_sites:\n            denom = 0\n            numer = 0\n            rate = None\n        else:\n            # Re-run with site IN (...) constraint.\n            # Note: chunking omitted for brevity; add if IN list can be large.\n            in_list = ",".join([f"\'{str(x)}\'" for x in eligible_sites])\n            where2 = ["v.nas_e911_validation_date IS NOT NULL", f"v.nas_site_id IN ({in_list})"]\n            if start_date:\n                where2.append(f"v.nas_e911_validation_date >= \'{str(start_date)}\'")\n            if end_date:\n                where2.append(f"v.nas_e911_validation_date <= \'{str(end_date)}\'")\n            if f_site_id:\n                where2.append(f"v.nas_site_id = \'{str(f_site_id)}\'")\n            where2_sql = " AND ".join(where2)\n\n            sql2 = f"""\n            SELECT\n              COUNT(DISTINCT v.nas_site_id) AS attempted_sites,\n              COUNT(DISTINCT CASE\n                WHEN v.nas_validate_e911_readiness = \'PASS\'\n                 AND v.nas_consolidation_check_all_layers = \'PASS\'\n                THEN v.nas_site_id END) AS first_time_right_pass_sites\n            FROM stg_nas_e911_readiness_riot_validation v\n            INNER JOIN (\n              SELECT\n                nas_site_id,\n                MIN(nas_e911_validation_date) AS first_validation_date\n              FROM stg_nas_e911_readiness_riot_validation\n              WHERE nas_e911_validation_date IS NOT NULL\n              GROUP BY nas_site_id\n            ) first_v\n              ON first_v.nas_site_id = v.nas_site_id\n             AND first_v.first_validation_date = v.nas_e911_validation_date\n            WHERE {where2_sql}\n            """\n\n            rows2 = execute_query(sql2) or []\n            rr = rows2[0] if rows2 else {}\n\n            try:\n                denom = int(rr.get("attempted_sites")) if rr.get("attempted_sites") is not None else 0\n            except Exception:\n                denom = 0\n            try:\n                numer = int(rr.get("first_time_right_pass_sites")) if rr.get("first_time_right_pass_sites") is not None else 0\n            except Exception:\n                numer = 0\n            rate = (float(numer) / float(denom)) if denom else None\n\n    out = {\n        "kpi_name": "E911 FTR Rate",\n        "attempted_sites": denom,\n        "first_time_right_pass_sites": numer,\n        "e911_ftr_rate": rate,\n        "start_date": start_date,\n        "end_date": end_date,\n        "site_id": f_site_id,\n        "m_market": f_market,\n        "m_area": f_area,\n        "rgn_region": f_region,\n    }\n\n    return [out]\n', kpi_source_columns: ['nas_site_id', 'nas_e911_validation_date', 'nas_validate_e911_readiness', 'nas_consolidation_check_all_layers'], session_id: '69a3d22f26e208edc083a06e', label: 'E911 FTR Rate', kpi_related_core_node_ids: ['stg_nas_e911_readiness_riot_validation', 'site', 'market', 'project', 'milestone', 'integration_activity', 'person'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'a90dec51-0e24-4d89-9c5e-e153d3cbea93', entity_type: 'kpi', kpi_name: 'E911 FTR Rate', name: 'a90dec51-0e24-4d89-9c5e-e153d3cbea93', kpi_dimensions: ['m_market', 'm_area', 'rgn_region'], kpi_description: 'Measures the share of sites that pass E911 validation on the first attempt out of all sites where E911 validation has been attempted. This KPI distinguishes clean executions from passes achieved only after rework, helping prioritize corrective actions, highlight recurring readiness issues by market/region/vendor, and reduce cycle-time impacts caused by repeated E911 validation failures. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: 'a90dec51-0e24-4d89-9c5e-e153d3cbea93'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Swap Completion Rate = 100 * (distinct pj_project_id with pj_a_5175_construction_complete_finish not null and (optionally) within a provided start_date/end_date window) / (distinct pj_project_id in the POR population, excluding pj_project_status = \'Dead\'), grouped by rgn_region, m_area, m_market, and construction_gc. Also returns counts for completed, planned-not-complete (BOM submitted but not complete), and pending (no BOM submitted and not complete). Date filters apply only to the completed numerator and are guarded by validating pj_a_5175_construction_complete_finish text before casting to date. The smp_name filter is direct equality; if smp_name equals \'NTM\' (case-insensitive), additionally require smp_status = \'Active\' and exclude specific ntm_project_type values.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping."}, {"column": "m_area", "type": "string", "description": "Area grouping."}, {"column": "m_market", "type": "string", "description": "Market grouping."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping."}, {"column": "total_por_sites", "type": "integer", "description": "Total distinct projects in scope (POR), excluding Dead."}, {"column": "swap_completed_count", "type": "integer", "description": "Distinct projects with pj_a_5175_construction_complete_finish not null (optionally date-scoped)."}, {"column": "swap_planned_not_complete_count", "type": "integer", "description": "Distinct projects with BOM submitted not null and construction complete null."}, {"column": "swap_pending_count", "type": "integer", "description": "Distinct projects with neither BOM submitted nor construction complete."}, {"column": "swap_completion_rate_pct", "type": "float", "description": "Completion rate percent = 100 * swap_completed_count / total_por_sites."}]', kpi_business_logic: 'Start from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined and exclude records where COALESCE(pj_project_status,\'\') = \'Dead\'.\nApply optional equality filters: rgn_region, m_area, m_market, construction_gc, por_category, pj_project_id, s_site_id.\nApply smp_name filter as "smp_name" = <value>; if the provided smp_name value uppercased is \'NTM\', additionally filter to "smp_status" = \'Active\' and "ntm_project_type" NOT IN (\'E2E06 - NSD Cx Mgmt\',\'E2E07 - OL/MOD Cx Mgmt\').\nDefine completed_condition as pj_a_5175_construction_complete_finish IS NOT NULL plus optional start_date/end_date constraints. Each date constraint first checks LENGTH(pj_a_5175_construction_complete_finish::text) >= 10 and SUBSTRING(...,1,1) between \'0\' and \'9\' before casting pj_a_5175_construction_complete_finish::date for comparison.\nAggregate by rgn_region, m_area, m_market, construction_gc and compute: total_por_sites = COUNT(DISTINCT pj_project_id).\nCompute swap_completed_count = COUNT(DISTINCT pj_project_id) where completed_condition is true.\nCompute swap_planned_not_complete_count = COUNT(DISTINCT pj_project_id) where pj_a_3850_bom_submitted_bom_in_bat_finish IS NOT NULL and pj_a_5175_construction_complete_finish IS NULL.\nCompute swap_pending_count = COUNT(DISTINCT pj_project_id) where pj_a_3850_bom_submitted_bom_in_bat_finish IS NULL and pj_a_5175_construction_complete_finish IS NULL.\nCompute swap_completion_rate_pct = 100.0 * swap_completed_count / NULLIF(total_por_sites, 0).', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": ""}, {"name": "m_area", "type": "string", "description": ""}, {"name": "m_market", "type": "string", "description": ""}, {"name": "construction_gc", "type": "string", "description": ""}, {"name": "por_category", "type": "string", "description": ""}, {"name": "pj_project_id", "type": "string", "description": ""}, {"name": "s_site_id", "type": "string", "description": ""}, {"name": "smp_name", "type": "string", "description": ""}, {"name": "start_date", "type": "string", "description": ""}, {"name": "end_date", "type": "string", "description": ""}]', kpi_contract: '{"function_name": "get_swap_completion_rate", "node_type": "kpi", "node_id": "74904211-c4aa-48c0-a998-aaf0ab9d58cb", "node_label": "Swap Completion Rate", "description": "Tracks swap execution progress across the POR by counting total distinct projects in scope and categorizing them into swap-completed (pj_a_5175_construction_complete_finish is not null), planned-but-not-complete (BOM submitted via pj_a_3850_bom_submitted_bom_in_bat_finish is not null AND construction complete is null), and pending (neither BOM submitted nor construction complete). Reports completion rate as 100 * completed / total POR. Grouped by rgn_region, m_area, m_market, and construction_gc, with optional filters for geography, GC, por_category, project/site identifiers, smp_name, and an optional date range that restricts only which completions are counted.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "total_por_sites", "type": "number", "nullable": false}, {"name": "swap_completed_count", "type": "number", "nullable": false}, {"name": "swap_planned_not_complete_count", "type": "number", "nullable": false}, {"name": "swap_pending_count", "type": "number", "nullable": false}, {"name": "swap_completion_rate_pct", "type": "string", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Swap Completion Rate = 100 * (distinct pj_project_id with pj_a_5175_construction_complete_finish not null and (optionally) within a provided start_date/end_date window) / (distinct pj_project_id in the POR population, excluding pj_project_status = \'Dead\'), grouped by rgn_region, m_area, m_market, and construction_gc. Also returns counts for completed, planned-not-complete (BOM submitted but not complete), and pending (no BOM submitted and not complete). Date filters apply only to the completed numerator and are guarded by validating pj_a_5175_construction_complete_finish text before casting to date. The smp_name filter is direct equality; if smp_name equals \'NTM\' (case-insensitive), additionally require smp_status = \'Active\' and exclude specific ntm_project_type values.', node_type: 'CORE', definition: 'Swap Completion Rate = 100 * (distinct pj_project_id with pj_a_5175_construction_complete_finish not null and (optionally) within a provided start_date/end_date window) / (distinct pj_project_id in the POR population, excluding pj_project_status = \'Dead\'), grouped by rgn_region, m_area, m_market, and construction_gc. Also returns counts for completed, planned-not-complete (BOM submitted but not complete), and pending (no BOM submitted and not complete). Date filters apply only to the completed numerator and are guarded by validating pj_a_5175_construction_complete_finish text before casting to date. The smp_name filter is direct equality; if smp_name equals \'NTM\' (case-insensitive), additionally require smp_status = \'Active\' and exclude specific ntm_project_type values.', kpi_python_function: 'def get_swap_completion_rate(execute_query, filters=None) -> list[dict]:\n    filters = filters or {}\n\n    where_parts = [\n        "1=1",\n        "COALESCE(\\"pj_project_status\\", \'\') <> \'Dead\'"\n    ]\n\n    # Allowlisted equality filters\n    if filters.get("rgn_region"):\n        v = str(filters["rgn_region"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"rgn_region\\" = \'{v}\'")\n\n    if filters.get("m_area"):\n        v = str(filters["m_area"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"m_area\\" = \'{v}\'")\n\n    if filters.get("m_market"):\n        v = str(filters["m_market"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"m_market\\" = \'{v}\'")\n\n    if filters.get("construction_gc"):\n        v = str(filters["construction_gc"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"construction_gc\\" = \'{v}\'")\n\n    if filters.get("por_category"):\n        v = str(filters["por_category"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"por_category\\" = \'{v}\'")\n\n    if filters.get("pj_project_id"):\n        v = str(filters["pj_project_id"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"pj_project_id\\" = \'{v}\'")\n\n    if filters.get("s_site_id"):\n        v = str(filters["s_site_id"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"s_site_id\\" = \'{v}\'")\n\n    # SMP Name filter (standard block)\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"smp_name\\" = \'{v}\'")\n        if v.strip().upper() == \'NTM\':\n            where_parts.append("\\"smp_status\\" = \'Active\'")\n            where_parts.append("\\"ntm_project_type\\" NOT IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\')")\n\n    where_sql = " AND ".join(where_parts)\n\n    # Optional date range: restrict ONLY the completed count (not total POR)\n    completed_date_parts = ["\\"pj_a_5175_construction_complete_finish\\" IS NOT NULL"]\n\n    if filters.get("start_date"):\n        sd = str(filters["start_date"]).strip().replace("\'", "\'\'")\n        completed_date_parts.append(\n            f"LENGTH(\\"pj_a_5175_construction_complete_finish\\"::text) >= 10"\n            f" AND SUBSTRING(\\"pj_a_5175_construction_complete_finish\\"::text, 1, 1) BETWEEN \'0\' AND \'9\'"\n            f" AND \\"pj_a_5175_construction_complete_finish\\"::date >= \'{sd}\'::date"\n        )\n\n    if filters.get("end_date"):\n        ed = str(filters["end_date"]).strip().replace("\'", "\'\'")\n        completed_date_parts.append(\n            f"LENGTH(\\"pj_a_5175_construction_complete_finish\\"::text) >= 10"\n            f" AND SUBSTRING(\\"pj_a_5175_construction_complete_finish\\"::text, 1, 1) BETWEEN \'0\' AND \'9\'"\n            f" AND \\"pj_a_5175_construction_complete_finish\\"::date <= \'{ed}\'::date"\n        )\n\n    completed_condition = " AND ".join(completed_date_parts)\n\n    sql = f"""\n    SELECT\n      \\"rgn_region\\" AS \\"rgn_region\\",\n      \\"m_area\\" AS \\"m_area\\",\n      \\"m_market\\" AS \\"m_market\\",\n      \\"construction_gc\\" AS \\"construction_gc\\",\n      COUNT(DISTINCT \\"pj_project_id\\") AS \\"total_por_sites\\",\n      COUNT(DISTINCT CASE\n        WHEN {completed_condition}\n        THEN \\"pj_project_id\\" END) AS \\"swap_completed_count\\",\n      COUNT(DISTINCT CASE\n        WHEN \\"pj_a_3850_bom_submitted_bom_in_bat_finish\\" IS NOT NULL\n         AND \\"pj_a_5175_construction_complete_finish\\" IS NULL\n        THEN \\"pj_project_id\\" END) AS \\"swap_planned_not_complete_count\\",\n      COUNT(DISTINCT CASE\n        WHEN \\"pj_a_3850_bom_submitted_bom_in_bat_finish\\" IS NULL\n         AND \\"pj_a_5175_construction_complete_finish\\" IS NULL\n        THEN \\"pj_project_id\\" END) AS \\"swap_pending_count\\",\n      100.0 * COUNT(DISTINCT CASE\n        WHEN {completed_condition}\n        THEN \\"pj_project_id\\" END)\n        / NULLIF(COUNT(DISTINCT \\"pj_project_id\\"), 0) AS \\"swap_completion_rate_pct\\"\n    FROM \\"pwc_macro_staging_schema\\".\\"stg_ndpd_mbt_tmobile_macro_combined\\"\n    WHERE {where_sql}\n    GROUP BY\n      \\"rgn_region\\", \\"m_area\\", \\"m_market\\", \\"construction_gc\\"\n    ORDER BY\n      \\"rgn_region\\", \\"m_area\\", \\"m_market\\", \\"construction_gc\\";\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_status', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'pj_project_id', 'por_category', 's_site_id', 'smp_name', 'smp_status', 'ntm_project_type', 'pj_a_5175_construction_complete_finish', 'pj_a_3850_bom_submitted_bom_in_bat_finish'], session_id: '69a3d22f26e208edc083a06e', label: 'Swap Completion Rate', kpi_related_core_node_ids: ['project'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '74904211-c4aa-48c0-a998-aaf0ab9d58cb', entity_type: 'kpi', kpi_name: 'Swap Completion Rate', name: '74904211-c4aa-48c0-a998-aaf0ab9d58cb', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Tracks swap execution progress across the POR by counting total distinct projects in scope and categorizing them into swap-completed (pj_a_5175_construction_complete_finish is not null), planned-but-not-complete (BOM submitted via pj_a_3850_bom_submitted_bom_in_bat_finish is not null AND construction complete is null), and pending (neither BOM submitted nor construction complete). Reports completion rate as 100 * completed / total POR. Grouped by rgn_region, m_area, m_market, and construction_gc, with optional filters for geography, GC, por_category, project/site identifiers, smp_name, and an optional date range that restricts only which completions are counted.', status: 'mentioned', node_id: '74904211-c4aa-48c0-a998-aaf0ab9d58cb'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Workfront pipeline funnel: counts distinct entitled projects (pj_a_3710_ran_entitlement_complete_finish IS NOT NULL) at each of 10 sequential milestone stages, using dual milestone systems (Magenta primary, NDPd fallback). For each stage reports reached_X (Magenta stage timestamp is not null OR NDPd stage timestamp is not null) and stuck_at_X (reached stage X but did not reach stage X+1). Stages: precon, material_picked, tower_ntp, civil_start, civil_complete, tower_work_start, tower_work_complete, integration, scop_submission, scop_approval. Civil stages are optional for some projects. Per QB Rows 2, 34, 241.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region dimension (present when grouped by region; included by default when no group_by flags are provided)."}, {"column": "m_area", "type": "string", "description": "Area dimension (present when grouped by area; included by default when no group_by flags are provided)."}, {"column": "m_market", "type": "string", "description": "Market dimension (present when grouped by market; included by default when no group_by flags are provided)."}, {"column": "construction_gc", "type": "string", "description": "General contractor dimension (present when grouped by GC; included by default when no group_by flags are provided)."}, {"column": "entitled_not_built_projects", "type": "integer", "description": "Count of distinct projects entitled (RAN entitlement complete present) but not yet construction complete (construction complete actual is null)."}]', kpi_business_logic: 'Start from pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined.\nSeed WHERE with 1=1 and entitlement-complete population: pj_a_3710_ran_entitlement_complete_finish IS NOT NULL.\nApply allowlisted equality filters: rgn_region, m_area, m_market, construction_gc, por_category, pj_project_id, s_site_id.\nIf smp_name is provided: filter smp_name = value; if smp_name (after strip/upper) equals \'NTM\', additionally require smp_status = \'Active\' and ntm_project_type not in (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\').\nApply optional date range filters (start_date inclusive, end_date exclusive) against pj_a_3710_ran_entitlement_complete_finish::timestamp.\nSelect grouping dimensions based on group_by_* flags; if none provided, default group by rgn_region, m_area, m_market, construction_gc.\nFor each of 10 ordered stages, define reached condition as (Magenta stage column IS NOT NULL OR NDPd stage expression IS NOT NULL). This avoids COALESCE type conflicts since only existence is checked.\nFor scop_submission’s NDPd expression (ms_1557...), apply a LENGTH>=10 and first-character numeric guard; if it fails, treat the NDPd expression as NULL.\nCompute total_entitled as COUNT(DISTINCT pj_project_id).\nFor each stage X: compute reached_X as COUNT(DISTINCT pj_project_id) where reached condition for stage X is true.\nFor each stage X except the last: compute stuck_at_X as COUNT(DISTINCT pj_project_id) where reached condition for stage X is true AND reached condition for stage X+1 is false.\nReturn grouped results ordered by the grouping dimensions.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Exact match filter on rgn_region."}, {"name": "m_area", "type": "string", "description": "Exact match filter on m_area."}, {"name": "m_market", "type": "string", "description": "Exact match filter on m_market."}, {"name": "construction_gc", "type": "string", "description": "Exact match filter on construction_gc."}, {"name": "por_category", "type": "string", "description": "Exact match filter on por_category."}, {"name": "pj_project_id", "type": "string", "description": "Exact match filter on pj_project_id."}, {"name": "s_site_id", "type": "string", "description": "Exact match filter on s_site_id."}, {"name": "smp_name", "type": "string", "description": "Program name filter; when exactly \'NTM\' also applies smp_status/ntm_project_type guardrails."}, {"name": "start_date", "type": "string", "description": "Lower bound (inclusive) on pj_a_3710_ran_entitlement_complete_finish::timestamp."}, {"name": "end_date", "type": "string", "description": "Upper bound (exclusive) on pj_a_3710_ran_entitlement_complete_finish::timestamp."}, {"name": "group_by_region", "type": "string", "description": "If truthy, include rgn_region in GROUP BY/SELECT."}, {"name": "group_by_area", "type": "string", "description": "If truthy, include m_area in GROUP BY/SELECT."}, {"name": "group_by_market", "type": "string", "description": "If truthy, include m_market in GROUP BY/SELECT."}, {"name": "group_by_gc", "type": "string", "description": "If truthy, include construction_gc in GROUP BY/SELECT."}]', kpi_contract: '{"function_name": "get_workfront", "node_type": "kpi", "node_id": "4d3a8f74-eece-46d9-a865-17ce022b210d", "node_label": "Workfront", "description": "Counts sites/projects that have received RAN entitlement but have not yet reached construction completion, highlighting the construction pipeline backlog after entitlement clearance. This helps identify execution bottlenecks and prioritize construction follow-up by region, market, and general contractor. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por category", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj project id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s site id", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp name", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Filter by start date", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Filter by end date", "required": false, "sample_values": []}, {"name": "group_by_region", "type": "string", "description": "Filter by group by region", "required": false, "sample_values": []}, {"name": "group_by_area", "type": "string", "description": "Filter by group by area", "required": false, "sample_values": []}, {"name": "group_by_market", "type": "string", "description": "Filter by group by market", "required": false, "sample_values": []}, {"name": "group_by_gc", "type": "string", "description": "Filter by group by gc", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "total_entitled", "type": "number", "nullable": false}, {"name": "reached_precon", "type": "number", "nullable": false}, {"name": "stuck_at_precon", "type": "number", "nullable": false}, {"name": "reached_material_picked", "type": "number", "nullable": false}, {"name": "stuck_at_material_picked", "type": "number", "nullable": false}, {"name": "reached_tower_ntp", "type": "number", "nullable": false}, {"name": "stuck_at_tower_ntp", "type": "number", "nullable": false}, {"name": "reached_civil_start", "type": "number", "nullable": false}, {"name": "stuck_at_civil_start", "type": "number", "nullable": false}, {"name": "reached_civil_complete", "type": "number", "nullable": false}, {"name": "stuck_at_civil_complete", "type": "number", "nullable": false}, {"name": "reached_tower_work_start", "type": "number", "nullable": false}, {"name": "stuck_at_tower_work_start", "type": "number", "nullable": false}, {"name": "reached_tower_work_complete", "type": "number", "nullable": false}, {"name": "stuck_at_tower_work_complete", "type": "number", "nullable": false}, {"name": "reached_integration", "type": "number", "nullable": false}, {"name": "stuck_at_integration", "type": "number", "nullable": false}, {"name": "reached_scop_submission", "type": "number", "nullable": false}, {"name": "stuck_at_scop_submission", "type": "number", "nullable": false}, {"name": "reached_scop_approval", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Workfront pipeline funnel: counts distinct entitled projects (pj_a_3710_ran_entitlement_complete_finish IS NOT NULL) at each of 10 sequential milestone stages, using dual milestone systems (Magenta primary, NDPd fallback). For each stage reports reached_X (Magenta stage timestamp is not null OR NDPd stage timestamp is not null) and stuck_at_X (reached stage X but did not reach stage X+1). Stages: precon, material_picked, tower_ntp, civil_start, civil_complete, tower_work_start, tower_work_complete, integration, scop_submission, scop_approval. Civil stages are optional for some projects. Per QB Rows 2, 34, 241.', node_type: 'CORE', definition: 'Workfront pipeline funnel: counts distinct entitled projects (pj_a_3710_ran_entitlement_complete_finish IS NOT NULL) at each of 10 sequential milestone stages, using dual milestone systems (Magenta primary, NDPd fallback). For each stage reports reached_X (Magenta stage timestamp is not null OR NDPd stage timestamp is not null) and stuck_at_X (reached stage X but did not reach stage X+1). Stages: precon, material_picked, tower_ntp, civil_start, civil_complete, tower_work_start, tower_work_complete, integration, scop_submission, scop_approval. Civil stages are optional for some projects. Per QB Rows 2, 34, 241.', kpi_python_function: 'def get_workfront_funnel(execute_query, filters=None) -> list[dict]:\n    """Workfront pipeline funnel: reached_X and stuck_at_X counts across 10 sequential stages for entitled projects."""\n\n    # 1) first executable line\n    filters = filters or {}\n\n    stages = [\n        # (stage_name, magenta_col, ndpd_col)\n        ("precon", "pj_a_3800_pre_ntp_issued_finish", "ms_1313_pre_construction_package_validated_actual"),\n        ("material_picked", "pj_a_3925_msl_pickup_date_finish", "ms_1461_pickup_tower_materials_and_validate_actual"),\n        ("tower_ntp", "pj_a_4100_construction_ntp_accepted_by_gc_finish", "ms_1507_tower_ntp_approved_actual"),\n        ("civil_start", "pj_a_4250_civil_construction_start_finish", "ms_1549_civil_construction_start_actual"),\n        ("civil_complete", "pj_a_4750_civil_construction_complete_finish", "ms_1551_civil_construction_complete_actual_date"),\n        ("tower_work_start", "pj_a_4225_construction_start_finish", "ms_1550_construction_start_actual"),\n        ("tower_work_complete", "pj_a_5175_construction_complete_finish", "ms_1555_construction_complete_actual"),\n        ("integration", "pj_a_5275_integration_complete_finish", "ms_1899_all_planned_technologies_integrated_actual"),\n        ("scop_submission", "pj_a_5500_receive_close_out_binder_finish", "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl"),\n        ("scop_approval", "pj_a_5525_approve_close_out_binder_finish", "ms_1559_cop_approved_by_t_mobile_actual"),\n    ]\n\n    # 2) seed WHERE with entitled condition\n    where_parts = [\n        "1=1",\n        \'"pj_a_3710_ran_entitlement_complete_finish" IS NOT NULL\'\n    ]\n\n    # 3) allowlisted equality filters\n    if filters.get("rgn_region"):\n        v = str(filters["rgn_region"]).replace("\'", "\'\'")\n        where_parts.append(f\'"rgn_region" = \\\'{v}\\\'\')\n    if filters.get("m_area"):\n        v = str(filters["m_area"]).replace("\'", "\'\'")\n        where_parts.append(f\'"m_area" = \\\'{v}\\\'\')\n    if filters.get("m_market"):\n        v = str(filters["m_market"]).replace("\'", "\'\'")\n        where_parts.append(f\'"m_market" = \\\'{v}\\\'\')\n    if filters.get("construction_gc"):\n        v = str(filters["construction_gc"]).replace("\'", "\'\'")\n        where_parts.append(f\'"construction_gc" = \\\'{v}\\\'\')\n    if filters.get("por_category"):\n        v = str(filters["por_category"]).replace("\'", "\'\'")\n        where_parts.append(f\'"por_category" = \\\'{v}\\\'\')\n    if filters.get("pj_project_id"):\n        v = str(filters["pj_project_id"]).replace("\'", "\'\'")\n        where_parts.append(f\'"pj_project_id" = \\\'{v}\\\'\')\n    if filters.get("s_site_id"):\n        v = str(filters["s_site_id"]).replace("\'", "\'\'")\n        where_parts.append(f\'"s_site_id" = \\\'{v}\\\'\')\n\n    # 4) smp_name filter with NTM conditional (standard block)\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if v.strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    # 5) date range filters apply to entitlement completion\n    if filters.get("start_date"):\n        start = str(filters["start_date"]).replace("\'", "\'\'")\n        where_parts.append(f\'"pj_a_3710_ran_entitlement_complete_finish"::timestamp >= \\\'{start}\\\'::timestamp\')\n    if filters.get("end_date"):\n        end = str(filters["end_date"]).replace("\'", "\'\'")\n        where_parts.append(f\'"pj_a_3710_ran_entitlement_complete_finish"::timestamp < \\\'{end}\\\'::timestamp\')\n\n    # 6) optional grouping (default all four)\n    group_by = []\n    select_dims = []\n\n    if filters.get("group_by_region"):\n        select_dims.append(\'"rgn_region" AS "rgn_region"\')\n        group_by.append(\'"rgn_region"\')\n    if filters.get("group_by_area"):\n        select_dims.append(\'"m_area" AS "m_area"\')\n        group_by.append(\'"m_area"\')\n    if filters.get("group_by_market"):\n        select_dims.append(\'"m_market" AS "m_market"\')\n        group_by.append(\'"m_market"\')\n    if filters.get("group_by_gc"):\n        select_dims.append(\'"construction_gc" AS "construction_gc"\')\n        group_by.append(\'"construction_gc"\')\n\n    if not group_by:\n        select_dims = [\n            \'"rgn_region" AS "rgn_region"\',\n            \'"m_area" AS "m_area"\',\n            \'"m_market" AS "m_market"\',\n            \'"construction_gc" AS "construction_gc"\'\n        ]\n        group_by = [\'"rgn_region"\', \'"m_area"\', \'"m_market"\', \'"construction_gc"\']\n\n    def _ndpd_expr(col: str) -> str:\n        # 1557 guard: LENGTH + first-char numeric check; no regex\n        if col == "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl":\n            return (\n                \'CASE WHEN LENGTH("ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl"::text) >= 10 \'\n                \'AND SUBSTRING("ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl"::text, 1, 1) BETWEEN \\\'0\\\' AND \\\'9\\\' \'\n                \'THEN "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl" \'\n                \'ELSE NULL END\'\n            )\n        return f\'"{col}"\'\n\n    # 7) single SELECT with dynamic funnel metrics\n    metrics = [\'COUNT(DISTINCT "pj_project_id")::bigint AS "total_entitled"\']\n\n    for i, (stage_name, mag_col, ndpd_col) in enumerate(stages):\n        ndpd_expr = _ndpd_expr(ndpd_col)\n        reached_expr = f\'("{mag_col}" IS NOT NULL OR {ndpd_expr} IS NOT NULL)\'\n\n        # reached_X\n        metrics.append(\n            \'COUNT(DISTINCT CASE WHEN \' + reached_expr + \' THEN "pj_project_id" END)::bigint \'\n            f\'AS "reached_{stage_name}"\'\n        )\n\n        # stuck_at_X (omit for last stage)\n        if i < len(stages) - 1:\n            _, next_mag, next_ndpd = stages[i + 1]\n            next_ndpd_expr = _ndpd_expr(next_ndpd)\n            next_reached_expr = f\'("{next_mag}" IS NOT NULL OR {next_ndpd_expr} IS NOT NULL)\'\n\n            metrics.append(\n                \'COUNT(DISTINCT CASE WHEN \' + reached_expr + \' AND NOT \' + next_reached_expr +\n                \' THEN "pj_project_id" END)::bigint \'\n                f\'AS "stuck_at_{stage_name}"\'\n            )\n\n    select_clause = ",\\n            ".join(select_dims + metrics)\n    group_by_clause = ", ".join(group_by)\n    where_clause = " AND ".join(where_parts)\n\n    sql = f"""\n        SELECT\n            {select_clause}\n        FROM "pwc_macro_staging_schema"."stg_ndpd_mbt_tmobile_macro_combined"\n        WHERE {where_clause}\n        GROUP BY {group_by_clause}\n        ORDER BY {group_by_clause}\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 's_site_id', 'pj_a_3710_ran_entitlement_complete_finish', 'smp_name', 'smp_status', 'ntm_project_type', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 'por_category', 'pj_a_3800_pre_ntp_issued_finish', 'ms_1313_pre_construction_package_validated_actual', 'pj_a_3925_msl_pickup_date_finish', 'ms_1461_pickup_tower_materials_and_validate_actual', 'pj_a_4100_construction_ntp_accepted_by_gc_finish', 'ms_1507_tower_ntp_approved_actual', 'pj_a_4250_civil_construction_start_finish', 'ms_1549_civil_construction_start_actual', 'pj_a_4750_civil_construction_complete_finish', 'ms_1551_civil_construction_complete_actual_date', 'pj_a_4225_construction_start_finish', 'ms_1550_construction_start_actual', 'pj_a_5175_construction_complete_finish', 'ms_1555_construction_complete_actual', 'pj_a_5275_integration_complete_finish', 'ms_1899_all_planned_technologies_integrated_actual', 'pj_a_5500_receive_close_out_binder_finish', 'ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl', 'pj_a_5525_approve_close_out_binder_finish', 'ms_1559_cop_approved_by_t_mobile_actual'], session_id: '69a3d22f26e208edc083a06e', label: 'Workfront', kpi_related_core_node_ids: ['Workfront', 'project', 'permit'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '4d3a8f74-eece-46d9-a865-17ce022b210d', entity_type: 'kpi', kpi_name: 'Workfront', name: '4d3a8f74-eece-46d9-a865-17ce022b210d', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Counts sites/projects that have received RAN entitlement but have not yet reached construction completion, highlighting the construction pipeline backlog after entitlement clearance. This helps identify execution bottlenecks and prioritize construction follow-up by region, market, and general contractor. Optionally filterable by program via smp_name (with NTM-specific constraints when smp_name=\'NTM\').', status: 'mentioned', node_id: '4d3a8f74-eece-46d9-a865-17ce022b210d'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'cx_pending_count = COUNT(DISTINCT pj_project_id) per (rgn_region, m_area, m_market, construction_gc) where construction has STARTED in EITHER source system (pj_a_4225_construction_start_finish IS NOT NULL OR ms_1550_construction_start_actual IS NOT NULL) AND construction is NOT COMPLETE in EITHER source system (pj_a_5175_construction_complete_finish IS NULL AND ms_1555_construction_complete_actual IS NULL); Dead projects (pj_project_status = \'Dead\') are excluded. Aging metrics use COALESCE on the start dates (Magenta preferred, NDPd fallback). Output also includes diagnostic counts of how many projects came from each source system.', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region from macro_combined."}, {"column": "m_area", "type": "string", "description": "Area from macro_combined."}, {"column": "m_market", "type": "string", "description": "Market from macro_combined."}, {"column": "construction_gc", "type": "string", "description": "General contractor from macro_combined."}, {"column": "cx_pending_count", "type": "int", "description": "Distinct pending projects (started in either system, not complete in either)."}, {"column": "avg_days_pending", "type": "float", "description": "Average days since construction start (Magenta preferred, NDPd fallback)."}, {"column": "max_days_pending", "type": "float", "description": "Longest pending project\'s age in days."}, {"column": "started_in_magenta", "type": "int", "description": "Pending projects whose Magenta start (pj_a_4225) is non-null."}, {"column": "started_only_in_ndpd", "type": "int", "description": "Pending projects with only NDPd start (ms_1550) \\u2014 not visible to Magenta-only KPIs."}]', kpi_business_logic: '1) From stg_ndpd_mbt_tmobile_macro_combined, identify pending construction sites: construction STARTED in EITHER Magenta (pj_a_4225_construction_start_finish IS NOT NULL) OR NDPd (ms_1550_construction_start_actual IS NOT NULL); AND NOT YET COMPLETE in EITHER system (both pj_a_5175_construction_complete_finish AND ms_1555_construction_complete_actual IS NULL). 2) Exclude Dead projects: COALESCE(pj_project_status, \'\') <> \'Dead\'. 3) Apply optional equality filters (rgn_region, m_area, m_market, construction_gc, smp_id, smp_name). 4) Group by (rgn_region, m_area, m_market, construction_gc). 5) cx_pending_count = COUNT(DISTINCT pj_project_id) per group. 6) Aging: avg_days_pending and max_days_pending = aggregates of (CURRENT_DATE - COALESCE(magenta_start::date, ndpd_start::date)). 7) Diagnostic split: started_in_magenta = projects whose Magenta start is non-null; started_only_in_ndpd = projects with only NDPd start (extra coverage beyond what Magenta-only KPIs see).', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Equality filter on rgn_region."}, {"name": "m_area", "type": "string", "description": "Equality filter on m_area."}, {"name": "m_market", "type": "string", "description": "Equality filter on m_market."}, {"name": "construction_gc", "type": "string", "description": "Equality filter on construction_gc."}, {"name": "smp_id", "type": "string", "description": "Equality filter on smp_id."}, {"name": "smp_name", "type": "string", "description": "Equality filter on smp_name (e.g., \'NTM\', \'AHLOB Modernization\')."}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Optional filter on the construction-start delay code column. When provided, the query adds: pj_construction_start_delay_code IS NOT NULL AND pj_construction_start_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}, {"name": "pj_construction_complete_delay_code", "type": "string", "description": "Optional filter on the construction-complete delay code column. When provided, the query adds: pj_construction_complete_delay_code IS NOT NULL AND pj_construction_complete_delay_code <> \'No Delay\'. If the value is a specific delay-code label (not a sentinel like \'any\'/\'true\'/\'*\'), also adds equality to that value."}]', kpi_contract: '{"function_name": "get_cx_pending_construction_sites", "node_type": "kpi", "node_id": "6700b7d0-1b20-4540-b4a0-b5cc13540d17", "node_label": "CX Pending Construction Sites", "description": "CX Pending Construction Sites \\u2014 distinct projects where construction has started in EITHER Magenta (pj_a_4225_construction_start_finish) OR NDPd (ms_1550_construction_start_actual) source system, but is NOT YET complete in EITHER (pj_a_5175_construction_complete_finish AND ms_1555_construction_complete_actual both NULL). Excludes Dead projects. Output is grouped by (rgn_region, m_area, m_market, construction_gc) with the pending count, aging metrics (avg/max days since start), and diagnostic split between Magenta-tracked and NDPd-only-tracked starts. Distinct from `CX WIP Delay Code` (which adds a RAN-entitlement gate and breaks down by delay codes) and from `CX to On-Air Backlog` (which counts CX-complete-but-not-On-Air, a different lifecycle stage).", "parameters": [{"name": "rgn_region", "type": "string", "description": "Filter by rgn_region.", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m_area.", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m_market.", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction_gc.", "required": false, "sample_values": []}, {"name": "smp_id", "type": "string", "description": "Filter by smp_id.", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Filter by smp_name.", "required": false, "sample_values": ["NTM", "AHLOB Modernization"]}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Filter to projects with a specific construction-start delay code, or any real start delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}, {"name": "pj_construction_complete_delay_code", "type": "string", "description": "Filter to projects with a specific construction-complete delay code, or any real complete delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": true}, {"name": "m_area", "type": "string", "nullable": true}, {"name": "m_market", "type": "string", "nullable": true}, {"name": "construction_gc", "type": "string", "nullable": true}, {"name": "cx_pending_count", "type": "number", "nullable": false}, {"name": "avg_days_pending", "type": "number", "nullable": true}, {"name": "max_days_pending", "type": "number", "nullable": true}, {"name": "started_in_magenta", "type": "number", "nullable": false}, {"name": "started_only_in_ndpd", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'CX Pending Construction Sites = COUNT(DISTINCT pj_project_id) where construction has started in EITHER Magenta (pj_a_4225_construction_start_finish) OR NDPd (ms_1550_construction_start_actual) source system but is not yet complete in EITHER (both finish columns NULL); excludes Dead projects; grouped by (rgn_region, m_area, m_market, construction_gc) with aging metrics and dual-source diagnostics.', node_type: 'CORE', definition: 'CX Pending Construction Sites = COUNT(DISTINCT pj_project_id) where construction has started in EITHER Magenta (pj_a_4225_construction_start_finish) OR NDPd (ms_1550_construction_start_actual) source system but is not yet complete in EITHER (both finish columns NULL); excludes Dead projects; grouped by (rgn_region, m_area, m_market, construction_gc) with aging metrics and dual-source diagnostics.', kpi_python_function: 'def get_cx_pending_construction_sites(execute_query, filters=None) -> list[dict]:\n    """CX Pending Construction Sites.\n\n    Counts distinct projects where construction has started in EITHER source\n    system (Magenta or NDPd) but is NOT YET complete in EITHER. Returns the\n    pending count plus aging metrics, grouped by\n    (rgn_region, m_area, m_market, construction_gc).\n\n    Source columns (dual-source pattern):\n      - Start  : pj_a_4225_construction_start_finish (Magenta)\n                 OR ms_1550_construction_start_actual (NDPd)\n      - Finish : pj_a_5175_construction_complete_finish (Magenta)\n                 AND ms_1555_construction_complete_actual (NDPd) BOTH NULL = pending\n\n    Output columns:\n      - cx_pending_count        : COUNT(DISTINCT pj_project_id) of pending projects\n      - avg_days_pending        : average days since construction start (Magenta preferred, NDPd fallback)\n      - max_days_pending        : longest pending project\'s age in days\n      - started_in_magenta      : distinct pending projects whose Magenta start is non-null\n      - started_only_in_ndpd    : distinct pending projects with only NDPd start (not Magenta)\n\n    Optional filters (all equality, all optional): rgn_region, m_area, m_market,\n    construction_gc, smp_id, smp_name. Excludes Dead projects by default.\n    """\n    filters = filters or {}\n\n    where_parts = [\n        "1=1",\n        "COALESCE(\\"pj_project_status\\", \'\') <> \'Dead\'",\n        "(\\"pj_a_4225_construction_start_finish\\" IS NOT NULL OR \\"ms_1550_construction_start_actual\\" IS NOT NULL)",\n        "\\"pj_a_5175_construction_complete_finish\\" IS NULL",\n        "\\"ms_1555_construction_complete_actual\\" IS NULL",\n    ]\n\n    if filters.get("rgn_region"):\n        v = str(filters["rgn_region"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"rgn_region\\" = \'{v}\'")\n    if filters.get("m_area"):\n        v = str(filters["m_area"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"m_area\\" = \'{v}\'")\n    if filters.get("m_market"):\n        v = str(filters["m_market"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"m_market\\" = \'{v}\'")\n    if filters.get("construction_gc"):\n        v = str(filters["construction_gc"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"construction_gc\\" = \'{v}\'")\n    if filters.get("smp_id"):\n        v = str(filters["smp_id"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"smp_id\\" = \'{v}\'")\n    if filters.get("smp_name"):\n        v = str(filters["smp_name"]).replace("\'", "\'\'")\n        where_parts.append(f"\\"smp_name\\" = \'{v}\'")\n\n\n    # Optional construction delay-code filters (engage when caller wants to narrow to delayed projects)\n\n    for _delay_col in ("pj_construction_start_delay_code", "pj_construction_complete_delay_code"):\n\n        _v = filters.get(_delay_col)\n\n        if _v is None or str(_v).strip() == "":\n\n            continue\n\n        _s = str(_v).strip()\n\n        where_parts.append(f\'"{_delay_col}" IS NOT NULL\')\n\n        where_parts.append(f\'"{_delay_col}" <> \\\'No Delay\\\'\')\n\n        if _s.lower() not in ("any", "true", "yes", "1", "*"):\n\n            _ss = _s.replace("\'", "\'\'")\n\n            where_parts.append(f\'"{_delay_col}" = \\\'{_ss}\\\'\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n        SELECT\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "construction_gc",\n            COUNT(DISTINCT "pj_project_id") AS cx_pending_count,\n            AVG(\n                CURRENT_DATE - COALESCE(\n                    "pj_a_4225_construction_start_finish"::date,\n                    "ms_1550_construction_start_actual"::date\n                )\n            ) AS avg_days_pending,\n            MAX(\n                CURRENT_DATE - COALESCE(\n                    "pj_a_4225_construction_start_finish"::date,\n                    "ms_1550_construction_start_actual"::date\n                )\n            ) AS max_days_pending,\n            COUNT(DISTINCT CASE\n                WHEN "pj_a_4225_construction_start_finish" IS NOT NULL\n                THEN "pj_project_id"\n            END) AS started_in_magenta,\n            COUNT(DISTINCT CASE\n                WHEN "ms_1550_construction_start_actual" IS NOT NULL\n                 AND "pj_a_4225_construction_start_finish" IS NULL\n                THEN "pj_project_id"\n            END) AS started_only_in_ndpd\n        FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n        WHERE {where_sql}\n        GROUP BY "rgn_region", "m_area", "m_market", "construction_gc"\n        ORDER BY "rgn_region", "m_area", "m_market", "construction_gc"\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['stg_ndpd_mbt_tmobile_macro_combined.pj_project_id', 'stg_ndpd_mbt_tmobile_macro_combined.pj_project_status', 'stg_ndpd_mbt_tmobile_macro_combined.pj_a_4225_construction_start_finish', 'stg_ndpd_mbt_tmobile_macro_combined.ms_1550_construction_start_actual', 'stg_ndpd_mbt_tmobile_macro_combined.pj_a_5175_construction_complete_finish', 'stg_ndpd_mbt_tmobile_macro_combined.ms_1555_construction_complete_actual', 'stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'stg_ndpd_mbt_tmobile_macro_combined.m_area', 'stg_ndpd_mbt_tmobile_macro_combined.m_market', 'stg_ndpd_mbt_tmobile_macro_combined.construction_gc', 'stg_ndpd_mbt_tmobile_macro_combined.smp_id', 'stg_ndpd_mbt_tmobile_macro_combined.smp_name', 'stg_ndpd_mbt_tmobile_macro_combined.pj_construction_start_delay_code', 'stg_ndpd_mbt_tmobile_macro_combined.pj_construction_complete_delay_code'], session_id: '69a3d22f26e208edc083a06e', label: 'CX Pending Construction Sites', kpi_related_core_node_ids: ['project', 'general_contractor', 'market', 'site'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '6700b7d0-1b20-4540-b4a0-b5cc13540d17', entity_type: 'kpi', kpi_name: 'CX Pending Construction Sites', name: '6700b7d0-1b20-4540-b4a0-b5cc13540d17', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Counts distinct projects in the construction phase but not yet complete (pending), with full Magenta+NDPd dual-source coverage. Useful as an operational "how much construction work is in flight right now and how aged is it" metric. Differs from CX WIP Delay Code (which adds a RAN entitlement gate and expects delay-code breakdown) and CX to On-Air Backlog (which is construction-complete-but-not-On-Air). Includes per-source diagnostic counts so you can see how much extra coverage you get from looking at NDPd in addition to Magenta. Optionally filterable by construction delay code: pass pj_construction_start_delay_code or pj_construction_complete_delay_code (any non-empty value engages IS NOT NULL AND <> \'No Delay\'; a specific code value also narrows to that code).', status: 'mentioned', node_id: '6700b7d0-1b20-4540-b4a0-b5cc13540d17'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Two scalar metrics in one row:\nplanned_site_count = COUNT(DISTINCT s_site_id) WHERE NULLIF("pj_p_4225_construction_start_finish", \'\')::date BETWEEN CURRENT_DATE AND (CURRENT_DATE + INTERVAL \'1 day\' * upcoming_window_days);\nactually_started_count = COUNT(DISTINCT s_site_id) WHERE "pj_a_4225_construction_start_finish" IS NOT NULL.\nBoth counts are computed in a single pass over stg_ndpd_mbt_tmobile_macro_combined via CASE WHEN inside the COUNT(DISTINCT ...) expression. The upcoming time-window applies only to the planned count; the actually-started count is all-time, narrowed by any optional filters supplied. Geo dimensions are NOT GROUP BY but ARE available as optional WHERE filters.', kpi_output_schema: '[{"column": "planned_site_count", "type": "int", "description": "COUNT(DISTINCT s_site_id) where planned construction start (pj_p_4225_construction_start_finish) falls within the upcoming window [CURRENT_DATE, CURRENT_DATE + upcoming_window_days days]."}, {"column": "actually_started_count", "type": "int", "description": "COUNT(DISTINCT s_site_id) where actual construction start (pj_a_4225_construction_start_finish) IS NOT NULL \\u2014 sites that have actually started construction. Narrowed by any optional filters."}]', kpi_business_logic: '1) Single source: stg_ndpd_mbt_tmobile_macro_combined (no JOIN). 2) Two counts produced via CASE WHEN inside COUNT(DISTINCT s_site_id): (a) planned_site_count where NULLIF(pj_p_4225_construction_start_finish, \'\')::date BETWEEN CURRENT_DATE AND CURRENT_DATE + (upcoming_window_days days); (b) actually_started_count where pj_a_4225_construction_start_finish IS NOT NULL. 3) Apply optional equality filters via WHERE (apply to BOTH counts): smp_name, smp_id, rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id, por_category. 4) Apply optional construction-start delay-code filter (pj_construction_start_delay_code): any non-empty value engages IS NOT NULL AND <> \'No Delay\'; specific code value also narrows via equality; sentinels \'any\'/\'true\'/\'yes\'/\'1\'/\'*\' engage the predicate without equality. 5) Output: SCALAR single row with planned_site_count and actually_started_count.', kpi_filters: '[{"name": "upcoming_window_days", "type": "int", "description": "Forward-looking window in days; default 7. Integer; coerced from string if necessary. Applies only to planned_site_count."}, {"name": "smp_name", "type": "string", "description": "Optional equality filter on smp_name (program filter)."}, {"name": "smp_id", "type": "string", "description": "Optional equality filter on smp_id."}, {"name": "rgn_region", "type": "string", "description": "Optional equality filter on rgn_region."}, {"name": "m_area", "type": "string", "description": "Optional equality filter on m_area."}, {"name": "m_market", "type": "string", "description": "Optional equality filter on m_market."}, {"name": "construction_gc", "type": "string", "description": "Optional equality filter on construction_gc."}, {"name": "pj_project_id", "type": "string", "description": "Optional equality filter on pj_project_id."}, {"name": "s_site_id", "type": "string", "description": "Optional equality filter on s_site_id."}, {"name": "por_category", "type": "string", "description": "Optional equality filter on por_category."}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Optional filter on construction-start delay code. Any non-empty value engages: pj_construction_start_delay_code IS NOT NULL AND <> \'No Delay\'. A specific delay code value (not a sentinel) also narrows via equality. Sentinels \'any\'/\'true\'/\'yes\'/\'1\'/\'*\' apply predicate only."}]', kpi_contract: '{"function_name": "get_planned_sites_count", "node_type": "kpi", "node_id": "b0d7f4a6-3a72-4517-8dc7-e4a4e012fc1f", "node_label": "Planned Sites Count", "description": "Planned Sites Count + Actually Started Count \\u2014 two scalar counts of distinct sites in one row. Single source: stg_ndpd_mbt_tmobile_macro_combined (no JOIN).\\n\\nOutput:\\n- planned_site_count: distinct sites with planned construction start (pj_p_4225_construction_start_finish) within the upcoming time window (default 7 days)\\n- actually_started_count: distinct sites that have actually started construction (pj_a_4225_construction_start_finish IS NOT NULL)\\n\\nUse this node for forward-looking demand (planned_site_count) and started-volume (actually_started_count) questions. Pair with Crew Capacity for demand-vs-supply analysis. Filterable by program (smp_name), geo dims, project/site IDs, and construction-start delay code (pj_construction_start_delay_code) for delay-reason narrowing.", "parameters": [{"name": "upcoming_window_days", "type": "int", "description": "Forward-looking window in days. Default 7. Applies only to planned_site_count.", "required": false, "sample_values": [7, 14, 30]}, {"name": "smp_name", "type": "string", "description": "Program filter.", "required": false, "sample_values": []}, {"name": "smp_id", "type": "string", "description": "Filter by smp_id.", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by region.", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by area.", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by market.", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by GC.", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj_project_id.", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s_site_id.", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por_category.", "required": false, "sample_values": []}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Filter to projects with a specific construction-start delay code, or any real start delay (pass \'any\' to skip equality and just require IS NOT NULL AND <> \'No Delay\').", "required": false, "sample_values": ["any", "Material Delay", "Weather Delay"]}], "output_columns": [{"name": "planned_site_count", "type": "number", "nullable": false}, {"name": "actually_started_count", "type": "number", "nullable": false}], "sample_output": [], "row_count": 1}', nl_description: 'Planned Sites Count + Actually Started Count: two scalar counts of distinct s_site_id from stg_ndpd_mbt_tmobile_macro_combined. planned_site_count = sites where pj_p_4225_construction_start_finish (planned start) falls in [CURRENT_DATE, CURRENT_DATE + upcoming_window_days]; actually_started_count = sites where pj_a_4225_construction_start_finish (actual start) IS NOT NULL. Output is scalar (single row). Optional filters (smp_name, geo dims, entity IDs, por_category) apply to both counts via WHERE. Optional pj_construction_start_delay_code filter narrows to sites with real (non-\'No Delay\') construction-start delay codes.', node_type: 'CORE', definition: 'Planned Sites Count + Actually Started Count: two scalar counts of distinct s_site_id from stg_ndpd_mbt_tmobile_macro_combined. planned_site_count = sites where pj_p_4225_construction_start_finish (planned start) falls in [CURRENT_DATE, CURRENT_DATE + upcoming_window_days]; actually_started_count = sites where pj_a_4225_construction_start_finish (actual start) IS NOT NULL. Output is scalar (single row). Optional filters (smp_name, geo dims, entity IDs, por_category) apply to both counts via WHERE. Optional pj_construction_start_delay_code filter narrows to sites with real (non-\'No Delay\') construction-start delay codes.', kpi_python_function: 'def get_planned_sites_count(execute_query, filters=None) -> list[dict]:\n    """Planned Sites Count + Actually Started Count.\n\n    Two scalar metrics returned in one row:\n      - planned_site_count    : COUNT(DISTINCT s_site_id) where\n          NULLIF("pj_p_4225_construction_start_finish", \'\')::date is BETWEEN\n          CURRENT_DATE and (CURRENT_DATE + upcoming_window_days days)\n      - actually_started_count: COUNT(DISTINCT s_site_id) where\n          "pj_a_4225_construction_start_finish" IS NOT NULL\n\n    Single source: stg_ndpd_mbt_tmobile_macro_combined (no JOIN).\n\n    Output is SCALAR (single row). The time-window applies only to the planned\n    count (via CASE WHEN). The actually-started count is all-time, narrowed by\n    any optional filters supplied. Geo dimensions (rgn_region, m_area, m_market,\n    construction_gc) are NOT used as GROUP BY but ARE available as optional\n    WHERE filters when the caller wants to narrow to a specific\n    region/area/market/GC.\n\n    Optional filters (all equality, all optional):\n      - upcoming_window_days       : int, default 7  (window for planned count)\n      - smp_name                   : e.g., \'NTM\', \'AHLOB Modernization\'\n      - rgn_region, m_area, m_market, construction_gc : geo filters\n      - smp_id, pj_project_id, s_site_id : entity filters\n      - por_category               : POR category filter\n      - pj_construction_start_delay_code : delay-code filter (any non-empty value\n          engages IS NOT NULL AND <> \'No Delay\'; a specific code value also\n          narrows to that code via equality; sentinels \'any\'/\'true\'/\'yes\'/\n          \'1\'/\'*\' engage the predicate without equality)\n    """\n    filters = filters or {}\n\n    try:\n        window_days = int(filters.get("upcoming_window_days", 7))\n    except (TypeError, ValueError):\n        window_days = 7\n\n    where_parts = []\n\n    optional_eq_cols = [\n        "smp_name",\n        "smp_id",\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "pj_project_id",\n        "s_site_id",\n        "por_category",\n    ]\n    for col in optional_eq_cols:\n        v = filters.get(col)\n        if v is not None and str(v) != "":\n            vv = str(v).replace("\'", "\'\'")\n            where_parts.append(f"\\"{col}\\" = \'{vv}\'")\n\n    # Optional construction-start delay-code filter\n    _v = filters.get("pj_construction_start_delay_code")\n    if _v is not None and str(_v).strip() != "":\n        _s = str(_v).strip()\n        where_parts.append(\'"pj_construction_start_delay_code" IS NOT NULL\')\n        where_parts.append("\\"pj_construction_start_delay_code\\" <> \'No Delay\'")\n        if _s.lower() not in ("any", "true", "yes", "1", "*"):\n            _ss = _s.replace("\'", "\'\'")\n            where_parts.append(f\'"pj_construction_start_delay_code" = \\\'{_ss}\\\'\')\n\n    where_sql = (" WHERE " + " AND ".join(where_parts)) if where_parts else ""\n\n    sql = f"""\n        SELECT\n            COUNT(DISTINCT CASE\n                WHEN NULLIF("pj_p_4225_construction_start_finish", \'\')::date\n                     BETWEEN CURRENT_DATE\n                         AND (CURRENT_DATE + (INTERVAL \'1 day\' * {window_days}))\n                THEN "s_site_id"\n            END) AS planned_site_count,\n\n            COUNT(DISTINCT CASE\n                WHEN "pj_a_4225_construction_start_finish" IS NOT NULL\n                THEN "s_site_id"\n            END) AS actually_started_count\n        FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n        {where_sql}\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['stg_ndpd_mbt_tmobile_macro_combined.s_site_id', 'stg_ndpd_mbt_tmobile_macro_combined.pj_p_4225_construction_start_finish', 'stg_ndpd_mbt_tmobile_macro_combined.pj_a_4225_construction_start_finish', 'stg_ndpd_mbt_tmobile_macro_combined.pj_construction_start_delay_code', 'stg_ndpd_mbt_tmobile_macro_combined.smp_name', 'stg_ndpd_mbt_tmobile_macro_combined.smp_id', 'stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'stg_ndpd_mbt_tmobile_macro_combined.m_area', 'stg_ndpd_mbt_tmobile_macro_combined.m_market', 'stg_ndpd_mbt_tmobile_macro_combined.construction_gc', 'stg_ndpd_mbt_tmobile_macro_combined.pj_project_id', 'stg_ndpd_mbt_tmobile_macro_combined.por_category'], session_id: '69a3d22f26e208edc083a06e', label: 'Planned Sites Count', kpi_related_core_node_ids: ['project', 'general_contractor', 'market', 'site'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'b0d7f4a6-3a72-4517-8dc7-e4a4e012fc1f', entity_type: 'kpi', kpi_name: 'Planned Sites Count', name: 'b0d7f4a6-3a72-4517-8dc7-e4a4e012fc1f', kpi_dimensions: [], kpi_description: 'Forward-looking demand + started-volume metric — answers both \'how many sites are planned to start construction in the next N days?\' and \'how many sites have actually started construction (narrowed by filters)?\'. Single source: stg_ndpd_mbt_tmobile_macro_combined. Default window 7 days (overridable via upcoming_window_days). Optional filters (smp_name, smp_id, rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id, por_category) and an optional construction-start delay-code filter (pj_construction_start_delay_code — \'why didn\'t it start?\'). Pairs with Crew Capacity for capacity-vs-demand analysis.', status: 'mentioned', node_id: 'b0d7f4a6-3a72-4517-8dc7-e4a4e012fc1f'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'scop_ftr_rate_pct = ROUND(100.0 * ftr_count / NULLIF(accepted_count, 0), 2), where accepted_count = COUNT(DISTINCT pj_project_id) with ms_1559_cop_approved_by_t_mobile_actual IS NOT NULL, and ftr_count = COUNT(DISTINCT pj_project_id) with that condition AND scop_tw_checklist_rejected_by_tmo IS NULL (client-validated). Hard guards: rgn_region IS NOT NULL, construction_gc IS NOT NULL, construction_gc <> \'NOKIA\'. Single unified formula — same logic for both NTM and AHLOB Modernization; smp_name is just an optional filter. Output also includes raw counts (accepted_count, ftr_count, rejected_count, resubmission_count) and acceptance cycle days (avg_cycle_days = ROUND(AVG(...), 0), max_cycle_days = MAX(...)) when both ms_1559_cop_approved_by_t_mobile_actual and ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl are NOT NULL and diff >= 0. Grouped by (rgn_region, m_area, m_market, construction_gc).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region group-by dimension."}, {"column": "m_area", "type": "string", "description": "Area group-by dimension."}, {"column": "m_market", "type": "string", "description": "Market group-by dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor group-by dimension."}, {"column": "accepted_count", "type": "int", "description": "COUNT(DISTINCT pj_project_id) of accepted sites (denominator: ms_1559_cop_approved_by_t_mobile_actual IS NOT NULL)."}, {"column": "ftr_count", "type": "int", "description": "COUNT(DISTINCT pj_project_id) of FTR sites (accepted AND cop_approval_type IS NULL)."}, {"column": "rejected_count", "type": "int", "description": "COUNT(DISTINCT pj_project_id) with TMO rejection signal (scop_tw_checklist_rejected_by_tmo IS NOT NULL)."}, {"column": "resubmission_count", "type": "int", "description": "COUNT(DISTINCT pj_project_id) of resubmitted-to-TMO sites (scop_tw_punch_list_re_submitted_to_tmo IS NOT NULL)."}, {"column": "scop_ftr_rate_pct", "type": "float", "description": "100.0 * ftr_count / NULLIF(accepted_count, 0). Primary quality metric."}, {"column": "avg_cycle_days", "type": "float", "description": "Average days from ms_1557 (punch checklist submitted) to ms_1559 (COP approved) when both NOT NULL and diff >= 0."}, {"column": "max_cycle_days", "type": "float", "description": "Longest cycle days under the same condition."}]', kpi_business_logic: '1) Single source: pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined — NO JOIN, NO smp_name branching. Same formula applies to both NTM and AHLOB Modernization; smp_name is one of the optional equality filters the agent can pass. 2) Hard guard filters (always applied, client-validated): "rgn_region" IS NOT NULL; "construction_gc" IS NOT NULL; "construction_gc" <> \'NOKIA\'. 3) Apply optional equality filters (open filter surface — pass any subset): smp_name, smp_id, rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id, customer_site_code, package_name, por_category. 4) Apply optional date range (start_date / end_date) on ms_1559_cop_approved_by_t_mobile_actual::date. 5) Group by (rgn_region, m_area, m_market, construction_gc). 6) accepted_count = COUNT(DISTINCT pj_project_id) WHERE ms_1559_cop_approved_by_t_mobile_actual IS NOT NULL. 7) ftr_count = COUNT(DISTINCT pj_project_id) WHERE accepted AND scop_tw_checklist_rejected_by_tmo IS NULL  (client-validated; replaces the old cop_approval_type IS NULL signal). 8) rejected_count = COUNT(DISTINCT pj_project_id) WHERE scop_tw_checklist_rejected_by_tmo IS NOT NULL. 9) resubmission_count = COUNT(DISTINCT pj_project_id) WHERE scop_tw_punch_list_re_submitted_to_tmo IS NOT NULL. 10) scop_ftr_rate_pct = ROUND(100.0 * ftr_count / NULLIF(accepted_count, 0), 2). 11) avg_cycle_days / max_cycle_days = aggregates of (ms_1559_cop_approved_by_t_mobile_actual::date - ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl::date) when both timestamps are NOT NULL and the diff is >= 0; avg is ROUND(..., 0).', kpi_filters: '[{"name": "smp_name", "type": "string", "description": "Optional equality filter on smp_name (program filter)."}, {"name": "smp_id", "type": "string", "description": "Optional equality filter on smp_id."}, {"name": "rgn_region", "type": "string", "description": "Optional equality filter on rgn_region \\u2014 narrows to a specific region."}, {"name": "m_area", "type": "string", "description": "Optional equality filter on m_area \\u2014 narrows to a specific area."}, {"name": "m_market", "type": "string", "description": "Optional equality filter on m_market \\u2014 narrows to a specific market."}, {"name": "construction_gc", "type": "string", "description": "Optional equality filter on construction_gc \\u2014 narrows to a specific GC."}, {"name": "pj_project_id", "type": "string", "description": "Optional equality filter on pj_project_id."}, {"name": "s_site_id", "type": "string", "description": "Optional equality filter on s_site_id."}, {"name": "customer_site_code", "type": "string", "description": "Optional equality filter on customer_site_code."}, {"name": "package_name", "type": "string", "description": "Optional equality filter on package_name."}, {"name": "por_category", "type": "string", "description": "Optional equality filter on por_category."}, {"name": "start_date", "type": "date", "description": "Lower bound on ms_1559_cop_approved_by_t_mobile_actual::date (cast to date literal)."}, {"name": "end_date", "type": "date", "description": "Upper bound on ms_1559_cop_approved_by_t_mobile_actual::date."}]', kpi_contract: '{"function_name": "get_scop_cop_quality_rate", "node_type": "kpi", "node_id": "a1205491-3abb-41be-b638-cbef40e44441", "node_label": "SCOP/COP Quality Rate", "description": "SCOP/COP Quality Rate \\u2014 measures the quality of completed SCOP/COP approvals via the First-Time-Right rate (sites accepted without any TMO rejection / total accepted * 100). Single source: stg_ndpd_mbt_tmobile_macro_combined (no JOIN). Single unified formula \\u2014 same logic applies to both NTM and AHLOB Modernization; smp_name is just an optional filter the agent can pass to narrow results.\\n\\nCanonical predicates (per client KPI 881505 DAX):\\n- Accepted   : ms_1559_cop_approved_by_t_mobile_actual IS NOT NULL\\n- FTR        : accepted AND cop_approval_type IS NULL\\n- Rejected   : scop_tw_checklist_rejected_by_tmo IS NOT NULL\\n- Resubmitted: scop_tw_punch_list_re_submitted_to_tmo IS NOT NULL\\n- Cycle days : ms_1559::date - ms_1557::date when both NOT NULL and >= 0\\n\\nOutput is grouped by (rgn_region, m_area, m_market, construction_gc) with 7 metric columns: accepted_count, ftr_count, rejected_count, resubmission_count, scop_ftr_rate_pct, avg_cycle_days, max_cycle_days.\\n\\nDISTINCT from `SCOP Approval Pending` (aa4376f5-\\u2026), which measures *pending volume* (sites awaiting approval); this node measures *quality of completed approvals*. COP and SCOP are synonymous in this domain.", "parameters": [{"name": "smp_name", "type": "string", "description": "Filter by program name on smp_name.", "required": false, "sample_values": []}, {"name": "smp_id", "type": "string", "description": "Filter by smp_id.", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by region.", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by area.", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by market.", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by GC.", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj_project_id.", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s_site_id.", "required": false, "sample_values": []}, {"name": "customer_site_code", "type": "string", "description": "Filter by customer_site_code.", "required": false, "sample_values": []}, {"name": "package_name", "type": "string", "description": "Filter by package_name.", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por_category.", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Lower bound on ms_1559_cop_approved_by_t_mobile_actual::date.", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Upper bound on ms_1559_cop_approved_by_t_mobile_actual::date.", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": true}, {"name": "m_area", "type": "string", "nullable": true}, {"name": "m_market", "type": "string", "nullable": true}, {"name": "construction_gc", "type": "string", "nullable": true}, {"name": "accepted_count", "type": "number", "nullable": false}, {"name": "ftr_count", "type": "number", "nullable": false}, {"name": "rejected_count", "type": "number", "nullable": false}, {"name": "resubmission_count", "type": "number", "nullable": false}, {"name": "scop_ftr_rate_pct", "type": "number", "nullable": true}, {"name": "avg_cycle_days", "type": "number", "nullable": true}, {"name": "max_cycle_days", "type": "number", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'SCOP/COP Quality Rate (FTR%) = ROUND(100 * (distinct accepted projects with no TMO rejection on the checklist) / (distinct accepted projects), 2), grouped by (rgn_region, m_area, m_market, construction_gc). Source: stg_ndpd_mbt_tmobile_macro_combined. Single unified formula for both NTM and AHLOB Modernization; smp_name is just an optional filter. Acceptance = ms_1559_cop_approved_by_t_mobile_actual IS NOT NULL; FTR additionally requires scop_tw_checklist_rejected_by_tmo IS NULL (client-validated). Hard guards always applied: rgn_region IS NOT NULL, construction_gc IS NOT NULL, construction_gc <> \'NOKIA\'. Includes raw counts (accepted_count, ftr_count, rejected_count, resubmission_count) and acceptance cycle days (avg/max) from ms_1559::date - ms_1557::date. COP and SCOP are synonymous; distinct from SCOP Approval Pending (which measures pending volume, not quality).', node_type: 'CORE', definition: 'SCOP/COP Quality Rate (FTR%) = ROUND(100 * (distinct accepted projects with no TMO rejection on the checklist) / (distinct accepted projects), 2), grouped by (rgn_region, m_area, m_market, construction_gc). Source: stg_ndpd_mbt_tmobile_macro_combined. Single unified formula for both NTM and AHLOB Modernization; smp_name is just an optional filter. Acceptance = ms_1559_cop_approved_by_t_mobile_actual IS NOT NULL; FTR additionally requires scop_tw_checklist_rejected_by_tmo IS NULL (client-validated). Hard guards always applied: rgn_region IS NOT NULL, construction_gc IS NOT NULL, construction_gc <> \'NOKIA\'. Includes raw counts (accepted_count, ftr_count, rejected_count, resubmission_count) and acceptance cycle days (avg/max) from ms_1559::date - ms_1557::date. COP and SCOP are synonymous; distinct from SCOP Approval Pending (which measures pending volume, not quality).', kpi_python_function: 'def get_scop_cop_quality_rate(execute_query, filters=None) -> list[dict]:\n    """SCOP/COP Quality Rate (FTR%) — aligned with client-validated logic.\n\n    Source: stg_ndpd_mbt_tmobile_macro_combined (no JOIN).\n\n    Canonical predicates (client-validated):\n      - Accepted   : "ms_1559_cop_approved_by_t_mobile_actual" IS NOT NULL\n      - FTR        : accepted AND "scop_tw_checklist_rejected_by_tmo" IS NULL\n      - Rejected   : "scop_tw_checklist_rejected_by_tmo" IS NOT NULL\n      - Resubmitted: "scop_tw_punch_list_re_submitted_to_tmo" IS NOT NULL\n      - Cycle days : ms_1559_cop_approved_by_t_mobile_actual::date\n                       - ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl::date\n                     (only when both NOT NULL and diff >= 0)\n\n    Hard guard filters (always applied — client validated):\n      - "rgn_region"      IS NOT NULL\n      - "construction_gc" IS NOT NULL\n      - "construction_gc" <> \'NOKIA\'\n\n    Output (one row per (rgn_region, m_area, m_market, construction_gc)):\n      - accepted_count, ftr_count, rejected_count, resubmission_count\n      - scop_ftr_rate_pct = ROUND(100 * ftr / NULLIF(accepted, 0), 2)\n      - avg_cycle_days    = ROUND(AVG(...), 0)\n      - max_cycle_days\n\n    Optional filters (all equality, all optional):\n      smp_name, smp_id,\n      rgn_region, m_area, m_market, construction_gc,\n      pj_project_id, s_site_id, customer_site_code,\n      package_name, por_category,\n      start_date, end_date (applied to ms_1559_cop_approved_by_t_mobile_actual::date).\n    """\n    filters = filters or {}\n\n    # Hard guard filters (client-validated, always present)\n    where_parts = [\n        \'"rgn_region" IS NOT NULL\',\n        \'"construction_gc" IS NOT NULL\',\n        \'"construction_gc" <> \\\'NOKIA\\\'\',\n    ]\n\n    optional_eq_cols = [\n        "smp_name",\n        "smp_id",\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "pj_project_id",\n        "s_site_id",\n        "customer_site_code",\n        "package_name",\n        "por_category",\n    ]\n    for col in optional_eq_cols:\n        v = filters.get(col)\n        if v is not None and str(v) != "":\n            vv = str(v).replace("\'", "\'\'")\n            where_parts.append(f"\\"{col}\\" = \'{vv}\'")\n\n    if filters.get("start_date"):\n        sd = str(filters["start_date"]).replace("\'", "\'\'")\n        where_parts.append(\n            f"\\"ms_1559_cop_approved_by_t_mobile_actual\\"::date >= DATE \'{sd}\'"\n        )\n    if filters.get("end_date"):\n        ed = str(filters["end_date"]).replace("\'", "\'\'")\n        where_parts.append(\n            f"\\"ms_1559_cop_approved_by_t_mobile_actual\\"::date <= DATE \'{ed}\'"\n        )\n\n    where_sql = "WHERE " + " AND ".join(where_parts)\n\n    sql = f"""\n        SELECT\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "construction_gc",\n\n            COUNT(DISTINCT CASE\n                WHEN "ms_1559_cop_approved_by_t_mobile_actual" IS NOT NULL\n                THEN "pj_project_id"\n            END) AS accepted_count,\n\n            COUNT(DISTINCT CASE\n                WHEN "ms_1559_cop_approved_by_t_mobile_actual" IS NOT NULL\n                 AND "scop_tw_checklist_rejected_by_tmo" IS NULL\n                THEN "pj_project_id"\n            END) AS ftr_count,\n\n            COUNT(DISTINCT CASE\n                WHEN "scop_tw_checklist_rejected_by_tmo" IS NOT NULL\n                THEN "pj_project_id"\n            END) AS rejected_count,\n\n            COUNT(DISTINCT CASE\n                WHEN "scop_tw_punch_list_re_submitted_to_tmo" IS NOT NULL\n                THEN "pj_project_id"\n            END) AS resubmission_count,\n\n            ROUND(\n                (100.0 *\n                    COUNT(DISTINCT CASE\n                        WHEN "ms_1559_cop_approved_by_t_mobile_actual" IS NOT NULL\n                         AND "scop_tw_checklist_rejected_by_tmo" IS NULL\n                        THEN "pj_project_id"\n                    END)\n                    / NULLIF(\n                        COUNT(DISTINCT CASE\n                            WHEN "ms_1559_cop_approved_by_t_mobile_actual" IS NOT NULL\n                            THEN "pj_project_id"\n                        END),\n                        0\n                    )\n                ),\n                2\n            ) AS scop_ftr_rate_pct,\n\n            ROUND(\n                AVG(CASE\n                    WHEN "ms_1559_cop_approved_by_t_mobile_actual" IS NOT NULL\n                     AND "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl" IS NOT NULL\n                     AND ("ms_1559_cop_approved_by_t_mobile_actual"::date\n                          - "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl"::date) >= 0\n                    THEN ("ms_1559_cop_approved_by_t_mobile_actual"::date\n                          - "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl"::date)\n                END),\n                0\n            ) AS avg_cycle_days,\n\n            MAX(CASE\n                WHEN "ms_1559_cop_approved_by_t_mobile_actual" IS NOT NULL\n                 AND "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl" IS NOT NULL\n                 AND ("ms_1559_cop_approved_by_t_mobile_actual"::date\n                      - "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl"::date) >= 0\n                THEN ("ms_1559_cop_approved_by_t_mobile_actual"::date\n                      - "ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl"::date)\n            END) AS max_cycle_days\n\n        FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n        {where_sql}\n        GROUP BY\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "construction_gc"\n        ORDER BY\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "construction_gc"\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['stg_ndpd_mbt_tmobile_macro_combined.pj_project_id', 'stg_ndpd_mbt_tmobile_macro_combined.s_site_id', 'stg_ndpd_mbt_tmobile_macro_combined.customer_site_code', 'stg_ndpd_mbt_tmobile_macro_combined.smp_id', 'stg_ndpd_mbt_tmobile_macro_combined.smp_name', 'stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'stg_ndpd_mbt_tmobile_macro_combined.m_area', 'stg_ndpd_mbt_tmobile_macro_combined.m_market', 'stg_ndpd_mbt_tmobile_macro_combined.construction_gc', 'stg_ndpd_mbt_tmobile_macro_combined.package_name', 'stg_ndpd_mbt_tmobile_macro_combined.por_category', 'stg_ndpd_mbt_tmobile_macro_combined.scop_tw_checklist_submitted_to_customer', 'stg_ndpd_mbt_tmobile_macro_combined.scop_checklist_accepted_by_customer', 'stg_ndpd_mbt_tmobile_macro_combined.scop_tw_checklist_rejected_by_tmo', 'stg_ndpd_mbt_tmobile_macro_combined.scop_tw_punch_list_re_submitted_to_tmo', 'stg_ndpd_mbt_tmobile_macro_combined.ms_1557_punch_checklist_reviewed_and_submitted_to_tmobile_atl', 'stg_ndpd_mbt_tmobile_macro_combined.ms_1559_cop_approved_by_t_mobile_actual'], session_id: '69a3d22f26e208edc083a06e', label: 'SCOP/COP Quality Rate', kpi_related_core_node_ids: ['project', 'general_contractor', 'market', 'site'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'a1205491-3abb-41be-b638-cbef40e44441', entity_type: 'kpi', kpi_name: 'SCOP/COP Quality Rate', name: 'a1205491-3abb-41be-b638-cbef40e44441', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'SCOP/COP Quality Rate (FTR%) = ROUND(100 * (distinct accepted projects with no TMO rejection on the checklist) / (distinct accepted projects), 2), grouped by (rgn_region, m_area, m_market, construction_gc). Source: stg_ndpd_mbt_tmobile_macro_combined. Single unified formula for both NTM and AHLOB Modernization; smp_name is just an optional filter. Acceptance = ms_1559_cop_approved_by_t_mobile_actual IS NOT NULL; FTR additionally requires scop_tw_checklist_rejected_by_tmo IS NULL (client-validated). Hard guards always applied: rgn_region IS NOT NULL, construction_gc IS NOT NULL, construction_gc <> \'NOKIA\'. Includes raw counts (accepted_count, ftr_count, rejected_count, resubmission_count) and acceptance cycle days (avg/max) from ms_1559::date - ms_1557::date. COP and SCOP are synonymous; distinct from SCOP Approval Pending (which measures pending volume, not quality).', status: 'mentioned', node_id: 'a1205491-3abb-41be-b638-cbef40e44441'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'Business-day cycle time = COUNT(*) over generate_series(scop_tw_checklist_submitted_to_customer::date, scop_checklist_accepted_by_customer::date, INTERVAL \'1 day\') WHERE EXTRACT(ISODOW FROM g) BETWEEN 1 AND 5 (Mon-Fri only). within_sla_count = sites where business_day_diff <= 14; without_sla_count = sites where business_day_diff > 14; within_sla_pct = 100.0 * within_sla_count / NULLIF(total_sites_accepted, 0). Aggregated by (rgn_region, m_area, m_market, construction_gc) over completed cycles only (both submitted and accepted timestamps NOT NULL, accepted >= submitted).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping dimension."}, {"column": "m_area", "type": "string", "description": "Area grouping dimension."}, {"column": "m_market", "type": "string", "description": "Market grouping dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping dimension."}, {"column": "total_sites_accepted", "type": "int", "description": "COUNT(DISTINCT pj_project_id) of completed cycles (both submission and acceptance timestamps NOT NULL)."}, {"column": "within_sla_count", "type": "int", "description": "Distinct projects whose business-day cycle is <= 14 days (within 14-day SLA)."}, {"column": "without_sla_count", "type": "int", "description": "Distinct projects whose business-day cycle is > 14 days (SLA breach)."}, {"column": "within_sla_pct", "type": "float", "description": "100.0 * within_sla_count / NULLIF(total_sites_accepted, 0). SLA compliance rate."}, {"column": "avg_business_days", "type": "float", "description": "Average business-day cycle time across completed cycles."}, {"column": "min_business_days", "type": "int", "description": "Fastest cycle time (in business days) among completed cycles."}, {"column": "max_business_days", "type": "int", "description": "Slowest cycle time (in business days) among completed cycles."}]', kpi_business_logic: '1) Source: stg_ndpd_mbt_tmobile_macro_combined (single table, no JOIN). 2) Per-row cycle time computed by CROSS JOIN LATERAL generate_series between scop_tw_checklist_submitted_to_customer::date and scop_checklist_accepted_by_customer::date with 1-day step, then COUNT(*) over days where ISODOW BETWEEN 1 AND 5 (business days, Mon-Fri). 3) Mandatory predicates: both submission and acceptance timestamps NOT NULL; accepted >= submitted (guards against malformed data); ISODOW between 1 and 5 (only counts weekdays). 4) Apply optional equality filters: smp_name, smp_id, rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id, customer_site_code, package_name, por_category. 5) Apply optional date range (start_date / end_date on scop_checklist_accepted_by_customer::date). 6) GROUP per-row outputs to geo grain (rgn_region, m_area, m_market, construction_gc). 7) Compute totals + SLA buckets: total_sites_accepted = COUNT(DISTINCT pj_project_id); within_sla_count = COUNT(DISTINCT) where business_day_diff <= 14; without_sla_count = COUNT(DISTINCT) where business_day_diff > 14; within_sla_pct = 100 * within_sla_count / NULLIF(total_sites_accepted, 0); avg/min/max_business_days aggregates over the per-site business_day_diff.', kpi_filters: '[{"name": "smp_name", "type": "string", "description": "Optional equality filter on m.smp_name (program filter)."}, {"name": "smp_id", "type": "string", "description": "Optional equality filter on m.smp_id."}, {"name": "rgn_region", "type": "string", "description": "Optional equality filter on m.rgn_region."}, {"name": "m_area", "type": "string", "description": "Optional equality filter on m.m_area."}, {"name": "m_market", "type": "string", "description": "Optional equality filter on m.m_market."}, {"name": "construction_gc", "type": "string", "description": "Optional equality filter on m.construction_gc."}, {"name": "pj_project_id", "type": "string", "description": "Optional equality filter on m.pj_project_id."}, {"name": "s_site_id", "type": "string", "description": "Optional equality filter on m.s_site_id."}, {"name": "customer_site_code", "type": "string", "description": "Optional equality filter on m.customer_site_code."}, {"name": "package_name", "type": "string", "description": "Optional equality filter on m.package_name."}, {"name": "por_category", "type": "string", "description": "Optional equality filter on m.por_category."}, {"name": "start_date", "type": "date", "description": "Lower bound on scop_checklist_accepted_by_customer::date."}, {"name": "end_date", "type": "date", "description": "Upper bound on scop_checklist_accepted_by_customer::date."}]', kpi_contract: '{"function_name": "get_scop_acceptance_cycle_time", "node_type": "kpi", "node_id": "109ef604-2e52-4082-8ebe-d4297e9daa52", "node_label": "SCOP Acceptance Cycle Time", "description": "SCOP Acceptance Cycle Time \\u2014 measures how long the customer takes to accept the Tower-Work (TW) SCOP checklist after submission, in BUSINESS DAYS (Mon-Fri only, ISODOW 1-5). Computed per project/site/package via CROSS JOIN LATERAL generate_series between scop_tw_checklist_submitted_to_customer::date and scop_checklist_accepted_by_customer::date, then aggregated at (rgn_region, m_area, m_market, construction_gc) grain.\\n\\nPrimary outputs:\\n- total_sites_accepted : completed-cycle count (denominator)\\n- within_sla_count / without_sla_count : 14-day business-day SLA buckets\\n- within_sla_pct : SLA compliance percentage\\n- avg/min/max_business_days : cycle-time aggregates\\n\\nWhen to use this node: agent should pick this for any question about SCOP/COP acceptance speed, customer SLA compliance, days-to-acceptance, \'14-day SLA\', or cycle time between TW checklist submission and customer acceptance. Distinct from SCOP/COP Quality Rate (measures FTR rate / approval quality, not speed) and SCOP Approval Pending (measures pending volume awaiting TMO approval, not closed cycles).", "parameters": [{"name": "smp_name", "type": "string", "description": "Filter by program (e.g., \'NTM\', \'AHLOB Modernization\').", "required": false, "sample_values": []}, {"name": "smp_id", "type": "string", "description": "Filter by smp_id.", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by region.", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by area.", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by market.", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by GC.", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj_project_id.", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s_site_id.", "required": false, "sample_values": []}, {"name": "customer_site_code", "type": "string", "description": "Filter by customer_site_code.", "required": false, "sample_values": []}, {"name": "package_name", "type": "string", "description": "Filter by package_name.", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por_category.", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Lower bound on acceptance date.", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Upper bound on acceptance date.", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": true}, {"name": "m_area", "type": "string", "nullable": true}, {"name": "m_market", "type": "string", "nullable": true}, {"name": "construction_gc", "type": "string", "nullable": true}, {"name": "total_sites_accepted", "type": "number", "nullable": false}, {"name": "within_sla_count", "type": "number", "nullable": false}, {"name": "without_sla_count", "type": "number", "nullable": false}, {"name": "within_sla_pct", "type": "number", "nullable": true}, {"name": "avg_business_days", "type": "number", "nullable": true}, {"name": "min_business_days", "type": "number", "nullable": true}, {"name": "max_business_days", "type": "number", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'SCOP Acceptance Cycle Time = business days (Mon-Fri, ISODOW 1-5) from scop_tw_checklist_submitted_to_customer to scop_checklist_accepted_by_customer, computed per project/site/package via LATERAL generate_series and aggregated by (rgn_region, m_area, m_market, construction_gc). 14-day SLA bucketing: within_sla_count (<= 14 days) vs without_sla_count (> 14 days) with within_sla_pct, plus avg/min/max business days. Only counts completed cycles (both timestamps NOT NULL, accepted >= submitted). Source: stg_ndpd_mbt_tmobile_macro_combined.', node_type: 'CORE', definition: 'SCOP Acceptance Cycle Time = business days (Mon-Fri, ISODOW 1-5) from scop_tw_checklist_submitted_to_customer to scop_checklist_accepted_by_customer, computed per project/site/package via LATERAL generate_series and aggregated by (rgn_region, m_area, m_market, construction_gc). 14-day SLA bucketing: within_sla_count (<= 14 days) vs without_sla_count (> 14 days) with within_sla_pct, plus avg/min/max business days. Only counts completed cycles (both timestamps NOT NULL, accepted >= submitted). Source: stg_ndpd_mbt_tmobile_macro_combined.', kpi_python_function: 'def get_scop_acceptance_cycle_time(execute_query, filters=None) -> list[dict]:\n    """SCOP Acceptance Cycle Time.\n\n    Measures how long the customer takes to accept the Tower-Work (TW) SCOP\n    checklist after submission, in BUSINESS DAYS (Mon-Fri only). Bucketed by\n    14-day SLA: within_sla (<= 14 business days) vs without_sla (> 14 business\n    days). Source: pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n    (single table, no JOIN).\n\n    Per-row business-day cycle:\n        COUNT(*) FROM generate_series(\n            scop_tw_checklist_submitted_to_customer::date,\n            scop_checklist_accepted_by_customer::date,\n            INTERVAL \'1 day\'\n        ) g\n        WHERE EXTRACT(ISODOW FROM g) BETWEEN 1 AND 5\n\n    Output (one row per (rgn_region, m_area, m_market, construction_gc)):\n      - total_sites_accepted : COUNT(DISTINCT pj_project_id) of completed cycles\n      - within_sla_count     : completed cycles where business_day_diff <= 14\n      - without_sla_count    : completed cycles where business_day_diff >  14\n      - within_sla_pct       : 100 * within_sla_count / total_sites_accepted\n      - avg_business_days, min_business_days, max_business_days\n\n    Optional filters (all equality, all optional):\n      - smp_name             : program filter (e.g., NTM, AHLOB Modernization)\n      - smp_id, pj_project_id, s_site_id, customer_site_code\n      - rgn_region, m_area, m_market, construction_gc\n      - package_name, por_category\n      - start_date, end_date : applied to scop_checklist_accepted_by_customer::date\n    """\n    filters = filters or {}\n\n    def _esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    where_parts = [\n        "m.\\"scop_tw_checklist_submitted_to_customer\\" IS NOT NULL",\n        "m.\\"scop_checklist_accepted_by_customer\\" IS NOT NULL",\n        "m.\\"scop_checklist_accepted_by_customer\\"::date >= m.\\"scop_tw_checklist_submitted_to_customer\\"::date",\n        "EXTRACT(ISODOW FROM g) BETWEEN 1 AND 5",\n    ]\n\n    # Date-range filters on the acceptance timestamp\n    if filters.get("start_date"):\n        where_parts.append(\n            f"m.\\"scop_checklist_accepted_by_customer\\"::date >= DATE \'{_esc(filters[\'start_date\'])}\'"\n        )\n    if filters.get("end_date"):\n        where_parts.append(\n            f"m.\\"scop_checklist_accepted_by_customer\\"::date <= DATE \'{_esc(filters[\'end_date\'])}\'"\n        )\n\n    # Open filter surface — optional equality filters\n    optional_eq_cols = [\n        "smp_name",\n        "smp_id",\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "pj_project_id",\n        "s_site_id",\n        "customer_site_code",\n        "package_name",\n        "por_category",\n    ]\n    for col in optional_eq_cols:\n        v = filters.get(col)\n        if v is not None and str(v) != "":\n            vv = _esc(v)\n            where_parts.append(f"m.\\"{col}\\" = \'{vv}\'")\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n        WITH cycle_times AS (\n            SELECT\n                m."rgn_region",\n                m."m_area",\n                m."m_market",\n                m."construction_gc",\n                m."pj_project_id",\n                m."s_site_id",\n                m."package_name",\n                COUNT(*) AS business_day_diff\n            FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined m\n            CROSS JOIN LATERAL generate_series(\n                m."scop_tw_checklist_submitted_to_customer"::date,\n                m."scop_checklist_accepted_by_customer"::date,\n                INTERVAL \'1 day\'\n            ) AS g\n            WHERE {where_sql}\n            GROUP BY\n                m."rgn_region",\n                m."m_area",\n                m."m_market",\n                m."construction_gc",\n                m."pj_project_id",\n                m."s_site_id",\n                m."package_name"\n        )\n        SELECT\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "construction_gc",\n\n            COUNT(DISTINCT "pj_project_id") AS total_sites_accepted,\n\n            COUNT(DISTINCT CASE WHEN business_day_diff <= 14\n                                THEN "pj_project_id" END) AS within_sla_count,\n\n            COUNT(DISTINCT CASE WHEN business_day_diff >  14\n                                THEN "pj_project_id" END) AS without_sla_count,\n\n            (100.0 *\n                COUNT(DISTINCT CASE WHEN business_day_diff <= 14\n                                    THEN "pj_project_id" END)\n                / NULLIF(COUNT(DISTINCT "pj_project_id"), 0)\n            ) AS within_sla_pct,\n\n            AVG(business_day_diff)::float AS avg_business_days,\n            MIN(business_day_diff) AS min_business_days,\n            MAX(business_day_diff) AS max_business_days\n\n        FROM cycle_times\n        GROUP BY "rgn_region", "m_area", "m_market", "construction_gc"\n        ORDER BY "rgn_region", "m_area", "m_market", "construction_gc"\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['stg_ndpd_mbt_tmobile_macro_combined.pj_project_id', 'stg_ndpd_mbt_tmobile_macro_combined.s_site_id', 'stg_ndpd_mbt_tmobile_macro_combined.customer_site_code', 'stg_ndpd_mbt_tmobile_macro_combined.smp_id', 'stg_ndpd_mbt_tmobile_macro_combined.smp_name', 'stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'stg_ndpd_mbt_tmobile_macro_combined.m_area', 'stg_ndpd_mbt_tmobile_macro_combined.m_market', 'stg_ndpd_mbt_tmobile_macro_combined.construction_gc', 'stg_ndpd_mbt_tmobile_macro_combined.package_name', 'stg_ndpd_mbt_tmobile_macro_combined.por_category', 'stg_ndpd_mbt_tmobile_macro_combined.scop_tw_checklist_submitted_to_customer', 'stg_ndpd_mbt_tmobile_macro_combined.scop_checklist_accepted_by_customer'], session_id: '69a3d22f26e208edc083a06e', label: 'SCOP Acceptance Cycle Time', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market', 'closeout_package'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '109ef604-2e52-4082-8ebe-d4297e9daa52', entity_type: 'kpi', kpi_name: 'SCOP Acceptance Cycle Time', name: '109ef604-2e52-4082-8ebe-d4297e9daa52', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Customer SLA metric for SCOP acceptance speed — answers \'how quickly did the customer accept the Tower-Work SCOP checklist after submission?\'. Counted in BUSINESS DAYS only (Mon-Fri). Primary output is the within_sla_pct (% of cycles closed within 14 business days), plus raw counts and avg/min/max cycle days. Use this node for any query mentioning SCOP/COP acceptance time, customer SLA, 14-day SLA, days-to-accept, or cycle time between submission and acceptance. Distinct from SCOP/COP Quality Rate (measures FTR/approval quality, not speed) and SCOP Approval Pending (measures volume awaiting TMO approval, not closed cycles).', status: 'mentioned', node_id: '109ef604-2e52-4082-8ebe-d4297e9daa52'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'avg_material_to_closeout_days = AVG(ms_1559_cop_approved_by_t_mobile_spo_issued_date::date - pj_a_3925_msl_pickup_date_finish::date) rounded to 2 decimals, computed only over rows where both timestamps are NOT NULL and closeout::date >= pickup::date. site_count = COUNT(DISTINCT pj_project_id) over the same set. Aggregated by (rgn_region, m_area, m_market, construction_gc). Source: stg_ndpd_mbt_tmobile_macro_combined (single table, no JOIN).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping dimension."}, {"column": "m_area", "type": "string", "description": "Area grouping dimension."}, {"column": "m_market", "type": "string", "description": "Market grouping dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping dimension."}, {"column": "avg_material_to_closeout_days", "type": "float", "description": "Average days from material pickup (pj_a_3925_msl_pickup_date_finish) to site closeout / SPO issuance (ms_1559_cop_approved_by_t_mobile_spo_issued_date), rounded to 2 decimals."}, {"column": "site_count", "type": "int", "description": "Distinct project count (COUNT(DISTINCT pj_project_id)) underlying the average."}]', kpi_business_logic: '1) Single source: stg_ndpd_mbt_tmobile_macro_combined (no JOIN). 2) Mandatory NOT NULL predicates on both date columns + guard closeout_date::date >= pickup_date::date (rejects malformed data where closeout is before pickup). 3) Apply optional equality filters: smp_name (supports both \'NTM\' and \'AHLOB Modernization\'), smp_id, rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id, customer_site_code, ntm_project_type, package_name, por_category. 4) Apply optional date range filter (start_date / end_date) on ms_1559_cop_approved_by_t_mobile_spo_issued_date::date. 5) GROUP BY rgn_region, m_area, m_market, construction_gc. 6) avg_material_to_closeout_days = ROUND(AVG(closeout::date - pickup::date)::numeric, 2). 7) site_count = COUNT(DISTINCT pj_project_id).', kpi_filters: '[{"name": "smp_name", "type": "string", "description": "Optional equality filter on smp_name (e.g., \'NTM\' or \'AHLOB Modernization\')."}, {"name": "smp_id", "type": "string", "description": "Optional equality filter on smp_id."}, {"name": "rgn_region", "type": "string", "description": "Optional equality filter on rgn_region."}, {"name": "m_area", "type": "string", "description": "Optional equality filter on m_area."}, {"name": "m_market", "type": "string", "description": "Optional equality filter on m_market."}, {"name": "construction_gc", "type": "string", "description": "Optional equality filter on construction_gc."}, {"name": "pj_project_id", "type": "string", "description": "Optional equality filter on pj_project_id."}, {"name": "s_site_id", "type": "string", "description": "Optional equality filter on s_site_id."}, {"name": "customer_site_code", "type": "string", "description": "Optional equality filter on customer_site_code."}, {"name": "ntm_project_type", "type": "string", "description": "Optional equality filter on ntm_project_type (NTM-specific). Useful when smp_name=\'NTM\'."}, {"name": "package_name", "type": "string", "description": "Optional equality filter on package_name."}, {"name": "por_category", "type": "string", "description": "Optional equality filter on por_category."}, {"name": "start_date", "type": "date", "description": "Lower bound on ms_1559_cop_approved_by_t_mobile_spo_issued_date::date."}, {"name": "end_date", "type": "date", "description": "Upper bound on ms_1559_cop_approved_by_t_mobile_spo_issued_date::date."}]', kpi_contract: '{"function_name": "get_material_to_site_closeout_lead_time", "node_type": "kpi", "node_id": "be4f97d5-d5d5-4674-84a0-685f21b1a6c2", "node_label": "Material to Site Closeout Lead Time", "description": "Material to Site Closeout Lead Time \\u2014 average calendar days between material pickup (pj_a_3925_msl_pickup_date_finish) and site closeout / SPO issuance (ms_1559_cop_approved_by_t_mobile_spo_issued_date). Source: stg_ndpd_mbt_tmobile_macro_combined (single table, no JOIN). Aggregated by (rgn_region, m_area, m_market, construction_gc).\\n\\nWhen to use this node: agent should pick this for any question about days from material pickup to site closeout, lead time from MSL pickup to COP/SPO, GC-level closeout speed, or \'which GCs are slowest/fastest at closing sites once materials arrive\'. Works for both NTM and AHLOB Modernization programs \\u2014 pass smp_name as a filter to narrow. Pair with ntm_project_type filter for NTM-program-type slicing.\\n\\nDistinct from SCOP Acceptance Cycle Time (measures customer review/acceptance time, different milestones) and Material Pickup Timeliness (measures BOM-receipt-to-pickup aging, different metric entirely).", "parameters": [{"name": "smp_name", "type": "string", "description": "Filter by program (e.g., \'NTM\', \'AHLOB Modernization\').", "required": false, "sample_values": ["NTM", "AHLOB Modernization"]}, {"name": "smp_id", "type": "string", "description": "Filter by smp_id.", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by region.", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by area.", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by market.", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by GC.", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Filter by pj_project_id.", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s_site_id.", "required": false, "sample_values": []}, {"name": "customer_site_code", "type": "string", "description": "Filter by customer_site_code.", "required": false, "sample_values": []}, {"name": "ntm_project_type", "type": "string", "description": "Filter by NTM project type.", "required": false, "sample_values": []}, {"name": "package_name", "type": "string", "description": "Filter by package_name.", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por_category.", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Lower bound on closeout/SPO-issued date.", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Upper bound on closeout/SPO-issued date.", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": true}, {"name": "m_area", "type": "string", "nullable": true}, {"name": "m_market", "type": "string", "nullable": true}, {"name": "construction_gc", "type": "string", "nullable": true}, {"name": "avg_material_to_closeout_days", "type": "number", "nullable": true}, {"name": "site_count", "type": "number", "nullable": false}], "sample_output": [], "row_count": 10}', nl_description: 'Material to Site Closeout Lead Time = AVG(ms_1559_cop_approved_by_t_mobile_spo_issued_date::date - pj_a_3925_msl_pickup_date_finish::date) per (rgn_region, m_area, m_market, construction_gc). Computed only over rows where both timestamps are NOT NULL and closeout >= pickup. Source: stg_ndpd_mbt_tmobile_macro_combined. Works for both NTM and AHLOB Modernization (pass smp_name). Output: avg_material_to_closeout_days (rounded 2dp), site_count (DISTINCT pj_project_id). Optional filters: smp_name, smp_id, geo dims, entity IDs, ntm_project_type, package_name, por_category, plus date-range on the closeout (SPO-issued) date.', node_type: 'CORE', definition: 'Material to Site Closeout Lead Time = AVG(ms_1559_cop_approved_by_t_mobile_spo_issued_date::date - pj_a_3925_msl_pickup_date_finish::date) per (rgn_region, m_area, m_market, construction_gc). Computed only over rows where both timestamps are NOT NULL and closeout >= pickup. Source: stg_ndpd_mbt_tmobile_macro_combined. Works for both NTM and AHLOB Modernization (pass smp_name). Output: avg_material_to_closeout_days (rounded 2dp), site_count (DISTINCT pj_project_id). Optional filters: smp_name, smp_id, geo dims, entity IDs, ntm_project_type, package_name, por_category, plus date-range on the closeout (SPO-issued) date.', kpi_python_function: 'def get_material_to_site_closeout_lead_time(execute_query, filters=None) -> list[dict]:\n    """Material to Site Closeout Lead Time.\n\n    Average calendar days between material pickup (pj_a_3925_msl_pickup_date_finish)\n    and site closeout / SPO issuance (ms_1559_cop_approved_by_t_mobile_spo_issued_date),\n    aggregated by (rgn_region, m_area, m_market, construction_gc).\n\n    Hardwired predicates (always applied):\n      - pj_a_3925_msl_pickup_date_finish IS NOT NULL\n      - ms_1559_cop_approved_by_t_mobile_spo_issued_date IS NOT NULL\n      - closeout_date::date >= material_pickup_date::date  (guard against malformed data)\n\n    Output (one row per (rgn_region, m_area, m_market, construction_gc)):\n      - avg_material_to_closeout_days : AVG(closeout::date - pickup::date)\n      - site_count                    : COUNT(DISTINCT pj_project_id)\n\n    Source: stg_ndpd_mbt_tmobile_macro_combined (single table, no JOIN).\n\n    Optional filters (all equality, all optional):\n      - smp_name                : e.g., \'NTM\', \'AHLOB Modernization\'\n      - smp_id, pj_project_id, s_site_id, customer_site_code\n      - rgn_region, m_area, m_market, construction_gc\n      - ntm_project_type, package_name, por_category\n      - start_date, end_date    : applied to\n            ms_1559_cop_approved_by_t_mobile_spo_issued_date::date\n    """\n    filters = filters or {}\n\n    def _esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    where_parts = [\n        "\\"pj_a_3925_msl_pickup_date_finish\\" IS NOT NULL",\n        "\\"ms_1559_cop_approved_by_t_mobile_spo_issued_date\\" IS NOT NULL",\n        "\\"ms_1559_cop_approved_by_t_mobile_spo_issued_date\\"::date >= \\"pj_a_3925_msl_pickup_date_finish\\"::date",\n    ]\n\n    # Date-range filters on the closeout (SPO-issued) date\n    if filters.get("start_date"):\n        where_parts.append(\n            f"\\"ms_1559_cop_approved_by_t_mobile_spo_issued_date\\"::date >= DATE \'{_esc(filters[\'start_date\'])}\'"\n        )\n    if filters.get("end_date"):\n        where_parts.append(\n            f"\\"ms_1559_cop_approved_by_t_mobile_spo_issued_date\\"::date <= DATE \'{_esc(filters[\'end_date\'])}\'"\n        )\n\n    optional_eq_cols = [\n        "smp_name",\n        "smp_id",\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "pj_project_id",\n        "s_site_id",\n        "customer_site_code",\n        "ntm_project_type",\n        "package_name",\n        "por_category",\n    ]\n    for col in optional_eq_cols:\n        v = filters.get(col)\n        if v is not None and str(v) != "":\n            vv = _esc(v)\n            where_parts.append(f"\\"{col}\\" = \'{vv}\'")\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n        SELECT\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "construction_gc",\n\n            ROUND(\n                AVG(\n                    "ms_1559_cop_approved_by_t_mobile_spo_issued_date"::date\n                    - "pj_a_3925_msl_pickup_date_finish"::date\n                )::numeric,\n                2\n            ) AS avg_material_to_closeout_days,\n\n            COUNT(DISTINCT "pj_project_id") AS site_count\n\n        FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n        WHERE {where_sql}\n        GROUP BY "rgn_region", "m_area", "m_market", "construction_gc"\n        ORDER BY "rgn_region", "m_area", "m_market", "construction_gc"\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['stg_ndpd_mbt_tmobile_macro_combined.pj_project_id', 'stg_ndpd_mbt_tmobile_macro_combined.s_site_id', 'stg_ndpd_mbt_tmobile_macro_combined.customer_site_code', 'stg_ndpd_mbt_tmobile_macro_combined.smp_id', 'stg_ndpd_mbt_tmobile_macro_combined.smp_name', 'stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'stg_ndpd_mbt_tmobile_macro_combined.m_area', 'stg_ndpd_mbt_tmobile_macro_combined.m_market', 'stg_ndpd_mbt_tmobile_macro_combined.construction_gc', 'stg_ndpd_mbt_tmobile_macro_combined.ntm_project_type', 'stg_ndpd_mbt_tmobile_macro_combined.package_name', 'stg_ndpd_mbt_tmobile_macro_combined.por_category', 'stg_ndpd_mbt_tmobile_macro_combined.pj_a_3925_msl_pickup_date_finish', 'stg_ndpd_mbt_tmobile_macro_combined.ms_1559_cop_approved_by_t_mobile_spo_issued_date'], session_id: '69a3d22f26e208edc083a06e', label: 'Material to Site Closeout Lead Time', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market', 'material_equipment', 'closeout_package'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'be4f97d5-d5d5-4674-84a0-685f21b1a6c2', entity_type: 'kpi', kpi_name: 'Material to Site Closeout Lead Time', name: 'be4f97d5-d5d5-4674-84a0-685f21b1a6c2', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'GC-vs-GC and geo-vs-geo lead-time comparison — answers \'how long does it take, on average, from material pickup to site closeout (COP approved + SPO issued)?\'. Useful for identifying General Contractors and markets with the slowest end-to-end closeout pipelines once materials are on site. Source: stg_ndpd_mbt_tmobile_macro_combined. Default grain: (rgn_region, m_area, m_market, construction_gc) — filterable by smp_name to choose between \'NTM\' and \'AHLOB Modernization\', and by ntm_project_type for NTM-program-type slicing.', status: 'mentioned', node_id: 'be4f97d5-d5d5-4674-84a0-685f21b1a6c2'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_services_ndpc_answers_daily_from_sdb', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'customer_approval_rate = ROUND(100.0 * SUM(CASE WHEN formanswerstatus=\'6\' THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN formanswerstatus IN (\'6\',\'7\') THEN 1 ELSE 0 END), 0), 2); customer_rejection_rate = ROUND(100.0 * SUM(CASE WHEN formanswerstatus=\'7\' THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN formanswerstatus IN (\'6\',\'7\') THEN 1 ELSE 0 END), 0), 2); nokia_approval_rate = ROUND(100.0 * SUM(CASE WHEN formanswerstatus IN (\'1\',\'4\') THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN formanswerstatus IN (\'1\',\'2\',\'4\') THEN 1 ELSE 0 END), 0), 2); nokia_rejection_rate = ROUND(100.0 * SUM(CASE WHEN formanswerstatus=\'2\' THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN formanswerstatus IN (\'1\',\'2\',\'4\') THEN 1 ELSE 0 END), 0), 2). Grouped by (rgn_region, m_area, m_market, construction_gc).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region group-by dimension."}, {"column": "m_area", "type": "string", "description": "Area group-by dimension."}, {"column": "m_market", "type": "string", "description": "Market group-by dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor group-by dimension."}, {"column": "customer_reviewed_count", "type": "int", "description": "Count of answers with formanswerstatus IN (\'6\',\'7\')."}, {"column": "customer_approved_count", "type": "int", "description": "Count of answers with formanswerstatus = \'6\' (customer approved)."}, {"column": "customer_rejected_count", "type": "int", "description": "Count of answers with formanswerstatus = \'7\' (customer rejected)."}, {"column": "nokia_reviewed_count", "type": "int", "description": "Count of answers with formanswerstatus IN (\'1\',\'2\',\'4\')."}, {"column": "nokia_approved_count", "type": "int", "description": "Count of answers with formanswerstatus IN (\'1\',\'4\') (Nokia human + Nokia AI approval)."}, {"column": "nokia_rejected_count", "type": "int", "description": "Count of answers with formanswerstatus = \'2\' (Nokia rejected)."}, {"column": "customer_approval_rate", "type": "float", "description": "100.0 * customer_approved_count / NULLIF(customer_reviewed_count, 0); rounded to 2dp."}, {"column": "customer_rejection_rate", "type": "float", "description": "100.0 * customer_rejected_count / NULLIF(customer_reviewed_count, 0); rounded to 2dp."}, {"column": "nokia_approval_rate", "type": "float", "description": "100.0 * nokia_approved_count / NULLIF(nokia_reviewed_count, 0); rounded to 2dp."}, {"column": "nokia_rejection_rate", "type": "float", "description": "100.0 * nokia_rejected_count / NULLIF(nokia_reviewed_count, 0); rounded to 2dp."}]', kpi_business_logic: '1) Join NDPc answers (a) to macro_combined (b) ON a.sessiontitle = b.scop_title. 2) Restrict to a.formanswerstatus IN (\'1\',\'2\',\'4\',\'6\',\'7\') — the union of customer and Nokia review universes. 3) Apply optional equality filters on the macro side (b.*): smp_name, smp_id, rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id, customer_site_code, package_name, por_category; scop_title applies to a.sessiontitle. 4) Optional start_date/end_date apply to a.formanswerdate::date. 5) Compute customer-side and Nokia-side counts via CASE-WHEN-SUM: customer_reviewed=IN(\'6\',\'7\'); customer_approved=\'6\'; customer_rejected=\'7\'; nokia_reviewed=IN(\'1\',\'2\',\'4\'); nokia_approved=IN(\'1\',\'4\') [human + AI]; nokia_rejected=\'2\'. 6) Compute rates as ROUND(numerator*100.0 / NULLIF(denom, 0), 2): customer_approval_rate=approved/reviewed; customer_rejection_rate=rejected/reviewed; nokia_approval_rate=(1+4)/(1+2+4); nokia_rejection_rate=2/(1+2+4). 7) Group by (b.rgn_region, b.m_area, b.m_market, b.construction_gc).', kpi_filters: '[{"name": "smp_name", "type": "string", "description": "Optional equality filter on smp_name (program filter, e.g., NTM, AHLOB Modernization)."}, {"name": "smp_id", "type": "string", "description": "Optional equality filter on smp_id."}, {"name": "rgn_region", "type": "string", "description": "Optional equality filter on rgn_region."}, {"name": "m_area", "type": "string", "description": "Optional equality filter on m_area."}, {"name": "m_market", "type": "string", "description": "Optional equality filter on m_market."}, {"name": "construction_gc", "type": "string", "description": "Optional equality filter on construction_gc."}, {"name": "pj_project_id", "type": "string", "description": "Optional equality filter on pj_project_id."}, {"name": "s_site_id", "type": "string", "description": "Optional equality filter on s_site_id."}, {"name": "customer_site_code", "type": "string", "description": "Optional equality filter on customer_site_code."}, {"name": "package_name", "type": "string", "description": "Optional equality filter on package_name."}, {"name": "por_category", "type": "string", "description": "Optional equality filter on por_category."}, {"name": "scop_title", "type": "string", "description": "Optional equality filter on a.sessiontitle (the JOIN key) \\u2014 narrows to a specific quality session."}, {"name": "start_date", "type": "date", "description": "Lower bound on a.formanswerdate::date."}, {"name": "end_date", "type": "date", "description": "Upper bound on a.formanswerdate::date."}]', kpi_contract: '{"function_name": "get_customer_nokia_approval_rejection_rate", "node_type": "kpi", "node_id": "4dc0ff1a-6af1-4835-91ac-f3768dfb5b21", "node_label": "Customer & Nokia Approval & Rejection Rate", "description": "Customer & Nokia Approval & Rejection Rate \\u2014 answer-level percentages on BOTH sides of the workflow. Customer side: % of customer-reviewed answers (formanswerstatus IN (\'6\',\'7\')) that the customer approved (\'6\') vs rejected (\'7\'). Nokia side: % of Nokia-reviewed answers (formanswerstatus IN (\'1\',\'2\',\'4\')) that Nokia approved (human \'1\' + AI \'4\') vs rejected (\'2\'). Source: stg_services_ndpc_answers_daily_from_sdb JOIN stg_ndpd_mbt_tmobile_macro_combined ON sessiontitle = scop_title. Output is grouped by (rgn_region, m_area, m_market, construction_gc) and exposes 6 raw counts (customer_reviewed_count, customer_approved_count, customer_rejected_count, nokia_reviewed_count, nokia_approved_count, nokia_rejected_count) plus 4 rates (customer_approval_rate, customer_rejection_rate, nokia_approval_rate, nokia_rejection_rate). Open filter surface: smp_name, smp_id, rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id, customer_site_code, package_name, por_category, scop_title; start_date/end_date apply to formanswerdate. Distinct from NDPc Quality FTR Rate (which exposes site-level FTR only and excludes Nokia statuses) and from Customer & Nokia Punch Point Count (the volume-count counterpart). formanswerstatus map: \'0\'=submitted, \'1\'=Nokia-approved, \'2\'=Nokia-rejected, \'3\'=not-submitted, \'4\'=Nokia-AI-approved, \'6\'=customer-approved, \'7\'=customer-rejected. Traversal hints: customer approval rate, customer rejection rate, Nokia approval rate, Nokia rejection rate, % of approvals / rejections, Nokia AI approval rate.", "parameters": [{"name": "smp_name", "type": "string", "description": "Optional equality filter on smp_name (program filter, e.g., NTM, AHLOB Modernization).", "required": false, "sample_values": []}, {"name": "smp_id", "type": "string", "description": "Optional equality filter on smp_id.", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Optional equality filter on rgn_region.", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Optional equality filter on m_area.", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Optional equality filter on m_market.", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Optional equality filter on construction_gc.", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Optional equality filter on pj_project_id.", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Optional equality filter on s_site_id.", "required": false, "sample_values": []}, {"name": "customer_site_code", "type": "string", "description": "Optional equality filter on customer_site_code.", "required": false, "sample_values": []}, {"name": "package_name", "type": "string", "description": "Optional equality filter on package_name.", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Optional equality filter on por_category.", "required": false, "sample_values": []}, {"name": "scop_title", "type": "string", "description": "Optional equality filter on a.sessiontitle (the JOIN key) \\u2014 narrows to a specific quality session.", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Lower bound on a.formanswerdate::date.", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Upper bound on a.formanswerdate::date.", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": true}, {"name": "m_area", "type": "string", "nullable": true}, {"name": "m_market", "type": "string", "nullable": true}, {"name": "construction_gc", "type": "string", "nullable": true}, {"name": "customer_reviewed_count", "type": "number", "nullable": false}, {"name": "customer_approved_count", "type": "number", "nullable": false}, {"name": "customer_rejected_count", "type": "number", "nullable": false}, {"name": "nokia_reviewed_count", "type": "number", "nullable": false}, {"name": "nokia_approved_count", "type": "number", "nullable": false}, {"name": "nokia_rejected_count", "type": "number", "nullable": false}, {"name": "customer_approval_rate", "type": "number", "nullable": false}, {"name": "customer_rejection_rate", "type": "number", "nullable": false}, {"name": "nokia_approval_rate", "type": "number", "nullable": false}, {"name": "nokia_rejection_rate", "type": "number", "nullable": false}], "sample_output": [], "row_count": 14}', nl_description: 'Answer-level approval/rejection rates on BOTH review sides. Customer side: \'6\' (approved) vs \'7\' (rejected) over (\'6\'+\'7\'). Nokia side: (\'1\'+\'4\') (human + AI approved) vs \'2\' (rejected) over (\'1\'+\'2\'+\'4\'). Source: NDPc answers JOIN macro_combined ON sessiontitle = scop_title. Grouped by (rgn_region, m_area, m_market, construction_gc); returns 6 raw counts + 4 rates. Paired with `Customer & Nokia Punch Point Count` (volume counterpart).', node_type: 'CORE', definition: 'Answer-level approval/rejection rates on BOTH review sides. Customer side: \'6\' (approved) vs \'7\' (rejected) over (\'6\'+\'7\'). Nokia side: (\'1\'+\'4\') (human + AI approved) vs \'2\' (rejected) over (\'1\'+\'2\'+\'4\'). Source: NDPc answers JOIN macro_combined ON sessiontitle = scop_title. Grouped by (rgn_region, m_area, m_market, construction_gc); returns 6 raw counts + 4 rates. Paired with `Customer & Nokia Punch Point Count` (volume counterpart).', kpi_python_function: 'def get_customer_nokia_approval_rejection_rate(execute_query, filters=None) -> list[dict]:\n    """Customer & Nokia Approval & Rejection Rate.\n\n    Answer-level approval/rejection rate KPI for BOTH sides of the workflow:\n      - Customer (T-Mobile) accept vs reject\n      - Nokia (human + AI) accept vs reject\n\n    formanswerstatus value map:\n      \'0\' = submitted\n      \'1\' = submission approved by Nokia (human reviewer)\n      \'2\' = rejected by Nokia\n      \'3\' = not submitted\n      \'4\' = approved by Nokia\'s AI\n      \'6\' = accepted/approved by customer (T-Mobile)\n      \'7\' = rejected by customer (T-Mobile)\n\n    Bucket definitions:\n      - Customer reviewed  = formanswerstatus IN (\'6\',\'7\')\n      - Customer approved  = formanswerstatus = \'6\'\n      - Customer rejected  = formanswerstatus = \'7\'\n      - Nokia reviewed     = formanswerstatus IN (\'1\',\'2\',\'4\')\n      - Nokia approved     = formanswerstatus IN (\'1\',\'4\')   # human + AI\n      - Nokia rejected     = formanswerstatus = \'2\'\n\n    Source:\n      pwc_macro_staging_schema.stg_services_ndpc_answers_daily_from_sdb a\n      JOIN pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined b\n        ON a."sessiontitle" = b."scop_title"\n\n    Output (one row per rgn_region, m_area, m_market, construction_gc):\n      customer_reviewed_count, customer_approved_count, customer_rejected_count,\n      nokia_reviewed_count,    nokia_approved_count,    nokia_rejected_count,\n      customer_approval_rate, customer_rejection_rate,\n      nokia_approval_rate,    nokia_rejection_rate\n\n    Optional filters (all equality, all optional):\n      smp_name, smp_id,\n      rgn_region, m_area, m_market, construction_gc,\n      pj_project_id, s_site_id, customer_site_code,\n      package_name, por_category,\n      scop_title,\n      start_date, end_date (applied to a."formanswerdate"::date)\n    """\n    filters = filters or {}\n\n    def esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    where_parts = ["a.\\"formanswerstatus\\" IN (\'1\',\'2\',\'4\',\'6\',\'7\')"]\n\n    optional_eq_cols = [\n        "smp_name",\n        "smp_id",\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "pj_project_id",\n        "s_site_id",\n        "customer_site_code",\n        "package_name",\n        "por_category",\n    ]\n    for col in optional_eq_cols:\n        v = filters.get(col)\n        if v is not None and str(v) != "":\n            where_parts.append(f\'b."{col}" = \\\'{esc(v)}\\\'\')\n\n    scop_title = filters.get("scop_title")\n    if scop_title is not None and str(scop_title) != "":\n        where_parts.append(f\'a."sessiontitle" = \\\'{esc(scop_title)}\\\'\')\n\n    start_date = filters.get("start_date")\n    end_date = filters.get("end_date")\n    if start_date:\n        where_parts.append(f"a.\\"formanswerdate\\"::date >= DATE \'{esc(start_date)}\'")\n    if end_date:\n        where_parts.append(f"a.\\"formanswerdate\\"::date <= DATE \'{esc(end_date)}\'")\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n        SELECT\n            b."rgn_region",\n            b."m_area",\n            b."m_market",\n            b."construction_gc",\n\n            SUM(CASE WHEN a."formanswerstatus" IN (\'6\',\'7\') THEN 1 ELSE 0 END) AS customer_reviewed_count,\n            SUM(CASE WHEN a."formanswerstatus" = \'6\'        THEN 1 ELSE 0 END) AS customer_approved_count,\n            SUM(CASE WHEN a."formanswerstatus" = \'7\'        THEN 1 ELSE 0 END) AS customer_rejected_count,\n\n            SUM(CASE WHEN a."formanswerstatus" IN (\'1\',\'2\',\'4\') THEN 1 ELSE 0 END) AS nokia_reviewed_count,\n            SUM(CASE WHEN a."formanswerstatus" IN (\'1\',\'4\')     THEN 1 ELSE 0 END) AS nokia_approved_count,\n            SUM(CASE WHEN a."formanswerstatus" = \'2\'            THEN 1 ELSE 0 END) AS nokia_rejected_count,\n\n            ROUND(\n                SUM(CASE WHEN a."formanswerstatus" = \'6\' THEN 1 ELSE 0 END) * 100.0\n                / NULLIF(SUM(CASE WHEN a."formanswerstatus" IN (\'6\',\'7\') THEN 1 ELSE 0 END), 0),\n                2\n            ) AS customer_approval_rate,\n\n            ROUND(\n                SUM(CASE WHEN a."formanswerstatus" = \'7\' THEN 1 ELSE 0 END) * 100.0\n                / NULLIF(SUM(CASE WHEN a."formanswerstatus" IN (\'6\',\'7\') THEN 1 ELSE 0 END), 0),\n                2\n            ) AS customer_rejection_rate,\n\n            ROUND(\n                SUM(CASE WHEN a."formanswerstatus" IN (\'1\',\'4\') THEN 1 ELSE 0 END) * 100.0\n                / NULLIF(SUM(CASE WHEN a."formanswerstatus" IN (\'1\',\'2\',\'4\') THEN 1 ELSE 0 END), 0),\n                2\n            ) AS nokia_approval_rate,\n\n            ROUND(\n                SUM(CASE WHEN a."formanswerstatus" = \'2\' THEN 1 ELSE 0 END) * 100.0\n                / NULLIF(SUM(CASE WHEN a."formanswerstatus" IN (\'1\',\'2\',\'4\') THEN 1 ELSE 0 END), 0),\n                2\n            ) AS nokia_rejection_rate\n\n        FROM pwc_macro_staging_schema.stg_services_ndpc_answers_daily_from_sdb a\n        JOIN pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined b\n            ON a."sessiontitle" = b."scop_title"\n        WHERE {where_sql}\n        GROUP BY b."rgn_region", b."m_area", b."m_market", b."construction_gc"\n        ORDER BY b."rgn_region", b."m_area", b."m_market", b."construction_gc"\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['stg_services_ndpc_answers_daily_from_sdb.sessiontitle', 'stg_services_ndpc_answers_daily_from_sdb.formanswerstatus', 'stg_services_ndpc_answers_daily_from_sdb.formanswerdate', 'stg_ndpd_mbt_tmobile_macro_combined.scop_title', 'stg_ndpd_mbt_tmobile_macro_combined.pj_project_id', 'stg_ndpd_mbt_tmobile_macro_combined.s_site_id', 'stg_ndpd_mbt_tmobile_macro_combined.customer_site_code', 'stg_ndpd_mbt_tmobile_macro_combined.smp_id', 'stg_ndpd_mbt_tmobile_macro_combined.smp_name', 'stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'stg_ndpd_mbt_tmobile_macro_combined.m_area', 'stg_ndpd_mbt_tmobile_macro_combined.m_market', 'stg_ndpd_mbt_tmobile_macro_combined.construction_gc', 'stg_ndpd_mbt_tmobile_macro_combined.package_name', 'stg_ndpd_mbt_tmobile_macro_combined.por_category'], session_id: '69a3d22f26e208edc083a06e', label: 'Customer & Nokia Approval & Rejection Rate', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market', 'quality_answer'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '4dc0ff1a-6af1-4835-91ac-f3768dfb5b21', entity_type: 'kpi', kpi_name: 'Customer & Nokia Approval & Rejection Rate', name: '4dc0ff1a-6af1-4835-91ac-f3768dfb5b21', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Answer-level approval/rejection rates on BOTH review sides. Customer side: \'6\' (approved) vs \'7\' (rejected) over (\'6\'+\'7\'). Nokia side: (\'1\'+\'4\') (human + AI approved) vs \'2\' (rejected) over (\'1\'+\'2\'+\'4\'). Source: NDPc answers JOIN macro_combined ON sessiontitle = scop_title. Grouped by (rgn_region, m_area, m_market, construction_gc); returns 6 raw counts + 4 rates. Paired with `Customer & Nokia Punch Point Count` (volume counterpart).', status: 'mentioned', node_id: '4dc0ff1a-6af1-4835-91ac-f3768dfb5b21'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_services_ndpc_answers_daily_from_sdb', 'pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined', 'pwc_macro_staging_schema.stg_tmo_rejections_master_file'], nl_business_rule: '', kpi_formula_description: 'Per row (one per geo × reason): customer_punch_point_count = COUNT(DISTINCT CASE WHEN a.formanswerstatus = \'7\' THEN a.id END); nokia_punch_point_count   = COUNT(DISTINCT CASE WHEN a.formanswerstatus IN (\'2\',\'4\') THEN a.id END). Reason column = t.trmf_tmo_punch_point_details via LEFT JOIN on t.trmf_smp_id = b.smp_id. COUNT(DISTINCT a.id) keeps counts accurate under the one-smp-to-many-rejections fan-out. Grouped by (rgn_region, m_area, m_market, construction_gc, punch_point_reason).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region group-by dimension."}, {"column": "m_area", "type": "string", "description": "Area group-by dimension."}, {"column": "m_market", "type": "string", "description": "Market group-by dimension."}, {"column": "construction_gc", "type": "string", "description": "General contractor group-by dimension."}, {"column": "customer_punch_point_count", "type": "int", "description": "Count of answers with formanswerstatus = \'7\' (customer-rejected = customer punch point)."}, {"column": "nokia_punch_point_count", "type": "int", "description": "Count of answers with formanswerstatus IN (\'2\',\'4\') (Nokia-rejected OR Nokia-AI-approved = Nokia punch point)."}]', kpi_business_logic: '1) Join ndpc answers (a) to macro_combined (b) ON a.sessiontitle = b.scop_title. 2) LEFT JOIN stg_tmo_rejections_master_file (t) on t.trmf_smp_id = b.smp_id to surface the rejection reason. 3) Restrict to a.formanswerstatus IN (\'2\',\'4\',\'7\') — the union of punch-point producing statuses. 4) Apply optional equality filters on the macro side (b.*): smp_name, smp_id, rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id, customer_site_code, package_name, por_category; scop_title applies to a.sessiontitle. 5) Optional start_date / end_date apply to a.formanswerdate::date. 6) Count punch points by source using DISTINCT on a.id so the LEFT JOIN\'s potential fan-out (one smp → many trmf rows) cannot inflate counts: customer_punch_point_count = COUNT(DISTINCT CASE WHEN a.formanswerstatus=\'7\' THEN a.id END); nokia_punch_point_count   = COUNT(DISTINCT CASE WHEN a.formanswerstatus IN (\'2\',\'4\') THEN a.id END). 7) GROUP BY (b.rgn_region, b.m_area, b.m_market, b.construction_gc, t.trmf_tmo_punch_point_details). 8) Rows whose smp has no trmf record are kept with punch_point_reason = NULL.', kpi_filters: '[{"name": "smp_name", "type": "string", "description": "Optional equality filter on smp_name (program filter, e.g., NTM, AHLOB Modernization)."}, {"name": "smp_id", "type": "string", "description": "Optional equality filter on smp_id."}, {"name": "rgn_region", "type": "string", "description": "Optional equality filter on rgn_region."}, {"name": "m_area", "type": "string", "description": "Optional equality filter on m_area."}, {"name": "m_market", "type": "string", "description": "Optional equality filter on m_market."}, {"name": "construction_gc", "type": "string", "description": "Optional equality filter on construction_gc."}, {"name": "pj_project_id", "type": "string", "description": "Optional equality filter on pj_project_id."}, {"name": "s_site_id", "type": "string", "description": "Optional equality filter on s_site_id."}, {"name": "customer_site_code", "type": "string", "description": "Optional equality filter on customer_site_code."}, {"name": "package_name", "type": "string", "description": "Optional equality filter on package_name."}, {"name": "por_category", "type": "string", "description": "Optional equality filter on por_category."}, {"name": "scop_title", "type": "string", "description": "Optional equality filter on a.sessiontitle (the JOIN key)."}, {"name": "start_date", "type": "date", "description": "Lower bound on a.formanswerdate::date."}, {"name": "end_date", "type": "date", "description": "Upper bound on a.formanswerdate::date."}]', kpi_contract: '{"function_name": "get_customer_nokia_punch_point_count", "node_type": "kpi", "node_id": "5cc3d858-db28-46fb-920a-6439c9dc2c7b", "node_label": "Customer & Nokia Punch Point Count", "description": "Answer-level punch-point volume by source with per-reason breakdown. Customer punch point = formanswerstatus = \'7\' (T-Mobile rejected). Nokia punch point = formanswerstatus IN (\'2\',\'4\') (Nokia rejected or Nokia AI flagged). Reasons are exposed via LEFT JOIN to stg_tmo_rejections_master_file on t.trmf_smp_id = b.smp_id, surfaced as the `punch_point_reason` output column and added to GROUP BY; counts use COUNT(DISTINCT a.id) so the one-smp-to-many-rejections fan-out cannot inflate them. Source join: NDPc answers JOIN macro_combined ON sessiontitle = scop_title. Grouped by (rgn_region, m_area, m_market, construction_gc, punch_point_reason): customer_punch_point_count, nokia_punch_point_count. Paired with `Customer & Nokia Approval & Rejection Rate` (rate counterpart).", "parameters": [{"name": "smp_name", "type": "string", "description": "Optional equality filter on smp_name (program filter, e.g., NTM, AHLOB Modernization).", "required": false, "sample_values": []}, {"name": "smp_id", "type": "string", "description": "Optional equality filter on smp_id.", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Optional equality filter on rgn_region.", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Optional equality filter on m_area.", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Optional equality filter on m_market.", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Optional equality filter on construction_gc.", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Optional equality filter on pj_project_id.", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Optional equality filter on s_site_id.", "required": false, "sample_values": []}, {"name": "customer_site_code", "type": "string", "description": "Optional equality filter on customer_site_code.", "required": false, "sample_values": []}, {"name": "package_name", "type": "string", "description": "Optional equality filter on package_name.", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Optional equality filter on por_category.", "required": false, "sample_values": []}, {"name": "scop_title", "type": "string", "description": "Optional equality filter on a.sessiontitle (the JOIN key).", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Lower bound on a.formanswerdate::date.", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Upper bound on a.formanswerdate::date.", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": false}, {"name": "m_area", "type": "string", "nullable": false}, {"name": "m_market", "type": "string", "nullable": false}, {"name": "construction_gc", "type": "string", "nullable": false}, {"name": "punch_point_reason", "type": "string", "nullable": true}, {"name": "customer_punch_point_count", "type": "number", "nullable": false}, {"name": "nokia_punch_point_count", "type": "number", "nullable": false}], "sample_output": [], "row_count": 25}', nl_description: 'Answer-level punch-point volume by source with per-reason breakdown. Customer punch point = formanswerstatus = \'7\' (T-Mobile rejected). Nokia punch point = formanswerstatus IN (\'2\',\'4\') (Nokia rejected or Nokia AI flagged). Reasons are exposed via LEFT JOIN to stg_tmo_rejections_master_file on t.trmf_smp_id = b.smp_id, surfaced as the `punch_point_reason` output column and added to GROUP BY; counts use COUNT(DISTINCT a.id) so the one-smp-to-many-rejections fan-out cannot inflate them. Source join: NDPc answers JOIN macro_combined ON sessiontitle = scop_title. Grouped by (rgn_region, m_area, m_market, construction_gc, punch_point_reason): customer_punch_point_count, nokia_punch_point_count. Paired with `Customer & Nokia Approval & Rejection Rate` (rate counterpart).', node_type: 'CORE', definition: 'Answer-level punch-point volume by source with per-reason breakdown. Customer punch point = formanswerstatus = \'7\' (T-Mobile rejected). Nokia punch point = formanswerstatus IN (\'2\',\'4\') (Nokia rejected or Nokia AI flagged). Reasons are exposed via LEFT JOIN to stg_tmo_rejections_master_file on t.trmf_smp_id = b.smp_id, surfaced as the `punch_point_reason` output column and added to GROUP BY; counts use COUNT(DISTINCT a.id) so the one-smp-to-many-rejections fan-out cannot inflate them. Source join: NDPc answers JOIN macro_combined ON sessiontitle = scop_title. Grouped by (rgn_region, m_area, m_market, construction_gc, punch_point_reason): customer_punch_point_count, nokia_punch_point_count. Paired with `Customer & Nokia Approval & Rejection Rate` (rate counterpart).', kpi_python_function: 'def get_customer_nokia_punch_point_count(execute_query, filters=None) -> list[dict]:\n    """Customer & Nokia Punch Point Count — with per-reason breakdown.\n\n    Answer-level volume of punch points by source AND reason:\n      - Customer punch point  = a."formanswerstatus" = \'7\'        (T-Mobile rejected)\n      - Nokia punch point     = a."formanswerstatus" IN (\'2\',\'4\') (Nokia rejected OR Nokia AI flagged)\n\n    The reason behind each punch point is exposed via a LEFT JOIN to\n    pwc_macro_staging_schema.stg_tmo_rejections_master_file (t) on\n    t."trmf_smp_id" = b."smp_id", surfaced as `punch_point_reason` in the output\n    and added to GROUP BY.\n\n    Because the trmf side is one-smp-to-many-rejections, COUNT(DISTINCT a."id")\n    is used so the LEFT JOIN cannot inflate counts (each answer is still counted\n    once per (reason) bucket it falls into). Rows whose smp has no trmf record\n    are kept with punch_point_reason = NULL.\n\n    formanswerstatus value map:\n      \'0\' = submitted\n      \'1\' = Nokia approved (human)\n      \'2\' = Nokia rejected\n      \'3\' = not submitted\n      \'4\' = Nokia AI approved\n      \'6\' = customer approved (T-Mobile)\n      \'7\' = customer rejected (T-Mobile)\n\n    Source:\n      pwc_macro_staging_schema.stg_services_ndpc_answers_daily_from_sdb a\n      JOIN pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined b\n        ON a."sessiontitle" = b."scop_title"\n      LEFT JOIN pwc_macro_staging_schema.stg_tmo_rejections_master_file t\n        ON t."trmf_smp_id" = b."smp_id"\n\n    Output (one row per rgn_region × m_area × m_market × construction_gc × punch_point_reason):\n      rgn_region, m_area, m_market, construction_gc, punch_point_reason,\n      customer_punch_point_count, nokia_punch_point_count\n\n    Optional filters (all equality, all optional):\n      smp_name, smp_id,\n      rgn_region, m_area, m_market, construction_gc,\n      pj_project_id, s_site_id, customer_site_code,\n      package_name, por_category,\n      scop_title,\n      start_date, end_date (applied to a."formanswerdate"::date).\n    """\n    filters = filters or {}\n\n    def _esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    where_parts = ["a.\\"formanswerstatus\\" IN (\'2\',\'4\',\'7\')"]\n\n    optional_eq_cols = [\n        "smp_name",\n        "smp_id",\n        "rgn_region",\n        "m_area",\n        "m_market",\n        "construction_gc",\n        "pj_project_id",\n        "s_site_id",\n        "customer_site_code",\n        "package_name",\n        "por_category",\n    ]\n    for col in optional_eq_cols:\n        v = filters.get(col)\n        if v is not None and str(v) != "":\n            where_parts.append(f\'b."{col}" = \\\'{_esc(v)}\\\'\')\n\n    scop_title = filters.get("scop_title")\n    if scop_title is not None and str(scop_title) != "":\n        where_parts.append(f\'a."sessiontitle" = \\\'{_esc(scop_title)}\\\'\')\n\n    start_date = filters.get("start_date")\n    end_date = filters.get("end_date")\n    if start_date:\n        where_parts.append(f"a.\\"formanswerdate\\"::date >= DATE \'{_esc(start_date)}\'")\n    if end_date:\n        where_parts.append(f"a.\\"formanswerdate\\"::date <= DATE \'{_esc(end_date)}\'")\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n        SELECT\n            b."rgn_region",\n            b."m_area",\n            b."m_market",\n            b."construction_gc",\n            t."trmf_tmo_punch_point_details" AS punch_point_reason,\n\n            COUNT(DISTINCT CASE WHEN a."formanswerstatus" = \'7\'        THEN a."id" END) AS customer_punch_point_count,\n            COUNT(DISTINCT CASE WHEN a."formanswerstatus" IN (\'2\',\'4\') THEN a."id" END) AS nokia_punch_point_count\n\n        FROM pwc_macro_staging_schema.stg_services_ndpc_answers_daily_from_sdb a\n        JOIN pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined b\n            ON a."sessiontitle" = b."scop_title"\n        LEFT JOIN pwc_macro_staging_schema.stg_tmo_rejections_master_file t\n            ON t."trmf_smp_id" = b."smp_id"\n        WHERE {where_sql}\n        GROUP BY b."rgn_region", b."m_area", b."m_market", b."construction_gc", t."trmf_tmo_punch_point_details"\n        ORDER BY b."rgn_region", b."m_area", b."m_market", b."construction_gc", t."trmf_tmo_punch_point_details"\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['stg_services_ndpc_answers_daily_from_sdb.id', 'stg_services_ndpc_answers_daily_from_sdb.sessiontitle', 'stg_services_ndpc_answers_daily_from_sdb.formanswerstatus', 'stg_services_ndpc_answers_daily_from_sdb.formanswerdate', 'stg_ndpd_mbt_tmobile_macro_combined.scop_title', 'stg_ndpd_mbt_tmobile_macro_combined.pj_project_id', 'stg_ndpd_mbt_tmobile_macro_combined.s_site_id', 'stg_ndpd_mbt_tmobile_macro_combined.customer_site_code', 'stg_ndpd_mbt_tmobile_macro_combined.smp_id', 'stg_ndpd_mbt_tmobile_macro_combined.smp_name', 'stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'stg_ndpd_mbt_tmobile_macro_combined.m_area', 'stg_ndpd_mbt_tmobile_macro_combined.m_market', 'stg_ndpd_mbt_tmobile_macro_combined.construction_gc', 'stg_ndpd_mbt_tmobile_macro_combined.package_name', 'stg_ndpd_mbt_tmobile_macro_combined.por_category', 'stg_tmo_rejections_master_file.trmf_smp_id', 'stg_tmo_rejections_master_file.trmf_tmo_punch_point_details'], session_id: '69a3d22f26e208edc083a06e', label: 'Customer & Nokia Punch Point Count', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market', 'quality_answer'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '5cc3d858-db28-46fb-920a-6439c9dc2c7b', entity_type: 'kpi', kpi_name: 'Customer & Nokia Punch Point Count', name: '5cc3d858-db28-46fb-920a-6439c9dc2c7b', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Answer-level punch-point volume by source with per-reason breakdown. Customer punch point = formanswerstatus = \'7\' (T-Mobile rejected). Nokia punch point = formanswerstatus IN (\'2\',\'4\') (Nokia rejected or Nokia AI flagged). Reasons are exposed via LEFT JOIN to stg_tmo_rejections_master_file on t.trmf_smp_id = b.smp_id, surfaced as the `punch_point_reason` output column and added to GROUP BY; counts use COUNT(DISTINCT a.id) so the one-smp-to-many-rejections fan-out cannot inflate them. Source join: NDPc answers JOIN macro_combined ON sessiontitle = scop_title. Grouped by (rgn_region, m_area, m_market, construction_gc, punch_point_reason): customer_punch_point_count, nokia_punch_point_count. Paired with `Customer & Nokia Approval & Rejection Rate` (rate counterpart).', status: 'mentioned', node_id: '5cc3d858-db28-46fb-920a-6439c9dc2c7b'});
CREATE (:BKGNode {map_table_name: 'stg_ndpd_mbt_tmobile_macro_combined', map_key_column: 'pj_project_id', nl_business_rule: '', session_id: '69a3d22f26e208edc083a06e', label: 'Customer Revenue Recognition', map_sql_template: 'SELECT DISTINCT\n    "pj_project_id",\n    "por_category",\n    "pj_project_status",\n    "smp_name",\n    "rgn_region",\n    "m_area",\n    "m_market",\n    "construction_gc",\n    "ms_1551_civil_construction_complete_ca_date" AS civil_ca_date,\n    "ms1555_construction_complete_ca_date"        AS tower_ca_date,\n    "ms_1559_cop_approved_by_t_mobile_ca_date"    AS scop_ca_date,\n    CASE\n        WHEN "por_category" = \'New Build\' AND "ms_1551_civil_construction_complete_ca_date" IS NOT NULL THEN \'Completed\'\n        WHEN "por_category" = \'New Build\' THEN \'Pending\'\n        ELSE \'Not Applicable\'\n    END AS civil_ca_status,\n    CASE WHEN "ms1555_construction_complete_ca_date"   IS NOT NULL THEN \'Completed\' ELSE \'Pending\' END AS tower_ca_status,\n    CASE WHEN "ms_1559_cop_approved_by_t_mobile_ca_date" IS NOT NULL THEN \'Completed\' ELSE \'Pending\' END AS scop_ca_status\nFROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\nWHERE "pj_project_status" IN (\'Active\',\'Completed\') AND "por_category" = \'New Build\'', map_label_column: 'pj_project_id', nl_description: 'Customer Revenue Recognition — per-project Customer Acceptance (CA) status across civil CA, tower CA, and SCOP CA milestones that gate revenue recognition (actual transactions from T-Mobile to Nokia).', map_contract: '{"function_name": "get_customer_revenue_recognition", "node_type": "core", "node_id": "customer_revenue_recognition", "node_label": "Customer Revenue Recognition", "description": "Customer Revenue Recognition \\u2014 per-project Customer Acceptance (CA) status across civil CA, tower CA, and SCOP CA milestones that gate revenue recognition (actual transactions from T-Mobile to Nokia).", "parameters": [{"name": "pj_project_id", "type": "string", "description": "Filter by pj_project_id", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Filter by s_site_id", "required": false, "sample_values": []}, {"name": "customer_site_code", "type": "string", "description": "Filter by customer_site_code", "required": false, "sample_values": []}, {"name": "rgn_region", "type": "string", "description": "Filter by rgn_region", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Filter by m_area", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Filter by m_market", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Filter by construction_gc", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Filter by por_category. Defaults to \'New Build\' when not provided.", "required": false, "sample_values": ["New Build", "Site Mod"]}, {"name": "smp_name", "type": "string", "description": "Filter by program.", "required": false, "sample_values": ["NTM", "AHLOB Modernization"]}, {"name": "smp_id", "type": "string", "description": "Filter by smp_id", "required": false, "sample_values": []}], "output_columns": [{"name": "pj_project_id", "type": "string", "nullable": false}, {"name": "por_category", "type": "string", "nullable": true}, {"name": "pj_project_status", "type": "string", "nullable": true}, {"name": "smp_name", "type": "string", "nullable": true}, {"name": "rgn_region", "type": "string", "nullable": true}, {"name": "m_area", "type": "string", "nullable": true}, {"name": "m_market", "type": "string", "nullable": true}, {"name": "construction_gc", "type": "string", "nullable": true}, {"name": "civil_ca_date", "type": "string", "nullable": true}, {"name": "tower_ca_date", "type": "string", "nullable": true}, {"name": "scop_ca_date", "type": "string", "nullable": true}, {"name": "civil_ca_status", "type": "string", "nullable": false}, {"name": "tower_ca_status", "type": "string", "nullable": false}, {"name": "scop_ca_status", "type": "string", "nullable": false}], "sample_output": [], "row_count": 3}', node_type: 'CORE', entity_type: 'core', map_python_function: 'def get_customer_revenue_recognition(execute_query, filters=None) -> list[dict]:\n    """Per-project Customer Acceptance (CA) status for revenue-recognition milestones.\n\n    Defaults por_category to \'New Build\' when not provided (distinct values: \'New Build\', \'Site Mod\').\n    Branches by smp_name: AHLOB Modernization returns civil/tower CA as \'Not Applicable\' (only scop_ca\n    tracked); otherwise (NTM/default) civil only applies to New Build.\n\n    Optional generic filters (equality):\n      rgn_region, m_area, m_market, construction_gc,\n      pj_project_id, s_site_id, customer_site_code,\n      smp_name, smp_id, por_category.\n    """\n    filters = filters or {}\n\n    def _esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    where_parts = ["\\"pj_project_status\\" IN (\'Active\', \'Completed\')"]\n\n    por_category = filters.get("por_category")\n    if por_category is None or str(por_category) == "":\n        por_category = "New Build"\n    where_parts.append(f\'"por_category" = \\\'{_esc(por_category)}\\\'\')\n\n    optional_eq_cols = [\n        "rgn_region", "m_area", "m_market", "construction_gc",\n        "pj_project_id", "s_site_id", "customer_site_code",\n        "smp_id",\n    ]\n    for col in optional_eq_cols:\n        v = filters.get(col)\n        if v is not None and str(v) != "":\n            where_parts.append(f\'"{col}" = \\\'{_esc(v)}\\\'\')\n\n    smp_name = filters.get("smp_name")\n    is_ahlob = bool(smp_name) and ("AHLOB" in str(smp_name).upper())\n    if smp_name is not None and str(smp_name).strip() != "":\n        v = _esc(smp_name)\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if str(smp_name).strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    where_sql = " AND ".join(where_parts)\n\n    if is_ahlob:\n        civil_status_expr = "\'Not Applicable\'"\n        tower_status_expr = "\'Not Applicable\'"\n    else:\n        civil_status_expr = (\n            "CASE "\n            "WHEN \\"por_category\\" = \'New Build\' AND \\"ms_1551_civil_construction_complete_ca_date\\" IS NOT NULL THEN \'Completed\' "\n            "WHEN \\"por_category\\" = \'New Build\' THEN \'Pending\' "\n            "ELSE \'Not Applicable\' END"\n        )\n        tower_status_expr = (\n            "CASE WHEN \\"ms1555_construction_complete_ca_date\\" IS NOT NULL THEN \'Completed\' ELSE \'Pending\' END"\n        )\n\n    scop_status_expr = (\n        "CASE WHEN \\"ms_1559_cop_approved_by_t_mobile_ca_date\\" IS NOT NULL THEN \'Completed\' ELSE \'Pending\' END"\n    )\n\n    sql = f"""\n        SELECT DISTINCT\n            "pj_project_id",\n            "por_category",\n            "pj_project_status",\n            "smp_name",\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "construction_gc",\n            "ms_1551_civil_construction_complete_ca_date" AS civil_ca_date,\n            "ms1555_construction_complete_ca_date"        AS tower_ca_date,\n            "ms_1559_cop_approved_by_t_mobile_ca_date"    AS scop_ca_date,\n            {civil_status_expr} AS civil_ca_status,\n            {tower_status_expr} AS tower_ca_status,\n            {scop_status_expr}  AS scop_ca_status\n        FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n        WHERE {where_sql}\n        ORDER BY "por_category", "pj_project_id"\n    """\n\n    return execute_query(sql)\n', is_skipped: false, name: 'customer_revenue_recognition', definition: 'Customer Revenue Recognition — per-project Customer Acceptance (CA) status across civil CA, tower CA, and SCOP CA milestones that gate revenue recognition (actual transactions from T-Mobile to Nokia).', map_database_name: 'public', skip_reason: '', status: 'mentioned', node_id: 'customer_revenue_recognition'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined'], nl_business_rule: '', kpi_formula_description: 'avg_<cycle>_days = ROUND(AVG(<end_date>::date - <start_date>::date), 0); median_<cycle>_days = ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY <end_date>::date - <start_date>::date)::numeric, 0). Cycles: entitlement→civil, civil→tower, tower→scop, entitlement→tower, entitlement→scop. For AHLOB only entitlement→scop is computed; others NULL. Default time window: last 2 months on entitlement date.', kpi_output_schema: '[{"column": "por_category", "type": "string", "description": "Project category (\'New Build\' or \'Site Mod\')."}, {"column": "avg_entitlement_to_civil_days", "type": "number", "description": "Avg days from RAN entitlement to civil CA. NULL for AHLOB."}, {"column": "median_entitlement_to_civil_days", "type": "number", "description": "Median days from RAN entitlement to civil CA. NULL for AHLOB."}, {"column": "avg_civil_to_tower_days", "type": "number", "description": "Avg days from civil CA to tower CA. NULL for AHLOB."}, {"column": "median_civil_to_tower_days", "type": "number", "description": "Median days from civil CA to tower CA. NULL for AHLOB."}, {"column": "avg_tower_to_scop_days", "type": "number", "description": "Avg days from tower CA to SCOP CA. NULL for AHLOB."}, {"column": "median_tower_to_scop_days", "type": "number", "description": "Median days from tower CA to SCOP CA. NULL for AHLOB."}, {"column": "avg_entitlement_to_tower_days", "type": "number", "description": "Avg days from RAN entitlement to tower CA. NULL for AHLOB."}, {"column": "median_entitlement_to_tower_days", "type": "number", "description": "Median days from RAN entitlement to tower CA. NULL for AHLOB."}, {"column": "avg_entitlement_to_scop_days", "type": "number", "description": "Avg days from RAN entitlement to SCOP CA."}, {"column": "median_entitlement_to_scop_days", "type": "number", "description": "Median days from RAN entitlement to SCOP CA."}]', kpi_business_logic: '1) Source: pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined. 2) Population: pj_project_status IN (\'Active\', \'Completed\'). 3) por_category defaults to \'New Build\' when not provided; user can override via filter. 4) Date range defaults to last 2 months on pj_a_3710_ran_entitlement_complete_finish::date (CURRENT_DATE - INTERVAL \'2 months\' to CURRENT_DATE) when start_date/end_date not provided. 5) Allowlisted equality filters (optional): rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id, customer_site_code, smp_id. 6) smp_name conditional: if smp_name = \'NTM\', enforce smp_status = \'Active\' and exclude ntm_project_type IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\'). 7) CTE base_data: distinct (pj_project_id, por_category, entitlement, 3 CA dates). 8) CTE cycle_times: per-project day differences. 9) Branch by smp_name containing \'AHLOB\' (case-insensitive): AHLOB: only entitlement_to_scop_days computed; other metric columns return NULL::numeric. NTM/default: all 5 cycle-day diffs computed. 10) GROUP BY por_category; avg = ROUND(AVG(...), 0); median = ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY ...)::numeric, 0).', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Optional equality filter on rgn_region."}, {"name": "m_area", "type": "string", "description": "Optional equality filter on m_area."}, {"name": "m_market", "type": "string", "description": "Optional equality filter on m_market."}, {"name": "construction_gc", "type": "string", "description": "Optional equality filter on construction_gc."}, {"name": "pj_project_id", "type": "string", "description": "Optional equality filter on pj_project_id."}, {"name": "s_site_id", "type": "string", "description": "Optional equality filter on s_site_id."}, {"name": "customer_site_code", "type": "string", "description": "Optional equality filter on customer_site_code."}, {"name": "por_category", "type": "string", "description": "Optional equality filter on por_category. Defaults to \'New Build\' when not provided."}, {"name": "smp_name", "type": "string", "description": "Program filter. AHLOB-substring switches to scop-only single-cycle output; NTM applies NTM-specific extra filters."}, {"name": "smp_id", "type": "string", "description": "Optional equality filter on smp_id."}, {"name": "start_date", "type": "date", "description": "Lower bound on pj_a_3710_ran_entitlement_complete_finish::date. Defaults to CURRENT_DATE - INTERVAL \'2 months\' when not provided."}, {"name": "end_date", "type": "date", "description": "Upper bound on pj_a_3710_ran_entitlement_complete_finish::date. Defaults to CURRENT_DATE when not provided."}]', kpi_contract: '{"function_name": "get_revenue_recognition_cycle_time", "node_type": "kpi", "node_id": "ec6cabd8-5f74-4337-8faa-c73871cd945c", "node_label": "Revenue Recognition Cycle Time", "description": "Revenue Recognition Cycle Time \\u2014 average and median days between key milestones leading to Customer Acceptance (entitlement \\u2192 civil CA \\u2192 tower CA \\u2192 SCOP CA), grouped by por_category. Defaults to the last 2 months on entitlement date when start_date/end_date are not provided.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Optional equality filter on rgn_region.", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Optional equality filter on m_area.", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Optional equality filter on m_market.", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Optional equality filter on construction_gc.", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Optional equality filter on pj_project_id.", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Optional equality filter on s_site_id.", "required": false, "sample_values": []}, {"name": "customer_site_code", "type": "string", "description": "Optional equality filter on customer_site_code.", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Optional equality filter on por_category. Defaults to \'New Build\' when not provided.", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Program filter. AHLOB-substring switches to scop-only single-cycle output; NTM applies NTM-specific extra filters.", "required": false, "sample_values": []}, {"name": "smp_id", "type": "string", "description": "Optional equality filter on smp_id.", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Lower bound on pj_a_3710_ran_entitlement_complete_finish::date. Defaults to CURRENT_DATE - INTERVAL \'2 months\' when not provided.", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Upper bound on pj_a_3710_ran_entitlement_complete_finish::date. Defaults to CURRENT_DATE when not provided.", "required": false, "sample_values": []}], "output_columns": [{"name": "por_category", "type": "string", "nullable": false}, {"name": "avg_entitlement_to_civil_days", "type": "number", "nullable": true}, {"name": "median_entitlement_to_civil_days", "type": "number", "nullable": true}, {"name": "avg_civil_to_tower_days", "type": "number", "nullable": true}, {"name": "median_civil_to_tower_days", "type": "number", "nullable": true}, {"name": "avg_tower_to_scop_days", "type": "number", "nullable": true}, {"name": "median_tower_to_scop_days", "type": "number", "nullable": true}, {"name": "avg_entitlement_to_tower_days", "type": "number", "nullable": true}, {"name": "median_entitlement_to_tower_days", "type": "number", "nullable": true}, {"name": "avg_entitlement_to_scop_days", "type": "number", "nullable": true}, {"name": "median_entitlement_to_scop_days", "type": "number", "nullable": true}], "sample_output": [], "row_count": 2}', nl_description: 'Revenue Recognition Cycle Time — average and median days between key milestones leading to Customer Acceptance (entitlement → civil CA → tower CA → SCOP CA), grouped by por_category. Defaults to the last 2 months on entitlement date when start_date/end_date are not provided.', node_type: 'CORE', definition: 'Revenue Recognition Cycle Time — average and median days between key milestones leading to Customer Acceptance (entitlement → civil CA → tower CA → SCOP CA), grouped by por_category. Defaults to the last 2 months on entitlement date when start_date/end_date are not provided.', kpi_python_function: 'def get_revenue_recognition_cycle_time(execute_query, filters=None) -> list[dict]:\n    """Cycle time (days) between revenue-recognition milestones.\n\n    Defaults por_category to \'New Build\' when not provided (distinct values: \'New Build\', \'Site Mod\').\n    Defaults entitlement-date range to the last 2 months (CURRENT_DATE - INTERVAL \'2 months\' to\n    CURRENT_DATE) when start_date and/or end_date are not provided.\n\n    Branches by smp_name: AHLOB Modernization computes ONLY entitlement→scop_ca (other measures NULL);\n    NTM/default computes all 5 cycle measures.\n\n    Optional generic filters (equality):\n      rgn_region, m_area, m_market, construction_gc,\n      pj_project_id, s_site_id, customer_site_code,\n      smp_name, smp_id, por_category.\n    Date range: start_date / end_date applied to pj_a_3710_ran_entitlement_complete_finish::date.\n    """\n    filters = filters or {}\n\n    def _esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    where_parts = ["\\"pj_project_status\\" IN (\'Active\', \'Completed\')"]\n\n    por_category = filters.get("por_category")\n    if por_category is None or str(por_category) == "":\n        por_category = "New Build"\n    where_parts.append(f\'"por_category" = \\\'{_esc(por_category)}\\\'\')\n\n    optional_eq_cols = [\n        "rgn_region", "m_area", "m_market", "construction_gc",\n        "pj_project_id", "s_site_id", "customer_site_code",\n        "smp_id",\n    ]\n    for col in optional_eq_cols:\n        v = filters.get(col)\n        if v is not None and str(v) != "":\n            where_parts.append(f\'"{col}" = \\\'{_esc(v)}\\\'\')\n\n    smp_name = filters.get("smp_name")\n    is_ahlob = bool(smp_name) and ("AHLOB" in str(smp_name).upper())\n    if smp_name is not None and str(smp_name).strip() != "":\n        v = _esc(smp_name)\n        where_parts.append(f\'"smp_name" = \\\'{v}\\\'\')\n        if str(smp_name).strip().upper() == \'NTM\':\n            where_parts.append(\'"smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'"ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    # Default to last 2 months on entitlement date when start/end not provided\n    start_date = filters.get("start_date")\n    if start_date:\n        start_expr = f"DATE \'{_esc(start_date)}\'"\n    else:\n        start_expr = "CURRENT_DATE - INTERVAL \'2 months\'"\n    end_date = filters.get("end_date")\n    if end_date:\n        end_expr = f"DATE \'{_esc(end_date)}\'"\n    else:\n        end_expr = "CURRENT_DATE"\n    where_parts.append(f\'"pj_a_3710_ran_entitlement_complete_finish"::date >= {start_expr}\')\n    where_parts.append(f\'"pj_a_3710_ran_entitlement_complete_finish"::date <= {end_expr}\')\n\n    where_sql = " AND ".join(where_parts)\n\n    if is_ahlob:\n        select_metrics = (\n            "NULL::numeric AS avg_entitlement_to_civil_days,\\n"\n            "            NULL::numeric AS median_entitlement_to_civil_days,\\n"\n            "            NULL::numeric AS avg_civil_to_tower_days,\\n"\n            "            NULL::numeric AS median_civil_to_tower_days,\\n"\n            "            NULL::numeric AS avg_tower_to_scop_days,\\n"\n            "            NULL::numeric AS median_tower_to_scop_days,\\n"\n            "            NULL::numeric AS avg_entitlement_to_tower_days,\\n"\n            "            NULL::numeric AS median_entitlement_to_tower_days,\\n"\n            "            ROUND(AVG(entitlement_to_scop_days), 0) AS avg_entitlement_to_scop_days,\\n"\n            "            ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY entitlement_to_scop_days)::numeric, 0) AS median_entitlement_to_scop_days"\n        )\n        cycle_columns = (\n            "NULL::int AS entitlement_to_civil_days,\\n"\n            "                NULL::int AS civil_to_tower_days,\\n"\n            "                NULL::int AS tower_to_scop_days,\\n"\n            "                NULL::int AS entitlement_to_tower_days,\\n"\n            "                (\\"ms_1559_cop_approved_by_t_mobile_ca_date\\"::date - \\"pj_a_3710_ran_entitlement_complete_finish\\"::date) AS entitlement_to_scop_days"\n        )\n    else:\n        select_metrics = (\n            "ROUND(AVG(entitlement_to_civil_days), 0) AS avg_entitlement_to_civil_days,\\n"\n            "            ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY entitlement_to_civil_days)::numeric, 0) AS median_entitlement_to_civil_days,\\n"\n            "            ROUND(AVG(civil_to_tower_days), 0) AS avg_civil_to_tower_days,\\n"\n            "            ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY civil_to_tower_days)::numeric, 0) AS median_civil_to_tower_days,\\n"\n            "            ROUND(AVG(tower_to_scop_days), 0) AS avg_tower_to_scop_days,\\n"\n            "            ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY tower_to_scop_days)::numeric, 0) AS median_tower_to_scop_days,\\n"\n            "            ROUND(AVG(entitlement_to_tower_days), 0) AS avg_entitlement_to_tower_days,\\n"\n            "            ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY entitlement_to_tower_days)::numeric, 0) AS median_entitlement_to_tower_days,\\n"\n            "            ROUND(AVG(entitlement_to_scop_days), 0) AS avg_entitlement_to_scop_days,\\n"\n            "            ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY entitlement_to_scop_days)::numeric, 0) AS median_entitlement_to_scop_days"\n        )\n        cycle_columns = (\n            "(\\"ms_1551_civil_construction_complete_ca_date\\"::date - \\"pj_a_3710_ran_entitlement_complete_finish\\"::date) AS entitlement_to_civil_days,\\n"\n            "                (\\"ms1555_construction_complete_ca_date\\"::date - \\"ms_1551_civil_construction_complete_ca_date\\"::date) AS civil_to_tower_days,\\n"\n            "                (\\"ms_1559_cop_approved_by_t_mobile_ca_date\\"::date - \\"ms1555_construction_complete_ca_date\\"::date) AS tower_to_scop_days,\\n"\n            "                (\\"ms1555_construction_complete_ca_date\\"::date - \\"pj_a_3710_ran_entitlement_complete_finish\\"::date) AS entitlement_to_tower_days,\\n"\n            "                (\\"ms_1559_cop_approved_by_t_mobile_ca_date\\"::date - \\"pj_a_3710_ran_entitlement_complete_finish\\"::date) AS entitlement_to_scop_days"\n        )\n\n    sql = f"""\n        WITH base_data AS (\n            SELECT DISTINCT\n                "pj_project_id",\n                "por_category",\n                "pj_project_status",\n                "pj_a_3710_ran_entitlement_complete_finish",\n                "ms_1551_civil_construction_complete_ca_date",\n                "ms1555_construction_complete_ca_date",\n                "ms_1559_cop_approved_by_t_mobile_ca_date"\n            FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined\n            WHERE {where_sql}\n        ),\n        cycle_times AS (\n            SELECT\n                "pj_project_id",\n                "por_category",\n                {cycle_columns}\n            FROM base_data\n        )\n        SELECT\n            "por_category",\n            {select_metrics}\n        FROM cycle_times\n        GROUP BY "por_category"\n        ORDER BY "por_category"\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['pj_project_id', 'por_category', 'pj_project_status', 'smp_name', 'smp_status', 'smp_id', 'ntm_project_type', 'rgn_region', 'm_area', 'm_market', 'construction_gc', 's_site_id', 'customer_site_code', 'pj_a_3710_ran_entitlement_complete_finish', 'ms_1551_civil_construction_complete_ca_date', 'ms1555_construction_complete_ca_date', 'ms_1559_cop_approved_by_t_mobile_ca_date'], session_id: '69a3d22f26e208edc083a06e', label: 'Revenue Recognition Cycle Time', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market', 'customer_revenue_recognition'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: 'ec6cabd8-5f74-4337-8faa-c73871cd945c', entity_type: 'kpi', kpi_name: 'Revenue Recognition Cycle Time', name: 'ec6cabd8-5f74-4337-8faa-c73871cd945c', kpi_dimensions: ['por_category'], kpi_description: 'Revenue Recognition Cycle Time — average and median days between key milestones leading to Customer Acceptance (entitlement → civil CA → tower CA → SCOP CA), grouped by por_category. Defaults to the last 2 months on entitlement date when start_date/end_date are not provided.', status: 'mentioned', node_id: 'ec6cabd8-5f74-4337-8faa-c73871cd945c'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined', 'public.tmo_macro_copilot_short_construction_start_forecast'], nl_business_rule: '', kpi_formula_description: 'forecast_accuracy_week_pct = ROUND(AVG(is_accurate::numeric) * 100, 2), where is_accurate = 1 when date_trunc(\'week\', MIN(forecast.construction_start_finish per project)) = date_trunc(\'week\', macro_combined.pj_a_4225_construction_start_finish), else 0. Grouped by (rgn_region, m_area, m_market, construction_gc).', kpi_output_schema: '[{"column": "rgn_region", "type": "string", "description": "Region grouping field."}, {"column": "m_area", "type": "string", "description": "Area grouping field."}, {"column": "m_market", "type": "string", "description": "Market grouping field."}, {"column": "construction_gc", "type": "string", "description": "General contractor grouping field."}, {"column": "project_count", "type": "int", "description": "Distinct projects in the geo cell that have an actual start and at least one forecast entry."}, {"column": "accurate_count", "type": "int", "description": "Projects whose actual start week matches the original forecast week."}, {"column": "forecast_accuracy_week_pct", "type": "number", "description": "ROUND(AVG(is_accurate) * 100, 2)."}]', kpi_business_logic: '1) Source: macro_combined (c) for actuals and dims; public.tmo_macro_copilot_short_construction_start_forecast (f) for historical forecast dates. 2) Population: c.pj_a_4225_construction_start_finish IS NOT NULL. 3) Apply optional equality filters on c.*: rgn_region, m_area, m_market, construction_gc, pj_project_id, s_site_id, customer_site_code, smp_id, por_category. 4) smp_name conditional: when \'NTM\', also enforce c.smp_status=\'Active\' and exclude c.ntm_project_type IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\'). 5) Optional date range: start_date / end_date applied to c.pj_a_4225_construction_start_finish::date. 6) CTE initial_forecast: per project MIN(forecast.construction_start_finish) AS initial_forecast_date. 7) CTE actual: filtered macro_combined rows projecting geo + actual_start_date = pj_a_4225_construction_start_finish. 8) CTE base: INNER JOIN of initial_forecast and actual on pj_project_id; is_accurate = 1 when date_trunc(\'week\', initial_forecast_date) = date_trunc(\'week\', actual_start_date), else 0. 9) Aggregate per (rgn_region, m_area, m_market, construction_gc): project_count = COUNT(*), accurate_count = SUM(is_accurate), forecast_accuracy_week_pct = ROUND(AVG(is_accurate::numeric) * 100, 2). Optional pj_construction_start_delay_code filter (when provided) adds c."pj_construction_start_delay_code" IS NOT NULL AND <> \'No Delay\'; non-sentinel values also add equality c."pj_construction_start_delay_code" = \'<value>\'.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Optional equality filter on rgn_region."}, {"name": "m_area", "type": "string", "description": "Optional equality filter on m_area."}, {"name": "m_market", "type": "string", "description": "Optional equality filter on m_market."}, {"name": "construction_gc", "type": "string", "description": "Optional equality filter on construction_gc."}, {"name": "pj_project_id", "type": "string", "description": "Optional equality filter on pj_project_id."}, {"name": "s_site_id", "type": "string", "description": "Optional equality filter on s_site_id."}, {"name": "customer_site_code", "type": "string", "description": "Optional equality filter on customer_site_code."}, {"name": "por_category", "type": "string", "description": "Optional equality filter on por_category."}, {"name": "smp_name", "type": "string", "description": "Program filter. When \'NTM\', also enforces smp_status=\'Active\' and excludes specific ntm_project_type values."}, {"name": "smp_id", "type": "string", "description": "Optional equality filter on smp_id."}, {"name": "start_date", "type": "date", "description": "Lower bound on pj_a_4225_construction_start_finish::date."}, {"name": "end_date", "type": "date", "description": "Upper bound on pj_a_4225_construction_start_finish::date."}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Optional filter for delayed projects. Sentinel values (\'any\',\'true\',\'yes\',\'1\',\'*\') restrict to ANY non-empty delay code (IS NOT NULL AND <> \'No Delay\'). Any other value applies an exact equality on the delay code in addition to the IS NOT NULL guards."}]', kpi_contract: '{"function_name": "get_forecast_accuracy_pct", "node_type": "kpi", "node_id": "848a393e-28b7-4b4b-b099-dbd60c208ddf", "node_label": "Forecast Accuracy %", "description": "Forecast Accuracy % \\u2014 share of projects whose ACTUAL construction start landed in the same ISO week as the ORIGINAL forecast date (MIN over the forecast table per project). Reported as ROUND(AVG(is_accurate) * 100, 2) per (rgn_region, m_area, m_market, construction_gc), with supporting project_count and accurate_count.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Optional equality filter on rgn_region.", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Optional equality filter on m_area.", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Optional equality filter on m_market.", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Optional equality filter on construction_gc.", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Optional equality filter on pj_project_id.", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Optional equality filter on s_site_id.", "required": false, "sample_values": []}, {"name": "customer_site_code", "type": "string", "description": "Optional equality filter on customer_site_code.", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Optional equality filter on por_category.", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Program filter. When \'NTM\', also enforces smp_status=\'Active\' and excludes specific ntm_project_type values.", "required": false, "sample_values": []}, {"name": "smp_id", "type": "string", "description": "Optional equality filter on smp_id.", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Lower bound on pj_a_4225_construction_start_finish::date.", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Upper bound on pj_a_4225_construction_start_finish::date.", "required": false, "sample_values": []}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Optional filter for delayed projects. Sentinel values (\'any\',\'true\',\'yes\',\'1\',\'*\') restrict to ANY non-empty delay code (IS NOT NULL AND <> \'No Delay\'). Any other value applies an exact equality on the delay code in addition to the IS NOT NULL guards.", "required": false, "sample_values": []}], "output_columns": [{"name": "rgn_region", "type": "string", "nullable": true}, {"name": "m_area", "type": "string", "nullable": true}, {"name": "m_market", "type": "string", "nullable": true}, {"name": "construction_gc", "type": "string", "nullable": true}, {"name": "project_count", "type": "number", "nullable": true}, {"name": "accurate_count", "type": "number", "nullable": true}, {"name": "forecast_accuracy_week_pct", "type": "number", "nullable": true}], "sample_output": [], "row_count": 10}', nl_description: 'Forecast Accuracy % — share of projects whose ACTUAL construction start landed in the same ISO week as the ORIGINAL forecast date (MIN over the forecast table per project). Reported as ROUND(AVG(is_accurate) * 100, 2) per (rgn_region, m_area, m_market, construction_gc), with supporting project_count and accurate_count.', node_type: 'CORE', definition: 'Forecast Accuracy % — share of projects whose ACTUAL construction start landed in the same ISO week as the ORIGINAL forecast date (MIN over the forecast table per project). Reported as ROUND(AVG(is_accurate) * 100, 2) per (rgn_region, m_area, m_market, construction_gc), with supporting project_count and accurate_count.', kpi_python_function: 'def get_forecast_accuracy_pct(execute_query, filters=None) -> list[dict]:\n    """Forecast Accuracy % — original-plan-vs-actual hit rate per geo, week granularity.\n\n    Compares the ORIGINAL forecast date for each project (MIN over the forecast table) to the\n    ACTUAL construction start date (pj_a_4225_construction_start_finish). A project is flagged\n    accurate when date_trunc(\'week\', initial_forecast_date) = date_trunc(\'week\', actual_start_date).\n    Output: per-geo ROUND(AVG(is_accurate) * 100, 2) plus raw counts.\n\n    Population:\n      - pj_a_4225_construction_start_finish IS NOT NULL\n      - smp_name = \'NTM\' → also enforces smp_status = \'Active\' and excludes\n        ntm_project_type IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\')\n\n    Optional generic equality filters:\n      rgn_region, m_area, m_market, construction_gc,\n      pj_project_id, s_site_id, customer_site_code,\n      smp_name, smp_id, por_category.\n\n    Optional delay filter:\n      pj_construction_start_delay_code — when provided, narrows to delayed projects (column\n      IS NOT NULL AND <> \'No Delay\'). Sentinel values ("any","true","yes","1","*") restrict to\n      *any* delay; any other value applies an exact equality filter on the delay code.\n\n    Optional date range: start_date / end_date applied to pj_a_4225_construction_start_finish::date.\n    """\n    filters = filters or {}\n\n    def _esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    where_parts = [\'c."pj_a_4225_construction_start_finish" IS NOT NULL\']\n\n    optional_eq_cols = [\n        "rgn_region", "m_area", "m_market", "construction_gc",\n        "pj_project_id", "s_site_id", "customer_site_code",\n        "smp_id", "por_category",\n    ]\n    for col in optional_eq_cols:\n        v = filters.get(col)\n        if v is not None and str(v) != "":\n            where_parts.append(f\'c."{col}" = \\\'{_esc(v)}\\\'\')\n\n    smp_name = filters.get("smp_name")\n    if smp_name is not None and str(smp_name).strip() != "":\n        v = _esc(smp_name)\n        where_parts.append(f\'c."smp_name" = \\\'{v}\\\'\')\n        if str(smp_name).strip().upper() == \'NTM\':\n            where_parts.append(\'c."smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'c."ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    # Optional construction-start delay-code filter (engages when caller wants delayed projects)\n    _v = filters.get("pj_construction_start_delay_code")\n    if _v is not None and str(_v).strip() != "":\n        _s = str(_v).strip()\n        where_parts.append(\'c."pj_construction_start_delay_code" IS NOT NULL\')\n        where_parts.append(\'c."pj_construction_start_delay_code" <> \\\'No Delay\\\'\')\n        if _s.lower() not in ("any", "true", "yes", "1", "*"):\n            _ss = _s.replace("\'", "\'\'")\n            where_parts.append(f\'c."pj_construction_start_delay_code" = \\\'{_ss}\\\'\')\n\n    start_date = filters.get("start_date")\n    end_date = filters.get("end_date")\n    if start_date:\n        where_parts.append(f\'c."pj_a_4225_construction_start_finish"::date >= DATE \\\'{_esc(start_date)}\\\'\')\n    if end_date:\n        where_parts.append(f\'c."pj_a_4225_construction_start_finish"::date <= DATE \\\'{_esc(end_date)}\\\'\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n        WITH initial_forecast AS (\n            SELECT pj_project_id, MIN(construction_start_finish) AS initial_forecast_date\n            FROM public.tmo_macro_copilot_short_construction_start_forecast\n            GROUP BY pj_project_id\n        ),\n        actual AS (\n            SELECT\n                c."pj_project_id",\n                c."rgn_region",\n                c."m_area",\n                c."m_market",\n                c."construction_gc",\n                c."pj_a_4225_construction_start_finish" AS actual_start_date\n            FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined c\n            WHERE {where_sql}\n        ),\n        base AS (\n            SELECT\n                a."rgn_region",\n                a."m_area",\n                a."m_market",\n                a."construction_gc",\n                CASE\n                    WHEN date_trunc(\'week\', i.initial_forecast_date::timestamp)\n                       = date_trunc(\'week\', a.actual_start_date::timestamp)\n                    THEN 1 ELSE 0\n                END AS is_accurate\n            FROM initial_forecast i\n            JOIN actual a ON i.pj_project_id = a."pj_project_id"\n        )\n        SELECT\n            "rgn_region",\n            "m_area",\n            "m_market",\n            "construction_gc",\n            COUNT(*) AS project_count,\n            SUM(is_accurate) AS accurate_count,\n            ROUND(AVG(is_accurate::numeric) * 100, 2) AS forecast_accuracy_week_pct\n        FROM base\n        GROUP BY "rgn_region", "m_area", "m_market", "construction_gc"\n        ORDER BY "rgn_region", "m_area", "m_market", "construction_gc"\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['stg_ndpd_mbt_tmobile_macro_combined.pj_project_id', 'stg_ndpd_mbt_tmobile_macro_combined.s_site_id', 'stg_ndpd_mbt_tmobile_macro_combined.customer_site_code', 'stg_ndpd_mbt_tmobile_macro_combined.smp_id', 'stg_ndpd_mbt_tmobile_macro_combined.smp_name', 'stg_ndpd_mbt_tmobile_macro_combined.smp_status', 'stg_ndpd_mbt_tmobile_macro_combined.ntm_project_type', 'stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'stg_ndpd_mbt_tmobile_macro_combined.m_area', 'stg_ndpd_mbt_tmobile_macro_combined.m_market', 'stg_ndpd_mbt_tmobile_macro_combined.construction_gc', 'stg_ndpd_mbt_tmobile_macro_combined.por_category', 'stg_ndpd_mbt_tmobile_macro_combined.pj_a_4225_construction_start_finish', 'stg_ndpd_mbt_tmobile_macro_combined.pj_construction_start_delay_code', 'tmo_macro_copilot_short_construction_start_forecast.pj_project_id', 'tmo_macro_copilot_short_construction_start_forecast.construction_start_finish'], session_id: '69a3d22f26e208edc083a06e', label: 'Forecast Accuracy %', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '848a393e-28b7-4b4b-b099-dbd60c208ddf', entity_type: 'kpi', kpi_name: 'Forecast Accuracy %', name: '848a393e-28b7-4b4b-b099-dbd60c208ddf', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Forecast Accuracy % — share of projects whose ACTUAL construction start landed in the same ISO week as the ORIGINAL forecast date (MIN over the forecast table per project). Reported as ROUND(AVG(is_accurate) * 100, 2) per (rgn_region, m_area, m_market, construction_gc), with supporting project_count and accurate_count.', status: 'mentioned', node_id: '848a393e-28b7-4b4b-b099-dbd60c208ddf'});
CREATE (:BKGNode {kpi_source_tables: ['pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined', 'public.tmo_macro_copilot_short_construction_start_forecast'], nl_business_rule: '', kpi_formula_description: 'rescheduled_count = GREATEST(COUNT(f.pj_project_id) - 1, 0). Per project, with optional date-range and equality filters applied to the macro_combined side. ORDER BY rescheduled_count DESC.', kpi_output_schema: '[{"column": "pj_project_id", "type": "string", "description": "Project identifier."}, {"column": "rgn_region", "type": "string", "description": "Region."}, {"column": "m_area", "type": "string", "description": "Area."}, {"column": "m_market", "type": "string", "description": "Market."}, {"column": "construction_gc", "type": "string", "description": "General contractor."}, {"column": "rescheduled_count", "type": "int", "description": "GREATEST(COUNT(forecast rows) - 1, 0)."}]', kpi_business_logic: '1) Source: macro_combined (c) joined to public.tmo_macro_copilot_short_construction_start_forecast (f) via LEFT JOIN on c.pj_project_id = f.pj_project_id (LEFT keeps projects with zero forecast rows). 2) Population: c.pj_a_4225_construction_start_finish IS NOT NULL. 3) Apply optional equality filters on c.* (same surface as Forecast Accuracy %) and smp_name conditional. 4) Optional date range: start_date / end_date applied to c.pj_a_4225_construction_start_finish::date. 5) GROUP BY c.pj_project_id, c.rgn_region, c.m_area, c.m_market, c.construction_gc. 6) rescheduled_count = GREATEST(COUNT(f.pj_project_id) - 1, 0). 7) ORDER BY rescheduled_count DESC, c.pj_project_id. Optional pj_construction_start_delay_code filter (when provided) adds c."pj_construction_start_delay_code" IS NOT NULL AND <> \'No Delay\'; non-sentinel values also add equality c."pj_construction_start_delay_code" = \'<value>\'.', kpi_filters: '[{"name": "rgn_region", "type": "string", "description": "Optional equality filter on rgn_region."}, {"name": "m_area", "type": "string", "description": "Optional equality filter on m_area."}, {"name": "m_market", "type": "string", "description": "Optional equality filter on m_market."}, {"name": "construction_gc", "type": "string", "description": "Optional equality filter on construction_gc."}, {"name": "pj_project_id", "type": "string", "description": "Optional equality filter on pj_project_id."}, {"name": "s_site_id", "type": "string", "description": "Optional equality filter on s_site_id."}, {"name": "customer_site_code", "type": "string", "description": "Optional equality filter on customer_site_code."}, {"name": "por_category", "type": "string", "description": "Optional equality filter on por_category."}, {"name": "smp_name", "type": "string", "description": "Program filter. When \'NTM\', also enforces smp_status=\'Active\' and excludes specific ntm_project_type values."}, {"name": "smp_id", "type": "string", "description": "Optional equality filter on smp_id."}, {"name": "start_date", "type": "date", "description": "Lower bound on pj_a_4225_construction_start_finish::date."}, {"name": "end_date", "type": "date", "description": "Upper bound on pj_a_4225_construction_start_finish::date."}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Optional filter for delayed projects. Sentinel values (\'any\',\'true\',\'yes\',\'1\',\'*\') restrict to ANY non-empty delay code (IS NOT NULL AND <> \'No Delay\'). Any other value applies an exact equality on the delay code in addition to the IS NOT NULL guards."}]', kpi_contract: '{"function_name": "get_site_reschedule_count", "node_type": "kpi", "node_id": "277ecc42-c37c-46f9-9d9c-6c2e8d672a63", "node_label": "Site Reschedule Count", "description": "Site Reschedule Count \\u2014 per-project number of times the planned construction start date was overwritten before construction began, computed as GREATEST(COUNT(forecast rows) - 1, 0). Returns one row per project with geo context and rescheduled_count.", "parameters": [{"name": "rgn_region", "type": "string", "description": "Optional equality filter on rgn_region.", "required": false, "sample_values": []}, {"name": "m_area", "type": "string", "description": "Optional equality filter on m_area.", "required": false, "sample_values": []}, {"name": "m_market", "type": "string", "description": "Optional equality filter on m_market.", "required": false, "sample_values": []}, {"name": "construction_gc", "type": "string", "description": "Optional equality filter on construction_gc.", "required": false, "sample_values": []}, {"name": "pj_project_id", "type": "string", "description": "Optional equality filter on pj_project_id.", "required": false, "sample_values": []}, {"name": "s_site_id", "type": "string", "description": "Optional equality filter on s_site_id.", "required": false, "sample_values": []}, {"name": "customer_site_code", "type": "string", "description": "Optional equality filter on customer_site_code.", "required": false, "sample_values": []}, {"name": "por_category", "type": "string", "description": "Optional equality filter on por_category.", "required": false, "sample_values": []}, {"name": "smp_name", "type": "string", "description": "Program filter. When \'NTM\', also enforces smp_status=\'Active\' and excludes specific ntm_project_type values.", "required": false, "sample_values": []}, {"name": "smp_id", "type": "string", "description": "Optional equality filter on smp_id.", "required": false, "sample_values": []}, {"name": "start_date", "type": "date", "description": "Lower bound on pj_a_4225_construction_start_finish::date.", "required": false, "sample_values": []}, {"name": "end_date", "type": "date", "description": "Upper bound on pj_a_4225_construction_start_finish::date.", "required": false, "sample_values": []}, {"name": "pj_construction_start_delay_code", "type": "string", "description": "Optional filter for delayed projects. Sentinel values (\'any\',\'true\',\'yes\',\'1\',\'*\') restrict to ANY non-empty delay code (IS NOT NULL AND <> \'No Delay\'). Any other value applies an exact equality on the delay code in addition to the IS NOT NULL guards.", "required": false, "sample_values": []}], "output_columns": [{"name": "pj_project_id", "type": "string", "nullable": false}, {"name": "rgn_region", "type": "string", "nullable": true}, {"name": "m_area", "type": "string", "nullable": true}, {"name": "m_market", "type": "string", "nullable": true}, {"name": "construction_gc", "type": "string", "nullable": true}, {"name": "rescheduled_count", "type": "number", "nullable": true}], "sample_output": [], "row_count": 100}', nl_description: 'Site Reschedule Count — per-project number of times the planned construction start date was overwritten before construction began, computed as GREATEST(COUNT(forecast rows) - 1, 0). Returns one row per project with geo context and rescheduled_count.', node_type: 'CORE', definition: 'Site Reschedule Count — per-project number of times the planned construction start date was overwritten before construction began, computed as GREATEST(COUNT(forecast rows) - 1, 0). Returns one row per project with geo context and rescheduled_count.', kpi_python_function: 'def get_site_reschedule_count(execute_query, filters=None) -> list[dict]:\n    """Site Reschedule Count — per-project count of construction-start reschedules.\n\n    Reschedule count = GREATEST(COUNT(forecast rows for that project) - 1, 0). When the project\n    has been rescheduled N times, the forecast table holds N + 1 historical planned dates; the\n    clamp protects the LEFT-JOIN null edge case where no forecast row exists.\n\n    Population:\n      - pj_a_4225_construction_start_finish IS NOT NULL (only projects that actually started)\n      - smp_name = \'NTM\' → also enforces smp_status = \'Active\' and excludes\n        ntm_project_type IN (\'E2E06 - NSD Cx Mgmt\', \'E2E07 - OL/MOD Cx Mgmt\')\n\n    Optional generic equality filters:\n      rgn_region, m_area, m_market, construction_gc,\n      pj_project_id, s_site_id, customer_site_code,\n      smp_name, smp_id, por_category.\n\n    Optional delay filter:\n      pj_construction_start_delay_code — when provided, narrows to delayed projects (column\n      IS NOT NULL AND <> \'No Delay\'). Sentinel values ("any","true","yes","1","*") restrict to\n      *any* delay; any other value applies an exact equality filter on the delay code.\n\n    Optional date range: start_date / end_date applied to pj_a_4225_construction_start_finish::date.\n\n    Output: one row per project (pj_project_id, rgn_region, m_area, m_market, construction_gc,\n    rescheduled_count), ordered by rescheduled_count DESC.\n    """\n    filters = filters or {}\n\n    def _esc(v):\n        return str(v).replace("\'", "\'\'")\n\n    where_parts = [\'c."pj_a_4225_construction_start_finish" IS NOT NULL\']\n\n    optional_eq_cols = [\n        "rgn_region", "m_area", "m_market", "construction_gc",\n        "pj_project_id", "s_site_id", "customer_site_code",\n        "smp_id", "por_category",\n    ]\n    for col in optional_eq_cols:\n        v = filters.get(col)\n        if v is not None and str(v) != "":\n            where_parts.append(f\'c."{col}" = \\\'{_esc(v)}\\\'\')\n\n    smp_name = filters.get("smp_name")\n    if smp_name is not None and str(smp_name).strip() != "":\n        v = _esc(smp_name)\n        where_parts.append(f\'c."smp_name" = \\\'{v}\\\'\')\n        if str(smp_name).strip().upper() == \'NTM\':\n            where_parts.append(\'c."smp_status" = \\\'Active\\\'\')\n            where_parts.append(\'c."ntm_project_type" NOT IN (\\\'E2E06 - NSD Cx Mgmt\\\', \\\'E2E07 - OL/MOD Cx Mgmt\\\')\')\n\n    # Optional construction-start delay-code filter (engages when caller wants delayed projects)\n    _v = filters.get("pj_construction_start_delay_code")\n    if _v is not None and str(_v).strip() != "":\n        _s = str(_v).strip()\n        where_parts.append(\'c."pj_construction_start_delay_code" IS NOT NULL\')\n        where_parts.append(\'c."pj_construction_start_delay_code" <> \\\'No Delay\\\'\')\n        if _s.lower() not in ("any", "true", "yes", "1", "*"):\n            _ss = _s.replace("\'", "\'\'")\n            where_parts.append(f\'c."pj_construction_start_delay_code" = \\\'{_ss}\\\'\')\n\n    start_date = filters.get("start_date")\n    end_date = filters.get("end_date")\n    if start_date:\n        where_parts.append(f\'c."pj_a_4225_construction_start_finish"::date >= DATE \\\'{_esc(start_date)}\\\'\')\n    if end_date:\n        where_parts.append(f\'c."pj_a_4225_construction_start_finish"::date <= DATE \\\'{_esc(end_date)}\\\'\')\n\n    where_sql = " AND ".join(where_parts)\n\n    sql = f"""\n        SELECT\n            c."pj_project_id",\n            c."rgn_region",\n            c."m_area",\n            c."m_market",\n            c."construction_gc",\n            GREATEST(COUNT(f.pj_project_id) - 1, 0) AS rescheduled_count\n        FROM pwc_macro_staging_schema.stg_ndpd_mbt_tmobile_macro_combined c\n        LEFT JOIN public.tmo_macro_copilot_short_construction_start_forecast f\n            ON c."pj_project_id" = f.pj_project_id\n        WHERE {where_sql}\n        GROUP BY\n            c."pj_project_id",\n            c."rgn_region",\n            c."m_area",\n            c."m_market",\n            c."construction_gc"\n        ORDER BY rescheduled_count DESC, c."pj_project_id"\n    """\n\n    return execute_query(sql)\n', kpi_source_columns: ['stg_ndpd_mbt_tmobile_macro_combined.pj_project_id', 'stg_ndpd_mbt_tmobile_macro_combined.s_site_id', 'stg_ndpd_mbt_tmobile_macro_combined.customer_site_code', 'stg_ndpd_mbt_tmobile_macro_combined.smp_id', 'stg_ndpd_mbt_tmobile_macro_combined.smp_name', 'stg_ndpd_mbt_tmobile_macro_combined.smp_status', 'stg_ndpd_mbt_tmobile_macro_combined.ntm_project_type', 'stg_ndpd_mbt_tmobile_macro_combined.rgn_region', 'stg_ndpd_mbt_tmobile_macro_combined.m_area', 'stg_ndpd_mbt_tmobile_macro_combined.m_market', 'stg_ndpd_mbt_tmobile_macro_combined.construction_gc', 'stg_ndpd_mbt_tmobile_macro_combined.por_category', 'stg_ndpd_mbt_tmobile_macro_combined.pj_a_4225_construction_start_finish', 'stg_ndpd_mbt_tmobile_macro_combined.pj_construction_start_delay_code', 'tmo_macro_copilot_short_construction_start_forecast.pj_project_id', 'tmo_macro_copilot_short_construction_start_forecast.construction_start_finish'], session_id: '69a3d22f26e208edc083a06e', label: 'Site Reschedule Count', kpi_related_core_node_ids: ['project', 'site', 'general_contractor', 'market'], kpi_relationship_type: 'COMPUTES_FROM', kpi_kpi_id: '277ecc42-c37c-46f9-9d9c-6c2e8d672a63', entity_type: 'kpi', kpi_name: 'Site Reschedule Count', name: '277ecc42-c37c-46f9-9d9c-6c2e8d672a63', kpi_dimensions: ['rgn_region', 'm_area', 'm_market', 'construction_gc'], kpi_description: 'Site Reschedule Count — per-project number of times the planned construction start date was overwritten before construction began, computed as GREATEST(COUNT(forecast rows) - 1, 0). Returns one row per project with geo context and rescheduled_count.', status: 'mentioned', node_id: '277ecc42-c37c-46f9-9d9c-6c2e8d672a63'});

